---@class CameraShakeStoryAction : BaseStoryAction @摄像机抖动剧情行为
---@field ActionData CameraRotateActionData @行为数据
---@field ControlCamera Camera @控制的摄像机
---@field RotateTweener DG.Tweening.Tweener @抖动Tweener
local CameraShakeStoryAction = _G.BaseClass("CameraShakeStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---CameraShakeStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraShakeStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraShakeStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraShakeStoryAction:Excute()
    --TODO:摄像机抖动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoCameraRotation()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function CameraShakeStoryAction:DoWaitExecuteAction()
    self:DoCameraRotation(_G.handler(self, self.OnCameraRotateComplete))
end

---执行摄像机抖动
---@param completecb function @摄像机抖动完成回调
function CameraShakeStoryAction:DoCameraRotation(completecb)
    self.ControlCamera = _G.StoryUtilities.GetMainCamera(self)
    self.RotateTweener =
        self.ControlCamera:GetTransform(1):DOShakePosition(
        self.ActionData.duration,
        self.ActionData.strength,
        self.ActionData.randomness
    )
    self.RotateTweener.onComplete = _G.handler(self, completecb)
end
---摄像机抖动完成
function CameraShakeStoryAction:OnCameraRotateComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function CameraShakeStoryAction:DoMustDoForSkip()
end

---剧情动作退出
function CameraShakeStoryAction:Exit()
    if self.RotateTweener ~= nil then
        self.RotateTweener:Kill(true)
    end
    base.Exit(self)
end

---清除数据
function CameraShakeStoryAction:ResetData()
    self.ControlCamera = nil
    self.RotateTweener = nil
end

---@type CameraShakeStoryAction @摄像机抖动剧情行为
return CameraShakeStoryAction
