---@class DialogueShowStoryAction : BaseStoryAction @对话剧情行为
---@field ActionData DialogueShowActionData @行为数据
local DialogueShowStoryAction = _G.BaseClass("DialogueShowStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---DialogueShowStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function DialogueShowStoryAction:__init(storyactionid)
end

---剧情动作进入
function DialogueShowStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function DialogueShowStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWaitExecuteAction()
    end

    base.Excute(self)
end

---执行等待完成行为的相关代码
function DialogueShowStoryAction:DoWaitExecuteAction()
    ---@type Params_DialogueView
    local Params_DialogueView = {}
    Params_DialogueView.isShowBtn = self.ActionData.ShowBtn

    _G.StoryManager:GetInstance():PlayDialogueView(
        self.ActionData.DialogueID,
        _G.handler(self, self.OnDialogueComplete),
        Params_DialogueView
    )
end

---剧情动作退出
function DialogueShowStoryAction:Exit()
    base.Exit(self)
end

---对话完成回调
function DialogueShowStoryAction:OnDialogueComplete()
    self:ActionExecuteCompleteCB()
end

---@type DialogueShowStoryAction @对话剧情行为
return DialogueShowStoryAction
