---@class LightAutoAngleStoryAction : BaseStoryAction @行为
---@field ActionData LightAutoAngleActionData @行为数据
local LightAutoAngleStoryAction = _G.BaseClass("LightAutoAngleStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---LightAutoAngleStoryAction的构造函数
---@param storyactionid number @行为ID
function LightAutoAngleStoryAction:__init(storyactionid)
    self.CustomLightInfo = _G.StoryManager:GetInstance():GetCustomLightInfo()
    if self.CustomLightInfo then
    end
end

---剧情动作执行
function LightAutoAngleStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function LightAutoAngleStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function LightAutoAngleStoryAction:DOFun()
    self:DoMustDoForSkip()
    self:Complete()
end
---跳过剧情行为必须做的部分
function LightAutoAngleStoryAction:DoMustDoForSkip()
    if self.CustomLightInfo then
        local key = self.CustomLightInfo:GetInstanceIDE()

        if self.ActionData.IsOpen == 1 then
            local rot = _G.StoryManager:GetInstance():GetCustomLightInfoRot(key)
            if rot == nil then
                local x, y, z = self.CustomLightInfo:GetEulerAngles()
                ---记录当前rot
                _G.StoryManager:GetInstance():SaveCustomLightInfoRot(key, x, y, z)
            end

            local Rot = self.ActionData.Rot
            if Rot then
                self.CustomLightInfo.IsAutoAngle = false
                ---设参
                self.CustomLightInfo:SetEulerAngles(Rot[1], Rot[2], Rot[3])
            else
                ---自动
                self.CustomLightInfo.IsAutoAngle = true
            end
        else
            _G.StoryManager:GetInstance():CloseAutoCustomLightInfo(self.CustomLightInfo, key)
        end
    end
end

function LightAutoAngleStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function LightAutoAngleStoryAction:Exit()
    base.Exit(self)
end
---@type LightAutoAngleStoryAction @行为
return LightAutoAngleStoryAction
