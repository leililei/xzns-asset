local BubblesTempArrStoryAction = _G.BaseClass("BubblesTempArrStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---BubblesTempArrStoryAction的构造函数
---@param storyactionid number @行为ID
function BubblesTempArrStoryAction:__init(storyactionid)
end

---剧情动作执行
function BubblesTempArrStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function BubblesTempArrStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function BubblesTempArrStoryAction:DOFun()
    if self.ActionData.UID == nil or self.ActionData.bubbles == nil or self.ActionData.intervalids == nil then
        self:Log(" 参数 有误 参数2 [ UID |hudid1#hudid2... |间隔最小值#间隔最大值 ] ")
    else
        local npc = _G.StoryUtilities.GetWorldItem(self.ActionData.UID)
        if npc then
            npc.BubblesIsOn = false

            ---@type Params_PlayBubbles
            local data = {}
            data.intervalArr = self.ActionData.intervalids
            data.npcType = self.ActionData.UID == 0 and 1 or 0

            npc:CheckNormalBubbles(self.ActionData.bubbles, nil, npc, data)
        end
    end

    self:Complete()
end
---跳过剧情行为必须做的部分
function BubblesTempArrStoryAction:DoMustDoForSkip()
end

function BubblesTempArrStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function BubblesTempArrStoryAction:Exit()
    base.Exit(self)
end
---@type BubblesTempArrStoryAction @行为
return BubblesTempArrStoryAction
