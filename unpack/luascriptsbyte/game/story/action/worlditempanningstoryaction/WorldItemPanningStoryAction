---@class WorldItemPanningStoryAction : BaseStoryAction @世界对象平移剧情行为
---@field ActionData WorldItemMoveActionData @行为数据
---@field WorldItem WorldBaseItem @操控的世界对象
---@field TempCB function @临时寻路回调
local WorldItemPanningStoryAction = _G.BaseClass("WorldItemPanningStoryAction", _G.BaseStoryAction)
WorldItemPanningStoryAction.WorldItem = nil
WorldItemPanningStoryAction.TempCB = nil

local base = _G.BaseStoryAction

---WorldItemPanningStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemPanningStoryAction:__init(storyactionid)
end

---剧情动作进入
function WorldItemPanningStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldItemPanningStoryAction:Excute()
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemMove()
    end
    base.Excute(self)
end

---执行世界物体平移
---@param completecb function @平移完成回调
function WorldItemPanningStoryAction:DoWorldItemMove(completecb)
    ---@type NavParam
    self.navparam = {}
    self.navparam.Position = self.ActionData.TargetPosition

    self.OverFun = function()
        if completecb ~= nil then
            completecb()
        end
    end

    if self.ActionData.UID == 0 then
        self.navparam.Object = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    else
        self.WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
        if self.WorldItem ~= nil then
            self.navparam.Object = self.WorldItem
        else
            if _G.AppSetting.DEBUG then
                _G.LogError(string.format("找不到UID:%d的世界对象，平移失败!", self.ActionData.UID))
            end
            self.OverFun()
            return
        end
    end

    -- navparam.Speed = navparam.Object.MoveSpeed * self.ActionData.SpeedMultiple
    self.navparam.Speed = 5 * self.ActionData.SpeedMultiple
    -- self.navparam.Object.Transform:LookAt(self.navparam.Position)

    local x, y, z = self.navparam.Object.Transform:GetPosition()
    local pos = Vector3.New(x, y, z)
    local duration = math.abs(Vector3.Distance(pos, self.navparam.Position)) / self.navparam.Speed
    self.dotween_Move =
        self.navparam.Object.Transform:DoMove(
        self.navparam.Position.x,
        self.navparam.Position.y,
        self.navparam.Position.z,
        _G.handler(self, self.MoveIng),
        duration
    )

    self.dotween_Move:SetEase(_G.CS.DG.Tweening.Ease.Linear)
end
---移动中
function WorldItemPanningStoryAction:MoveIng()
    self.OverFun()
end
function WorldItemPanningStoryAction:Stop_Move()
    if self.dotween_Move ~= nil then
        self.dotween_Move:Kill()
        self.dotween_Move = nil
    end
end

---执行等待完成行为的相关代码
function WorldItemPanningStoryAction:DoWaitExecuteAction()
    self:DoWorldItemMove(_G.handler(self, self.OnMoveToComplete))
end

---跳过剧情行为必须做的部分
function WorldItemPanningStoryAction:DoMustDoForSkip()
    --让世界对象停下来确保平移完成
    if self.WorldItem ~= nil then
        self.WorldItem:Move(0)
        self.WorldItem.Transform:SetPosition(
            self.ActionData.TargetPosition.x,
            self.ActionData.TargetPosition.y,
            self.ActionData.TargetPosition.z
        )
    else
        _G.StoryUtilities.Log_NoFindWorldItem(self)
    end
end

---剧情动作退出
function WorldItemPanningStoryAction:Exit()
    base.Exit(self)
end

---实体对象平移到指定位置完成
function WorldItemPanningStoryAction:OnMoveToComplete()
    self:ActionExecuteCompleteCB()
end

---清除数据
function WorldItemPanningStoryAction:ResetData()
    self.WorldItem = nil
    self:Stop_Move()
    self.navparam = nil
    base.ResetData(self)
end

---@type WorldItemPanningStoryAction @世界对象平移剧情行为
return WorldItemPanningStoryAction
