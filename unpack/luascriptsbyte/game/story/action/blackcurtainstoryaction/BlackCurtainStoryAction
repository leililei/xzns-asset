---@class BlackCurtainStoryAction : BaseStoryAction @幕布
---@field ActionData BlackCurtainActionData @行为数据
---@field View View @控制的摄像机
---@field TweenerIng DG.Tweening.Tweener @旋转Tweener
local BlackCurtainStoryAction = _G.BaseClass("BlackCurtainStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---BlackCurtainStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function BlackCurtainStoryAction:__init(storyactionid)
end

---剧情动作进入
function BlackCurtainStoryAction:Enter()
    ---预加载界面
    _G.PoolsManager:GetInstance():Preload(
        _G.ConfigManager.ui_cfg.BlackCurtainView.PrefabPath,
        function()
        end,
        _G.ePoolType.UIItem
    )
    base.Enter(self)
end

---剧情动作执行
function BlackCurtainStoryAction:Excute()
    --TODO:摄像机旋转代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        _G.coroutine.start(_G.handlerbind(self, self.DoCameraRotation, _G.handler(self, self.OnCameraRotateComplete)))
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function BlackCurtainStoryAction:DoWaitExecuteAction()
    local startCo = _G.handlerbind(self, self.DoCameraRotation, _G.handler(self, self.OnCameraRotateComplete))
    _G.coroutine.start(startCo)
end

---执行摄像机旋转
---@param completecb function @摄像机旋转完成回调
function BlackCurtainStoryAction:DoCameraRotation(completecb)
    ---@type BlackCurtainView
    self.View = _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BlackCurtainView.Name).View
    -- 等待 战斗窗口 加载完成
    while (_G.IsNil(self.View.gameObject)) do
        _G.coroutine.waitforendofframe()
    end
    local colorRgb = nil
    if self.ActionData.Color == 0 then
        colorRgb = {255 / 255, 255 / 255, 255 / 255, 1}
    else
        colorRgb = {0 / 255, 0 / 255, 0 / 255, 1}
    end
    local tagerAlpha = 1
    if self.ActionData.showType == 1 then
        colorRgb[4] = 0
    elseif self.ActionData.showType == 0 then
        tagerAlpha = 0
        colorRgb[4] = 1
    end
    self.View.go_table.aorrawimage_curtain.color = _G.Color.New(colorRgb[1], colorRgb[2], colorRgb[3], colorRgb[4])
    if self.TweenerIng ~= nil then
        self.TweenerIng:Kill(true)
        self.TweenerIng = nil
    end
    self.TweenerIng = self.View.go_table.aorrawimage_curtain:DOFade(tagerAlpha, self.ActionData.showTime)
    self.TweenerIng:SetEase(_G.CS.DG.Tweening.Ease.InQuad)
    self.TweenerIng.onComplete = completecb
end

---摄像机旋转完成
function BlackCurtainStoryAction:OnCameraRotateComplete()
    if self.ActionData.showType == 0 then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BlackCurtainView.Name)
    end

    self:ActionExecuteCompleteCB()
end

---跳过剧情行为
function BlackCurtainStoryAction:DoMustDoForSkip()
end

---剧情动作退出
function BlackCurtainStoryAction:Exit()
    if self.TweenerIng ~= nil then
        self.TweenerIng:Kill(true)
    end
    base.Exit(self)
end

---清除数据
function BlackCurtainStoryAction:ResetData()
    self.ControlCamera = nil
    self.TweenerIng = nil
end

---@type BlackCurtainStoryAction @摄像机旋转剧情行为
return BlackCurtainStoryAction
