---@class DelUidEffByPathStoryAction : BaseStoryAction
---@field ActionData DelUidEffByPathActionData @行为数据
local DelUidEffByPathStoryAction = _G.BaseClass("DelUidEffByPathStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---DialogueShowStoryAction的构造函数
---@param storyactionid number @行为ID
function DelUidEffByPathStoryAction:__init(storyactionid)
end

---剧情动作执行
function DelUidEffByPathStoryAction:Excute()
    self:DoMustDoForSkip()
    base.Excute(self)
end

---跳过剧情行为必须做的部分
function DelUidEffByPathStoryAction:DoMustDoForSkip()
    if self.ActionData.uid == 0 then
        self.WorldItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    else
        self.WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.uid)
    end
    if _G.IsNil(self.WorldItem) == false then
        local item
        if self.WorldItem.ObjectMod then
            item = self.WorldItem.ObjectMod
        elseif self.WorldItem.Transform then
            item = self.WorldItem.Transform
        else
            item = self.WorldItem
        end

        local node
        if item then
            node = item:FindE(self.ActionData.path)
        end

        if node ~= nil then
            _G.DestroyObject(node)
        else
            node = item:GetParent():FindE(self.ActionData.path)
            if node ~= nil then
                _G.DestroyObject(node)
            else
                self:Log(" 未匹配到路径 path:" .. tostring(self.ActionData.path))
            end
        end
    else
        self:Log(" 未找到 uid:" .. tostring(self.ActionData.uid))
    end
end

---退出
function DelUidEffByPathStoryAction:Exit()
    self.WorldItem = nil
    base.Exit(self)
end
---@type DelUidEffByPathStoryAction
return DelUidEffByPathStoryAction
