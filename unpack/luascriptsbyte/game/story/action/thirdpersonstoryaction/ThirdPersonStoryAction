---@class ThirdPersonStoryAction : BaseStoryAction @摄像机出现剧情行为
---@field ActionData CameraBlinkActionData @行为数据
local ThirdPersonStoryAction = _G.BaseClass("ThirdPersonStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---ThirdPersonStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function ThirdPersonStoryAction:__init(storyactionid)
end

---剧情动作进入
function ThirdPersonStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function ThirdPersonStoryAction:Excute()
    self:SetData()
    base.Excute(self)
end

function ThirdPersonStoryAction:SetData()
    self.ControlCamera = _G.StoryManager:GetInstance():GetCamera()
    if self.ActionData.CameraTargetUid == 0 then
        return
    end

    if self.ActionData.CameraTargetUid ~= -1 then
        self:SetWorldCameraPosRot()
        self:SetLook()
    else
        self:SetCameraPosRot()
    end
end
function ThirdPersonStoryAction:SetCameraPosRot()
    local v3 = {}
    v3.x = self.ActionData.CameraTargetPosition.x
    v3.y = self.ActionData.CameraTargetPosition.y
    v3.z = self.ActionData.CameraTargetPosition.z
    self.ControlCamera:SetPosition(v3.x, v3.y, v3.z)

    local Quaternion = {}
    Quaternion.x = self.ActionData.CameraTargetQuaternion[1]
    Quaternion.y = self.ActionData.CameraTargetQuaternion[2]
    Quaternion.z = self.ActionData.CameraTargetQuaternion[3]
    Quaternion.w = self.ActionData.CameraTargetQuaternion[4]
    self.ControlCamera.gameObject:SetRotation(Quaternion.x, Quaternion.y, Quaternion.z, Quaternion.w)
end
function ThirdPersonStoryAction:SetWorldCameraPosRot()
    local v3 = _G.Vector3.zero
    v3.x = self.ActionData.CameraTargetPosition.x
    v3.y = self.ActionData.CameraTargetPosition.y
    v3.z = self.ActionData.CameraTargetPosition.z
    self.ControlCamera.TargetOffset = v3

    local Quaternion = self.ControlCamera.CameraRotation
    Quaternion.x = self.ActionData.CameraTargetQuaternion[1]
    Quaternion.y = self.ActionData.CameraTargetQuaternion[2]
    Quaternion.z = self.ActionData.CameraTargetQuaternion[3]
    Quaternion.w = self.ActionData.CameraTargetQuaternion[4]
    self.ControlCamera.CameraRotation = Quaternion
end
function ThirdPersonStoryAction:SetLook()
    if self.ActionData.CameraTargetUid == 1 then
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        self.ActionData.CameraTargetUid = player.Uid
    end

    local target = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.CameraTargetUid)
    self.ControlCamera:Look(target.Transform)
    self.ControlCamera.DisablePositionSynchronization = false
end

---跳过剧情行为必须做的部分
function ThirdPersonStoryAction:DoMustDoForSkip()
    self:SetData()
end

---剧情动作退出
function ThirdPersonStoryAction:Exit()
    base.Exit(self)
end

---@type ThirdPersonStoryAction @摄像机出现剧情行为
return ThirdPersonStoryAction
