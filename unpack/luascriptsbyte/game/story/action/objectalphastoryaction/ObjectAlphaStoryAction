---@class ObjectAlphaStoryAction : BaseStoryAction @行为
---@field ActionData ObjectAlphaActionData @行为数据
local ObjectAlphaStoryAction = _G.BaseClass("ObjectAlphaStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---ObjectAlphaStoryAction的构造函数
---@param storyactionid number @行为ID
function ObjectAlphaStoryAction:__init(storyactionid)
end

---剧情动作执行
function ObjectAlphaStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function ObjectAlphaStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function ObjectAlphaStoryAction:DOFun()
    self:NpcAlphaCheck(self.ActionData.isOpen)
    self:Complete()
end
---跳过剧情行为必须做的部分
function ObjectAlphaStoryAction:DoMustDoForSkip()
end

----Npc透明检测 远离玩家就隐藏 isOpen true开启
function ObjectAlphaStoryAction:NpcAlphaCheck(isOpen)
    local world = _G.WorldManager:GetInstance():GetCurWorld()
    if world == nil or world.Cfg == nil or world.Cfg.Scene_Type ~= _G.SceneType.MainWorld then
        return
    end
    if isOpen then
        world:StartObjectAlphaCheck()
        _G.StoryManager:GetInstance():SetIsHideOtherPlayer(false, 2)
    else
        _G.StoryManager:GetInstance():SetIsHideOtherPlayer(true, 2)
        world:StopObjectAlphaCheck()
        world:ResetObjectAlphaEffect()
        world:ShowOrHideAllItem(true)
    end
end

function ObjectAlphaStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function ObjectAlphaStoryAction:Exit()
    base.Exit(self)
end
---@type ObjectAlphaStoryAction @行为
return ObjectAlphaStoryAction
