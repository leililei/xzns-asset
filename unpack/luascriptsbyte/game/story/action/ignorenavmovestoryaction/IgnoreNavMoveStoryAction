---@class IgnoreNavMoveStoryAction : BaseStoryAction @无视地形移动剧情行为
---@field ActionData IgnoreNavMoveActionData @行为数据
---@field WorldItem WorldBaseItem @操控的世界对象
---@field DoPathTweener DG.Tweening.Tweener @移动Tweener
local IgnoreNavMoveStoryAction = _G.BaseClass("IgnoreNavMoveStoryAction", _G.BaseStoryAction)
IgnoreNavMoveStoryAction.WorldItem = nil
IgnoreNavMoveStoryAction.DoPathTweener = nil

local base = _G.BaseStoryAction

---IgnoreNavMoveStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function IgnoreNavMoveStoryAction:__init(storyactionid)
end

---剧情动作进入
function IgnoreNavMoveStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function IgnoreNavMoveStoryAction:Excute()
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemPathMove()
    end
    base.Excute(self)
end

---执行世界物体路点移动
function IgnoreNavMoveStoryAction:DoWorldItemPathMove()
    self.WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
    self.DoPathTweener =
        self.WorldItem.Transform:DOPath(
        self.ActionData.Path,
        self.ActionData.ConsumeTime,
        CS.DG.Tweening.PathType.CatmullRom
    )
    self.DoPathTweener.onComplete = _G.handler(self, self.OnDoPathMoveCompleted)
end

---执行等待完成行为的相关代码
function IgnoreNavMoveStoryAction:DoWaitExecuteAction()
    self:DoWorldItemPathMove(_G.handler(self, self.OnMoveToComplete))
end

---完成路点移动
function IgnoreNavMoveStoryAction:OnDoPathMoveCompleted()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function IgnoreNavMoveStoryAction:DoMustDoForSkip()
    if self.DoPathTweener ~= nil then
        self.DoPathTweener:Kill(true)
    end
    self.WorldItem:SetPosition(self.ActionData.Path[3].x, self.ActionData.Path[3].y, self.ActionData.Path[3].z)
end

---剧情动作退出
function IgnoreNavMoveStoryAction:Exit()
    if self.DoPathTweener ~= nil then
        self.DoPathTweener:Kill(true)
    end
    base.Exit(self)
end

---清除数据
function IgnoreNavMoveStoryAction:ResetData()
    self.WorldItem = nil
    self.DoPathTweener = nil
end

---@type IgnoreNavMoveStoryAction @无视地形移动剧情行为
return IgnoreNavMoveStoryAction
