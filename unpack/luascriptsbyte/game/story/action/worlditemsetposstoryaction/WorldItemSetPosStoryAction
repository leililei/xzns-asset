---@class WorldItemSetPosStoryAction : BaseStoryAction @设置物体坐标
---@field ActionData WorldItemSetPosActionData @行为数据
local WorldItemSetPosStoryAction = _G.BaseClass("WorldItemSetPosStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---WorldItemSetPosStoryAction的构造函数
---@param storyactionid number @行为ID
function WorldItemSetPosStoryAction:__init(storyactionid)
end

---剧情动作执行
function WorldItemSetPosStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function WorldItemSetPosStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function WorldItemSetPosStoryAction:DOFun()
    ---@type BaseItem
    self.WorldItem = _G.StoryUtilities.GetWorldItem(self.ActionData.UID)
    if self.WorldItem ~= nil then
        local x = self.ActionData.Pos[1]
        local y = self.ActionData.Pos[2]
        local z = self.ActionData.Pos[3]
        if y == nil or x == nil or z == nil then
            self:Log(_G.string.format("xy坐标有空 x:%s y:%s z:%s ", _G.tostring(x), _G.tostring(y), _G.tostring(z)))
        else
            self.WorldItem.Transform:SetPosition(x, y, z)
        end
    end

    self:Complete()
end
---跳过剧情行为必须做的部分
function WorldItemSetPosStoryAction:DoMustDoForSkip()
    self:DOFun()
end

function WorldItemSetPosStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function WorldItemSetPosStoryAction:Exit()
    base.Exit(self)
end
---@type WorldItemSetPosStoryAction @行为
return WorldItemSetPosStoryAction
