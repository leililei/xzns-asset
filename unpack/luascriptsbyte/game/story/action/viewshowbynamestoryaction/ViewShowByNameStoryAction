---@class ViewShowByNameStoryAction : BaseStoryAction @界面显示
---@field ActionData ViewShowByNameActionData @行为数据
---@field View View @控制的摄像机
---@field TweenerIng DG.Tweening.Tweener @旋转Tweener
local ViewShowByNameStoryAction = _G.BaseClass("ViewShowByNameStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---ViewShowByNameStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function ViewShowByNameStoryAction:__init(storyactionid)
end

---剧情动作进入
function ViewShowByNameStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function ViewShowByNameStoryAction:Excute()
    --TODO:摄像机旋转代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWaitExecuteAction()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function ViewShowByNameStoryAction:DoWaitExecuteAction()
    self:DoCameraRotation()
end

---执行
function ViewShowByNameStoryAction:DoCameraRotation()
    if self.ActionData.isshow then
        if self.ActionData.params[1] ~= "VideoQTE" and self.ActionData.JumpId then
            _G.JumpManager:GetInstance():Jump(self.ActionData.JumpId)
            self:OnCameraRotateComplete()
            return
        end

        if self.ActionData.uiname == _G.ConfigManager.ui_cfg.StoryItemDisplayView.Name then
            _G.UIManager:GetInstance():OpenWindow(
                self.ActionData.uiname,
                self.ActionData.params,
                self.ActionID,
                function()
                    self:OnCameraRotateComplete()
                end
            )
        else
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
            _G.UIManager:GetInstance():OpenWindow(self.ActionData.uiname, self.ActionData.params)
        end
    else
        _G.UIManager:GetInstance():CloseWindow(self.ActionData.uiname)
        self:OnCameraRotateComplete()
    end
end

---执行完成
function ViewShowByNameStoryAction:OnCameraRotateComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function ViewShowByNameStoryAction:DoMustDoForSkip()
end

function ViewShowByNameStoryAction:OnUIClosed(uiName)
    --- StoryItemDisplayView 界面  剧情会连续打开 要注意剧情配置
    if uiName == self.ActionData.uiname then
        self:OnCameraRotateComplete()
    end
end
---剧情动作退出
function ViewShowByNameStoryAction:Exit()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    base.Exit(self)
end

---清除数据
function ViewShowByNameStoryAction:ResetData()
end

---@type ViewShowByNameStoryAction
return ViewShowByNameStoryAction
