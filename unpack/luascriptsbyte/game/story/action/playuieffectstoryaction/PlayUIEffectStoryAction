---@class PlayUIEffectStoryAction : BaseStoryAction @播放特效剧情行为
---@field ActionData PlayEffectActionData @行为数据
---@field EffectGo UnityEngine.GameObject @特效实体对象
local PlayUIEffectStoryAction = _G.BaseClass("PlayUIEffectStoryAction", _G.BaseStoryAction)
PlayUIEffectStoryAction.EffectGo = nil

local base = _G.BaseStoryAction

---PlayEffectStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function PlayUIEffectStoryAction:__init(storyactionid)
end

---剧情动作进入
function PlayUIEffectStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function PlayUIEffectStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:StartPlay()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function PlayUIEffectStoryAction:DoWaitExecuteAction()
    self:StartPlay(_G.handler(self, self.OnPlayComplete))
end

---剧情动作执行
function PlayUIEffectStoryAction:StartPlay(completecb)
    self.worlditem = nil

    self.parent = _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.InfoLayer.Name)

    local call = function()
        if completecb ~= nil then
            completecb()
        end
    end

    if not _G.IsNil(self.ActionData.npcuid) then
        local npc = nil
        if self.ActionData.npcuid == 0 then
            npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(_G.PlayerModel:GetInstance().role_uid)
        else
            npc = self.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner:GetStoryItem(self.ActionData.npcuid)
            if npc == nil then
                npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.npcuid)
            end
        end
        if npc then
            if not _G.IsNil(self.ActionData.nodepath) then
                self.worlditem = npc:GetChildNode(self.ActionData.nodepath)
            else
                if npc.ObjectMod then
                    self.worlditem = npc.ObjectMod:GetParent()
                elseif npc.Transform then
                    self.worlditem = npc.Transform
                else
                    self.worlditem = npc
                end
            end
        end

        -- GetParent 模型父级 uid检测是否隐藏
        if _G.IsNil(self.worlditem) == true or self.worlditem:GetActiveSelf() ~= 1 then
            self.parent = nil
        end
    end

    local cfg = _G.ConfigManager.ui_effect_cfg[self.ActionData.EffectName]
    if cfg ~= nil and self.parent ~= nil then
        local cfg = _G.ConfigManager.ui_effect_cfg[self.ActionData.EffectName]
        local RectTransform = self.parent:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        local v3 = _G.Vector3.zero
        v3.x, v3.y, v3.z = self.worlditem:GetPosition()
        local pos = _G.UIUtils.Get3DTo2DPos(RectTransform, v3)
        pos.x = pos.x + (cfg.Pos[1] or 0)
        pos.y = pos.y + (cfg.Pos[2] or 0)

        self.Params_pos = pos

        _G.UIUtils.LoadEffectByCfg(cfg, self.parent, _G.handler(self, self.OnLoadEffectComplete), call)
        return
    end
    call()
end

---剧情动作退出
function PlayUIEffectStoryAction:Exit()
    -- _G.GameObject.Destroy(self.EffectGo)
    base.Exit(self)
end

---清除数据
function PlayUIEffectStoryAction:ResetData()
    self.EffectGo = nil
    self.worlditem = nil
    self.parent = nil
    _G.BaseStoryAction:ResetData(self)
end
---跳过剧情行为必须做的部分
function PlayUIEffectStoryAction:DoMustDoForSkip()
end
---响应特效加载完成
---@param obj UnityEngine.Transform @特效Transform
function PlayUIEffectStoryAction:OnLoadEffectComplete(obj)
    if obj ~= nil and self.Params_pos ~= nil then
        obj:SetLocalPosition(self.Params_pos.x, self.Params_pos.y, self.Params_pos.z)
    end
    self.EffectGo = obj
end
function PlayUIEffectStoryAction:OnPlayComplete()
    self:ActionExecuteCompleteCB()
end
---@type PlayUIEffectStoryAction @播放特效剧情行为
return PlayUIEffectStoryAction
