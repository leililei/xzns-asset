---@class CameraFollowStoryAction : BaseStoryAction @摄像机移动剧情行为
---@field ActionData CameraMoveActionData @行为数据
---@field ControlCamera Camera @控制的摄像机
---@field WorldCamera WorldCamera @用于跟随效果
local CameraFollowStoryAction = _G.BaseClass("CameraFollowStoryAction", _G.BaseStoryAction)
CameraFollowStoryAction.ControlCamera = nil
CameraFollowStoryAction.WorldCamera = nil

local base = _G.BaseStoryAction

---CameraFollowStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraFollowStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraFollowStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraFollowStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoCameraMove()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function CameraFollowStoryAction:DoWaitExecuteAction()
    self:DoCameraMove()
end

---执行摄像机移动
function CameraFollowStoryAction:DoCameraMove(completecb)
    local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera
    ---以 第二次调用赋0 来关闭
    if self.ActionData.CameraTargetUid > 0 then
        ---缓存 摄象机位置 方便关闭时还原
        _G.StoryUtilities.SetTempCameraV3(
            self,
            _G.Vector3.New(sceneCamera:GetPosition()),
            _G.Vector3.New(sceneCamera:GetEulerAngles())
        )

        if self.ActionData.CameraTargetUid == 1 then
            local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
            self.ActionData.CameraTargetUid = player.Uid
        end

        local target = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.CameraTargetUid)
        sceneCamera:Look(target.Transform)
        sceneCamera.DisablePositionSynchronization = false
        self:ActionExecuteCompleteCB()
    else
        sceneCamera.DisablePositionSynchronization = _G.WorldManager:GetInstance():GetCurWorld().Cfg.LockMainCamera
        sceneCamera:Look()

        local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera
        ---还原 摄象机位置
        local v3s = _G.StoryUtilities.GetTempCameraV3(self)
        local pos = v3s.pos
        local rot = v3s.rot

        self.MoveTweener = sceneCamera:DoMove(pos.x, pos.y, pos.z, completecb, 0.2)
    end
end

---摄像机移动完成
function CameraFollowStoryAction:OnCameraMoveComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function CameraFollowStoryAction:DoMustDoForSkip()
    if self.MoveTweener ~= nil then
        self.MoveTweener:Kill(true)
    else
        local sceneCamera = _G.WorldManager:GetInstance():GetCurWorld().WorldSetting.SceneCamera
        ---还原 摄象机位置
        local v3s = _G.StoryUtilities.GetTempCameraV3(self)
        local pos = v3s.pos
        sceneCamera:SetPosition(pos.x, pos.y, pos.z)
        local rot = v3s.rot
        sceneCamera:SetEulerAngles(rot.x, rot.y, rot.z)
    end
end
---剧情动作退出
function CameraFollowStoryAction:Exit()
    base.Exit(self)
end

---清除数据
function CameraFollowStoryAction:ResetData()
    self.ControlCamera = nil
    self.WorldCamera = nil
end

---@type CameraFollowStoryAction @摄像机移动剧情行为
return CameraFollowStoryAction
