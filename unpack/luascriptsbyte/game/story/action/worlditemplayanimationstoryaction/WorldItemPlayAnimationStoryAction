---@class WorldItemPlayAnimationStoryAction : BaseStoryAction @世界对象播放动画行为
---@field ActionData WorldItemPlayAnimationActionData @行为数据
---@field CoDelay function @延时判定Function
---@field WorldItem WorldBaseItem @控制的世界对象
---@field AnimTime number @动画时长
local WorldItemPlayAnimationStoryAction = _G.BaseClass("WorldItemPlayAnimationStoryAction", _G.BaseStoryAction)
WorldItemPlayAnimationStoryAction.CoDelay = nil
WorldItemPlayAnimationStoryAction.WorldItem = nil
WorldItemPlayAnimationStoryAction.AnimTime = nil

local base = _G.BaseStoryAction

---WorldItemPlayAnimationStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemPlayAnimationStoryAction:__init(storyactionid)
end

---剧情动作进入[virtual]
function WorldItemPlayAnimationStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行[virtual]
function WorldItemPlayAnimationStoryAction:Excute()
    if self.ActionData.UID == 0 then
        ---@type WorldNPCItem
        self.WorldItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    else
        self.WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
    end

    --- 所有参数 Remove遍历递归播放多个动作
    self.TempAnimationParams = _G.DeepCopyCfgTable(self.ActionData.AnimationParams)

    if self.ActionData.WaitExecuteComplete == false then
        if self.WorldItem ~= nil then
            self.WorldItem:PlayAnimByName(self.ActionData.AnimationName)
        else
            _G.StoryUtilities.Log_NoFindWorldItem(self)
        end
    end

    base.Excute(self)
end

---执行等待完成行为的相关代码
function WorldItemPlayAnimationStoryAction:DoWaitExecuteAction()
    self:PlayNextAni()
end

--- 递归播放动作
function WorldItemPlayAnimationStoryAction:PlayWait(aniName)
    if self.WorldItem ~= nil then
        if self.WorldItem.AnimComponent.animator == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError("animator 为空 Sid" .. self.WorldItem.Sid)
            end
            self:OnAnimPlayComplete()
            return
        end
        self.AnimTime = self.WorldItem.AnimComponent.animator:GetAnimationClipLength(aniName)
        self.WorldItem:PlayAnimByName(aniName)
        self.CoDelay = _G.DelayDo(self.AnimTime, _G.handler(self, self.PlayNextAni))
    else
        self:OnAnimPlayComplete()
    end
end

---剧情动作退出
function WorldItemPlayAnimationStoryAction:Exit()
    if self.CoDelay ~= nil then
        _G.coroutine.stopwaiting(self.CoDelay)
        self.CoDelay = nil
    end
    if self.WorldItem ~= nil then
        self.WorldItem:PlayAnimByName(self.ActionData.AnimationParams[#self.ActionData.AnimationParams])
    end
    base.Exit(self)
end

function WorldItemPlayAnimationStoryAction:PlayNextAni()
    local aniName = table.remove(self.TempAnimationParams, 2)

    if aniName == nil then
        self:OnAnimPlayComplete()
    else
        self:PlayWait(aniName)
    end
end

---实体对象播放动画完成
function WorldItemPlayAnimationStoryAction:OnAnimPlayComplete()
    self:ActionExecuteCompleteCB()
end

---清除数据
function WorldItemPlayAnimationStoryAction:ResetData()
    self.CoDelay = nil
    self.WorldItem = nil
    self.AnimTime = nil
    self.TempAnimationParams = nil
    base.ResetData(self)
end

---@type WorldItemPlayAnimationStoryAction @世界物体播放动画行为
return WorldItemPlayAnimationStoryAction
