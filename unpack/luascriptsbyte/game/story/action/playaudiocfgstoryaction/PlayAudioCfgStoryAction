---@class PlayAudioCfgStoryAction : BaseStoryAction @行为
---@field ActionData PlayAudioCfgActionData @行为数据
local PlayAudioCfgStoryAction = _G.BaseClass("PlayAudioCfgStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---PlayAudioCfgStoryAction的构造函数
---@param storyactionid number @行为ID
function PlayAudioCfgStoryAction:__init(storyactionid)
end

---剧情动作执行
function PlayAudioCfgStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DOFun()
    end
    base.Excute(self)
end
function PlayAudioCfgStoryAction:DoWaitExecuteAction()
    self:DOFun()
end

---行为
function PlayAudioCfgStoryAction:DOFun()
    if self.ActionData.audioId ~= nil then
        if self.ActionData.audioId == 0 then
            --- 暂停
            _G.StoryManager:GetInstance():StopGameMusicAudio()
        elseif self.ActionData.audioId == 1 then
            --- 继续
            _G.StoryManager:GetInstance():ResumeGameMusicAudio()
        else
            --- 播
            _G.StoryManager:GetInstance():PlayStoryMusicAudio(self.ActionData.audioId)
        end
    else
        self:Log(" 参数 无效 ", true)
    end
    self:Complete()
end
---跳过剧情行为必须做的部分
function PlayAudioCfgStoryAction:DoMustDoForSkip()
    self:DoAddOrRemoveAIAction()
end

function PlayAudioCfgStoryAction:Complete()
    if self.ActionData.WaitExecuteComplete == true then
        self:ActionExecuteCompleteCB()
    end
end

---退出
function PlayAudioCfgStoryAction:Exit()
    base.Exit(self)
end
---@type PlayAudioCfgStoryAction @行为
return PlayAudioCfgStoryAction
