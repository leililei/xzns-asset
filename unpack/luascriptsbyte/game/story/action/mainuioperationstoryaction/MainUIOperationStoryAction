---@class MainUIOperationStoryAction : BaseStoryAction @Main UI操作剧情行为
---@field ActionData MainUIOperationActionData @行为数据
local MainUIOperationStoryAction = _G.BaseClass("MainUIOperationStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---MainUIOperationStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function MainUIOperationStoryAction:__init(storyactionid)
end

---剧情动作进入
function MainUIOperationStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function MainUIOperationStoryAction:Excute()
    self:DoOperateMainUI()
    base.Excute(self)
end

---执行主UI操作
function MainUIOperationStoryAction:DoOperateMainUI()
    if self.ActionData.IsShowMainUI then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    else
        --_G.UIManager:GetInstance():CloseWindowsByLayer(_G.UILayers.NormalLayer, _G.UILayers.InfoLayer)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    end
end

---跳过剧情行为必须做的部分
function MainUIOperationStoryAction:DoMustDoForSkip()
    self:DoOperateMainUI()
end

---剧情动作退出
function MainUIOperationStoryAction:Exit()
    base.Exit(self)
end

---@type MainUIOperationStoryAction @Main UI操作剧情行为
return MainUIOperationStoryAction
