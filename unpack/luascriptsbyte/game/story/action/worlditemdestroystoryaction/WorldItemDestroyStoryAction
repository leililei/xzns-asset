---@class WorldItemDestroyStoryAction : BaseStoryAction @世界对象销毁剧情行为
---@field ActionData WorldItemDestroyActionData @行为数据
local WorldItemDestroyStoryAction = _G.BaseClass("WorldItemDestroyStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---WorldItemDestroyStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemDestroyStoryAction:__init(storyactionid)
end

---剧情动作进入
function WorldItemDestroyStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldItemDestroyStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemDestroyAction()
    end
    base.Excute(self)
end

---执行世界物体销毁行为
function WorldItemDestroyStoryAction:DoWorldItemDestroyAction(completecb)
    local npc = self.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner:GetStoryItem(self.ActionData.UID)
    if npc == nil then
        npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
    end
    if _G.IsNil(npc) then
        _G.StoryUtilities.Log_NoFindWorldItem(self)
        if completecb ~= nil then
            completecb()
        end
        return
    end
    self:DoMustDoForSkip()
    self:OnComplete()
end

---跳过剧情行为必须做的部分
function WorldItemDestroyStoryAction:DoMustDoForSkip()
    local result =
        self.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner:DestroySpecificStoryItem(self.ActionData.UID)
    --为False表明可能是删除世界对象而非剧情创建的对象
    if result == false then
        _G.WorldManager:GetInstance():GetCurWorld():RemoveWorldItems(self.ActionData.UID)
    end
end

---摄像机移动完成
function WorldItemDestroyStoryAction:OnComplete()
    self:ActionExecuteCompleteCB()
end

---执行等待完成行为的相关代码
function WorldItemDestroyStoryAction:DoWaitExecuteAction()
    self:DoWorldItemDestroyAction(_G.handler(self, self.OnComplete))
end

---剧情动作退出
function WorldItemDestroyStoryAction:Exit()
    base.Exit(self)
end

---@type WorldItemDestroyStoryAction @世界对象销毁剧情行为
return WorldItemDestroyStoryAction
