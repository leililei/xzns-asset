---@class WorldItemRotateStoryAction : BaseStoryAction @世界对象旋转剧情行为
---@field ActionData WorldItemRotateActionData @行为数据
local WorldItemRotateStoryAction = _G.BaseClass("WorldItemRotateStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---WorldItemRotateStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemRotateStoryAction:__init(storyactionid)
end

---剧情动作进入
function WorldItemRotateStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldItemRotateStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemRotateAction(true)
    end
    base.Excute(self)
end

function WorldItemRotateStoryAction:DoWaitExecuteAction()
    self:DoWorldItemRotateAction()
end

---执行世界物体旋转行为
---@param 变量名 boolean true  直接设置旋(跳过时)
function WorldItemRotateStoryAction:DoWorldItemRotateAction(isSet)
    ---@type WorldBaseItem
    local worlditem = nil
    if self.ActionData.UID == 0 then
        worlditem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
    else
        worlditem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
    end
    if worlditem == nil then
        _G.StoryUtilities.Log_NoFindWorldItem(self)
    else
        -- worlditem.Transform.forward = self.ActionData.TargetDirection
        self.worlditem = worlditem

        local Rot = self.ActionData.TargetDirection

        self.ItmeEuler = Vector3.New(self.worlditem.Transform:GetEulerAngles())

        --- 旋转差值
        self.subRot = nil
        --- 定值
        self.tagerRot = nil

        if self.ActionData.rotType == 0 then
            if self.ActionData.rotTime == 0 or isSet then
                self.tagerRot = self.ActionData.TargetDirection
                self:SetLocalEulerAngles()
            else
                self.subRot = Vector3.New(Rot.x - self.ItmeEuler.x, Rot.y - self.ItmeEuler.y, Rot.z - self.ItmeEuler.z)
                self:RotateCoOnProgress()
            end
        else
            if self.ActionData.rotTime == 0 or isSet then
                self.tagerRot =
                    Vector3.New(self.ItmeEuler.x + Rot.x, self.ItmeEuler.y + Rot.y, self.ItmeEuler.z + Rot.z)
                self:SetLocalEulerAngles()
            else
                self.subRot = self.ActionData.TargetDirection
                self:RotateCoOnProgress()
            end
        end
    end
end
function WorldItemRotateStoryAction:SetLocalEulerAngles()
    self.worlditem.Transform:SetLocalEulerAngles(self.tagerRot.x, self.tagerRot.y, self.tagerRot.z)
    self:ActionExecuteCompleteCB()
end

function WorldItemRotateStoryAction:RotateCoOnProgress()
    local frame = 25
    local count = frame * self.ActionData.rotTime
    local Rot = self.subRot
    local subRot = _G.DeepCopy(Rot)
    Rot.x = Rot.x / count
    Rot.y = Rot.y / count
    Rot.z = Rot.z / count

    local mRot = self.ItmeEuler

    self.temp_rotate =
        _G.TimerManager:GetInstance():GetTimer(
        1 / frame,
        self.GetTimerCallBack,
        self,
        false,
        false,
        true,
        subRot,
        Rot,
        mRot
    )
    self.temp_rotate:Start()
end

function WorldItemRotateStoryAction:GetTimerCallBack(subRot, Rot, mRot)
    if _G.IsNil(self.worlditem) == true then
        self:DelTimer()
        return
    end
    if subRot.x == 0 and subRot.y == 0 and subRot.z == 0 then
        self:DelTimer()
        return
    end
    if math.abs(subRot.x) < math.abs(Rot.x) then
        --- 如果 剩余旋转 小于本次差值 就转完剩余
        Rot.x = subRot.x
    end
    if Rot.x ~= 0 then
        mRot.x = mRot.x + Rot.x
        subRot.x = subRot.x - Rot.x
    end

    if math.abs(subRot.y) < math.abs(Rot.y) then
        --- 如果 剩余旋转 小于本次差值 就转完剩余
        Rot.y = subRot.y
    end
    if Rot.y ~= 0 then
        mRot.y = mRot.y + Rot.y
        subRot.y = subRot.y - Rot.y
    end

    if math.abs(subRot.z) < math.abs(Rot.z) then
        --- 如果 剩余旋转 小于本次差值 就转完剩余
        Rot.z = subRot.z
    end
    if Rot.z ~= 0 then
        mRot.z = mRot.z + Rot.z
        subRot.z = subRot.z - Rot.z
    end

    self.worlditem.Transform:SetEulerAngles(mRot.x, mRot.y, mRot.z)
end

function WorldItemRotateStoryAction:DelTimer()
    if self.temp_rotate ~= nil then
        self.temp_rotate:Stop()
        self.temp_rotate = nil
    end

    self:ActionExecuteCompleteCB()
end
---跳过剧情行为必须做的部分
function WorldItemRotateStoryAction:DoMustDoForSkip()
    self:DoWorldItemRotateAction(true)
end

---剧情动作退出
function WorldItemRotateStoryAction:Exit()
    base.Exit(self)
end

---@type WorldItemRotateStoryAction @世界对象旋转剧情行为
return WorldItemRotateStoryAction
