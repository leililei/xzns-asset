---@class DoCollectWorldItemStoryAction : BaseStoryAction @开始采集指定世界物品行为
---@field ActionData DoCollectWorldItemActionData @行为数据
---@field WorldItem WorldBaseItem @采集物对象
local DoCollectWorldItemStoryAction = _G.BaseClass("DoCollectWorldItemStoryAction", _G.BaseStoryAction)
DoCollectWorldItemStoryAction.WorldItem = nil

local base = _G.BaseStoryAction

---DoCollectWorldItemStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function DoCollectWorldItemStoryAction:__init(storyactionid)
end

---剧情动作进入[virtual]
function DoCollectWorldItemStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行[virtual]
function DoCollectWorldItemStoryAction:Excute()
    --TODO：采集物已被删除。
    base.Excute(self)
    self:OnCollectCompleted(self.ActionData.CollectItemUID)
end

---执行等待完成行为的相关代码
function DoCollectWorldItemStoryAction:DoWaitExecuteAction()
end

---采集完成回调
---@param uid number @采集物UID
function DoCollectWorldItemStoryAction:OnCollectCompleted(uid)
    if self.ActionData.CollectItemUID == uid then
        self:ActionExecuteCompleteCB()
    end
end

---剧情动作退出
function DoCollectWorldItemStoryAction:Exit()
    base.Exit(self)
end

---实体对象播放动画完成
function DoCollectWorldItemStoryAction:OnAnimPlayComplete()
    self:ActionExecuteCompleteCB()
end

---清除数据
function DoCollectWorldItemStoryAction:ResetData()
    self.WorldItem = nil
    base.ResetData(self)
end

---@type DoCollectWorldItemStoryAction @开始采集指定世界物品行为
return DoCollectWorldItemStoryAction
