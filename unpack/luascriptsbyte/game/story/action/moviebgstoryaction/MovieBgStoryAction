---@class MovieBgStoryAction : BaseStoryAction @播放CG视频剧情行为
---@field ActionData PlayCGActionData @行为数据
local MovieBgStoryAction = _G.BaseClass("MovieBgStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---MovieBgStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function MovieBgStoryAction:__init(storyactionid)
end

---剧情动作进入
function MovieBgStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function MovieBgStoryAction:Excute()
    if self.ActionData.isShow == true then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StoryView.Name, {ShowMovie = true})
    else
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.StoryView.Name)
    end
    base.Excute(self)
end

---跳过剧情行为必须做的部分
function MovieBgStoryAction:DoMustDoForSkip()
end

---剧情动作退出
function MovieBgStoryAction:Exit()
    if self.ActionData.isShow == false then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.StoryView.Name)
    end
    base.Exit(self)
end

---@type MovieBgStoryAction @播放CG视频剧情行为
return MovieBgStoryAction
