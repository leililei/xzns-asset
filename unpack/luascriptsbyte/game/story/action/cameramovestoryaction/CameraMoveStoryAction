---@class CameraMoveStoryAction : BaseStoryAction @摄像机移动剧情行为
---@field ActionData CameraMoveActionData @行为数据
---@field ControlCamera Camera @控制的摄像机
---@field MoveTweener DG.Tweening.Tweener @移动Tweener
local CameraMoveStoryAction = _G.BaseClass("CameraMoveStoryAction", _G.BaseStoryAction)
CameraMoveStoryAction.ControlCamera = nil
CameraMoveStoryAction.MoveTweener = nil

local base = _G.BaseStoryAction

---CameraMoveStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraMoveStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraMoveStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraMoveStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoCameraMove()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function CameraMoveStoryAction:DoWaitExecuteAction()
    self:DoCameraMove(_G.handler(self, self.OnCameraMoveComplete))
end

---执行摄像机移动
function CameraMoveStoryAction:DoCameraMove(completecb)
    self.ControlCamera = _G.StoryUtilities.GetMainCamera(self)
    self.MoveTweener =
        self.ControlCamera:DoMove(
        self.ActionData.CameraTargetPosition.x,
        self.ActionData.CameraTargetPosition.y,
        self.ActionData.CameraTargetPosition.z,
        completecb,
        self.ActionData.TimeConsume
    )
end

---摄像机移动完成
function CameraMoveStoryAction:OnCameraMoveComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function CameraMoveStoryAction:DoMustDoForSkip()
    if self.MoveTweener ~= nil then
        self.MoveTweener:Kill(true)
    end
    if self.ControlCamera == nil then
        self.ControlCamera = _G.StoryUtilities.GetMainCamera(self)
    end
    self.ControlCamera:SetPosition(
        self.ActionData.CameraTargetPosition.x,
        self.ActionData.CameraTargetPosition.y,
        self.ActionData.CameraTargetPosition.z
    )
end

---剧情动作退出
function CameraMoveStoryAction:Exit()
    if self.MoveTweener ~= nil then
        self.MoveTweener:Kill(true)
        self.MoveTweener = nil
    end
    base.Exit(self)
end

---清除数据
function CameraMoveStoryAction:ResetData()
    self.ControlCamera = nil
    self.MoveTweener = nil
end

---@type CameraMoveStoryAction @摄像机移动剧情行为
return CameraMoveStoryAction
