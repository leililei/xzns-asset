---@class CustomUIInteractionStoryAction : BaseStoryAction @自定义UI交互(QTE)剧情行为
---@field ActionData CustomUIInteractionActionData @行为数据
local CustomUIInteractionStoryAction = _G.BaseClass("CustomUIInteractionStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---CustomUIInteractionStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CustomUIInteractionStoryAction:__init(storyactionid)
end

---剧情动作进入
function CustomUIInteractionStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CustomUIInteractionStoryAction:Excute()
    base.Excute(self)
    _G.Time:SetTimeScale(0.1)
end

---剧情动作退出
function CustomUIInteractionStoryAction:Exit()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg[self.ActionData.CustomInteractionUIName].Name)
    base.Exit(self)
end

---执行等待完成行为的相关代码
function CustomUIInteractionStoryAction:DoWaitExecuteAction()
    --TODO:QTE代码待添加
    local uiinteractionview =
        _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg[self.ActionData.CustomInteractionUIName].Name,
        self.ActionData
    ).View
    --监听所有QTE事件完成事件
    uiinteractionview:AddListener(
        _G.eInputEvent.CompleteAllQTEUIEvents,
        _G.handler(self, self.OnAllQTEUIEventsCompleted)
    )
end

---所有QTE UI事件完成回调
function CustomUIInteractionStoryAction:OnAllQTEUIEventsCompleted()
    self:ActionExecuteCompleteCB()
    _G.Time:SetTimeScale(1)
end

---@type CustomUIInteractionStoryAction @自定义UI交互(QTE)剧情行为
return CustomUIInteractionStoryAction
