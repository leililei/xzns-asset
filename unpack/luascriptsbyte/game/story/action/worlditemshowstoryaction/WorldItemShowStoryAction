---@class WorldItemShowStoryAction : BaseStoryAction @世界物体显示剧情行为
---@field ActionData WorldItemShowActionData @行为数据
---@field WorldItem WorldBaseItem @世界对象
local WorldItemShowStoryAction = _G.BaseClass("WorldItemShowStoryAction", _G.BaseStoryAction)
WorldItemShowStoryAction.WorldItem = nil

local base = _G.BaseStoryAction

---WorldItemShowStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemShowStoryAction:__init(storyactionid)
end

---剧情动作进入
function WorldItemShowStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldItemShowStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemShowAction()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function WorldItemShowStoryAction:DoWaitExecuteAction()
    self:DoWorldItemShowAction()
end

---执行世界物体显示控制操作
---@param isSkip boolean true跳过  不执行延迟相关操作
function WorldItemShowStoryAction:DoWorldItemShowAction(isSkip)
    ---@type StoryUtilities_ShowtWorldItem_Data
    local data = {}
    data.CallBack = _G.handler(self, self.OnPlayComplete)
    data.isShow = self.ActionData.IsShow
    data.IsShowDissolve = self.ActionData.IsShowDissolve
    data.isSkip = isSkip
    data.uid = self.ActionData.UID
    _G.StoryUtilities.ShowtWorldItem(data, self)
end

---跳过剧情行为必须做的部分
function WorldItemShowStoryAction:DoMustDoForSkip()
    self:DoWorldItemShowAction(true)
end
function WorldItemShowStoryAction:OnPlayComplete()
    self:ActionExecuteCompleteCB()
end
---剧情动作退出
function WorldItemShowStoryAction:Exit()
    base.Exit(self)
end

---重置剧情行为播放数据
function WorldItemShowStoryAction:ResetData()
    self.WorldItem = nil
    base.ResetData(self)
end

---@type WorldItemShowStoryAction @世界物体显示剧情行为
return WorldItemShowStoryAction
