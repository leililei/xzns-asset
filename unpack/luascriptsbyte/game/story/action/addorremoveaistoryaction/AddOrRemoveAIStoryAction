---@class AddOrRemoveAIStoryAction : BaseStoryAction @指定世界对象添加AI或移除AI剧情行为
---@field ActionData AddOrRemoveAIActionData @行为数据
local AddOrRemoveAIStoryAction = _G.BaseClass("AddOrRemoveAIStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---HUDStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function AddOrRemoveAIStoryAction:__init(storyactionid)
end

---剧情动作进入
function AddOrRemoveAIStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function AddOrRemoveAIStoryAction:Excute()
    self:DoAddOrRemoveAIAction()
    base.Excute(self)
end

---执行添加或移除AI操作
function AddOrRemoveAIStoryAction:DoAddOrRemoveAIAction()
    if self.ActionData.IsAdd then
        _G.AIManager:GetInstance():AddAI(self.ActionData.AIID, self.ActionData.WorldItemUID)
    else
        _G.AIManager:GetInstance():ClearAI(self.ActionData.WorldItemUID)
    end
end

---跳过剧情行为必须做的部分
function AddOrRemoveAIStoryAction:DoMustDoForSkip()
    self:DoAddOrRemoveAIAction()
end

---剧情动作退出
function AddOrRemoveAIStoryAction:Exit()
    base.Exit(self)
end

---@type AddOrRemoveAIStoryAction @指定世界对象添加AI或移除AI剧情行为
return AddOrRemoveAIStoryAction
