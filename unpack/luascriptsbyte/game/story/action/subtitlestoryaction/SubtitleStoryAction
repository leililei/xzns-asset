---@class SubtitleStoryAction : BaseStoryAction @对话剧情行为
---@field ActionData SubtitleActionData @行为数据
local SubtitleStoryAction = _G.BaseClass("SubtitleStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---DialogueShowStoryAction的构造函数
---@param storyactionid number @行为ID
function SubtitleStoryAction:__init(storyactionid)
end

---剧情动作执行
function SubtitleStoryAction:Excute()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SubtitleView.Name, self.ActionData.data)
    --view.View:ShowContent(self.ActionData.data.Content)
    base.Excute(self)
end

---退出
function SubtitleStoryAction:Exit()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SubtitleView.Name)
    --view.View:Close()
    base.Exit(self)
end
---@type SubtitleStoryAction @字幕行为
return SubtitleStoryAction
