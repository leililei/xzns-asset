---@class PlayRoleUpdataStoryAction : BaseStoryAction @修改玩家主控角色
---@field ActionData CameraRotateActionData @行为数据
local PlayRoleUpdataStoryAction = _G.BaseClass("PlayRoleUpdataStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---PlayRoleUpdataStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function PlayRoleUpdataStoryAction:__init(storyactionid)
end

---剧情动作进入
function PlayRoleUpdataStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function PlayRoleUpdataStoryAction:Excute()
    --TODO:摄像机旋转代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoFun()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function PlayRoleUpdataStoryAction:DoWaitExecuteAction()
    self:DoFun(_G.handler(self, self.OnCameraRotateComplete))
end

---执行内容
---@param completecb function @摄完成回调
function PlayRoleUpdataStoryAction:DoFun(completecb)
    local chapterroommanager = _G.ChapterRoomManager:GetInstance()
    if self.ActionData.playerSids <= 0 then
        chapterroommanager:SetSceneRunPlayer(nil, _G.SceneRunPlayerWeight.story)
    else
        chapterroommanager:SetSceneRunPlayer(self.ActionData.playerSids, _G.SceneRunPlayerWeight.story)
    end
    chapterroommanager:SetSceneRunPlayer(nil, _G.SceneRunPlayerWeight.storyBattle)
    local sids = chapterroommanager:GetSceneRunPlayer()
    ---@type card_cfg
    local cfg = require "CardCommentManager":GetInstance():GetCfgs(sids)
    if cfg then
        local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        player:ChangeModel(nil, sids, cfg.ModelPathLow)
        if self.ActionData.playerPos then
            player:SetInitPosition(self.ActionData.playerPos)
        end
    end
    if completecb then
        completecb()
    end
end

---摄像机旋转完成
function PlayRoleUpdataStoryAction:OnCameraRotateComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function PlayRoleUpdataStoryAction:DoMustDoForSkip()
end

---剧情动作退出
function PlayRoleUpdataStoryAction:Exit()
    base.Exit(self)
end

---清除数据
function PlayRoleUpdataStoryAction:ResetData()
