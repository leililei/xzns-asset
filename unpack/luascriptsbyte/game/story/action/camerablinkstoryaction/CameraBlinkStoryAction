---@class CameraBlinkStoryAction : BaseStoryAction @摄像机出现剧情行为
---@field ActionData CameraBlinkActionData @行为数据
local CameraBlinkStoryAction = _G.BaseClass("CameraBlinkStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---CameraBlinkStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraBlinkStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraBlinkStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraBlinkStoryAction:Excute()
    if self.ActionData.WaitExecuteComplete == false then
        self:SetPosWait()
    end
    base.Excute(self)
end

function CameraBlinkStoryAction:DoWaitExecuteAction()
    self:SetPosWait(
        function()
            self:ActionExecuteCompleteCB()
        end
    )
end

function CameraBlinkStoryAction:SetPos()
    -- _G.StoryManager:GetInstance():CameraLerpTimeZero(true)
    ---@type UnityEngine.Camera
    self.ControlCamera = _G.StoryUtilities.GetMainCamera(self)
    if self.ControlCamera == nil then
        return
    end
    self.ControlCamera:SetPosition(
        self.ActionData.CameraTargetPosition.x,
        self.ActionData.CameraTargetPosition.y,
        self.ActionData.CameraTargetPosition.z
    )

    if self.ActionData.CameraTargetQuaternion[1] ~= nil then
        self.ControlCamera.transform:SetRotation(
            self.ActionData.CameraTargetQuaternion[1],
            self.ActionData.CameraTargetQuaternion[2],
            self.ActionData.CameraTargetQuaternion[3],
            self.ActionData.CameraTargetQuaternion[4]
        )
    end

    _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
end

function CameraBlinkStoryAction:SetPosWait(call)
    self:SetPos()

    if call ~= nil then
        call()
    end
end

---跳过剧情行为必须做的部分
function CameraBlinkStoryAction:DoMustDoForSkip()
    self:SetPosWait()

    -- _G.StoryManager:GetInstance():CameraLerpTimeZero(false)
end

---剧情动作退出
function CameraBlinkStoryAction:Exit()
    base.Exit(self)
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

---@type CameraBlinkStoryAction @摄像机出现剧情行为
return CameraBlinkStoryAction
