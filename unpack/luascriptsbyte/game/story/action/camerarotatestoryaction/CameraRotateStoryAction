---@class CameraRotateStoryAction : BaseStoryAction @摄像机旋转剧情行为
---@field ActionData CameraRotateActionData @行为数据
---@field ControlCamera Camera @控制的摄像机
---@field RotateTweener DG.Tweening.Tweener @旋转Tweener
local CameraRotateStoryAction = _G.BaseClass("CameraRotateStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---CameraRotateStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraRotateStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraRotateStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraRotateStoryAction:Excute()
    --TODO:摄像机旋转代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoCameraRotation()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function CameraRotateStoryAction:DoWaitExecuteAction()
    self:DoCameraRotation(_G.handler(self, self.OnCameraRotateComplete))
end

---执行摄像机旋转
---@param completecb function @摄像机旋转完成回调
function CameraRotateStoryAction:DoCameraRotation(completecb)
    self.ControlCamera = _G.StoryUtilities.GetMainCamera(self)
    self.RotateTweener =
        self.ControlCamera:DORotateQuaternion(
        self.ActionData.CameraTargetQuaternion[1],
        self.ActionData.CameraTargetQuaternion[2],
        self.ActionData.CameraTargetQuaternion[3],
        self.ActionData.CameraTargetQuaternion[4],
        self.ActionData.DurationTime,
        completecb
    )
end

---摄像机旋转完成
function CameraRotateStoryAction:OnCameraRotateComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function CameraRotateStoryAction:DoMustDoForSkip()
    if self.RotateTweener ~= nil then
        self.RotateTweener:Kill(true)
    else
        if self.ControlCamera == nil then
            self.ControlCamera = self:GetMainCamera()
        end
        self.ControlCamera:SetRotation(
            self.ActionData.CameraTargetPosition.x,
            self.ActionData.CameraTargetPosition.y,
            self.ActionData.CameraTargetPosition.z
        )
    end
end

---剧情动作退出
function CameraRotateStoryAction:Exit()
    base.Exit(self)
end

---清除数据
function CameraRotateStoryAction:ResetData()
    self.ControlCamera = nil
    self.RotateTweener = nil
end

---@type CameraRotateStoryAction @摄像机旋转剧情行为
return CameraRotateStoryAction
