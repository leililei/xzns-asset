local base = _G.BaseStoryAction
---@class WorldStoryItemCreateStoryAction : BaseStoryAction @世界物体创建 剧情行为
---@field ActionData WorldStoryItemCreateActionData @行为数据
---@field WorldItem WorldBaseItem @世界对象
local WorldStoryItemCreateStoryAction = _G.BaseClass("WorldStoryItemCreateStoryAction", base)
WorldStoryItemCreateStoryAction.WorldItem = nil

---WorldStoryItemCreateStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldStoryItemCreateStoryAction:__init(storyactionid)
    self.tiemr_fShowTime = nil
    self.dissolve = nil
    self.isCreate = false
end
function WorldStoryItemCreateStoryAction:Dispose()
    self.isCreate = nil
end

---剧情动作进入
function WorldStoryItemCreateStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldStoryItemCreateStoryAction:Excute()
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemShowAction()
    end
    base.Excute(self)
end

---执行世界物体显示控制操作
function WorldStoryItemCreateStoryAction:DoWorldItemShowAction(completecb)
    if self.isCreate then
        return
    end
    self.isCreate = true
    _G.StoryUtilities.CreateStoryItem(
        self.ActionData.UID,
        self.ActionData.SID,
        self.ActionData.posX,
        self.ActionData.posZ,
        self.ActionData.rotX,
        self.ActionData.rotY,
        self.ActionData.rotZ,
        completecb,
        self.ActionData.extra
    )
end

---跳过剧情行为必须做的部分
function WorldStoryItemCreateStoryAction:DoMustDoForSkip()
    if self.isCreate then
        return
    end
    self.isCreate = true
    _G.StoryUtilities.CreateStoryItem(
        self.ActionData.UID,
        self.ActionData.SID,
        self.ActionData.posX,
        self.ActionData.posZ,
        self.ActionData.rotX,
        self.ActionData.rotY,
        self.ActionData.rotZ,
        nil,
        self.ActionData.extra
    )
end

---剧情动作退出
function WorldStoryItemCreateStoryAction:Exit()
    if self.tiemr_fShowTime ~= nil then
        _G.coroutine.stopwaiting(self.tiemr_fShowTime)
        self.tiemr_fShowTime = nil
    end
    if self.dissolve ~= nil then
        self.dissolve.enabled = false
        self.dissolve = nil
    end
    base.Exit(self)
end
---动画完成
function WorldStoryItemCreateStoryAction:OnComplete()
    self:ActionExecuteCompleteCB()
end
---执行等待完成行为的相关代码
function WorldStoryItemCreateStoryAction:DoWaitExecuteAction()
    self:DoWorldItemShowAction(_G.handler(self, self.OnComplete))
end

---重置剧情行为播放数据
function WorldStoryItemCreateStoryAction:ResetData()
    self.WorldItem = nil
    base.ResetData(self)
end

---@type WorldStoryItemCreateStoryAction @世界物体显示剧情行为
return WorldStoryItemCreateStoryAction
