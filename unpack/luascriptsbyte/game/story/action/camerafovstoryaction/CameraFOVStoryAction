---@class CameraFOVStoryAction : BaseStoryAction @摄像机FOV改变剧情行为
---@field ActionData CameraFOVActionData @行为数据
local CameraFOVStoryAction = _G.BaseClass("CameraFOVStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---CameraFOVStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function CameraFOVStoryAction:__init(storyactionid)
end

---剧情动作进入
function CameraFOVStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function CameraFOVStoryAction:Excute()
    ---@type UnityEngine.Camera
    local maincamera = _G.GraphicsManager.Instance.MainCamera
    maincamera.fieldOfView = self.ActionData.TargetFOV * _G.CS.Launcher.Inst.FovScale
    base.Excute(self)
end

---剧情动作退出
function CameraFOVStoryAction:Exit()
    base.Exit(self)
end

---@type CameraFOVStoryAction @摄像机FOV改变剧情行为
return CameraFOVStoryAction
