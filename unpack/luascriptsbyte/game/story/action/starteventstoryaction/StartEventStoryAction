---@class StartEventStoryAction : BaseStoryAction @修改玩家主控角色
---@field ActionData CameraRotateActionData @行为数据
local StartEventStoryAction = _G.BaseClass("StartEventStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---StartEventStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function StartEventStoryAction:__init(storyactionid)
end

---剧情动作进入
function StartEventStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function StartEventStoryAction:Excute()
    --TODO:摄像机旋转代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:DoFun()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function StartEventStoryAction:DoWaitExecuteAction()
    self:DoFun(_G.handler(self, self.OnComplete))
end

---执行内容
---@param completecb function @摄完成回调
function StartEventStoryAction:DoFun(completecb)
    local isStart = _G.EventManager:GetInstance():StartEvent(_G.tonumber(self.ActionData.data_EventID), completecb)
    if isStart == false then
        if _G.AppSetting.DEBUG then
            _G.LogError(" 事件无法执行 事件id:" .. self.ActionData.data_EventID)
        end
    end
end

---摄像机旋转完成
function StartEventStoryAction:OnComplete()
    self:ActionExecuteCompleteCB()
end

---跳过剧情行为必须做的部分
function StartEventStoryAction:DoMustDoForSkip()
end

---剧情动作退出
function StartEventStoryAction:Exit()
    base.Exit(self)
end

---清除数据
function StartEventStoryAction:ResetData()
    -- self.ControlCamera = nil
    -- self.RotateTweener = nil
end

---@type StartEventStoryAction @修改玩家主控角色
return StartEventStoryAction
