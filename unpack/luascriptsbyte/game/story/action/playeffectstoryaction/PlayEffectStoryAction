---@class PlayEffectStoryAction : BaseStoryAction @播放特效剧情行为
---@field ActionData PlayEffectActionData @行为数据
---@field EffectGo UnityEngine.GameObject @特效实体对象
local PlayEffectStoryAction = _G.BaseClass("PlayEffectStoryAction", _G.BaseStoryAction)
PlayEffectStoryAction.EffectGo = nil

local base = _G.BaseStoryAction

---PlayEffectStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function PlayEffectStoryAction:__init(storyactionid)
end

---剧情动作进入
function PlayEffectStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function PlayEffectStoryAction:Excute()
    --TODO:摄像机移动代码待添加
    if self.ActionData.WaitExecuteComplete == false then
        self:StartPlay()
    end
    base.Excute(self)
end

---执行等待完成行为的相关代码
function PlayEffectStoryAction:DoWaitExecuteAction()
    self:StartPlay(_G.handler(self, self.OnPlayComplete))
end

---剧情动作执行
function PlayEffectStoryAction:StartPlay(completecb)
    local parent = nil
    if not _G.IsNil(self.ActionData.npcuid) then
        local npc = nil
        ---摄像机
        if self.ActionData.npcuid == -999 then
            local camera = _G.StoryUtilities.GetMainCamera(self)
            if camera ~= nil then
                parent = (camera.gameObject)
            end
        elseif self.ActionData.npcuid == 0 then
            npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(_G.PlayerModel:GetInstance().role_uid)
        else
            npc = self.StoryStepOwner.StoryOwner.StoryOwner.StoryPlayOwner:GetStoryItem(self.ActionData.npcuid)
            if npc == nil then
                npc = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.npcuid)
            end
        end

        if not _G.IsNil(npc) then
            parent = npc:GetChildNode(self.ActionData.nodepath)
        end
    end
    if _G.IsNil(parent) then
        parent = _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.InfoLayer.Name)
    end
    local cfg = _G.ConfigManager.ui_effect_cfg[self.ActionData.EffectName]
    if cfg ~= nil and parent ~= nil then
        _G.UIUtils.LoadEffectByCfg(cfg, parent, _G.handler(self, self.OnLoadEffectComplete), completecb)
        if completecb == nil then
            --- 如果不等待就直接完成
            self:OnPlayComplete()
        end
        return
    end
    if completecb ~= nil then
        completecb()
    end
end

---剧情动作退出
function PlayEffectStoryAction:Exit()
    -- _G.GameObject.Destroy(self.EffectGo)
    base.Exit(self)
end

---清除数据
function PlayEffectStoryAction:ResetData()
    self.EffectGo = nil
    _G.BaseStoryAction:ResetData(self)
end
---跳过剧情行为必须做的部分
function PlayEffectStoryAction:DoMustDoForSkip()
end
---响应特效加载完成
---@param obj UnityEngine.Transform @特效Transform
function PlayEffectStoryAction:OnLoadEffectComplete(obj)
    self.EffectGo = obj
end
function PlayEffectStoryAction:OnPlayComplete()
    self:ActionExecuteCompleteCB()
end
---@type PlayEffectStoryAction @播放特效剧情行为
return PlayEffectStoryAction
