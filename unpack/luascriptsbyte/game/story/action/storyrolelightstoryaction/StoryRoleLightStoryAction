---@class StoryRoleLightStoryAction : BaseStoryAction @剧情角色光源
---@field ActionData StoryRoleLightActionData @行为数据
local StoryRoleLightStoryAction = _G.BaseClass("StoryRoleLightStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---DialogueShowStoryAction的构造函数
---@param storyactionid number @行为ID
function StoryRoleLightStoryAction:__init(storyactionid)
end

function StoryRoleLightStoryAction:Enter()
    local lightObj = _G.StoryManager:GetInstance():GetLight(self.ActionData.key)
    if self.ActionData.isShow and lightObj == nil then
        _G.PoolsManager:GetInstance():Spawn(
            "UI/Dialogue/Point_light_dialogue",
            _G.ePoolType.Temporary,
            nil,
            function(tran)
                tran:SetName("dialogueLight_" .. self.ActionData.key)
                tran:SetActiveE(0)
                _G.StoryManager:GetInstance():SetLight(self.ActionData.key, tran)
                base.Enter(self)
            end
        )
    else
        base.Enter(self)
    end
end

---剧情动作执行
function StoryRoleLightStoryAction:Excute()
    local okFun = function()
        base.Excute(self)
    end
    ---@type UnityEngine.GameObject
    local lightObj = _G.StoryManager:GetInstance():GetLight(self.ActionData.key)
    if self.ActionData.isShow then
        lightObj:SetActiveE(1)
    else
        _G.StoryManager:GetInstance():SetLight(self.ActionData.key, nil)
        okFun()
        return
    end
    local Pos = self.ActionData.Pos
    if Pos[1] ~= nil then
        lightObj:SetPosition(Pos[1], Pos[2], Pos[3])
    end
    local Rot = self.ActionData.Rot
    if Rot[1] ~= nil then
        _G.CS.UnityObjectExtends.SetRot(lightObj, Rot[1], Rot[2], Rot[3])
    end
    local CustomLightInfo = lightObj:GetComponentE(_G.typeof(_G.CS.FrameWork.Graphic.CustomLight.CustomLightInfo))
    if self.ActionData.LightType ~= nil then
        local typeDic = {
            ["Spot"] = _G.CS.UnityEngine.LightType.Spot,
            ["Directional"] = _G.CS.UnityEngine.LightType.Directional,
            ["Point"] = _G.CS.UnityEngine.LightType.Point,
            ["Area"] = _G.CS.UnityEngine.LightType.Area,
            ["Rectangle"] = _G.CS.UnityEngine.LightType.Rectangle,
            ["Disc"] = _G.CS.UnityEngine.LightType.Disc
        }
        local type = typeDic[self.ActionData.LightType]
        if type ~= nil then
            CustomLightInfo.lightType = typeDic[self.ActionData.LightType]
        else
            self:Log(" 没有此 LightType " .. self.ActionData.LightType)
        end
    end

    if self.ActionData.Range ~= nil then
        CustomLightInfo.range = self.ActionData.Range
    end
    if self.ActionData.Color ~= nil then
        CustomLightInfo.lightColor = require("CardInfoManager").GetColorFromRGB(self.ActionData.Color)
    end
    if self.ActionData.Intensity ~= nil then
        CustomLightInfo.intensity = self.ActionData.Intensity
    end
    okFun()
end

---跳过剧情行为必须做的部分
function StoryRoleLightStoryAction:DoMustDoForSkip()
    if self.ActionData.isShow == false then
        _G.StoryManager:GetInstance():SetLight(self.ActionData.key, nil)
    end
end

---退出
function StoryRoleLightStoryAction:Exit()
    base.Exit(self)
end
---@type StoryRoleLightStoryAction @字幕行为
return StoryRoleLightStoryAction
