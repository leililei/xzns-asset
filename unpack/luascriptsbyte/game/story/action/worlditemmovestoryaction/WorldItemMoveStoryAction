---@class WorldItemMoveStoryAction : BaseStoryAction @世界对象移动剧情行为
---@field ActionData WorldItemMoveActionData @行为数据
---@field WorldItem WorldBaseItem @操控的世界对象
---@field TempCB function @临时寻路回调
local WorldItemMoveStoryAction = _G.BaseClass("WorldItemMoveStoryAction", _G.BaseStoryAction)
WorldItemMoveStoryAction.WorldItem = nil
WorldItemMoveStoryAction.TempCB = nil

local base = _G.BaseStoryAction

---WorldItemMoveStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function WorldItemMoveStoryAction:__init(storyactionid)
end

---剧情动作进入
function WorldItemMoveStoryAction:Enter()
    base.Enter(self)
end

---剧情动作执行
function WorldItemMoveStoryAction:Excute()
    if self.ActionData.WaitExecuteComplete == false then
        self:DoWorldItemMove()
    end
    base.Excute(self)
end

---执行世界物体移动
---@param completecb function @移动完成回调
function WorldItemMoveStoryAction:DoWorldItemMove(completecb)
    ---@type NavParam
    local navparam = {}
    navparam.Position = self.ActionData.TargetPosition

    local OverFun = function()
        if completecb ~= nil then
            completecb()
        end
    end

    self:SetWorldItem()
    if self.WorldItem ~= nil then
        navparam.Object = self.WorldItem
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到UID:%d的世界对象，移动失败!", self.ActionData.UID))
        end
        OverFun()
        return
    end

    -- navparam.Speed = navparam.Object.MoveSpeed * self.ActionData.SpeedMultiple
    navparam.Speed = 5 * self.ActionData.SpeedMultiple
    local navitem, navstate = _G.NavManager:GetInstance():DoNavMove(navparam, OverFun)
    if navstate == _G.NavState.Success then
        --navitem:AddListener(_G.NavItemEvent, _G.NavItemEvent.EnumValue.NavComplete, OverFun, self, true)
        _G.Events:GetInstance():AddListener(_G.eNav.NavInterruptMove, self.OnMoveToComplete, self)
    else
        OverFun()
    end
end

---执行等待完成行为的相关代码
function WorldItemMoveStoryAction:DoWaitExecuteAction()
    self:DoWorldItemMove(_G.handler(self, self.OnMoveToComplete))
end

---跳过剧情行为必须做的部分
function WorldItemMoveStoryAction:DoMustDoForSkip()
    --让世界对象停下来确保移动完成
    self:SetWorldItem()
    if self.WorldItem ~= nil then
        self.WorldItem:Move(0)
        self.WorldItem.Transform:SetPosition(
            self.ActionData.TargetPosition.x,
            self.ActionData.TargetPosition.y,
            self.ActionData.TargetPosition.z
        )
    else
        _G.StoryUtilities.Log_NoFindWorldItem(self)
    end
end

function WorldItemMoveStoryAction:SetWorldItem()
    if self.WorldItem == nil then
        if self.ActionData.UID == 0 then
            self.WorldItem = _G.WorldManager:GetInstance():GetCurWorldPlayer()
        else
            self.WorldItem = _G.WorldManager:GetInstance():GetCurWorld():GetItemInfo(self.ActionData.UID)
        end
    end
end
---剧情动作退出
function WorldItemMoveStoryAction:Exit()
    base.Exit(self)
end

---实体对象移动到指定位置完成
function WorldItemMoveStoryAction:OnMoveToComplete()
    self:ActionExecuteCompleteCB()
end

---清除数据
function WorldItemMoveStoryAction:ResetData()
    self.WorldItem = nil

    _G.Events:GetInstance():RemoveListener(_G.eNav.NavInterruptMove, self.OnMoveToComplete, self)
    base.ResetData(self)
end

---@type WorldItemMoveStoryAction @世界对象移动剧情行为
return WorldItemMoveStoryAction
