---@class PlayCGStoryAction : BaseStoryAction @播放CG视频剧情行为
---@field ActionData PlayCGActionData @行为数据
local PlayCGStoryAction = _G.BaseClass("PlayCGStoryAction", _G.BaseStoryAction)

local base = _G.BaseStoryAction

---PlayCGStoryAction的构造函数
---@param storyactionid number @剧情行为ID
function PlayCGStoryAction:__init(storyactionid)
end

---剧情动作进入
function PlayCGStoryAction:Enter()
    _G.UIUtils.Preload(
        _G.ConfigManager.video_cfg[self.ActionData.CGKey],
        function()
            base.Enter(self)
        end
    )
end

---剧情动作执行
function PlayCGStoryAction:Excute()
    if self.ActionData.Mute == 1 and _G.CS.GameAudioManager.Inst then
        _G.CS.GameAudioManager.Inst:PauseMusic()
    end

    self.PlayCount = 1
    _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg[self.ActionData.CGKey], _G.handler(self, self.OnVideoPlayComplete))

    --- 如果 需要CG上显示对话
    if self.ActionData.DialogueID ~= 0 then
        self.PlayCount = 2
        ---隐藏CG跳过按钮
        _G.UIUtils.ShowVideoSkipBtn(false)

        _G.StoryManager:GetInstance():PlayDialogueView(
            self.ActionData.DialogueID,
            _G.handler(self, self.OnVideoPlayComplete)
        )

        --- 等两次 等待界面页面层级等初始化完成 在设置父级

        self.Timer = _G.TimerManager:GetInstance():GetTimer(5, self.GetTimerCallBack, self, false, true)
        self.Timer:Start()
    end

    -- _G.StoryManager:GetInstance():PlayDialogueView(810010201, )
end

function PlayCGStoryAction:GetTimerCallBack(elapsed)
    local wait = 2
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DialogueView.Name)
    --- 提高对话层级
    if view and view.View and view.gameObject ~= nil then
        wait = wait - elapsed
        if wait < 1 then
            _G.UIManager:GetInstance():ChangeCanvasOrderByTransform(view.gameObject, 11000)

            self:StopTimer()
        end
    end
end

---剧情动作退出
function PlayCGStoryAction:Exit()
    self:StopTimer()
    base.Exit(self)
end
function PlayCGStoryAction:StopTimer()
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
end
---响应视频播放完成
function PlayCGStoryAction:OnVideoPlayComplete(_, DialogueClosetype)
    if DialogueClosetype == 1 then
        self.PlayCount = 0
    else
        _G.UIUtils.ShowVideoSkipBtn(_G.ConfigManager.video_cfg[self.ActionData.CGKey].isShowSkipBtn)
        self.PlayCount = self.PlayCount - 1
    end
    if self.PlayCount > 0 then
        return
    end
    self.PlayCount = 99
    if self.ActionData.Mute == 1 and _G.CS.GameAudioManager.Inst then
        _G.CS.GameAudioManager.Inst:ContinueMusic()
    end
    _G.UIUtils.CloseVideo()
    self:ActionExecuteCompleteCB()
end

---@type PlayCGStoryAction @播放CG视频剧情行为
return PlayCGStoryAction
