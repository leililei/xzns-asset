require "BaseEntityEvent"

---Note:
---不受限于后端同步位置等，用于纯表现
---具体受谁管理，由创建完成后的逻辑决定

---@class BaseEntity : BaseEvent @世界物体基类[abstract]
---@field UID number @物体UID
---@field SID number @物体SID
---@field PoolType ePoolType @资源加载的池类型(外部设置更改，否则默认ePoolType.Default)
---@field InstanceID number @根节点实例对象UID
---@field LoadResPrepreaCoroutine coroutine @资源加载准备携程
---@field RootGameObject UnityEngine.GameObject @根节点
---@field RootTransform UnityEngine.Transform @根节点Transform
---@field EntityGo UnityEngine.GameObject @实体对象
---@field EntityTransform UnityEngine.Transform @实体对象Transform
local BaseEntity = _G.BaseClass("BaseEntity", _G.BaseEvent)
BaseEntity.UID = nil
BaseEntity.SID = nil
BaseEntity.PoolType = nil
BaseEntity.InstanceID = nil
BaseEntity.RootGameObject = nil
BaseEntity.RootTransform = nil
BaseEntity.EntityGo = nil
BaseEntity.EntityTransform = nil

---BaseEntity构造函数
---@param uid number @Entity UID
---@param sid number @Entity SID
function BaseEntity:__init(uid, sid)
    self.UID = uid
    self.SID = sid
    --默认Default池
    self.PoolType = _G.ePoolType.Default
    self.RootGameObject = _G.GameObject()
    self.RootTransform = self.RootGameObject
    self.InstanceID = self.RootGameObject:GetInstanceIDE()
    --默认名字格式:UID+"_"+SID+"_"+InstanceID
    self.RootGameObject.name = uid .. "_" .. sid .. "_" .. self.InstanceID

    self.LoadResPrepreaCoroutine = _G.coroutine.start(_G.handler(self, self.PrepareLoadAssetCoroutine))
end

---准备加载资源
function BaseEntity:PrepareLoadAssetCoroutine()
    --等一帧，让逻辑先行
    _G.coroutine.waitforendofframe()
    self:StartLoadAsset()
end

---开始加载资源[abstract](子类重写后调用DoLoadAsset加载资源)
function BaseEntity:StartLoadAsset()
end

---真实加载资源(子类调用)
---@param respath string @资源路径
function BaseEntity:DoLoadAsset(respath)
    _G.PoolsManager:GetInstance():Spawn(
        respath,
        self.PoolType,
        self.RootTransform,
        function(tran)
            self.EntityTransform = tran
            self.EntityGo = tran
            self:OnLoadAssetComplete()
            self:DispatchEvent(_G.BaseEntityEvent, _G.BaseEntityEvent.EnumValue.ResLoadedComplete, self)
        end
    )
end

---加载资源完成(子类重写写资源加载完成后的后续逻辑)
function BaseEntity:OnLoadAssetComplete()
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("Entity UID:%d SID:%d实体对象资源加载完成!", self.UID, self.SID))
    end
end

---更新接口[virtual](上层管理类负责调用)
function BaseEntity:Update()
end

---设置朝向
---@param forward UnityEngine.Vector3 @新的朝向
function BaseEntity:SetDirection(forward)
    self.RootTransform.forward = forward
end

---销毁接口(上层管理类负责调用)
function BaseEntity:Destroy()
    if _G.AppSetting.DEBUG then
        _G.Log("BaseEntity:Destroy()")
    end
    _G.GameObject.Destroy(self.RootGameObject)
    self.UID = nil
    self.SID = nil
    self.PoolType = nil
    self.InstanceID = nil
    self.RootGameObject = nil
    self.RootTransform = nil
    self.EntityGo = nil
    self.EntityTransform = nil
end

---@type BaseEntity
_G.BaseEntity = BaseEntity
---@type BaseEntity
return BaseEntity
