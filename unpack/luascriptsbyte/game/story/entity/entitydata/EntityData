---@class EntityData @世界实体数据定义
---@field AnimNames EnityAnimName @动画名
---@field EntityType EEntityType @实体类型
---@field EntityMoveType EEntityMoveType @实体移动类型
---@field EntityTypeScriptMap EntityTypeScriptMap @任务类型与脚本名映射Map
local EntityData = {}
---@class EnityAnimName @世界实体动画常量定义
---@field MOVE string @移动动画名
---@field IDLE string @闲置动画名
---@field WALK string @走动动画名
EntityData.AnimNames = {
    MOVE = "Run",
    IDLE = "Idle",
    WALK = "Walk"
}

---实体移动类型
local EEntityMoveTypeSource = {
    "Run",
    "Walk"
}
---@class EEntityMoveType @实体移动方式类型
---@field Run number @跑动
---@field Walk number @走动
EntityData.EntityMoveType = _G.CreatEnumTable(EEntityMoveTypeSource, 0)

---实体类型
local EEntityTypeSource = {
    "Player",
    "NPC",
    "Monster",
    "CollectItem"
}
---@class EEntityType @实体类型
---@field Player number @场景玩家对象
---@field NPC number @NPC
---@field Monster number @NPC
---@field CollectItem number @采集物
EntityData.EntityType = _G.CreatEnumTable(EEntityTypeSource, 1)

---Note:
---世界实体类型和对应脚本名源至EntityData.EntityType里的定义
---取名规则:与EEntityTypeSource里的Key+Entity后缀
--print("世界实体类型脚本映射Map数据初始化:")
---@class EntityTypeScriptMap @世界实体类型与脚本名映射Map
local entitytypescriptmap = {}
for k, v in pairs(EntityData.EntityType) do
    entitytypescriptmap[v] = k .. "Entity"
    -- print(string.format("实体类型:%d,实体对应脚本名:%s", v, entitytypescriptmap[v]))
end
---@type EntityTypeScriptMap @任务类型与脚本名映射Map
EntityData.EntityTypeScriptMap = entitytypescriptmap

---@type EntityData @世界实体数据定义
_G.EntityData = EntityData
---@type EntityData @世界实体数据定义
return EntityData
