---@class GameBaseEntity : BaseEntity @游戏实体基类[abstract]
---@field public EntityType EEntityType @物体对象类型
---@field protected CurrentAnimName string @当前播放的动画名
---@field protected CurrentMoveType EEntityMoveType @当前实体移动方式
---@field protected NavNodes UnityEngine.AI.NavMeshPath 寻路数据
---@field protected MoveSpeed number @移动速度
---@field protected MoveStep number @移动步数, 0= 没有移动 0>表示正在移动
---@field protected IsUnderMoveTo boolean @是否处于移动到指定位置中
---@field protected MoveToNextNodeTimer Timer @移动到下一个点的定时器
---@field public AnimatorComponent UnityEngine.Animator @动画组件
local GameBaseEntity = _G.BaseClass("GameBaseEntity", _G.BaseEntity)
GameBaseEntity.EntityType = nil
GameBaseEntity.CurrentAnimName = nil
GameBaseEntity.CurrentMoveType = nil
GameBaseEntity.NavNodes = nil
GameBaseEntity.MoveSpeed = nil
GameBaseEntity.MoveStep = nil
GameBaseEntity.IsUnderMoveTo = nil
GameBaseEntity.MoveToNextNodeTimer = nil
GameBaseEntity.AnimatorComponent = nil

---GameBaseEntity构造函数
---@param uid number @Entity UID
---@param sid number @Entity SID
function GameBaseEntity:__init(uid, sid)
    self.MoveSpeed = 5
    self.MoveStep = 0
    self.CurrentAnimName = _G.EntityData.AnimNames.IDLE
    self.CurrentMoveType = _G.EntityData.EntityMoveType.Run
    self.NavNodes = _G.CS.UnityEngine.AI.NavMeshPath()
    self.IsUnderMoveTo = false
end

---加载资源完成(子类重写写资源加载完成后的后续逻辑)
function GameBaseEntity:OnLoadAssetComplete()
    self.AnimatorComponent = self.EntityGo:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---移动(比如摇杆一直控制那种)
---@param moveStep number 移动状态
---@param movetype EEntityMoveType @移动类型
---@param interuptmoveto boolean @是否打断目标地点移动
function GameBaseEntity:Move(moveStep, movetype, interuptmoveto)
    movetype = movetype or _G.EntityData.EntityMoveType.Run
    self.CurrentMoveType = movetype
    interuptmoveto = interuptmoveto or true
    if interuptmoveto and self.IsUnderMoveTo == true then
        if self.MoveToNextNodeTimer ~= nil then
            self.MoveToNextNodeTimer:Stop()
            self.MoveToNextNodeTimer = nil
        end
        self.IsUnderMoveTo = false
        self:DispatchEvent(_G.BaseEntityEvent, _G.BaseEntityEvent.EnumValue.InteruptMoveTo, self)
    end

    self.MoveStep = moveStep
    if self.MoveStep == 0 then
        self:PlayAnim(_G.EntityData.AnimNames.IDLE)
    else
        local moveanimname = _G.EntityData.AnimNames.MOVE
        if movetype == _G.EntityData.EntityMoveType.Walk then
            moveanimname = _G.EntityData.AnimNames.WALK
        else
            moveanimname = _G.EntityData.AnimNames.MOVE
        end
        self:PlayAnim(moveanimname)
    end
end

---移动到指定位置
---@param destination UnityEngine.Vector3 @目标位置
---@param movetype EEntityMoveType @移动类型
function GameBaseEntity:MoveTo(destination, movetype)
    movetype = movetype or _G.EntityData.EntityMoveType.Run
    self.CurrentMoveType = movetype
    local isvalide =
        _G.CS.UnityObjectExtends.CalculatePath(
        self.RootTransform,
        destination.x,
        destination.y,
        destination.z,
        self.NavNodes
    )
    if isvalide then
        self:Move(1, self.CurrentMoveType, false)
        self:MoveToNextNode(0)
        self.IsUnderMoveTo = true
        self:DispatchEvent(_G.BaseEntityEvent, _G.BaseEntityEvent.EnumValue.StartMoveTo, self)
    else
        if _G.AppSetting.DEBUG then
            _G.Log("无有效路径")
        end
        self:Move(0, self.CurrentMoveType)
        self.IsUnderMoveTo = false
    end
end

---移动到下一个点
---@param index number @路点索引值
function GameBaseEntity:MoveToNextNode(index)
    if _G.AppSetting.DEBUG then
        _G.Log(string.format("GameBaseEntity:MoveToNextNode(%d)", index))
    end
    local corners = self.NavNodes.corners
    local len = corners.Length
    if index < len then
        if _G.AppSetting.DEBUG then
            _G.Log(string.format("移动到第%d的路点", index + 1))
        end
        local to = corners[index]
        local delay = self.RootTransform:SetDirection(to.x, to.y, to.z, self.MoveSpeed)
        self:Move(1, self.CurrentMoveType, false)
        self.MoveToNextNodeTimer =
            _G.TimerManager:GetInstance():GetTimer(delay, self.MoveToNextNode, self, true, false, true, index + 1)
        self.MoveToNextNodeTimer:Start()
    else
        self.MoveToNextNodeTimer = nil
        self.NavNodes:ClearCorners()
        self:Move(0)
        self:DispatchEvent(_G.BaseEntityEvent, _G.BaseEntityEvent.EnumValue.CompleteMoveTo, self)
    end
end

---播放动画
---@param name string 动画名称
---@return float @动画时长
function GameBaseEntity:PlayAnim(name)
    if self.AnimName ~= nil and self.AnimName == name then
        return
    end
    self.AnimName = name

    if not self.AnimatorComponent and not self.RootGameObject and 0 == self.RootGameObject:GetctiveInHierarchy() then
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log(string.format("EntityType:%s UID:%d 播放动画:%s", self.EntityType, self.UID, self.AnimName))
    end
    local timelength = _G.CS.AnimatorExtends.GetAnimationClipLength(self.AnimatorComponent, name)
    self.AnimatorComponent:CrossFade(self.AnimName, 0.1)
    return timelength
end

---更新接口[virtual](上层管理类负责调用)
function GameBaseEntity:Update()
    --普通移动通过Update调整方向，MoveTo自身携程调整方向
    if self.MoveStep ~= 0 and self.IsUnderMoveTo == false then
        self.RootTransform:SetForwardPosition(self.MoveSpeed, 1, 1)
    end
end

---对象销毁
function GameBaseEntity:Destroy()
    if _G.AppSetting.DEBUG then
        _G.Log("GameBaseEntity:Destroy()")
    end
    if self.MoveToNextNodeTimer ~= nil then
        self.MoveToNextNodeTimer:Stop()
    end
    -- 父类方法的典型调用方式：父类类名.方法名(self)
    -- Note:
    -- self.super在多重继承下有潜在问题：
    -- 比如C继承B，B继承A，A和B都实现F方法，但C没实现F方法
    -- 此时C对象实例调用C:F()方法
    -- C:F()方法里写self.super.F(self)会导致这里的第一个self还是C，导致死循环
    _G.BaseEntity.Destroy(self)
    self.EntityType = nil
    self.CurrentAnimName = nil
    self.CurrentMoveType = nil
    self.NavNodes = nil
    self.MoveSpeed = nil
    self.MoveStep = nil
    self.IsUnderMoveTo = nil
    self.MoveToNextNodeTimer = nil
    self.AnimatorComponent = nil
end

---@type GameBaseEntity
_G.GameBaseEntity = GameBaseEntity
---@type GameBaseEntity
return GameBaseEntity
