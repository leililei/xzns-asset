---@class NPCEntity : GameBaseEntity @NPC实体对象
local NPCEntity = _G.BaseClass("NPCEntity", _G.GameBaseEntity)

---NPCEntity构造函数
function NPCEntity:__init(uid, sid)
end

---开始加载资源
function NPCEntity:StartLoadAsset()
    ---@type npc_world_cfg_Item
    local npccfg = _G.ConfigManager.object_world_cfg[self.SID]
    self:DoLoadAsset(npccfg.Res)
end

---@type NPCEntity
_G.NPCEntity = NPCEntity
---@type NPCEntity
return NPCEntity
