--- Note:
--- 此工具创建的对象是纯表现，不受主世界控制的(非WorldBaseItem那一套)

local EntityTypeScriptMap = _G.EntityData.EntityTypeScriptMap

---@class EntityUtilities @世界物体(纯表现)工具类
local EntityUtilities = {}

---创建一个Entity
---@param uid number @物体UID
---@param sid number @物体SID
---@param entitytype EEntityType @物体类型
---@return GameBaseEntity @物体Entity
function EntityUtilities.CreateEntity(uid, sid, entitytype)
    if _G.AppSetting.DEBUG then
        _G.Log("EntityUtilities.CreateEntity()")
    end
    if EntityTypeScriptMap[entitytype] ~= nil then
        local realentityscriptpath = string.format("Game.Story.Entity.%s", EntityTypeScriptMap[entitytype])

        if _G.AppSetting.DEBUG then
            _G.Log(string.format("创建实体类型:%s脚本路径:%s的行为数据!", entitytype, realentityscriptpath))
        end
        local realentity = require(realentityscriptpath)
        local realentityinstance = realentity.New(uid, sid)
        realentityinstance.EEntityType = entitytype
        return realentityinstance
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("未定义的实体类型:%s,创建Entity对象失败!", entitytype))
        end
    end
end

---@type EntityUtilities
_G.EntityUtilities = EntityUtilities
---@type EntityUtilities
return EntityUtilities
