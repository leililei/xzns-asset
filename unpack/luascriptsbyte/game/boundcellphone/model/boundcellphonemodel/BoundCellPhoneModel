---@class BoundCellPhoneModel:GameDataModelBase
local BoundCellPhoneModel = BaseClass("BoundCellPhoneModel",GameDataModelBase)
local SDKProxy = require("SDKProxy")

---创建对象时,入口构造函数
function BoundCellPhoneModel:__init()
    self.maxTimer = 60
    self.timeShengYu = 0
    self.isShowBtn = false
    self.isSendIng = false
    self.rewardId = 201016
end

function BoundCellPhoneModel:playTimer()
    self.timeShengYu = self.maxTimer

    if self.ShengYuTimers == nil then
        self.ShengYuTimers = _G.TimerManager:GetInstance():GetTimer(1, self.PoolTimer, self, false, false, true)
        self.ShengYuTimers:Start()
    end
end

---讨伐中倒计时--
function BoundCellPhoneModel:PoolTimer(elapsed)
    self.timeShengYu = self.timeShengYu - elapsed
    if self.timeShengYu <= 0 then
        self.timeShengYu = 0
        if self.ShengYuTimers then
            self.ShengYuTimers:Stop()
            self.ShengYuTimers = nil
        end
        return
    end
end

function BoundCellPhoneModel:Dispose()
    GameDataModelBase.Dispose(self)
    if self.ShengYuTimers then
        self.ShengYuTimers:Stop()
        self.ShengYuTimers = nil
    end
end

function BoundCellPhoneModel:GetDataFormServer()
    if GameUtil.GetFunctionBlockState(_G.FunctionBlock.LinkMobile) then
        GameDataModelBase.ParseData(self)
    else
        SDKProxy:SendExtend("getThirdSDKInfo", (_G.handler(self, self.ParseData)))
    end
end

function BoundCellPhoneModel:ParseData(isok,data)
    if AppSetting.IsEditor then
        self.isShowBtn = true
        GameDataModelBase.ParseData(self)
        return
    end
    if isok and data and data.collectPhone == 1 then
        self.isShowBtn = true
    else
        self.isShowBtn = false
    end
    GameDataModelBase.ParseData(self)
end

function BoundCellPhoneModel:GetIsShowBtn()
    return require("BoundCellPhoneModel"):GetInstance().isShowBtn
end

function BoundCellPhoneModel:EnterMainView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BoundCellPhoneView.Name, self)
end

function BoundCellPhoneModel:SendPhoneNumber(phone)
    if self.isSendIng then
        return
    end
    self.isSendIng = true
    local dictionary = {}
    dictionary["phone"] = phone
    SDKProxy:SendExtend("sendPhonecode", (_G.handler(self, self.GetPhoneNumberBack)), dictionary)
end

function BoundCellPhoneModel:GetPhoneNumberBack(isok,data)
    self.isSendIng = false
    if isok and data.state == "success" then
        --成功
        self:playTimer()

        _G.PopWindowManager:GetInstance():ShowAllTips(43,GetLangPackValue(99000000024))
    else
        --失败
        _G.PopWindowManager:GetInstance():ShowAllTips(43,GetLangPackValue(99000000025))
    end
end

function BoundCellPhoneModel:SendBoundCellPhone(phone,vcode)
    if self.isSendIng then
        return
    end
    if AppSetting.IsEditor then
        self.isSendIng = true
        self:BoundCellPhoneBack(true,{
            state = "success"
        })
        return
    end
    self.isSendIng = true
    local dictionary = {}
    dictionary["phone"] = phone
    dictionary["vcode"] = vcode
    SDKProxy:SendExtend("bindPhone", (_G.handler(self, self.BoundCellPhoneBack)), dictionary)
end

function BoundCellPhoneModel:BoundCellPhoneBack(isok,data)
    self.isSendIng = false
    if isok and data and data.state == "success" then
        --成功
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.BoundCellPhoneView.Name)
        --发起请求 获取奖励
        require("DouyinModel"):GetInstance():GetAward({self.rewardId})
        --_G.PopWindowManager:GetInstance():ShowAllTips(43,GetLangPackValue(99000000024))
        self.isShowBtn = false
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.BoundCellPhone)
        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.PhoneBinding.id)
    else
        --失败
        _G.PopWindowManager:GetInstance():ShowAllTips(43,GetLangPackValue(99000000025))
    end
end


return BoundCellPhoneModel