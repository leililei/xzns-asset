local TurnTerminalModel = require("TurnTerminalModel")
---@class TurnTerminalView : UIBaseView	中文描述
---@field public go_table TurnTerminalView_GoTable GoTable
local TurnTerminalView = _G.BaseClass("TurnTerminalView", _G.UIBaseView)

function TurnTerminalView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TurnTerminalView:OnCreate()
    self.index = 2
    self:InitToggle()
end

function TurnTerminalView:InitToggle()
    self.toggles = {
        _G.GetAutoGoTable(
            self.go_table.toggle_tab1,
            _G.handlerbind(self, self.OnClickToggle, 1)
        ),
        _G.GetAutoGoTable(
            self.go_table.toggle_tab2,
            _G.handlerbind(self, self.OnClickToggle, 2)
        )
    }
    self.toggles[1].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 2)
    self.toggles[2].obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 1)
    self.go_table["toggle_tab" .. self.index].isOn = false
    self.go_table["toggle_tab" .. self.index].isOn = true
end

function TurnTerminalView:OnClickToggle(go, isOn, key)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    self.go_table["obj_view" .. key]:SetActiveE(isOn and 1 or 0)
    if isOn then
        self.index = key
        self:RefreshView()
    end
end

function TurnTerminalView:RefreshView()
    if self.index == 2 then
        self:RefreshFollowPanel()
    else
        self:RefreshLoginPanel()
    end
end

--region 关注领奖
---刷新关注领奖
function TurnTerminalView:RefreshFollowPanel()
    if not self.followTb then
        self.followTb = _G.GetAutoGoTable(self.go_table.obj_view2, _G.handler(self, self.OnClickFollowBtn))
        self.followTb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 1)
        ---关注奖励
        self.followTb.itemTb1 = _G.GetAutoGoTable(self.followTb.obj_item1, _G.handler(self, self.OnClickFollowBtn))
        ---登录7天汇总奖励
        self.followTb.itemTb2 = _G.GetAutoGoTable(self.followTb.obj_item2, _G.handler(self, self.OnClickFollowBtn))

        if AppSetting.IsXzns then
            self.followTb.aorrawimage_code:LoadImage( _G.GameUtil.GetFunctionData(_G.FunctionBlock.transferQRcode))
        else
            if TurnTerminalModel:GetInstance().codeImgPath then
                self.followTb.aorrawimage_code:LoadImage(TurnTerminalModel:GetInstance().codeImgPath)
            end
        end
    end
    self:RefreshFollowAward()
    self:RefreshFollowAwardBtn()
    self:RefreshLoginAllAward()
end

function TurnTerminalView:OnClickFollowBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_follow" then
        self.index = 2
        self.go_table["toggle_tab" .. self.index].isOn = true
    elseif name == "@_aorbtn_followAward" then
        if not TurnTerminalModel:GetInstance():IsTurnTerminal() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1150001)
            return
        end
        if not TurnTerminalModel:GetInstance():IsGetAward() then
            TurnTerminalModel:GetInstance():GetAward(function()
                if self:IsNil() then
                    return
                end
                self:RefreshFollowAwardBtn()
            end)
        end
    elseif name == "@_aorbtn_code" then
        if _G.AppSetting.IsH5 then
            self:RefreshCodeImg(true)
        end
    end
end

---刷新图片
function TurnTerminalView:RefreshCodeImg(isShow)
    self.go_table.aorbtn_codeMask:SetActiveE(isShow and 1 or 0)
    if isShow then
        if self.isLoadCodeImg then
            return
        end
        self.isLoadCodeImg = true
        local width, height = 350, 350
        local data = {
            url = "https://zhjmycdn.gzjwwh.cn/zhuanduan/zhuanduan251103.jpg",
            left = 0,
            bottom = 0,
            width = width,
            height = height,
            unityHeight = 1280
        }
        _G.SDKManager:GetInstance():ShowImage(data)
    else
        if self.isLoadCodeImg then
            _G.SDKManager:GetInstance():HideImage()
            self.isLoadCodeImg = false
        end
    end
end

function TurnTerminalView:RefreshFollowAwardBtn()
    local isGet = TurnTerminalModel:GetInstance():IsGetAward()
    if not isGet then
        if TurnTerminalModel:GetInstance():IsTurnTerminal() then
            self.followTb.itemTb1.aorbtn_followAward:SetGray(false)
            self.followTb.itemTb1.aortext_get.text = _G.GetLangPackValue(90000010016)
        else
            self.followTb.itemTb1.aorbtn_followAward:SetGray(true)
            self.followTb.itemTb1.aortext_get.text = _G.GetLangPackValue(90020400086)
        end
    else
        self.followTb.itemTb1.aorbtn_followAward:SetGray(true)
        self.followTb.itemTb1.aortext_get.text = _G.GetLangPackValue(90000010221)
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 1)
end

function TurnTerminalView:RefreshFollowAward()
    self.followData = _G.ConfigManager.discrete_cfg[135001]
    if not self.followListView then
        self.followTb.itemTb1.scrollloophorizontal_item:InitItemData(#self.followData,
            _G.handler(self, self.RefreshFollowItem))
        self.followListView = self.followTb.itemTb1.scrollloophorizontal_item
    else
        self.followListView:UpdateAllItem()
    end
end

function TurnTerminalView:RefreshFollowItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(self.followData[index + 1], tb.obj_root, function(item)
        if self:IsNil() then
            _G.DestroyObject(item.gameObject)
            return
        end
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
            item:ShowEffect(true)
        end
    end)
end

function TurnTerminalView:InitLoginAward()
    if not self.loginAward then
        local cfg = _G.ConfigManager.discrete_cfg[135002]
        ---每天的登录奖励
        self.loginAward = {}
        ---所有登录奖励
        self.loginAllAward = {}
        local temp = {}

        for _, v in pairs(cfg) do
            local _cfg = _G.ConfigManager.discrete_cfg[v[2]]
            self.loginAward[v[1]] = _cfg

            for _, t in ipairs(_cfg) do
                if not temp[t[1]] then
                    temp[t[1]] = t[2]
                else
                    temp[t[1]] = temp[t[1]] + t[2]
                end
            end
        end

        for k, v in pairs(temp) do
            _G.table.insert(self.loginAllAward, { k, v })
        end
    end
end

function TurnTerminalView:RefreshLoginAllAward()
    self:InitLoginAward()
    if not self.loginAllAwardList then
        self.followTb.itemTb2.scrollloophorizontal_item:InitItemData(#self.loginAllAward,
            _G.handler(self, self.RefreshAllLoginItem))
        self.loginAllAwardList = self.followTb.itemTb2.scrollloophorizontal_item
    else
        self.loginAllAwardList:UpdateAllItem()
    end
end

function TurnTerminalView:RefreshAllLoginItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)

    tb.obj_root:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(self.loginAllAward[index + 1], tb.obj_root, function(item)
        if self:IsNil() then
            _G.DestroyObject(item.gameObject)
            return
        end
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
            item:ShowEffect(true)
        end
    end)
end

--endregion

--region 登录有礼
---刷新登录有礼界面
function TurnTerminalView:RefreshLoginPanel()
    if not self.loginTb then
        self.loginTb = _G.GetAutoGoTable(self.go_table.obj_view1, _G.handler(self, self.OnClickFollowBtn))
        self.loginTb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 2)
    end

    self:InitLoginAward()
    if AppSetting.IsXzns then
        self:RefreshLoginPanelAllItem()
    else
        if not self.loginListView then
            self.loginTb.scrollloopvectical_item:InitItemData(#self.loginAward,
                    _G.handler(self, self.RefreshLoginAwardItem))
            self.loginListView = self.loginTb.scrollloopvectical_item
        else
            self.loginListView:UpdateAllItem()
        end
    end
end
function TurnTerminalView:RefreshLoginPanelAllItem()
    local contenttb=_G.GetAutoGoTable(self.loginTb.obj_itemcount)
    for i = 1, #self.loginAward do
        local tb=_G.GetAutoGoTable(contenttb["obj_item"..i], _G.handlerbind(self, self.OnClickAward, i))
        tb.aortext_name.text = _G.GetLangPackValue(90023800006, _G.GameUtil.NumberToChinese(i))
        tb.obj_Root:ClearChildren()
        local isGetAward = TurnTerminalModel:GetInstance():IsGetLoginAward(i)
        _G.StorageManager:GetInstance():GetItemBaseViewNew(self.loginAward[i][1], tb.obj_Root, function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                item:ShowEffect(true)
            end
        end)

        if not isGetAward then
            local canGetAward = TurnTerminalModel:GetInstance():CanGetLoginAward(i)
            tb.obj_got:SetActiveE(0)
            tb.aorimage_unlock:SetActiveE(canGetAward and 0 or 1)
            tb.aorbtn_get:SetActiveE(canGetAward and 1 or 0)
            if canGetAward then
                self.loginTb.obj_redpoint:SetParentE(tb.gameObject)
                self.loginTb.obj_redpoint:SetLocalPosition(64, -48)
            end
        else
            tb.obj_got:SetActiveE(1)
            tb.aorimage_unlock:SetActiveE(0)
            tb.aorbtn_get:SetActiveE(0)
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TurnTerminal.id, 2)
    
end

function TurnTerminalView:RefreshLoginAwardItem(index, obj)
    local day = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickAward, day))

    tb.aortext_name.text = _G.GetLangPackValue(90059010009, day)
    tb.obj_Root:ClearChildren()
    for _, v in pairs(self.loginAward[day]) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(v, tb.obj_Root, function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                item:ShowEffect(true)
            end
        end)

        local isGetAward = TurnTerminalModel:GetInstance():IsGetLoginAward(day)
        if not isGetAward then
            local canGetAward = TurnTerminalModel:GetInstance():CanGetLoginAward(day)
            tb.aortext_get.text = _G.GetLangPackValue(canGetAward and 90000010016 or 90020400086)
            tb.aorbtn_get:SetGray(not canGetAward)
        else
            tb.aorbtn_get:SetGray(true)
            tb.aortext_get.text = _G.GetLangPackValue(90000010221)
        end
    end
end

function TurnTerminalView:OnClickAward(go, isOn, day)
    if TurnTerminalModel:GetInstance():IsGetLoginAward(day) then
        _G.PopWindowManager:GetInstance():ShowAllTips(2802)
        return
    end

    if TurnTerminalModel:GetInstance():CanGetLoginAward(day) then
        if not TurnTerminalModel:GetInstance():IsTurnTerminal() then
            _G.PopWindowManager:GetInstance():ShowAllTips(1150001)
            return
        end

        TurnTerminalModel:GetInstance():Sign({ day }, function()
            if self:IsNil() then
                return
            end
            if AppSetting.IsXzns then
                self:RefreshLoginPanelAllItem()
            else
                self.loginListView:UpdateAllItem()
            end
        end)
    end
end

--endregion

---界面的销毁函数
function TurnTerminalView:OnDestroy()
    if self.isLoadCodeImg then
        _G.SDKManager:GetInstance():HideImage()
    end
    self.isLoadCodeImg = nil
end

---按钮点击事件在这里派发
function TurnTerminalView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_codeMask then
        self:RefreshCodeImg(false)
        self.go_table.aorbtn_codeMask:SetActiveE(0)
    end
end

return TurnTerminalView
