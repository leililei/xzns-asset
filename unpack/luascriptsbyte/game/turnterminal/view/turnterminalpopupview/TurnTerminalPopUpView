---@class TurnTerminalPopUpView : UIBaseView	中文描述
---@field public go_table TurnTerminalPopUpView_GoTable GoTable
local TurnTerminalPopUpView = _G.BaseClass("TurnTerminalPopUpView", _G.UIBaseView)

function TurnTerminalPopUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function TurnTerminalPopUpView:OnCreate()
    self:InitSpine()
    self:InitAward()
end

function TurnTerminalPopUpView:InitSpine()
    _G.UIUtils.LoadEffectByPath(
        "WX_Role/Animation_UI/Shiguangzhiwang_UI/prf_Shiguangzhiwang_UI_ui",
        self.go_table.obj_spine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end

function TurnTerminalPopUpView:InitAward()
    local data = _G.ConfigManager.discrete_cfg[135001]
    for _, v in pairs(data) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(v, self.go_table.obj_item, function(item)
            if self:IsNil() then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
            if item.cfg and item.cfg.ef_item and _G.tonumber(item.cfg.ef_item) == 1 then
                item:ShowEffect(true)
            end
        end)
    end
end

---界面的销毁函数
function TurnTerminalPopUpView:OnDestroy()
end

---按钮点击事件在这里派发
function TurnTerminalPopUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        require("TurnTerminalModel"):GetInstance():OpenView()
        self:Close()
    end
end

return TurnTerminalPopUpView
