local base = require("BaseGameNet")

---@class TurnTerminalNet : BaseGameNet	通信协议
local TurnTerminalNet = _G.BaseClass("TurnTerminalNet", base)
---@return TurnTerminalNet TurnTerminalNet
function TurnTerminalNet:GetInstance()
    return  base.GetInstance(self)
end

---获取领奖的信息
function TurnTerminalNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_transfer_sign_info
    self:Access(item, self:GetEmptyPB(), callback)
end

---签到
function TurnTerminalNet:Sign(pbData, callback)
    local item = _G.ConfigManager.net_map.game_transfer_sign_sign
    self:Access(item, pbData, callback)
end

---领取转端奖励
function TurnTerminalNet:GetAward(callback)
    local item = _G.ConfigManager.net_map.game_transfer_sign_award
    self:Access(item, self:GetEmptyPB(), callback)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function TurnTerminalNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TurnTerminalNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end


return TurnTerminalNet