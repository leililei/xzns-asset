local base = _G.GameDataModelBase
---@class TurnTerminalModel : GameDataModelBase	中文描述
local TurnTerminalModel = _G.BaseClass("TurnTerminalModel", base)

---@return TurnTerminalModel TurnTerminalModel
function TurnTerminalModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function TurnTerminalModel:__init()
    self.awardList = {}
    self.awardState = 0
    self.isAward = false
    if AppSetting.IsXzns then
        self.directGetAward=1
    else
        ---解析挂接后台的参数 open_transfer： 开关#类型（0-需判断；1-不判断）#二维码路径
        local transfer = _G.SDKManager:GetInstance():GetExtraDataField("open_transfer")
        ---@type number 功能开关
        self.functionOpen = 0
        ---@type boolean 是否可以直接领奖
        self.directGetAward = false
        ---@type string 二维码路径
        self.codeImgPath = nil
        if transfer then
            local list = _G.json.decode(transfer)
            if not list.open_transfer then
                return
            end
            self.functionOpen = list.open_transfer.switch or 0
            self.directGetAward = list.open_transfer.needCheck and list.open_transfer.needCheck == 1
            self.codeImgPath = list.open_transfer.code
        end
    end
end

function TurnTerminalModel:GetDataFormServer()
    if AppSetting.IsXzns and  _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.transferevent) then
        require("TurnTerminalNet"):GetInstance():GetInfo(_G.handler(self, self.ParseData))
    else
        if self:CheckOneOpen() then
            require("TurnTerminalNet"):GetInstance():GetInfo(_G.handler(self, self.ParseData))
        else
            base.ParseData(self)
        end
    end
end

function TurnTerminalModel:ParseData(msg)
    if msg.ack == 1 then
        --转服奖励 0:未领取 1:已领取
        self.awardState = msg.award_state or 0
        --已领取的天数
        self.awardList = msg.award_list or {}
        --当天是否已领取
        self.isAward = msg.is_award or false

        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TurnTerminalView.Name)
        if view then
            view:RefreshView()
        end
    end
    base.ParseData(self)
end

---是否领取转服奖励
function TurnTerminalModel:IsGetAward()
    return self.awardState == 1
end

---是否领取登录奖励
function TurnTerminalModel:IsGetLoginAward(day)
    return day <= _G.table.count(self.awardList)
end

---可领取奖励天数
function TurnTerminalModel:GetAwardDay()
    if not _G.PlayerModel:GetInstance().open_time then
        return 0
    end
    return _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(), _G.PlayerModel:GetInstance().open_time)
end

---是否可领取登录奖励
function TurnTerminalModel:CanGetLoginAward(day)
    return day - 1 == _G.table.count(self.awardList) and not self.isAward
end

---签到
function TurnTerminalModel:Sign(days, callback)
    require("TurnTerminalNet"):GetInstance():Sign(
        { id = days },
        _G.handlerbind(self, self.OnSignCall, days, callback)
    )
end

function TurnTerminalModel:OnSignCall(msg, days, callback)
    if msg.ack ~= 1 then
        return
    end

    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
    for _, v in ipairs(days) do
        _G.table.insert(self.awardList, v)
    end
    self.isAward = true
    if require("TurnTerminalModel"):GetInstance():CheckIsGetAllAward() then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.TurnTerminal)
    end

    if callback then
        callback()
    end
end

---领取转端奖励
function TurnTerminalModel:GetAward(callback)
    require("TurnTerminalNet"):GetInstance():GetAward(
        _G.handlerbind(self, self.GetAwardCall, callback)
    )
end

function TurnTerminalModel:GetAwardCall(msg, callback)
    if msg.ack ~= 1 then
        return
    end

    self.awardState = 1
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)

    if require("TurnTerminalModel"):GetInstance():CheckIsGetAllAward() then
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.TurnTerminal)
    end
    if callback then
        callback()
    end
end

function TurnTerminalModel:GetThirdSDKInfo(callBack)
    _G.SDKManager:GetInstance():GetThirdSDKInfo(_G.handlerbind(self, self.OnThirdSDKInfo, callBack))
end


function TurnTerminalModel:OnThirdSDKInfo(bol, data, callBack)
    if _G.AppSetting.DEBUG then
       _G.LogError(data)
    end
    if bol and data then
        if _G.type(data.data) == "string" then
            local _data = _G.json.decode(data.data)
            self.wxweb = _G.tonumber(_data and _data.wxweb or 1)
        else
            self.wxweb = _G.tonumber(data and data.data.wxweb or 1)
        end
    end
    if callBack then
        callBack()
    end
end

function TurnTerminalModel:IsTurnTerminal()
    if self.directGetAward then
       return true 
    end
    return self.wxweb and self.wxweb == 0
end

function TurnTerminalModel:OpenView()
    if _G.AppSetting.IsEditor or self.directGetAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TurnTerminalView.Name)
        return
    end

    if self.wxweb == nil and _G.AppSetting.IsH5 then
        ---因为SDK给的GetThirdSDKInfo接口只能在H5里面调用
        self:GetThirdSDKInfo(function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TurnTerminalView.Name)
        end)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TurnTerminalView.Name)
    end
end
function TurnTerminalModel:CheckIsGetAllAward()
    local cfg=_G.ConfigManager.discrete_cfg[135002]
    if table.isEmptyOrNil(self.awardList) or table.count(cfg)>#self.awardList then
        return false
    end
    return self.awardState==1
end

---检查功能是否开启
function TurnTerminalModel:CheckOneOpen()
    if AppSetting.IsXzns and _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.transferevent) then
        return not  require("TurnTerminalModel"):GetInstance():CheckIsGetAllAward()
    else
        if _G.AppSetting.IsArraigned then
            return false
        end
        return require("TurnTerminalModel"):GetInstance().functionOpen == 1
    end
end

---检查红点
function TurnTerminalModel:CheckRedpoint(param)
    if not param then
        if self:CheckRedpoint(1) == 1 or self:CheckRedpoint(2) == 1 then
            return 1
        end
        return 0
    end
    if self:CheckIsGetAllAward() then
        return 0
    end
    if param == 1 then
        return (self:IsTurnTerminal() and self.awardState ~= 1) and 1 or 0
    elseif param == 2 then
        local cfg = _G.ConfigManager.discrete_cfg[135002]
        for _, v in pairs(cfg) do
            if self:CanGetLoginAward(v[1]) then
                return 1
            end
        end
    end
    return 0
end

---销毁对象时,析构函数
function TurnTerminalModel:Dispose()
    self.wxweb = nil
end

return TurnTerminalModel
