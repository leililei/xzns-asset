local base = require("ActivitySynTypeBase")
local SDKDef = require("SDKDef")

---@class GwRecruitWeekSynModel : ActivitySynTypeBase	中文描述
local GwRecruitWeekSynModel = _G.BaseClass("GwRecruitWeekSynModel", base)

---类的构造函数
function GwRecruitWeekSynModel:__init()
end

function GwRecruitWeekSynModel:OnHandleGMData(data)
    self:ParseData(data)
end

function GwRecruitWeekSynModel:ParseData(data)
    data = data.military_week_sign
    self.isBuy = data.is_buy == 1
    self.giftId = data.bag_id
    self.price = data.price
    self.signIdTable = data.pay_sign or {}
    self.weekAward = data.sid_award or {}
    self.buyAward = data.base_award
    self.rebate = data.rebate
    _G.SortList(self.weekAward,function (item)
        return -item.sid
    end)
    base.ParseData(self)
end

---进入活动主体
function GwRecruitWeekSynModel:OnEnterActivity()
    local type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    local name
    local subType = self.curActivityClass:GetJumpType()
    if type == _G.JointActivityType.SpringFestival then
        name = _G.ConfigManager.ui_cfg.SpringFestivalRecruitWeek.Name
    elseif subType == 100209 then
        name = _G.ConfigManager.ui_cfg.LabourDayRecruitWeekView.Name
    else
        name = _G.ConfigManager.ui_cfg.GwRecruitWeekView.Name
    end
    _G.UIManager:GetInstance():OpenWindow(name, self)
end

function GwRecruitWeekSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.GwRecruitWeekView.Name
end

---初始化红点树
function GwRecruitWeekSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GwRecruitWeekSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function GwRecruitWeekSynModel:CheckRedPoint()
    if _G.AppSetting.IsXzns and _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) ~=
        _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.GwRecruitWeekFirstLogin, 0) 
    then
        return 1
    end
    if not self.isBuy then
        return 0
    end
    local startTime = self.curActivityClass.cfg.time.start_time
    local loginIndex = _G.TimeUtil.GetIntervalDayBySix1(startTime,_G.TimeUtil.GetServerUnixTime()) + 1
    for i = 1, #self.weekAward do
        if not _G.table.ContainsValue(self.signIdTable,i) and i <= loginIndex then
            return 1
        end
    end
    return 0
end

--region 外部接口

function GwRecruitWeekSynModel:GetPriceId()
    return self.price
end

function GwRecruitWeekSynModel:GetIsBuy()
    return self.isBuy
end

function GwRecruitWeekSynModel:GetAwardList()
    return self.weekAward
end

function GwRecruitWeekSynModel:GetBuyAward()
    return self.buyAward
end

function GwRecruitWeekSynModel:GetRebate()
    return self.rebate 
end

--- 检测是否已经领取
function GwRecruitWeekSynModel:CheckIsGet(id)
    return _G.table.ContainsValue(self.signIdTable, id)
end

---检测是否能够领取
function GwRecruitWeekSynModel:CheckCanGet(index)
    if not self.isBuy or self:CheckIsGet(index) then
        return false
    end
    local startTime = self.curActivityClass.cfg.time.start_time
    local loginIndex = _G.TimeUtil.GetIntervalDayBySix1(startTime,_G.TimeUtil.GetServerUnixTime()) + 1
    return loginIndex >= index
end

function GwRecruitWeekSynModel:GetAward(callback)
    if not self.isBuy then
        return
    end
    local startTime = self.curActivityClass.cfg.time.start_time
    local loginIndex = _G.TimeUtil.GetIntervalDayBySix1(startTime,_G.TimeUtil.GetServerUnixTime()) + 1
    local ids = {}
    for i = 1, #self.weekAward do
        if not _G.table.ContainsValue(self.signIdTable, i) and i <= loginIndex then
            _G.table.insert(ids,i)
        end
    end
    self:GetActivityAward(
        ids,
        function(msg)
            _G.table.insertto(self.signIdTable, ids)
            require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
            if callback then
                callback(msg)
            end
        end
    )
end

function GwRecruitWeekSynModel:BuyGift(callback)
    if self.isBuy then
        return
    end
    self.mallCall = callback
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_failed, self.OnPay_failed, self)
    require "MallManager":GetInstance():BuyActiveGift(self.price, self.curActivityClass:GetActivityID(), self.giftId)
end

function GwRecruitWeekSynModel:OnMallCashListener()
    self.isBuy = true
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    if self.mallCall then
        self.mallCall()
        self.mallCall = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function GwRecruitWeekSynModel:OnPay_failed()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_failed, self.OnPay_failed, self)
    self.mallCall = nil
end

--endregion


function GwRecruitWeekSynModel:IsShowBtn()
    local type = self.curActivityClass:GetMainType()
    local sub_type = self.curActivityClass:GetJumpType()
    if sub_type == 100209 then
        return true
    end
    if not type then
        return false
    else
        return true
    end
end
---类的析构函数
function GwRecruitWeekSynModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_failed, self.OnPay_failed, self)
    base.Dispose(self)
end

return GwRecruitWeekSynModel