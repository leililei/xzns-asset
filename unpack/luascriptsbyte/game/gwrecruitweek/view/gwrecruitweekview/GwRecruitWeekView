---@class GwRecruitWeekView : UIBaseView	中文描述
---@field public go_table GwRecruitWeekView_GoTable GoTable
local GwRecruitWeekView = _G.BaseClass("GwRecruitWeekView", _G.UIBaseView)

function GwRecruitWeekView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate,self.Close)
end

---界面的入口函数
function GwRecruitWeekView:OnCreate(activity)
    self.activity = activity
    self:InitView()
    self:UpdateView()
end

function GwRecruitWeekView:InitView()
    self.price = self.activity:GetPriceId()
    self.buyAward = self.activity:GetBuyAward()
    self.loginAward = self.activity:GetAwardList()
    self.elapsedTime = self.activity.curActivityClass.cfg.time.start_time +
    self.activity.curActivityClass.cfg.time.run_time - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(0)
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()

    self.go_table.aorrawimage_BoardBG:SetActiveE(1)

    local precast = self.activity.curActivityClass.cfg.info.front.precast
    if precast then
        self.cfgs = _G.string.split(precast, "#")
        if self.cfgs then
            self.go_table.aorrawimage_title1:LoadImage(self.cfgs[1])
            self.go_table.aorrawimage_title1:SetLocalPosition(tonumber(self.cfgs[2]), tonumber(self.cfgs[3]), tonumber(self.cfgs[4]))
            self.go_table.aorrawimage_title1:SetLocalScaleXYZ(tonumber(self.cfgs[5]))

            self.go_table.aorrawimage_BoardBG:SetActiveE(0)
            _G.PoolsManager:GetInstance():Spawn(
                self.cfgs[6],
                _G.ePoolType.Temporary,
                self.go_table.obj_Spine,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("spine无法加载 path:" .. self.cfgs[6] .. "  GwRecruitWeekView")
                        end
                        return
                    end
                    if self.go_table == nil then
                        _G.DestroyObject(trans)
                        return
                    end
                    
                    trans:SetLocalPosition(tonumber(self.cfgs[7]), tonumber(self.cfgs[8]), tonumber(self.cfgs[9]))
                    trans:SetLocalScaleXYZ(tonumber(self.cfgs[10]))
                end
            )
            
            self.go_table.aorrawimage_person:LoadImage(self.cfgs[11])
        end
    end
end

function GwRecruitWeekView:UpdateView()
    local isBuy = self.activity:GetIsBuy()
    self.go_table.aorbtn_buy:SetActiveE(isBuy and 0 or 1)
    local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(self.price)
    finalPrice = _G.GameUtil.RatioControl(finalPrice)
    self.go_table.aortext_price.text = _G.GetLangPackValue(90034712004, finalPrice)

    local award
    self.go_table.obj_Content:ClearChildren()
    for _, v in pairs(self.buyAward) do
        award = v.type
        local sid = award[1] == 0 and award[4] or award[1]
        local count = award[1] == 0 and award[5] or award[2]
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { sid, count },
            self.go_table.obj_Content,
            function(trans)
                if self:IsNil() then
                    return
                end
                trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                trans:SetGou(isBuy)
            end
        )
    end
    if self.go_table.obj_effNode then
        self.go_table.obj_effNode:RemoveAllChildren()
        if isBuy then

        else
            UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_upgw_bg,self.go_table.obj_effNode,function(obj)
                if self.go_table == nil then
                    DestroyObject(obj)
                end
            end)
        end
    end

    local tb, sid, count
    for k, v in pairs(self.loginAward) do
        if k > 7 then
            break
        end
        tb = _G.GetAutoGoTable(self.go_table["obj_award" .. k], _G.handler(self, self.OnClickAward))
        tb.aortext_day.text = _G.GetLangPackValue(90023800006, k)

        if self.cfgs then
            if k == 7 then
                tb.aorrawimage_bg:LoadImage(self.cfgs[13])
            else
                tb.aorrawimage_bg:LoadImage(self.cfgs[12])
            end
        end
        local isGet = self.activity:CheckIsGet(v.sid)
        local canGet = self.activity:CheckCanGet(v.sid)
        tb.aorbtn_click:SetActiveE(canGet and 1 or 0)
        tb.obj_redpoint:SetActiveE(canGet and 1 or 0)

        tb.obj_root:ClearChildren()
        for _, v in pairs(v.base_award) do
            award = v.type
            sid = award[1] == 0 and award[4] or award[1]
            count = award[1] == 0 and award[5] or award[2]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, count },
                tb.obj_root,
                function(trans)
                    if self:IsNil() then
                        return
                    end
                    trans:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    trans:SetGou(isGet)
                    trans:ShowEffect(canGet)
                end
            )
        end
        if tb.obj_effNode then
            tb.obj_effNode:RemoveAllChildren()
            if isGet then

            else
                UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_award7_bg,tb.obj_effNode,function(obj)
                    if self.go_table == nil then
                        DestroyObject(obj)
                    end
                end)
            end
        end
    end
end

function GwRecruitWeekView:UpdateTime(elapsed)
    self.elapsedTime = self.elapsedTime - elapsed
    if self.elapsedTime <= 0 then
        self:Close()
        return
    end
    self.go_table.aortext_time.text =
        _G.GetLangPackValue(90000010360,
            _G.string.AddColor(_G.TimeUtil.GodSpecialGiftForStr(self.elapsedTime),"96ce51"))
end

function GwRecruitWeekView:OnClickAward()
    self.activity:GetAward(function(msg)
        if msg.ack ~= 1 then
            return
        end
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        self:UpdateView()
    end)
end

---界面的销毁函数
function GwRecruitWeekView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function GwRecruitWeekView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_buy then
        self.activity:BuyGift(
            function(msg)
                if self:IsNil() then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:UpdateView()
            end
        )
    end
end

return GwRecruitWeekView
