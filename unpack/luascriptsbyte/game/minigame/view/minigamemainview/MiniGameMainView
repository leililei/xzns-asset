local MiniGameMainView = _G.BaseClass("MiniGameMainView", _G.UIBaseView)

local ActivitySynManager = require "ActivitySynManager"
local PanelLuaFile = {
    [3] = "RedBoundView"
}

local PanelPrefabs = {
    [3] = "UIH5/MiniGames/GameView/RedBoundView" --红包
}
function MiniGameMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function MiniGameMainView:OnCreate(activity)
    self.activity = activity
    self.TypeCls = self.activity.typeClass
    self.OpenType = self.TypeCls.GameType
    self:OpenGameView()
    self:ShowCountDown()
    local activitys2 =
    require "ActivitySynManager":GetInstance():GetChildAcitivity(
            10007,
            self.activity:GetJumpType(self.activity.activityID)
    )
    if activitys2 then
        self.go_table.obj_taskredpoint:UpdateRedPointItemIDAndParam(
                activitys2:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
        self.go_table.aorbtn_task:SetActiveE(activitys2 and 1 or 0)
    else
        self.go_table.aorbtn_task:SetActiveE(0)
    end
end
function MiniGameMainView:ShowCountDown()
    self.CountDownTime=self.activity.cfg.time.start_time + self.activity.cfg.time.run_time -_G.TimeUtil.GetServerUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpDateTime, self, false)
    self.timer:Start()
    self:UpDateTime(0)
end
function MiniGameMainView:UpDateTime(fix)
    if self.CountDownTime <= 0 then
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90026100053)
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        return
    else
        self.CountDownTime = self.CountDownTime - fix
        local time = string.format("%s<color=#96ce51>%s</color>", _G.LangUtil.GetLangPackValue(90022500595), _G.TimeUtil.TranslateSecondForStrMiaoHui(self.CountDownTime))
        self.go_table.aortext_time.text = time
    end
end
---加载小游戏界面
function MiniGameMainView:OpenGameView()
    _G.PoolsManager:GetInstance():Spawn(
            PanelPrefabs[self.OpenType],
            _G.ePoolType.UIItem,
            self.go_table.obj_panel,
            function(trans)
                if not trans or trans:GetctiveInHierarchy() ~= 1 then
                    self.GameInit= nil
                    _G.DestroyObject(trans)
                    return
                end
                self.GameLua = self:AddComponent(trans, require(PanelLuaFile[self.OpenType]).New(trans,self))
                self.GameInit= true
            end
    )
end
function MiniGameMainView:GameOver(score,callBack)
    if score>0 then
        self.TypeCls:GameOver(score,callBack)
    else
        callBack()
    end
end
function MiniGameMainView:ShowBtnAndTime()
    self.gamestate=0
    if self.TypeCls.curActivityClass==nil then
        self:Close()
    end
    self.go_table.obj_main:SetActiveE(1)
end

function MiniGameMainView:HindBtnAndTime()
    self.gamestate=1
    self.go_table.obj_main:SetActiveE(0)
end

function MiniGameMainView:OnClickBtn(go,ison)
    if go==self.go_table.aorbtn_close then
        self:Close()
    elseif go==self.go_table.aorbtn_help then
        self:HelpOnClick()
    elseif go==self.go_table.aorbtn_task then
        _G.GlobalInterface.JumpActivityByGM(10007,self.activity:GetJumpType(self.activity.activityID))
    end
end

function MiniGameMainView:HelpOnClick()
    if self.OpenType == self.TypeCls.GameOpenType.RedBoundView then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 61)
    end
end
function MiniGameMainView:SetState(state)
    self.state=state
    if not self.gamestate or self.gamestate==0 then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ActiveTaskToggleView.Name)
        if view then
            view:Close()
        end
        self:Close()
    end
end
function MiniGameMainView:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return MiniGameMainView