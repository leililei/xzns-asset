---掉落物配置, 需匹配RedPaperModel.items
local DropConfigIcons = {
    { "ui_zjm_jinbi_icon", _G.GetLangPackValue(90034543002, 666) },
    { "beibaoxiao", _G.GetLangPackValue(90034543002, 1888) },
    { "beibaoda",   _G.GetLangPackValue(90034543002, 8888) },
    { "caoqunwawa", _G.GetLangPackValue(90034543004, 5) },
}

---@class MTRedPaperMainView : UIBaseView MT送包包_主页面
---@field go_table MTRedPaperMainView_GoTable GoTable
---@field activity ActivitySynGMActivity
---@field model MiniTaskGameSynModel
local MTRedPaperMainView = _G.BaseClass("MTRedPaperMainView", _G.UIBaseView)

function MTRedPaperMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function MTRedPaperMainView:OnCreate(model)
    self.model = model
    self.activity = model.curActivityClass
    self.lastTime = self.model:GetRemianDuration()

    self:InitView()
    self:UpdateView()
    self:UpdateTimeView(0)

    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeView, self, false)
    self.timer:Start()
end

function MTRedPaperMainView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function MTRedPaperMainView:InitView()
    local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        10007,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    self.go_table.aorbtn_task:SetActiveE(taskActivity and 1 or 0)
    if taskActivity then
        self.go_table.obj_taskRedpoint:UpdateRedPointItemIDAndParam(
            taskActivity:GetActivityTypeCls():GetRedpointIDByIndex(1),
            -1
        )
    end

    --道具说明
    for _, cfg in ipairs(DropConfigIcons) do
        ---@type MTRedPaperMainView._obj_item_GoTable
        local tb = _G.GetAutoGoTable(_G.InstantiateObject(
            self.go_table.obj_item,
            self.go_table.obj_itemParent
        ))
        tb.gameObject:SetActiveE(1)
        tb.aorimage_icon.SpriteName = cfg[1]
        tb.aortext_text.text = cfg[2]
    end
end

---更新页面状态
function MTRedPaperMainView:UpdateView()
    self.go_table.aortext_max.text = tostring(self.model.maxScore or 0)
    self.go_table.aortext_today.text = tostring(self.model.dayScore or 0)

    local nextScore, nowScore = self:GetNextScore()
    self.go_table.obj_next:SetActiveE(nextScore <= 0 and nowScore <= 0 and 0 or 1)
    if nextScore > 0 or nowScore > 0 then
        if nextScore > 0 then
            self.go_table.aortext_next.text = string.format(
                "<color=#96ce51>%s</color>/<color=#e6dab5>%s</color>",
                nowScore,
                nextScore
            )
        else
            self.go_table.aortext_next.text = _G.GetLangPackValue(90034533009)
        end
    end
end

---获取下一目标所需分数
---@return number,number        @下一阶段分数,当前分数
function MTRedPaperMainView:GetNextScore()
    local taskActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        10007,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if not taskActivity then
        return 0, 0
    end

    local allTask = taskActivity:GetActivityTypeCls():GetAllTaskDatas()
    local nextScore, nowScore = 0, self.model.dayScore or 0
    for k, v in pairs(allTask) do
        if v.taskEnumType == 192 then
            nowScore = math.max(nowScore, v.i_task.target[1])
            if v.i_task.target[1] < v.Cfg.count and v.i_task.state ~= _G.TaskEnum.ETaskState.Submited then
                nextScore = nextScore ~= 0 and math.min(nextScore, v.Cfg.count) or v.Cfg.count
            end
        end
    end

    return nextScore, nowScore
end

---更新时间倒计时
function MTRedPaperMainView:UpdateTimeView(elapsed)
    self.lastTime = self.lastTime - elapsed
    if self.lastTime < 0 then
        self:Close()
    else
        local time = _G.TimeUtil.TranslateSecondForDHMOrHMS(self.lastTime)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90027600008, time)
    end
end

function MTRedPaperMainView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.MTRedPaperView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

    ---@type MTRedPaperView
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MTRedPaperView.Name)
    if view then
        local nextScore = self:GetNextScore()
        view:SetNextDescript(nextScore > 0 and tostring(nextScore) or _G.GetLangPackValue(90034533009))
    end
end

function MTRedPaperMainView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_start then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.MTRedPaperView.Name,
            function(score)
                self.model:Finish(score, function()
                    self:UpdateView()
                end)
            end
        )
    elseif go == self.go_table.aorbtn_task then
        _G.GlobalInterface.JumpActivityByGM(
            10007,
            self.activity:GetJumpType(),
            nil,
            self.activity:GetMainType()
        )
    end
end

return MTRedPaperMainView
