                    trans:SetLocalScaleXYZ(self.cfg.spine.scale)
                end
                _G.GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                if btnCfg.delay then
                    _G.DelayDo(
                        btnCfg.delay,
                        function()
                            self:ShowCloseBtn(btnCfg)
                        end
                    )
                else
                    self:ShowCloseBtn(btnCfg)
                end
                if bubbleCfg.delay then
                    _G.DelayDo(
