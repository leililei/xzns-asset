local MiniGameTaskInfoData = _G.BaseClass("MiniGameTaskInfoData", base)

function MiniGameTaskInfoData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end
---进入活动
function MiniGameTaskInfoData:OnEnterActivity()
    local toggleTab={
        {
            tasktype=_G.eActiveTaskType.DailyTask,
            title=_G.GetLangPackValue(90021300094),
            PanelView=_G.eActiveTaskPanelLua.ActiveTaskPanel,
            PanelPrefarb=_G.eActiveTaskPanelPrefab.ActiveTaskPanel,
            toggletxt=_G.GetLangPackValue(90000010337)
        },
        {
            tasktype=_G.eActiveTaskType.CycleTask,
            title=_G.GetLangPackValue(90010050151),
            PanelView=_G.eActiveTaskPanelLua.ActiveTaskPanel,
            PanelPrefarb=_G.eActiveTaskPanelPrefab.ActiveTaskPanel,
            toggletxt=_G.GetLangPackValue(90010050151)
        }
    }
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActiveTaskToggleView.Name, self.curActivityClass,toggleTab,_G.eActiveTaskType.DailyTask)
end
---领取奖励
function MiniGameTaskInfoData:GetAward(ids, call)
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
            {activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2},
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                for _, v in pairs(ids) do
                    if not msg.award or not msg.award.item then
                        msg.award = {item = {}}
                    end

                    self.activity.finishTask[v] = true
                end
                require "CommonTipManager".OpenCommonAwardView(msg)
                self.activity:RefreshRedPoint()
                if call then
                    call()
                end
            end
    )
end
function MiniGameTaskInfoData:GetJumpModelType()
    return 10001
end
