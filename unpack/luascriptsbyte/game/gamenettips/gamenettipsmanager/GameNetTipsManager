---OnReceiveMsg 接收消息，如果收到消息和发出消息数量匹配
---改动原因:cmd和发送的cmd对不上，采用消息序列号判定
---@param cmd number
function GameNetTipsManager:OnReceiveMsg(cmd, port)
    ---@param v NetSendData 清理发送的数据
    for i, v in ipairs(self.mMsgList) do
        if v.sn == port then
            table.remove(self.mMsgList, i)
            self.mAccessMsgCount = self.mAccessMsgCount - 1
            --
            if _G.AppSetting.DEBUG then
                _G.Log(self.mAccessMsgCount, "消息剩余未处理的数据量>>>>>>>>>>>>>>>>>>>>")
            end
            if (self.mAccessMsgCount <= 0) then
                self.mAccessMsgCount = 0
                self:ShowLoading()
            end
            break
        end
    end
    if self.isResendMessage then
        self:SendMsg(port)
    end
end
---OnReceiveMsgError消息格式错误
---@param errorStr string
function GameNetTipsManager:OnReceiveMsgError(errorStr)
    if _G.AppSetting.DEBUG then
        _G.LogError(errorStr, "GameNetTipsManager:OnReceiveMsgError")
    end
end
---OnReceiveGlobalMsg 接收广播推送
function GameNetTipsManager:OnReceiveGlobalMsg(cmd, args)
end
---登出
function GameNetTipsManager:OnUserLoginOut()
    self.mAccessMsgCount = 0
    _G.Net.CloseAllConnects()
    self:ShowLoading()
end
--endregion
------发送没有发送成功的消息
function GameNetTipsManager:ReSendMsg()
    ---@param ReMsgList NetSendData 缓存发送的数据
    local reSendArgs = self.ReMsgList[1]
    _G.Net.SendSocket(reSendArgs.pbMap, reSendArgs.sendPBData, reSendArgs.func, reSendArgs.sn)
end

---循环发送remsglist里面的消息，当这个消息回来的时候在收消息的地方继续循环直到消息发送完为止
---@param sn number 消息的流水号
function GameNetTipsManager:SendMsg(sn)
    --没有或者为空的时候直接返回
    if self.ReMsgList == nil then
        return
    end
    local count = #self.ReMsgList
    if count <= 0 then
        return
    end
    --如果收到的消息里面有相同的流水号，就接着发送下一个，如果这里面没有了，就返回OnReSendMsgOK()
    local isRe = false
    for i = 1, count do
        if self.ReMsgList[i].sn == sn then
            _G.table.remove(self.ReMsgList, i)
            isRe = true
            break
        end
    end
    if isRe then
        if count > 1 then
            local msg = self.ReMsgList[1]
            _G.Net.SendSocket(msg.pbMap, msg.sendPBData, msg.func, msg.sn)
        else
            self.ReMsgList = nil
            self:OnReSendMsgOK()
        end
    end
end

---ShowLoading 是否需要遮罩
---@param showMask boolean 遮罩开关
function GameNetTipsManager:ShowLoading(showMask)
    if nil == showMask then
        showMask = false
    end
    if _G.AppSetting.DEBUG then
        _G.Log(showMask, "<color=red><size=18>" .. "网络通信遮罩开关接口调用，设置状态为" .. "</size></color>")
    end
    local name = _G.ConfigManager.ui_cfg.GameNetTipsView.Name
    if not showMask or require("BaseGameNet"):GetInstance().IsLocal then
        _G.UIManager:GetInstance():HideWindow(name)
        return
    end
    if _G.UIManager:GetInstance():IsActiveWindow(name) then
        _G.UIManager:GetInstance():ShowWindow(name)
    else
        _G.UIManager:GetInstance():OpenWindow(name)
    end
end
