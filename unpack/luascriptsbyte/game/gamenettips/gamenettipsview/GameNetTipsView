function GameNetTipsView:OnEnable()
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_eff, false)
    if self.showEffectTimer then
        self.showEffectTimer:Stop()
        self.showEffectTimer = nil
    end
    self.showEffectTimer = _G.TimerManager:GetInstance():GetTimer(showEffectTime, self.ShowEffect, self, true)
    self.showEffectTimer:Start()
end
function GameNetTipsView:OnDisable()
    if self.showEffectTimer then
        self.showEffectTimer:Stop()
        self.showEffectTimer = nil
    end
    _G.Events:GetInstance():Broadcast(_G.eNetTipsViewShow.Show, false)
end
function GameNetTipsView:ShowEffect()
    _G.Events:GetInstance():Broadcast(_G.eNetTipsViewShow.Show, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_eff, true)
end
return GameNetTipsView
