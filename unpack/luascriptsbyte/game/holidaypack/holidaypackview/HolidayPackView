---@class HolidayPackView : UIBaseView    中文描述
---@field public go_table HolidayPackView GoTable
local HolidayPackView = _G.BaseClass("HolidayPackView", _G.UIBaseView)
local bubble_continuous, bubble_hidden = _G.ConfigManager.discrete_cfg[115801][1][1], 1
local log_continuous = _G.ConfigManager.discrete_cfg[115802][1][1]
local ActivitySynManager = require "ActivitySynManager"

function HolidayPackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = 991
    self.go_table.looplist2_:InitListView(0, _G.handlerbind(self, self.RefreshItem))
    self.logData = {}
end

---界面的入口函数
function HolidayPackView:OnCreate()
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.HolidayPackView, self.go_table)
    self.curGiftIndex = 1
    self.bubbleIndex = 1
    self.BubbleRect1 = self.go_table.aorimage_bubble1.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self.BubbleRect2 = self.go_table.aorimage_bubble2.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:UpdateView()
    self:InitToggle()
end

function HolidayPackView:InitToggle()
    if not _G.AppSetting.IsXzns then
        return
    end
    self.toggleItem = {}
    for i = 1, 3 do
        local page = _G.InstantiateObject(self.go_table.toggle_Page, self.go_table.obj_PageContent)
        local tb = self.toggleItem[i]
        if not tb then
            tb = _G.GetAutoGoTable(page, _G.handlerbind(self, self.OnClickToggle, i))
            self.toggleItem[i] = tb
        end
        page:SetActiveE(1)
        page:SetName(i)
        tb.aortext_togDesc.text = _G.GetLangPackValue(self.cfgs.todayCfg.items[i].name)
        tb.aortext_togDesc.color = _G.ColorTools.FormatColorByString(i == self.curGiftIndex and "410F0F" or "FEF3D8")
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(self.curActivityClass.typeClass:GetRedpointIDByIndex(1))
        tb.obj_redpoint:SetActiveE(
                _G.TimeUtil.GetServerUnixTime() > _G.PlayerPrefsManager.GetInt(
                        _G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPackGift" .. i
                ) and 1 or 0
        )
    end
end

--刷新滚动条条目方法
function HolidayPackView:RefreshItem(listView2, index, chatlooplist)
    if index < 0 then
        return
    end
    local t_index = index + 1
    if t_index <= #self.logData then
        local item
        item = listView2:NewListViewItem("$_obj_ListItem")
        local goTable = _G.GetAutoGoTable(item)
        goTable.aortext_log.text = self.logData[t_index]
        --local rtf_Tmp = goTable.aortext_log:GetComponentE(typeof(CS.UnityEngine.RectTransform))
        local csf_tmp = goTable.aortext_log:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter))
        local csf_tmp1 = item:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter))
        csf_tmp:SetLayoutVertical()
        csf_tmp1:SetLayoutVertical()
        _G.GameUtil.ReBuildRTF(item)
        return item
    end
    return nil
end

function HolidayPackView:RefreshToggle()
    if not _G.AppSetting.IsXzns then
        return
    end
    for i = 1, 3 do
        if self.toggleItem and self.toggleItem[i] then
            self.toggleItem[i].aortext_togDesc.text = _G.GetLangPackValue(self.cfgs.todayCfg.items[i].name)
        end
    end
end

function HolidayPackView:CloseView()
    self:StopAllTimer()
    self:Close()
end

function HolidayPackView:OnDestroy()
    self:CloseView()
end
--界面刷新
function HolidayPackView:UpdateView(activityClass, updateFlag)
    if activityClass == nil then
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10041)
    else
        self.curActivityClass = activityClass
    end
    self.cfgs = self.curActivityClass.typeClass:GetNowInfo()
    if self.cfgs.todayCfg.path_str then
        self.path_str = _G.string.split(self.cfgs.todayCfg.path_str, "|")
        local str1 = self.path_str[1] or ""
        local str2 = self.path_str[3] or ""
        if not string.IsNullOrEmpty(str1) then
            self.go_table.aorrawimage_bg:LoadImage(str1)
        end
        if not string.IsNullOrEmpty(str2) then
            local temp = _G.string.split(str2, "#")
            self.go_table.aorrawimage_title:LoadImage(temp[1], function(trans)
                trans.gameObject:SetLocalPosition(tonumber(temp[2]), tonumber(temp[3]), tonumber(temp[4]))
                trans:SetNativeSize()
            end)
        end
    end
    local bol1 = self.curActivityClass.typeClass:CheckBigDay()
    self.curBubbles = self.curActivityClass.typeClass:CheckBigDay() and _G.DeepCopy(_G.ConfigManager.discrete_cfg[115803][1]) or _G.DeepCopy(_G.ConfigManager.discrete_cfg[115804][1])
    self.logTxt = self.curActivityClass.typeClass:CheckBigDay() and _G.DeepCopy(_G.ConfigManager.discrete_cfg[115805][1]) or _G.DeepCopy(_G.ConfigManager.discrete_cfg[115806][1])
    local temp = {}
    self.logRandom = {}
    for i = 2, #self.logTxt do
        _G.table.insert(temp, i)
    end
    while #temp > 0 do
        local index = _G.math.random(1, #temp)
        _G.table.insert(self.logRandom, _G.table.remove(temp, index))
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aorimage_Term.SpriteName = "ui_nszx_no_" .. self.curActivityClass.typeClass:GetNowDay()
    else
        self.go_table.aortext_title.text = _G.GetLangPackValue(18900000071,self.curActivityClass.typeClass:GetNowDay())
    end
    local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local startTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    self.activityEndTime = endTime
    self.activityStartTime = startTime
    self:StopAllTimer()
    self:UpdateTime()
    self.endTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.endTimer:Start()
    self:RefreshToggle()
    self:RefreshList()
    self:ShowBubble()
    self:ShowLog()
    self:ShowRole()
end
--刷新时间显示
function HolidayPackView:UpdateTime()
    local time = self.activityEndTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self:CloseView()
        return
    end
    --local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    --.go_table.aortext_time.text = _G.GetLangPackValue(90000011044, str)
    local str = _G.TimeUtil.TranslateSecondForDHMOrHMS(time)
    if _G.AppSetting.IsXzns then
        str = "<color=#83E497>" .. str .. "</color>"
    end
    self.go_table.aortext_time2.text = _G.GetLangPackValue(90027600008, str)
end

function HolidayPackView:StopAllTimer()
    if self.endTimer then
        self.endTimer:Stop()
        self.endTimer = nil
    end
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
        self.bubbleTimer = nil
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
    if self.logTimer ~= nil then
        self.logTimer:Stop()
        self.logTimer = nil
    end
end

---按钮点击事件在这里派发
function HolidayPackView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 85)
    elseif go == self.go_table.aorbtn_check then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            113020000,
            nil,
            true
        )
    elseif go == self.go_table.aorbtn_send then
        self:SendMessage(self.go_table.input_input.text)
    elseif go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    end
end
--显示对话泡泡
function HolidayPackView:ShowBubble()
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self.BubbleRect1:SetActiveE(1)
    self.BubbleRect2:SetActiveE(0)
    self.bubbleTimer = nil
    self.Timer = nil
    self.go_table.aorimage_bubble1:SetActiveE(1)
    --self.curBubbles = _G.DeepCopyCfgTable(bubble_chat1)
    self:PlayBubbleDialog(true)
    self.bubbleTimer = _G.TimerManager:GetInstance():GetTimer(
        bubble_continuous + bubble_hidden,
        self.PlayBubbleDialog,
        self
    )
    self.bubbleTimer:Start()
end

function HolidayPackView:PlayBubbleDialog(isFirst)
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
    self.BubbleRect1:SetLocalScaleXYZ(0)
    self.BubbleRect1:DOScale(1, 1, 1, 0.4)
    self.BubbleRect2:SetLocalScaleXYZ(0)
    self.BubbleRect2:DOScale(1, 1, 1, 0.4)
    local languageStr
    if self.bubbleIndex == 1 then
        languageStr = _G.GetLangPackValue(self.curBubbles[self.bubbleIndex], self.cfgs.todayCfg.token)
    elseif self.bubbleIndex == 2 then
        languageStr = _G.GetLangPackValue(self.curBubbles[self.bubbleIndex], _G.GetPlayerName(), _G.GetPlayerName())
    else
        languageStr = _G.GetLangPackValue(self.curBubbles[self.bubbleIndex])
    end
    self.bubbleIndex = self.bubbleIndex == #self.curBubbles and 1 or (self.bubbleIndex + 1)
    self.go_table.aortext_bubble1.text = languageStr
    self.go_table.aortext_bubble2.text = languageStr
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_bubble1.gameObject)
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_bubble2.gameObject)
    self.Timer = _G.TimerManager:GetInstance():GetTimer(bubble_continuous, self.GetTimerCallBack, self)
    self.Timer:Start()
end

function HolidayPackView:GetTimerCallBack()
    self.BubbleRect1:DOScale(0, 0, 0, 0.4):OnComplete(_G.handler(self, self.GetTimerCallBack1))
    self.BubbleRect2:DOScale(0, 0, 0, 0.4)
end

function HolidayPackView:GetTimerCallBack1()
    if _G.AppSetting.IsXzns then
        return
    end
    self.BubbleRect1:SetActiveE(self.BubbleRect1:GetActiveSelf() == 1 and 0 or 1)
    self.BubbleRect2:SetActiveE(self.BubbleRect2:GetActiveSelf() == 1 and 0 or 1)
end

--显示滚动log
function HolidayPackView:ShowLog()
    if self.logTimer ~= nil then
        self.logTimer:Stop()
    end
    self.logTimer = nil
    self.logTimer = _G.TimerManager:GetInstance():GetTimer(
        log_continuous,
        self.CreateLog,
        self
    )
    self.logTimer:Start()
end

--- 显示角色spine
function HolidayPackView:ShowRole()
    if _G.AppSetting.IsXzns then
        return
    end
    local roleStr = self.path_str and self.path_str[2] or ""
    if not string.IsNullOrEmpty(roleStr) then
        local strT = _G.string.split(roleStr, "#")
        _G.UIUtils.LoadEffectByPath(strT[1], self.go_table.obj_role,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans.gameObject:SetLocalScaleXYZ(tonumber(strT[5]))
                trans.gameObject:SetLocalPosition(tonumber(strT[2]), tonumber(strT[3]), tonumber(strT[4]))
            end)
    else
        local cardSid = 111010000
        local cfg = _G.ConfigManager.card_cfg[cardSid]
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table.obj_role,
            function(trans)
                if self:IsNil() then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
                    return
                end
                trans.gameObject:SetLocalScaleXYZ(cfg.size2)
                trans.gameObject:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
            end
        )
    end
end

--魂玉购买绑定
function HolidayPackView:OnBtnOnclickStoreExchange(go, data, index)
    if not _G.StorageManager:GetInstance():CheckItem(data.coin_type, data.price) then
        _G.PopWindowManager:GetInstance():ShowAllTips(230303)
        return
    end
    self.curActivityClass.typeClass.buyIndex = index
    self.curActivityClass.typeClass:BuyItem(data.sid, _G.handlerbind(self, self.BuyItemSuc, data))
end

---购买物品返回
function HolidayPackView:BuyItemSuc(data, item, call)
    if data.ack ~= 1 then
        return
    end
    local bol = true
    for i = 1, #self.cfgs.buy_gifts do
        if self.cfgs.buy_gifts[i].k == item.sid then
            self.cfgs.buy_gifts[i].v = self.cfgs.buy_gifts[i].v + 1
            bol = false
        end
    end
    if bol then
        _G.table.insert(self.cfgs.buy_gifts, { k = item.sid, v = 1 })
    end
    _G.StorageManager:GetInstance():ConsumeItem(item.coin_type, 0, item.price)
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    self:RefreshList()
    self:CreateLog(nil, _G.LangUtil.GetLangPackValue(90000011557, _G.GetPlayerName(), self.curActivityClass.typeClass.buyIndex or 2))
end
--RMB购买绑定
function HolidayPackView:OnBtnOnclickStoreExtra(go, data, index)
    self.curActivityClass.typeClass.buyIndex = index
    require("MallManager"):GetInstance():BuyActiveGift(
        data.price,
        self.curActivityClass:GetActivityID(),
        data.sid
    )
end

function HolidayPackView:OnClickToggle(go, isOn, index)
    local tb = self.toggleItem[index]
    if not tb then
        tb = _G.GetAutoGoTable(go)
    end
    tb.aortext_togDesc.color = _G.ColorTools.FormatColorByString(isOn and "410F0F" or "FEF3D8")
    self.go_table["obj_item" .. index]:SetActiveE(isOn and 1 or 0)
    if isOn then
        self.curActivityClass.typeClass:SetGiftRed(index)
        local time = _G.TimeUtil.GetServerUnixTime()
        tb.obj_redpoint:SetActiveE(
            time > _G.PlayerPrefsManager.GetInt(
            _G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPackGift" .. index
            ) and 1 or 0
        )
        if self.curGiftIndex ~= index then
            self.curGiftIndex = index
            self:RefreshList()
        end
    end
end

function HolidayPackView:OnClick_item(go, ison, data, index)
    if go:GetName() == "@_aorbtn_btnBuy" then
        if not _G.table.isEmptyOrNil(self.cfgs.buy_gifts) then
            for _, v in pairs(self.cfgs.buy_gifts) do
                if v.k == data.sid then
                    return
                end
            end
        end
        if data.coin_type == 0 then
            self:OnBtnOnclickStoreExtra(go, data, index)
        else
            self:OnBtnOnclickStoreExchange(go, data, index)
        end
    end
end

--刷新item
function HolidayPackView:RefreshList()
    local startIndex, endIndex = 1, 3
    if _G.AppSetting.IsXzns then
        startIndex = self.curGiftIndex
        endIndex = self.curGiftIndex
    end
    for i = startIndex, endIndex do
        local data
        data = self.cfgs.todayCfg.items[i]
        self.go_table.aortext_time2:SetActiveE(1)
        local objGame = self.go_table["obj_item" .. i]
        local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data, i))
        itemGoTable.aortext_limit:SetActiveE(1)
        itemGoTable.obj_Root:SetActiveE(1)
        itemGoTable.aortext_name:SetActiveE(1)
        itemGoTable.aortext_name2:SetActiveE(1)
        local node = itemGoTable.obj_Root
        if node:GetChildCountE() > 0 then
            for i = 1, node:GetChildCountE() do
                _G.PoolsManager:GetInstance():Despawn(node:GetChildE(0), _G.ePoolType.UIItem)
            end
        end
        for i = 1, #data.award do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.award[i].type,
                node,
                function(item)
                    item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    item:ShowEffectOrder(true)
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.award[i].type[1] == 0 and data.award[i].type[4] or data.award[i].type[1])
                end
            )
        end

        if _G.AppSetting.IsXzns then
            itemGoTable.aortext_desc.text = _G.math.ceil(data.discount / 10000) .. "%"
            _G.GameUtil.ReBuildRTF(itemGoTable.obj_Discount)
        else
            local str = _G.string.format("<size=36>%s</size>",_G.math.ceil(data.discount / 10000))
            itemGoTable.aortext_desc.text = _G.GetLangPackValue(90000013012, str)
        end

        local num = tonumber(data.name)
        itemGoTable.aortext_name.text = num and _G.GetLangPackValue(num) or data.name
        itemGoTable.aortext_name2.text = _G.GetLangPackValue(90000011573 + i - 1)
        local buyCount = 0
        for i = 1, #self.cfgs.buy_gifts do
            if self.cfgs.buy_gifts[i].k == data.sid then
                buyCount = self.cfgs.buy_gifts[i].v
            end
        end
        buyCount = buyCount or 0
        local restCount = data.count - buyCount
        if restCount > 0 then
            itemGoTable.aortext_limit.text = _G.GetLangPackValue(90000011045, restCount, data.count)
        else
            itemGoTable.aortext_limit.text = _G.GetLangPackValue(90000011045,
                _G.string.format("<color=#d0441f>%s</color>", restCount), data.count)
        end
        if buyCount >= data.count then
            itemGoTable.obj_price:SetActiveE(0)
            itemGoTable.obj_sellOut:SetActiveE(1)
            if _G.AppSetting.IsXzns then
                itemGoTable.aortext_rmb:SetActiveE(1)
                itemGoTable.aortext_rmb.text = _G.GetLangPackValue(90000011046)
                itemGoTable.aortext_rmb.color = _G.ColorTools.FormatColorByString("444444")
                itemGoTable.aorbtn_btnBuy:SetGray(true)
            else
                itemGoTable.aortext_rmb:SetActiveE(0)
                itemGoTable.aorbtn_btnBuy:SetActiveE(0)
            end
        else
            itemGoTable.aorbtn_btnBuy:SetGray(false)
            itemGoTable.obj_sellOut:SetActiveE(0)
            itemGoTable.aorbtn_btnBuy:SetActiveE(1)
            if data.coin_type == 0 then
                itemGoTable.obj_price:SetActiveE(0)
                itemGoTable.aortext_rmb:SetActiveE(1)
                _G.GameUtil.SetPriceByChannel(data.price, itemGoTable.aortext_rmb)
            else
                itemGoTable.obj_price:SetActiveE(1)
                itemGoTable.aortext_rmb:SetActiveE(0)
                itemGoTable.aorrawimage_price:LoadImage(_G.ConfigManager.currency_type_cfg[data.coin_type].icon)
                itemGoTable.aortext_price.text = tostring(data.price)
            end
        end
        _G.GameUtil.AddDouYinIcon(itemGoTable.aorbtn_btnBuy, true, nil, nil, nil, data.coin_type == 0 and data.price or 0)
    end
end

function HolidayPackView:SendMessage(text)
    if self.cfgs.todayCfg.token == text then
        self.curActivityClass.typeClass:GetAward(text, _G.handlerbind(self, self.InputCallBack))
    else
        _G.FloatTipsModel:GetInstance():Show(_G.LangUtil.GetLangPackValue(90000011526))
        self.go_table.input_input.text = ""
    end
end

--输入回调
function HolidayPackView:InputCallBack(data)
    self.go_table.input_input.text = ""
    if data.ack ~= 1 then
        return
    end
    _G.StorageManager:GetInstance():ReceiveAwardData(data)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
    self:CreateLog(nil, _G.GetLangPackValue(90000011527, _G.GetPlayerName()))
end
--创建滚动条条目
function HolidayPackView:CreateLog(go, text)
    local txt = text
    if not text then
        if not self.logIndex then
            txt = _G.LangUtil.GetLangPackValue(self.logTxt[1], _G.GetPlayerName())
            self.logIndex = 0
        else
            txt = _G.LangUtil.GetLangPackValue(self.logTxt[self.logRandom[self.logIndex]])
        end
        self.logIndex = self.logIndex == #self.logRandom and 1 or (self.logIndex + 1)
    end
    _G.table.insert(self.logData, txt)
    local len = #self.logData
    if len > 10 then
        _G.table.remove(self.logData, 1)
        len = len - 1
    end
    self.go_table.looplist2_:SetListItemCount(len)
    --显示最新消息
    self.go_table.looplist2_:MovePanelToItemIndex(len)
end

return HolidayPackView
