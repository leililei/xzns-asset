--活动的第几天
function HolidyaPackModel:GetNowDay()
    local startTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local time = _G.TimeUtil.GetServerUnixTime()
    return _G.math.ceil((time + 1 - startTime) / 86400)--刚跨天的时候结果会是上一天，多加1秒再计算天数
end
--检查是不是双十一当天
function HolidyaPackModel:CheckBigDay()
    local time = _G.TimeUtil.GetServerUnixTime()
    local dataT = {}
    TimeUtil.GetDateTime(time, dataT)
    return (dataT.day == 11 and dataT.month == 11 and dataT.hour >= _G.TimeUtil.GAME_DAY_HOUR) or (dataT.day == 12 and dataT.month == 11 and dataT.hour < _G.TimeUtil.GAME_DAY_HOUR)
end

--检查还有没有能买的礼包
function HolidyaPackModel:CheckCanBuyItem()
    -- local endTime, _ = self.curActivityClass:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    -- local time = _G.TimeUtil.GetServerUnixTime()
    -- if endTime - time > 86400 then 
    --     return true
    -- end
    local info = self:GetNowInfo()
    if not info.todayCfg then 
        return false 
    end
    if #info.buy_gifts < #info.todayCfg.items then 
        return true
    end
    for k, v in pairs(info.buy_gifts) do 
        for i = 1, #info.todayCfg.items do 
            if v.k == info.todayCfg.items[i].sid and v.v < info.todayCfg.items[i].count then 
                return true
            end
        end
    end
    return false
end
