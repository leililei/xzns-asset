local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager":GetInstance()
---@class HolidyaPackModel : ActivitySynTypeBase	
local HolidyaPackModel = _G.BaseClass("HolidyaPackModel", base)

---创建对象时,入口构造函数
function HolidyaPackModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    self.infocfgs = self.curActivityClass.cfg.self_info.live_room
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    self:RefreshRedPoint()
end

--rmb礼包购买回调
function HolidyaPackModel:OnMallCashListener(data)
    if data.activity_id == self.curActivityClass:GetActivityID() then
        local info = self:GetNowInfo()
        local bol = true
        for i = 1, #info.buy_gifts do 
            if info.buy_gifts[i].k == data.sid and info.buy_gifts[i].v < info.todayCfg.items[i].count then 
                info.buy_gifts[i].v = info.buy_gifts[i].v + 1
                bol = false
            end
        end
        if bol then 
            _G.table.insert(info.buy_gifts, {k = data.sid, v = 1})
        end
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HolidayPackView.Name)
        if ctrl then
            ctrl:RefreshList()
            ctrl:CreateLog(nil, _G.LangUtil.GetLangPackValue(90000011557, _G.GetPlayerName(), self.buyIndex or 2))
        end
    end
end

---获取服务器数据
function HolidyaPackModel:GetDataFormServer()
    self:GetInfo()
end

function HolidyaPackModel:HandleGMData(info)
    self.infocfgs = info.live_room
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.HolidayPackView.Name)
    if ctrl then
        ctrl:UpdateView(self.curActivityClass)
    end
end

function HolidyaPackModel:ParseData(data)
    self:HandleGMData(data)
    base.ParseData(self)
end

