--获取当天的活动数据
function HolidyaPackModel:GetNowInfo()
    local info = {}
    local day = self:GetNowDay()
    for i = 1, #self.infocfgs.live_room_cfg do 
        if self.infocfgs.live_room_cfg[i].index == day then 
            info.todayCfg = self.infocfgs.live_room_cfg[i]
            break
        end
    end
    self.infocfgs.buy_gifts = self.infocfgs.buy_gifts or {}
    info.buy_gifts = self.infocfgs.buy_gifts
    if day > 1 then 
        for i = 1, #self.infocfgs.live_room_cfg do 
            if self.infocfgs.live_room_cfg[i].index == day - 1 then 
                info.yesterdayCfg = self.infocfgs.live_room_cfg[i]
                break
            end
        end
    end
    return info
end 

function HolidyaPackModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.HolidayPackView.Name
end

---初始化红点树
function HolidyaPackModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function HolidyaPackModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function HolidyaPackModel:CheckRedPoint()
    if self.curActivityClass:GetCurActivityState() ~= require "ActivitySynManager".State.Open then
        return 0
    end
    if not self:CheckCanBuyItem() then 
        return 0
    end
    local dayLimit =
        _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPack" .. self.ActivityId)
    local now = _G.TimeUtil.GetServerUnixTime()
    if now > dayLimit then
        return 1
    end
    if _G.AppSetting.IsXzns then
        for i = 1, 3 do
            local time = _G.PlayerPrefsManager.GetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPackGift" .. i)
            if now > time then
                return 1
            end
        end
    end
    return 0
end

---红点刷新时间写入
function HolidyaPackModel:SetWeekRed()
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()) 
    local duration = 86400
    local endTime = time + duration
    _G.PlayerPrefsManager.SetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPack" .. self.ActivityId, endTime)
end

function HolidyaPackModel:SetGiftRed(index)
    local time = _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime())
    local duration = 86400
    local endTime = time + duration
    _G.PlayerPrefsManager.SetInt(_G.PlayerModel:GetInstance():GetPlayerUid() .. "HolidyaPackGift" .. index, endTime)
    self:RefreshRedPoint()
end

---刷新奖励红点
function HolidyaPackModel:RefreshRedPoint()
    local num = self:GetRedpointIDByIndex(1)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

--返回第二天6点的时间戳表
function HolidyaPackModel:GetNextDayT()
    local time = _G.TimeUtil.GetServerUnixTime()
    local dataT = {}
    _G.TimeUtil.GetDateTime(time, dataT)
    if dataT.hour > 5 then
        _G.TimeUtil.GetDateTime(time + 86400, dataT)
    end
    return dataT
end

function HolidyaPackModel:IsShowBtn()
    --父活动存在时, 不显示主界面按钮
    local parentActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        10043,
        self.curActivityClass:GetJumpType(),
        nil --self.curActivityClass:GetMainType()
    )
    if parentActivity then
        return false
    end
    return true
end

function HolidyaPackModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return HolidyaPackModel
