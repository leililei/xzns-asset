function HolidyaPackModel:OnEnterActivity()
    self:SetWeekRed()
    self:RefreshRedPoint()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HolidayPackView.Name, self.curActivityClass)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

