local base = require "BaseGameNet"
---@class HolidayPackNet : BaseGameNet	通信协议
local HolidayPackNet = _G.BaseClass("HolidayPackNet", base)

---拉数据
---@param pbData table PB数据
---@param callback function 完成回调
function HolidayPackNet:GetInfo(ID, callback)
    local pbData = {id = ID}
    local item = _G.ConfigManager.net_map.game_activity_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---购买魂玉礼包
---@param pbData table PB数据
---@param callback function 完成回调
function HolidayPackNet:BuyItem(ID, sid, callback)
    local pbData = {id = ID, prams = {2, sid}}
    local item = _G.ConfigManager.net_map.game_activity_get_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取密令奖励
---@param pbData table PB数据
---@param callback function 完成回调
function HolidayPackNet:GetAward(ID, str, callback)
    local pbData = {id = ID, prams = {1}, prams_str = str}
    local item = _G.ConfigManager.net_map.game_activity_get_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function HolidayPackNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type HolidayPackNet
_G.HolidayPackNet = HolidayPackNet
return HolidayPackNet
