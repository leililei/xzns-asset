local base = require "BaseGameNet"
---@class ChipGiftNet : BaseGameNet	通信协议
local ChipGiftNet = _G.BaseClass("ChipGiftNet", base)

---@return ChipGiftNet ChipGiftNet
function ChipGiftNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function ChipGiftNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_daily_store_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---领取每日碎片免费礼包
function ChipGiftNet:GetFreeAward(sid, callback)
    local item = _G.ConfigManager.net_map.game_daily_store_award
    local port = base.Access(self, item, {sid = sid}, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---选择英雄
function ChipGiftNet:ChangeCard(sid, callback)
    local item = _G.ConfigManager.net_map.game_daily_store_change
    local port = base.Access(self, item, {sid = sid}, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function ChipGiftNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type ChipGiftNet
_G.ChipGiftNet = ChipGiftNet
return ChipGiftNet
