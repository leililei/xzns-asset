local base = require "ActivitySynTypeBase"
---@class ChipGiftSynModel : ActivitySynTypeBase	中文描述
local ChipGiftSynModel = _G.BaseClass("ChipGiftSynModel", base)
-- _G.ChipGiftSynModel = ChipGiftSynModel

-- local CS = _G.CS
-- local typeof = _G.typeof

---创建对象时,入口构造函数
function ChipGiftSynModel:__init()
    self.ChipGiftModel = require "ChipGiftModel":GetInstance()
    self.ChipGiftModel:SetFreshRedPoint(_G.handler(self, self.RefreshRedPoint))
end

--- 网络请求初始化
function ChipGiftSynModel:GetDataFormServer()
    self.ChipGiftModel:GetInfo(_G.handler(self, self.ParseData))
end
---数据解析完成
function ChipGiftSynModel:ParseData()
    base.ParseData(self)
end
function ChipGiftSynModel:InitFunction()
    self.ChipGiftModel:InitFunction()
end
---进入活动主体
function ChipGiftSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ChipGiftView.Name)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
function ChipGiftSynModel:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.ChipGiftView.Name
end
---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ChipGiftSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end
function ChipGiftSynModel:CheckRedPoint()
    return self.ChipGiftModel:CheckRed()
end
---刷新奖励红点
function ChipGiftSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ChipGiftSynModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
--endregion

--endregion
---销毁对象时,析构函数
function ChipGiftSynModel:Dispose()
end

function ChipGiftSynModel:ReConnect(endcall)
    self.ChipGiftModel:ReConnect(endcall)
end
return ChipGiftSynModel
