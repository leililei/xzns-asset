local ChipGiftModel = require "ChipGiftModel"

---@class DailyChipGiftView : UIBaseView	中文描述
---@field public go_table DailyChipGiftView_GoTable GoTable
local DailyChipGiftView = _G.BaseClass("DailyChipGiftView", _G.UIBaseView)

function DailyChipGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_cancel"] = self.Close,
        ["@_aorbtn_closeView"] = self.Close,
        ["@_aorbtn_close"] = self.Close,
        ["@_aorbtn_sure"] = self.Select,
        ["@_aorbtn_lei"] = function()
            self:OnClickElement(_G.CardElementType.Thunder)
        end,
        ["@_aorbtn_feng"] = function()
            self:OnClickElement(_G.CardElementType.Wind)
        end,
        ["@_aorbtn_shui"] = function()
            self:OnClickElement(_G.CardElementType.Water)
        end,
        ["@_aorbtn_huo"] = function()
            self:OnClickElement(_G.CardElementType.Fire)
        end,
        ["@_aorbtn_tu"] = function()
            self:OnClickElement(_G.CardElementType.Earth)
        end,
        ["@_aorbtn_shen"] = function()
            self:OnClickElement(_G.CardElementType.God)
        end,
        ["@_aorbtn_all"] = function()
            self:OnClickElement(_G.CardElementType.None)
        end,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self.elementBtns = {
        self.go_table.aorbtn_all,
        self.go_table.aorbtn_lei,
        self.go_table.aorbtn_feng,
        self.go_table.aorbtn_shui,
        self.go_table.aorbtn_huo,
        self.go_table.aorbtn_tu,
        self.go_table.aorbtn_shen
    }
    self.go_table.scrollloopvectical_card:InitItemData(0, _G.handler(self, self.RefreshBagItem))
end

---界面的入口函数
function DailyChipGiftView:OnCreate(closecall)
    self.CloseCall = closecall
    self.CardItemList = {}
    self.CurSelectCard = ChipGiftModel:GetInstance():GetCurrentCard()
    local Cardlist = ChipGiftModel:GetInstance():GetCardList()
    local card_cfg = _G.ConfigManager.card_cfg
    ---五行卡牌表
    self.cardList = {}
    ---所有卡牌表
    self.CardList = {}
    local index = 0
    for _, id in pairs(Cardlist) do
        if card_cfg[id] then
            if not self.cardList[card_cfg[id].Elements] then
                self.cardList[card_cfg[id].Elements] = {}
            end
            index = index + 1
            _G.table.insert(self.cardList[card_cfg[id].Elements], { sid = id, index = index })
            _G.table.insert(self.CardList, { sid = id, index = index })
        end
    end
    local god = _G.CardElementType.God
    _G.SortList(
        self.CardList,
        function(data)
            local godIndex = 0
            if card_cfg[data.sid].Elements == god and _G.StorageManager:GetInstance():CheckItem(data.sid, 1) then
                godIndex = 1
            end
            local isGod = ChipGiftModel:GetInstance():FindCardIndex(data.sid)
            local typeIndex = isGod and 1 or 0
            return godIndex, -typeIndex, -data.index
        end
    )
    for _, type in pairs(_G.CardElementType) do
        if self.cardList[type] then
            _G.SortList(
                self.cardList[type],
                function(data)
                    local godIndex = 0
                    if type == god and _G.StorageManager:GetInstance():CheckItem(data.sid, 1) then
                        godIndex = 1
                    end
                    local isGod = ChipGiftModel:GetInstance():FindCardIndex(data.sid)
                    local typeIndex = isGod and 1 or 0
                    return godIndex, -typeIndex, -data.index
                end
            )
        end
    end
    self:OnClickElement(_G.CardElementType.None)
end

---点击元素
function DailyChipGiftView:OnClickElement(element)
    if self.chooseElementType == element then
        return
    end
    self.go_table.trans_choose:SetParentE(self.elementBtns[element + 1].transform)
    self.chooseElementType = element
    self.cardlist = {}
    if self.chooseElementType == 0 then
        self.cardlist = self.CardList
    else
        self.cardlist = self.cardList[self.chooseElementType]
    end
    local count = self.cardlist and #self.cardlist
    if count > 0 then
        if self.count ~= count then
            self.go_table.scrollloopvectical_card:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_card:UpdateAllItem()
        end
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(320114)
        self.go_table.scrollloopvectical_card:UpdateAllItem()
    end
end

function DailyChipGiftView:RefreshBagItem(index, obj)
    local x = index + 1
    local data = self.cardlist[x]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickCard, data))
    if not tb.card then
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.HeadItem_Select,
            tb.obj_cardNode,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item)
                    return
                end
                item.transform:SetLocalPositionToZero()
                item:Show(data.sid, nil, 1)
                item:isHave(true)
                item:SetSelectGou(self.CurSelectCard == data.sid)
                tb.card = item
            end
        )
    elseif tb.card ~= true then
        tb.card:Show(data.sid, nil, true)
        tb.card:isHave(true)
        tb.card:SetSelectGou(self.CurSelectCard == data.sid)
    end
end

function DailyChipGiftView:ClickCard(go, isOn, data)
    if self.CurSelectCard == data.sid then
        return
    end
    self.CurSelectCard = data.sid
    self.go_table.scrollloopvectical_card:UpdateAllItem()
end

function DailyChipGiftView:Select()
    local pan = false
    if self.CurSelectCard then
        local id = _G.tonumber(self.CurSelectCard)
        local data = _G.ConfigManager.item_cfg[id]
        if data then
            id = _G.tonumber(data.UseParameter[1][2])
        end

        pan = _G.StorageManager:GetInstance():GetIDMax(self.CurSelectCard, id)
    end

    if pan then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            622,
            nil,
            function()
                if self.CurSelectCard == ChipGiftModel:GetInstance():GetCurrentCard() then
                    self:Close()
                else
                    ChipGiftModel:GetInstance():ChangeCard(
                        self.CurSelectCard,
                        function()
                            if self.CloseCall then
                                self.CloseCall()
                            end
                            self:Close()
                        end
                    )
                end
            end
        )
    else
        if self.CurSelectCard == ChipGiftModel:GetInstance():GetCurrentCard() then
            self:Close()
        else
            ChipGiftModel:GetInstance():ChangeCard(
                self.CurSelectCard,
                function()
                    if self.CloseCall then
                        self.CloseCall()
                    end
                    self:Close()
                end
            )
        end
    end
end

--region 点击
---按钮点击事件在这里派发
function DailyChipGiftView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return DailyChipGiftView
