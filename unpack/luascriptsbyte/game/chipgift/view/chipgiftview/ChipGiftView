local typeof, CS, GetLangPackValue = _G.typeof, _G.CS, _G.GetLangPackValue

local BaseAwardNewItem = require "BaseAwardNewItem"
local ChipGiftModel = require "ChipGiftModel"

---角色碎片礼包页面
---@class ChipGiftView : UIBaseView	中文描述
---@field go_table ChipGiftView_GoTable GoTable
---@field curCardSid number                 当前选择的英雄sid
---@field curCardItem ItemCardAllView       当前选择英雄的显示节点
---@field productItems ChipGiftView._obj_item_GoTable[]         商品节点列表
---@field awardItemMapping table<number,table<number,any>>      商品奖励节点
local ChipGiftView = _G.BaseClass("ChipGiftView", _G.UIBaseView)

function ChipGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_getAll"] = self.BuyAll,
        ["@_aorbtn_select"] = self.SelectCard,
        ["@_aorbtn_help"] = self.PopHelp,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---界面的入口函数
function ChipGiftView:OnCreate()
    self:Init()
    self:InitEffect()
end

---界面的入口函数
function ChipGiftView:Init()
    local curCardSid = ChipGiftModel:GetInstance():GetCurrentCard()
    if self.curCardSid ~= curCardSid then
        self.curCardSid = curCardSid
        self:SetCurSelectedCard()
    end

    self:ShowProducts()
    self:ShowAllBought()
end

function ChipGiftView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SPbg,
        self.go_table.trans_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SPbiankuangtishi,
        self.go_table.trans_kuang,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.effect = trans
            local cfg = _G.ConfigManager.card_cfg[ChipGiftModel:GetInstance():GetCurrentCard()]
            self.effect:SetActiveE(not cfg and 1 or 0)
        end
    )
end

---展示一键购买状态
function ChipGiftView:ShowAllBought()
    local allProduct = ChipGiftModel:GetInstance():GetAllBoughtProduct()
    local callBuyAllProduct = ChipGiftModel:GetInstance():CanBuyAll()
    --一键购买状态丶价格显示
    self.go_table.aorbtn_getAll:SetGray(self.curCardSid == 0 or not callBuyAllProduct)

    local content = _G.GameUtil.SetPriceByChannel(allProduct.cfg.price_id)
    self.go_table.aortext_getAll.text = content .. GetLangPackValue(90021000017)
    local color = callBuyAllProduct and _G.Color.New(130 / 255, 58 / 255, 15 / 255, 1) or _G.Color.gray
    self.go_table.aortext_getAll.color = color
    self.go_table.aortext_alltext.color = color
end

---展示礼包列表
function ChipGiftView:ShowProducts()
    if not self.productItems then
        self.productItems = {}
    end
    if not self.awardItemMapping then
        self.awardItemMapping = {}
    end

    local products = ChipGiftModel:GetInstance():GetProducts() or {}
    local len = #products
    --显示礼包列表
    for i = 1, len do
        local item = self.productItems[i]
        local product = products[i]
        if not item then
            local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Grid)
            item = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGift, i))
            self.productItems[i] = item
        end
        item.gameObject:SetActiveE(1)
        local _, price = _G.GameUtil.SetPriceByChannel(product.cfg.price_id, self.go_table.aortext_get, nil, 90000010016)
        --价格显示
        if price <= 0 then
            item.aorimage_get:SetGray(false)
        else
            --默认未选择角色时置灰购买按钮
            item.aorimage_get:SetGray(self.curCardSid == 0)
        end
        --按钮状态
        local canBuy = ChipGiftModel:GetInstance():CanBuyProduct(product.cfg.id)
        _G.GameUtil.SetActiveByCondition(item.aorbtn_get, canBuy)
        _G.GameUtil.SetActiveByCondition(item.aorimage_complete, not canBuy)
        --物品展示
        local goods = ChipGiftModel:GetInstance():GetGift(product.cfg.id)
        if not _G.table.isEmptyOrNil(goods) then
            local goodsLen = #goods
            for j = 1, goodsLen do
                _G.GameUtil.SetActiveByCondition(item["aorimage_mask" .. j], not canBuy)
                if not self.awardItemMapping[i] then
                    self.awardItemMapping[i] = {}
                end
                if not self.awardItemMapping[i][j] then
                    self.awardItemMapping[i][j] =
                        BaseAwardNewItem.New(item["obj_itemRoot"], nil, 88, item["obj_itemRoot"])
                end
                local sid, num = table.unpack(goods[j])
                self.awardItemMapping[i][j]:ShowWithID(
                    { sid, num },
                    nil,
                    function(lua)
                        if lua.item.SetGradeNew then
                            lua.item:SetGradeNew(false)
                        end
                    end
                )
                self.awardItemMapping[i][j].gameObject:SetLocalScaleXYZ(0.83)
            end
            for j = goodsLen + 1, 4 do
                _G.GameUtil.SetActiveByCondition(item["aorimage_mask" .. j], false)
            end
        end
        item["obj_itemRoot"]:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = false
        item["obj_itemRoot"]:GetComponentE(typeof(CS.UnityEngine.UI.GridLayoutGroup)).enabled = true
    end
    --多余的节点进行隐藏
    for i = len + 1, #self.productItems do
        self.productItems[i].gameObject:SetActiveE(0)
    end
end

---设置当前选择的卡牌
function ChipGiftView:SetCurSelectedCard()
    if not self.CurCardItem then
        self.CurCardItem = require("ItemCardAllView").New(self.go_table.obj_select)
    end
    local cfg = _G.ConfigManager.card_cfg[ChipGiftModel:GetInstance():GetCurrentCard()]
    if cfg then
        self.CurCardItem:Show(cfg.id, nil, cfg.Star)
        self.CurCardItem:HideOrShowLevel(false)
        self.CurCardItem:HideOrShowElements(false)
        self.CurCardItem.gameObject:SetActiveE(1)
        if self.effect then
            self.effect:SetActiveE(0)
        end
    else
        self.CurCardItem.gameObject:SetActiveE(0)
        if self.effect then
            self.effect:SetActiveE(1)
        end
    end
end

---打开角色选择界面
function ChipGiftView:SelectCard()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.DailyChipGiftView.Name,
        _G.handler(self, self.OnSelectedCard)
    )
end

---当角色选择界面关掉
----@param 选择对应卡牌所对应的礼包索引
function ChipGiftView:OnSelectedCard()
    self.curCardSid = ChipGiftModel:GetInstance():GetCurrentCard()

    self:SetCurSelectedCard()
    self:ShowProducts()
    self:ShowAllBought()
end

---购买所有
function ChipGiftView:BuyAll()
    if self.curCardSid == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(750101)
    else
        if ChipGiftModel:GetInstance():CanBuyAll() then
            ChipGiftModel:GetInstance():BuyAll()
        end
    end
end

---玩法说明
function ChipGiftView:PopHelp()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 53)
end

--region 点击
---按钮点击事件在这里派发
function ChipGiftView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

function ChipGiftView:OnClickGift(go, isOn, index)
    if go:GetName() ~= "@_aorbtn_get" then
        return
    end
    local product = ChipGiftModel:GetInstance():GetProductByIndex(index)
    if not product or product.remainCount <= 0 then
        return
    end
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(product.cfg.price_id)
    if finalPrice <= 0 then
        ChipGiftModel:GetInstance():GetFreeAward(
            product.cfg.id,
            function()
                self:Init()
            end
        )
    else
        if self.curCardSid == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(750101)
        else
            ChipGiftModel:GetInstance():BuyProduct(product.cfg.id)
        end
    end
end

function ChipGiftView:CloseView()
    self:Close()
end

return ChipGiftView
