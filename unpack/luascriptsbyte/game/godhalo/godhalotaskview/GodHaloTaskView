---@class GodHaloTaskView : UIBaseView    中文描述
---@field public go_table GodHaloTaskView_GoTable GoTable
local GodHaloTaskView = _G.BaseClass("GodHaloTaskView", _G.UIBaseView)
local GodHaloModel = require("GodHaloModel")

function GodHaloTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GodHaloTaskView:OnCreate(data, callback)
    self:InitView()
end

---初始化页面
function GodHaloTaskView:InitView()
    self:RefreshTask()
end

---任务刷新
function GodHaloTaskView:RefreshTask()
    self.taskDatas = _G.ConfigManager.discrete_cfg[200702][1]
    if not self.isInited then
        self.go_table.scrollloopvectical_Group:InitItemData(#self.taskDatas, _G.handler(self, self.RefreshTaskItem))
        self.isInited = true
    else
        self.go_table.scrollloopvectical_Group:UpdateCount(#self.taskDatas)
    end
end

function GodHaloTaskView:RefreshTaskItem(index, obj)
    ---@type ActiveTaskPanel._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index + 1))
    go_table.obj_items:ClearChildren()
    local ID = self.taskDatas[index + 1]
    local data = GodHaloModel:GetInstance():GetTaskByTaskid(ID)
    data.Cfg = _G.ConfigManager.mission_cfg[ID]
    go_table.aortext_info.text = _G.LangUtil.GetLangPackValue(data.Cfg.desc)
    local count = #_G.PlayerModel:GetInstance():GetAllUnlockGodHalo()
    go_table.aorimage_noGet:SetActiveE(0)
    go_table.aorimage_get:SetActiveE(0)
    go_table.aorbtn_get:SetActiveE(1)
    go_table.aorimage_over:SetActiveE(0)
    if data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        go_table.aortext_jd.text = _G.string.format("(%s/%s)", count, data.Cfg.count)

        if count >= data.Cfg.count then
            go_table.aorimage_get:SetActiveE(1)
        else
            go_table.aorimage_noGet:SetActiveE(1)
        end
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        go_table.aortext_jd.text = _G.string.format("(%s/%s)", data.Cfg.count, data.Cfg.count)
        go_table.aorimage_over:SetActiveE(1)
        go_table.aorbtn_get:SetActiveE(0)
    else
        go_table.aortext_jd.text = _G.string.format("(%s/%s)", count, data.Cfg.count)
    end

    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            go_table.obj_items,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.7)
                tran.go_table.obj_ItemNum:SetActiveE(1)
            end
        )
    end
end

---点击任务
function GodHaloTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    local ID = self.taskDatas[index]
    local data = GodHaloModel:GetInstance():GetTaskByTaskid(ID)
    data.Cfg = _G.ConfigManager.mission_cfg[ID]
    if name == "@_aorbtn_get" then
        local msgTask = {}
        msgTask.task = { ID }
        msgTask.finish_type = 2
        data.i_task.state = _G.TaskEnum.ETaskState.Completed
        GodHaloModel:GetInstance():GodHaloFinishTask(msgTask, function(msg)
            self:RefreshTask()
            _G.UIUtils.ShowCommonAward(msg)
        end)
    elseif name == "@_aorimage_noGet" then
        _G.JumpManager:GetInstance():Jump(data.Cfg.link, nil)
    end
end

---按钮点击事件在这里派发
function GodHaloTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Click then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
    end
end

return GodHaloTaskView
