local SystemSettingNet = require("SystemSettingNet")

---@class GodHaloModel : GameDataModelBase	中文描述
local GodHaloModel = _G.BaseClass("GodHaloModel", _G.GameDataModelBase)

---@return GodHaloModel GodHaloModel
function GodHaloModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function GodHaloModel:__init()
    self.curFunctionOpenID = 1004
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end

---从服务器拉取数据
function GodHaloModel:GetDataFormServer()
    SystemSettingNet:GetInstance():GodHaloTaskGetInfo(_G.handler(self, self.ParseData))
end

function GodHaloModel:GetInfo(callBack)
    SystemSettingNet:GetInstance():GodHaloTaskGetInfo(
        function(msg)
            self:ParseData(msg)
            if callBack then
                callBack(msg)
            end
        end
    )
end

function GodHaloModel:OnSixClockUpdateCallback(endcall)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return
    end
    -- SystemSettingNet:GetInstance():GodHaloTaskGetInfo(_G.handler(self, self.ParseData))
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirst.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointGodHalo.id)
end

function GodHaloModel:UpdataTask(task)
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)

    return true
end

function GodHaloModel:ReConnect(endcall)
    self:GetDataFormServer()
    if endcall then
        endcall()
    end
end

function GodHaloModel:GetTaskByTaskid(sid)
    if self.tasks then
        for i = 1, #self.tasks do
            if sid == self.tasks[i].i_task.sid then
                self.tasks[i]:CheckTaskState()
                return self.tasks[i]
            end
        end
    end

    return nil
end

function GodHaloModel:ParseData(msg)
    local tasks = msg.task or {}
    local finish_task = msg.finish_task or {}
    self.tasks = {}
    for i = 1, #tasks do
        local ActiveTaskBase =
            require("GodHaloTaskData").New(
                tasks[i],
                function(data)
                end
            )

        table.insert(self.tasks, ActiveTaskBase)
    end

    for i = 1, #finish_task do
        local args = {}
        args.sid = finish_task[i]
        args.state = _G.TaskEnum.ETaskState.Completed
        args.target = { 1 }
        local ActiveTaskBase =
            require("GodHaloTaskData").New(
                args,
                function(data)
                end
            )

        table.insert(self.tasks, ActiveTaskBase)
    end

    self.super.ParseData(self)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirst.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointGodHalo.id)
end

function GodHaloModel:GodHaloFinishTask(pbData, callback)
    SystemSettingNet:GetInstance():GodHaloTaskFinish(
        pbData,
        function(msg)
            if msg.ack == 1 then
                if msg.award then
                    if _G.ConfigManager.god_halo_cfg[msg.award.item[1].type[1]] then
                        _G.PlayerModel:GetInstance():AddUnlockGodHalo(msg.award.item[1].type[1])
                    end
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                end
                if callback then
                    callback(msg)
                end
            end
        end
    )
end

function GodHaloModel:SetTask(data)
    for i = 1, #self.tasks do
        if data[1].sid == self.tasks[i].i_task.sid then
            self.tasks[i].i_task.state = data[1].state
        end
    end
end

---销毁对象时,析构函数
function GodHaloModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.OnSixClockUpdateCallback, self)
end

return GodHaloModel
