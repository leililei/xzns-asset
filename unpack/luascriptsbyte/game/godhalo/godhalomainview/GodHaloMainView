---界面的入口函数
function GodHaloMainView:OnCreate(GodHaloID, SelectType)
    --- 当前选择ID
    self.curHaloID = 0
    --- 当前data
    self.curData = {}
    --- 存储神环道具
    self.HaloList = {}
    self.isTypeID = false
    self.SelectType = SelectType or 1


    --- 存储神环道具
    self.HaloBagList = {}
    self.HaloBagDatas = {}

    self.go_table.aorimage_Tips:SetActiveE(0)
    self.go_table.aorbtn_TipsShow:SetActiveE(0)
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    _G.PlayerPrefsManager.SetInt(uid .. "RedPointGodHaloFirst", 1)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirst.id)
    self:SetProp()

    if GodHaloID then
        self.isTypeID = true
        self.curHaloID = GodHaloID
        local data = self.cfg[GodHaloID]
        self.ToggleOrder = data.grade
        self:InitView()
        self.isTypeID = false
    else
        self:InitView()
    end
end

---初始化页面
function GodHaloMainView:InitView()
    self.SuitNum = 0
    self.ToggleBagOrder = GodHaloSkillType.noUse

    self:InitDatas()
    self:UpdateAll()
    self:RefreshHaloDatas()
    self:InitBagView()
    self:RefreshView()
end

function GodHaloMainView:RefreshView()
    self.go_table.obj_MainView:SetActiveE(self.SelectType == 1 and 1 or 0)
    self.go_table.obj_BagView:SetActiveE(self.SelectType == 2 and 1 or 0)
    self.go_table.aorimage_Main:SetActiveE(self.SelectType == 1 and 1 or 0)
    self.go_table.aorimage_Bag:SetActiveE(self.SelectType == 2 and 1 or 0)
end

--- 初始化神环背包
function GodHaloMainView:InitBagView()
    self.SuitBagNum = 0
    local curNum = #_G.PlayerModel:GetInstance():GetAllUnlockGodHalo()
    self.go_table.aorimage_circle.fillAmount = curNum / #self.HaloDatas
    self.go_table.aortext_CircleNum.text = _G.GetLangPackValue(99000100009, curNum, #self.HaloDatas)

    self:InitBagDatas()
    self:UpdateBagAll()
end

function GodHaloMainView:UpdateBagAll()
    ---判断是不是初始化了
    if not self.InitBag then
        self.go_table.scrollloopvectical_allBag:InitItemData(self.SuitBagNum, _G.handler(self, self.RefreshBagList))
        self.InitBag = true
    else
        self.go_table.scrollloopvectical_allBag:UpdateCount(self.SuitBagNum)
    end
    self.go_table.scrollloopvectical_allBag:ScrollToTop()
end

function GodHaloMainView:RefreshBagList(index, obj)
    index = index + 1
    obj:SetName("$_obj_Item_" .. index)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local data = self.HaloBagDatas[index]

    local effectCfg

    for i = 1, #data.halo_effect do
        if _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]].effect_type == self.ToggleBagOrder then
            effectCfg = _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]]
        end
    end

    self.HaloBagList[index] = tb
    tb.aortext_name.text = _G.GetLangPackValue(effectCfg.skill_name)
    tb.aortext_des.text = _G.GetLangPackValue(effectCfg.skill_describe)
    tb.aorrawimage_SkillIcon:LoadImage(effectCfg.skill_icon)
    tb.aorimage_IconBG.SpriteName = self.Quility[effectCfg.grade]
    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(effectCfg.grade))
    ctm:SetItemTextGradient(tb.aortext_name, effectCfg.grade)
    tb.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    tb.aortext_name:SetActiveE(0)
    tb.aortext_name:SetActiveE(1)
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(data.id)

    local isWear = effectCfg.id == self.curHaloID
    local isShowSubstitution = false
    if isUnlock and self.curHaloID > 1 and effectCfg.effect_type == 2 and not isWear then
        isShowSubstitution = true
    end
    -- tb.aorrawimage_select:SetActiveE(isSelect and 1 or 0)
    tb.aortext_text:SetActiveE(isUnlock and effectCfg.effect_type == 1 and 1 or 0)
    tb.aortext_text2:SetActiveE(0)
    -- tb.aortext_text2:SetActiveE(isUnlock and 0 or 1)
    tb.aortext_text3:SetActiveE(isUnlock and effectCfg.effect_type ~= 1 and 1 or 0)
    tb.aortext_text3.text = ""

    -- tb.aorbtn_Wear:SetActiveE(isUnlock and self.curHaloID == 1 and effectCfg.effect_type == 2 and 1 or 0)
    tb.aorbtn_Wear:SetActiveE(0)
    -- tb.aorbtn_Wear2:SetActiveE(isShowSubstitution and 1 or 0)
    tb.aorbtn_Wear2:SetActiveE(0)
    -- tb.aorrawimage_SkillIcon:SetGray(not isUnlock)

    --- 技能装备在哪个神环上 空为0
    local skillGodHaloId = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfg.id)
    --- 技能原始在哪个神环上 空为0
    local skillGodHaloId2 = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillCfgID(effectCfg.id)

    if skillGodHaloId ~= 0 then
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.god_halo_cfg[skillGodHaloId].icon)
        tb.aorimage_bgGodHalo.SpriteName = _G.EquipItemIconName[data.grade]
    end
    tb.aorimage_bgGodHalo:SetActiveE(skillGodHaloId ~= 0 and 1 or 0)
    tb.aortext_des2.text = _G.GetLangPackValue(90049200094,
        _G.GetLangPackValue(_G.ConfigManager.god_halo_cfg[skillGodHaloId2].name))

    -- if skillGodHaloId ~= self.curData.id then
    --     tb.aortext_text3.text = ""
    -- else
    --     tb.aortext_text3.text = GetLangPackValue(90021300072)
    -- end
    local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(skillGodHaloId)
    --tb.aorimage_iconHero:SetActiveE(WearID ~= 0 and 1 or 0)
    tb.aorimage_ColorBg:SetActiveE(WearID > 1 and 1 or 0)
    -- tb.aorimage_bgGodHalo.SpriteName = self.Quility[effectCfg.grade]
    tb.aorimage_nameGrade.SpriteName = self.QuilityIcon[effectCfg.grade]
    tb.aorimage_bg.SpriteName = self.BGIcon[effectCfg.grade]
    tb.aorimage_bg2.SpriteName = self.BGIcon2[effectCfg.grade]

    if WearID > 1 then
        local cardCfg = _G.ConfigManager.card_cfg[WearID]
        tb.aorimage_iconHero.SpriteName = cardCfg.Icon
    end
end

function GodHaloMainView:InitBagDatas()
    for _, v in pairs(self.cfg) do
        --- 必须有神环技能
        if #v.halo_effect > 0 then
            for i = 1, #v.halo_effect do
                local effectCfg = _G.ConfigManager.god_halo_effect_cfg[v.halo_effect[i]]
                if self.ToggleBagOrder == effectCfg.effect_type then
                    local isShowCondition = v.get_display == 1

                    if _G.GlobalConditionManager.CheckConditionByArray({ v.condition_type }) then
                        if isShowCondition then
                            if _G.PlayerModel:GetInstance():IsUnlockGodHalo(v.id) then
                                self.SuitBagNum = self.SuitBagNum + 1
                                self.HaloBagDatas[self.SuitBagNum] = v
                            end
                        else
                            if effectCfg.skill_name ~= 0 then
                                self.SuitBagNum = self.SuitBagNum + 1
                                self.HaloBagDatas[self.SuitBagNum] = v
                            end
                        end
                    end
                end
            end
        end
    end


    if self.ToggleBagOrder == GodHaloSkillType.noUse then
        _G.table.sort(
            self.HaloBagDatas,
            function(a, b)
                local isUnlockA = _G.PlayerModel:GetInstance():IsUnlockGodHalo(a.id) and 1 or 0
                local isUnlockB = _G.PlayerModel:GetInstance():IsUnlockGodHalo(b.id) and 1 or 0

                local IsCurA = a.id == self.curData.id and 1 or 0
                local IsCurB = b.id == self.curData.id and 1 or 0

                if IsCurA == IsCurB then
                    if isUnlockA == 1 and isUnlockB == 1 then
                        local effectCfgA
                        local effectCfgB
                        for i = 1, #a.halo_effect do
                            if _G.ConfigManager.god_halo_effect_cfg[a.halo_effect[i]].effect_type == self.ToggleBagOrder then
                                effectCfgA = _G.ConfigManager.god_halo_effect_cfg[a.halo_effect[i]]
                            end
                        end


                        for i = 1, #b.halo_effect do
                            if _G.ConfigManager.god_halo_effect_cfg[b.halo_effect[i]].effect_type == self.ToggleBagOrder then
                                effectCfgB = _G.ConfigManager.god_halo_effect_cfg[b.halo_effect[i]]
                            end
                        end

                        local skillInGodHaloA = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfgA.id)
                        local skillInGodHaloB = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfgB.id)

                        if skillInGodHaloA ~= skillInGodHaloB then
                            return skillInGodHaloA < skillInGodHaloB
                        else
                            return a.sort < b.sort
                        end
                        return a.sort < b.sort
                    elseif isUnlockA == 1 or isUnlockB == 1 then
                        return isUnlockA > isUnlockB
                    else
                        return a.sort < b.sort
                    end
                else
                    return IsCurA > IsCurB
                end
            end
        )
    end

    self.obj_Toggle1 = _G.GetAutoGoTable(self.go_table.obj_Toggle1)
    self.obj_Toggle2 = _G.GetAutoGoTable(self.go_table.obj_Toggle2)
    self.obj_Toggle1.aorimage_TaskRed:SetActiveE(self.ToggleBagOrder == GodHaloSkillType.noUse and 1 or 0)
    self.obj_Toggle1.aorimage_TaskBlack:SetActiveE(self.ToggleBagOrder ~= GodHaloSkillType.noUse and 1 or 0)
    self.obj_Toggle2.aorimage_TaskRed:SetActiveE(self.ToggleBagOrder == GodHaloSkillType.needUse and 1 or 0)
    self.obj_Toggle2.aorimage_TaskBlack:SetActiveE(self.ToggleBagOrder ~= GodHaloSkillType.needUse and 1 or 0)
end

function GodHaloMainView:InitDatas()
    if not self.isTypeID then
        self.curHaloID = 0
    end

    --- 神环总数
    self.HaloDatas = {}
    self.HaloList = {}
    for _, v in pairs(self.cfg) do
        if self.ToggleOrder == v.grade or self.ToggleOrder == 0 then
            local isShowCondition = v.get_display == 1
            if _G.GlobalConditionManager.CheckConditionByArray({ v.condition_type }) then
                if isShowCondition then
                    if _G.PlayerModel:GetInstance():IsUnlockGodHalo(v.id) then
                        self.SuitNum = self.SuitNum + 1
                        self.HaloDatas[self.SuitNum] = v
                    end
                else
                    self.SuitNum = self.SuitNum + 1
                    self.HaloDatas[self.SuitNum] = v
                end
            end
        end
    end

    _G.SortList(
        self.HaloDatas,
        function(a)
            local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(a.id)
            local unlockType = isUnlock and 1 or 0
            return unlockType, a.grade, -a.sort
        end
    )
    if self.curHaloID == 0 then
        self.curHaloID = self.HaloDatas[1].id
        self.curData = self.HaloDatas[1]
    end

    if self.ToggleOrder == 0 then
        self.go_table.toggle_Toggle4.isOn = true
        self.go_table.aortext_ToggleName.text = _G.GetLangPackValue(90020200027)
    elseif self.ToggleOrder == _G.SpoilsQuilty.cai then
        self.go_table.toggle_Toggle1.isOn = true
        self.go_table.aortext_ToggleName.text = _G.GetLangPackValue(90033900014)
    elseif self.ToggleOrder == _G.SpoilsQuilty.hong then
        self.go_table.toggle_Toggle2.isOn = true
        self.go_table.aortext_ToggleName.text = _G.GetLangPackValue(90033900013)
    elseif self.ToggleOrder == _G.SpoilsQuilty.cheng then
        self.go_table.toggle_Toggle3.isOn = true
        self.go_table.aortext_ToggleName.text = _G.GetLangPackValue(90033900012)
    end
end

--- 刷新选中状态
function GodHaloMainView:RefreshHaloDatas()
    for i = 1, #self.HaloList do
        if self.HaloList[i].data.id == self.curHaloID then
            self.curData = self.HaloList[i].data
            self.HaloList[i].aorrawimage_select:SetActiveE(1)
        else
            self.HaloList[i].aorrawimage_select:SetActiveE(0)
        end

        local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.HaloList[i].data.id)
        self.HaloList[i].aorimage_ColorBg:SetActiveE(WearID > 1 and 1 or 0)

        if WearID > 1 then
            local cardCfg = _G.ConfigManager.card_cfg[WearID]
            self.HaloList[i].aorimage_iconHero.SpriteName = cardCfg.Icon
            self.HaloList[i].aorimage_Orderzi.SpriteName = orderDic[cardCfg.Order]
        end

        local isNew = self:GetIsNew(self.HaloDatas[i].id)
        self.HaloList[i].obj_redpoint:SetActiveE(isNew and 1 or 0)
    end
    self:RefreshViewShow()
end

--- 刷新界面信息
function GodHaloMainView:RefreshViewShow()
    self.go_table.aortext_Name.text = _G.GetLangPackValue(self.curData.name)

    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor =
        _G.ColorTools.FormatColorByString(
            require("CommonTipManager"):GetTipTypeNameOutLineColorByGrade(self.curData.grade)
        )
    ctm:SetItemTextGradient(self.go_table.aortext_Name, self.curData.grade)
    self.go_table.aortext_Name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    self.go_table.aortext_Name:SetActiveE(0)
    self.go_table.aortext_Name:SetActiveE(1)
    self.go_table.aorbtn_get2:SetActiveE(1)

    -- 如果装备了卡牌 展示形象
    local cardID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)
    if cardID > 1 then
        local temp = self.go_table.trans_role
        local tempCount = temp:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp:GetChildE(0), _G.ePoolType.Temporary)
        end

        local cfg = require "CardCommentManager":GetInstance():CardData(cardID, false)
        self:LoadRoleModel(_G.UIUtils.GetBattleSpine(cfg), i, cfg.size4, cfg)
        self.go_table.trans_role:SetActiveE(1)
        self.go_table.aorrawimage_norole:SetActiveE(0)
        self.go_table.aorbtn_get2:SetActiveE(0)
    else
        self.go_table.aorrawimage_norole:SetActiveE(1)
        self.go_table.trans_role:SetActiveE(0)
        if self.go_table.aorrawimage_norole:GetChildCountE() > 0 then
            for i = 1, self.go_table.aorrawimage_norole:GetChildCountE() do
                _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
            end
        end
        local effCfg = self.curData.ui_effect_cfg
        --- 神环路径，父级路径(加载角色的下面)
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[effCfg],
            self.go_table.aorrawimage_norole.gameObject,
            function()
                --- 跳转时重复加载处理
                if self.go_table.aorrawimage_norole:GetChildCountE() > 1 then
                    _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
                end
            end
        )
    end
    self.go_table.aortext_propName1.text = _G.AttrType[self.curData.base_att[1][1]].des .. "+"
    self.go_table.aortext_propName2.text = _G.AttrType[self.curData.base_att[2][1]].des .. "+"

    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute1 =
        AttributeClassManager:GetShowProp(
            self.curData.base_att[1][1],
            self.curData.base_att[1][2],
            self.curData.base_att[1][3],
            0.01,
            1,
            false
        )
    local attribute2 =
        AttributeClassManager:GetShowProp(
            self.curData.base_att[2][1],
            self.curData.base_att[2][2],
            self.curData.base_att[2][3],
            0.01,
            1,
            false
        )

    self.go_table.aortext_sumProp1.text = attribute1
    self.go_table.aortext_sumProp2.text = attribute2

    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)
    local isWear = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id) > 1
    local halo_effect = _G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect
    self.go_table.aorbtn_get2:SetActiveE(isUnlock and 1 or 0)

    --- 有任务条件才打开
    self.go_table.aortext_desc:SetActiveE(0)

    local taskID = self.curData.open_conditions[1] and self.curData.open_conditions[1][1] or nil
    if taskID and not isUnlock then
        self.go_table.aortext_desc:SetActiveE(1)
        local task = GodHaloModel:GetInstance():GetTaskByTaskid(taskID)
        local v1, v2 = task:GetCount()
        self.go_table.aortext_desc.text =
            _G.GetLangPackValue(task.Cfg.desc) .. "<color=#73CF64>(" .. v2 .. "/" .. v1 .. ")</color>"

        if v2 < v1 then
            self.go_table.aortext_desc.text =
                _G.GetLangPackValue(task.Cfg.desc) .. "<color=#FF2E51>(" .. v2 .. "/" .. v1 .. ")</color>"
        end
    end

    self.go_table.obj_redpointSkill2:SetActiveE(0)
    self.go_table.aortext_notActive:SetActiveE(0)
    self.go_table.aortext_tipsNoSkill:SetActiveE(0)
    if not isUnlock then
        --- 未解锁时 先把第二个 携带技能的框关了
        self.go_table.aorimage_BG:SetActiveE(0)
        self.go_table.aorimage_BG2:SetActiveE(0)
        self.go_table.aortext_notActive:SetActiveE(1)
        self.go_table.aortext_text.text = _G.GetLangPackValue(90000010012)
        self.go_table.aorimage_add2:SetActiveE(0)
        self.go_table.aorrawimage_skillIcon2:SetActiveE(1)
        -- self.go_table.aortext_skillTioShow.text = _G.GetLangPackValue(90049200036)
        --- 神环有技能
        if #halo_effect > 0 then
            local effectCfg =
                _G.ConfigManager.god_halo_effect_cfg[_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[1]]
            if effectCfg.effect_type == 1 then
                self.go_table.aorimage_BG:SetActiveE(1)
                self.go_table.aorrawimage_skillIcon:LoadImage(effectCfg.skill_icon)
                self.go_table.aortext_skillName.text = _G.GetLangPackValue(effectCfg.skill_name)
                self.go_table.aorimage_MidBG:SetActiveE(1)
                self.go_table.aorimage_nameGrade.SpriteName = self.QuilityIcon[effectCfg.grade]
                self.go_table.aorimage_BG.SpriteName = self.QuilityBGIcon[effectCfg.grade]
            else
                self.go_table.aorimage_BG2:SetActiveE(1)
                self.go_table.aorrawimage_skillIcon2:LoadImage(effectCfg.skill_icon)
                self.go_table.aortext_skillName2.text = _G.GetLangPackValue(effectCfg.skill_name)
