function GodHaloMainView:GetIsNew(id)
    local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
    for i = 1, #newList do
        if newList[i] == id then
            return true
        end
    end
    local isWear = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(id) > 1
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(id)

    if isUnlock and not isWear then
        return true
    end

    return false
end

function GodHaloMainView:SetProp()
    local iconDic = {
        ["max_hp"] = "ui_js_sm_icon",
        ["atk"] = "ui_js_gj_icon",
        ["def"] = "ui_js_fy_icon",
        ["bre"] = "ui_js_pj_icon",
        ["hit_rate"] = "ui_js_mzl_icon",
        ["avd_rate"] = "ui_js_sbl_icon",
        ["cri_rate"] = "ui_js_bjl_icon",
        ["cri_r_rate"] = "ui_js_kbl_icon",
        ["cri_dmg"] = "ui_js_bjsh_icon",
        ["cri_dmg_r"] = "ui_js_bsjm_icon",
        ["dmg_inc"] = "ui_js_shzj_icon",
        ["psy_d_r"] = "ui_js_wsjm_icon",
        ["mag_d_r"] = "ui_js_fsjm_icon",
        ["all_speed"] = "ui_js_js_icon",
        ["pvp_dmg"] = "ui_js_pvpzs_icon",
        ["pvp_dmg_r"] = "ui_js_pvpjs_icon",
        ["recover_rate"] = "ui_js_zy_icon",
        ["recover_suffer"] = "ui_js_sy_icon",
        ["control_dec"] = "ui_js_rx_icon"
    }

    --- 忽略  (不显示)
    local ignore = {
        ---雷伤增加
        [_G.AttrType.thd_dmg.key] = true,
        ---雷伤减免
        [_G.AttrType.thd_d_r.key] = true,
        ---风伤增加
        [_G.AttrType.air_dmg.key] = true,
        ---风伤减免
        [_G.AttrType.air_d_r.key] = true,
        ---水伤增加
        [_G.AttrType.water_dmg.key] = true,
        ---水伤减免
        [_G.AttrType.water_d_r.key] = true,
        ---火伤增加
        [_G.AttrType.fire_dmg.key] = true,
        ---火伤减免
        [_G.AttrType.fire_d_r.key] = true,
        ---土伤增加
        [_G.AttrType.earth_dmg.key] = true,
        ---土伤减免
        [_G.AttrType.earth_d_r.key] = true
    }
    local unlockList = _G.PlayerModel:GetInstance().un_god_halo
    local prop = {}
    for i = 1, #unlockList do
        local cfg = self.cfg[unlockList[i].k]
        if cfg.base_att then
            for j = 1, #cfg.base_att do
                local attr = cfg.base_att[j]

                --- 如果没有 先设置基础值
                if not prop[attr[1]] then
                    prop[attr[1]] = {}
                    prop[attr[1]][1] = 0
                    prop[attr[1]][2] = 0
                end

                prop[attr[1]][tonumber(attr[2])] = prop[attr[1]][tonumber(attr[2])] + attr[3]
            end
        end
    end
    local attrList = {}

    for i, v in pairs(prop) do
        if _G.AttrType[i] then
            local per = _G.ConfigManager.type_attribute_cfg[_G.AttrType[i].ID].value_type

            for j = 1, #v do
                if v[j] > 0 then
                    --- 四维按表里配置 其他属性按参数表 不得不说这个设计真是傻逼到了极点
                    if i == "atk" or i == "max_hp" or i == "bre" or i == "def" then
                        per = j
                    end
                    table.insert(
                        attrList,
                        {
                            key = i,
                            ID = _G.AttrType[i].ID,
                            sortid = _G.AttrType[i].sortid,
                            proptype = _G.AttrType[i].proptype,
                            icon = iconDic[i],
                            des = _G.AttrType[i].des,
                            percentage = per,
                            num = v[j]
                        }
                    )
                end
            end
        end
    end
    SortList(
        attrList,
        function(a)
            return -a.sortid
        end
    )
    self.go_table.aortext_NoneTipsText:SetActiveE(#attrList > 0 and 0 or 1)

    for _, v in pairs(attrList) do
        local key = v.key
        if ignore[key] == nil then
            local parent = self.go_table.obj_Prop2Content
            if parent ~= nil then
                local tran = _G.InstantiateObject(self.go_table.obj_BaseProp, parent)
                if tran then
                    local tb = _G.GetAutoGoTable(tran)
                    --tb.aorrawimage_icon:LoadImage(v.icon)
                    if v.icon then
                        tb.aorimage_icon:SetActiveE(1)
                        tb.aorimage_icon.SpriteName = v.icon
                    else
                        tb.aorimage_icon:SetActiveE(0)
                    end
                    tb.aortext_Name.text = v.des
                    tb.aorbtn_Click.onClick:AddListener(
                        _G.handlerbind(self, self.OnClickPropDetail, tb.aorbtn_Click, v.ID)
                    )
                    local num = v.num
                    if v.percentage == 2 then
                        num = num * 100 / 10000
                        --num = math.floor(num)
                        num = string.format("%0.1f", num) .. "%"
                        tb.aortext_Num.text = num
                    else
                        tb.aortext_Num.text = tostring(math.floor(num))
                    end
                end
            end
        end
    end
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function GodHaloMainView:LoadRoleModel(rolepath, posIndex, scale, cfg)
    ---@type RecordRankListView._obj_info1_GoTable
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.go_table.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            self.roleTrans = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end

            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local effCfg = self.curData.ui_effect_cfg
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                --- 神环路径，父级路径(加载角色的下面)
                _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                _G.UIUtils.LoadArtifacteffect(trans, cfg.id, nil, nil)
            end
        end
    )
end

function GodHaloMainView:UpdateAll()
    ---判断是不是初始化了
    if not self.Init then
        self.go_table.scrollloopvectical_all:InitItemData(self.SuitNum, _G.handler(self, self.RefreshList))
        self.Init = true
