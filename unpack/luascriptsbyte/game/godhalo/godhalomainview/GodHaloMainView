end

function GodHaloMainView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_Item_" .. index)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local data = self.HaloDatas[index]
    self.HaloList[index] = tb
    self.HaloList[index].data = data
    tb.aortext_name.text = _G.GetLangPackValue(data.name)

    tb.aorrawimage_icon:LoadImage(data.icon)
    tb.aorimage_bg.SpriteName = _G.EquipItemIconName[data.grade]

    local isSelect = data.id == self.curHaloID
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(data.id)
    local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(data.id)
    --tb.aorimage_iconHero:SetActiveE(WearID ~= 0 and 1 or 0)
    tb.aorimage_ColorBg:SetActiveE(WearID > 1 and 1 or 0)

    if WearID > 1 then
        local cardCfg = _G.ConfigManager.card_cfg[WearID]
        tb.aorimage_iconHero.SpriteName = cardCfg.Icon
        tb.aorimage_Orderzi.SpriteName = orderDic[cardCfg.Order]
    end

    local isNew = self:GetIsNew(data.id)
    tb.obj_redpoint:SetActiveE(isNew and 1 or 0)
    tb.aorrawimage_select:SetActiveE(isSelect and 1 or 0)
    tb.aorrawimage_lock:SetActiveE(isUnlock and 0 or 1)
    -- tb.obj_mask:SetActiveE(isUnlock and 0 or 1)
    -- tb.aorrawimage_icon:SetGray(not isUnlock)
    -- tb.aorimage_bg:SetGray(not isUnlock)
end

---选择卡牌后回调
---@param card ItemCardBodySelectView
function GodHaloMainView:SelectCallBack(card, indexDic)
    local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curData.id)
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)

    --- 当前神环装备卡牌ID
    local cardCurID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)

    if isUnlock then
        --- 神环已装备的卡牌ID等于选择的卡牌 传0 卸下神环 否则传选择的卡牌ID
        local cardSid = cardCurID == card.sid and 0 or card.sid

        _G.SystemSettingManager:GetInstance():PutGodHalo(
            { halo_id = self.curData.id, card_sid = cardSid, halo_id_skill = WearSkillID },
            function(msg)
                if msg.ack == 1 then
                    --- 如果神环已装备的卡牌ID等于选择的卡牌 卸下卡牌 当前神环的卡牌ID要为1
                    self.curCardID = cardCurID == card.sid and 1 or card.sid
                    _G.PlayerModel:GetInstance():SetUnlockGodHalo(cardSid, self.curData.id, WearSkillID)
                    _G.PlayerModel:GetInstance():SetUnGodHaloList(self.curData.id, WearSkillID)
                    self:RefreshHaloDatas()
                    local godHaloCurId = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id, true)

                    if godHaloCurId == _G.PlayerModel:GetInstance():GetRoleSid() then
                        _G.PlayerModel:GetInstance():SetGodHaloToRole(self.curData.id)
                    end
                end
            end
        )
    else
        --- 没解锁的时候选了哪张卡当前就是哪张卡
        self.curCardID = card.sid
        self:RefreshHaloDatas()
    end
end

function GodHaloMainView:OnClickItem(obj, _, index)
    if _G.AppSetting.Debug then
        Log(index, "点击")
    end

    local data = self.HaloList[index].data
    self.curHaloID = data.id
    local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
    for i = #newList, 1, -1 do
        if newList[i] == data.id then
            local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curHaloID)
            if WearID > 1 then
                table.remove(newList, i)
                self.HaloList[index].obj_redpoint:SetActiveE(0)
            end
        end
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirstOne.id)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointGodHalo.id)

    self:RefreshHaloDatas()
end

---按钮点击事件在这里派发
function GodHaloMainView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_close then
        self:Close()
        for _, window in pairs(self.WindowName) do
            local view = UIManager:GetWindow(window)
            if view then
                UIManager:CloseWindow(window)
            end
        end
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.PointGodHaloFirstOne.id)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointGodHalo.id)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRoleGodHalo.id)
    elseif go == self.go_table.aorbtn_help then
        UIManager:OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 120)
    elseif go == self.go_table.aorbtn_ToggleBtn then
        if self.go_table.aorimage_toggles:GetActiveSelf() == 1 then
            self.go_table.aorimage_toggles:SetActiveE(0)
        else
            self.go_table.aorimage_toggles:SetActiveE(1)
        end
    elseif name == "@_toggle_Toggle1" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.cai
            self:InitView()
            self.go_table.aorimage_toggles:SetActiveE(0)
        end
    elseif name == "@_toggle_Toggle2" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.hong
            self:InitView()
            self.go_table.aorimage_toggles:SetActiveE(0)
        end
    elseif name == "@_toggle_Toggle3" then
        if isOn then
            self.ToggleOrder = _G.SpoilsQuilty.cheng
            self:InitView()
            self.go_table.aorimage_toggles:SetActiveE(0)
        end
    elseif name == "@_toggle_Toggle4" then
        if isOn then
            self.ToggleOrder = 0
            self:InitView()
            self.go_table.aorimage_toggles:SetActiveE(0)
        end
    elseif name == "@_aorbtn_get" or name == "@_aorbtn_get2" then
        if _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id) then
            -- _G.UIManager:GetInstance():OpenWindow(
            --     _G.ConfigManager.ui_cfg.GodHaloShowView.Name,
            --     self.curData,
            --     nil,
            --     nil,
            --     function()
            --         self:RefreshHaloDatas()
            --     end
            -- )

            local cardID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)
            --- 点击完不管怎么样，都先把红点刷掉
            local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
            for i = #newList, 1, -1 do
                if newList[i] == self.curData.id then
                    table.remove(newList, i)
                end
            end
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CardMaCheView_selectHero.Name,
                0,
                _G.handler(self, self.SelectCallBack),
                cardID
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
        end
    elseif name == "@_aorbtn_Skill3" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GodHaloShowView.Name,
            self.curData,
            nil,
            nil,
            function()
                self:RefreshHaloDatas()
            end
        )
    elseif name == "@_aorbtn_Skill2" or name == "@_aorbtn_Skill4" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name,
            self.curData,
            function()
                self:RefreshHaloDatas()
            end,
            2
        )
    elseif name == "@_aorbtn_Skill" then
        local cfg = _G.ConfigManager.god_halo_effect_cfg[self.curData.halo_effect[1]]
        local type = 0
        if #self.curData.halo_effect > 1 then
            type = 1
        else
            type = cfg.effect_type
        end

        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name,
            self.curData,
            function()
                self:RefreshHaloDatas()
            end,
            type
        )
    elseif name == "@_aorbtn_View2" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name,
            self.curData,
            function()
                self:RefreshHaloDatas()
            end
        )
    elseif name == "@_aorbtn_View1" or name == "@_aorbtn_ViewBag1" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TeamHallAttrGodHaloPanel.Name)
        --self.go_table.aorimage_Tips:SetActiveE(1)
        --self.go_table.aorbtn_TipsShow:SetActiveE(1)
    elseif name == "@_aorbtn_TipsShow" or name == "@_aorbtn_TipsShow2" then
        self.go_table.aorimage_Tips:SetActiveE(0)
        self.go_table.aorbtn_TipsShow:SetActiveE(0)
    elseif name == "@_aorbtn_Help" or name == "@_aorbtn_Help2" then
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1003)
    elseif name == "@_aorbtn_ViewBag2" then
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloTaskView.Name)
    elseif name == "@_aorbtn_Bag" then
        self.SelectType = 2
        self:RefreshView()
    elseif name == "@_aorbtn_Main" then
        self.SelectType = 1
        self:RefreshView()
    elseif name == "$_obj_Toggle1" then
        self.ToggleBagOrder = GodHaloSkillType.noUse
        self.SuitBagNum = 0
        self:InitBagDatas()
        self.go_table.scrollloopvectical_allBag:UpdateCount(self.SuitBagNum)
    elseif name == "$_obj_Toggle2" then
        self.ToggleBagOrder = GodHaloSkillType.needUse
        self.SuitBagNum = 0
        self:InitBagDatas()
        self.go_table.scrollloopvectical_allBag:UpdateCount(self.SuitBagNum)
    end
end

