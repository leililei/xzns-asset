local SpoilsModel = require("SpoilsModel")
local CardInfoManager = require("CardInfoManager")
local CommonTipManager = require("CommonTipManager")

---@class GodHaloSkillShowView : UIBaseView    中文描述
---@field public go_table GodHaloSkillShowView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field SuitDatas spoils_suit_cfg
local GodHaloSkillShowView = _G.BaseClass("GodHaloSkillShowView", _G.UIBaseView)

function GodHaloSkillShowView:Awake()
    self.Quility = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_dikuang_cheng",
        [_G.SpoilsQuilty.hong] = "ui_jn_dikuang_hong",
        [_G.SpoilsQuilty.cai] = "ui_jn_dikuang_cai"
    }

    self.QuilityIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_icon_shishi",
        [_G.SpoilsQuilty.hong] = "ui_jn_icon_chuanshuo",
        [_G.SpoilsQuilty.cai] = "ui_jn_icon_shenghua"
    }


    
    self.BGIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_shjm_gx2_hdk2",
        [_G.SpoilsQuilty.hong] = "ui_shjm_gx2_hdk",
        [_G.SpoilsQuilty.cai] = "ui_shjm_gx2_dk"
    }

      self.BGIcon2 = {
        [_G.SpoilsQuilty.cheng] = "ui_shjm_gx2_huangd",
        [_G.SpoilsQuilty.hong] = "ui_shjm_gx2_hongd",
        [_G.SpoilsQuilty.cai] = "ui_shjm_gx2_hd"
    }
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local GodHaloSkillType = {
    noUse = 2,
    needUse = 1,
}


---界面的入口函数
function GodHaloSkillShowView:OnCreate(data, callback, typeChoose)
    self.callback = callback
    --- 当前data
    self.curData = data
    --- 当前选择ID
    self.curHaloID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curData.id)

    --- 存储神环道具
    self.HaloList = {}
    self.HaloDatas = {}

    --- _G.ConfigManager.god_halo_cfg
    self.cfg = _G.ConfigManager.god_halo_cfg
    self.ToggleOrder = GodHaloSkillType.noUse

    if typeChoose then
        self.ToggleOrder = typeChoose
    end

    self:InitView()
end

---初始化页面
function GodHaloSkillShowView:InitView()
    self.SuitNum = 0
    self:InitDatas()
    self:UpdateAll()
end

function GodHaloSkillShowView:UpdateAll()
    ---判断是不是初始化了
    if not self.Init then
        self.go_table.scrollloopvectical_all:InitItemData(self.SuitNum, _G.handler(self, self.RefreshList))
        self.Init = true
    else
        self.go_table.scrollloopvectical_all:UpdateCount(self.SuitNum)
    end
    self.go_table.scrollloopvectical_all:ScrollToTop()
end

function GodHaloSkillShowView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_Item_" .. index)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local data = self.HaloDatas[index]

    local effectCfg

    for i = 1, #data.halo_effect do
        if _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]].effect_type == self.ToggleOrder then
            effectCfg = _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]]
        end
    end

    self.HaloList[index] = tb
    tb.aortext_name.text = _G.GetLangPackValue(effectCfg.skill_name)
    tb.aortext_des.text = _G.GetLangPackValue(effectCfg.skill_describe)
    tb.aorrawimage_SkillIcon:LoadImage(effectCfg.skill_icon)
    tb.aorimage_IconBG.SpriteName = self.Quility[effectCfg.grade]
    local ctm = require "CommonTipManager":GetInstance()
    local outlineColor = _G.ColorTools.FormatColorByString(require("CommonTipManager")
        :GetTipTypeNameOutLineColorByGrade(effectCfg.grade))
    ctm:SetItemTextGradient(tb.aortext_name, effectCfg.grade)
    tb.aortext_name:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = outlineColor
    tb.aortext_name:SetActiveE(0)
    tb.aortext_name:SetActiveE(1)
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(data.id)

    local isWear = effectCfg.id == self.curHaloID
    local isShowSubstitution = false
    if isUnlock and self.curHaloID > 1 and effectCfg.effect_type == 2 and not isWear then
        isShowSubstitution = true
    end
    -- tb.aorrawimage_select:SetActiveE(isSelect and 1 or 0)
    tb.aortext_text:SetActiveE(isUnlock and effectCfg.effect_type == 1 and 1 or 0)
    tb.aortext_text2:SetActiveE(isUnlock and 0 or 1)
    tb.aortext_text3:SetActiveE(isUnlock and effectCfg.effect_type ~= 1 and 1 or 0)

    tb.aorbtn_Wear:SetActiveE(isUnlock and self.curHaloID == 1 and effectCfg.effect_type == 2 and 1 or 0)
    tb.aorbtn_Wear2:SetActiveE(isShowSubstitution and 1 or 0)
    -- tb.aorrawimage_SkillIcon:SetGray(not isUnlock)

    --- 技能装备在哪个神环上 空为0
    local skillGodHaloId = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfg.id)
    --- 技能原始在哪个神环上 空为0
    local skillGodHaloId2 = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillCfgID(effectCfg.id)

    if skillGodHaloId ~= 0 then
        tb.aorrawimage_icon:LoadImage(_G.ConfigManager.god_halo_cfg[skillGodHaloId].icon)
        tb.aorimage_bgGodHalo.SpriteName = _G.EquipItemIconName[data.grade]
    end
    tb.aorimage_bgGodHalo:SetActiveE(skillGodHaloId ~= 0 and 1 or 0)
    tb.aortext_des2.text = _G.GetLangPackValue(90049200094,
        _G.GetLangPackValue(_G.ConfigManager.god_halo_cfg[skillGodHaloId2].name))

    if skillGodHaloId ~= self.curData.id then
        tb.aortext_text3.text = ""
    else
        tb.aortext_text3.text = GetLangPackValue(90021300072)
    end
    local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(skillGodHaloId)
    --tb.aorimage_iconHero:SetActiveE(WearID ~= 0 and 1 or 0)
    tb.aorimage_ColorBg:SetActiveE(WearID > 1 and 1 or 0)
    -- tb.aorimage_bgGodHalo.SpriteName = self.Quility[effectCfg.grade]
    tb.aorimage_nameGrade.SpriteName = self.QuilityIcon[effectCfg.grade]
    tb.aorimage_bg.SpriteName = self.BGIcon[effectCfg.grade]
    tb.aorimage_bg2.SpriteName = self.BGIcon2[effectCfg.grade]

    if WearID > 1 then
        local cardCfg = _G.ConfigManager.card_cfg[WearID]
        tb.aorimage_iconHero.SpriteName = cardCfg.Icon
    end
end

function GodHaloSkillShowView:OnClickItem(obj, _, index)
    if _G.AppSetting.Debug then
        Log(index, "点击")
    end

    local data = self.HaloDatas[index]
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)
    local isWear = data.id == self.curHaloID

    if not isUnlock then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
        self:Close()
    else
        local effectCfg

        for i = 1, #data.halo_effect do
            if _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]].effect_type == self.ToggleOrder then
                effectCfg = _G.ConfigManager.god_halo_effect_cfg[data.halo_effect[i]]
            end
        end

        if effectCfg.effect_type ~= 1 then
            if not isWear then
                local WearSkillID = effectCfg.id
                local cardID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)
                _G.SystemSettingManager:GetInstance():PutGodHalo(
                    { halo_id = self.curData.id, card_sid = cardID, halo_id_skill = WearSkillID },
                    function(msg)
                        if msg.ack == 1 then
                            -- _G.PlayerModel:GetInstance():SetUnlockGodHalo(cardID, self.curData.id, WearSkillID)
                            _G.PlayerModel:GetInstance():SetUnGodHaloList(self.curData.id, WearSkillID)
                            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg
                                .RedPointGodHaloSkill.id)

                            if self.callback then
                                self.callback()
                            end
                        end
                    end)
                self:Close()
            end
        end
    end
end

function GodHaloSkillShowView:InitDatas()
    for _, v in pairs(self.cfg) do
        --- 必须有神环技能
        if #v.halo_effect > 0 then
            for i = 1, #v.halo_effect do
                local effectCfg = _G.ConfigManager.god_halo_effect_cfg[v.halo_effect[i]]
                if self.ToggleOrder == effectCfg.effect_type then
                    local isShowCondition = v.get_display == 1

                    if _G.GlobalConditionManager.CheckConditionByArray({ v.condition_type }) then
                        if isShowCondition then
                            if _G.PlayerModel:GetInstance():IsUnlockGodHalo(v.id) then
                                self.SuitNum = self.SuitNum + 1
                                self.HaloDatas[self.SuitNum] = v
                            end
                        else
                            if effectCfg.skill_name ~= 0 then
                                self.SuitNum = self.SuitNum + 1
                                self.HaloDatas[self.SuitNum] = v
                            end
                        end
                    end
                end
            end
        end
    end


    if self.ToggleOrder == GodHaloSkillType.noUse then
        _G.table.sort(
            self.HaloDatas,
            function(a, b)
                local isUnlockA = _G.PlayerModel:GetInstance():IsUnlockGodHalo(a.id) and 1 or 0
                local isUnlockB = _G.PlayerModel:GetInstance():IsUnlockGodHalo(b.id) and 1 or 0

                local IsCurA = a.id == self.curData.id and 1 or 0 
                local IsCurB = b.id == self.curData.id and 1 or 0 

                if IsCurA == IsCurB then
                    if isUnlockA == 1 and isUnlockB == 1 then
                        local effectCfgA
                        local effectCfgB
                        for i = 1, #a.halo_effect do
                            if _G.ConfigManager.god_halo_effect_cfg[a.halo_effect[i]].effect_type == self.ToggleOrder then
                                effectCfgA = _G.ConfigManager.god_halo_effect_cfg[a.halo_effect[i]]
                            end
                        end


                        for i = 1, #b.halo_effect do
                            if _G.ConfigManager.god_halo_effect_cfg[b.halo_effect[i]].effect_type == self.ToggleOrder then
                                effectCfgB = _G.ConfigManager.god_halo_effect_cfg[b.halo_effect[i]]
                            end
                        end

                        local skillInGodHaloA = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfgA.id)
                        local skillInGodHaloB = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillID(effectCfgB.id)

                        if skillInGodHaloA ~= skillInGodHaloB then
                            return skillInGodHaloA < skillInGodHaloB
                        else
                            return a.sort < b.sort
                        end
                        return a.sort < b.sort
                    elseif isUnlockA == 1 or isUnlockB == 1 then
                        return isUnlockA > isUnlockB
                    else
                        return a.sort < b.sort
                    end
                else
                        return IsCurA > IsCurB
 
                end
            end
        )
    end

    self.obj_Toggle1 = _G.GetAutoGoTable(self.go_table.obj_Toggle1)
    self.obj_Toggle2 = _G.GetAutoGoTable(self.go_table.obj_Toggle2)
    self.obj_Toggle1.aorimage_TaskRed:SetActiveE(self.ToggleOrder == GodHaloSkillType.noUse and 1 or 0)
    self.obj_Toggle1.aorimage_TaskBlack:SetActiveE(self.ToggleOrder ~= GodHaloSkillType.noUse and 1 or 0)
    self.obj_Toggle2.aorimage_TaskRed:SetActiveE(self.ToggleOrder == GodHaloSkillType.needUse and 1 or 0)
    self.obj_Toggle2.aorimage_TaskBlack:SetActiveE(self.ToggleOrder ~= GodHaloSkillType.needUse and 1 or 0)
end

---按钮点击事件在这里派发
function GodHaloSkillShowView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_CloseView then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Click then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
    elseif name == "@_obj_Toggle1" then
        if isOn then
            self.ToggleOrder = GodHaloSkillType.noUse
            self.SuitNum = 0
            self:InitDatas()
            self.go_table.scrollloopvectical_all:UpdateCount(self.SuitNum)
        end
    elseif name == "@_obj_Toggle2" then
        if isOn then
            self.ToggleOrder = GodHaloSkillType.needUse
            self.SuitNum = 0
            self:InitDatas()
            self.go_table.scrollloopvectical_all:UpdateCount(self.SuitNum)
        end
    end
end

return GodHaloSkillShowView
