local SpoilsModel = require("SpoilsModel")
local CardInfoManager = require("CardInfoManager")
local CommonTipManager = require("CommonTipManager")

---@class GodHaloShowView : UIBaseView    中文描述
---@field public go_table GodHaloShowView_GoTable GoTable
---@field cfgList limit_broken_cfg[]
---@field SuitDatas spoils_suit_cfg
local GodHaloShowView = _G.BaseClass("GodHaloShowView", _G.UIBaseView)

function GodHaloShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---@class GodHaloShowView.price
---@field icon string
---@field num number

---界面的入口函数
---@param data god_halo_cfg
---@param price GodHaloShowView.price
function GodHaloShowView:OnCreate(data, price, shopData, buyback, shopBack, hideBtn)
    self.hideBtn = hideBtn
    self.curData = data
    self.price = price
    self.buyback = buyback
    self.shopBack = shopBack
    self.shopData = shopData
    --- 新需求 临时预览卡牌ID
    self.curCardID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)
    self:InitView()
end

---初始化页面
function GodHaloShowView:InitView()
    self.go_table.aortext_title.text = _G.GetLangPackValue(self.curData.name)
    self.go_table.aortext_propName1.text = _G.AttrType[self.curData.base_att[1][1]].des .. ":"
    self.go_table.aortext_propName2.text = _G.AttrType[self.curData.base_att[2][1]].des .. ":"

    self.BGIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_shjm_gx2_hdk2",
        [_G.SpoilsQuilty.hong] = "ui_shjm_gx2_hdk",
        [_G.SpoilsQuilty.cai] = "ui_shjm_gx2_dk"
    }

    self.QuilityIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_icon_shishi",
        [_G.SpoilsQuilty.hong] = "ui_jn_icon_chuanshuo",
        [_G.SpoilsQuilty.cai] = "ui_jn_icon_shenghua"
    }


    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    local attribute1 = AttributeClassManager:GetShowProp(self.curData.base_att[1][1], self.curData.base_att[1][2],
        self.curData.base_att[1][3], 0.01, 1, false)
    local attribute2 = AttributeClassManager:GetShowProp(self.curData.base_att[2][1], self.curData.base_att[2][2],
        self.curData.base_att[2][3], 0.01, 1, false)

    self.go_table.aortext_sumProp1.text = attribute1
    self.go_table.aortext_sumProp2.text = attribute2
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)


    self.go_table.aorrawimage_SkillIcon:SetActiveE(0)
    self.go_table.aortext_name:SetActiveE(0)
    self.go_table.obj_des:SetActiveE(0)
    self.go_table.aorimage_add:SetActiveE(0)
    self.go_table.aortext_noSkill:SetActiveE(0)

    if self.price then
        self.go_table.aorbtn_buy:SetActiveE(isUnlock and 0 or 1)
        self.go_table.aorbtn_Click:SetActiveE(0)
        self.go_table.aorimage_View1:SetActiveE(0)
        self.go_table.aorrawimage_price:LoadImage(self.price.icon)
        self.go_table.aortext_price.text = self.price.num
    elseif self.hideBtn then
        self.go_table.aorbtn_Click:SetActiveE(0)
    else
        self.go_table.aorbtn_buy:SetActiveE(0)
        self.go_table.aorbtn_Click:SetActiveE(1)
        self.go_table.aorimage_showCard2:SetActiveE(0)
        self.go_table.aorimage_showCard:SetActiveE(0)
    end


    if isUnlock then
        self.go_table.aorimage_showCard:SetActiveE(1)
        local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curData.id)
        --- 已装备技能
        if WearSkillID > 1 then
            local effectCfg = _G.ConfigManager.god_halo_effect_cfg[WearSkillID]
            self.go_table.aorimage_bg2.SpriteName = self.BGIcon[effectCfg.grade]

            self.go_table.aorrawimage_SkillIcon:LoadImage(effectCfg.skill_icon)
            local skillGodHaloId = _G.PlayerModel:GetInstance():GetGodHaloIDBySkillCfgID(WearSkillID)

            self.go_table.aortext_name.text = _G.GetLangPackValue(90049200094,
                _G.GetLangPackValue(_G.ConfigManager.god_halo_cfg[skillGodHaloId].name))
            -- self.go_table.aortext_View2.text = _G.GetLangPackValue(effectCfg.name)

            self.go_table.aortext_des.text = _G.GetLangPackValue(effectCfg.skill_describe)
            self.go_table.aorrawimage_SkillIcon:SetActiveE(1)
            self.go_table.aorimage_nameGrade2.SpriteName = self.QuilityIcon[effectCfg.grade]
            self.go_table.aortext_name:SetActiveE(1)
            self.go_table.obj_des:SetActiveE(1)
        else
            --- 解锁但没有装备技能
            self.go_table.aorimage_add:SetActiveE(1)
        end
        self.go_table.aortext_ClickBtn.text = _G.GetLangPackValue(90012500401)
        self.go_table.aortext_title2.text = _G.GetLangPackValue(90049200033)
        self.go_table.aorrawimage_shuaxin:SetActiveE(1)
        self.go_table.obj_CenterDeep1:SetActiveE(0)
    else
        self.go_table.aorrawimage_shuaxin:SetActiveE(0)
        self.go_table.aorimage_showCard2:SetActiveE(1)
        --- 未解锁
        self.go_table.aortext_ClickBtn.text = _G.GetLangPackValue(90012500401)
        self.go_table.aortext_title2.text = _G.GetLangPackValue(90049200039)
        local halo_effect = _G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect

        local effectCfg
        local effectCfg1
        --- 只能有1个主动技能1个被动技能
        for i = 1, #halo_effect do
            if _G.ConfigManager.god_halo_effect_cfg
                [_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[i]].effect_type == 2 then
                effectCfg = _G.ConfigManager.god_halo_effect_cfg
                    [_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[i]]
            elseif _G.ConfigManager.god_halo_effect_cfg
                [_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[i]].effect_type == 1 then
                effectCfg1 = _G.ConfigManager.god_halo_effect_cfg
                    [_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[i]]
            end
        end

        --- 神环有主动技能
        if effectCfg then
            -- local effectCfg = _G.ConfigManager.god_halo_effect_cfg
            --     [_G.ConfigManager.god_halo_cfg[self.curData.id].halo_effect[1]]
            self.go_table.aorrawimage_SkillIcon:LoadImage(effectCfg.skill_icon)
            self.go_table.aorrawimage_SkillIcon:SetActiveE(1)
            self.go_table.aortext_name.text = _G.GetLangPackValue(90049200094, _G.GetLangPackValue(self.curData.name))
            self.go_table.aortext_des.text = _G.GetLangPackValue(effectCfg.skill_describe)
            -- self.go_table.aortext_View2.text = _G.GetLangPackValue(effectCfg.name)
            self.go_table.aortext_name:SetActiveE(1)
            self.go_table.obj_des:SetActiveE(1)
            self.go_table.obj_CenterDeep2:SetActiveE(1)
            self.go_table.aorimage_bg2.SpriteName = self.BGIcon[effectCfg.grade]
            self.go_table.aorimage_nameGrade2.SpriteName = self.QuilityIcon[effectCfg.grade]
        else
            self.go_table.aortext_noSkill:SetActiveE(1)
            self.go_table.aortext_name:SetActiveE(0)
            self.go_table.obj_des:SetActiveE(0)
            self.go_table.aorbtn_View2:SetActiveE(0)
            self.go_table.obj_CenterDeep2:SetActiveE(0)
        end

        --- 神环有被动技能
        if effectCfg1 then
            self.go_table.aorrawimage_SkillIcon1:LoadImage(effectCfg1.skill_icon)
            self.go_table.aorrawimage_SkillIcon1:SetActiveE(1)
            self.go_table.aortext_name1.text = _G.GetLangPackValue(90049200094, _G.GetLangPackValue(self.curData.name))
            self.go_table.aortext_des1.text = _G.GetLangPackValue(effectCfg1.skill_describe)
            -- self.go_table.aortext_View1.text = _G.GetLangPackValue(effectCfg1.name)
            self.go_table.aortext_name:SetActiveE(1)
            self.go_table.obj_des1:SetActiveE(1)
            self.go_table.obj_CenterDeep1:SetActiveE(1)
            self.go_table.aorimage_bg1.SpriteName = self.BGIcon[effectCfg1.grade]
            self.go_table.aorimage_nameGrade1.SpriteName = self.QuilityIcon[effectCfg1.grade]
        else
            self.go_table.obj_CenterDeep1:SetActiveE(0)
        end
    end

    -- 如果装备了卡牌 展示形象
    local cardID = self.curCardID
    self.go_table.aorimage_addCard:SetActiveE(1)
    local isNew = self:GetIsNew(self.curData.id)
    self.go_table.obj_redpointSkill2:SetActiveE(isNew and 1 or 0)

    if self.curCardID > 1 then
        self.go_table.aorimage_CardIcon:SetActiveE(1)
        self.go_table.aorimage_addCard:SetActiveE(0)

        local temp = self.go_table.trans_role
        local tempCount = temp:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp:GetChildE(0), _G.ePoolType.Temporary)
        end

        local cfg = require "CardCommentManager":GetInstance():CardData(cardID, false)
        self:LoadRoleModel(_G.UIUtils.GetBattleSpine(cfg), i, cfg.size4, cfg)

        local cardCfg = _G.ConfigManager.card_cfg[cardID]
        self.go_table.aorimage_CardIcon.SpriteName = cardCfg.Icon


        self.go_table.trans_role:SetActiveE(1)
        self.go_table.aorrawimage_norole:SetActiveE(0)
    else
        self.go_table.aorimage_CardIcon:SetActiveE(0)
        self.go_table.aorrawimage_norole:SetActiveE(1)
        self.go_table.trans_role:SetActiveE(0)
        if self.go_table.aorrawimage_norole:GetChildCountE() > 0 then
            _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
        end
        local effCfg = self.curData.ui_effect_cfg
        --- 神环路径，父级路径(加载角色的下面)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[effCfg], self.go_table.aorrawimage_norole.gameObject)
    end
end

function GodHaloShowView:GetIsNew(id)
    local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
    for i = 1, #newList do
        if newList[i] == id then
            return true
        end
    end
    return false
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function GodHaloShowView:LoadRoleModel(rolepath, posIndex, scale, cfg)
    ---@type RecordRankListView._obj_info1_GoTable
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.go_table.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            self.roleTrans = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            --- 只有星座女神有神环
            if _G.AppSetting.IsXzns then
                local effCfg = self.curData.ui_effect_cfg
                local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(cfg.id)
                --- 神环路径，父级路径(加载角色的下面)
                _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                _G.UIUtils.LoadArtifacteffect(trans,cfg.id,nil,nil)
            end
        end
    )
end

---选择卡牌后回调
---@param card ItemCardBodySelectView
function GodHaloShowView:SelectCallBack(card, indexDic)
    local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curData.id)
    local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)

    --- 当前神环装备卡牌ID
    local cardCurID = _G.PlayerModel:GetInstance():IsGodHaloWear(self.curData.id)

    if isUnlock then
        --- 神环已装备的卡牌ID等于选择的卡牌 传0 卸下神环 否则传选择的卡牌ID
        local cardSid = cardCurID == card.sid and 0 or card.sid

        _G.SystemSettingManager:GetInstance():PutGodHalo(
            { halo_id = self.curData.id, card_sid = cardSid, halo_id_skill = WearSkillID },
            function(msg)
                if msg.ack == 1 then
                    --- 如果神环已装备的卡牌ID等于选择的卡牌 卸下卡牌 当前神环的卡牌ID要为1
                    self.curCardID = cardCurID == card.sid and 1 or card.sid
                    _G.PlayerModel:GetInstance():SetUnlockGodHalo(cardSid, self.curData.id, WearSkillID)
                    _G.PlayerModel:GetInstance():SetUnGodHaloList(self.curData.id, WearSkillID)
                    self:InitView()

                    if cardSid == _G.PlayerModel:GetInstance().city_style then
                        _G.PlayerModel:GetInstance():SetGodHaloToRole(self.curData.id)
                    end
                end
            end)
    else
        --- 没解锁的时候选了哪张卡当前就是哪张卡
        self.curCardID = card.sid
        self:InitView()
    end
end

---按钮点击事件在这里派发
function GodHaloShowView:OnClickBtn(go, isOn)
    local UIManager = _G.UIManager:GetInstance()
    local name = go:GetName()
    if go == self.go_table.aorbtn_CloseView then
        if self.buyback then
            self.buyback(self.shopData)
            self:Close()
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_Click then
        if self.buyback then
            self.buyback()
            self:Close()    
        else
            self:Close()
        end

        -- local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)

        -- if not isUnlock then
        --     -- _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
        --     self:Close()
        -- else
        --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name, self.curData,
        --         function()
        --             self:InitView()
        --         end)
        -- end
    elseif go == self.go_table.aorbtn_buy then
        if self.shopBack then
            self.shopBack(self.shopData)
            self:Close()
        end
    elseif go == self.go_table.aorbtn_View2 then
        local isUnlock = _G.PlayerModel:GetInstance():IsUnlockGodHalo(self.curData.id)
        if isUnlock then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name, self.curData,
                function()
                    self:InitView()
                end)
        end
    elseif go == self.go_table.aorbtn_showCard then
        local cardID = self.curCardID
        --- 点击完不管怎么样，都先把红点刷掉
        local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
        for i = #newList, 1, -1 do
            if newList[i] == self.curData.id then
                table.remove(newList, i)
            end
        end
        self:InitView()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardMaCheView_selectHero.Name, 0,
            _G.handler(self, self.SelectCallBack), cardID)
    end
end

return GodHaloShowView
