---@class GodHaloWearView : UIBaseView    中文描述
---@field public go_table GodHaloWearView_GoTable GoTable
local GodHaloWearView = _G.BaseClass("GodHaloWearView", _G.UIBaseView)

function GodHaloWearView:Awake()
    self.Quility = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_dikuang_cheng",
        [_G.SpoilsQuilty.hong] = "ui_jn_dikuang_hong",
        [_G.SpoilsQuilty.cai] = "ui_jn_dikuang_cai"
    }

    self.QuilityIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_jn_icon_shishi",
        [_G.SpoilsQuilty.hong] = "ui_jn_icon_chuanshuo",
        [_G.SpoilsQuilty.cai] = "ui_jn_icon_shenghua"
    }

    self.QuilityBGIcon = {
        [_G.SpoilsQuilty.cheng] = "ui_sh_icon_jineng",
        [_G.SpoilsQuilty.hong] = "ui_sh_icon_hong",
        [_G.SpoilsQuilty.cai] = "ui_sh_icon_cai"
    }


    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GodHaloWearView:OnCreate(data, callback)
    self.callback = callback
    local godHaloID = _G.PlayerModel:GetInstance():IsCardWearGodHalo(data.sid)
    --- 当前卡牌data
    self.curData = data
    --- 当前卡牌的神环ID
    self.curHaloID = godHaloID
    self.cfg = _G.ConfigManager.god_halo_cfg
    self:InitView()
end

---初始化页面
function GodHaloWearView:InitView()
    self:InitMid()
    self:UpdateAll()
end

function GodHaloWearView:InitMid()
    if self.curHaloID == 0 then
        self.go_table.aorrawimage_norole:SetActiveE(0)
        self.go_table.aorimage_MidBG:SetActiveE(0)
    else
        self.go_table.aorrawimage_norole:SetActiveE(1)
        self:LoadGodHalo()
        local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curHaloID)
        if WearSkillID > 1 then
            self.go_table.aorimage_MidBG:SetActiveE(1)
            self.go_table.aortext_Tips:SetActiveE(0)
            self:LoadGodHaloSkill()
        else
            self.go_table.aortext_Tips:SetActiveE(1)
            self.go_table.aorimage_MidBG:SetActiveE(0)
        end
    end
end

function GodHaloWearView:LoadGodHaloSkill()
    local WearSkillID = _G.PlayerModel:GetInstance():IsGodHaloHaveSkill(self.curHaloID)
    local effectCfg =
        _G.ConfigManager.god_halo_effect_cfg[WearSkillID]

    self.go_table.aorimage_BG2:SetActiveE(1)
    self.go_table.aorrawimage_skillIcon2:LoadImage(effectCfg.skill_icon)
    self.go_table.aortext_skillName2.text = _G.GetLangPackValue(effectCfg.skill_name)
    self.go_table.aorimage_MidBG:SetActiveE(1)
    self.go_table.aorimage_nameGrade2.SpriteName = self.QuilityIcon[effectCfg.grade]
    self.go_table.aorimage_BG2.SpriteName = self.QuilityBGIcon[effectCfg.grade]
    self.go_table.aortext_skillDesc.text = _G.GetLangPackValue(effectCfg.skill_describe)
end

function GodHaloWearView:LoadGodHalo()
    if self.go_table.aorrawimage_norole:GetChildCountE() > 0 then
        for i = 1, self.go_table.aorrawimage_norole:GetChildCountE() do
            _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
        end
    end
    local effCfg = self.cfg[self.curHaloID].ui_effect_cfg
    --- 神环路径，父级路径(加载角色的下面)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[effCfg],
        self.go_table.aorrawimage_norole.gameObject,
        function()
            --- 跳转时重复加载处理
            if self.go_table.aorrawimage_norole:GetChildCountE() > 1 then
                _G.DestroyObject(self.go_table.aorrawimage_norole:GetChildE(0))
            end
        end
    )
end

function GodHaloWearView:UpdateAll()
    self.HaloDatas = _G.PlayerModel:GetInstance():GetAllUnlockGodHalo()
    if #self.HaloDatas == 0 then
        return
    end

    _G.table.sort(
        self.HaloDatas,
        function(a, b)
            local orderA = 1
            local orderB = 1

            local cfgA = self.cfg[a.k]
            local cfgB = self.cfg[b.k]

            if a.k == self.curHaloID then
                orderA = 9999999
            elseif b.k == self.curHaloID then
                orderB = 9999999
            end
            orderA = orderA + cfgA.id + cfgA.grade * 1000
            orderB = orderB + cfgB.id + cfgB.grade * 1000

            return orderA > orderB
        end
    )

    ---判断是不是初始化了
    if not self.Init then
        self.go_table.scrollloopvectical_all:InitItemData(#self.HaloDatas, _G.handler(self, self.RefreshList))
        self.Init = true
    else
        self.go_table.scrollloopvectical_all:UpdateCount(#self.HaloDatas)
    end
    self.go_table.scrollloopvectical_all:ScrollToTop()
end

function GodHaloWearView:RefreshList(index, obj)
    index = index + 1
    obj:SetName("$_obj_Item_" .. index)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local skillID = self.HaloDatas[index].v
    if skillID > 1 then
        local effectCfg = _G.ConfigManager.god_halo_effect_cfg[skillID]
        -- tb.aortext_des.text = _G.GetLangPackValue(effectCfg.skill_describe)
        tb.aorrawimage_SkillIcon:LoadImage(effectCfg.skill_icon)
        tb.aorimage_IconBG.SpriteName = self.Quility[effectCfg.grade]
        tb.obj_LeftContent:SetActiveE(1)
        tb.aorimage_Kong:SetActiveE(0)
    else
        tb.obj_LeftContent:SetActiveE(0)
        tb.aorimage_Kong:SetActiveE(1)
    end
    tb.obj_redpoint:SetActiveE(0)


    local godHaloID = self.HaloDatas[index].k

    if godHaloID == self.curHaloID and skillID <= 1 then
        tb.obj_redpoint:SetActiveE(1)
    end
    local Cfg = self.cfg[godHaloID]
    tb.aortext_name.text = _G.GetLangPackValue(Cfg.name)
    local WearID = _G.PlayerModel:GetInstance():IsGodHaloWear(godHaloID)
    tb.aorrawimage_icon:LoadImage(Cfg.icon)
    tb.aorimage_bgGodHalo.SpriteName = _G.EquipItemIconName[Cfg.grade]

    local cardCfg = _G.ConfigManager.card_cfg[WearID]
    if cardCfg then
        tb.aorimage_iconHero.SpriteName = cardCfg.Icon
        tb.aorimage_ColorBg:SetActiveE(1)
    else
        tb.aorimage_ColorBg:SetActiveE(0)
    end


    if WearID == self.curData.sid then
        tb.aorbtn_Wear:SetActiveE(0)
    else
        tb.aorbtn_Wear:SetActiveE(1)
    end
end

function GodHaloWearView:OnClickItem(go, _, index)
    local name = go:GetName()
    if name == "@_aorbtn_get" then
        local godHaloID = self.HaloDatas[index].k
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.GodHaloSkillShowView.Name,
            self.cfg[godHaloID],
            function()
                self:InitView()
            end,
            2
        )
    elseif name == "@_aorbtn_Wear" then
        local godHaloID = self.HaloDatas[index].k
        local WearSkillID = self.HaloDatas[index].v ~= 0 and self.HaloDatas[index].v or 1

        local cardSid = self.curData.sid
        _G.SystemSettingManager:GetInstance():PutGodHalo(
            { halo_id = godHaloID, card_sid = cardSid, halo_id_skill = WearSkillID },
            function(msg)
                if msg.ack == 1 then
                    --- 如果神环已装备的卡牌ID等于选择的卡牌 卸下卡牌 当前神环的卡牌ID要为1
                    _G.PlayerModel:GetInstance():SetUnlockGodHalo(cardSid, godHaloID, WearSkillID)
                    _G.PlayerModel:GetInstance():SetUnGodHaloList(godHaloID, WearSkillID)
                    local godHaloCurId = _G.PlayerModel:GetInstance():IsGodHaloWear(cardSid, true)
                    local newList = _G.PlayerModel:GetInstance().isNewGodHaloList
                    for i = #newList, 1, -1 do
                        if newList[i] == godHaloID then
                            table.remove(newList, i)
                        end
                    end
                    if godHaloCurId == _G.PlayerModel:GetInstance():GetRoleSid() then
                        _G.PlayerModel:GetInstance():SetGodHaloToRole(cardSid)
                    end
                    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointGodHalo.id)
                    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RedPointRoleGodHalo.id, self.curData.uid)
                    if self.callback then
                        self.callback()
                    end

                    self:Close()
                end
            end
        )
    end
end

---按钮点击事件在这里派发
function GodHaloWearView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if self.callback then
            self.callback()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Click then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.curData.item_id)
    end
end

return GodHaloWearView
