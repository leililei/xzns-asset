---@return HellRoadManager
function HellRoadManager:GetInstance()
    return self.super.GetInstance(self)
end
---获取地狱道头衔
function HellRoadManager:GetHellImage(id)
    if not id then
        if not require "HellRoadModel":GetInstance().hellData then
            return ""
        end
        id = require "HellRoadModel":GetInstance():GetLastHell()
    end
    if Images[id] then
        return "Images/nHellRoad/" .. Images[id]
    end
    return ""
end
---获取地狱道图标
function HellRoadManager:GetHellIcon(id)
    if Icons[id] then
        return "Images/nHellRoad/" .. Icons[id]
    end
    return ""
end
---获取地狱道名字
function HellRoadManager:GetHellFont(id)
    if fontImage[id] then
        return fontImage[id]
    end
    return ""
end

return HellRoadManager
