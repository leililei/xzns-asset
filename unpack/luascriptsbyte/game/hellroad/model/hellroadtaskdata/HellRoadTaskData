require "ActiveTaskBase"
---@class HellRoadTaskData:ActiveTaskBase	中文描述
---@field isComplete boolean 是否完成
---@field taskCfg mission_extra_cfg
---@field privilegeCfg privilege_cfg
---@field isLock boolean 任务是否上锁
local HellRoadTaskData = _G.BaseClass("HellRoadTaskData", _G.ActiveTaskBase)

function HellRoadTaskData:Init()
    self.MarkTaskType = _G.MarkTaskType.Hell
end

---类的析构函数
---解析
---@param task task.i_task 任务id
---@param level number 地狱道等级
function HellRoadTaskData:ParseData(task)
    self.i_task = task
    self.Cfg = _G.ConfigManager.mission_extra_cfg[task.sid]
    if self.taskEnumType == nil then
        self.taskEnumType = self.Cfg.condition[1][1]
        self.taskcontentparams = self.Cfg.condition[1]
    end
    self:CheckLock()
    self:CheckTaskState()
    self:CheckTaskTarget()
    self.id = self.Cfg.id
    self.count = self.Cfg.count
    self.jumpId = self.Cfg.link
    self.matchCount = _G.math.min(#self.Cfg.condition - 1, 1)
end

function HellRoadTaskData:AddListener()
    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.specifiedTime then
            --指定时间段登录 6点起 0- 86400
            local starSecond = self.i_task.taskcontentparams[2]
            local notSecond = _G.TimeUtil.GetSecondsOfDayOf6Hour()
            ---如果已错过时间 86400+明天启始时间-今天已过时间
            local next = 86400 + starSecond - notSecond
            self:AddSpecifiedTime(next)
        elseif self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter then
            --接取任务后几天登录
            local nowSecond = _G.TimeUtil.GetServerUnixTime()
            local starSecond = (self.taskcontentparams[2] - 1) * 86400 + _G.TimeUtil.GetDayBySix(self.getTime)
            local nexttime = starSecond - nowSecond
            self:AddDayAfterTime(nexttime)
        else
            _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
        end
    end
end

function HellRoadTaskData:ResetState()
    if self.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        if self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.specifiedTime then
            --指定时间段登录 6点起 0- 86400
            local starSecond = self.taskcontentparams[2]
            local notSecond = _G.TimeUtil.GetSecondsOfDayOf6Hour()
            ---如果已错过时间 86400+明天启始时间-今天已过时间
            local next = 86400 + starSecond - notSecond
            self:AddSpecifiedTime(next)
        elseif self.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.CumulativeLogin.dayAfter then
            --接取任务后几天登录
            local nowSecond = _G.TimeUtil.GetServerUnixTime()
            local starSecond = (self.taskcontentparams[2] - 1) * 86400 + _G.TimeUtil.GetDayBySix(self.getTime)
            local nexttime = starSecond - nowSecond
            self:AddDayAfterTime(nexttime)
        else
            _G.Events:GetInstance():AddListener(_G.ePlayAactionEvent.PlayAaction, self.OnAactionEnent, self)
        end
    end
end

