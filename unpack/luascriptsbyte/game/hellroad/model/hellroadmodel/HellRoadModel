---更新任务
function HellRoadModel:UpdateTaskData()
    if not self.hellData.task_info then
        return
    end
    for _3, v3 in pairs(self.hellData.task_info) do
        for _, v in pairs(self.TaskDatas[self.hellData.h_id]) do
            if v3.sid == v.id then
                v:ParseData(v3)
                v:AddListener()
            end
        end
    end
end

---更新任务状态
function HellRoadModel:ChangeSingleTaskState(sid, state)
    for _, v in pairs(self.TaskDatas[self.hellData.h_id]) do
        if v.id == sid then
            v.i_task.state = state
            v:CheckTaskState()
            break
        end
    end
end

---更新任务状态
function HellRoadModel:ChangeAllTaskState(state)
    for _, v in pairs(self.TaskDatas[self.hellData.h_id]) do
        v.i_task.state = state
        v:CheckTaskState()
        v:AddListener()
    end
end

