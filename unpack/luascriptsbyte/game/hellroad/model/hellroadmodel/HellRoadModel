---更新任务数据
function HellRoadModel:UpdataTask(task)
    if not self.hellData then
        return
    end
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)
    return true
end

---@return HellRoadTaskData
function HellRoadModel:GetTaskByTaskid(taskid)
    for _, v in pairs(self.TaskDatas[self.curHellCfg.id]) do
        if v.i_task.sid == taskid then
            return v
        end
    end
    return nil
end

---检测任务是否可以领取
function HellRoadModel:CheckTaskCanTake(sid)
    if not self.TaskDatas then
        return false
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(40) then
        return false
    end
    if sid == 0 then
        return self.hellData.daily_award == 0
    end
    if self:CheckIsFinish(sid) then
        return false
    end
    local data = self:GetTaskByTaskid(sid)
    if data then
        return data:CheckIsCanTake()
    else
        return false
    end
end

---获取完成任务数
function HellRoadModel:GetFinishCount()
    if not self.hellData then
        return 0
    end
    if not self.FinishCount then
        self.FinishCount = 0
        for _, v in pairs(self.curHellCfg.mission_privilege) do
            if self:CheckIsFinish(v) then
                self.FinishCount = self.FinishCount + 1
            end
        end
        for _, v in pairs(self.curHellCfg.mission_phase) do
            if self:CheckIsFinish(v) then
                self.FinishCount = self.FinishCount + 1
            end
        end
    end
    return self.FinishCount
end

