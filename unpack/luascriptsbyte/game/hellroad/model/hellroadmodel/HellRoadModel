---获取所有已解锁（可领取）奖励
---@param id number 用于服务器交互的战令id
---@param lv number 战令等级
---@return cycle_battle.i_battle_award[]
function HellRoadModel:GetAllUnlockAwards(id, lv)
    local awardLis = {}
    local content = _G.ConfigManager.store_season_battle_cfg[id].content
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local isBuy = self:GetIsBuy(id)
    ---@type store_season_battlecon_cfg
    local cfg, free, pay
    for _, v in pairs(content) do
        cfg = store_season_battlecon_cfg[v]
        if lv >= cfg.level then
            free = not self:CheckAwardIsGet(id, v, true)
            pay = isBuy and not self:CheckAwardIsGet(id, v, false)
            if free and pay then
                _G.table.insert(awardLis, {sid = v, type = 3})
            elseif free then
                _G.table.insert(awardLis, {sid = v, type = 1})
            elseif pay then
                _G.table.insert(awardLis, {sid = v, type = 2})
            end
        end
    end
    return awardLis
end

---检查奖励是否已领取
---@param id number 用于服务器交互的战令id
---@param awardId number 奖励id
---@param isFree boolean 是否是免费奖励
---@return boolean
function HellRoadModel:CheckAwardIsGet(id, awardId, isFree)
    if isFree then
        return _G.table.ContainsValue(self.bpInfo[id].free_award, awardId)
    else
        return _G.table.ContainsValue(self.bpInfo[id].pay_award, awardId)
    end
end

function HellRoadModel:CheckBPCanTake(id)
    if id then 
        for k1, v1 in ipairs(_G.ConfigManager.store_season_battle_cfg[id].content) do 
            if _G.ConfigManager.store_season_battlecon_cfg[v1].conditions[2] <= self.hellData.h_id then 
                if not self:CheckAwardIsGet(id, v1, true) then 
                    return true
                end
                if self:GetIsBuy(id) and not self:CheckAwardIsGet(id, v1) then 
                    return true 
                end
            end
        end
    else 
        for k, v in ipairs(_G.ConfigManager.discrete_cfg[118002][1]) do 
            for k1, v1 in ipairs(_G.ConfigManager.store_season_battle_cfg[v].content) do 
                if _G.ConfigManager.store_season_battlecon_cfg[v1].conditions[2] <= self.hellData.h_id then 
                    if not self:CheckAwardIsGet(v, v1, true) then 
                        return true
                    end
                    if self:GetIsBuy(v) and not self:CheckAwardIsGet(v, v1) then 
                        return true 
                    end
                end
            end
        end
    end
    return false 
end

---返回本级和下一级战令条目ID,第三个返回值是对应的战令sid（store_season_battle_cfg）
function HellRoadModel:GetNowBPCfgId()
    for k, v in ipairs(_G.ConfigManager.discrete_cfg[118002][1]) do 
        for k1, v1 in ipairs(_G.ConfigManager.store_season_battle_cfg[v].content) do 
            if _G.ConfigManager.store_season_battlecon_cfg[v1].conditions[2] == self.hellData.h_id then 
                if not _G.ConfigManager.store_season_battle_cfg[v].content[k1 + 1] then 
                    local index = _G.ConfigManager.discrete_cfg[118002][1][k + 1]
                    if index then 
                        return v1, _G.ConfigManager.store_season_battle_cfg[index].content[1], index 
                    end
                end
                return v1, _G.ConfigManager.store_season_battle_cfg[v].content[k1 + 1], v
            end
        end
    end
end

---领取奖励
---@param id number 用于服务器交互的战令id
---@param awardLis cycle_battle.i_battle_award[] 奖励列表
function HellRoadModel:GetBPAward(id, awardLis, callback)
    local sidT = {}
    for k, v in ipairs(awardLis) do 
        table.insert(sidT, v.sid)
    end 
    local pbData = {type = awardLis[1].type, sid = id, award_ids = sidT}
    HellRoadNet:GetInstance():GetBPAward(
        pbData,
        function(msg)
            if msg.ack == 1 then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                for _, v in pairs(sidT) do
                    if awardLis[1].type == 1 then
                        _G.table.insert(self.bpInfo[id].free_award, v)
                    elseif awardLis[1].type == 2 then
                        _G.table.insert(self.bpInfo[id].pay_award, v)
                    elseif awardLis[1].type == 3 then
                        _G.table.insert(self.bpInfo[id].free_award, v)
                        _G.table.insert(self.bpInfo[id].pay_award, v)
                    end
                end
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HellBattlePass.id)
                _G.Events:GetInstance():Broadcast(_G.eHellRoad.HellGetAwardEnd)
                if callback then
                    callback()
                end
            end
        end
    )
end

---一键领取奖励
---@param id number 用于服务器交互的战令id
---@param awardLis cycle_battle.i_battle_award[] 奖励列表
function HellRoadModel:GetAllBPAward(id, awardLis, callback)
    local sidT = {}
    for k, v in ipairs(awardLis) do 
        table.insert(sidT, v.sid)
    end 
    local pbData = {type = 3, sid = id}
    HellRoadNet:GetInstance():GetBPAward(
        pbData,
        function(msg)
            if msg.ack == 1 then
                local isBuy = self:GetIsBuy(id)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                for _, v in pairs(awardLis) do
                    _G.table.insert(self.bpInfo[id].free_award, v.sid)
                    if isBuy then
                        _G.table.insert(self.bpInfo[id].pay_award, v.sid)
                    end
                end
                require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HellBattlePass.id)
                _G.Events:GetInstance():Broadcast(_G.eHellRoad.HellGetAwardEnd)
                if callback then
                    callback()
                end
            end
        end
    )
end

