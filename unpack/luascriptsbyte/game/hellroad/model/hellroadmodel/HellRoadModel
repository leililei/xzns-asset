---任务排序
function HellRoadModel:SortData(id)
    if not id then
        id = self.hellData.h_id
    end
    if not self.TaskDatas or not self.TaskDatas[id] then
        return
    end

    local sort = {}
    for i, v in pairs(_G.ConfigManager.hell_title_cfg[id].mission_sort) do
        sort[v] = i
    end
    _G.table.sort(
        self.TaskDatas[id],
        function(a, b)
            if a.i_task.state == b.i_task.state then
                if (a:CheckIsCanTake() and b:CheckIsCanTake()) or (not a:CheckIsCanTake() and not b:CheckIsCanTake()) then
                    if sort[a.id] and sort[b.id] then
                        return sort[a.id] < sort[b.id]
                    end
                    return sort[a.id] ~= nil
                else
                    return a:CheckIsCanTake()
                end
            else
                if a:CheckIsCanTake() or b:CheckIsCanTake() then
                    return a:CheckIsCanTake()
                elseif
                    a.i_task.state == _G.TaskEnum.ETaskState.Claimed or b.i_task.state == _G.TaskEnum.ETaskState.Claimed
                 then
                    return a.i_task.state == _G.TaskEnum.ETaskState.Claimed
                else
                    return a:CheckIsGet()
                end
            end
        end
    )
end

---初始化特权显示
function HellRoadModel:InitPrivilegeShow()
    local tb = {}
    self.showPrivilege = {}
    for _, v in ipairs(_G.ConfigManager.hell_title_cfg) do
        if not tb[v.id] then
            tb[v.id] = {}
            self.showPrivilege[v.id] = {}
        end
        for _2, v2 in pairs(v.privilege_extra) do
            local cfg = _G.ConfigManager.privilege_cfg[v2]
            if cfg then
                tb[v.id][cfg.privilege[1][1]] = require "HellRoadPriviegeShowData".New()
                tb[v.id][cfg.privilege[1][1]]:ParseData(v2)
            end
        end
    end
    for i, v in ipairs(tb) do
        for i2, v2 in ipairs(tb) do
            if i2 == i then
                for _, v3 in pairs(v2) do
                    if not self.showPrivilege[i][v3.type] then
                        self.showPrivilege[i][v3.type] = v3
                        v3:ChangeState(3)
                    else
                        if v3.type == 5 then
                            if self.showPrivilege[i][v3.type].other == v3.other then
                                v3:ChangeState(2)
                            else
                                v3:ChangeState(3)
                            end
                        else
                            v3:ChangeState(2)
                        end
                        self.showPrivilege[i][v3.type] = v3
                    end
                end
            elseif i2 < i then
                for _, v3 in pairs(v2) do
                    self.showPrivilege[i][v3.type] = require "HellRoadPriviegeShowData".New()
                    self.showPrivilege[i][v3.type]:ParseData(v3.id)
                end
            end
        end
    end

    for i, v in ipairs(self.showPrivilege) do
        local tb = _G.table.toArray(v)
        _G.table.sort(
            tb,
            function(a, b)
                if a.state == b.state then
                    return a.id < b.id
                else
                    return a.state > b.state
                end
            end
        )
        self.showPrivilege[i] = tb
    end
end

---获取属性加成
function HellRoadModel:GetAllAttr(id)
    if not id and self.attribute then
        return self.attribute, self.attributeChangeType
    end
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local attribute = attributeManager:GetAttribtueClass()
    local cfg = self.curHellCfg
    if id then
        cfg = _G.ConfigManager.hell_title_cfg[id]
    end
    local changeType = {}
    if self.hellData then
        for _, v in pairs(cfg.attribute) do
            table.insert(changeType, _G.AttrType[v[1]])
            attribute:AddValueByName(
                v[1],
                attributeManager:GetValueWithName(v[1], v[3], _G.tonumber(v[2])),
                nil,
                _G.tonumber(v[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
            )
        end
    end
    return attribute, changeType
end

