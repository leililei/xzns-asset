---检测是否完成所有的任务
---@param id number 地狱道id
function HellRoadModel:CheckIsFinishAll(id)
    local cfg = _G.ConfigManager.hell_title_cfg[id]
    if cfg then
        for _, v in pairs(cfg.mission_privilege) do
            if not self:CheckIsFinish(v) then
                return false
            end
        end
        --mission_phase中的任务也需要处理, mission_phase指到达此军衔阶段后才开始计数
        for _, v in pairs(cfg.mission_phase) do
            if not self:CheckIsFinish(v) then
                return false
            end
        end
        return true
    else
        if _G.AppSetting.DEBUG then
            _G.Log(_G.string.format("hell_title_cfg id error,error id =%s", id))
        end
    end
end

