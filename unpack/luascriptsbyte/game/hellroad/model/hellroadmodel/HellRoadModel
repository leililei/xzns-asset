function HellRoadModel:GetBattlePassAwardByID(id)
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local awardLis = {}
    local bpId
    local content, cfg
    local flag = false
    for _, _id in pairs(_G.ConfigManager.discrete_cfg[118002][1]) do
        content = _G.ConfigManager.store_season_battle_cfg[_id].content
        for _, v in pairs(content) do
            cfg = store_season_battlecon_cfg[v]
            if id == cfg.level then
                bpId = _id
                _G.table.insertto(awardLis, cfg.rewards_normal)
                _G.table.insertto(awardLis, cfg.rewards_pay)
                flag = true
                break
            end
        end
        if flag then
            break
        end
    end
    return awardLis, bpId
end

---第一个有可领取奖励的战令下标，或者当前等级战令
function HellRoadModel:GetBattlePassJumpID()
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local curId = self.hellData.h_id
    local content, cfg, isBuy, free, pay
    for index, _id in ipairs(_G.ConfigManager.discrete_cfg[118002][1]) do
        content = _G.ConfigManager.store_season_battle_cfg[_id].content
        isBuy = self:GetIsBuy(_id)
        for _, v in ipairs(content) do
            cfg = store_season_battlecon_cfg[v]
            if curId <= cfg.level then
                return index
            end
            free = not self:CheckAwardIsGet(_id, v, true)
            if free then
                return index
            elseif isBuy then
                pay = not self:CheckAwardIsGet(_id, v, false)
                if pay then
                    return index
                end
            end
        end
    end
    return 1
end

---当前显示的战令数量
function HellRoadModel:GetBattlePassNum()
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local curId = self.hellData.h_id
    local content, cfg
    for index, _id in ipairs(_G.ConfigManager.discrete_cfg[118002][1]) do
        content = _G.ConfigManager.store_season_battle_cfg[_id].content
        content = content[#content]
        cfg = store_season_battlecon_cfg[content]
        if curId <= cfg.level then
            return index
        end
    end
    return #_G.ConfigManager.discrete_cfg[118002][1]
end

