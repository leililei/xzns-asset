---获取地狱道信息回调
---@param msg hell_title.s2c_hell_title_info
function HellRoadModel:GetInfoCall(msg, callback)
    if msg.ack == 1 then
        if self.hellData then
            self.hellData.daily_award = msg.info.daily_award
            self.hellData.h_id = _G.math.min(self.hellData.h_id, self.MaxHellId)
            if callback then
                callback()
            end
            _G.Events:GetInstance():Broadcast(_G.eHellRoad.RefreshPanel)
        else
            self.hellData = msg.info
            self.hellData.h_id = _G.math.min(self.hellData.h_id, self.MaxHellId)
            self:InitFinshTask()
            self:InitFinishPromotion()
            self:InitCfg()
            self:InitTaskData()
            self:InitAttribute()
            if callback then
                callback()
            end
            ---功能开启是更新地狱道任务
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.HellRoad.id,
                    self:GetNowHellId()
                },
                1,
                false,
                true
            )
        end
        self.bpInfo = self.bpInfo or {}
        for k, v in ipairs(_G.ConfigManager.discrete_cfg[118002][1]) do 
            self.bpInfo[v] = self.bpInfo[v] or {}
            self.bpInfo[v].free_award = self.bpInfo[v].free_award or {}
            self.bpInfo[v].pay_award = self.bpInfo[v].pay_award or {}
        end
        for k, v in ipairs(msg.info.buy_list or {}) do 
            self.bpInfo[v].is_buy = 1
        end 
        for k, v in ipairs(msg.info.free_award or {}) do
            if v.award then
                for k1, v1 in ipairs(v.award) do 
                    table.insert(self.bpInfo[v.sid].free_award, v1)
                end
            end
        end 
        for k, v in ipairs(msg.info.pay_award or {}) do
            if v .award then 
                for k1, v1 in ipairs(v.award) do 
                    table.insert(self.bpInfo[v.sid].pay_award, v1)
                end
            end
        end 
        self:SortData()
    end
    self:ShowMainHell()
    self:ParseData()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.MainNaraka.id)
    _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.Hell)
end

function HellRoadModel:ShowMainHell()
    local isExit, wind = _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    if isExit then
        --wind.View:UpdateHell()
    end
    ---更新人物头衔
    local player = _G.WorldManager:GetInstance():GetCurWorldPlayer()
