function HellRoadModel:CheckCanTaskPromotion(id)
    if id <= 0 or id > self.MaxHellId then
        return false
    end
    if self.hellData.h_id == self.MaxHellId then
        return self:CheckIsFinishAll(self.hellData.h_id) and not self:CheckIsGetPromotion(id)
    else
        return id < self.hellData.h_id and not self:CheckIsGetPromotion(id)
    end
end

