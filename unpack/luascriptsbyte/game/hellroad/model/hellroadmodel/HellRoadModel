function HellRoadModel:InitTaskData()
    local HellRoadTaskData = require "HellRoadTaskData"
    local cfgs = _G.ConfigManager.hell_title_cfg
    local count = #cfgs
    self.TaskDatas = {}
    for i = 1, count do
        self.TaskDatas[i] = {}
        local count2 = #cfgs[i].mission_privilege
        for j = 1, count2 do
            local task = self:GetTaskInfo(cfgs[i].mission_privilege[j])
            if not task then
                task = {
                    sid = cfgs[i].mission_privilege[j],
                    state = self:GetTaskState(cfgs[i].mission_privilege[j]),
                    target = {
                        [1] = 0
                    }
                }
            end
            _G.table.insert(self.TaskDatas[i], HellRoadTaskData.New(task))
        end
        if cfgs[i].id >= self.hellData.h_id then --当前阶段才接取,但是是后台发的，前台只用作显示，就把后续的都初始化了
            count2 = #cfgs[i].mission_phase
            for j = 1, count2 do
                local task = self:GetTaskInfo(cfgs[i].mission_phase[j])
                if not task then
                    task = {
                        sid = cfgs[i].mission_phase[j],
                        state = self:GetTaskState(cfgs[i].mission_phase[j]),
                        target = {
                            [1] = 0
                        }
                    }
                end
                _G.table.insert(self.TaskDatas[i], HellRoadTaskData.New(task))
            end
        end
    end
end

---获取任务状态
function HellRoadModel:GetTaskState(sid)
    local isFinish = self
    if not self.hellData.finish_task then
        return _G.TaskEnum.ETaskState.Invalide
    end
    for k, v in pairs(self.hellData.finish_task) do
        if v == sid then
            return _G.TaskEnum.ETaskState.Submited
        end
    end
    return _G.TaskEnum.ETaskState.Invalide
end

---获取任务信息
function HellRoadModel:GetTaskInfo(sid)
    if not self.hellData.task_info then
        return nil
    end
    for _, v in pairs(self.hellData.task_info) do
        if v.sid == sid then
            return v
        end
    end
    return nil
end

---获取任务进程
function HellRoadModel:GetTaskProgress(id)
    local datas = self.TaskDatas[id]
    local count = #datas
    local CompleteCount = 0
    for i = 1, count do
        if datas[i].i_task.state == _G.TaskEnum.ETaskState.Submited then
            CompleteCount = CompleteCount + 1
        end
    end
    return CompleteCount
end

---获取当前任务名
function HellRoadModel:GetCurTaskName(id)
    local datas = self.TaskDatas[id]
    local count = #datas
    for i = 1, count do
        if datas[i].i_task.state ~= _G.TaskEnum.ETaskState.Submited then
            return _G.GetLangPackValue(datas[i].Cfg.desc)
        end
    end
end

---获取当前显示任务名，可领奖>未完成
---@return string, boolean 任务名，是否已完成
function HellRoadModel:GetCurShowTaskName(id)
    self:SortData()
    local datas = self.TaskDatas[id]
    local count = #datas
    for i = 1, count do
        if datas[i].i_task.state == _G.TaskEnum.ETaskState.Submited then
            return _G.GetLangPackValue(datas[i].Cfg.desc), true
        end
        if datas[i].i_task.state ~= _G.TaskEnum.ETaskState.Submited then
            return _G.GetLangPackValue(datas[i].Cfg.desc), false
        end
    end
    return _G.GetLangPackValue(90023900003), true
end

---完成任务
---@param data HellRoadTaskData
function HellRoadModel:FinishTask(data, callback)
    if self.finishTasks[data.id] then
        return
    end
    self.finishTasks[data.id] = true
    HellRoadNet:GetInstance():FinishTask(
        {sid = data.id, finish_type = 2},
        function(msg)
            if msg.ack ~= 1 then
                self.finishTasks[data.id] = nil
                return
            end
            self.FinishCount = self.FinishCount + 1
            self:ChangeSingleTaskState(data.id, _G.TaskEnum.ETaskState.Submited)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require "CommonTipManager".OpenCommonAwardView(
                msg,
                function()
                    if self.FinishCount ~= 0 then
                        if callback then
                            callback()
                        end
                    end
                end
            )
            if not self:CheckIsFinishAll(self.curHellCfg.id) then
                self:SortData(self.hellData.h_id)
            end
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                {
                    _G.ActiveTaskEnum.ConditionEnum.HellRoad.FinishTask
                },
                self:GetFinishCount(),
                false,
                true
            )
        end
    )
end

---进行升级操作
---@param callback function
function HellRoadModel:Upgrade(callback)
    HellRoadNet:GetInstance():Upgrade(function(msg)
        if not msg or msg.ack ~= 1 then
            if callback then
                callback()
            end
            return
        end
        --重置任务进度
        if self.hellData.h_id ~= self.MaxHellId then
            self.FinishCount = 0
        end
        --重新拉取军衔状态
        HellRoadNet:GetInstance():GetHellInfo(_G.handlerbind(self, self.UpdateHellInfo, function()
            require "RedPointManager":GetInstance():RefreshNode(
                _G.ConfigManager.redpoint_cfg.MainNaraka.id,
                1
            )
            if callback then
                callback()
            end
        end))
    end)
end

