function HellRoadModel:CheckIsPass()
    return self.hellData.h_id >= self.MaxHellId
end

---@param Data table
function HellRoadModel:GetNumber(Data)
    local PrivilegeManager = require "PrivilegeManager":GetInstance()
    if not PrivilegeManager.Privilege then
        return 0
    end
    if PrivilegeManager.Privilege[Data[1]] then
        local count = #Data + 1
        for _, v in pairs(PrivilegeManager.Privilege[Data[1]]) do
            for i = 1, count do
                if i == count then
                    return v[i]
                end
                if i < count and v[i] ~= Data[i] then
                    break
                end
            end
        end
    end
    return 0
end

