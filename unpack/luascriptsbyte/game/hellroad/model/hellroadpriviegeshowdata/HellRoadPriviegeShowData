---@class HellRoadPriviegeShowData	中文描述
---@field state number 3新增特权 1无更改 2有更改
---@field id number 特权id
---@field cfg privilege_cfg
local HellRoadPriviegeShowData = _G.BaseClass("HellRoadPriviegeShowData")
_G.HellRoadPriviegeShowData = HellRoadPriviegeShowData
---解析数据
---@param id number 特权id
function HellRoadPriviegeShowData:ParseData(id)
    self.id = id
    self.cfg = _G.ConfigManager.privilege_cfg[self.id]
    self.type = self.cfg.privilege[1][1]
    if self.cfg.privilege[1][3] then
        self.other = self.cfg.privilege[1][2]
    end
    self.value = self.cfg.privilege[#self.cfg.privilege]
    self.state = 1
end
---更改状态
function HellRoadPriviegeShowData:ChangeState(state)
    self.state = state
end

---类的析构函数
function HellRoadPriviegeShowData:Dispose()
    self.id = nil
    self.cfg = nil
    self.type = nil
    self.value = nil
    self.state = nil
end

return HellRoadPriviegeShowData
