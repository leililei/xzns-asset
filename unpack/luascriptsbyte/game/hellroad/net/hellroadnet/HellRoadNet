local BaseGameNet = require "BaseGameNet"

---@class HellRoadNet : BaseGameNet	通信协议
local HellRoadNet = _G.BaseClass("HellRoadNet", BaseGameNet)
local base = BaseGameNet

---@return HellRoadNet HellRoadNet
function HellRoadNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---获取地狱道信息
---@param pbData table PB数据
---@param callback function 完成回调
function HellRoadNet:GetHellInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_hell_title_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---领取奖励
function HellRoadNet:GetAward(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_hell_title_daily_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---领取战令奖励
function HellRoadNet:GetBPAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_hell_title_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---完成任务
function HellRoadNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_hell_title_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---领取晋升奖励
function HellRoadNet:FinishUpAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_hell_title_up_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---进行升级操作
---@param callback fun(msg:public.s2c_common_ack):void
function HellRoadNet:Upgrade(callback)
    local item = _G.ConfigManager.net_map.game_hell_title_up
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据v
---@param error string 错误信息
function HellRoadNet:CallBack(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type HellRoadNet
return HellRoadNet
