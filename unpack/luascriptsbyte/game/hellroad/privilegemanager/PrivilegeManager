---@return PrivilegeManager PrivilegeManager
function PrivilegeManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function PrivilegeManager:__init()
    self.Privilege = {}
    self.privilegeIDLis = {}
end

---销毁对象时,析构函数
function PrivilegeManager:Dispose()
    self.Privilege = nil
    if self.timerList then
        for _, v in pairs(self.timerList) do
            v:Stop()
        end
        self.timerList = nil
    end
end

---初始化特权
---@param ids table<number> data 所有特权id
function PrivilegeManager:InitPrivilege(ids)
    for _, v in pairs(ids) do
        self:AddPrivilege(v, true, false, true)
    end
end

---获取特权数据 (数值)
---@param Data table {id,params} id 特权类型id params 对应的特权参数
---@return 数值
function PrivilegeManager:GetPrivilegeData(Data)
    if not self.Privilege then
        return {}
    end
    local isHave = true
    local count = #Data
    if self.Privilege[Data[1]] then
        if count == 1 then
            local tb = {}
            if #self.Privilege[Data[1]] > 1 then
                for i, v2 in ipairs(self.Privilege[Data[1]]) do
                    tb[i] = v2
                end
            else
                for i = 1, #self.Privilege[Data[1]][1] do
                    if i > 1 then
                        tb[i - 1] = self.Privilege[Data[1]][1][i]
                    end
                end
            end

            return tb
        end
        for _, v in pairs(self.Privilege[Data[1]]) do
            isHave = true
            for i = 1, count do
                if v[i] ~= Data[i] then
                    isHave = false
                    break
                end
            end
            if isHave then
                local tb = {}
                local count2 = #v
                for j = count + 1, count2 do
                    tb[j - count] = v[j]
                end
                return tb
            end
        end
    end
    return {}
end

---获取特权数据 (数值)
---@param Data table {id,params} id 特权类型id params 对应的特权参数
---@return 数值
function PrivilegeManager:GetPrivilegeDataNew(Data)
    if not self.Privilege then
        return {}
    end
    local table = _G.table
    local tb = {}
    if self.Privilege[Data[1]] then
        if _G.IsNil(Data[2]) then
            ---针对如特权35做特殊处理
            tb = self.Privilege[Data[1]]
        else
            for _, v in pairs(self.Privilege[Data[1]]) do
                if table.sameByCount(Data, v) then
                    table.insert(tb, v)
                end
            end
        end
    end
    return tb
end
---获取特权数据 (数值)
---@param  data number 特权枚举的类型  比如：战斗跳过25
function PrivilegeManager:GetPrivilegeBoolen(data)
    local flag, value = false, 96 --功能id
    local resoult_table = self:GetPrivilegeData({data})
    if _G.table.isEmptyOrNil(resoult_table) then
        flag = false
    else
        flag = true
        value = resoult_table
    end
    return flag, value
end
---添加特权
---@param id number privilege_cfg id
---@param isNotDispath boolean 是否推送事件,true为推送,false未不推送
---@param isOver boolean 是否终值（true 终值， false 累加）
---@param isInit boolean
function PrivilegeManager:AddPrivilege(id, isNotDispath, isOver, isInit)
    if self.privilegeIDLis[id] then
        return
    end
    self.privilegeIDLis[id] = {isOver = isOver}
    local cfg = self:UpdateSinglePrivilege(id, isOver)
    if isNotDispath and cfg then
        self:AddTimer(cfg.privilege[1][1], cfg, isInit)
    end
end

---移除单个特权
---@param id number privilege_cfg id
function PrivilegeManager:RemovePrivilege(id)
    if not self.privilegeIDLis[id] then
        return
    end
    self.privilegeIDLis[id] = nil
    self:UpdateAllPrivilege()
end

---批量移除特权
---@param idLis number[] privilege_cfg id
function PrivilegeManager:MultiRemovePrivilege(idLis)
    local count = 0
    for _, id in pairs(idLis) do
        if self.privilegeIDLis[id] then
            count = count + 1
        end
        self.privilegeIDLis[id] = nil
    end
    if count == 0 then
        return
    end
    self:UpdateAllPrivilege()
end

---刷新所有特权
function PrivilegeManager:UpdateAllPrivilege()
    self.Privilege = {}
    for id, v in pairs(self.privilegeIDLis) do
        self:UpdateSinglePrivilege(id, v.isOver)
    end
end

---更新单个特权数据
---@param id number privilege_cfg id
---@param isOver boolean 是否终值（true 终值， false 累加）
---@return privilege_cfg 避免重复查表
function PrivilegeManager:UpdateSinglePrivilege(id, isOver)
    ---@type privilege_cfg
    local cfg = _G.ConfigManager.privilege_cfg[id]
    if not cfg or _G.table.isEmptyOrNil(cfg.privilege) then
        return
    end
    local privateType = cfg.privilege[1][1]
    if not self.Privilege[privateType] then
        self.Privilege[privateType] = {}
        for i, v in ipairs(cfg.privilege) do
            _G.table.insert(self.Privilege[privateType], _G.DeepCopyCfgTable(v))
        end
    else
        if privateType == 35 then
            self.Privilege[privateType][3][1] = self.Privilege[privateType][3][1] + cfg.privilege[3][1]
        else
            local isAdd = false
            for _, v in pairs(self.Privilege[privateType]) do
                local count2 = #v
                for i = 1, count2 do
                    if i < count2 then
                        if v[i] ~= cfg.privilege[1][i] then
                            break
                        end
                    end
                    if i == count2 then
                        if isOver then
                            if v[i] < cfg.privilege[1][i] then
                                v[i] = cfg.privilege[1][i]
                            end
                        else
                            v[i] = v[i] + cfg.privilege[1][i]
                        end
                        isAdd = true
                        break
                    end
                end
            end
            if not isAdd then
                _G.table.insert(self.Privilege[privateType], _G.DeepCopyCfgTable(cfg.privilege[1]))
            end
        end
    end
    return cfg
end

function PrivilegeManager:AddTimer(privateType, cfg, isInit)
    if not self.timerList then
        self.timerList = {}
    end
    if self.timerList[privateType] then
        return
    end
    if isInit and privateType == _G.PrivilegeType.Arena.Count then
        return
    end
    self.timerList[privateType] =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.RefrePrivilegeEvent,
        self,
        true,
        true,
        true,
        privateType,
        cfg,
        isInit
    )
    self.timerList[privateType]:Start()
end

---刷新特权
function PrivilegeManager:RefrePrivilegeEvent(privateType, cfg, isInit)
    if RefreshOtherModelData[privateType] then
        RefreshOtherModelData[privateType]()
    end
    if RefreshRedFunction[cfg.privilege[1][1]] then
        RefreshRedFunction[cfg.privilege[1][1]]()
    end
    self.timerList[privateType] = nil
    if _G.table.isEmptyOrNil(self.timerList) then
        _G.Events:GetInstance():Broadcast(_G.eHellRoadPrivilegeEvent.HellRoadPrivilege, isInit)
    end
end

