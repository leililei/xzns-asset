local HellRoadModel = require "HellRoadModel"
---@class HellRoadDailyRewardView : UIBaseView	中文描述
---@field public go_table HellRoadDailyRewardView_GoTable GoTable
---@field cfg hell_title_cfg
local HellRoadDailyRewardView = _G.BaseClass("HellRoadDailyRewardView", _G.UIBaseView)
--_G.HellRoadDailyRewardView = HellRoadDailyRewardView

function HellRoadDailyRewardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HellRoadDailyRewardView:OnCreate()
    self.cfg = HellRoadModel:GetInstance().curHellCfg
    self.go_table.aortext_title.text = _G.ConfigManager.language_package_cfg[90022100032]
    self.go_table.aorrawimage_icon:LoadImage("Images/HellRoad/ui_diyudao_icon_" .. self.cfg.id)
    self:ShowReward()
end

function HellRoadDailyRewardView:ShowReward()
    local count = #self.cfg.reward
    for i = 1, count do
        local data = self.cfg.reward[i]
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            self.go_table.trans_Content,
            function(item)
                item:Show(data[1], nil, data[2])
            end
        )
    end
end

---按钮点击事件在这里派发
function HellRoadDailyRewardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Get then
        HellRoadModel:GetInstance():GetDaily(
            function()
                self:Close()
            end
        )
    end
end

return HellRoadDailyRewardView
