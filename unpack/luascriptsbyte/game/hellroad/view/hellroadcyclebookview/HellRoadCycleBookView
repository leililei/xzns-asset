---@class HellRoadCycleBookView : UIBaseView	中文描述
---@field public go_table HellRoadCycleBookView_GoTable GoTable
local HellRoadCycleBookView = _G.BaseClass("HellRoadCycleBookView", _G.UIBaseView)
--_G.HellRoadCycleBookView = HellRoadCycleBookView

function HellRoadCycleBookView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.isOver = false
    _G.DelayDo(2,function()
        self.isOver = true
    end)
end

---界面的入口函数
---@param curHellCfg hell_title_cfg
---@param nexHellCfg hell_title_cfg
function HellRoadCycleBookView:OnCreate(curHellCfg, nexHellCfg)
    self.go_table.aortext_title.text =
        _G.string.format(
        _G.LangUtil.GetLangPackValue(90012200001),
        _G.PlayerModel:GetInstance().role_name,
        _G.LangUtil.GetLangPackValue(nexHellCfg.name)
    )
    self:UpdateShow(self.go_table.obj_left, curHellCfg)
    self:UpdateShow(self.go_table.obj_right, nexHellCfg)
    -- self.go_table.aortext_content.text =
    --     _G.string.format(
    --     _G.LangUtil.GetLangPackValue(_G.ConfigManager.privilege_cfg[nexHellCfg.privilege_extra[1]].desc),
    --     "",
    --     ""
    -- ) .. "<color=#515268>等</color>"
end
---@param cfg hell_title_cfg
function HellRoadCycleBookView:UpdateShow(go, cfg)
    local tb = _G.GetAutoGoTable(go)
    tb.aorrawimage_icon:LoadImage(require "HellRoadManager":GetInstance():GetHellIcon(cfg.id))
    tb.aorimage_font.SpriteName = require "HellRoadManager":GetInstance():GetHellFont(cfg.id)
    local count = #cfg.reward
    for i = 1, count do
        local data = cfg.reward[i]
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.ItemBaseWithCount,
            tb.trans_Content,
            function(item)
                item:Show(data[1], nil, data[2])
            end
        )
    end
end

---按钮点击事件在这里派发
function HellRoadCycleBookView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close and self.isOver then
        self:Close()
    elseif go == self.go_table.aorbtn_CloseView and self.isOver then
        self:Close()
    end
end

return HellRoadCycleBookView
