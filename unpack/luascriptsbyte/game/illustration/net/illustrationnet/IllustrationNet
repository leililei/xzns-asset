---@class IllustrationNet : BaseGameNet 通信协议
local IllustrationNet = _G.BaseClass("IllustrationNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return IllustrationNet IllustrationNet
function IllustrationNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--获取图鉴信息
---@param callback function 回调方法
function IllustrationNet:AccessToMap(callback)
    local item = _G.ConfigManager.net_map.game_illustrations_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

