---获取图鉴数据
function IllustrationModel:GetIllustrationData(callback)
    ---抽卡获取的新卡记录
    self.NewChoKa = {}

    ---@class TaskState 图鉴卡牌信息
    ---@field display_priority number 图鉴排序（数字越小，排在越靠前）
    ---@field  note string 名称备注
    ---@field taskState TaskState  解锁状态
    ---@field award number 是否收藏或者领取奖励
    ---@field star number 魂将星级
    ---@field group number id
    ---@field image number 图片位置
    self.IllustrationData = {}

    ---@class TaskState 魂将卡牌信息集合
    ---@field group number id
    ---@field groupPinJie number  图鉴分组（0-不显示；1-R卡；2-SR卡；3-SSR卡）
    ---@field conditon number 解锁条件
    ---@field Elements number 五行
    ---@field level number 卡牌等级
    ---@field exclusive number 卡牌专武等级
    ---@field taskState IllustrationData  详细信息
    self.IllustrationHunJiangList = {}
    ---@class TaskState 图鉴卡牌信息集合
    ---@field group number id
    ---@field taskState IllustrationData  详细信息
    self.IllustrationTuJianList = {}
    ---宝箱可领取数
    self.KeLingQuShu = 0
    ---新插画数
    self.ChaHuaNew = {}
    self.keys = {}
    self.ShowIllustrationImage = {}
    ---需要显示的插画ID
    self.ChaHuaXianShi = {}
    ---所有卡牌历史最大星级
    self.Maxstars = 0

    IllustrationNet:GetInstance():AccessToMap(_G.handlerbind(self, self.GetIllustrationDataCallback, callback))
end

