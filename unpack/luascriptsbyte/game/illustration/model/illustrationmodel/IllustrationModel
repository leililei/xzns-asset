function IllustrationModel:ChangeMaxStar(id, star)
    local bol 
    if star > self.Maxstars then
        self.Maxstars = star
        require "DrawModel":GetInstance().GengHuan = true
        bol = true
    end
    if not self.stars[id] then
        --self:shuXingPingZHi(id)
        
        self.stars[id] = star
        if _G.ConfigManager.card_hall_cfg[id] then 
            require "CardHallModel":GetInstance():GetTaskByCardSid(id)
        end
        bol = true
    else
        if star > self.stars[id] then
            self.stars[id] = star
        -- self:shuXingPingZHi(id)
            bol = true
            
        end
    end
    if bol then 
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.CardUpStar.assignSidAssignStar,
                --- 指定SID卡牌升到N级（检测当前背包）
                id
            },
            star
        )
        if _G.ConfigManager.card_hall_cfg[id] then 
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardHallView.Name)
            if ctrl then 
                ctrl:UpdateView()
            end 
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.CardHallTask.id, id)
        end
    end
