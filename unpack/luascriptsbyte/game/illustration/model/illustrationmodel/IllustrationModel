---获取卡牌图鉴页面的第一个奖励索引
function IllustrationModel:GetCardIllFisrtAwardIndex()
    local list = _G.DeepCopy(self.IllustrationHunJiangList)
    list = _G.table.values(list)
    _G.SortList(list,
    function(a)
        return -a.taskState.display_priority
    end)
    local index = 0
    for k, v in pairs(list) do
        index = index + 1
        if v.taskState.award then
            return index
        end
    end
    return 0
end

