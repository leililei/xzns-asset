---获取图鉴数据回调
---@param msg illustrations.s2c_illustrations_info
function IllustrationModel:GetIllustrationDataCallback(msg, callback)
    self.Data = msg
    self:ParseData(msg)
    ---@type illustrations.c2s_unlock
    self.data = {}
    self.datas = {}
    self.datas.sids = {}
    self.data.sids = {}
    ---卡牌最大星级
    self.stars = {}
    ---当前卡牌领取情况
    self.b_info = {}
    _G.Events:GetInstance():AddListener(_G.eIllustrationsToUnlockEvent.Unlock, self.OnIllustrationEnent, self)
    for _, value in pairs(_G.ConfigManager.illustrations_card_cfg) do
        local condition = value.condition_type
        if condition == nil or #condition == 0 or _G.GlobalConditionManager.CheckConditionByArray(condition) then
            self.IllustrationHunJiangList[value.id] = {}
            self.IllustrationHunJiangList[value.id].id = value.id
            self.IllustrationHunJiangList[value.id].taskState = {}
            self.IllustrationHunJiangList[value.id].group = IllustrationModel.InformationType.Hunjiang
            self.IllustrationHunJiangList[value.id].taskState.display_priority = value.display_priority
            self.IllustrationHunJiangList[value.id].taskState.taskState = false
            self.IllustrationHunJiangList[value.id].taskState.award = false
            self.IllustrationHunJiangList[value.id].taskState.star = value.star
            self.IllustrationHunJiangList[value.id].taskState.group = value.id
            self.IllustrationHunJiangList[value.id].taskState.groupPinJie = value.group
    
            self.IllustrationHunJiangList[value.id].Elements = _G.ConfigManager.card_cfg[value.id].Elements
            self.IllustrationHunJiangList[value.id].level = value.level
            self.IllustrationHunJiangList[value.id].exclusive = value.exclusive
            self.IllustrationHunJiangList[value.id].potential = value.potential
        end
    end
    if _G.ConfigManager.illustrations_image_cfg ~= nil then
        -- body

        for _, value in pairs(_G.ConfigManager.illustrations_image_cfg) do
            self.IllustrationTuJianList[value.id] = {}
            self.IllustrationTuJianList[value.id].taskState = {}
            self.IllustrationTuJianList[value.id].group = IllustrationModel.InformationType.ChaHua
            self.IllustrationTuJianList[value.id].taskState.display_priority = value.display_priority
            self.IllustrationTuJianList[value.id].taskState.note = value.name
            self.IllustrationTuJianList[value.id].taskState.taskState = false
            self.IllustrationTuJianList[value.id].taskState.award = IllustrationModel.Information.TypeNo

            self.IllustrationTuJianList[value.id].taskState.group = value.id
            self.IllustrationTuJianList[value.id].taskState.image = value.image
            self.IllustrationTuJianList[value.id].conditon = value.conditon[1][2]
        end
    end
    if self.Data.cards then
        for _, v in pairs(self.Data.cards) do
            self.stars[v.k] = v.v
            if v.v > self.Maxstars then
                self.Maxstars = v.v
            end
        end
    end
    if self.Data.b_info then
        for _, v in pairs(self.Data.b_info) do
            self.b_info[v.c_id] = v.a_list
        end
    end
    if self.Data.spiritual then
        require("SpiritualIllustrationModel"):GetInstance():ParseData(self.Data.spiritual)
    end
    if self.Data.decoration then
        require("RuneIllustrationModel"):GetInstance():ParseData(self.Data.decoration)
    end
    self:HunjiangBool()
    self:HunjiangAwardsBool()

    self:ChaHuaBool()
    if callback ~= nil then
        callback()
    end
end
---判断是否符合插画开启条件
function IllustrationModel:OnIllustrationEnent(id)
    --策划需求屏蔽插画功能 单号ZHJ-18691
    if true then
        return
    end
    self.data.sids = {}
    for key, value in pairs(self.IllustrationTuJianList) do
        if value.conditon == id[1] and not (value.taskState.taskState) then
            self.ChaHuaXianShi[value.taskState.display_priority] = value.taskState.group
        end
    end
    if _G.table.count(self.ChaHuaXianShi) > 0 then
        self.keys = _G.table.keys(self.ChaHuaXianShi)
        _G.table.sort(
            self.keys,
            function(a, b)
                return a < b
            end
        )
        self:HuanXing()
    end
end
---判断是否已经开启插画
function IllustrationModel:HuanXing()
    for key, value in pairs(self.keys) do
        if not (self.IllustrationTuJianList[self.ChaHuaXianShi[value]].taskState.taskState) then
            self.IllustrationTuJianList[self.ChaHuaXianShi[value]].taskState.taskState = true

            _G.table.insert(self.data.sids, self.IllustrationTuJianList[self.ChaHuaXianShi[value]].taskState.group)
            _G.table.insert(self.datas.sids, self.IllustrationTuJianList[self.ChaHuaXianShi[value]].taskState.group)
            if self.ChaHuaNew[self.ChaHuaXianShi[value]] == nil then
                self.ChaHuaNew[self.ChaHuaXianShi[value]] = self.ChaHuaXianShi[value]
            end
        end
    end
    if _G.table.count(self.datas.sids) > 0 then
        self.datas.sids = {}
        IllustrationNet:GetInstance():IllustrationsUnlock(self.data, _G.handler(self, self.MapIllustration))
    -- require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.ExistingPicture.id)
    end
end
--显示插画
function IllustrationModel:MapIllustration()
    local MainOpenViewFunItem = {}

    MainOpenViewFunItem.checkFun = function()
        local CurrentWorld = _G.WorldManager:GetInstance():GetCurWorld()
        return CurrentWorld.Cfg.Scene_Type == _G.SceneType.MainWorld
    end
    MainOpenViewFunItem.DelFun = function()
        return _G.table.count(self.keys) <= 0
    end
    MainOpenViewFunItem.OpenViewFun = function()
        require("IllustrationModel"):GetInstance():OpenWindow()
    end
    _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.Illustration)
end

function IllustrationModel:OpenWindow()
    if _G.table.count(self.keys) <= 0 then
        return
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MapIllustrationView.Name)
end

---判断魂将是否解锁
function IllustrationModel:HunjiangBool()
    if self.Data.cards == nil then
        return
    end
    for _, value in pairs(self.Data.cards) do
        if self.IllustrationHunJiangList[value.k] ~= nil then
            self.IllustrationHunJiangList[value.k].taskState.taskState = true
        end
    end
end
---根据传输过来的ID修改
function IllustrationModel:JieSuoHunJiang(data)
    if data == nil or self.IllustrationHunJiangList[data] == nil then
        return false
    end
    if self.IllustrationHunJiangList[data] ~= nil and self.IllustrationHunJiangList[data].taskState.taskState == true then
        return false
    end
    self.NewChoKa[data] = true
    self.IllustrationHunJiangList[data].taskState.taskState = true
    self.IllustrationHunJiangList[data].taskState.award = true
    if not self.stars[data] then
        self.stars[data] = _G.ConfigManager.card_cfg[data].Star
    end

    self.KeLingQuShu = self.KeLingQuShu + 1
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.OneClickCollection.id)
    require("ArtifactDemoModel"):GetInstance():UpdateAllArtifact()
    _G.Events:GetInstance():Broadcast(_G.eIllustrationUnlcok.CardIllustrationUnlcok)
    return true
end

---根据传输过来的ID修改
---@param data number 卡牌sid
function IllustrationModel:JieSuoHunJiangNew(data)
    if self:HunjiangJieSuo(data) then
        return true
    else
        local cfg = _G.ConfigManager.card_cfg[data]
        if cfg.Order > 2 then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
                _G.ConfigManager.card_cfg[data],
                nil,
                _G.ConfigManager.card_cfg[data].Star,
                false,
                true
            )
            _G.table.insert(self.Zidata, cfg)
        end
    end
    return self:JieSuoHunJiang(data)
end

---判断魂将是否解锁
function IllustrationModel:HunjiangJieSuo(id)
    if self.IllustrationHunJiangList[id] ~= nil and self.IllustrationHunJiangList[id].taskState.taskState == true then
        return true
    end

    return false
end

---判断魂将是否领取奖励
function IllustrationModel:HunjiangAwardsBool()
    if self.Data.card_awards == nil then
        return
    end
    for _, value in pairs(self.Data.card_awards) do
        if self.IllustrationHunJiangList[value] ~= nil then
            self.IllustrationHunJiangList[value].taskState.award = true
            self.KeLingQuShu = self.KeLingQuShu + 1
        end
    end
end
---新魂将魂将是否领取奖励
function IllustrationModel:HunjiangNew(data)
    if data.cards == nil then
        return
    end
    for key, value in pairs(data.cards) do
        if self.IllustrationHunJiangList[value] ~= nil then
            self.IllustrationHunJiangList[value].taskState.taskState = true
            self.IllustrationHunJiangList[value].taskState.award = true
            self.KeLingQuShu = self.KeLingQuShu + 1
        end
    end
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.OneClickCollection.id)
end
---判断插画是否解锁
function IllustrationModel:ChaHuaBool()
    if self.Data.images == nil then
        return
    end

    for _, value in pairs(self.Data.images) do
        if self.IllustrationTuJianList[value.id] ~= nil then
            self.IllustrationTuJianList[value.id].taskState.taskState = true
            self.IllustrationTuJianList[value.id].taskState.award = value.type
            if
                value.type == IllustrationModel.Information.TypeYes and
                    false == _G.table.ContainsValue(self.ShowIllustrationImage, value.id)
             then
                _G.table.insert(self.ShowIllustrationImage, value.id)
            end
            if value.type == 2 then
                if self.ChaHuaNew[value.id] == nil then
                    self.ChaHuaNew[value.id] = value.id
                end
            end
        end
    end
end
