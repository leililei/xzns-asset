--根据传输ID判断领取奖励
function IllustrationModel:CardPanDuan(id)
    local stars = self:GetCardMaxStar(id)
    local Data = _G.ConfigManager.card_cfg[id]
    local i = 0
    for _, value in pairs(_G.ConfigManager.card_biography_cfg) do
        if value.order == Data.Order and stars >= value.star then
            i = i + 1
        end
    end

    local b_info = self.b_info[id]
    if b_info == nil then
        b_info = {}
    end
    if i > _G.table.count(b_info) then
        return true
    end
    return false
end

