---获取卡牌最大星级达到star的数量
---@param star number 星级
---@return number 数量
function IllustrationModel:GetCardMaxStarCount(star)
    local count = 0
    if self.stars ~= nil then
        for k, v in pairs(self.stars) do
            if v >= star then
                count = count + 1
            end
        end
    end
    return count
end

---获取最高N个星级的平均值（取整）
function IllustrationModel:GetTopNStarAverage(n)
    local stars = _G.table.ValuesToTable(self.stars)
    _G.table.sort(
        stars,
        function(a, b)
            return a > b
        end
    )
    local count = _G.Mathf.Min(n, #stars)
    if count == 0 then
        return 0
    end
    local sum = 0
    for i = 1, count do
        sum = sum + stars[i]
    end
    return _G.Mathf.RoundToInt(sum / count)
end

