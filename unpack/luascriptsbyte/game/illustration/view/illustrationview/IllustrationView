---获取品质框类型
function IllustrationView:SetColorBox(star)
    local colorType
    if star >= 11 then
        colorType = 6
    elseif star >= 6 then
        colorType = 5
    elseif star >= 5 then
        colorType = 4
    elseif star >= 4 then
        colorType = 3
    elseif star >= 3 then
        colorType = 2
    else
        colorType = 1
    end
    return colorType
end

