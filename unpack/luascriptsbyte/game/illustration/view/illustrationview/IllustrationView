---按钮点击事件在这里派发
function IllustrationView:OnClickBtn(go, _)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_chahua" then
        --插画关闭按钮
        -- elseif name == "@_aorbtn_fenxiang" then -- 待添加
        _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_ChaHua, false)
    elseif name == "@_aorbtn_shoucang" then
        --收藏操作
        self:Shoucang()
    elseif name == "@_aorbtn_zuo" then
        --左键点击
        self:ZuoJianBtn()
    elseif name == "@_aorbtn_you" then
        --右键点击
        self:YouJianBtn()
    elseif name == "@_aorbtn_yijian" then
        --宝箱一键领取按钮点击
        require("IllustrationModel"):GetInstance():YiJianLingQu(_G.handler(self, self.YiJianLingQuNew))
    else
        --筛选类型
        for i = 0, 6, 1 do
            local typeNode = self.go_table["aorbtn_type" .. i]
            if go == typeNode then
                if self.Elements ~= i then
                    self.Elements = i
                    self.IllustrationMaxNum.HunJiang = 1
                    self:HunJiangWuXing()
                    self:ScrollToNextBaoXiang()
                end
                self.go_table.obj_typeOn:SetParentE(typeNode)
                self.go_table.obj_typeOn:SetLocalPositionToZero()
                break
            end
        end
    end
end

return IllustrationView
