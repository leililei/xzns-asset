---魂将五行分类
function IllustrationView:HunJiangWuXing()
    self.CurrentBaoXiangList = {}
    self.BaoXiangEffectInit = {}
    self.DQIllustrationDataortHunJiang = {}
    local xianshiNum = 0
    local i = 1

    if _G.GlobalConditionManager.CheckConditionArrays(_G.ConfigManager.discrete_cfg[106706]) then
        self.go_table.aorbtn_type6:SetActiveE(1)
    else
        self.go_table.aorbtn_type6:SetActiveE(0)
    end

    for v = 1, _G.table.count(self.IllustrationDataortHunJiang) do
        if self.IllustrationDataortHunJiang[v] ~= nil then
            if 0 == self.Elements or self.IllustrationDataortHunJiang[v].Elements == self.Elements then
                _G.table.insert(self.DQIllustrationDataortHunJiang, self.IllustrationDataortHunJiang[v])
                i = i + 1
                if self.IllustrationDataortHunJiang[v].taskState.taskState then
                    xianshiNum = xianshiNum + 1
                end
            end
        end
    end
    local total = _G.table.count(self.DQIllustrationDataortHunJiang)

    if total % self.IllustrationMax.HunJiang > 0 then
        self.IllustrationMaxNum.HunJiangMax = total / self.IllustrationMax.HunJiang + 1
    else
        self.IllustrationMaxNum.HunJiangMax = total / self.IllustrationMax.HunJiang
    end
    self.IllustrationNum.HunJiang = total

    local shujuSSR = {}
    local shujuSR = {}
    local shujuR = {}

    for key, value in pairs(self.DQIllustrationDataortHunJiang) do
        if 1 == value.taskState.groupPinJie then
            _G.table.insert(shujuR, value)
        elseif 2 == value.taskState.groupPinJie then
            _G.table.insert(shujuSR, value)
        elseif 3 == value.taskState.groupPinJie then
            _G.table.insert(shujuSSR, value)
        end
    end

    local dq = {}

    local shu = CARD_ROW_COUNT
    for key, value in pairs(shujuSSR) do
        _G.table.insert(dq, value)
        shu = shu - 1
        if shu == 0 then
            shu = CARD_ROW_COUNT
        end
        if value.taskState.award then
            _G.table.insert(self.CurrentBaoXiangList, #dq)
        end
    end
    if _G.math.fmod(_G.table.count(shujuSSR), CARD_ROW_COUNT) > 0 then
        -- body
        for i = 1, shu do
            _G.table.insert(dq, 0)
        end
    end
    shu = CARD_ROW_COUNT
    for key, value in pairs(shujuSR) do
        _G.table.insert(dq, value)
        shu = shu - 1
        if shu == 0 then
            shu = CARD_ROW_COUNT
        end
        if value.taskState.award then
            _G.table.insert(self.CurrentBaoXiangList, #dq)
        end
    end
    if _G.math.fmod(_G.table.count(shujuSR), CARD_ROW_COUNT) > 0 then
        -- body
        for i = 1, shu do
            _G.table.insert(dq, 0)
        end
    end
    shu = CARD_ROW_COUNT
    for key, value in pairs(shujuR) do
        _G.table.insert(dq, value)
        shu = shu - 1
        if shu == 0 then
            shu = CARD_ROW_COUNT
        end
        if value.taskState.award then
            _G.table.insert(self.CurrentBaoXiangList, #dq)
        end
    end
    if _G.math.fmod(_G.table.count(shujuR), CARD_ROW_COUNT) > 0 then
        -- body
        for i = 1, shu do
            _G.table.insert(dq, 0)
        end
    end

    local dq_grouped = {}
    --数据按行分组
    local function addCategoryData(shuju)
        if _G.table.count(shuju) > 0 then
            -- 插入分类标题（=1）
            local titleRow = shuju[1].taskState.groupPinJie
            _G.table.insert(dq_grouped, titleRow)

            local row = {} -- 存放当前行的数据
            for key, value in pairs(shuju) do
                table.insert(row, value)
                if #row == CARD_ROW_COUNT then
                    table.insert(dq_grouped, row)
                    row = {} -- 重新开始下一行
                end
            end

            -- 如果最后一行不足 4 个，填充 0
            while #row < CARD_ROW_COUNT and #row ~= 0 do
                table.insert(row, 0)
            end
            if #row > 0 then
                table.insert(dq_grouped, row)
            end
        end
    end

    -- 依次处理 SSR、SR、R 分类的数据
    addCategoryData(shujuSSR)
    addCategoryData(shujuSR)
    addCategoryData(shujuR)

    -- 将最终分组数据赋值
    self.DQIllustrationDataortHunJiang = dq_grouped
    total = _G.table.count(self.DQIllustrationDataortHunJiang)
    self.XianShiBiao = {}
    --self.DQIllustrationDataortHunJiang = dq
    self.TuJianFenZu = 3

    -- 第一个可领取的角色索引
    local index = require("IllustrationModel"):GetInstance():GetCardIllFisrtAwardIndex()
    -- 计算角色在滑动列表中所在的item
    -- ssr、sr、r 标题也占一个索引
    -- 滑动列表索引从0开始，所以索引 -1
    if index - _G.table.count(shujuSSR) < 0 then
        -- ssr
        index = 1 + (index - 1) // 4 + 1 - 1
    elseif index - _G.table.count(shujuSSR) - _G.table.count(shujuSR) < 0 then
        -- sr
        index = 1 + (_G.table.count(shujuSSR) - 1) // 4 + 1 +
            1 + (index - _G.table.count(shujuSSR) - 1) // 4 + 1 - 1
    else
        -- r
        index = 1 + (_G.table.count(shujuSSR) - 1) // 4 + 1 +
            1 + (_G.table.count(shujuSR) - 1) // 4 + 1 +
            1 + (index - _G.table.count(shujuSSR) - _G.table.count(shujuSR) - 1) // 4 + 1 - 1
    end
    ---looplist2的C#代码有改动，做兼容处理
    -- local isNewCSCode = _G.AppSetting.IS_EDITOR or _G.GameUtil.CompareVersion("1.0.0")
    if self.go_table.looplist2_team.isChangeCode then
        if self.num ~= total then
            self.num = total
            self.go_table.looplist2_team:SetListItemCount(self.num, true, false, index)
        else
            self.go_table.looplist2_team:MovePanelToItemIndex(index)
        end
    else
        if self.num ~= total then
            self.num = total
            self.go_table.looplist2_team:SetListItemCount(self.num, true, false)
        end
        self.go_table.looplist2_team:MovePanelToItemIndex(index)
    end
end

--初始化item
function IllustrationView:RefreshRenItem(listView2, index)
    if index < 0 then
        return
    end
    local t_index = index + 1
    local item = listView2:NewListViewItem("$_obj_Item1")
    item:SetActiveE(1)

    self:SetItem(item, t_index)
    return item
end

--设置Item
function IllustrationView:SetItem(go, teamsid)
    if not self.cardItems then
        self.cardItems = {}
    end

    local item = self.cardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        self.cardItems[go:GetInstanceIDE()] = item
    end

    local index = teamsid
    local data = self.DQIllustrationDataortHunJiang[index]
    item.index = index
    item.data = data

    item.obj_title:SetActiveE(0)
    item.obj_cards:SetActiveE(0)

    if not data or data == 1 or data == 2 or data == 3 then
        item.obj_title:SetActiveE(1)
        item.aorimage_pinjie.SpriteName = PingJie[data]
        item.aorimage_pinjie:SetNativeSize()
    else
        item.obj_cards:SetActiveE(1)
        self:SetCardItem(item, index)
    end

    _G.GameUtil.ReBuildRTF(go.gameObject)
    self.go_table.looplist2_team:OnItemSizeChanged(index - 1)
end

function IllustrationView:SetCardItem(go, index)
    for i = 1, CARD_ROW_COUNT do
        local tb, data
        tb = _G.GetAutoGoTable(go[CardItemName[i]])
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.AddHunJiangBtn, tb))

        data = self.DQIllustrationDataortHunJiang[index][i]
        tb.rowIndex = index --行index
        tb.index = i        --行index
        tb.data = data

        if not data or data == 0 or data == 1 or data == 2 then
            tb.gameObject:SetActiveE(0)
        else
            tb.gameObject:SetActiveE(1)
            self.BaoXiangEffectInit[index] = 0
            tb.aorimage_Click:SetActiveE(data.taskState.taskState and 0 or 1)             --判断是否解锁
            tb.obj_effect:SetActiveE(_G.IsNil(self.BaoXiangEffectInit[index]) and 1 or 0) --宝箱特效初次显示
            tb.aorimage_baoxiang:SetActiveE(data.taskState.award and 1 or 0)              --宝箱按钮显示
            --卡牌类型
            local cardCfg = require "CardCommentManager":GetInstance():CardData(data.taskState.group, true)
            local showType = false
            if cardCfg and cardCfg.Elements == _G.CardElementType.God then
                --ZHJH-5722 传奇种族不再显示传奇标签
                showType = false
                tb.aorimage_type.SpriteName = "0ui_icon_chuanqi"
            elseif cardCfg and cardCfg.card_logo == 1 then
                showType = true
                tb.aorimage_type.SpriteName = "0ui_icon_hexin"
            end
            tb.aorimage_type:SetActiveE(showType and 1 or 0)

            --加载卡牌
            local grade = cardCfg and cardCfg.Order or 1 --取卡牌原始品质
            tb.data = data                               --限制多次调用异步加载, 加载完成从tb.data取最后的数据
            tb.grade = grade
            if not tb.cardItem then
                tb.cardItem = 0 --限制异步加载
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.baseBodyItem,
                    tb.aorrawimage_role,
                    function(cardItem)
                        if _G.IsNil(tb.aorrawimage_role) then
                            --ItemFactory:GetInstance():SetItemCard(cardItem)
                            return
                        end
                        tb.cardItem = cardItem
                        cardItem.transform:SetLocalPositionToZero()
                        cardItem.transform:SetLocalScale(1, 1, 1)
                        if not tb.data or tb.data == 0 or tb.data == 1 or tb.data == 2 then
                            return
                        end
                        cardItem:Show({
                                sid = tb.data.taskState.group,
                                star = tb.data.taskState.star,
                                lv = tb.data.level,
                                soulLink_lv = tb.data.taskState.star,
                                potential = tb.data.potential,
                                Grade = tb.grade
                            },
                            nil,
                            true
                        )
                        cardItem:ShowOrHideEffect(data.taskState.taskState)
                    end
                )
            elseif tb.cardItem ~= 0 then
                tb.cardItem:Show(
                    {
                        sid = data.taskState.group,
                        star = data.taskState.star,
                        lv = data.level,
                        soulLink_lv = data.taskState.star,
                        potential = data.potential,
                        Grade = grade
                    },
                    nil,
                    true
                )
                tb.cardItem:ShowOrHideEffect(data.taskState.taskState)
            end
        end
    end
end

---魂将显示刷新
---@param go UnityEngine.GameObject
function IllustrationView:Hunjiang(_i, go)
    if not self.cardItems then
        ---@type table<number, any>
        self.cardItems = {}
    end

    local item = self.cardItems[go:GetInstanceIDE()]
    if not item then
        item = _G.GetAutoGoTable(go)
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.AddHunJiangBtn, item))
        self.cardItems[go:GetInstanceIDE()] = item
    end

    local index = _i + 1
    local data = self.DQIllustrationDataortHunJiang[index]
    item.index = index
    item.data = data

    if _i % CARD_ROW_COUNT == 0 then
        self.XianShiBiao[_i / CARD_ROW_COUNT] = data.taskState.groupPinJie
    end
    if not data or data == 0 then
        item.gameObject:SetActiveE(0)
    else
        item.gameObject:SetActiveE(1)

        self.BaoXiangEffectInit[index] = 0
        item.aorimage_Click:SetActiveE(data.taskState.taskState and 0 or 1)             --判断是否解锁
        item.obj_effect:SetActiveE(_G.IsNil(self.BaoXiangEffectInit[index]) and 1 or 0) --宝箱特效初次显示
        item.aorimage_baoxiang:SetActiveE(data.taskState.award and 1 or 0)              --宝箱按钮显示
        --卡牌类型
        local cardCfg = require "CardCommentManager":GetInstance():CardData(data.taskState.group, true)
        local showType = false
        if cardCfg and cardCfg.Elements == _G.CardElementType.God then
            showType = true
            item.aorimage_type.SpriteName = "0ui_icon_chuanqi"
        elseif cardCfg and cardCfg.card_logo == 1 then
            showType = true
            item.aorimage_type.SpriteName = "0ui_icon_hexin"
        end
        item.aorimage_type:SetActiveE(showType and 1 or 0)

        --加载卡牌
        local grade = cardCfg and cardCfg.Order or 1 --取卡牌原始品质
        if not item.cardItem then
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.baseBodyItem,
                item.aorrawimage_role,
                function(cardItem)
                    if _G.IsNil(item.aorrawimage_role) or item.data ~= data or item.cardItem then
                        ItemFactory:GetInstance():SetItemCard(cardItem)
                        return
                    end
                    cardItem.transform:SetLocalPositionToZero()
                    cardItem.transform:SetLocalScale(1, 1, 1)
                    cardItem:Show({
                            sid = data.taskState.group,
                            star = data.taskState.star,
                            lv = data.level,
                            soulLink_lv = data.taskState.star,
                            Grade = grade
                        },
                        nil,
                        true
                    )
                    cardItem:ShowOrHideEffect(data.taskState.taskState)
                    item.cardItem = cardItem
                end
            )
        else
            item.cardItem:Show(
                {
                    sid = data.taskState.group,
                    star = data.taskState.star,
                    lv = data.level,
                    soulLink_lv = data.taskState.star,
                    Grade = grade
                },
                nil,
                true
            )
            item.cardItem:ShowOrHideEffect(data.taskState.taskState)
        end
    end
end

---魂将显示
function IllustrationView:AddHunJiangBtn(go, _, item)
    local rowIndex = item.rowIndex
    local index = item.index
    local data = self.DQIllustrationDataortHunJiang[rowIndex][index]
    local name = go:GetName()

    if name == "@_aorbtn_baoxiang" then
        if self.BaoXiangEnable then
            self.CurrentBaoXiangRowIndex = index
            require("IllustrationModel"):GetInstance():BaoXiang(
                data,
                _G.handlerbind(self, self.BaoXiangIllustrationNew, rowIndex)
            )
            self.BaoXiangEnable = false
        end
    elseif name == "@_aorbtn_Click" then
        --ZHJH-4121 统一跳转至预览界面
        -- local count =  _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.Card,data.taskState.group)
        --local card = _G.StorageManager:GetInstance():GetMaxPowerCardBySid(data.taskState.group)
        local cardData = require("CardData").GetPreviewData(data.taskState.group)
        cardData:SetSkin(0)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardShowView.Name,
            { CardData = cardData },
            nil,
            true, nil, 1)
        --if data.taskState.taskState and card then
        --    -- 解锁
        --    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardShowView.Name,
        --    {CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card,card.uid)})
        --else
        -- 未解锁
        --end
    end
end

