---魂将根据传输数据来修改源数据
function IllustrationView:ShuJuXiuGai(data)
    local IllustrationHunJiangList = require "IllustrationModel":GetInstance().IllustrationHunJiangList
    if IllustrationHunJiangList[data] ~= nil then
        IllustrationHunJiangList[data].taskState.award = false
        for key, value in pairs(self.IllustrationDataortHunJiang) do
            if value.taskState.group == data then
                value.taskState.award = false
            end
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("ID查找失败")
        end
    end
end

