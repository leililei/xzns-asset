---收藏按钮点击
function IllustrationView:Shoucang()
    ---@type illustrations.c2s_collect
    local callback = {}
    callback.sid = self.ShoucangDate.taskState.group
    if self.ShoucangDate.taskState.award == require "IllustrationModel".Information.TypeNo then
        self.ShoucangDate.taskState.award = require "IllustrationModel".Information.TypeYes
        callback.behavior = require "IllustrationModel".Information.TypeYes
    elseif self.ShoucangDate.taskState.award == require "IllustrationModel".Information.TypeNew then
        callback.behavior = require "IllustrationModel".Information.TypeYes
        self.ShoucangDate.taskState.award = require "IllustrationModel".Information.TypeYes
    else
        callback.behavior = require "IllustrationModel".Information.TypeNo
        self.ShoucangDate.taskState.award = require "IllustrationModel".Information.TypeNo
    end
    IllustrationNet:GetInstance():IllustrationsCollect(
        callback,
        _G.handlerbind(self, self.GetIllustrationNew, callback)
    )
end

---收藏按钮点击刷新
function IllustrationView:GetIllustrationNew(msg, callback)
    local illuModel = require "IllustrationModel"
    if callback.behavior == illuModel.Information.TypeYes then
        _G.table.insert(illuModel:GetInstance().ShowIllustrationImage, callback.sid)
        self.go_table.aorbtn_shoucang:GetComponentE(typeof(CS.AorImage)).SpriteName = "ui_tj_icon_02zhanshizhong"
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsID.shoucang)
    else
        _G.table.removebyvalue(illuModel:GetInstance().ShowIllustrationImage, callback.sid)
        self.go_table.aorbtn_shoucang:GetComponentE(typeof(CS.AorImage)).SpriteName = "ui_tj_icon_01zhanshi"
        _G.PopWindowManager:GetInstance():ShowAllTips(self.tipsID.nshoucang)
    end

    self.Data = msg
    self:HunJiangWuXing()
end

