---图鉴分类
function IllustrationView:IllustrationCon()
    local illustrations_image_cfg = _G.table.count(_G.ConfigManager.illustrations_image_cfg)
    if illustrations_image_cfg % self.IllustrationMax.HunJiang > 0 then
        self.IllustrationMaxNum.ChaHuaMax = illustrations_image_cfg / self.IllustrationMax.ChaHua + 1
    else
        self.IllustrationMaxNum.ChaHuaMax = illustrations_image_cfg / self.IllustrationMax.ChaHua
    end
    self.IllustrationNum.ChaHua = illustrations_image_cfg
    local illustrations_card_cfg = _G.table.count(_G.ConfigManager.illustrations_card_cfg)
    if illustrations_card_cfg % self.IllustrationMax.HunJiang > 0 then
        self.IllustrationMaxNum.HunJiangMax = illustrations_card_cfg / self.IllustrationMax.HunJiang + 1
    else
        self.IllustrationMaxNum.HunJiangMax = illustrations_card_cfg / self.IllustrationMax.HunJiang
    end
    self.IllustrationNum.HunJiang = illustrations_card_cfg

    local IllustrationHunJiangList = require("IllustrationModel"):GetInstance().IllustrationHunJiangList
    self.IllustrationDataortHunJiangs = {}
    for _, value in pairs(IllustrationHunJiangList) do
        self.IllustrationDataortHunJiangs[value.taskState.display_priority] = {}
        self.IllustrationDataortHunJiangs[value.taskState.display_priority] = value
    end

    for i = 1, illustrations_card_cfg do
        _G.table.insert(self.IllustrationDataortHunJiang, self.IllustrationDataortHunJiangs[i])
    end
    local IllustrationTuJianList = require("IllustrationModel"):GetInstance().IllustrationTuJianList
    self.IllustrationDataortChaHuas = {}
    for _, value in pairs(IllustrationTuJianList) do
        self.IllustrationDataortChaHuas[value.taskState.display_priority] = {}
        self.IllustrationDataortChaHuas[value.taskState.display_priority] = value
        -- body
    end
    for i = 1, illustrations_image_cfg do
        _G.table.insert(self.IllustrationDataortChaHua, self.IllustrationDataortChaHuas[i])
    end
    self.IllustrationDataortChaHuas = nil
    self.IllustrationDataortHunJiangs = nil
end

