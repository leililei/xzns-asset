function IllustrationView:BaoXiangIllustrationNew(msg, index)
    ---@type public.s2c_common_ack
    self.Data = msg
    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonAwardView.Name,
        msg,
        function()
