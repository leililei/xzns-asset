function IllustrationView:Show()
    if self.isAddEvent then
        return
    end
    self.isAddEvent = true
    _G.Events:GetInstance():AddListener(_G.eIllustrationUnlcok.CardIllustrationUnlcok, self.UpdateView, self)
end

function IllustrationView:Hide()
    if not self.isAddEvent then
        return
    end
    self.isAddEvent = false
    _G.Events:GetInstance():RemoveListener(_G.eIllustrationUnlcok.CardIllustrationUnlcok, self.UpdateView, self)
end

