---@class GameDataModelBase : Singleton 	中文描述
local GameDataModelBase = _G.BaseClass("GameDataModelBase", _G.Singleton)
_G.GameDataModelBase = GameDataModelBase

---创建对象时,入口构造函数
function GameDataModelBase:__init()
    self.endCallback = nil
    self.curFunctionOpenID = 0
    self.initFunctionTag = true
    self.initDataDoneTag = true
end

---销毁对象时,析构函数
function GameDataModelBase:Dispose()
    self.endCallback = nil
    self.curFunctionOpenID = nil
    if self.addFunctionListener then
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
        self.addFunctionListener = nil
    end
    self.initFunctionTag = nil
    self.initDataDoneTag = nil
end

function GameDataModelBase:InitData(endcall)
    if self.curFunctionOpenID > 0 then
        if self.addFunctionListener then
            if endcall then
                endcall(self.__cname)
            end
            return
        end
        if not self:GetFunctionOpen() then
            self.addFunctionListener = true
            self.OnSixUpdateTag = nil
            _G.Events:GetInstance():AddListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
            if endcall then
                endcall(self.__cname)
            end
            return
        end
    end
    self.endCallback = endcall
    self:GetDataFormServer()
end

function GameDataModelBase:OnFunctionOpenCall(id)
    if id == self.curFunctionOpenID then
        self.addFunctionListener = nil
        _G.Events:GetInstance():RemoveListener(_G.eFunctionsStatus.OpenCfgFunctionId, self.OnFunctionOpenCall, self)
        self:InitData(_G.handler(self, self.OnInitFunction))
    end
end

---!!!继承重写此方法时, 需同时重写GetDataFormServer方法且调用ParseData回调(否则Logicmanager逻辑将被阻断)
function GameDataModelBase:OnSixClockUpdate(endcall)
    if self.curFunctionOpenID > 0 then
        if self.addFunctionListener then
            if endcall then
                endcall()
            end
            return
        end
        if not self:GetFunctionOpen() then
            if endcall then
                endcall(self.__cname)
            end
            self.addFunctionListener = true
            return
        end
    end
    self.initFunctionTag = true
    self.OnSixUpdateTag = true
    self:InitData(endcall)
end

---执行初始化
---@param force boolean 是否强制(凌晨6点刷新需要强制，解决登录时，因为功能解锁导致重复执行)
function GameDataModelBase:OnInitFunction(force)
    if self.initDataDoneTag then
        return
    end
    if not self.addFunctionListener then
        if force == true then
            self:InitFunction()
        else
            if self.initFunctionTag then
                self.initFunctionTag = nil
                self:InitFunction()
            end
        end
    end
end
--region 子类重写
---获取模块功能是否开放
---@return boolean 是否开放
function GameDataModelBase:GetFunctionOpen()
    local createPlayer = _G.PlayerModel:GetInstance():CheckCreateRole()
    if self.curFunctionOpenID > 0 then
        if createPlayer then
            return _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID)
        end
    end
    return createPlayer
end
---从服务器拉取数据
function GameDataModelBase:GetDataFormServer()
    if _G.AppSetting.DEBUG then
        _G.LogWarning("子类没有重写GetDataFormServer方法 name = " .. self.__cname)
    end
end
---解析数据
---@param data table 服务器返回数据
function GameDataModelBase:ParseData(data)
    self.initDataDoneTag = nil
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    self.endCallback = nil
    self.OnSixUpdateTag = nil
end
---重连成功调用
---@param endcall function 完成回调
function GameDataModelBase:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
end
---初始化功能逻辑
function GameDataModelBase:InitFunction()
end
--endregion

function GameDataModelBase:AddOnNetReConnectListener(call, obj)
    _G.Events:GetInstance():AddListener(self.__cname, call, obj)
end

function GameDataModelBase:RemoveOnNetReconnectListener(call, obj)
    _G.Events:GetInstance():RemoveListener(self.__cname, call, obj)
end

function GameDataModelBase:BroadcastNetReconnect()
    _G.Events:GetInstance():Broadcast(self.__cname)
end

---初始
function GameDataModelBase:StartUp()
end

return GameDataModelBase
