---@class HellGuardTaskData	中文描述
---@field cfg hell_guard_cfg
local HellGuardTaskData = _G.BaseClass("HellGuardTaskData", _G.LogicClass)
---非叠加数据
local isNotAdd = {
    [_G.HellGuardTaskType.OneKillEnemy] = true
}
---类的构造函数
function HellGuardTaskData:__init(data)
    self:Parse(data)
end

---类的析构函数
function HellGuardTaskData:Dispose()
end

---@param data guard.proto.i_task
function HellGuardTaskData:Parse(data)
    self.sid = data.tid
    self.cfg = _G.ConfigManager.hell_guard_cfg[self.sid]
    self.type = self.cfg.type_mission
    self.conditionNum = self.cfg.count
    self.taskType = self.cfg.condition[1][1]
    self.curValue = data.curr == -1 and self.conditionNum or data.curr
    self:CheckTask()
    self:CheckState()
    if self.state == _G.TaskEnum.ETaskState.Claimed then
        _G.Events:GetInstance():AddListener(_G.eHellGuard.UpdateTask, self.UpdateTask, self)
    end
end

---检测任务
function HellGuardTaskData:CheckTask()
    if self.taskType == _G.HellGuardTaskType.Complete then
        if require "HellGuardModel":GetInstance():CheckIsPass(self.cfg.condition[1][#self.cfg.condition[1]]) then
            self.curValue = self.conditionNum
        end
    end
end

---检测任务状态
function HellGuardTaskData:CheckState()
    self.state =
        self.curValue >= self.conditionNum and _G.TaskEnum.ETaskState.Submited or _G.TaskEnum.ETaskState.Claimed
    if
        self.state == _G.TaskEnum.ETaskState.Submited and
        require "HellGuardModel":GetInstance():CheckTaskIsFinish(self.sid)
    then
        self.state = _G.TaskEnum.ETaskState.Completed
    end
    if self.state == _G.TaskEnum.ETaskState.Submited then
        _G.Events:GetInstance():RemoveListener(_G.eHellGuard.UpdateTask, self.UpdateTask, self)
    end
end

---@param data table
function HellGuardTaskData:UpdateTask(data, param)
    if self.state ~= _G.TaskEnum.ETaskState.Claimed then
        return
    end
    if self.type ~= data[1] then
        return
    end
    if _G.table.same(self.cfg.condition, data) then
        local num = self.curValue + param
        if num >= self.conditionNum then
            num = self.conditionNum
        elseif isNotAdd then
            num = 0
        end
        self.curValue = num
        self:CheckState()
    end
end

function HellGuardTaskData:FinishTask()
    self.state = _G.TaskEnum.ETaskState.Completed
    self.curValue = -1
end

return HellGuardTaskData
