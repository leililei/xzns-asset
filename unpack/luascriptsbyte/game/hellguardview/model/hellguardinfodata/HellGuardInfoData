---@class HellGuardInfoData	中文描述
---@field sid number 通关历史最高难度
---@field curSid number 当前难度
---@field taskModel HellGuardTaskModel
---@field maxDifficulty number 最高难度
---@field cfg hell_guard_diff_cfg 当前难度配置
local HellGuardInfoData = _G.BaseClass("HellGuardInfoData")
---类的构造函数
function HellGuardInfoData:__init()
    self.sid = 0
    self.curSid = 0
    self.taskModel = require "HellGuardTaskModel".New()
    self.maxDifficulty = #_G.ConfigManager.hell_guard_diff_cfg
    self.killNum = 0
end

---类的析构函数
function HellGuardInfoData:Dispose()
    self.sid = nil
    self.curSid = nil
    self.taskModel = nil
    self.maxDifficulty = nil
    self.killNum = nil
end

---@param msg guard.s2c_guard_info
function HellGuardInfoData:Parse(msg)
    self.sid = msg.info.sid
    self.curSid = self.sid + 1 > self.maxDifficulty and self.maxDifficulty or self.sid + 1
    self.cfg = _G.ConfigManager.hell_guard_diff_cfg[self.curSid]
    self.last_kill_num = msg.info.kill_num
    self.last_rank = msg.info.last_rank
    self.last_sid = msg.info.last_sid
    self.maxKillNum = msg.info.max_kill_num
    self.taskModel:Parse(msg)
    self.start = self.maxDifficulty - self.curSid >= 3 and self.curSid or self.maxDifficulty - 3
    self.killNum = msg.info.kill_num
    if require "HellGuardModel":GetInstance().realData then
        self.last_rank = msg.info.last_rank
        self.last_sid = msg.info.last_sid
        self.last_kill_num = msg.info.last_kill_num
        self.is_get_award = msg.info.is_get_award
    end
    self.role_kill_num = msg.info.role_kill_num
    self.role_fight_sid = msg.info.role_fight_sid
    _G.Events:GetInstance():Broadcast(_G.eHellGuard.RefreshModel)
    --TODO 更新红点
end
---更新难度
function HellGuardInfoData:UpdateDifficulty()
    self.sid = self.curSid
    self.curSid = self.sid + 1 > self.maxDifficulty and self.maxDifficulty or self.sid + 1
    _G.Events:GetInstance():Broadcast(_G.eHellGuard.RefreshModel)
end

---完成任务
function HellGuardInfoData:FinishTask(sid)
    self.taskModel:FinishTask(sid)
end
---检测任务是否完成
function HellGuardInfoData:CheckTaskIsFinish(sid)
    return self.taskModel:CheckIsFinish(sid)
end
---获取任务数据
function HellGuardInfoData:GetTaskDatas()
    return self.taskModel:GetTaskDatas()
end
---任务排序
function HellGuardInfoData:SortTask()
    self.taskModel:SortTask()
end

function HellGuardInfoData:ClearLast()
    self.is_get_award = 1
end

return HellGuardInfoData
