---@class HellGuardTaskModel	中文描述
---@field finishTasks table<boolean>
---@field taskDatas HellGuardTaskData[]
local HellGuardTaskModel = _G.BaseClass("HellGuardTaskModel")

---类的析构函数
function HellGuardTaskModel:Dispose()
    self.taskDatas = nil
    self.finishTasks = nil
end

---解析数据
---@param msg guard.s2c_guard_info
function HellGuardTaskModel:Parse(msg)
    self:InitFinishTask(msg)
    self:InitTaskDatas(msg)
    self.taskArray = nil
end
---初始化任务数据
---@param msg guard.proto.s2c_guard_info
function HellGuardTaskModel:InitTaskDatas(msg)
    self.taskDatas = {}
    if msg.info.curr_task then
        for _, v in pairs(msg.info.curr_task) do
            self.taskDatas[v.tid] = require "HellGuardTaskData".New(v)
        end
    end
    if self.finishTasks then
        for k, v in pairs(self.finishTasks) do
            self.taskDatas[k] = require "HellGuardTaskData".New({tid = k, curr = -1})
        end
    end
end
--region 完成任务
---初始化任务完成
---@param msg guard.proto.s2c_guard_info
function HellGuardTaskModel:InitFinishTask(msg)
    self.finishTasks = {}
    if msg.info.finish_one_task then
        for _, v in pairs(msg.info.finish_one_task) do
            self.finishTasks[v] = true
        end
    end
    if msg.info.finish_daily_task then
        for _, v in pairs(msg.info.finish_daily_task) do
            self.finishTasks[v] = true
        end
    end
end

---检测是否完成
function HellGuardTaskModel:CheckIsFinish(sid)
    return self.finishTasks[sid]
end

---完成任务
---@param data HellGuardTaskData
function HellGuardTaskModel:FinishTask(sid)
    self.finishTasks[sid] = true
    self.taskDatas[sid]:FinishTask()
end
---获取任务数据
function HellGuardTaskModel:GetTaskDatas()
    if not self.taskArray then
        self.taskArray = {}
        for _, v in pairs(self.taskDatas) do
            if not self.taskArray[v.type] then
                self.taskArray[v.type] = {}
            end
            _G.table.insert(self.taskArray[v.type], v)
        end
    end
    self:SortTask()
    return self.taskArray
end
---任务排序
function HellGuardTaskModel:SortTask()
    if not self.taskArray then
        return
    end
    for _, v in pairs(self.taskArray) do
        _G.SortList(
            v,
            function(data)
                local type = -99
                if data.state == _G.TaskEnum.ETaskState.Submited then
                    type = 99
                elseif data.state == _G.TaskEnum.ETaskState.Claimed then
                    type = 0
                end
                return type, -data.sid
            end
        )
    end
end
---检测是否有可领取的任务
function HellGuardTaskModel:CheckHaveGetTask(type)
    if not self.taskDatas then
        return false
    end
    if type then
        if self.taskArray then
            for _, v in pairs(self.taskArray[type]) do
                if v.state == _G.TaskEnum.ETaskState.Submited then
                    return true
                end
            end
        end
    else
        for k, v in pairs(self.taskDatas) do
            if v.state == _G.TaskEnum.ETaskState.Submited then
                return true
            end
        end
    end

    return false
end

--endregion

return HellGuardTaskModel
