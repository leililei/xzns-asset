---@class HellGuardModel:GameDataModelBase	中文描述
---@field infoData HellGuardInfoData 信息数据
---@field TaskDatas HellRoadTaskData[] 任务数据
local HellGuardModel = _G.BaseClass("HellGuardModel", _G.GameDataModelBase)

local Key = "HellGuardModelFirst"
---@return HellGuardModel HellGuardModel
function HellGuardModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function HellGuardModel:__init()
    self.TaskDatas = {}
    self.curFunctionOpenID = _G.FunctionID.HellGuard
    self.realData = true
    self.infoData = require "HellGuardInfoData".New()
    self.redPointId = _G.ConfigManager.redpoint_cfg.HellGuard.id
end

---销毁对象时,析构函数
function HellGuardModel:Dispose()
    self.TaskDatas = nil
    self.infoData = nil
    self.curFunctionOpenID = nil
    if self.sixTimer then
        self.sixTimer:Stop()
        self.sixTimer = nil
    end
end

--region 子类重写
---从服务器拉取数据
function HellGuardModel:GetDataFormServer()
    self:GetInfo()
end

---初始化功能逻辑
function HellGuardModel:InitFunction()
    local time = _G.TimeUtil.GetSecondsOfDayOf6Hour()
    if time > 0 and time < 60 and not self.sixTimer then
        self.sixTimer =
            _G.TimerManager:GetInstance():GetTimer(60 - time, self.OnSixClockUpdate, self, true, false, true)
        self.sixTimer:Start()
    end

    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.HellGuard.PassFloors
        },
        self.infoData.sid
    )
end

---重连成功调用
---@param endcall function 完成回调
function HellGuardModel:ReConnect(endcall)
    self:InitData(endcall)
end

--region 获取Info
function HellGuardModel:GetInfo()
    require "HellGuardNet":GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---获取成功回调
---@param msg guard.proto.s2c_guard_info
function HellGuardModel:GetInfoCall(msg)
    self.infoData:Parse(msg)
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.HellGuard.PassFloors
        },
        msg.info.sid
    )

    self:CheckIsFirst()
    self:ParseData()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.redPointId)
    self.realData = false
end

function HellGuardModel:GetKillNumInfo(call)
    ---@param msg guard.s2c_guard_info
    require "HellGuardNet":GetInstance():GetInfo(
        function(msg)
            self.infoData.killNum=msg.info.kill_num
            self.infoData.role_kill_num = msg.info.role_kill_num
            self.infoData.role_fight_sid = msg.info.role_fight_sid
            if call then
                call(self.infoData.role_kill_num)
            end
        end
    )
end

---检测是否为当天首次打开
function HellGuardModel:CheckIsFirst()
    if _G.PlayerPrefsManager.HasKey(Key) then
        local time = _G.PlayerPrefsManager.GetInt(Key, 0)
        local time2 = self:GetTime()
        self.isFirst = time < time2
    else
        self.isFirst = true
    end
end

---完成任务
---@param data HellGuardTaskData
function HellGuardModel:FinishTask(sids, call)
    require "HellGuardNet":GetInstance():FinishTask(
        {tid = sids},
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            for _, v in pairs(sids) do
                self.infoData:FinishTask(v)
            end

            if call then
                call(msg)
            end
            require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HellGuard.id, 1)
        end
    )
end

