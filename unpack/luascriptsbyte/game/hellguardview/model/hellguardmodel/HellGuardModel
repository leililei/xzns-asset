---获取结算期时长
---@return number
function HellGuardModel:GetSettlementDuration()
    local cfg = _G.ConfigManager.discrete_cfg[105803]
    return cfg and cfg[1][1] or 0
end

---是否在结算期中
---@return boolean
function HellGuardModel:IsSettlementTime()
    local sd = self:GetSettlementDuration()
    if sd <= 0 or sd >= 86400 then
        return false
    end
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local endTime = _G.TimeUtil.GetDayBegin(nowTime) + 86400 - sd --战斗其结束时间
    return nowTime >= endTime
end

---进入战斗
function HellGuardModel:Fight()
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.HellGuard, self.infoData.sid)
end

---自动进入下一关战斗
---@class battleView:HellGuardEmbattleView
function HellGuardModel:AutoNextFight()
    self.battleView:ClickStartBattleBtn()
end

---退出战斗
function HellGuardModel:ExitFitght()
    self.isChallenge = false
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
end

--重新开始战斗
function HellGuardModel:ReEnterFight()
    self:OnChallenge()
end

