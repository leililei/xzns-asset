---领取排行奖励
function HellGuardModel:GetLastRankAwarwd(call)
    if self:CheckCanTakeRankAward() then
        require "HellGuardNet":GetInstance():GetLastRankAwarwd(
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                self.infoData:ClearLast()
                if call then
                    call(msg)
                end
                require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HellGuard.id, 2)
            end
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(650101)
    end
end

---检测是否可以领取排行榜奖励
function HellGuardModel:CheckCanTakeRankAward()
    local time = _G.TimeUtil.GetSecondsOfDayOf6Hour()
    if self.infoData.last_rank and (not self.infoData.is_get_award or self.infoData.is_get_award == 0) then 
        return (time < 0 or time > 60) 
    end
    return false
end

---检测红点
function HellGuardModel:CheckRedPoint(id)
    if id == 0 then
        return self.isFirst
    elseif id == 1 then
        if self:CheckHaveGetTask() then
            return true
        -- elseif self.infoData.is_get_award == 0 and self:CheckCanTakeRankAward() then
        --     return true
        end
        return false
    elseif id == 2 then 
        return self:CheckCanTakeRankAward()
    end
end

---检测是否又可以领取的任务
function HellGuardModel:CheckHaveGetTask(type)
    return self.infoData.taskModel:CheckHaveGetTask(type)
end

function HellGuardModel:GetTime()
    local time = _G.TimeUtil.GetServerUnixTime()
    local data = _G.TimeUtil.GetDateTime(time)
    if data.hour < _G.TimeUtil.GAME_DAY_HOUR then
        return _G.TimeUtil.GetDayBegin(time - _G.TimeUtil.GAME_DAY_TIME) + _G.TimeUtil.GAME_DAY_TIME
    else
        return _G.TimeUtil.GetDayBegin(time) + _G.TimeUtil.GAME_DAY_TIME
    end
end

---检测是否为首次登录
function HellGuardModel:ChangeIsFirst()
    self.isFirst = false
    _G.PlayerPrefsManager.SetInt(Key, self:GetTime())
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HellGuard.id, 0)
end

function HellGuardModel:OnSixClockUpdate(endCall)
    if not self.sixTimer then
        self.sixTimer = _G.TimerManager:GetInstance():GetTimer(60, self.OnSixClockUpdate, self, true, false, true)
        self.sixTimer:Start()
        require "RedPointManager":GetInstance():RefreshNodeByAllParams(self.redPointId)
        _G.GameDataModelBase.OnSixClockUpdate(self, endCall)
    else
        self.realData = true
        self.sixTimer:Stop()
        self.sixTimer = nil
        _G.GameDataModelBase.OnSixClockUpdate(self)
    end
end

function HellGuardModel:OnSettlement()
    if not self.isChallenge then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.CommonRankView.Name)
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.HellGuardTaskView.Name)
    end
end

function HellGuardModel:OpenView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
end

--endregion

return HellGuardModel
