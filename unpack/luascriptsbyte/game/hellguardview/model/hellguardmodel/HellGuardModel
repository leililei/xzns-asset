    if (self.infoData.maxKillNum ~= nil) then
        return self.infoData.maxKillNum
    else
        return 0
    end
    --return self.infoData.killNum
end

---检测关卡是否通关
function HellGuardModel:CheckIsPass(id)
    local last = _G.ConfigManager.hell_guard_diff_cfg[#_G.ConfigManager.hell_guard_diff_cfg].id
    if (id == last and self.infoData.curSid == last) then
        if (_G.PlayerPrefsManager.GetInt("HellGuardLastPass") == 2) then
            return true
        end
        if (self:GetKillNum() >= _G.ConfigManager.discrete_cfg[107703][1][1]) then
            _G.PlayerPrefsManager.SetInt("HellGuardLastPass", 2)
            return true
        end
    end
    return self.infoData.sid >= id
end

---是否为当前是否为最后一关(sid从0开始，info从1开始，最大难度是50)
function HellGuardModel:CheckIsMax()
    return self.infoData.sid + 1 >= self.infoData.maxDifficulty
end

