local TrackingPointModel = require("TrackingPointModel")
---@class HellGuardView : UIBaseView	中文描述
---@field public go_table HellGuardView_GoTable GoTable
---@field difficultyItems HellGuardView._obj_1_GoTable[]
---@field refreshTimer Timer
local HellGuardView = _G.BaseClass("HellGuardView", _G.UIBaseView)
--_G.HellGuardView = HellGuardView
---@type HellGuardModel
local HellGuardModel
function HellGuardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HellGuardView:OnCreate()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.HellGuardView, self.go_table)
    HellGuardModel = require "HellGuardModel":GetInstance()
    HellGuardModel:ChangeIsFirst()
    self.difficultyItems = {}
    self.curWindow = "Main"
    self.order = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
    self:LoadSpine()
    self:InitView()
    self:AddListener(_G.eHellGuard.RefreshModel, self.InitView)
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    self.rankPanel =
        self:AddComponent(
        self.go_table.obj_littleZonePanel,
        require "LittleZoneRankView".New(_G.ZoneRankType.HellGuard, nil, nil, nil, nil,self:GetSelfRankData())
    )
    self.go_table.obj_inforedpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.CopyExplain.id,212)
    local resources = _G.ConfigManager.ui_cfg.HellGuardView.resources
    self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
    )
    self:AddComponent(
            self.go_table.obj_PlayerHead,
            require("PlayerComponent").New(self.go_table.obj_PlayerHead)
    )

    self:OnRefreshChallenge()
    self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(60, self.OnRefreshChallenge, self, false, false, true)
    self.refreshTimer:Start()
end

function HellGuardView:OnDestroy()
    self:RemoveAllListener()
    if self.refreshTimer then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
end

---刷新挑战按钮状态
function HellGuardView:OnRefreshChallenge()
    local isSettlement = HellGuardModel:IsSettlementTime()
    self.go_table.aorbtn_challenge:SetGray(isSettlement)
end

function HellGuardView:GetSelfRankData()
    local data = {
        HellGuardModel.infoData.role_fight_sid,
        HellGuardModel.infoData.role_kill_num,
    }
    return data
end

function HellGuardView:LoadSpine()
    if not _G.UIUtils.IsHaveChange(_G.IsNeedChangeUI.HellGuardView, "obj_SpineNode") then
        _G.PoolsManager:GetInstance():Spawn(
                "WX_Role/Animation_UI/Maluojiaer_UI/prf_Maluojiaer_UI_ui",
                _G.ePoolType.Temporary,
                self.go_table.obj_SpineNode,
                function(role)
                    if not self.go_table then
                        _G.DestroyObject(role)
                        return
                    end
                    role:SetLocalPosition(0, -209, 0)
                    role:SetLocalScale(0.6, 0.6, 0.6)
                end
        )
    end
end

---初始化界面
function HellGuardView:InitView()
    self:UpdateDifficulty()
    self:UpdateDifficultyInfo()
    if self.rankPanel then
        self.rankPanel:Refresh(self:GetSelfRankData())
    end
    self.go_table.aorbtn_info:SetActiveE(0)
end

---更新难度显示
function HellGuardView:UpdateDifficulty()
    local curDifficulty = HellGuardModel:GetCuDifficulty()
    local Difficulty
    ---@type HellGuardView._obj_1_GoTable
    local tb
    for i = 1, 4 do
        if not self.difficultyItems[i] then
            self.difficultyItems[i] =
                _G.GetAutoGoTable(self.go_table["obj_" .. i], _G.handlerbind(self, self.OnClickDifficulty, i))
            self.difficultyItems[i].aortext_desc.text = _G.LangUtil.GetLangPackValue(90026000013)
        end
        tb = self.difficultyItems[i]
        Difficulty = HellGuardModel:GetDifficulty(i)
        tb.aortext_mingzi.text = _G.LangUtil.GetLangPackValue(90026000007) .. Difficulty
        tb.aortext_togDesc.text = _G.LangUtil.GetLangPackValue(90026000007) .. Difficulty
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOn, Difficulty == curDifficulty)
        _G.GameUtil.SetActiveByCondition(tb.aorimage_isOff, Difficulty ~= curDifficulty)
        _G.GameUtil.SetActiveByCondition(tb.obj_suo, Difficulty > curDifficulty)
        tb.aorimage_isOff:SetGray(Difficulty > curDifficulty)
        tb.aortext_mingzi.color = _G.ColorTools.FormatColorByString(Difficulty > curDifficulty and "222222" or "C6B69D")
        if i < 4 then
            tb.slider_Progress.value = HellGuardModel:GetDifficulty(i + 1) > curDifficulty and 0 or 1
        end
    end
end

function HellGuardView:OnClickDifficulty(_, _, index)
    local curDifficulty = HellGuardModel:GetCuDifficulty()
    local Difficulty = HellGuardModel:GetDifficulty(index)
    if Difficulty > curDifficulty then
        _G.PopWindowManager:GetInstance():ShowAllTips(310106)
    end
end

function HellGuardView:UpdateDifficultyInfo()
    self.go_table.aortext_hp.text = (_G.math.floor(HellGuardModel:GetHpAdd() / 100)) .. "%"

    if HellGuardModel:CheckIsMax() then
        self.go_table.aortext_num.text = ""
        HellGuardModel:GetKillNumInfo(
                function(num)
                    self.go_table.aortext_power.text = HellGuardModel:GetCuDifficulty() .. "/" .. (num or 0)
                end
        )
    else
        HellGuardModel:GetKillNumInfo(
        function(num)
            self.go_table.aortext_power.text = (num or 0) .. "/" .. HellGuardModel:GetNextLevelCondition()
        end
        )
        -- self.go_table.aortext_num.text = HellGuardModel:GetNextLevelCondition()
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_none, false)
    end
end

function HellGuardView:CloseView()
    if self.rankWindow then
        self.rankWindow = false
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.HellGuardRankView.Name)
    end
    self:Close()
end

---按钮点击事件在这里派发
function HellGuardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_challenge then
        if _G.MainManager:GetInstance():IsFighting(true) then 
            return
        end
        if HellGuardModel:IsSettlementTime() then
            _G.PopWindowManager:GetInstance():ShowAllTips(827)
            self:OnRefreshChallenge()
            return
        end
        HellGuardModel:OnChallenge()
    elseif go == self.go_table.aorbtn_rank or go == self.go_table.aorbtn_rankDetail then
        --_G.UIManager:GetInstance():OpenWindow(
        --    _G.ConfigManager.ui_cfg.CommonRankView.Name,
        --    _G.CommonRankType.HellGuard
        --)
        if self.curWindow == "Rank" then
            return
        end
        self.curWindow = "Rank"
        if not self.rankWindow then
            self.rankWindow = true
            self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HellGuardRankView.Name)
        end
        self.go_table.obj_panel:SetActiveE(1)
        self.go_table.aorbtn_help:SetActiveE(0)
        self.go_table.aorbtn_rank:SetActiveE(0)
        self.go_table.aorbtn_task:SetActiveE(0)
        self.go_table.aorbtn_info:SetActiveE(0)
        self.go_table.aorbtn_Main:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_gn_frame"
    elseif go == self.go_table.aorbtn_Main then
        if self.curWindow == "Main" then
            return
        end
        self.curWindow = "Main"
        self.go_table.obj_panel:SetActiveE(0)
        self.go_table.aorbtn_help:SetActiveE(1)
        self.go_table.aorbtn_rank:SetActiveE(1)
        self.go_table.aorbtn_task:SetActiveE(1)
        self.go_table.aorbtn_info:SetActiveE(0)
        self.go_table.aorbtn_Main:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_gn_c_frame"
    elseif go == self.go_table.aorbtn_task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HellGuardTaskView.Name)
    elseif go == self.go_table.aorbtn_CloseView then
        if self.curWindow == "Rank" then
            self.curWindow = "Main"
            self.go_table.obj_panel:SetActiveE(0)
            self.go_table.aorbtn_help:SetActiveE(1)
            self.go_table.aorbtn_rank:SetActiveE(1)
            self.go_table.aorbtn_task:SetActiveE(1)
            self.go_table.aorbtn_info:SetActiveE(0)
            self.go_table.aorbtn_Main:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_gn_c_frame"
            return
        end
        TrackingPointModel:GetInstance():CloseActTracking(self.viewName)
        self:CloseView()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 74)
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WorldBossIntroduceView.Name, 212)
    end
end

---加载升星界面
function HellGuardView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.HellGuardRankView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() or not self.rankWindow then
        view:Close()
        return
    end

    view.transform:SetParentE(self.go_table.obj_panel)
    if view.go_table and view.go_table.obj_close then
        view.go_table.obj_close:SetActiveE(0)
    end
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder + 15
    )
end

return HellGuardView
