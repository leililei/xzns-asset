function HellGuardShowAwardView:InitPanel()
    local isMax = require "HellGuardModel":GetInstance():CheckIsMax()
    local data = self.data
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_complete, self.need <= 0 and not isMax)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_next, self.need > 0 and not isMax)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_end, isMax)
    --if self.need > 0 then
    --    self.go_table.aortext_num.text = self.need
    --end
    local next = "<color=#3CA831>" .. self.need .. "</color>"
    local per = "<color=#3CA831>" .. data.recent .. "%</color>"
    if AppSetting.IsXzns then
        next = "<color=#35CB00>" .. self.need .. "</color>"
        per = "<color=#35CB00>" .. data.recent .. "%</color>"
    end
    self.go_table.aortext_perTitle.text = _G.LangUtil.GetLangPackValue(90026000008, per)
    self.go_table.aortext_next.text = _G.LangUtil.GetLangPackValue(90026000010, next)
    self.go_table.aortext_killNum.text = tostring(data.kill_num)
    if (self.need > 0) then
        self.go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90000010034)
    elseif (self.need <= 0) then
        self.go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90000010033)
    end
end

---解析结算奖励
function HellGuardShowAwardView:SetAwardCount()
    local count = 0
    local count1 = 0
    if self.AwardData and not _G.table.isEmptyOrNil(self.AwardData) then
        count = _G.table.count(self.AwardData)
    end
    if self.ExtraAward and not _G.table.isEmptyOrNil(self.ExtraAward) then
        count = _G.table.count(self.ExtraAward)
    end
    self.awardCount = count + count1
end

---初始化胜利界面加载特效
function HellGuardShowAwardView:InitV()
    if self.awardCount > 0 then
        if self.AllItem == nil then
            self.AllItem = {}
        end
        self.CreateCount = 0
        self:ParseAward(self.AwardData, self.ExtraAward)
        self:CreateItem(self.Award)
    end
end

function HellGuardShowAwardView:CreateItem(award)
    local awardItem
    if award and not _G.table.isEmptyOrNil(award) then
        for _, v in pairs(award) do
            local goTable
            awardItem = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_AwardContent)
            _G.table.insert(self.AllItem, awardItem:GetComponentE(typeof(CS.UnityEngine.RectTransform)))
            goTable = _G.GetAutoGoTable(awardItem)
            goTable.sid = v._award[1]
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v._award,
                goTable.obj_root,
                function(tran)
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    self.CreateCount = self.CreateCount + 1
                    if _G.AppSetting.DEBUG then
                        _G.Log(self.CreateCount, "InitV,奖励个数")
                    end
                    if self.CreateCount == self.awardCount then
                        self:ShowAward()
                    end
                end,
                function()
                    self:ClickAward(goTable)
                end
            )
            _G.GameUtil.SetActiveByCondition(goTable.aorimage_extra, v._extra)
        end
    end
end

function HellGuardShowAwardView:ClickAward(goTable)
    local type = _G.StorageManager:GetInstance():CheckSidType(goTable.sid)
    if type == _G.StorageType.Card then
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow, self)
    end
    require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid)
end

function HellGuardShowAwardView:OnCommonIllustrationsViewShow(name)
    if name == _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name then
        _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, true)
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnCommonIllustrationsViewShow,
            self)
    end
end

---按钮点击事件在这里派发
function HellGuardShowAwardView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_back then
        if (self.need > 0) then
            self:CloseHell()
        elseif (self.need <= 0) then
            self:EnterNext()
        end
    end
end

function HellGuardShowAwardView:CloseHell()
    ---if not self.close then
    ---    return
    ---end
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if ctrl then
        ctrl:CloseCall(require "SettlementModel".FunctionEnum.None)
    end
    if self.callback then
        self.callback()
    end
    if self.call then
        self.call(require "SettlementModel".FunctionEnum.None)
    end
    self:Close()
end

---开启自动下一关的计时器
function HellGuardShowAwardView:StartAutoNextTimer()
    if (self.waitTimer == nil) then
        self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAutoNext, self)
        self.waitTimer:Start()
    end
    _G.PlayerPrefsManager.SetInt("StopHellGuardAutoFight", 0)
end

---更新自动下一关的计时器
function HellGuardShowAwardView:UpdateAutoNext(elapsed)
    ---当结算画面卡顿时可能导致在倒计时但勾选框不显示,确保倒计时一定显示
    local name = _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name
    self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if (self.ShowAwardWithButtonView.VEff ~= nil) then
        if (self.ShowAwardWithButtonView.VEff.toggle_autoNext.gameObject:GetActiveSelf() == 0) then
            self.ShowAwardWithButtonView.VEff.toggle_autoNext.gameObject:SetActiveE(1)
            self.autoNextText = self.ShowAwardWithButtonView.VEff.aortext_autoNext
        end
    end

    self.autoNextText.text = string.format(_G.GetLangPackValue(AutoNextText), Mathf.RoundToInt(self.waitTime))
    self.waitTime = self.waitTime - elapsed
    if (self.waitTime < 0) then
        self.waitTime = 0
        self.waitTimer:Stop()
        self.waitTimer = nil
        self:CloseCur()
        self:AutoEnterNext()
    end
end

---开始下一场战斗
function HellGuardShowAwardView:StartNextFight()
    HellGuardModel:AutoNextFight()
end

---自动进入下一场战斗
function HellGuardShowAwardView:AutoEnterNext()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.BattleOpened, self)
    HellGuardModel:ExitFitght()
    HellGuardModel:OnChallenge()
    _G.DelayDo(2.5, self.StartNextFight)
    self:HideAllOther()
end

---手动进入下一场战斗
function HellGuardShowAwardView:EnterNext()
    self:CloseCur()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.BattleOpened, self)
    HellGuardModel:ExitFitght()
    HellGuardModel:OnChallenge()
    self:HideAllOther()
    _G.DelayDo(2.5, self.StartNextFight)
end

---停止自动下一场战斗
function HellGuardShowAwardView:StopAutoNext()
    if (self.waitTimer == nil) then
        return
    end
    self.waitTimer:Stop()
    self.waitTimer = nil
    self.waitTime = 3
    self.autoNextText.text = _G.GetLangPackValue(TapAutoNextText)
    _G.PlayerPrefsManager.SetInt("StopHellGuardAutoFight", 1)
end

---自动战斗勾选变化
function HellGuardShowAwardView:OnToggleChanged()
    if (self.Toggle.isOn == false) then
        self:StopAutoNext()
    else
        if (self.Toggle.isOn == true) then
            self:StartAutoNextTimer()
        end
    end
end

---关闭当前的窗口
function HellGuardShowAwardView:CloseCur()
    local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if ctrl then
        ctrl:CloseCall(require "SettlementModel".FunctionEnum.None)
    end
end

---在进入下一场战斗时隐藏其他的窗口
function HellGuardShowAwardView:HideAllOther()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.WorldManager:GetInstance():SetCurrentWorldVisible(false, false)
end

---在结算界面点击了统计
function HellGuardShowAwardView:ClickShowTotal()
    if (self.waitTimer ~= nil) then
        self.waitTimer:Stop()
        self.waitTimer = nil
        self.waitTime = 3
        self.autoNextText.text = _G.GetLangPackValue(TapAutoNextText)
        self.TimerPaused = true
    end
end

---显示战斗消息

return HellGuardShowAwardView
