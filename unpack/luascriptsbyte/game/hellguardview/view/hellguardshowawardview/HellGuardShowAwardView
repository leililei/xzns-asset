---界面的入口函数
---@param result fight.c2s_fight_result
function HellGuardShowAwardView:OnCreate(call, award, extraAward, callback, result, data, fightArg)
    self.double = false
    self.call = call
    self.awardCount = 0
    self.AwardData = award
    self.result = result
    self.data = data
    self.fightArg = fightArg
    self.need = require "HellGuardModel":GetInstance():GetNextLevelCondition() - data.kill_num
    self.ExtraAward = extraAward
    self.callback = callback
    self.waitTime = 3
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, false)
    self:OpenEmbattleView()
    self:InitPanel()
    self:InitV()
    _G.Events:GetInstance():AddListener(_G.eHellGuardShowAwardEvents.ShowTotalView, self.ClickShowTotal, self)
end

function HellGuardShowAwardView:OnDisable()
    if (self.waitTimer ~= nil) then
        self.waitTimer:Stop()
        self.waitTimer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eHellGuardShowAwardEvents.ShowTotalView, self.ClickShowTotal, self)
    if (self.cot_end ~= nil) then
        _G.coroutine.stopwaiting(self.cot_end)
    end
    if (self.cot_gou ~= nil) then
        _G.coroutine.stopwaiting(self.cot_gou)
    end
end

function HellGuardShowAwardView:OpenEmbattleView()
    local result = {}
    result.iSWin = true
    result.statistics = true
    result.btnDisplay = false
    result.hidePlayerInfo = true
    result.loadedEffect = _G.handler(self, self.LoadedEffectCall)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    self:OnShowView(
        _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name,
        result,
        nil,
        nil,
        nil,
        self.fightArg and { self.fightArg } or nil
    )
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function HellGuardShowAwardView:OnShowView(name, result, ...)
    _G.UIManager:GetInstance():OpenWindow(name, nil, result, ...)
end

---监听界面
---@param name string 界面名称
function HellGuardShowAwardView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        self.cot_end = _G.DelayDo(
            1.5,
            function()
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, true)
                self.close = true

                self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
                if self.ShowAwardWithButtonView and self.ShowAwardWithButtonView.VEff then
                    self.ShowAwardWithButtonView.VEff.aorbtn_shenglitotal:SetParentE(self.go_table.obj_Award, 1)
                    if (self.need > 0) then
                        self.ShowAwardWithButtonView.VEff.toggle_autoNext:SetActiveE(0)
                    else
                        if (self.need <= 0 and require "HellGuardModel":GetInstance():CheckIsMax() == false) then
                            self.ShowAwardWithButtonView.VEff.toggle_autoNext:SetActiveE(1)
                            self.autoNextText = self.ShowAwardWithButtonView.VEff.aortext_autoNext
                            self.Toggle = self.ShowAwardWithButtonView.VEff.toggle_autoNext:GetComponentE(typeof(
                                CS.UnityEngine.UI.Toggle))
                            self.Toggle.onValueChanged:AddListener(_G.handler(self, self.OnToggleChanged))
                            if (_G.PlayerPrefsManager.GetInt("StopHellGuardAutoFight", 0) == 0) then
                                self.Toggle.isOn = true
                            else
                                self.Toggle.isOn = false
                            end
                            if (self.Toggle.isOn == true) then
                                self:StartAutoNextTimer()
                            end
                        end
                    end
                else
                    self:OnUIClosed(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
                end
            end
        )
        ---当结算界面打开时卡顿可能导致进倒计时但勾选框不显示，在结算界面显示1秒后再开一次勾选框，确保难度通过时勾选框一定显示
        self.cot_gou = _G.DelayDo(
            2.5,
            function()
                if (self.need <= 0 and require "HellGuardModel":GetInstance():CheckIsMax() == false) then
                    self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)
                    if self.ShowAwardWithButtonView and not self.ShowAwardWithButtonView.VEff.toggle_autoNext then
                        self.ShowAwardWithButtonView.VEff.toggle_autoNext:SetActiveE(1)
                        self.autoNextText = self.ShowAwardWithButtonView.VEff.aortext_autoNext
                            self.Toggle = self.ShowAwardWithButtonView.VEff.toggle_autoNext:GetComponentE(typeof(
                                CS.UnityEngine.UI.Toggle))
                            self.Toggle.onValueChanged:AddListener(_G.handler(self, self.OnToggleChanged))
                            if (_G.PlayerPrefsManager.GetInt("StopHellGuardAutoFight", 0) == 0) then
                                self.Toggle.isOn = true
                            else
                                self.Toggle.isOn = false
                            end
                            if (self.Toggle.isOn == true) then
                                self:StartAutoNextTimer()
                            end
                    end
                end
            end
        )
        ---_G.DelayDo(
        ---    1,
        ---    function()
        ---        self.close = true
        ---    end
        ---)
    end
end

