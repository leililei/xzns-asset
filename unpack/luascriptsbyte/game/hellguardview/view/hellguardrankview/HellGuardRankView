function HellGuardRankView:OnRank(isOn)
    -- _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
    if self.isZoneRankOpen then
        self:OnZoneRank(true)
        return
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ZoneRank, not isOn)
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
        _G.GameUtil.SetActiveByCondition(self.Rank.obj_yiwu, false)
        self.rankDatas = require "DungonesModel":GetInstance().rank_all_player or {}
        self.rankList = {}
        self.rewardList_Rank = {}
        self.RewardDatas = _G.ConfigManager.system_rank_cfg
        _G.table.sort(
            self.RewardDatas,
            function(a, b)
                return a.id < b.id
            end
        )
        local count = self.rankDatas and #self.rankDatas or 0
        self.Rank.scrollloopvectical_rankList:InitItemData(count > 3 and count or 3, _G.handler(self, self.RefreshRank))
        --_G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
        self:InitPlayer(self.Rank)
    end
end

---排行
function HellGuardRankView:InitRank()
    self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank)
    self.RewardDatas = _G.ConfigManager.system_rank_cfg
    local rewards = self.RewardDatas
    self.RewardDatas = _G.table.choose(
        rewards,
        function(k, v)
            if v.id <= 10000 or v.id >= 20000 then
                return false
            end
            return true
        end
    )
    _G.table.sort(
        self.RewardDatas,
        function(a, b)
            return a.id < b.id
        end
    )
    require "HellGuardModel":GetInstance():GetRank(
        function(data)
            self.rankDatas = data.guard_rank or {}
            self.rankList = {}
            self.rewardList_Rank = {}
            --_G.GameUtil.SetActiveByCondition(self.Rank.obj_no, #self.rankDatas <= 0)
            _G.GameUtil.SetActiveByCondition(self.gameObject, true)
            local count = self.rankDatas and #self.rankDatas or 0
            self.Rank.scrollloopvectical_rankList:InitItemData(count > 3 and count or 3,
                _G.handler(self, self.RefreshRank))
            self:InitTop3(self.Rank)
        end
    )

    require "HellGuardModel":GetInstance():GetPlayerRank(
        function()
            self:InitPlayer(self.Rank)
        end
    )
end

function HellGuardRankView:HeadClick(go, ref, data)
    local name = go:GetName()
    if name == "@_aorbtn_HeadClick" then
        if data.player_uid and data.player_uid > 0 then
            if data.player_uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                _G.PopWindowManager:GetInstance():ShowAllTips(620109)
            else
                _G.SystemSettingManager:GetInstance():OpenView(data.player_uid)
            end
        end
    elseif name == "@_aorbtn_GetAward" then
        if self.rewardSelf then
            local model = require "HellGuardModel":GetInstance()
            if model:CheckCanTakeRankAward() then
                model:GetLastRankAwarwd(
                    function(msg)
                        if msg.ack == 1 then
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                            self:InitPlayer(self.Rank)
                        end
                    end
                )
            end
        end
    end
end

---刷新排行
function HellGuardRankView:RefreshRank(index, obj)
    local newindex = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.rankList[instanceID] then
        self.rankList[instanceID] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.HeadClick, self.rankDatas[newindex]))
    end
    local tb = self.rankList[instanceID]
    if self.rankDatas and self.rankDatas[newindex] then
        local data = self.rankDatas[newindex]
        if not data.diff then
            local newData = {}
            newData.diff = data.rank_info[1]
            newData.kill_num = data.rank_info[2]
            newData.role_info = data.role_info
            data = newData
        end
        tb.obj_Info:SetLocalPosition(-30, 0, 0)
        tb.rankData = data
        tb.data = self:GetRankData(newindex)
        --_G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, newindex <= 3)
        if newindex <= 3 then
            tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
            tb.aorimage_rankBg:SetRectTransformSize(688, 132)
            for i = 1, 3 do
                tb["obj_rank" .. i]:SetActiveE(i == newindex and 1 or 0)
            end
            tb.aortext_rankNum:SetActiveE(0)
        else
            for i = 1, 3 do
                tb["obj_rank" .. i]:SetActiveE(0)
            end
            tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
            tb.aorimage_rankBg:SetRectTransformSize(680, 124)
            tb.aortext_rankNum:SetActiveE(1)
            tb.aortext_rankNum.text = newindex
        end
        if tb.rankData.role_info.uid == self.playerUid then
            tb.aortext_name.text = _G.PlayerModel:GetInstance():GetName()
            self:ShowTitle(tb.aorrawimage_Title, _G.PlayerModel:GetInstance():GetTitle())
            local headData = {}
            headData.style = _G.PlayerModel:GetInstance():GetRoleStyle()
            headData.frame = _G.PlayerModel:GetInstance():GetCurFrame()
            headData.lv = _G.PlayerModel:GetInstance():GetLevel()
            headData.title = _G.PlayerModel:GetInstance():GetTitle()
            headData.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
            UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, headData, 1, true, true, true)
        else
            --tb.aortext_name:SetAnchorPosition(-102, icon and -20 or 0)
            tb.aortext_name.text = data.role_info.name
            self:ShowTitle(tb.aorrawimage_Title, tb.rankData.role_info.title)
            UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, tb.rankData.role_info, 1, true, true, true)
        end
        tb.aorrawimage_Title:SetNativeSize()

        tb.aortext_level.text = _G.GetLangPackValue(90026000007) .. data.diff
        tb.aortext_num.text = data.kill_num
        if not tb.list then
            tb.list = {}
        end
        if self.IsHuiFang and tb.aorbtn_huifang then
            tb.aorbtn_huifang:SetActiveE(0)
        end
        if tb.data then
            self:ShowAward(tb, tb.obj_item, tb.data.rewards)
        end
    else
        tb.obj_Info:SetLocalPosition(-30, 0, 0)
        tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(i == newindex and 1 or 0)
        end
        tb.aortext_rankNum:SetActiveE(0)
        tb.aortext_num:SetActiveE(0)
        tb.aortext_level:SetActiveE(0)
        tb.aortext_name.text = _G.GetLangPackValue(90021800103)
        local head = _G.GetAutoGoTable(tb.obj_HeadItemBase)
        head.aorimage_portrait.SpriteName = "0ui_jsxt_sx_icon5"
        head.aorbtn_HeadClick:SetActiveE(0)
        head.obj_lvNode:SetActiveE(0)
        head.aorimage_levelBg:SetActiveE(0)
        local data = self:GetRankData(newindex)
        self:ShowAward(tb, tb.obj_item, data.rewards)
    end
end

function HellGuardRankView:ShowAward(tb, obj, award, isSelf)
    if not tb.list then
        tb.list = {}
    end
    if not isSelf then
        isSelf = false
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            local model = require "HellGuardModel":GetInstance()
            tb.list[i].go_table.obj_eff:ClearChildren()
            local canGet = isSelf and model:CheckCanTakeRankAward()
            if canGet then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    tb.list[i].go_table.obj_eff
                )
            end
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            local model = require "HellGuardModel":GetInstance()
            local canGet = isSelf and model:CheckCanTakeRankAward()
            --local isGet = isSelf and model.infoData.is_get_award == 1 and model.infoData.last_rank
            item.go_table.obj_eff:ClearChildren()
            if canGet then
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    item.go_table.obj_eff
                )
            end
            --item.go_table.obj_gou:SetActiveE(isGet and 1 or 0)
        end
    end
end

function HellGuardRankView:GetRankData(index)
    if index <= 0 then
        return
    end
    for _, v in pairs(self.RewardDatas) do
        if index >= v.min_rank and index <= v.max_rank then
            return v
        end
    end
    return nil
end

---显示前三名
function HellGuardRankView:InitTop3(rank)
    for i = 1, 3 do
        local tb = _G.GetAutoGoTable(rank["trans_rank" .. i])
        _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.HellGuardRankItem .. i, tb)
        if not self.rankDatas or not self.rankDatas[i] then
            tb.aorrawimage_norole:SetActiveE(1)
            tb.aortext_score:SetActiveE(0)
            tb.aortext_name.text = _G.GetLangPackValue(90021800103)
        else
            local data = self.rankDatas[i]
            tb.aorrawimage_norole:SetActiveE(0)
            tb.aortext_score:SetActiveE(1)
            tb.aortext_name.text = data.role_info.name
            if data.diff then
                tb.aortext_score.text = _G.GetLangPackValue(90026000007) .. data.diff .. ":" .. data.kill_num
            else
                tb.aortext_score.text = _G.GetLangPackValue(90026000007) .. data.rank_info[1] .. ":" .. data.rank_info
                    [2]
            end
            require("SystemSettingNet"):GetInstance():GetPlayerInfo(
                { uid = data.role_info.uid },
                function(msg)
                    if not msg.info then
                        return
                    end
                    local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
                    local scale = cfg.size2
                    local pos = cfg.pos_portrait
                    tb.trans_role:ClearChildren()
                    local path = cfg.ModelPathHi
                    if _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) then
                        path = _G.UIUtils.GetBattleSpine(cfg)
                        scale = cfg.size4
                        pos = { 0, 0, 0 }
                    end
                    _G.PoolsManager:GetInstance():Spawn(
                        path,
                        _G.ePoolType.Temporary,
                        nil,
                        function(trans)
                            if trans == nil then
                                if _G.AppSetting.DEBUG then
                                    _G.LogError("角色无法加载 path:" .. cfg.ModelPathHi .. "    CardInfoView LoadRoleScene")
                                end
                                return
                            end
                            if self:IsNil() then
                                _G.DestroyObject(trans)
                                return
                            end
                            trans:SetParentE(tb.trans_role)
                            trans:SetLocalPosition(pos[1], pos[2], pos[3])
                            trans:SetLocalScaleXYZ(scale)
                            --- 只有星座女神有神环
                            if _G.AppSetting.IsXzns then
                                local godHaloID = msg.info.god_halo
                                if godHaloID ~= 0 then
                                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                                    --- 神环路径，父级路径(加载角色的下面)
                                    _G.UIUtils.LoadGodHalo(effCfg, trans, godHaloID)
                                end
                                if not table.isEmptyOrNil(msg.info.artifact_skin) then
                                    _G.UIUtils.LoadArtifacteffect(trans,nil,msg.info.artifact_skin[1],msg.info.artifact_skin[2])
                                end
                            end
                        end
                    )
                end
            )
            self:UpdateTop3Title(tb, data.role_info.title, i)
        end
    end
end

---生成称号
---@param item table
function HellGuardRankView:UpdateTop3Title(tb, data, index)
    if data.sid == 0 then
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                player_title.title,
                tb.obj_titleEffect,
                function(trans)
                    if self.curShowEffTitle[index] ~= player_title.title then
                        trans:DestroyObject()
                        return
                    end
                    local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    parClip.NeedCheck = true
                    parClip.CheckCount = 10
                    parClip.CheckOne = 3
                    trans:SetLocalScaleXYZ(titleScale)
                end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end

---显示玩家排行
function HellGuardRankView:InitPlayer(rank)
    local PlayerModel = _G.PlayerModel:GetInstance()
    local hellModel = require "HellGuardModel":GetInstance()
    self.playerRank = require "HellGuardModel":GetInstance().playerRank
    self.player = _G.GetAutoGoTable(
        rank.obj_player,
        _G.handlerbind(self, self.HeadClick, { uid = _G.PlayerModel:GetInstance():GetPlayerUid() })
    )
    local tb = self.player
    local newindex = self.playerRank.index
    tb.aortext_label.text = _G.LangUtil.GetLangPackValue(90023300113)
    tb.aorbtn_GetAward:SetActiveE(0)
    if hellModel.infoData.last_rank and (not hellModel.infoData.is_get_award or hellModel.infoData.is_get_award == 0) then
        newindex = hellModel.infoData.last_rank
        tb.aortext_label.text = _G.LangUtil.GetLangPackValue(90029800020)
        tb.aorbtn_GetAward:SetActiveE(1)
    end
    tb.data = self:GetRankData(newindex)
    if newindex <= 3 and newindex > 0 then
        tb.aortext_rankNum:SetActiveE(0)
        tb.aortext_label:SetActiveE(0)
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(i == newindex and 1 or 0)
        end
        tb.aorimage_rankBg.SpriteName = "ui_diban" .. newindex
    else
        for i = 1, 3 do
            tb["obj_rank" .. i]:SetActiveE(0)
        end
        tb.aortext_rankNum:SetActiveE(1)
        tb.aortext_label:SetActiveE(1)
        tb.aorimage_rankBg.SpriteName = "TY_img_kuang"
        if newindex == 0 then
            tb.aortext_rankNum.text = _G.LangUtil.GetLangPackValue(90022900040)
        elseif newindex > 3 then
            tb.aortext_rankNum.text = newindex
        end
    end
    local data = {}
    tb.aortext_name.text = PlayerModel:GetName()
    data.style = PlayerModel:GetRoleStyle()
    data.frame = PlayerModel:GetCurFrame()
    data.lv = PlayerModel:GetLevel()
    data.title = PlayerModel:GetTitle()
    data.uid = PlayerModel:GetPlayerUid()
    self:ShowTitle(tb.aorrawimage_Title, data.title)
    tb.aorrawimage_Title:SetNativeSize()
    UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 1, true, true, true)
    if self.playerRank.index <= 0 then
        if hellModel.infoData.last_rank and (not hellModel.infoData.is_get_award or hellModel.infoData.is_get_award == 0) then
            tb.aortext_level.text = _G.GetLangPackValue(90026000007) ..
                    require "HellGuardModel":GetInstance().infoData.last_sid
            tb.aortext_num.text = require "HellGuardModel":GetInstance().infoData.last_kill_num
        else
            tb.aortext_level.text = _G.GetLangPackValue(90026000007) ..
                    require "HellGuardModel":GetInstance().infoData.role_fight_sid
            tb.aortext_num.text = require "HellGuardModel":GetInstance().infoData.role_kill_num
        end
    else
        tb.aortext_level.text = _G.GetLangPackValue(90026000007) .. self.playerRank.values[1]
        tb.aortext_num.text = self.playerRank.values[2]
    end
    --tb.aortext_name:SetAnchorPosition(-102, icon and -20 or 0)

    if tb.data then
        self.rewardSelf = tb.data.rewards
        self:ShowAward(tb, tb.obj_item, tb.data.rewards, true)
    else
        self:ShowAward(tb, tb.obj_item, {}, true)
    end
    --self.go_table.obj_Rank:SetActiveE(0)
    self:InitToggle()
    if self.go_table.toggle_zoneRank:GetActiveSelf() == 1 then
        self.go_table.toggle_zoneRank.isOn = true
    else
        self.go_table.toggle_rank.isOn = true
    end
end

