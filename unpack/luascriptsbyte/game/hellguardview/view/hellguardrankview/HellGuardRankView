                            self:InitPlayer(self.ZoneRank)
                            self:InitTop3(self.ZoneRank)
                        end
                    )
                else
                    self.rankDatas = {}
                    self.ZoneRank.scrollloopvectical_rankList:InitItemData(3, _G.handler(self, self.RefreshRank))
                    self:InitPlayer(self.ZoneRank)
                    self:InitTop3(self.ZoneRank)
