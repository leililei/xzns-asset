    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local data = tb.data.rewards[newIndex]
    local item = list[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 73, obj)
        list[instanceID] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
end

function HellGuardRankView:ShowTitle(obj, cfg)
    obj:LoadImage(cfg.icon, function()
        if cfg.type_title == 2 then
            _G.UIUtils.LoadEffectByPath(cfg.title, obj)
        end
    end)
end

---按钮点击事件在这里派发
function HellGuardRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return HellGuardRankView
