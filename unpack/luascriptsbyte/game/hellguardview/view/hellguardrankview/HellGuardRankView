    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, not isOn)
    if not self.ZoneRank then
        self.ZoneRank = _G.GetAutoGoTable(self.go_table.obj_ZoneRank)
        self.rankList = {}
        self.rewardList_Rank = {}
        require "ZoneRankModel":GetInstance():GetZoneSelfRankInfo(
            _G.ZoneRankType.HellGuard,
            nil,
            function(msg)
                self.playerInfo = msg.index_info or { dan = 0, index = 0 }
                self.selectDan = self.playerInfo.dan == 0 and 1 or self.playerInfo.dan
                self.selectZone = msg.index_info and msg.index_info.zone_id or -1
                if self.selectZone >= 0 then
                    require "ZoneRankModel":GetInstance():GetZoneRankInfo(
                        _G.ZoneRankType.HellGuard,
                        1,
                        self.selectZone,
                        nil,
                        self.selectDan,
                        function(msg2)
