function HellGuardTaskView:RefreshView()
    self.taskDatas = require "HellGuardModel":GetInstance():GetTaskDatas()
    self.taskData = self.taskDatas[self.type]
    if self.go_table.obj_Rank:GetActiveSelf() == 1 then
        self:RefresRank()
    else
        self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
    end
    if not _G.IsNil(require "HellGuardModel":GetInstance().infoData.last_rank) then
        require "HellGuardModel":GetInstance():GetPlayerRank(
            function()
                self.playerRank = require "HellGuardModel":GetInstance().playerRank
            end
        )
    end
    self:ShowGetAllBtn()
    self:RefreshRedPoint()
end

---刷新红点
function HellGuardTaskView:RefreshRedPoint(id)
    if id then
        if id == 3 then
            _G.GameUtil.SetActiveByCondition(
                self.redTogggle[id].obj_redpoint,
                require "HellGuardModel":GetInstance().infoData.is_get_award == 0
            )
        else
            _G.GameUtil.SetActiveByCondition(
                self.redTogggle[id].obj_redpoint,
                require "HellGuardModel":GetInstance():CheckHaveGetTask(id)
            )
        end
    else
        for k, v in pairs(self.redTogggle) do
            if k == 3 then
                _G.GameUtil.SetActiveByCondition(
                    v.obj_redpoint,
                    require "HellGuardModel":GetInstance().infoData.is_get_award == 0
                )
            else
                _G.GameUtil.SetActiveByCondition(
                    v.obj_redpoint,
                    require "HellGuardModel":GetInstance():CheckHaveGetTask(k)
                )
            end
        end
    end
end

---获取所有奖励
function HellGuardTaskView:GetAll()
    local tb = {}
    for _, v in pairs(self.taskData) do
        if v.state == _G.TaskEnum.ETaskState.Submited then
            _G.table.insert(tb, v.sid)
        end
    end
    if _G.table.isEmptyOrNil(tb) then
        return
    end
    require "HellGuardModel":GetInstance():FinishTask(
        tb,
        function(data)
            require "CommonTipManager".OpenCommonAwardView(data)
            self:SortTask()
            self.go_table.scrollloopvectical_taskList:UpdateAllItem()
            self:ShowGetAllBtn()
            self:RefreshRedPoint(self.type)
        end
    )
end

---按钮点击事件在这里派发
function HellGuardTaskView:OnClickBtn(go, isOn)
    if self.isinited == nil then
        self.isinited = false
    elseif self.isinited == false then
        self.isinited = true
    end
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.toggle_daily then
        _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        _G.GameUtil.SetActiveByCondition(self.go_table.toggle_daily:GetChildE(2), isOn)
        if isOn then
            self:ChangeType(TaskType.Daily)
        end
    elseif go == self.go_table.toggle_main then
        _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
        _G.GameUtil.SetActiveByCondition(self.go_table.toggle_main:GetChildE(2), isOn)
        if isOn then
            self:ChangeType(TaskType.Main)
        end
    elseif go == self.go_table.aorbtn_getAll then
        self:GetAll()
    --elseif go == self.go_table.toggle_rank then
    --    _G.AudioManager.PlayAudioByAudioCfgID(_G.AudioClipTypeEnum.clickAuido)
    --    _G.GameUtil.SetActiveByCondition(self.go_table.toggle_rank:GetChildE(2), isOn)
    --    self:ShowRank(isOn)
    elseif go == self.Rank.aorbtn_get then

        require "HellGuardModel":GetInstance():GetLastRankAwarwd(
            function(msg)
                require "CommonTipManager".OpenCommonAwardView(msg)
                self:ShowRank(true)
                self:RefreshRedPoint()
            end
        )
    elseif go == self.Rank.aorbtn_box then
        _G.PopWindowManager:GetInstance():ShowAllTips(400102)
    end
end

function HellGuardTaskView:ShowRank(isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Task, not isOn)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Rank, isOn)
    if not isOn then
        return
    end
    if not self.Rank then
        self.Rank = _G.GetAutoGoTable(self.go_table.obj_Rank, _G.handler(self, self.OnClickBtn))
        self.rankDatas =
            _G.table.chooseToArray(
            _G.ConfigManager.system_rank_cfg,
            function(k)
                return k > 10000 and k < 20000
            end
        )
        _G.SortList(
            self.rankDatas,
            function(a)
                return -a.id
            end
        )
        self.Rank.scrollloopvectical_rankList:InitItemData(#self.rankDatas, _G.handler(self, self.ReFreshRank))
    end
    self:RefresRank()
end

function HellGuardTaskView:RefresRank()
    local isLast = require "HellGuardModel":GetInstance().infoData.is_get_award == 0
    _G.GameUtil.SetActiveByCondition(self.Rank.obj_last, isLast)
    _G.GameUtil.SetActiveByCondition(self.Rank.obj_now, not isLast)
    if isLast then
        if _G.IsNil(require "HellGuardModel":GetInstance().infoData.last_rank) then
            self.Rank.aortext_lastIndex.text = GetLangPackValue(90022900040)
            self.Rank.aortext_lastKill.text = GetLangPackValue(90022500411)
        else
            self.Rank.aortext_lastIndex.text = require "HellGuardModel":GetInstance().infoData.last_rank
            self.Rank.aortext_lastKill.text = require "HellGuardModel":GetInstance().infoData.last_kill_num
        end
    else
        if not self.playerRank or self.playerRank.index <= 0 then
            self.Rank.aortext_nowIndex.text = GetLangPackValue(90022900040)
            self.Rank.aortext_nowKill.text =
                require "HellGuardModel":GetInstance().infoData.role_kill_num <= 0 and GetLangPackValue(90022500411) or
                require "HellGuardModel":GetInstance().infoData.role_kill_num
        else
            self.Rank.aortext_nowIndex.text = self.playerRank.index
            self.Rank.aortext_nowKill.text = self.playerRank.values[2]
        end
    end
end

function HellGuardTaskView:ReFreshRank(index, obj)
    index = index + 1
    local instanceId = obj:GetInstanceIDE()
    local tb = self.rankItems[instanceId]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.rankItems[instanceId] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_AwardList:InitItemData(0, _G._G.handlerbind(self, self.RefreshAward2, tb))
    end
    ---@type system_rank_cfg
    local cfg = self.rankDatas[index]
    _G.GameUtil.SetActiveByCondition(tb.aorimage_rankBg, index <= 3)
    _G.GameUtil.SetActiveByCondition(tb.obj_rankBg2, index > 3)
    tb.cfg = cfg
    if index <= 3 then
        tb.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. index
        tb.aortext_rankNum.text = ""
    elseif cfg.min_rank == cfg.max_rank then
        tb.aortext_rankNum.text = index
    else
        tb.aortext_rankNum.text = _G.string.format("%s~%s", cfg.min_rank, cfg.max_rank)
    end
    local count = #cfg.rewards
    tb.scrollloophorizontal_AwardList:UpdateScrollRectWeight(count * 73 + (count - 1) * 6 + 20)
    tb.scrollloophorizontal_AwardList:UpdateCount(count)
end

function HellGuardTaskView:RefreshAward2(index, obj, tb)
    local instanceID = obj:GetInstanceIDE()
    local item = tb.awardList[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73)
        tb.awardList[instanceID] = item
    end
    item:ShowWithID(tb.cfg.rewards[index + 1])
end

function HellGuardTaskView:ShowAward(tb, obj, award, parent)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]))
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.list[i].gameObject, false)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 73, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data))
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        end
    end
end

return HellGuardTaskView
