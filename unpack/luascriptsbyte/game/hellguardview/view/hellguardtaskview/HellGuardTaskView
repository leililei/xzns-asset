local HellGuardTaskView = _G.BaseClass("HellGuardTaskView", _G.UIBaseView)
--_G.HellGuardTaskView = HellGuardTaskView
local TaskType = {
    Daily = 1,
    Main = 2
}
local GetLangPackValue = _G.GetLangPackValue
function HellGuardTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function HellGuardTaskView:OnCreate()
    self.taskList = {}
    self.rankItems = {}
    self.redTogggle = {
        [TaskType.Daily] = _G.GetAutoGoTable(self.go_table.toggle_daily),
        [TaskType.Main] = _G.GetAutoGoTable(self.go_table.toggle_main),
        [3] = _G.GetAutoGoTable(self.go_table.toggle_rank)
    }
    self.taskDatas = require "HellGuardModel":GetInstance():GetTaskDatas()
    self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTask))
    self:AddListener(_G.eHellGuard.RefreshModel, self.RefreshView)
    self.go_table.toggle_daily.isOn = true
    require "HellGuardModel":GetInstance():GetPlayerRank(
        function()
            self.playerRank = require "HellGuardModel":GetInstance().playerRank
        end
    )
    self:RefreshRedPoint()
end

function HellGuardTaskView:SortTask()
    require "HellGuardModel":GetInstance():SortTask()
end

function HellGuardTaskView:ChangeType(type)
    if self.type ~= type then
        self.type = type
        self.taskData = self.taskDatas[self.type]
        self.go_table.scrollloopvectical_taskList:UpdateCount(#self.taskData)
        --self:ShowGetAllBtn()
    end
end

function HellGuardTaskView:ShowGetAllBtn()
    local isHave = false
    for _, v in pairs(self.taskData) do
        if v.state == _G.TaskEnum.ETaskState.Submited then
            isHave = true
            break
        end
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_getAll, isHave)
end

---刷新奖励
function HellGuardTaskView:RefreshTask(index, obj)
    local id = obj:GetInstanceIDE()
    local tb = self.taskList[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickTask))
        self.taskList[id] = tb
        tb.awardList = {}
        tb.scrollloophorizontal_awardList:InitItemData(0, _G.handlerbind(self, self.RefreshAward, tb))
    end
    ---@type HellGuardTaskData
    local data = self.taskData[index + 1]
    tb.index = index + 1
    tb.aortext_name.text = GetLangPackValue(data.cfg.desc)
    if data.state == _G.TaskEnum.ETaskState.Submited or data.state == _G.TaskEnum.ETaskState.Completed then
        tb.slider_progress.value = 1
        tb.aortext_Slider.text = data.cfg.count .. "/" .. data.cfg.count
    else
        tb.slider_progress.value = data.curValue / data.cfg.count
        tb.aortext_Slider.text = data.curValue .. "/" .. data.cfg.count
    end
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_get, data.state == _G.TaskEnum.ETaskState.Submited)
    _G.GameUtil.SetActiveByCondition(tb.aorbtn_unGet, data.state == _G.TaskEnum.ETaskState.Claimed)
    _G.GameUtil.SetActiveByCondition(tb.obj_complete, data.state == _G.TaskEnum.ETaskState.Completed)
    local count = #data.cfg.reward
    tb.scrollloophorizontal_awardList:UpdateScrollRectWeight(count <= 1 and 94 or 168)
    tb.scrollloophorizontal_awardList:UpdateCount(count)
    if not tb.ani then
        tb.ani = tb.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    end
    if not self.isinited then
        _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        tb.timer = _G.TimerManager:GetInstance():GetTimer(index * 2, self.ShowTaskObj, self, true, true, true, tb)
        tb.timer:Start()
    else
        tb.ani.enabled = false
    end
end

function HellGuardTaskView:ShowTaskObj(tb)
    if tb then
        tb.timer:Stop()
        tb.timer = nil
    end
    if self:IsNil() then
        return
    end

    _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
end
---显示奖励
---@param tb  HellGuardTaskView._obj_task_GoTable
function HellGuardTaskView:RefreshAward(index, obj, tb)
    local id = obj:GetInstanceIDE()
    ---@type BaseAwardNewItem
    local item = tb.awardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 74)
        tb.awardList[id] = item
    end
    local taskData = self.taskData[tb.index]
    local awardData = taskData.cfg.reward[index + 1]
    local data = _G.StorageManager:GetInstance():GetItemDataClassByCfg(awardData)
    item:Show(data)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_gou, taskData.state == _G.TaskEnum.ETaskState.Completed)
end

