local EmbattleController = require "EmbattleController"
---@class HellGuardEmbattleView : UIBaseView	中文描述
---@field public go_table HellGuardEmbattleView_GoTable GoTable
local HellGuardEmbattleView = _G.BaseClass("HellGuardEmbattleView", _G.UIBaseView)

function HellGuardEmbattleView:Awake()
    self.Anim = self.go_table.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
end

---界面的入口函数
function HellGuardEmbattleView:OnCreate(exitCall, battleCall, autofight)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall
    self.autoFight = autofight
    self.btnClick = false
    self:OpenEmbattleView()
    self:InitView()
    self:AddListener(_G.eBattleState.RecordStart, self.Hide)
    self:AddListener(_G.eBattleState.RecordEnd, self.Show)
end

function HellGuardEmbattleView:OnDestroy()
    self.maxsid = nil
    self.onExitCall = nil
    self.onBattleCall = nil
end

function HellGuardEmbattleView:InitView()
    self.go_table.aortext_Difficulty.text =
        _G.LangUtil.GetLangPackValue(90026000007) .. require "HellGuardModel":GetInstance():GetCuDifficulty()
end

function HellGuardEmbattleView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    require "EmbattleController":GetInstance():OpenEmbattle(
        _G.EmbattleType.HellGuard,
        _G.EmbattleSaveType.server,
        true,
        _G.EmbattleControllerItemType.hellGuard,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        require "HellGuardModel":GetInstance().infoData.cfg.monster_group
    )
end

function HellGuardEmbattleView:OnExitCall()
    require "HellGuardModel":GetInstance():ExitFitght()
    self:Close()
end

function HellGuardEmbattleView:OnBattleCall()
    require "HellGuardModel":GetInstance():Fight()
    self:Close()
end

function HellGuardEmbattleView:AutoNextFightEnter()
    require "EmbattleController":GetInstance():OnEmbattleBattle()
    self:Close()
end

---监听界面打开
---@param name string 界面名称
function HellGuardEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        embattleView.transform:SetParentE(self.go_table.trans_view)
        embattleView:SetInitDoneCall(
            function()
                if self.Anim then
                    self.Anim:Play("a_AfkEmbattleView_open_1")
                end
                self.startBattleBtn = embattleView.go_table.aorbtn_battle
            end
        )
        ---ZHJ-19222【灵域守卫】布阵内错误的显示了一个敌方等级标识
        embattleView:SetInitGuardTitleCall()
        self.embattleView = embattleView
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.HellGuardView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    end
end

function HellGuardEmbattleView:ClickStartBattleBtn()
    if (self.startBattleBtn ~= nil) then
        self.startBattleBtn.onClick:Invoke()
        self.btnClick = true
    else
        _G.DelayDo(
            1,
            function()
                if (self.btnClick == false) then
                    self:ClickStartBattleBtn()
                end
            end)
    end
end

return HellGuardEmbattleView
