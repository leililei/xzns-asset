local base = require "BaseGameNet"
---@class HellGuardNet : BaseGameNet	通信协议
local HellGuardNet = _G.BaseClass("HellGuardNet", base)

---@return HellGuardNet HellGuardNet
function HellGuardNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function HellGuardNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_guard_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---战斗
function HellGuardNet:Fight(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guard_fight
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---完成任务
function HellGuardNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_guard_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---获取排行榜数据
function HellGuardNet:GetRank(callback)
    local pbData = {page = 1}
    local item = _G.ConfigManager.net_map.game_rank_guard
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end

---获取玩家在排行榜上的名次
function HellGuardNet:GetPlayerRank(callback)
    local pbData = {type = 40}
    local item = _G.ConfigManager.net_map.game_rank_get_rank_num
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end
---获取排行奖励
function HellGuardNet:GetLastRankAwarwd(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_gaurd_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function HellGuardNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type HellGuardNet
_G.HellGuardNet = HellGuardNet
return HellGuardNet
