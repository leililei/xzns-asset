---@class SpiritualGiftView:UIBaseView  主题礼包
---@field public go_table SpiritualGiftView_GoTable GoTable
---@field RoleList activity_theme.i_gift_bag 当前主题的角色信息，唯一不变;新增适配称号和光环奖励：ZHJ-32330【客户端】主题活动&限时招募礼包-界面排版调整
---@field GiftList activity_theme.i_gift_bag[] 当前礼包信息表
local SpiritualGiftView = _G.BaseClass("SpiritualGiftView", _G.UIBaseView)
---@type SpiritualGiftModel
local SpiritualGiftModel
local GetLangPackValue = _G.LangUtil.GetLangPackValue
local StoreCfg = _G.ConfigManager.store_gear_cfg
local tonumber = _G.tonumber

function SpiritualGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.GiftList = {}
    self.RoleList = {}
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
    self.Anim = self.go_table.transform:GetComponentE(typeof(CS.UnityEngine.Animator))
    self.curAward = nil
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面入口
function SpiritualGiftView:OnCreate()
    SpiritualGiftModel = require "SpiritualGiftModel":GetInstance()
    self:InitView()
end

---析构函数
function SpiritualGiftView:Dispose()
    self.Anim = nil
end

---初始化界面
function SpiritualGiftView:InitView()
    --初始化当前礼包信息列表
    self.GiftList = SpiritualGiftModel:GetCurGiftList()
    self.RoleList = SpiritualGiftModel.RoleList
    --背景特效
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_SpiritualGiftView_bg, self.go_table.trans_efbg)
    local pos = SpiritualGiftModel.RolePos
    if pos and pos ~= "" then
        self.go_table.obj_role:SetActiveE(1)
        self.go_table.obj_title:SetActiveE(0)
        self:ShowNewRoleUI()
    else
        self.go_table.obj_role:SetActiveE(0)
        self.go_table.obj_title:SetActiveE(1)
        self:ShowTitleUI()
    end
    self:BaseText()
    self.go_table.scrollloopvectical_itemlist:InitItemData(#self.GiftList, _G.handler(self, self.RefreshList))
    if self.GiftList ~= nil and #self.GiftList > 4 then
        self.go_table.scrollloopvectical_itemlist:DetectingSlippage(_G.handler(self, self.onValueChanged))
    end

    self:LoadTitleFont()
end

function SpiritualGiftView:FinishAnim()
    if self.Anim then
        self.Anim:Play("lihui_loop")
    end
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.OpenAnimEnd, self.FinishAnim, self)
end

---滑动条显示
function SpiritualGiftView:onValueChanged(y)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_jiantou, y <= 0)
end

---称号展示(从奖励数据中读取)
function SpiritualGiftView:ShowTitleUI()
    local titleId
    local haloId
    for i = 1, #self.RoleList.award do
        local id = self.RoleList.award[i].sid
        local itemCfg = _G.ConfigManager.item_cfg[id]
        if itemCfg then
            if itemCfg.UseType == _G.ItemUseType.GetTitle then
                titleId = tonumber(itemCfg.UseParameter[1][1])
                break
            elseif itemCfg.UseType == _G.ItemUseType.GetHalo then
                haloId = tonumber(itemCfg.UseParameter[1][1])
                break
            end
        end
    end
    if titleId then
        local titleCfg = _G.ConfigManager.player_title_effect_cfg[titleId]
        self.go_table.aortext_titlename.text = _G.GetLangPackValue(titleCfg.name)
        if titleCfg.type_title ~= 2 then
            self.go_table.aorrawimage_titlenode:LoadImage(titleCfg.title)
        else
            self.go_table.aorrawimage_titlenode.color = _G.Color.New(1, 1, 1, 0)
            _G.UIUtils.LoadEffectTitleOrFrame(
                titleCfg.title,
                self.go_table.aorrawimage_titlenode,
                function(item)
                    if self:IsNil() then
                        _G.DestroyObject(item)
                        return
                    end
                    item:SetLocalScale(1, 1, 1)
                end
            )
        end
    elseif haloId then
        local haloCfg = _G.ConfigManager.player_halo_effect_cfg[haloId]
        self.go_table.aortext_titlename.text = _G.GetLangPackValue(haloCfg.name)
        self.go_table.aorrawimage_titlenode:LoadImage(haloCfg.icon)
    end
    local curList = self.RoleList

    if not self.titleAwardItemList then
        ---@type UnityEngine.GameObject
        self.titleAwardItemList = {}
    end
    for i = 1, #curList.award do
        if not self.titleAwardItemList[i] then
            self.titleAwardItemList[i] =
                _G.InstantiateObject(self.go_table.obj_title_award_item, self.go_table.obj_title_awardlist)
        end
        local giftItem = self.titleAwardItemList[i]
        if not curList.award[i] then
            giftItem:SetActiveE(0)
        else
            local icon = {curList.award[i].sid, curList.award[i].num}
            local giftTb = _G.GetAutoGoTable(giftItem, _G.handlerbind(self, i))
            giftItem:SetActiveE(1)
            if not giftTb.LoadTran then
                giftTb.LoadTran = 1
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    icon,
                    giftTb.obj_root,
                    function(tran)
                        tran.gameObject:SetLocalScaleXYZ(1)
                        _G.GameUtil.SetActiveByCondition(giftTb.obj_gou, false)
                        tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        giftTb.LoadTran = tran
                    end
                )
            else
                if not _G.IsNumber(giftTb.LoadTran) then
                    local tran = giftTb.LoadTran
                    local newdata = _G.StorageManager:GetInstance():GetItemDataClassByCfg(icon)
                    tran:UpdateData(tran.gameObject, newdata)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    _G.GameUtil.SetActiveByCondition(giftTb.obj_gou, false)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        end
    end
    for i = #curList.award + 1, #self.titleAwardItemList do
        if self.titleAwardItemList[i] then
            self.titleAwardItemList[i]:SetActiveE(0)
        end
    end
end

---角色立绘信息(从GM数据中读取)
function SpiritualGiftView:ShowNewRoleUI()
    local pos = SpiritualGiftModel.RolePos
    local imageList = _G.string.split(pos, "|")
    if tonumber(imageList[1]) == 1 then
        self:ShowRoleUI(imageList[2])
    elseif tonumber(imageList[1]) == 3 then
        local array = _G.string.split(imageList[2], "#")
        self.petSid = tonumber(array[1])
        local cfg = _G.ConfigManager.pet_cfg[self.petSid]
        _G.UIUtils.LoadEffectByPath(
            cfg.spine_1,
            self.go_table.obj_spine,
            function(obj)
                if _G.IsNil(self.go_table.obj_spine) then
                   return
                end
                self.go_table.obj_spine:SetActiveE(1)
                obj:SetLocalPosition(tonumber(array[2] or 0), tonumber(array[3] or 0), tonumber(array[4] or 0))
                obj:SetLocalScaleXYZ(tonumber(array[5] or 1))
            end
        )
        self.go_table.aorbtn_pet:SetAnchorPosition(0, tonumber(array[6] or 0))
    elseif tonumber(imageList[1]) == 5 then
        local array = _G.string.split(imageList[2], "#")
        _G.UIUtils.LoadEffectByPath(
            array[1],
            self.go_table.obj_spine,
            function(obj)
                if _G.IsNil(self.go_table.obj_spine) then
                   return
                end
                self.go_table.obj_spine:SetActiveE(1)
                obj:SetLocalPosition(tonumber(array[2] or 0), tonumber(array[3] or 0), tonumber(array[4] or 0))
                obj:SetLocalScaleXYZ(tonumber(array[5] or 1))
            end
        )
    else
        self.go_table.obj_cardName:SetActiveE(0)
        for i = 2, #imageList do
            local data = _G.string.split(imageList[i], "#")
            local obj = _G.InstantiateObject(self.go_table.obj_roleItem, self.go_table.obj_roles)
            local tb = _G.GetAutoGoTable(obj)
            tb.aorrawimage_role:LoadImage(
                data[1],
                function(tran)
                    tran:SetNativeSize()
                    tb.gameObject:SetLocalPosition(
                        tonumber(data[2]) or 0,
                        tonumber(data[3]) or 0,
                        tonumber(data[4]) or 0
                    )
                    tb.gameObject:SetLocalScaleXYZ(tonumber(data[5]))
                    tb.gameObject:SetActiveE(1)
                end
            )
        end
    end
end
---加载标题名称(艺术字)
function SpiritualGiftView:LoadTitleFont()
    local path = SpiritualGiftModel.TitleFont

    local isEmpty = _G.string.IsNullOrEmpty(path)
    self.go_table.aorimage_txt:SetActiveE(isEmpty and 1 or 0)
    self.go_table.aorrawimage_txt:SetActiveE(isEmpty and 0 or 1)
    if isEmpty then
        return
    end

    self.go_table.aorrawimage_txt:LoadImage(
        path,
        function(image)
            if _G.IsNil(self.go_table.aorrawimage_txt) then
                return
            end
            image:SetNativeSize()
        end
    )
end

