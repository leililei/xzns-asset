---初始化语言配置信息
function SpiritualGiftView:BaseText()
    --角色名字
    if SpiritualGiftModel.rewardType == 3 then
        ---灵兽spine
        if not self.petSid then
            local imageList = _G.string.split(SpiritualGiftModel.RolePos, "|")
            local array = _G.string.split(imageList[2], "#")
            self.petSid = tonumber(array[1])
        end
        local cfg = _G.ConfigManager.pet_cfg[self.petSid]
        self.go_table.aorrawimage_petName:LoadImage(
            cfg.image_2,
            function(tran)
                if _G.IsNil(self.go_table.aorrawimage_petName) then
                    return 
                 end
                tran:SetNativeSize()
            end
        )
        self.go_table.aorrawimage_petName:SetActiveE(1)
    else
        local itemData = SpiritualGiftModel.itemData
        local name = GetLangPackValue(itemData.Cfg.Name or itemData.Cfg.name)
        if SpiritualGiftModel.itemType == _G.StorageType.Card then
            self.go_table.aortext_rolename.text = name
        elseif SpiritualGiftModel.itemType == _G.StorageType.Artifact then
            self.go_table.aorrawimage_artifactName:LoadImage(
                itemData.Cfg.image_2,
                function(tran)
                    tran:SetNativeSize()
                end
            )
            self.go_table.aorrawimage_artifactName:SetActiveE(1)
        elseif SpiritualGiftModel.itemType == _G.StorageType.Spiritual then
            self.go_table.aortext_spiritualName.text = name
            self.go_table.aortext_spiritualName:SetActiveE(1)
        end
    end
    --角色原价钱和打折后显示
    local ori_price = _G.GameUtil.FormatNum(self.RoleList.ori_price.v / 100)
    local price = _G.GameUtil.FormatNum(self.RoleList.price.v / 100)
    local discount = self.RoleList.discount
    local limit_times = self.RoleList.limit_times
    self.go_table.aortext_box1.text = ori_price
    if not discount or discount == 0 then
        self.go_table.aorimage_title_discount:SetActiveE(0)
        self.go_table.aorimage_discount:SetActiveE(0)
    end
    self.go_table.aortext_discount.text = discount
    self.go_table.aortext_title_discount.text = discount
    self.go_table.aortext_box2.text = GetLangPackValue(90028500025, discount)
    self.go_table.aortext_num.text = self.RoleList.award[2].num
    --local gearCfg = StoreCfg[self.RoleList.price.v]
    local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(self.RoleList.price)
    if info ~= nil then
        self.go_table.aortext_purchasePrice.text = info.formattedPrice
        self.go_table.aortext_title_purchasePrice.text = info.formattedPrice
    else
        if _G.AppSetting.IsOverseas then
            self.go_table.aortext_purchasePrice.text = GetLangPackValue(90000010807) .. price
            self.go_table.aortext_title_purchasePrice.text = GetLangPackValue(90000010807) .. price
        else
            self.go_table.aortext_purchasePrice.text = GetLangPackValue(90000010819, price)
            self.go_table.aortext_title_purchasePrice.text = GetLangPackValue(90000010819, price)
        end
    end
    if limit_times ~= 0 then
        self.go_table.aorbtn_purchase:SetGray(false)
        self.go_table.aorbtn_title_purchase:SetGray(false)
    else
        self.go_table.aorbtn_purchase:SetGray(true)
        self.go_table.aorbtn_title_purchase:SetGray(true)
        self.go_table.aortext_purchasePrice.text = GetLangPackValue(90023030201)
        self.go_table.aortext_title_purchasePrice.text = GetLangPackValue(90023030201)
    end
end
---循环列表奖励展示
---@param index number 下标
---@param obj obj item
function SpiritualGiftView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    local x = index + 1
    local curList = self.GiftList[x]
    local itemTb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickBtn, x))
    local name = "obj_Root"
    local price = _G.GameUtil.FormatNum(curList.price.v / 100)
    itemTb.aorrawimage_Icon:SetActiveE(0)
    if curList.price.k ~= 0 then
        itemTb.aortext_price.text = curList.price.v
        local data = _G.StorageManager:GetInstance():GetStorageItemData(curList.price.k)
        itemTb.aorrawimage_Icon:LoadImage(data.Icon)
        itemTb.aorrawimage_Icon:SetActiveE(1)
    elseif price ~= 0 then
        local info = _G.LoginManager:GetInstance():GetGooglePayInfoByPrice(curList.price.v)
        if info ~= nil then
            itemTb.aortext_price.text = info.formattedPrice
        else
            if _G.AppSetting.IsOverseas then
                itemTb.aortext_price.text = GetLangPackValue(90000010807) .. price
            else
                itemTb.aortext_price.text = GetLangPackValue(90000010819, price)
            end
        end
    else
        itemTb.aortext_price.text = GetLangPackValue(90028500012)
    end
    if curList.limit_times > self.limitTimesCond then
        itemTb.aortext_limit:SetActiveE(0)
    else
        itemTb.aortext_limit:SetActiveE(1)
        if curList.limit_times ~= 0 then
            itemTb.aorbtn_buy:SetActiveE(1)
            itemTb.aorimage_sellout:SetActiveE(0)
            itemTb.aortext_limit.text = GetLangPackValue(90028500011, curList.limit_times)
        else
            itemTb.aorbtn_buy:SetActiveE(0)
            itemTb.aorimage_sellout:SetActiveE(1)
            itemTb.aortext_limit.text = GetLangPackValue(90028500011, curList.limit_times)
        end
    end
    local num = #curList.award
    if num > 4 then
        num = 4
    end
    for i = 1, 4 do
        local giftItem = itemTb[name .. i]
        if not curList.award[i] then
            giftItem:SetActiveE(0)
        else
            local icon = {curList.award[i].sid, curList.award[i].num}
            local giftTb = _G.GetAutoGoTable(giftItem, _G.handlerbind(self, i))
            giftItem:SetActiveE(1)
            if giftTb.obj_root:GetChildCountE() > 0 then
                _G.UIUtils.RemoveChildren(giftTb.obj_root)
            end
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                icon,
                giftTb.obj_root,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    _G.GameUtil.SetActiveByCondition(giftTb.obj_gou, false)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    local grade, type = _G.StorageManager:GetInstance():GetItemGrade(icon[1])
                    if grade > 3 then
                        tran:ShowEffect(true)
                    end
                end
            )
        end
    end
end

---点击购买礼包
function SpiritualGiftView:ClickBtn(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_buy" then
        local curList = self.GiftList[index]
        local giftinfo = {price = 0, sid = 0, type = 1}
        local type = curList.price.k
        giftinfo.price = curList.price.v
        giftinfo.sid = curList.sid
        local datas = {}
        datas.award = {}
        datas.award.item = {}
        if curList.award then
            for key, value in pairs(curList.award) do
                local item1 = {
                    type = {
                        value.sid,
                        value.num
                    }
                }
                _G.table.insert(datas.award.item, item1)
            end
        end
        SpiritualGiftModel:SetReConnectAward(curList.award)
        if giftinfo.price ~= 0 then
            if type == 0 then
                SpiritualGiftModel:BuySpiritualGift(
                    giftinfo,
                    function()
                        self:RefreshView()
                    end,
                    datas.award.item
                )
            else
                SpiritualGiftModel:GetFreeGift(
                    giftinfo.sid,
                    function(data)
                        _G.StorageManager:GetInstance():ReceiveAwardData(data)
                        _G.StorageManager:GetInstance():ConsumeItem(type, 0, giftinfo.price)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, datas)
                        self:RefreshView()
                    end
                )
            end
        else
            --领取免费礼包
            SpiritualGiftModel:GetFreeGift(
                giftinfo.sid,
                function(data)
                    _G.StorageManager:GetInstance():ReceiveAwardData(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, datas)
                    self:RefreshView()
                end
            )
        end
    end
end

---购买后更新界面表现
function SpiritualGiftView:RefreshView()
    require("TreasureHuntingManager"):GetInstance():RefreshRedPoint()
    --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WeekendTurntableButton.id)
    self.GiftList = SpiritualGiftModel:GetCurGiftList()
    self.RoleList = SpiritualGiftModel.RoleList
    self:BaseText()
    self.go_table.scrollloopvectical_itemlist:UpdateCount(#self.GiftList)
end

---点击事件
function SpiritualGiftView:OnClickBtn(go)
    if nil == go then
        return
    end
    local name = go:GetName()
    if "@_aorbtn_Back" == name then
        self:Close()
    end
    if "@_aorbtn_check" == name then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
            self.RoleList.award[1].sid,
            function()
            end,
            true
        )
    elseif "@_aorbtn_artifactname" == name or name == "@_aorbtn_spiritual" then
        require("CommonTipManager"):GetInstance():OpenTip(
            self.go_table.aorbtn_artifactname.gameObject,
            self.RoleList.award[1].sid
        )
    elseif "@_aorbtn_purchase" == name or "@_aorbtn_title_purchase" == name then
        if self.RoleList.limit_times ~= 0 then
            local giftinfo = {sid = self.RoleList.sid, price = self.RoleList.price.v, type = 2}
            SpiritualGiftModel:SetReConnectAward(self.RoleList.award)
            SpiritualGiftModel:BuySpiritualGift(
                giftinfo,
                function()
                    self:RefreshView()
                end
            )
        else
            return
        end
    elseif "@_aorbtn_pet" == name then
        require("CommonTipManager"):GetInstance():OpenTip(
            self.go_table.aorbtn_artifactname.gameObject,
            self.petSid
        )
    end
end

return SpiritualGiftView
