local base = require "ThemeActivityBaseModel"
---@class SpiritualGiftModel : ThemeActivityBaseModel
---@field GetInstance fun():SpiritualGiftModel
---@field RoleList activity_theme.i_gift_bag
---@field AllGift activity_theme.i_gift_bag[]
local SpiritualGiftModel = _G.BaseClass("SpiritualGiftModel", base)
---@return SpiritualGiftModel SpiritualGiftModel
local SpiritualGiftNet = require "SpiritualGiftNet"
local ThemeActivityManager = require "ThemeActivityManager":GetInstance()
local cardData = _G.ConfigManager.card_cfg
---@return SpiritualGiftModel SpiritualGiftModel
function SpiritualGiftModel:GetInstance()
    return self.super.GetInstance(self)
end

function SpiritualGiftModel:__init()
    --GM配置的礼包信息
    self.AllGift = {}
    --已经购买的礼包信息
    self.GetList = {}
    ---主题活动角色奖励，唯一，仅此角色打折
    ---新增适配称号和光环奖励：ZHJ-32330【客户端】主题活动&限时招募礼包-界面排版调整
    self.RoleList = {}
end

---进入活动
function SpiritualGiftModel:EnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpiritualGiftView.Name)
end

---初始化数据
---@param msg activity_theme.i_store
function SpiritualGiftModel:InitData(msg)
    if msg ~= nil then
        self.info = msg
        self:InitGiftInfo(self.info)
    end
end

---初始化礼包信息
---@param data activity_theme.i_store
function SpiritualGiftModel:InitGiftInfo(data)
    if data ~= nil then
        --角色立绘偏移量
        self.RolePos = data.theme.pos
        self.AllGift = data.cfg_list
        ---标题文字路径(艺术字图片)
        ---@type string
        self.TitleFont = data.theme.page_pos and _G.string.split(data.theme.page_pos, "|")[2] or nil
        if data.buy_list ~= nil then
            self.GetList = data.buy_list
            --将已购买的数据从本地表中去除
            for k, get in pairs(self.GetList) do
                for i, all in pairs(self.AllGift) do
                    if get.sid == all.sid then
                        self.AllGift[i].limit_times = self.AllGift[i].limit_times - get.buy_times
                    end
                end
            end
        end
        --单独提取角色奖励信息
        local minId = self.AllGift[1].sid
        local minIndex = 1
        for i, v in pairs(self.AllGift) do
            if minId > v.sid then
                minId = v.sid
                minIndex = i
            end
            if v.discount ~= 0 then
                self.RoleList = v
                _G.table.remove(self.AllGift, i)
                break
            end
        end
        --当没有折扣商品时，称号和光环默认选id最小的一个
        if not self.RoleList then
            self.RoleList = self.AllGift[minIndex]
            _G.table.remove(self.AllGift, minIndex)
        end
        -- _G.SortList(self.RoleList.award,
        --     function(a)
        --         return -a.num
        --     end)
        if not _G.string.IsNullOrEmpty(self.RolePos) then
            local imageList = _G.string.split(self.RolePos, "|")
            ---灵兽类型，灵兽不进仓库，所以需要单独判断
            self.rewardType = _G.tonumber(imageList[1])
        end
        if self.rewardType ~= 3 then
            ---3是灵兽，灵兽不进仓库，所以也获取不到类型和数据
            self.itemType = _G.StorageManager:GetInstance():CheckSidType(self.RoleList.award[1].sid)
            self.itemData = _G.StorageManager:GetInstance():GetStorageItemData(self.RoleList.award[1].sid) 
        end
        --对礼包信息进行排序
        _G.SortList(
            self.AllGift,
            function(list)
                local res = list.limit_times > 0 and 1 or 0
                return res, -list.sid
            end
        )
        self:RefreshRedPoint()
        if self.callback and self.reAward then
            local data = {}
            data.award = {}
            data.award.item = {}
            local StorageManager = _G.StorageManager:GetInstance()
            for k, v in pairs(self.reAward) do
                data.award.item[k] = StorageManager:SimulationAward(v.sid, v.num)
            end
            if self.giftInfo.type == 2 then
                local data = cardData[self.reAward[1].sid]
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawResultRoleView.Name,data,nil,nil,true,true)
            end
            self.reAward = nil
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
            self.callback()
            self.callback = nil
            _G.Events:GetInstance():RemoveListener(
                _G.ConfigManager.net_map.store_cash.Cmd,
                self.OnMallCashListener,
                self
            )
        end
    end
end

---获取当前所有礼包信息表
---@return table 当前需要展示的礼包信息表
function SpiritualGiftModel:GetCurGiftList()
    return self.AllGift
end

---更新礼包信息,可购买数量-1
---@param number sid 购买礼包的sid
---@param number type 购买礼包的类型,1为普通礼包,2为角色礼包
function SpiritualGiftModel:UpdataGiftInfo(sid, type)
    if type == 1 then
        for key, value in pairs(self.AllGift) do
            if value.sid == sid then
                self.AllGift[key].limit_times = self.AllGift[key].limit_times - 1
                break
            end
        end
        --对礼包信息进行排序
        _G.SortList(
            self.AllGift,
            function(list)
                local res = list.limit_times > 0 and 1 or 0
                return res, -list.sid
            end
        )
    else
        self.RoleList.limit_times = self.RoleList.limit_times - 1
    end
end

---购买礼包
---@param table GiftInfo 购买礼包sid,price,礼包类型type(1为普通,2为角色)
function SpiritualGiftModel:BuySpiritualGift(GiftInfo, callback, award)
    --活动id
    local activityId = require "ThemeActivityManager":GetInstance():GetActivityID()
    self.callback = callback
    self.award = award or {}
    self.giftInfo = GiftInfo
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    require "MallManager":GetInstance():BuyActiveGift(GiftInfo.price, activityId, GiftInfo.sid)
    self.buy = true
end

function SpiritualGiftModel:SetCoin()
    if not self.award then
        return nil
    end
    if not self.coinSid then
        self.coinSid = require"ThemeActivityManager":GetInstance():GetCoinSid()
    end
    for key, value in pairs(self.award) do
        if value.type[1] == self.coinSid then
            local item = {
                type = {
                    value.type[1],
                    value.type[2]
                }
            }
            return item
        end
    end

    return nil
end

function SpiritualGiftModel:OnMallCashListener(data)
    if ThemeActivityManager:CheckThemeActivityIsOpen() then
        if self.giftInfo then
            self:UpdataGiftInfo(self.giftInfo.sid, self.giftInfo.type)
            if self.giftInfo.type == 2 and self.type == 0 then
                local data = cardData[self.reAward[1].sid]
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DrawResultRoleView.Name,data,nil,nil,true,true)
            end
            self.giftInfo = nil
        end
        if self.callback then
            self.callback()
            self.callback = nil
        end
        self.buy = false
        _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    end
end

---领取免费礼包
---@param number sid 免费奖励的id
function SpiritualGiftModel:GetFreeGift(sid, callback)
    local activityId = require "ThemeActivityManager":GetInstance():GetActivityID()
    require "SpiritualGiftNet":GetInstance():GetFreeAward(
        activityId,
        sid,
        function(data)
            if 1 == data.ack then
                self:UpdataGiftInfo(sid, 1)
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---用贷币购买礼包
function SpiritualGiftModel:BuyGiftByCurrency(sid, callback)
    local activityId = require "ThemeActivityManager":GetInstance():GetActivityID()
    require "SpiritualGiftNet":GetInstance():GetFreeAward(
        activityId,
        sid,
        function(data)
            if 1 == data.ack then
                self:UpdataGiftInfo(sid, 1)
                self:RefreshRedPoint()
                if callback then
                    callback(data)
                end
            end
        end
    )
end

---初始化红点树
function SpiritualGiftModel:InitRedTree()
    self.redTree = {{1, "RedPointThemoGift", {}}}
end

---检测红点
---@return boolean
function SpiritualGiftModel:CheckRedPoint()
    if not self.GetList or not require "ThemeActivityManager":GetInstance():CheckThemeActivityIsOpen() then
        return false
    end
    ---仅免费礼包显示红点
    for key, value in pairs(self.AllGift) do
        if value.price.v == 0 and value.limit_times == 1 then
            return true
        elseif value.limit_times == 0 then
            return false
        end
    end
end

---刷新红点
function SpiritualGiftModel:RefreshRedPoint()
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(self:GetRedPointId())
end

function SpiritualGiftModel:SetReConnectAward(data)
    self.reAward = data
end

return SpiritualGiftModel
