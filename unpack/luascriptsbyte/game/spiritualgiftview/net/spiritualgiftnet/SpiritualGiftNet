---@class SpiritualGiftNet : BaseGameNet
---@field GetInstance fun():SpiritualGiftNet
local SpiritualGiftNet = _G.BaseClass("SpiritualGiftNet", require "BaseGameNet")
local base = require "BaseGameNet"
---@return SpiritualGiftNet SpiritualGiftNet

function SpiritualGiftNet:GetInstance()
    return base.GetInstance(self)
end

---购买免费礼包
---@param id number 活动sid
---@param sid number 免费奖励的id
---@param callback function 完成回调
function SpiritualGiftNet:GetFreeAward(id, sid, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_award
    local pbData = {id = id, sid = sid}
    local port = base.Access(self, item, pbData, _G.handler(self, self.SuccessCall))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SpiritualGiftNet:SuccessCall(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SpiritualGiftNet
