---@class DragonChessView : UIBaseView    中文描述
---@field public go_table DragonChessView_GoTable GoTable
local DragonChessView = _G.BaseClass("DragonChessView", _G.UIBaseView)

---卡牌id
local cardId = 113020000

function DragonChessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function DragonChessView:OnEnable()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView)
end

function DragonChessView:OnDisable()
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView)
end

---界面的入口函数
function DragonChessView:OnCreate()
    self.model = require "DragonChessModel":GetInstance()
    if not self.model.activity then
        _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        self:Close()
        return
    end
    self.task_info = self.model.task_info
    self.taskDatas = self.model.taskDatas
    self.maxTaskNum = #self.taskDatas
    self.finish_task = self.model.finish_task
    self:RedreshButton()
    self:InitBossInfo()
    self:RefreshView()
    self:RefreshActivityTime()
end

function DragonChessView:RefreshActivityTime()
    self.endTime = self.model:GetEndTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime()
end

function DragonChessView:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime >= self.endTime then
        self:CloseView()
    else
        if self.go_table then
            if AppSetting.IsXzns then
                self.go_table.aortext_time.text = _G.GetLangPackValue(
                        90000010360,
                        _G.TimeUtil.TranslateSecondForStr(self.endTime - serverTime):AddColor("83e497")
                )
            else
                self.go_table.aortext_time.text = _G.GetLangPackValue(
                        90000010360,
                        _G.TimeUtil.TranslateSecondForStr(self.endTime - serverTime)
                )
            end
        end
    end
end

---boss信息
function DragonChessView:InitBossInfo()
    local cardCfg = _G.ConfigManager.card_cfg[cardId]
    local name = _G.ConfigManager.discrete_cfg[119005][1][1]
    local quIcon = require("CardInfoManager"):GetInstance():GetCardOrderZi(cardCfg.Order)
    UIUtils.SetUIModel(self.go_table.obj_bossName,self.go_table.aorimage_bg,self.go_table.obj_bossName2,self.go_table.aorimage_bg2,quIcon)
    UIUtils.SetUIModelText(self.go_table.aortext_name,self.go_table.aortext_name2,_G.GetLangPackValue(name))
end

---界面显示
function DragonChessView:RefreshView()
    if not self.itemListView then
        if AppSetting.IsXzns then
            self:RefreshRewardItem()
        else
            self.go_table.scrollloophorizontal_item:InitItemData(_G.Mathf.Min(3, self.maxTaskNum),
                    _G.handler(self, self.RefreshListItem))
            self.itemListView = self.go_table.scrollloophorizontal_item
        end
    else
        self.itemListView:UpdateAllItem()
    end
    local isUseChinese = _G.GameUtil.GetIsUseChinese()
    --ZHJH-9513 中文和英文的标题文本图片中文字与图片边缘的距离不同，不能自动适配，手动更改坐标
    if isUseChinese then
        self.go_table.obj_Name:SetLocalPosition(174, 12, 0)
    else
        self.go_table.obj_Name:SetLocalPosition(196, 12, 0)
    end
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        return true
    end
    if not self.spineInited then
        self.spineInited = true
        _G.UIUtils.LoadEffectByPath(
                "WX_Role/Animation_UI/Yilidan_02_UI/prf_Yilidan_02_UI_ui",
                self.go_table.trans_Spine,
                function(trans)
                    if AppSetting.IsXzns then
                        GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
                    else
                        self.sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                        -- spine动画结束事件注册
                        --self.sg.AnimationState:Complete("+", _G.handler(self, self.EffActionChange))
                        self.sg.AnimationState:ClearTracks()
                        self.sg.AnimationState:AddAnimation(0, "show", false, 0)
                        self.sg.AnimationState:AddAnimation(0, "idle", true, 0)
                        local boneEff = {
                            Point_tx001 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx001,
                            Point_tx002 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx002,
                            Point_tx004 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx004,
                            Point_tx005 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx005,
                            Point_tx006 = _G.ConfigManager.ui_effect_cfg.ef_shouchong_yilidan_Point_tx006
                        }
                        local spObj, bone
                        for name, effCfg in pairs(boneEff) do
                            spObj = _G.InstantiateObject(self.go_table.trans_Eff, trans)
                            bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
                            bone.skeletonGraphic = self.sg
                            bone.boneName = name
                            _G.UIUtils.LoadEffectByCfg(effCfg, spObj, check)
                        end
                    end
                end
        )
    end
end

function DragonChessView:RefreshListItem(index, obj)
    local data = self.taskDatas[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, data))
    tb.aortext_Name.text = _G.GetLangPackValue(data.Cfg.desc)
    ---任务进度
    if data.taskEnumType == _G.ActiveTaskEnum.ConditionEnum.Charge.TotalCharge then
        tb.aortext_Num.text = self.NumberToUnitStr_CardFightNum(_G.math.floor(data.i_task.target[1] / 100)) ..
                "/" .. self.NumberToUnitStr_CardFightNum(_G.math.floor(data.Cfg.count / 100))
    else
        tb.aortext_Num.text = self.NumberToUnitStr_CardFightNum(data.i_task.target[1]) ..
                "/" .. self.NumberToUnitStr_CardFightNum(data.Cfg.count)
    end
    local isFinishTask = require "DragonChessModel":GetInstance():GetFinishTask(data.id)
    local isGou = data.i_task.target[1] >= data.Cfg.count and isFinishTask
    _G.StorageManager:GetInstance():GetItemBaseView(
            data.Cfg.reward[1][1],
            data.Cfg.reward[1][2],
            tb.obj_Item,
            function(item)
                if self:IsNil() then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(1)
                _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                item:SetGou(isGou)
                if item.go_table.aorrawimage_Icon then
                    item.go_table.aorrawimage_Icon:SetGray(isGou)
                end
                if item.go_table.aorimage_Color then
                    item.go_table.aorimage_Color:SetGray(isGou)
                end
                item.gameObject:SetLocalPosition(0, 0, 0)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                if item.SetGradeNew then
                    item:SetGradeNew(false)
                end
            end,
            function(go)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data.Cfg.reward[1][1], nil, nil)
            end
    )
    tb.aorbtn_Lingqu:SetActiveE(not isFinishTask and 1 or 0)
    if not isFinishTask then
        if data.i_task.target[1] >= data.Cfg.count then
            tb.aortext_get.text = _G.GetLangPackValue(90023300029)
            tb.aortext_get.color = _G.ColorTools.FormatColorByString("8C2D14")
            tb.aorbtn_Lingqu:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_kuang_00"
        else
            if AppSetting.IsXzns then
                tb.aortext_get.text = _G.GetLangPackValue(90022200010):AddColor("50351e")
            else
                tb.aortext_get.text = _G.GetLangPackValue(90022200010)
            end
            tb.aortext_get.color = _G.ColorTools.FormatColorByString("EEC398")
            tb.aorbtn_Lingqu:SetActiveE(data.Cfg.link > 0 and 1 or 0)
            tb.aorbtn_NotReach:SetActiveE(data.Cfg.link > 0 and 0 or 1)
            tb.aorbtn_NotReach:SetGray(true)
            tb.aorbtn_NotReach:SetActiveE(0)
            tb.aorbtn_Lingqu:GetComponentE(_G.typeof(_G.CS.AorImage)).SpriteName = "ui_ty_kuang_01"
        end
    end
    tb.obj_got:SetActiveE(isFinishTask and 1 or 0)
end

function DragonChessView:OnClickItem(go, _, data)
    local name = go:GetName()
    if name == "@_aorbtn_Lingqu" then
        if data.i_task.target[1] < data.Cfg.count then
            if data.Cfg.link > 0 then
                _G.JumpManager:GetInstance():Jump(data.Cfg.link)
            end
            return
        end
        local pbData = {}
        pbData.finish_type = 2
        pbData.sid = data.i_task.sid
        require "DragonChessModel":GetInstance():ChessFinish(
                pbData,
                function(msg)
                    if msg.ack == 1 then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                        require "DragonChessModel":GetInstance():IsFinishTask(data.i_task.sid)
                        self:RefreshView()
                        self:RedreshButton()
                    end
                end
        )
    end
end

function DragonChessView:OnEnable()
end

---战斗力 数字计算
function DragonChessView.NumberToUnitStr_CardFightNum(num)
    -- 小数点规则
    -- 保留一位小数 四舍五入
    -- 10.56亿 算10.6亿
    --num = _G.GameUtil.FormatNum(num)
    local str = ""
    local len = _G.string.len(num)
    --个十百千万十百千亿
    if len > 8 then
        num = num / 1000000
        local t1, t2 = _G.math.modf(_G.tonumber(num))
        str = _G.LangUtil.GetLangPackValue(90023100005, t1)
    elseif len > 6 then
        num = num / 1000
        local t1, t2 = _G.math.modf(_G.tonumber(num))
        str = _G.LangUtil.GetLangPackValue(90023100004, t1)
    else
        str = _G.tostring(num)
    end
    return str
end

---领取按钮显示
function DragonChessView:RedreshButton()
    local finishTaskNum = _G.table.count(self.finish_task)
    if AppSetting.IsXzns then
        self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString("50351E")
    else
        self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString("8C2D14")
    end
    if require "DragonChessModel":GetInstance():IsAward() == 1 then
        -- self.go_table.aorimage_get:SetGray(true)
        self.go_table.aortext_Get.text = _G.GetLangPackValue(90023800053)
        self.go_table.obj_redpoint:SetActiveE(0)
    elseif finishTaskNum < self.maxTaskNum then
        -- self.go_table.aorimage_get:SetGray(true)
        -- self.go_table.aorimage_get.color = _G.ColorTools.FormatColorByString("A9A9A9")
        self.go_table.aortext_Get.text = _G.GetLangPackValue(90023300140)
        -- self.go_table.aortext_Get.color = _G.ColorTools.FormatColorByString("434343")
        self.go_table.obj_redpoint:SetActiveE(0)
    else
        -- self.go_table.aorimage_get:SetGray(false)
        -- self.go_table.aorimage_get.color = _G.ColorTools.FormatColorByString("FFFFFF")
        self.go_table.aortext_Get.text = _G.GetLangPackValue(90023300140)
        self.go_table.obj_redpoint:SetActiveE(1)
    end
    self.go_table.aortext_progress.text = _G.GetLangPackValue(90023800095, finishTaskNum, self.maxTaskNum)
end

function DragonChessView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function DragonChessView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Get then
        if _G.table.count(self.finish_task) < self.maxTaskNum then
            _G.PopWindowManager:GetInstance():ShowAllTips(860101)
            return
        elseif require "DragonChessModel":GetInstance():IsAward() == 1 then
            return
        end
        require "DragonChessModel":GetInstance():ChessAward(_G.handler(self, self.RedreshButton))
    elseif go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 85)
    elseif go == self.go_table.aorbtn_check or go == self.go_table.aorbtn_check2 then
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                cardId,
                nil,
                true
        )
    elseif go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:CloseView()
    end
end

---给已完成的任务创建特效（不保留）
function DragonChessView:ShowFinishTaskEF()
    local pos = {}

    --特效位置从左到右，task顺序从340120001到340120004
    for _, value in pairs(self.finish_task) do
        if (value ~= nil) then
            if (value == 340120001) then
                pos = { -270, -90, 0 }
            elseif (value == 340120002) then
                pos = { 0, 100, 0 }
            elseif (value == 340120003) then
                pos = { 170, 70, 0 }
            elseif (value == 340120004) then
                pos = { 250, -80, 0 }
            end
            if (pos ~= nil) then
                _G.UIUtils.LoadEffectByPath(
                        "UI/UI_effect/DragonChessView_effect/ef_DragonChessView_once",
                        self.go_table.gameObject,
                        nil,
                        nil,
                        1,
                        pos,
                        1,
                        1,
                        true
                )
            end
        end
    end
end

function DragonChessView:OnDestroy()
    if (self.timer ~= nil) then
        self.timer:Stop()
        self.timer = nil
    end
end

function DragonChessView:RefreshRewardItem()
    local count = _G.Mathf.Min(3, self.maxTaskNum)
    for i = 1, count do
        local itemobj = self.go_table["obj_Panel" .. i]
        self:RefreshListItem(i - 1, itemobj)
    end
end

return DragonChessView
