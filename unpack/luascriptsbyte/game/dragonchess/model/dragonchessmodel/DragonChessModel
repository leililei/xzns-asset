---@class DragonChessModel:GameDataModelBase	中文描述
---@field infoData HellGuardInfoData 信息数据
---@field TaskDatas HellRoadTaskData[] 任务数据
local DragonChessModel = _G.BaseClass("DragonChessModel", _G.GameDataModelBase)
local mission_extra_cfg = _G.ConfigManager.mission_extra_cfg
---@return DragonChessModel DragonChessModel
function DragonChessModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DragonChessModel:__init()
    self.finish_task = {}
    self.taskDatas = {}
    self.taskDatasNew = {}
end

---销毁对象时,析构函数
function DragonChessModel:Dispose()
end

--region 子类重写
---从服务器拉取数据
function DragonChessModel:GetDataFormServer(call, activity)
    self.activity = activity
    self.typeCls = activity.typeClass
    self.call = call
    local redPointId = self.typeCls:GetRedpointIDByIndex(1)
    require("SeasonTaskActivityModel"):GetInstance().redPointId = redPointId
    require "RedPointManager":GetInstance():AddRedPointChild(_G.ConfigManager.redpoint_cfg.FirstTest.id, redPointId)
    require "DragonChessNet":GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---获取活动时间倒计时
function DragonChessModel:GetEndTime()
    local openTime = _G.PlayerModel:GetInstance():GetServerOpenTime()
    return openTime + self.activity.cfg.time_open[1] +  self.activity.cfg.time_duration
end

---红点刷新
function DragonChessModel:hongDianNew()
    if self.typeCls ~= nil then
        self.typeCls:RefreshRedPoint()
    end
end

---获取成功回调
---@param msg activity_dragon_chess.s2c_dragon_chess_info
function DragonChessModel:GetInfoCall(msg)
    if msg.ack == 1 then
        --已完成的任务
        self.finish_task = msg.info.finish_task or {}
        --任务进度
        self.task_info = msg.info.task_info or {}
        --最终奖励是否领取 0：未领取 | 1：已领取
        self.is_award = msg.info.is_award or 0
        if self.is_award == 1 then
            self.typeCls.curActivityClass:ChangeState(require "ActivitySynManager":GetInstance().State.Close)
        end
        self:GetTaskInfos()
    --self:ParseData(self)
    end
    if self.call ~= nil then
        self.call()
    end
end

function DragonChessModel:GetTaskInfos()
    if #self.taskDatas > 0 then
        for i = 1, #self.taskDatas do
            self.taskDatas[i]:Clear()
        end
        self.taskDatas = {}
    end
    for key, value in pairs(self.finish_task) do
        local states = _G.TaskEnum.ETaskState.Submited

        local taskDatas =
            require "DragonChessTaskData".New(
            {
                sid = value,
                target = {9999},
                state = states,
                cfg = mission_extra_cfg[value]
            }
        )
        _G.table.insert(self.taskDatas, taskDatas)
    end
    for k, v in pairs(self.task_info) do
        local taskDatas =
            require "DragonChessTaskData".New(
            {
                sid = v.sid,
                target = v.target,
                state = v.state,
                cfg = mission_extra_cfg[v.sid]
            }
        )
        _G.table.insert(self.taskDatas, taskDatas)
    end
    _G.SortList(
        self.taskDatas,
        function(a)
            return -a.id
        end
    )
end

---@param  task task.i_task
function DragonChessModel:UpdataTask(task)
    local isUpdata = false
    if task == nil or task.sid == nil then
        return isUpdata
    end
    local mTask = self:GetTaskByTaskid(task.sid)
    if mTask == nil then
        return isUpdata
    end
    mTask:UpdataData(task)

    return true
end

function DragonChessModel:GetTaskByTaskid(taskid)
    for i = 1, #self.taskDatas do
        if self.taskDatas[i].i_task.sid == taskid then
            return self.taskDatas[i]
        end
    end

    return nil
end

---龙棋降世完成任务
function DragonChessModel:ChessFinish(pbData, call)
    --local data = {sid = id, finish_type = type}
    require "DragonChessNet":GetInstance():ChessFinish(
        pbData,
        function(msg)
            self:hongDianNew()

            if call ~= nil then
                call(msg)
            end
        end
    )
end

---龙棋降世完成任务
function DragonChessModel:ChessAward(call)
    require "DragonChessNet":GetInstance():ChessAward(
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.is_award = 1
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DrawResultRoleView.Name,
                _G.ConfigManager.card_cfg[113020000]
            )
            self:hongDianNew()
            self.typeCls.curActivityClass:ChangeState(require "ActivitySynManager":GetInstance().State.Close)
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.longqijiangshi)
            if call ~= nil then
                call()
            end
        end
    )
end

---返回最终奖励是否已领取
function DragonChessModel:IsAward()
    return self.is_award
end

---返回任务进度
function DragonChessModel:GetTaskInfo(id)
    for key, value in pairs(self.task_info) do
        if value.sid == id then
            return value
        end
    end
    return nil
end

---返回当前id是否已完成
function DragonChessModel:GetFinishTask(id)
    if _G.table.isEmptyOrNil(self.finish_task) then
        return false
    end

    for key, value in pairs(self.finish_task) do
        if value == id then
            return true
        end
    end
    return false
end

---记录id已完成
function DragonChessModel:IsFinishTask(id)
    if self.finish_task == nil then
        self.finish_task = {}
    end
    local IS = true
    for key, value in pairs(self.finish_task) do
        if value == id then
            IS = false
        end
    end
    if IS then
        _G.table.insert(self.finish_task, id)
        self:hongDianNew()
    end
end

---记录id已完成
function DragonChessModel:IsFinishTaskNew(id)
    if self.taskDatasNew == nil then
        self.taskDatasNew = {}
    end
    local IS = true
    for key, value in pairs(self.taskDatasNew) do
        if value == id then
            IS = false
        end
    end
    if IS then
        _G.table.insert(self.taskDatasNew, id)
    end
    return IS
end

function DragonChessModel.CheckIsAward()
    if
        DragonChessModel:GetInstance().finish_task == nil or
            _G.table.count(DragonChessModel:GetInstance().finish_task) < 4
     then
        return true
    end
    return DragonChessModel:GetInstance():IsAward() == 0
end

return DragonChessModel
