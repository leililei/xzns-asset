end

---检测红点
function DragonChessManager:CheckRedPointNumChild()
    for key, value in pairs(self.DragonChessModel.taskDatas) do
        local type1, type2 = false, false

        local w = value.i_task.target[1] / value.Cfg.count
        if w >= 1 then
            type1 = true
        end
        type2 = self.DragonChessModel:GetFinishTask(value.id)
        if type1 and type2 == false then
            return 1
        end
    end
    local taskCount = #self.DragonChessModel.taskDatas
    if self.DragonChessModel:IsAward() == 0 and _G.table.count(self.DragonChessModel.finish_task) >= taskCount then
        return 1
    end
    return 0
end

---刷新奖励红点
function DragonChessManager:RefreshRedPoint()
    if self.curActivityClass:GetActivityID() == nil then
        return
    end
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function DragonChessManager:OnGetMainViewName()
    return _G.ConfigManager.ui_cfg.DragonChessView.Name
end
