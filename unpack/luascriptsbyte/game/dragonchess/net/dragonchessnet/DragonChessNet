local base = require "BaseGameNet"
---@class DragonChessNet : BaseGameNet	通信协议
local DragonChessNet = _G.BaseClass("DragonChessNet", base)

---请求
---@param pbData table PB数据
---@param callback function 完成回调
function DragonChessNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_dragon_chess_info
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
end
---龙棋降世完成任务
function DragonChessNet:ChessFinish(pbData, callback)
    local item = _G.ConfigManager.net_map.game_dragon_chess_finish
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
    return port
end
---领取龙棋降世最终奖励
function DragonChessNet:ChessAward(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_dragon_chess_award
    local port = base.Access(self, item, pbData, _G.handlerbind(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DragonChessNet:CallBack(port, data, error)
    if error then
        return
    end
    --TODO 写通用数据解析，没有需要做的记得删除TODO
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DragonChessNet
_G.DragonChessNet = DragonChessNet
return DragonChessNet
