    self.go_table.aorbtn_CloseView:SetActiveE(isActive and 1 or 0)
end

---按钮点击事件在这里派发
function MiniFireGameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_settings or go == self.go_table.aorbtn_CloseView1 then
        --弹窗确认
        self:SetPause(true)
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1140004,
            nil,
            _G.handler(self, self.Close),
            function()
                self:SetPause(false)
            end
        )
    elseif go == self.go_table.aorbtn_help then
        self:SetPause(true)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 190, function()
            self:SetPause(false)
        end)
    end
end

function MiniFireGameView:OnClick(_, ed)
    local T = {position = {}}
    T.position.x, T.position.y =
    _G.CS.UIUtils.ScreenPointToLocalPointInRectangle(self.go_table.obj_root.transform)
    if -160 < T.position.x and T.position.x < 400 then
        if self.nowBulletNum > 0 then 
            local obj = _G.InstantiateObject(self.go_table.obj_Click, self.go_table.obj_root)
            
            obj:SetLocalPosition(T.position.x, T.position.y, 0)
            _G.DelayDo(0.2, function()
                _G.DestroyObject(obj)
            end)
            self:OnShoot(T)
        end
    end
end

function MiniFireGameView:CheckBulletFull()
    return self.nowBulletNum >= self.cfg.bullet_num
end

---更新显示分数
function MiniFireGameView:UdpateScore()
    self.go_table.aortext_score.text = tostring(self.score)
end

---更新显示分数
function MiniFireGameView:UdpateBulletNum()
    self.go_table.aortext_bullet.text = "X" .. tostring(self.nowBulletNum)
end

function MiniFireGameView:OnDestroy()
    self:RemoveAllListener()
    --移除定时器
    if self.mainLoop then
        self.mainLoop:Stop()
        self.mainLoop = nil
    end
end

return MiniFireGameView