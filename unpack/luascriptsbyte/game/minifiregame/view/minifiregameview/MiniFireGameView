---@class MiniFireGameView : UIBaseView	中文描述
---@field public go_table TapTapJumpView_GoTable GoTable
local MiniFireGameView = _G.BaseClass("MiniFireGameView", _G.UIBaseView)
local ObjectFactory = require("ObjectFactory")
local SwordCasual_Utils = require("SwordCasual_Utils")
local FireGame_BulletItem = require("FireGame_BulletItem")
local FireGame_MonsterItem = require("FireGame_MonsterItem")
local monsterImageName = {
    "ui_hqzn_qiqiu_hong",
    "ui_hqzn_qiqiu_cheng",
    "ui_hqzn_qiqiu_lan",
    "ui_hqzn_qiqiu_cai"
}

local NumberImages = {
    "ui_hbdj_djs_1",
    "ui_hbdj_djs_2",
    "ui_hbdj_djs_3",
}

function MiniFireGameView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.SetEventTrigger(self.go_table.obj_root, "onClick", _G.handler(self, self.OnClick))
end

---界面的入口函数
function MiniFireGameView:OnCreate(stageIndex, cfg, callback, hideScore)
    self.stageIndex = stageIndex
    self.kill = 0
    self.cfg = cfg
    self:InitData()
    self.callback = callback
    self:InitView()
    --初始化对象池
    self:InitPools()
    self:CreateMasterItem()
    self.monsterItems = {}
    self.bulletItems = {}
    self.masterPositionY = 0
    self.direction = 1
    --初始化主循环
    self.mainLoop = _G.TimerManager:GetInstance():GetTimer(1, self.Update, self, false, true)
    self.mainLoop:Start()
    self:UpdateTime()
    self:UdpateBulletNum()

    --直接初始化所有节点状态
    if not self.initTime or self.initTime < 0 then
        self.go_table.obj_countdown:SetActiveE(0)
    else
        self.go_table.obj_countdown:SetActiveE(1)
        self:UpdateCountDownTime()
    end

    --积分信息
    self.go_table.obj_score:SetActiveE(hideScore and 0 or 1)
    if hideScore then
        self:UdpateScore()
    end
end

---更新倒计时文本
function MiniFireGameView:UpdateCountDownTime()
    local index = math.ceil(self.initTime)
    if index < 1 then
        index = 1
    elseif index > #NumberImages then
        index = #NumberImages
    end
    self.go_table.aorimage_countDown.SpriteName = NumberImages[index]
end

function MiniFireGameView:CreateMasterItem()
    self.go_table.obj_spine:RemoveAllChildren()
    _G.PoolsManager:GetInstance():Spawn(
        "WX_Role/Animation/Airenhuoqiangshou/prf_Airenhuoqiangshou_ui",
        _G.ePoolType.Temporary,
        self.go_table.obj_spine,
        function(role)
            if not self.go_table then
                _G.DestroyObject(role)
                return
            end
            self.hero = role
            self.SA = self.hero:Find("SkeletonGraphic"):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
        end
    )
end

function MiniFireGameView:InitData()
    self.go_table.aortext_next.text = self.cfg.needs_score
    self.time = self.cfg.time_limit 
    self.getBulletTime = 0
    self.nowBulletNum = self.cfg.bullet_num
    self.score = 0
    self.initTime = 3.1
    self.masterCfg = {}
    for i = 1, #self.cfg.balloon_speed do 
        self.masterCfg[i] = {score = self.cfg.score[i] or 0, speed = self.cfg.balloon_speed[i], weight = self.cfg.balloon_weight[i], spriteName = monsterImageName[i], scale = self.cfg.scale}
    end
end

--初始化页面信息
function MiniFireGameView:InitView()
    self.go_table.aortext_name.text = _G.GetLangPackValue(90049100011, self.stageIndex)
end

---初始化对象池
function MiniFireGameView:InitPools()
    self.bulletPool =
        ObjectFactory.New(
            function()
                --create
                local instance = _G.InstantiateObject(self.go_table.trans_bullet, self.go_table.obj_root)
                instance:SetActiveE(1)

                ---@type SwordCasual_BulletItem
                local bulletItem = self:AddComponent(instance, FireGame_BulletItem.New(instance))
                return bulletItem
            end,
            ---@param item SwordCasual_BulletItem
            function(item)
                --active
                item.gameObject:SetActiveE(1)
            end,
            ---@param item SwordCasual_BulletItem
            function(item)
                --release
                if item.gameObject then 
                    item.gameObject:SetActiveE(0)
                end
            end
        )

    self.monsterPool =
        ObjectFactory.New(
            function()
                --create
                local instance = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_root)
                instance:SetActiveE(1)

                ---@type SwordCasual_MonsterItem
                local roleItem = self:AddComponent(instance, FireGame_MonsterItem.New(instance))
                return roleItem
            end,
            ---@param item SwordCasual_MonsterItem
            function(item)
                --active
                item.gameObject:SetActiveE(1)
            end,
            ---@param item SwordCasual_MonsterItem
            function(item)
                --release
                if item.gameObject then 
                    item.gameObject:SetActiveE(0)
                end
            end
        )
end

---主循环事件
function MiniFireGameView:Update()
    if self:IsPause() then
        return
    end

    local dt = _G.Time.deltaTime

    --初始化时间
    if self.initTime >= 0 then
        self:UpdateCountDownTime()
        self.initTime = self.initTime - dt
        if self.initTime < 0 then
            self.go_table.obj_countdown:SetActiveE(0)
        end
        return
    end

    --时间计数
    self.time = self.time - dt

    if self.time <= 0 then 
        self:GameOver()
        return 
    end 
    
    if self:CheckBulletFull() then 
        self.getBulletTime = 0
    elseif self.getBulletTime >= self.cfg.bullet_gen_time then 
        self.nowBulletNum = self.nowBulletNum + 1
        self:UdpateBulletNum()
        self.getBulletTime = 0
    else 
        self.getBulletTime = self.getBulletTime + dt
    end
    self:UpdateTime()
    
    --主角移动
    local x, y = self.go_table.obj_master:GetLocalPosition()
    if y >= self.masterPositionY + self.cfg.platform_distance then 
        self.direction = -1
    elseif y <= self.masterPositionY - self.cfg.platform_distance then 
        self.direction = 1
    end
    local delta = self.cfg.platform_speed * dt * self.direction
    self.go_table.obj_master.transform:SetLocalPosition(x, y + delta, 0)
    --物理逻辑更新
    for i = #self.monsterItems, 1, -1 do
        self.monsterItems[i]:Update(dt)
    end
    for i = #self.bulletItems, 1, -1 do
        self.bulletItems[i]:Update(dt)
    end

    --计算子弹碰撞
    self:UpdateBulletOverlap()

    --生成怪物实例
    if self:CheckCreateM() then 
        local monsterItem = self:CreateMonsterItem()
        table.insert(self.monsterItems, monsterItem)
        monsterItem:OnDestroyed(_G.handlerbind(self, self.ReleaseMonsterItem, monsterItem))
        self.lastCreateMTime = self.time
    end
end

function MiniFireGameView:UpdateBulletOverlap()
    for i = #self.bulletItems, 1, -1 do
        for j = #self.monsterItems, 1, -1 do
            if not self.monsterItems[j]:IsDeath() then
                if SwordCasual_Utils.Physics:rectOverlapOBB(self.bulletItems[i]:GetRect(), self.monsterItems[j]:GetRect()) then 
                    self.monsterItems[j]:ShowDeath()
                    self:OnMonsterDeath(self.monsterItems[j])
                end
            end
        end
    end
end

---监听处理怪物死亡事件
function MiniFireGameView:OnMonsterDeath(monsterItem)
    self.kill = self.kill + 1

    --分数
    local cfg = monsterItem:GetData()
    if cfg then
        if cfg.score > 0 then
            self.score = self.score + cfg.score
        elseif cfg.score == 0 then 
            for j = #self.monsterItems, 1, -1 do
                if not self.monsterItems[j]:IsDeath() then
                    self.kill = self.kill + 1
                    self.monsterItems[j]:ShowDeath()
                    local nowCfg = self.monsterItems[j]:GetData()
                    self.score = self.score + nowCfg.score
                end
            end
        end
        
        self:UdpateScore()
    end
end

function MiniFireGameView:GetShootPosition()
    local x, y = self.go_table.obj_master:GetLocalPosition()
    return x + 45, y + 30
end

function MiniFireGameView:ShowShootEff()

end
function MiniFireGameView:OnShoot(target)
    --初始位置和方向
    local x, y = self:GetShootPosition()
    local tx = target.position.x 
    local ty = target.position.y 
    local offsetX, offsetY = tx - x, ty - y

    local distance = math.sqrt(offsetX * offsetX + offsetY * offsetY)
    if distance < 0.001 then
        if _G.AppSetting.DEBUG then
            _G.LogError("目标与射击手距离过近: 位置重叠")
        end
        return
    end
    local direction = { x = offsetX / distance, y = offsetY / distance }

    ---@type SwordCasual_BulletItem
    local bulletItem = self.bulletPool:Get()
    bulletItem:SetDirection(direction)
    bulletItem:SetPosition(x, y)
    bulletItem:SetData(self.cfg)
    bulletItem:OnDestroyed(_G.handlerbind(self, self.ReleaseMonsterItem, bulletItem))

    table.insert(self.bulletItems, bulletItem)
    self.nowBulletNum = self.nowBulletNum - 1 
    self:UdpateBulletNum()
    self:ShowShootEff()
    _G.AudioManager.PlayAudioByAudioCfgID(3009)
    self.SA.AnimationState:SetAnimation(0, "hit_1", false);
end

function MiniFireGameView:CheckCreateM()
    return (not self.lastCreateMTime or (self.lastCreateMTime - self.time) >= self.cfg.balloon_cd)
end

---创建怪物实例
---@param cx number @中心x坐标
---@param cy number @中心y坐标
---@return SwordCasual_MonsterItem
function MiniFireGameView:CreateMonsterItem()
    local monsterItem = self.monsterPool:Get()
    --设置基础属性
    local type = self:GetNewMonsterType()
    monsterItem:SetData(self.masterCfg[type])

    local x, y = self:GetMonsterBornPosition()
    monsterItem:SetPosition(x, y)

    return monsterItem
end

function MiniFireGameView:GetNewMonsterType()
    if not self.weight then 
        self.weight = 0 
        for i = 1, #self.masterCfg do 
            self.weight = self.weight + self.masterCfg[i].weight
        end 
    end
    local weight = math.random(1, self.weight)
    for i = 1, #self.masterCfg do 
        weight = weight - self.masterCfg[i].weight
        if weight <= 0 then 
            return i
        end
    end 
end

function MiniFireGameView:GetMonsterBornPosition()
    local x, y = self.go_table.obj_monsterRoot:GetLocalPosition()
    local offsetX = math.random(1, 350)
    return x + offsetX, y
end

---回收实例
function MiniFireGameView:ReleaseMonsterItem(roleItem)
    if roleItem.__cname == FireGame_BulletItem.__cname then
        self.bulletPool:Release(roleItem)
        --从全局列表中移除
        for i = #self.bulletItems, 1, -1 do
            if self.bulletItems[i] == roleItem then
                table.remove(self.bulletItems, i)
                break
            end
        end
    elseif roleItem.__cname == FireGame_MonsterItem.__cname then
        self.monsterPool:Release(roleItem)
        --从全局列表中移除
        for i = #self.monsterItems, 1, -1 do
            if self.monsterItems[i] == roleItem then
                table.remove(self.monsterItems, i)
                break
            end
        end
    else
        _G.DestroyObject(roleItem.gameObject)
        if _G.AppSetting.DEBUG then
            _G.LogError("未知的实例类型: " .. tostring(roleItem.__cname))
        end
    end
end

function MiniFireGameView:GameOver()
    self:SetPause(true)
    if self.callback then
        self.callback(self:CheckWin(), self.kill, self.time, self.score)
        self.callback = nil
    end
end

function MiniFireGameView:CheckWin()
    return self.score >= self.cfg.needs_score
end

---是否暂停游戏
---@return boolean
function MiniFireGameView:IsPause()
    return self.pause 
end

---设置是否暂停游戏
---@param pause boolean
function MiniFireGameView:SetPause(pause)
    self.pause = pause
end

