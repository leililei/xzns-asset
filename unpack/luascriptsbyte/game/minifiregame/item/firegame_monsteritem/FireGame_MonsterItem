
---@field direction {x:number,y:number}     @行进方向
---@field position {x:number,y:number}      @当前位置
---@field onDestroyed fun(item:FireGame_MonsterItem):void @销毁事件回调
local FireGame_MonsterItem = _G.BaseClass("FireGame_MonsterItem", _G.Component)

---入口函数
function FireGame_MonsterItem:OnCreate(trans)
    self.go_table = _G.GetAutoGoTable(trans)
    self.position = {x = 0, y = 0}
    --self.direction = { x = 1, y = 0 }
end

---物理逻辑更新
---@param deltaTime number @时间间隔
function FireGame_MonsterItem:Update(deltaTime)
    if self.isDeath then 
        return 
    end
     --更新位置信息
    self:UpdatePosition(self.speed * deltaTime)
    --更新矩形信息
    self:UpdateRect()

    if math.abs(self.position.y) >= (_G.CS.Launcher.Inst.ScreenSize.y / 2 + 300) then
        self.isDeath = true
        if self.onDestroyed then
            self.onDestroyed(self)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("未处理子弹销毁事件")
            end
        end
    end
end

function FireGame_MonsterItem:IsDeath()
    return self.isDeath
end

function FireGame_MonsterItem:ShowDeathEff(type)

end

function FireGame_MonsterItem:ShowDeath()
    self.isDeath = true 
    _G.AudioManager.PlayAudioByAudioCfgID(2056)
    if self.cfg.score == 0 then 
        self.go_table.obj_icon:SetActiveE(0)
        self.go_table.aortext_score:SetActiveE(0)
        self.go_table.aorrawimage_boom:SetActiveE(1)
        self:ShowDeathEff(1)
    else 
        self.go_table.obj_icon:SetActiveE(0)
        self.go_table.aortext_score:SetActiveE(1)
        self.go_table.aorrawimage_boom:SetActiveE(0)
        self:ShowDeathEff(2)
    end 
    _G.DelayDo(0.5, function()
        if self.onDestroyed then
            self.onDestroyed(self)
        else
            if _G.AppSetting.DEBUG then
                _G.LogError("未处理气球销毁事件")
            end
        end
    end)
end

---设置父节点
---@param parent SwordCasual_RoleItem @父节点
function FireGame_MonsterItem:SetParent(parent)
    self.parent = parent
end

---获取父节点
---@return SwordCasual_RoleItem @父节点
function FireGame_MonsterItem:GetParent()
    return self.parent
end

---设置配置数据
function FireGame_MonsterItem:SetData(cfg)
    self.cfg = cfg

    --配置信息
    self:SetSpeed(self.cfg.speed)
    self.go_table.obj_icon:SetLocalScale(self.cfg.scale, self.cfg.scale, self.cfg.scale)
    self.go_table.aorimage_icon.SpriteName = self.cfg.spriteName
    self.go_table.aortext_score.text = "+" .. self.cfg.score
    self.go_table.obj_icon:SetActiveE(1)
    self.go_table.aortext_score:SetActiveE(0)
    self.go_table.aorrawimage_boom:SetActiveE(0)
    self.isDeath = false 
    --self:UpdateColliderSize()
end

---获取配置数据
---@return jzxx_bullet_cfg
function FireGame_MonsterItem:GetData()
    return self.cfg
end

--region ===================物理/重叠判断相关===================

---更新自身矩形信息(立即更新信息)
function FireGame_MonsterItem:UpdateRect()
    if not self.rect then
        local w, h = self.go_table.trans_trigger:GetRectTransformWidthHeight()
        local rad = _G.math.rad(self:GetDirectionAngle())
        self.rect = { x = 0, y = 0, w = w, h = h, rot = rad }
    end
    self.rect.x = self.position.x
    self.rect.y = self.position.y
end

---获取自身矩形信息
---@return SwordCasual_Rect @矩形a
function FireGame_MonsterItem:GetRect()
    if not self.rect then
        self:UpdateRect()
    end
    return self.rect
end

---更新碰撞盒大小
function FireGame_MonsterItem:UpdateColliderSize()
    local width, height = table.unpack(self.cfg.box)
    width = math.max(1, width)
    height = math.max(1, height)
    self.go_table.trans_trigger:SetRectTransformSize(width, height)
    --更新矩形信息
    if self.rect then
        self.rect.w = width
        self.rect.h = height
    end
end

--endregion

--region ===================位置/方向/速度相关===================

---设置方向
---@param direction {x:number,y:number} @方向
function FireGame_MonsterItem:SetDirection(direction)
    self.direction = direction

    local angle = self:GetDirectionAngle()
    ---更新子弹方向
    if self.rect then
        local rad = _G.math.rad(angle)
        self.rect.rot = rad
    end
    --更新子弹朝向
    self.transform:SetLocalEulerAngles(0, 0, angle + 90) --子弹默认朝下, 旋转90度

    if self.target then
        self:UpdateMoveAnimation()
    end
end

---获取方向
---@return {x:number,y:number} @方向
function FireGame_MonsterItem:GetDirection()
    return self.direction
end

---设置移动速度
---@param speed number @速度
function FireGame_MonsterItem:SetSpeed(speed)
    self.speed = speed

    if self.target then
        self:UpdateMoveAnimation()
    end
end

---设置位置
---@param x number @x坐标
---@param y number @y坐标
function FireGame_MonsterItem:SetPosition(x, y)
    self.position.x = x
    self.position.y = y

    if self.target then
        self:UpdateMoveAnimation()
    else
        self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
    end
end

---更新位置
---@param delta number @移动距离
function FireGame_MonsterItem:UpdatePosition(delta)
    self.position.y = self.position.y + delta

    self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
end

---获取位置
---@return number @x轴坐标
---@return number @y轴坐标
function FireGame_MonsterItem:GetPosition()
    return self.position.x, self.position.y
end

---获取方向角度
---@private
---@return number @角度
function FireGame_MonsterItem:GetDirectionAngle()
    if not self.direction then
        return 0
    end

    local rad = math.atan(self.direction.y, self.direction.x)
    local angle = rad * 180 / math.pi
    return angle
end

---停止移动动画
function FireGame_MonsterItem:StopMoveAnimation()
    self.go_table.gameObject.transform:DOKill()
    --self.transform:SetLocalPosition(self.position.x, self.position.y, 0)
end

---更新移动动画
function FireGame_MonsterItem:UpdateMoveAnimation()
    self:StopMoveAnimation()

    local y = self.speed

    local tweener = self.go_table.gameObject.transform:DOBlendableLocalMoveBy(_G.Vector3(0, y, 0), 1)
    tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
    --tweener:SetLoops(-1, _G.CS.DG.Tweening.LoopType.Incremental)
    tweener:SetTarget(self.go_table.gameObject.transform)
end

--endregion


--region ===================模型相关===================

---根据当前血量更新模型
---@param force? boolean @是否强制更新
function FireGame_MonsterItem:UpdateModel()
    self:RemoveModel()
    if self.cfg.imgName and #self.cfg.imgName > 0 then
        self.go_table.trans_effect:SetActiveE(0)
        self.go_table.aorimage_renderer:SetActiveE(1)

        self.go_table.aorimage_renderer.SpriteName = self.cfg.imgName
        self.go_table.aorimage_renderer:SetNativeSize()
    elseif self.cfg.effectPath and #self.cfg.effectPath > 0 then
        self.go_table.trans_effect:SetActiveE(1)
        self.go_table.aorimage_renderer:SetActiveE(0)

        local d = self.cfg
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.effectPath,
            _G.ePoolType.Temporary,
            self.go_table.trans_effect,
            function(trans)
                if self.cfg ~= d or self.modelNode then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                    return
                end
                trans:SetLocalScaleXYZ(1)
                trans:SetLocalPositionToZero()
                trans:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                self.modelNode = trans
            end
        )
    end
end

---移除旧的模型实例
function FireGame_MonsterItem:RemoveModel()
    if not self.modelNode then
        return
    end
    --_G.PoolsManager:GetInstance():Despawn(self.modelNode, _G.ePoolType.Temporary)
    _G.DestroyObject(self.modelNode) --存在UIParticleOrderChange组件时, 不能回收入池
    self.modelNode = nil
end

--endregion

--region ===================注册事件===================

---注册销毁事件
---@param callback fun(item:FireGame_MonsterItem):void @事件回调
function FireGame_MonsterItem:OnDestroyed(callback)
    self.onDestroyed = callback
end

--endregion

return FireGame_MonsterItem
