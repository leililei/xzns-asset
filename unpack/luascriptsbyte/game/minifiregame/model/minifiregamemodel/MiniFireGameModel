local base = _G.GameDataModelBase

---@class MiniFireGameModel : GameDataModelBase
---@field GetInstance fun():MiniFireGameModel
---@field stages hqzn_stage_cfg[]       关卡列表
---@field curStageIndex number          当前进行中的关卡下标
---@field challengeIndex number         挑战中关卡下标
local MiniFireGameModel = _G.BaseClass("MiniFireGameModel", base)

function MiniFireGameModel:__init()
    self.stages = {}
    self.curStageIndex = 1
    for _, cfg in pairs(_G.ConfigManager.hqzn_stage_cfg) do
        if cfg.type == 0 then
            table.insert(self.stages, cfg)
        end
    end
    table.sort(self.stages, function(a, b)
        return a.id < b.id
    end)
end

---从服务器拉取数据
function MiniFireGameModel:GetDataFormServer()
    self:ParseData()
end

---@param msg any
function MiniFireGameModel:ParseData(msg)
    base.ParseData(self)
end

---检测是否全部通关
---@return boolean
function MiniFireGameModel:CheckIsAllPass()
    local curStage = self.stages[self.curStageIndex]
    return not curStage
end

---获取当前待挑战关卡下标
---@return number
function MiniFireGameModel:GetCurSectionIndex()
    return self.curStageIndex
end

---获取关卡配置
---@return jzxx_stage_cfg[]
function MiniFireGameModel:GetSectionCfgs()
    return self.stages
end

---挑战
---@param sectionId number 关卡下标
function MiniFireGameModel:Challenge(stageIndex)
    local stageCfg = self.stages[stageIndex]
    if not stageCfg then
        local cfg = _G.ConfigManager.hqzn_stage_cfg[stageIndex]
        if cfg then
            for index, _cfg in ipairs(self.stages) do
                if _cfg.id == stageIndex then
                    stageCfg = _cfg
                    stageIndex = index
                    break
                end
            end
        end
    end
    if not stageCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("挑战的关卡sectionId不存在: " .. tostring(stageIndex))
        end
        return
    end
    if _G.AppSetting.DEBUG then
        if stageIndex ~= self.curStageIndex then
            _G.LogError("当前挑战的关卡stageIndex错误: " .. tostring(stageIndex))
        end
    end
    self.challengeIndex = stageIndex
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.MiniFireGameView.Name,
        stageIndex,
        stageCfg,
        _G.handler(self, self.OnChallengeSettlement)
    )
end

---监听挑战结束事件
---@param win boolean 是否胜利
---@param kill number 击杀数量
---@param time number 挑战时间
function MiniFireGameModel:OnChallengeSettlement(win, kill, time)
    if win and self.curStageIndex == self.challengeIndex then
        self.curStageIndex = self.curStageIndex + 1
        self.challengeIndex = self.challengeIndex + 1
        _G.Events:GetInstance():Broadcast(_G.eMiniSectionGame.MiniSectionPass)
    end

    local hasNextStage = win and (not not self.stages[self.challengeIndex])
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.SwordCasualSettlementView.Name,
        { win = win, next = hasNextStage, kill = kill, time = time },
        ---@param type number 0返回, 1-继续, 2-重新开始
        function(type)
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.MiniFireGameView.Name)
            if type == 1 or type == 2 then
                self:Challenge(self.challengeIndex)
            end
        end
    )
end

return MiniFireGameModel
