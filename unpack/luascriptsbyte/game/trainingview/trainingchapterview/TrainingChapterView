function TrainingChapterView:SetData(Data)
    ---@type TrainingChapterItem[]
    self.ChapterItemArr = {}

    local train_chapter_cfg = _G.ConfigManager.train_chapter_cfg
    self.ChapterCfgDic = {}
    local trainChapterCfg_item
    for i = 1, 99 do
        trainChapterCfg_item = train_chapter_cfg[i]
        if trainChapterCfg_item ~= nil then
            self.ChapterCfgDic[i] = trainChapterCfg_item
            self:SetItem(trainChapterCfg_item, i)
        else
            break
        end
    end
end

-- 设置训练章节项
-- @param trainChapterCfg_item 训练章节配置项
-- @param i 索引
function TrainingChapterView:SetItem(trainChapterCfg_item, i)
    local luaItem = require("TrainingChapterItem")
    local tran, TrainingChapterItem
    tran = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Content)
    tran:SetName(i)
    TrainingChapterItem = luaItem.New(tran, trainChapterCfg_item, i)
    table.insert(self.ChapterItemArr, TrainingChapterItem)
end

-- 更新信息
function TrainingChapterView:UpdataInfo()
    for i, luaItem in pairs(self.ChapterItemArr) do
        luaItem:UpdataInfo(i)
    end
    -- self:JingDuTiao()
end

---进度条显示
function TrainingChapterView:JingDuTiao()
    local TrainingModel = require("TrainingModel"):GetInstance()
    local gid_list = TrainingModel.gid_list
    local train_gate_cfg = _G.ConfigManager.train_gate_cfg
    local max1
    if gid_list == 0 then
        max1 = 0
    else
        max1 = train_gate_cfg[gid_list].gate_number
    end
    local DQ = TrainingModel:GetCount() - max1
    local max = train_gate_cfg[gid_list + 1].gate_number - max1

    self.go_table.aorimage_jingdu.fillAmount = DQ / max
    if DQ > max then
        self.go_table.aortext_JinDu.text = _G.string.format("%d/%d", max, max)
    else
        self.go_table.aortext_JinDu.text = _G.string.format("%d/%d", DQ, max)
    end
    self.go_table.aortext_LingQuJiangLi.text = _G.string.format(_G.LangUtil.GetLangPackValue(90024300022), max)
    local train_gate = _G.ConfigManager.train_gate_cfg[self.tarinModel.gid_list + 1]
    self:CareatItemCjNew(train_gate.reward[1], self.go_table.obj_reward)

    -- if DQ >= max then
    --     self.go_table.aorbtn_LingJiang:SetActiveE(1)
    -- else
    --     self.go_table.aorbtn_LingJiang:SetActiveE(0)
    -- end
end

---物品显示
function TrainingChapterView:CareatItemCjNew(data, Parent)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        data,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(1)

            -- item:SetGou(isGou)
            item.gameObject:SetActiveE(1)
            item:SetGray(false)
            item.go_table.obj_ItemNum.GetComponentE(1)
            item.gameObject:SetLocalPosition(0, 0, 0)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        function(go, isOn)
            if
                _G.ConfigManager.train_gate_cfg[self.tarinModel.gid_list + 1].gate_number <=
                require("TrainingModel"):GetInstance():GetCount()
            then
                self.tarinModel:GetReward(2, self.tarinModel.gid_list + 1)
            else
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1])
            end
        end
    )
end

--- 关闭视图
function TrainingChapterView:CloseView()
    require("TrainingModel"):GetInstance().diyc = 0

    for _, luaItem in pairs(self.ChapterItemArr) do
        luaItem:Dispose()
    end
    self.ChapterItemArr = nil
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)

    self:Close()
end

---按钮点击事件在这里派发
function TrainingChapterView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return TrainingChapterView
