---@class TrainSettlementView : UIBaseView	中文描述
---@field public go_table TrainSettlementView_GoTable GoTable
local TrainSettlementView = _G.BaseClass("TrainSettlementView", _G.UIBaseView)
function TrainSettlementView:Awake()
end

---界面的入口函数
---@param data Params_EmbattleItemPVE_Train
function TrainSettlementView:OnCreate(OnSettlementEndCall, winner, awardList)
    self.go_table.obj_node:SetActiveE(0)

    --按钮点击对应的方法
    self.clickFunction = {
        [self.go_table.aorbtn_again:GetName()] = self.OnClick_Again,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Tips_Table = _G.GetAutoGoTable(self.go_table.obj_tips)
    self.OnSettlementEndCall = OnSettlementEndCall
    self.winner = winner
    self.awardList = awardList
    self:OpenEmbattleView()
end

function TrainSettlementView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    if self.Timer_Show ~= nil then
        _G.coroutine.stopwaiting(self.Timer_Show)
        self.Timer_Show = nil
    end
end

function TrainSettlementView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    local result = {}
    result.iSWin = self.winner
    result.AwardData = self.awardList
    result.statistics = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, self.OnSettlementEndCall, result)
end

---监听界面
---@param name string 界面名称
function TrainSettlementView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)

        self.ShowAwardWithButtonView = _G.UIManager:GetInstance():GetWindowCtrl(name)

        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.ShowAwardWithButtonView.transform:SetParentE(self.go_table.trans_view)
        self:SetInfo()
    end
end
---监听界面
---@param name string 界面名称
function TrainSettlementView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        require("TrainingModel"):GetInstance():ExitEmbattle()
        self:Close()
    end
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function TrainSettlementView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(name, OnSettlementEndCall, result)
end

function TrainSettlementView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function TrainSettlementView:OnBattleCall()
    self:Close()
    if self.onBattleCall then
        self.onBattleCall()
        self.onBattleCall = nil
    end
end

---@param embattleView EmbattleNewView
function TrainSettlementView:SetInfo()
    if self.winner == true then
    else
        ---隐藏提示按钮
        self.ShowAwardWithButtonView.go_table.obj_tips:SetActiveE(0)
        --- 不能点击屏幕关闭
        --self.ShowAwardWithButtonView.go_table.aorbtn_BG:SetActiveE(0)
        self.Timer_Show =
            _G.DelayDo(
            0.5,
            function()
                self:SetTips()
                self.go_table.obj_node:SetActiveE(1)
            end
        )
    end
end

function TrainSettlementView:SetTips()
    local sectionid = require("TrainingModel"):GetInstance():GetNowSelectSection()
    if sectionid == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(" sectionid nil")
        end
        return
    end
    local train_section_cfgItem = _G.ConfigManager.train_section_cfg[sectionid]
    if train_section_cfgItem == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(" train_section_cfgItem nil")
        end
        return
    end
    local langID
    for i = 1, 3 do
        langID = train_section_cfgItem.desc[i]
        if langID ~= nil then
            self.Tips_Table["aortext_tips (" .. i .. ")"].text = _G.LangUtil.GetLangPackValue(langID)
        end
        self.Tips_Table["obj_tips (" .. i .. ")"]:SetActiveE(langID ~= nil and 1 or 0)
    end
end

---再来一次
function TrainSettlementView:OnClick_Again()
    -- --- 禁止回调
    -- self.ShowAwardWithButtonView.callback = nil

    self.ShowAwardWithButtonView:CloseCall(_G.SettlementModel.FunctionEnum.None)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    -- require("TrainingModel"):GetInstance():OnSettlementEnd()
    self:Close()
    local sectionid = require("TrainingModel"):GetInstance():GetNowSelectSection()
    if sectionid ~= nil then
        require("TrainingModel"):GetInstance():EnterEmbattle(sectionid)
    end
end

---按钮点击事件在这里派发
function TrainSettlementView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return TrainSettlementView
