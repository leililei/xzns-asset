---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function TrainDoubleResourcesModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPointBet}
    self.redpointTree = {{2}, false}
end

---检测红点
function TrainDoubleResourcesModel:CheckRedPointBet()
    local DoubleResources = _G.PlayerPrefsManager.GetInt("DoubleResourceslist")

    if
        DoubleResources == nil or DoubleResources == 0 or
            DoubleResources ~= require "DoubleResourcesModel":GetInstance().sid
     then
        return 1
    end
    return 0
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function TrainDoubleResourcesModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end
---刷新奖励红点
function TrainDoubleResourcesModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
