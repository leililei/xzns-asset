function TrainingModel:TrainingHongDianChapter()
    local passCount
    local maxCount
    for k, v in pairs(_G.ConfigManager.train_chapter_cfg) do
        if not self:IsGetReward(v.id) then
            passCount = self:GetChapterPassCount(v.id)
            maxCount = self:GetChapterMaxCount(v.id)
            if passCount >= maxCount then
                return true
            end
        end
    end
    return false
end

function TrainingModel:TrainingView_SetShow(sectionId)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TrainingView.Name)
