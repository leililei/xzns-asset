function TrainingModel:InitSectionListDic()
    local chapter
    ---@param train_section_cfgItem train_section_cfg
    for key, train_section_cfgItem in pairs(_G.ConfigManager.train_section_cfg) do
        chapter = train_section_cfgItem.chapter
        if self.sectionListDic[chapter] == nil then
            self.sectionListDic[chapter] = {}
        end
        _G.table.insert(self.sectionListDic[chapter], train_section_cfgItem.id)
    end
    for _, list in pairs(self.sectionListDic) do
        _G.table.sort(
            list,
            function(a, b)
                return a < b
            end
        )
    end
end

