end

function TrainingModel:TrainingView_Sethigh_section(sectionId)
    if self.pid_list == nil and _G.table.count(self.pid_list) > 0 then
        return
    end
    for key, value in pairs(self.pid_list) do
        if value == sectionId then
            return
        end
    end
    _G.table.insert(self.pid_list, sectionId)

    --region --------------------------------------镇魂特训通关指定章节   指定关卡（0:该章所有关卡）--------

    ---@type train_section_cfg
    local cfg = _G.ConfigManager.train_section_cfg[sectionId]
    local list = self.sectionListDic[cfg.chapter]

    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        {
            _G.ActiveTaskEnum.ConditionEnum.Train.chpaterSection,
            cfg.chapter,
            sectionId
        },
        1,
        false,
        true
    )

    if list ~= nil and list[#list] == sectionId then
        --- 如果 通过关卡为最后一关  则通关章节
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {
                _G.ActiveTaskEnum.ConditionEnum.Train.chpaterSection,
                cfg.chapter,
                0
            },
            1,
            false,
            true
        )
    end

    --endregion------------------------------------镇魂特训通关指定章节   指定关卡（0:该章所有关卡）--------
end

