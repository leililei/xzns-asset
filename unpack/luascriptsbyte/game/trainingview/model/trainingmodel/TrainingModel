---进入布阵界面，准备战斗
function TrainingModel:EnterEmbattle(sectionId)
    ---@type train_section_cfg
    local train_section_cfgItem = _G.ConfigManager.train_section_cfg[sectionId]
    if train_section_cfgItem == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("train_section_cfg sectionId is nil " .. tostring(sectionId))
        end
        return
    end
    local monster_group = train_section_cfgItem.monster_group

    ---@type Params_EmbattleItemPVE_Train
    local data = {}
    data.sectionId = sectionId
    self.Embattle_sectionId = sectionId
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.TrainEmbattleView.Name,
        _G.handler(self, self.ExitEmbattle),
        function()
            self:EnterFight(sectionId, self.activityId)
        end,
        monster_group,
        data
    )
end

