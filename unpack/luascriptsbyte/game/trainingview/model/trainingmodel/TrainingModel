function TrainingModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.TrainChapterSection.id
    )
    require("RedPointManager"):GetInstance():RefreshNode(
        _G.ConfigManager.redpoint_cfg.TrainChapterReward.id
    )
    if self.RefreshRedPointCall ~= nil then
        self.RefreshRedPointCall()
    end
end

---@field type 类型（1,章节奖励 2，进度奖励）
---领取奖励  章节id 关卡id
function TrainingModel:GetReward(type, Id)
    ---@type special_training.c2s_special_training_gate
    local pbdata = {}
    pbdata.type = type
    pbdata.id = Id
    pbdata.activity_id = self.activityId
    require("TrainingNet"):GetInstance():GetReward(
        pbdata,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.award ~= nil then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                --奖励
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            end
            if type == 1 then
                _G.table.insert(self.chap_list, Id)
            else
                self.gid_list = self.gid_list + 1
            end
            self:RefreshRedPoint()
            self:UpdataView()
        end
    )
end

--- 获取是否已领取奖励  true已领取
function TrainingModel:IsGetReward(Id)
    return _G.table.exist(
        self.chap_list,
        function(id)
            return id == Id
        end
    )
end

--- 获取章节关卡进度（总）
function TrainingModel:GetCount()
    local count = 0
    for _, value in pairs(self.sectionListDic) do
        for i = 1, #value do
            for _, s in pairs(self.pid_list) do
                if s == value[i] then
                    count = count + 1
                end
            end
        end
    end

    return count
end

--- 获取章节关卡进度
function TrainingModel:GetChapterPassCount(chapterId)
    local list = self.sectionListDic[chapterId]
    if list == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(" error  chapterId " .. chapterId)
        end
        return
    end
    local count = 0
    for i = 1, #list do
        for key, value in pairs(self.pid_list) do
            if value == list[i] then
                count = count + 1
            end
        end
    end
    return count
end

--- 获取章节关卡数量
function TrainingModel:GetChapterMaxCount(chapterId)
    local list = self.sectionListDic[chapterId]
    if list == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning(" error  chapterId " .. chapterId)
        end
        return
    end
    return #list
end

