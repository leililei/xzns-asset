local base = require "ActivitySynTypeBase"
---@class TrainSignInModel : ActivitySynTypeBase	中文描述
local TrainSignInModel = _G.BaseClass("TrainSignInModel", base)

---创建对象时,入口构造函数
function TrainSignInModel:__init()
    self.curActivityState = false
end
--- 网络请求初始化
-- function TrainSignInModel:GetDataFormServer()
--     self:ParseData()
-- end

function TrainSignInModel:OnHandleGMData(info)
    self:ParseData(info)
end
---领取奖励
---@param callback function 回调
function TrainSignInModel:GetAward(index, callback)
    self:GetActivityAward({index}, callback)
end
---领取奖励
---@param callback function 回调
function TrainSignInModel:GetAwardT(indexT, callback)
    self:GetActivityAward(indexT, callback)
end
---数据解析完成
function TrainSignInModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end
function TrainSignInModel:SetSelfData(info)
    self.signType = info.sign.type
    self.showType = info.sign.show_type
    self.subType = self.curActivityClass:GetJumpType()
    if self.showType == 1 then
        require "SignInModel":GetInstance():GetInfoCall(info, self.curActivityClass)
    elseif self.showType == 2 then
        require "FestivalSignInModel":GetInstance():GetInfoCall(info, self.curActivityClass)
    elseif self.showType == 3 then
        require "JointActivityModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 4 then
        require"IceFestivalSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 5 then
        require"IceFestivalSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 6 then
        require"IceFestivalSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 7 then
        require"WinterVeilFestivalSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 8 then
        require"SpringFestivalSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    elseif self.showType == 9 then
        require"EasterSignInModel":GetInstance():ParseSignData(info, self.curActivityClass)
    end
end

function TrainSignInModel:InitFunction()
    --self.DoubleResourcesModel:InitFunction()
end
---进入活动主体
function TrainSignInModel:OnEnterActivity()
    if self.showType == 1 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SignInView.Name, self.curActivityClass)
    elseif self.showType == 2 then
        local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
        if _type == _G.JointActivityType.SpringFestival then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpringSignView.Name, self.curActivityClass)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FestivalSignView.Name, self.curActivityClass)
        end
    elseif self.showType == 3 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.JointActivitySignView.Name, self.curActivityClass)
    elseif self.showType == 4 then
        local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
        if _type == _G.JointActivityType.SummerFire then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SummerFireSignInView.Name, self.curActivityClass)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.IceFestivalSignInView.Name, self.curActivityClass)
        end
    elseif self.showType == 5 then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTSignInMainView.Name, self.curActivityClass)
    elseif self.showType == 6 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CapybaraSignInMainView.Name, self.curActivityClass)
    elseif self.showType == 7 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.WinterVeilFestivalSignInView.Name, self.curActivityClass)
    elseif self.showType == 8 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SpringFestivalSignInView.Name, self.curActivityClass)
    elseif self.subType == 100209 then
        ---@type LabourDaySignInView 劳动节活动
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDaySignInView.Name, self.curActivityClass)
    elseif self.showType == 9 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.EasterSignInView.Name, self.curActivityClass)
    end
    -- if self.onEnterDoneCall then
    --     self.onEnterDoneCall()
    --     self.onEnterDoneCall = nil
    -- end
end

function TrainSignInModel:IsShowBtn()
    if self.showType == 2 or self.showType == 3 or self.showType == 4 then
        return false
    end
    return true
end

function TrainSignInModel:OnGetMainViewName()
    if self.showType == 1 then
        return _G.ConfigManager.ui_cfg.SignInView.Name
    elseif self.showType == 2 then
        return _G.ConfigManager.ui_cfg.FestivalSignView.Name
    elseif self.showType == 3 then
        return _G.ConfigManager.ui_cfg.JointActivitySignView.Name
    elseif self.showType == 4 then
        local _type = require("JointActivityModel"):GetInstance():GetJointActivityType()
        if _type == _G.JointActivityType.SummerFire then
            return _G.ConfigManager.ui_cfg.SummerFireSignInView.Name
        else
            return _G.ConfigManager.ui_cfg.IceFestivalSignInView.Name
        end
    elseif self.showType == 5 then
        return _G.ConfigManager.ui_cfg.IceFestivalSignInView.Name
    elseif self.showType == 7 then
        return _G.ConfigManager.ui_cfg.WinterVeilFestivalSignInView.Name
    elseif self.showType == 8 then
        return _G.ConfigManager.ui_cfg.SpringFestivalSignInView.Name
    elseif self.subType == 100209 then
        ---@type LabourDaySignInView 劳动节活动
        return _G.ConfigManager.ui_cfg.LabourDaySignInView.Name
    elseif self.showType == 9 then
        return _G.ConfigManager.ui_cfg.EasterSignInView.Name
    end
end

function TrainSignInModel:OnCheckActivityAwardDone()
    if self.showType == 1 then
        return _G.table.count(require("SignInModel"):GetInstance().g_sids) >= 7
    elseif self.showType == 2 then
        return false
    end
end
--endregion

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function TrainSignInModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPointNumChild}
    self.redpointTree = {{2}, false}
end

---检测红点
function TrainSignInModel:CheckRedPointBets()
end

---检测红点
function TrainSignInModel:CheckRedPointNumChild()
    if self.showType == 1 then
        if require "SignInModel":GetInstance():CheckIsOvers() then
            return 1
        end
    elseif self.showType == 2 then
        if require "FestivalSignInModel":GetInstance():CheckIsOvers() then
            return 1
        end
    elseif self.showType == 3 then
        if require("JointActivityModel"):GetInstance():CheckSignRedPoint(self.curActivityClass) then
           return 1 
        end
    elseif self.showType == 4 or self.showType == 5 then
        if require("IceFestivalSignInModel"):GetInstance():CheckSignRedPoint() then
            return 1
        end
    elseif self.showType == 7 then
        if require("WinterVeilFestivalSignInModel"):GetInstance():CheckSignRedPoint() then
            return 1
        end
    elseif self.showType == 8 then
        if require("SpringFestivalSignInModel"):GetInstance():CheckSignRedPoint() then
            return 1
        end
    elseif self.showType == 9 then
        if require("EasterSignInModel"):GetInstance():CheckSignRedPoint() then
            return 1
        end
    end
    return 0
end
---刷新奖励红点
function TrainSignInModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(2))
end
--endregion
---销毁对象时,析构函数
function TrainSignInModel:Dispose()
end

return TrainSignInModel