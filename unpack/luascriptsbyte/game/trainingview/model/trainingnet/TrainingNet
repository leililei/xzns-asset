local base = require("BaseGameNet")
---@class TrainingNet : BaseGameNet	中文描述
local TrainingNet = _G.BaseClass("WorldNet", base)

---@return TrainingNet WorldNet
function TrainingNet:GetInstance()
    return base.GetInstance(self)
end

---挑战
function TrainingNet:FightBoss(pbData, callback)
    local item = _G.ConfigManager.net_map.game_special_training_fight
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
    return port
end

---获取信息
function TrainingNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_special_training_info
    local pbData = self:GetEmptyPB()
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---获取奖励
function TrainingNet:GetReward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_special_training_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallBack))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function TrainingNet:CallBack(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
-- ---@type TrainingNet
-- _G.TrainingNet = TrainingNet
return TrainingNet
