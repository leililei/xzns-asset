---@class TrainingViewItem	中文描述
local TrainingViewItem = _G.BaseClass("TrainingViewItem")
-- _G.TrainingViewItem = TrainingViewItem

-- local CS = _G.CS
-- local typeof = _G.typeof

---类的构造函数
---@param section_cfg_item train_section_cfg
function TrainingViewItem:__init(obj, section_cfg_item)
    self.UIDic = {
        text = {
            --- 未通关
            -- [90024300003] = "<size=18>(未掌握)</size>",
            wtg = 90024300003
        }
    }

    self.section_cfg_item = section_cfg_item
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.go_table.gameObject:SetActiveE(1)
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_btn"] = self.OnClickSectionItem,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }

    self:Init()
end

function TrainingViewItem:Init()
end
function TrainingViewItem:SetIsSelect(isSelect)
    self.go_table.aorimage_bg:SetActiveE(isSelect and 1 or 0)
end
function TrainingViewItem:SetIsPass(isPass)
    if self.isPass == isPass then
        return
    end
    self.isPass = isPass

    local pass = require("TrainingModel"):GetInstance():IsPassChpter(self.section_cfg_item.id)
    self.go_table.aortext_yizhangwo.text = "(" .. _G.LangUtil.GetLangPackValue(90024300006) .. ")"
    self.go_table.aortext_yizhangwo1.text = "(" .. _G.LangUtil.GetLangPackValue(90024300006) .. ")"
    self.go_table.aortext_yizhangwo:SetActiveE(pass and 0 or 1)
    self.go_table.aortext_yizhangwo1:SetActiveE(pass and 0 or 1)

    local text = _G.LangUtil.GetLangPackValue(self.section_cfg_item.Name)
    if isPass == true then
    else
        text = text
    end
    self.go_table.aortext_text.text = text
    self.go_table.aortext_text1.text = text
end

function TrainingViewItem:OnClickSectionItem()
    local TrainingModel = require("TrainingModel"):GetInstance()
    -- if TrainingModel.high_section < self.section_cfg_item.pre_section then
    --     -- _G.PopWindowManager:GetInstance():ShowAllTips(1001, "前置关卡未解锁")
    --     _G.PopWindowManager:GetInstance():ShowAllTips(500103)
    --     return
    -- end
    TrainingModel:TrainingView_SetShow(self.section_cfg_item.id)
end

---按钮点击事件在这里派发
function TrainingViewItem:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

---类的析构函数
function TrainingViewItem:Dispose()
end

return TrainingViewItem
