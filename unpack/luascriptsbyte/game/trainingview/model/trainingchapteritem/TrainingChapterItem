function TrainingChapterItem:GetChpterReward()
    local id = self.trainChapterCfg_item.id
    local TrainingModel = require("TrainingModel"):GetInstance()

    if TrainingModel:IsGetReward(id) then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(1001, "奖励已领取")
        _G.PopWindowManager:GetInstance():ShowAllTips(500101)
        return
    end

    if TrainingModel:IsPass(id) then
        -- _G.PopWindowManager:GetInstance():ShowAllTips(1001, " 章节未通关")
        -- _G.PopWindowManager:GetInstance():ShowAllTips(500102)

        local awardS = {}
        for key, value in pairs(self.trainChapterCfg_item.reward) do
            table.insert(awardS, {value[1], value[2]})
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardPreView.Name, awardS)
        return
    end
    TrainingModel:GetReward(1, id)
end

---按钮点击事件在这里派发
function TrainingChapterItem:OnClickBtn(go, isOn)
    if self.condition then
        if not self.condition.enter then
            _G.PopWindowManager:GetInstance():ShowAllTips(self.condition.tipsId, self.condition.content)
            return
        end
    end
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end
---类的析构函数
function TrainingChapterItem:Dispose()
    self.go_table = nil
end

return TrainingChapterItem
