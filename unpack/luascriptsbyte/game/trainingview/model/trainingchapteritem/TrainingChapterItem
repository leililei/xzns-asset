---类的构造函数
---@param trainChapterCfg_item train_chapter_cfg
function TrainingChapterItem:__init(obj, trainChapterCfg_item, num, condition)
    self.UIDic = {
        Bg = {
            [1] = {
                di = "ui-zhtx-img-xbtx",
                jd = "ui-zhtx-img-xbtxjd",
                mask = "ui-zhtx-img-xbtx1"
            },
            [2] = {
                di = "ui-zhtx-img-jjtx",
                jd = "ui-zhtx-img-jjtxjd",
                mask = "ui-zhtx-img-jjtx1"
            },
            [3] = {
                di = "ui-zhtx-img-hjtx",
                jd = "ui-zhtx-img-hjtxjd",
                mask = "ui-zhtx-img-hjtx1"
            }
        }
    }
    --是否可以进入
    self.condition = condition
    ---设置偏移量
    self.offset = {
        Bg = {
            [1] = {
                x = 20,
                y = 137
            },
            [2] = {
                x = 7,
                y = 137
            },
            [3] = {
                x = -10,
                y = 137
            },
            [4] = {
                x = -19,
                y = 8
            }
        }
    }

    self.trainChapterCfg_item = trainChapterCfg_item
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:Init(num)
end

function TrainingChapterItem:Init(num)
    self.go_table.gameObject:SetActiveE(1)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_texun_baoxiang_effect,
        self.go_table.aorbtn_box,
        function(eff)
            if not self.go_table then
                _G.UIUtils.RemoveEffect(eff)
            end
        end
    )
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_btn"] = self.OpenView,
        ["@_aorbtn_box"] = self.GetChpterReward,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
    self:UpdataInfo(num)
end
