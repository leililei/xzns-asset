function TrainingChapterItem:UpdataInfo(num)
    local chapterId = self.trainChapterCfg_item.id
    local TrainingModel = require("TrainingModel"):GetInstance()
    local passCount = TrainingModel:GetChapterPassCount(chapterId)
    local maxCount = TrainingModel:GetChapterMaxCount(chapterId)
    local text
    if passCount >= maxCount then
        text = _G.LangUtil.GetLangPackValue(90024300005)
    else
        text = _G.LangUtil.GetLangPackValue(90024300006)
        self.go_table.aortext_jd.text =
            string.format(
            "<color=#23d56a>%d</color>/%d",
            TrainingModel:GetChapterPassCount(chapterId),
            TrainingModel:GetChapterMaxCount(chapterId)
        )
    end

    local BGgDic = self.UIDic.Bg[chapterId]
    if BGgDic == nil then
        BGgDic = self.UIDic.Bg[1]
    end
    self.go_table.aorimage_di.SpriteName = BGgDic.di
    self.go_table.aorimage_mask.SpriteName = BGgDic.mask
    self.go_table.aorimage_mask:SetNativeSize()
    --检测 副本限制条件
    local str = ""
    local limit_condition = self.trainChapterCfg_item.limit_condition
    if not _G.table.isEmptyOrNil(limit_condition) then
        local flag = _G.GlobalConditionManager.CheckCondition(limit_condition[1], limit_condition[2])
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, not flag)
        if num == 3 then
            self.go_table.obj_mask:SetLocalPosition(-19, 57, 0)
            self.go_table.aortext_mask:SetLocalPosition(-9, -123, 0)
        elseif num == 1 then
            self.go_table.aortext_mask:SetLocalPosition(16, -123, 0)
            self.go_table.obj_mask:SetLocalPosition(0, 49, 0)
        else
            self.go_table.aortext_mask:SetLocalPosition(5, -123, 0)
            self.go_table.obj_mask:SetLocalPosition(0, 49, 0)
        end
        if not flag then
            local chapter, section = self:GetStrWithType(limit_condition[1], limit_condition[2])
            str = _G.LangUtil.GetLangPackValue(90028010108, chapter, section)
        end
    end
    self.go_table.aortext_mask.text = str
    self.go_table.aorimage_di:SetNativeSize()
    self.go_table.aorimage_jd.fillAmount = passCount / maxCount

    self.go_table.aorimage_jd.SpriteName = BGgDic.jd

    self.go_table.aorimage_box:SetGray(TrainingModel:IsGetReward(chapterId))
    self.go_table.aortext_jd:SetActiveE(passCount < maxCount and 1 or 0)
    self.go_table.aortext_txt.text = text
    self.go_table.aortext_txt:SetActiveE(passCount < maxCount and 1 or 0)
    if TrainingModel:IsGetReward(chapterId) then
        self.go_table.aortext_WanCheng:SetActiveE(passCount <= maxCount and 1 or 0)
        self.go_table.aorimage_box:SetActiveE(passCount <= maxCount and 0 or 1)
    else
        self.go_table.aorimage_box:SetActiveE(passCount < maxCount and 0 or 1)
    end

    if TrainingModel.diyc < 3 then
        self.go_table.aorimage_jd:SetAnchorPosition(self.offset.Bg[num].x, self.offset.Bg[num].y)
        if num == 3 then
            self.go_table.aorimage_di:SetAnchorPosition(self.offset.Bg[num + 1].x, self.offset.Bg[num + 1].y)
            self.go_table.aorimage_jd:SetAnchorPosition(self.offset.Bg[num].x, self.offset.Bg[num].y)
        end
        TrainingModel.diyc = TrainingModel.diyc + 1
    end
end

