end
---通用布阵打开选择英雄界面回调
function TrainEmbattleView:SetIntoCount(show)
    ---可上阵英雄数量
    if show ~= nil then
        self.show = show
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_count, self.show)
    self.go_table.aortext_count.text =
        _G.LangUtil.GetLangPackValue(90024900046, self.embattleView.curEmbattleItem:GetEmbattleCount())
end

function TrainEmbattleView:SetTips()
    local langID
    for i = 1, 3 do
        langID = self.train_section_cfgItem.desc[i]
        if langID ~= nil then
            self.Tips_Table["aortext_tips" .. i].text = _G.LangUtil.GetLangPackValue(langID)
        end
        self.Tips_Table["obj_tips" .. i]:SetActiveE(langID ~= nil and 1 or 0)
    end
end

return TrainEmbattleView
