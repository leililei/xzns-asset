local EmbattleController = require "EmbattleController"
---@class TrainEmbattleView : UIBaseView	中文描述
---@field public go_table TrainEmbattleView_GoTable GoTable
local TrainEmbattleView = _G.BaseClass("TrainEmbattleView", _G.UIBaseView)
function TrainEmbattleView:Awake()
end

---界面的入口函数
---@param data Params_EmbattleItemPVE_Train
function TrainEmbattleView:OnCreate(exitCall, battleCall, mgpID, data)
    self.Tips_Table = _G.GetAutoGoTable(self.go_table.obj_tips)
    self.onExitCall = exitCall
    self.onBattleCall = battleCall

    self.Data = data
    ---@type train_section_cfg
    self.train_section_cfgItem = _G.ConfigManager.train_section_cfg[self.Data.sectionId]

    self:OpenEmbattleView(mgpID, data)
end

function TrainEmbattleView:OnStartClose()
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleChooseViewClosed, self)
end

function TrainEmbattleView:OnDestroy()
end
function TrainEmbattleView:OpenEmbattleView(mgpID, data)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnEmbattleChooseViewClosed, self)

    EmbattleController:GetInstance():OpenEmbattle(
        _G.EmbattleType.trainBattle + data.sectionId,
        _G.EmbattleSaveType.localfile,
        true,
        _G.EmbattleControllerItemType.train,
        _G.handler(self, self.OnExitCall),
        _G.handler(self, self.OnBattleCall),
        mgpID,
        data,
        _G.handler(self, self.SetIntoCount),
        false
    )
    self:GetCombineSkillState(data.sectionId)
end

---获取合击技能状态
function TrainEmbattleView:GetCombineSkillState(sectionId)
    self.go_table.aorimage_bg1:SetActiveE(0)
    self.go_table.aorimage_bg2:SetActiveE(0)
    self.go_table.aorimage_bg3:SetActiveE(0)
    if _G.table.count(_G.ConfigManager.train_section_cfg[sectionId].skills) == 1 then
        self.go_table.aorimage_bg2:SetActiveE(1)
        self.go_table.aorimage_bg3:SetActiveE(1)
    elseif _G.table.count(_G.ConfigManager.train_section_cfg[sectionId].skills) == 2 then
        self.go_table.aorimage_bg3:SetActiveE(1)
    end
end

function TrainEmbattleView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
        self.onExitCall = nil
    end
end
function TrainEmbattleView:OnBattleCall()
    self:Close()
    if self.onBattleCall then
        self.onBattleCall()
        self.onBattleCall = nil
    end
end

---监听界面打开
---@param name string 界面名称
function TrainEmbattleView:OnEmbattleViewOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleViewOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.embattleView:RegiestChooseViewOpen(_G.handlerbind(self, self.SetIntoCount))
        self.embattleView:RegiestRoleUpOrDownOpen(_G.handlerbind(self, self.SetIntoCount))
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder
        )
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
        self:SetInfo()

        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ActivityView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.TrainingView.Name)
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.TrainingChapterView.Name)
    --_G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    end
end
