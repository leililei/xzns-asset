function TrainingView:SetData(Data)
    local cfg = _G.ConfigManager.train_section_cfg

    --- 关卡Item ={关卡id=train_section_cfg}
    ---@type table<id,train_section_cfg>
    self.SectionCfgDic = {}

    --- 关卡Item ={关卡id=TrainingViewItem}
    ---@type table<id,TrainingViewItem>
    self.SectionItemLuaDic = {}

    ---@param section_cfg_item train_section_cfg
    for key, section_cfg_item in pairs(cfg) do
        if section_cfg_item.chapter == self.Data.chapterId then
            self.SectionCfgDic[key] = section_cfg_item
        end
    end
    --- 当前可挑战关卡  否则显示 第一关
    local NowSectionId, oneSectionId

    for _, sectionId in pairs(self.tarinModel.sectionListDic[self.Data.chapterId]) do
        --- 有序显示
        self:SetItem(self.SectionCfgDic[sectionId])
        if NowSectionId == nil and self.tarinModel:IsPassChpter(sectionId) then
            NowSectionId = sectionId
        end
        if oneSectionId == nil then
            oneSectionId = sectionId
        end
    end

    if NowSectionId == nil then
        NowSectionId = self.tarinModel.sectionListDic[self.Data.chapterId][1]
    end
    self:SetInfo(NowSectionId)
end

---@param section_cfg_item train_section_cfg
function TrainingView:SetItem(section_cfg_item)
    local sectionId = section_cfg_item.id
    local luaItem = require("TrainingViewItem")
    local tran, TrainingViewItem
    tran = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_Content)
    TrainingViewItem = luaItem.New(tran, section_cfg_item)
    self.SectionItemLuaDic[sectionId] = TrainingViewItem
end

function TrainingView:SetInfo(sectionId)
    if self.sectionId == sectionId then
        return
    end
    local cfg = _G.ConfigManager.train_section_cfg
    local path = cfg[sectionId]
    local pos = cfg[sectionId]
    if path == nil then
        path = cfg[101].boss_preview
        pos = cfg[101].pos_portrait
    else
        path = cfg[sectionId].boss_preview
        pos = cfg[sectionId].pos_portrait
    end
    self.go_table.aorrawimage_Role:LoadImage(path)
    if _G.table.count(pos) > 0 then
        self.go_table.aorrawimage_Role:SetAnchorPosition(pos[1][1], pos[1][2])
    end

    local section_cfg_item = self.SectionCfgDic[sectionId]
    if section_cfg_item == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("train_section_cfg  sectionId is nil " .. tostring(sectionId))
        end
        return
    end
    local oldLua = self.SectionItemLuaDic[self.sectionId]
    if oldLua ~= nil then
        oldLua:SetIsSelect(false)
    end
    self.sectionId = sectionId
    self.SectionItemLuaDic[self.sectionId]:SetIsSelect(true)

    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(section_cfg_item.Name)
    self.section_cfg_item = section_cfg_item.desc
    self:SetTips(section_cfg_item)
    self:UpdataInfo()
end

