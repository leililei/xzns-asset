function TrainingView:OnItemCall(index, obj)
    if index < 0 then
        return
    end
    local item = _G.GetAutoGoTable(obj)
    local langID = self.section_cfg_item[index + 1]
    item.aortext_tips.text = _G.LangUtil.GetLangPackValue(langID)
    return item
end

