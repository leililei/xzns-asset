function TrainingView:OnCreate(Data)
    self.Data = Data
    self.ResLoadCompleteCall = _G.handlerbind(self, self.SetData, Data)

    --- 当前选择关卡id
    self.sectionId = nil

    local pathDic = {
        [1] = "Images/TXT/nTrainingChapter/ui-zhtx-txt-xbtx",
        [2] = "Images/TXT/nTrainingChapter/ui-zhtx-txt-jjtx",
        [3] = "Images/TXT/nTrainingChapter/ui-zhtx-txt-hjtx"
    }
    local path = pathDic[self.Data.chapterId]
    self.go_table.scrollloopvectical_tips:InitItemData(0, _G.handler(self, self.OnItemCall))
    if path == nil then
        path = pathDic[1]
    end
    self.go_table.aorrawimage_xbtx:LoadImage(path)
end
