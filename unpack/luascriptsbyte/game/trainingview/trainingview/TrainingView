function TrainingView:LoadImage(rawImage, path, card_cfgItem, call)
    rawImage.Alpha = 0
    ---@param image AorImage
    rawImage:LoadImage(
        path,
        function(image)
            if image.mShowImageRef then
                local pos =
                    _G.Vector3.New(
                    card_cfgItem.pos_portrait6[1] or 0,
                    card_cfgItem.pos_portrait6[2] or 0,
                    card_cfgItem.pos_portrait6[3] or 0
                )
                local size = card_cfgItem.size5 > 0 and card_cfgItem.size5 or 1
                image:SetAnchorPosition(pos.x, pos.y)
                image:SetLocalScaleXYZ(size)

                image:SetNativeSize()
                rawImage.Alpha = 1

                if call ~= nil then
                    call(image)
                end
            end
        end
    )
    -- body
end
function TrainingView:SetInfo_reward(reward)
    if _G.table.isEmptyOrNil(reward) then
        return
    end

    local ItemViewBase = require("ItemViewBase")
    if self.RewardItemDic ~= nil then
        ---@param luaItem ItemViewBase
        for key, luaItem in pairs(self.RewardItemDic) do
            if luaItem.gameObject ~= nil then
                ItemViewBase.Despawn(luaItem)
            end
        end
    end
    self.RewardItemDic = {}

    local isGet = self.tarinModel:IsGetReward(self.sectionId)
    ---   没领取过 且可以领取 (true可领取 显示领取特效)
    local isHaveGet = false
    if isGet == false and self.tarinModel:IsPassChpter(self.sectionId) then
        isHaveGet = true
    end
    local id, num
    for i = 1, #reward do
        id = reward[i][1]
        num = reward[i][2]
        self:SetInfo_reward_Create(id, num, isGet, isHaveGet)
    end
end
function TrainingView:SetInfo_reward_Create(id, num, isGet, isHaveGet)
    if self.RewardItemDic[id] == num then
        return
    end

    local ItemViewBase = require("ItemViewBase")

    ---占位 防止异步多次加载
    self.RewardItemDic[id] = num
    ---@param luaItem ItemViewBase
    _G.StorageManager:GetInstance():GetItemBaseView(
        id,
        num,
        self.go_table.obj_reward,
        function(luaItem)
            if self.RewardItemDic[id] ~= num then
                ItemViewBase.Despawn(luaItem)
                return
            end

            luaItem:SetGou(not (isHaveGet))
            luaItem:ShowNumText(true, ItemViewBase.NumTextAnchor.RightDown)
            self.RewardItemDic[id] = luaItem

