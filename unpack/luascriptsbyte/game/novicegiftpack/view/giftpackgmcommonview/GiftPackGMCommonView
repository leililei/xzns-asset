local DrawUpCoinModel = require("DrawUpCoinModel")
local MallManager = require("MallManager")

---@class GiftPackGMCommonView : UIBaseView    中文描述
---@field public go_table GiftPackGMCommonView_GoTable GoTable
---@field model_data activity_cash_gift.i_cash_gift[]
local GiftPackGMCommonView = _G.BaseClass("GiftPackGMCommonView", _G.UIBaseView)
local StorageManager, UIUtils

function GiftPackGMCommonView:Awake()
    UIUtils = _G.UIUtils
    StorageManager = _G.StorageManager:GetInstance()
    self.mScorll = nil
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    ---可购买文本显示时的次数
    self.limitTimesCond = _G.ConfigManager.discrete_cfg[106208][1][1]
end

---界面的入口函数
function GiftPackGMCommonView:OnCreate(data, type_enum, iconID)
    self.ActivityID = data.activityID
    self.iconID = iconID
    self.subType = data:GetJumpType()
    self:UpdateView(data, type_enum)
    self:UIEffect()

    local endtime, _ = data:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State.Close)
    local starttime, _ = data:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State.Open)
    local type = require("JointActivityModel"):GetInstance():GetJointActivityType()
    if type == _G.JointActivityType.SpringFestival then
        self.endtime = endtime
        self:UpdateTime()
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, _G.handler(self, self.UpdateTime))
        self.timer:Start()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(
                90025800003, "<color=#96ce51>" ..
                        _G.TimeUtil.TransTimegifStarToEnd(
                                starttime,
                                endtime
                        ) .. "</color>"
        )
    end
    
end

---@param index number
function GiftPackGMCommonView:RefreshItem(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = self.list2[i]
    if data == nil then
        return
    end
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(0)
    self:UpdateCommonItem(objGame, data)
end

function GiftPackGMCommonView:RefreshListTop(index, objGame)
    if index < 0 then
        return
    end
    local i = index + 1
    local data = self.list1[i]
    if data == nil then
        return
    end
    local itemGoTable = _G.GetAutoGoTable(objGame, _G.handlerbind(self, self.OnClick_item, data))

    itemGoTable.obj_special:SetActiveE(1)
    self:UpdateCommonItem(objGame, data)
end

function GiftPackGMCommonView:UpdateTime()
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000000988)
        .. _G.TimeUtil.TranslateSecondForStrMiaoHui(self.endtime - _G.TimeUtil.GetServerUnixTime()
    )
end

---@param obj SuperScrollView.LoopListViewItem2
---@param data activity_cash_gift.i_cash_gift
function GiftPackGMCommonView:UpdateCommonItem(obj, data)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.itemOnClickBtn, data))
    local limit = data.count_limit
    if self.type_enum == 2 then
        limit = data.count
    end
    local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
    local soldOut = limit == buy_num
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_star, true, nil, nil, nil, data.consume_type == 0 and data.price or 0)

    if limit - buy_num > self.limitTimesCond or soldOut then
        tb.aortext_num:SetActiveE(0)
    else
        tb.aortext_num:SetActiveE(1)
        local lang = data.type_reset == 1 and 90031400013 or 90021600042
        tb.aortext_num.text = _G.LangUtil.TryGetLangValue(lang, limit - buy_num)
    end
    tb.aorbtn_star:SetActiveE(soldOut and 0 or 1)
    tb.obj_soldout:SetActiveE(soldOut and 1 or 0)
    tb.aortext_giftname.text = data.name
    tb.aortext_discount.text = math.floor(data.discount * 0.01) .. "%"
    tb.obj_redpoint:SetActiveE(data.price <= 0 and 1 or 0)
    if data.price == 0 then
        tb.aortext_price.text = ""
        tb.aortext_price.text = _G.LangUtil.TryGetLangValue(90023900001)
    elseif data.consume_type == 0 then
        _G.GameUtil.SetPriceByChannel(data.price, tb.aortext_price)
    else
        tb.aortext_price.text = data.price
        local item = _G.StorageManager:GetInstance():GetItemDataClassByCfg({ data.consume_type, data.price })
        if item then
            tb.aorrawimage_icon:LoadImage(item.Icon)
        end
    end
    tb.aorrawimage_icon:SetActiveE(data.consume_type == 0 and 0 or 1)
    local awrad = data.goods
    tb.obj_AwardNode:RemoveAllChildren()
    for j = 1, #awrad do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            awrad[j],
            tb.obj_AwardNode,
            function(item)
                item.gameObject:SetLocalScaleXYZ(0.9)
                item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                item:SetGou(soldOut)
                if item.cfg then
                    item:ShowEffectOrder(item.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

--- 判断特殊礼包是否能购买
function GiftPackGMCommonView:CheckIsCanbuy()
    local data = self.data

    if #self.model_data > 0 then
        self.spDataId = self.model_data[1].sid
        local buy_num = data.typeClass:GetItemBuyTimes(self.model_data[1].id or self.model_data[1].sid,
            self.model_data[1].type_reset)
        local limit = self.model_data[1].count_limit or self.model_data[1].count

        if buy_num >= limit then
            self.isCanBuy = false
        end

        for i = 2, #self.model_data do
            if self.spDataId > self.model_data[i].sid then
                self.spDataId = self.model_data[i].sid
                local buy_num = data.typeClass:GetItemBuyTimes(
                    self.model_data[i].id or self.model_data[i].sid,
                    self.model_data[i].type_reset)
                local limit = self.model_data[i].count_limit or self.model_data[i].count

                if buy_num >= limit then
                    self.isCanBuy = false
                end
            end
        end
    end
end

---刷新
function GiftPackGMCommonView:UpdateView(data, type_enum)
    --self.model_data = data.typeClass.model_cfg
    data.typeClass:UpdateDynamicData(self.ActivityID)
    self.model_data = data.typeClass:GetModelCfgByCondition(self.ActivityID)
    self.isCanBuy = true
    self.data = data

    self:CheckIsCanbuy()

    self.typeClass = data.typeClass
    if type_enum then
        self.type_enum = type_enum
    else
        self.type_enum = 1
    end

    self:UpDateScorllView()
end

