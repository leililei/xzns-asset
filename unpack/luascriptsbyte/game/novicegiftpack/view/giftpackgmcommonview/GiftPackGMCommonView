function GiftPackGMCommonView:UIEffect()
    local RemoveEffect = UIUtils.RemoveEffect
    local LoadEffectByCfg = UIUtils.LoadEffectByCfg
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(obj)
        if self:IsNil() then
            RemoveEffect(obj)
        end
    end
    local lihuiPath, isImage = self.typeClass:GetLiHuiPath()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorrawimage_1, lihuiPath and isImage)
    _G.GameUtil.SetActiveByCondition(self.go_table.trans_spine, lihuiPath and not isImage)
    if not _G.string.IsNullOrEmpty(lihuiPath) then
        local scale = self.typeClass:GetLiHuiScale()
        local pos = self.typeClass:GetLiHuiPos()
        if isImage then
            self.go_table.aorrawimage_1:LoadImage(
                lihuiPath,
                function(image)
                    image:SetNativeSize()
                    image:SetLocalPosition(pos[1], pos[2], pos[3])
                    image:SetLocalScaleXYZ(scale)
                end
            )
        else
            _G.PoolsManager:GetInstance():Spawn(
                lihuiPath,
                _G.ePoolType.UIItem,
                self.go_table.trans_spine,
                function(tran)
                    if self:IsNil() then
                        tran:DestroyObject()
                        return
                    end
                    tran:SetLocalPosition(pos[1], pos[2], pos[3])
                    tran:SetLocalScaleXYZ(scale)
                end
            )
        end
    end
    local exchangeShow = self.data.typeClass.curActivityClass.cfg.info.front.exchange_show
    self.go_table.aorrawimage_2:SetActiveE(exchangeShow and 1 or 0)
    if exchangeShow then
        local dev = _G.string.split(exchangeShow.dev, "#")
        local pos = { dev[1], dev[2], dev[3], dev[4] }
        self.go_table.aorrawimage_2:LoadImage(
            exchangeShow.pos,
            function(image)
                image:SetNativeSize()
                image:SetLocalPosition(pos[1], pos[2], pos[3])
                image:SetLocalScaleXYZ(pos[4])
            end
        )
    end
end

---界面的销毁函数
function GiftPackGMCommonView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---按钮点击事件在这里派发
function GiftPackGMCommonView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Close then
        self:CloseView()
    end
end

function GiftPackGMCommonView:CloseView()
    self:Close()
end

function GiftPackGMCommonView:itemOnClickBtn(go, isOn, giftinfo)
    if not self.data:CheckActivityInteractable() then
        return
    end
    self.cashData = giftinfo

    self.Number = 0
    for i = 1, #self.cashData.award do
        if self.iconID and self.cashData.award[i].type[1] == self.iconID then
            self.Number = self.Number + self.cashData.award[i].type[2]
        end
    end

    self.typeClass:Chongzhi(
        giftinfo,
        function()
            if self:IsNil() then
                return
            end
            self.mlistView1 = nil
            self.mlistView2 = nil
            --这里保留一个回调处理领奖
            self:UpDateScorllView()
            if not self.typeClass:CheckOtherConditionExtra() then
                -- self.data:ChangeState(1) -- 改变状态 关闭
            end
            if self.iconID then
                _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { self.iconID, self.Number })
            end
        end
    )
end

function GiftPackGMCommonView:UpDateScorllView()
    self.index = 0
    self:CheckIsCanbuy()

    _G.SortList(
        self.model_data,
        function(data)
            local num = 10
            local buy_num = self.typeClass:GetItemBuyTimes(data.id or data.sid, data.type_reset)
            local limit = data.count_limit or data.count
            --local paixu = data.display_priority or data.price
            if buy_num == limit then
                num = 9
            end
            return num, -data.sid
        end
    )

    self.list1 = {}
    self.list2 = {}

    local topHeight, itemHeight
    if not self.isCanBuy then
        topHeight = 0
        itemHeight = 710
        self.list2 = self.model_data
    else
        topHeight = 194
        itemHeight = 530
        for i = 1, #self.model_data do
            if i == 1 then
                table.insert(self.list1, self.model_data[i])
            else
                table.insert(self.list2, self.model_data[i])
            end
        end
    end

    self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(topHeight)
    self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(itemHeight)

    if self.mlistView1 == nil then
        self.mlistView1 = self.go_table.scrollloopvectical_top
        self.go_table.scrollloopvectical_top:InitItemData(table.count(self.list1), _G.handler(self, self.RefreshListTop))
    else
        self.mlistView1:UpdateAllItem()
    end
    if self.mlistView2 == nil then
        self.go_table.scrollloopvectical_item:InitItemData(table.count(self.list2), _G.handler(self, self.RefreshItem))
        self.mlistView2 = self.go_table.scrollloopvectical_item
    else
        self.mlistView2:UpdateAllItem()
    end
end

function GiftPackGMCommonView:OnMallCashListener(data)
    if not self.typeClass:CheckOtherConditionExtra() then
        self.data:ChangeState(1) -- 改变状态 关闭
    end
    -- self.cashData = nil
end

function GiftPackGMCommonView:OnDestroy()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
end

return GiftPackGMCommonView
