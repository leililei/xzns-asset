---@class MTLimitTimeDropView : UIBaseView	中文描述
---@field public go_table NoviceGiftPackView_GoTable GoTable
local MTLimitTimeDropView = _G.BaseClass("MTLimitTimeDropView", _G.UIBaseView)

function MTLimitTimeDropView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MTLimitTimeDropView:OnCreate(activity)
    self.activity = activity
    self:UpdateItems()
    self:FreshTips()
    self.go_table.aortext_num.text = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    local coinCfg = _G.ConfigManager.currency_type_client_cfg[125]
    self.go_table.aorrawimage_icon:LoadImage(coinCfg.icon)
    self:TimesNew()
    self.timeTimer = _G.TimerManager:GetInstance():GetTimer(1, self.TimesNew, self)
    self.timeTimer:Start()
    self.go_table.obj_goRedpoint:UpdateRedPointItemIDAndParam(self.activity.typeClass:GetRedpointIDByIndex(1))
end

function MTLimitTimeDropView:UpdateItems()
    local act = require "ActivitySynManager":GetInstance():GetChildAcitivity(10005,10052)
    local data
    if act then 
        data = act.typeClass.SelfData
    end
    for i = 1, 4 do
        local tb = _G.GetAutoGoTable(self.go_table["obj_item" .. i])
        tb.gameObject:SetActiveE(0)
        if self.activity.typeClass.info.coin[i] then
            tb.obj_item:ClearChildren()
            tb.item = nil
            local T = {self.activity.typeClass.info.coin[i].k, 1}
            _G.StorageManager:GetItemBaseViewNew(
                T,
                tb.obj_item,
                function(tran)
                    tran:ShowNumText(false)
                    tran.gameObject:SetLocalScaleXYZ(1)
                    tran.gameObject:SetRectTransformSize(88, 88)
                    tb.item = tran
                    if tb.item.SetGradeNew then
                        tb.item:SetGradeNew(false)
                    end
                end
            )
            tb.gameObject:SetActiveE(1)
        end
    end
end

---时间刷新
function MTLimitTimeDropView:TimesNew()
    local time
    local settlementTime, countdown1 = self.activity:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State.Settlement)
    if countdown1 > 0 then 
        time = _G.TimeUtil.TranslateSecondForStr(countdown1)
        self.go_table.aortext_time.text = GetLangPackValue(90027600008, time)
        return 
    end
    local endTime, countdown2 = self.activity:GetActivityDeadLineByCondition(require "ActivitySynManager":GetInstance().State.Close)
    if countdown2 > 0 then 
        time = _G.TimeUtil.TranslateSecondForStr(countdown2)
        self.go_table.aortext_time.text = GetLangPackValue(90027600009, time)
    else 
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.NoviceGiftPackToggleView.Name)
        if view then
            view:Close()
        end
    end
end

function MTLimitTimeDropView:FreshTips()
    self.go_table.obj_content:ClearChildren()
    local txt = _G.GetLangPackValue(_G.ConfigManager.instruction_cfg[198].describe)
    self.textList = string.split(txt, "\n")
    for k, v in ipairs(self.textList) do 
        local obj = _G.InstantiateObject(self.go_table.obj_textObj, self.go_table.obj_content)
        local tb = _G.GetAutoGoTable(obj)
        tb.aortext_tips.text = v
    end
    _G.DelayDo(0.1,
    function(...)
        _G.GameUtil.ReBuildRTF(self.go_table.obj_content)
    end)
end

function MTLimitTimeDropView:ResUpdata(data)
    for _, v in pairs(data) do
        if v.type[1] == 125 then
            self.go_table.aortext_num.text = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
        end
    end
end

---按钮点击事件在这里派发
function MTLimitTimeDropView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_goto then 
        _G.JumpManager:GetInstance():Jump(122001)
    elseif go == self.go_table.aorbtn_close then 
        self:Close()
    elseif go == self.go_table.aorbtn_add then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 125)
    end
end

---界面的销毁函数
function MTLimitTimeDropView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    if self.timeTimer then
        self.timeTimer:Stop()
        self.timeTimer = nil
    end
end

return MTLimitTimeDropView