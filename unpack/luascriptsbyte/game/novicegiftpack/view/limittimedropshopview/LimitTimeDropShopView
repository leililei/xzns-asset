function LimitTimeDropShopView:Sortfunc(data)
    if not _G.table.isEmptyOrNil(data) then
        _G.SortList(
            data,
            function(a)
                --local NeedItem = a.NeedItem[1]
                local IsEnd = a.State == 0 and 0 or 1
                --return isCanTake, a.State,-NeedItem.num
                return IsEnd
            end
        )
    end
end

function LimitTimeDropShopView:SetView()
    local data = self.TypeCls:GetCurActivitySelfData()
    self.go_table.aortext_num.text = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
    self.coinCfg = _G.ConfigManager.currency_type_client_cfg[self.TypeCls:GetCoinSid()]
    self.go_table.aorrawimage_icon:LoadImage(self.coinCfg.icon)
    local count = #data
    self:Sortfunc(data)
    if not self.count then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
            #self.TypeCls:GetCurActivitySelfData(),
            _G.handler(self, self.RefreshItem)
        )
        self.count = count
    else
        if self.count ~= count then
            self.go_table.scrollloopvectical_ItemList:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
        end
    end
end

function LimitTimeDropShopView:RefreshItem(index, obj)
    local ide = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local data = self.TypeCls:GetCurActivitySelfData()
    local tb = _G.GetAutoGoTable(obj)
    if data[x] then
        tb.data = data[x]
        tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb, ide)
        self:CreateItem(tb, ide)
    end
end
