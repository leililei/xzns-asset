function LimitTimeDropShopView:CreateItem(tb, ide)
    local data = tb.data
    local item = self.ItemList[ide]
    local getItem = function(_data, p, type, eff)
        -- if eff ~= nil then
        --     if item then
        --         if item.eff then
        --             _G.PoolsManager:GetInstance():Despawn(item.eff.gameObject, _G.ePoolType.UIEffect)
        --         end
        --         _G.PoolsManager:GetInstance():Despawn(item.gameObject, _G.ePoolType.UIItem)
        --     end
        -- else
        --     for i = 1, p:GetChildCountE() do
        --         _G.PoolsManager:GetInstance():Despawn(p:GetChildE(0), _G.ePoolType.UIItem)
        --     end
        -- end
        _G.StorageManager:GetInstance():GetItemBaseView(
            _data.sid,
            _data.num,
            p,
            function(tran)
                tran.gameObject:SetName(_data.sid)
                tran.sid = _data.sid
                tran.gameObject:SetLocalPosition(0, 0, 0)
                if type then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
                if tran.SetGradeNew then
                    tran:SetGradeNew(false)
                end
                self.ItemList[ide] = tran
                -- if eff == true then
                --     self:LoadEff(tran, _data.sid)
                -- end
                --tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
            end,
            function(go)
                require "CommonTipManager":GetInstance():OpenTip(p, go.sid or go[1].sid)
            end
        )
    end
    local NeedItem = data.NeedItem[1]
    local GetItem = data.GetItem[1]
    tb.aortext_MaterialNum.text = data.NeedItem[1].num
    tb.aorrawimage_Material:LoadImage(self.coinCfg.icon)
    local myCount = 0
    if NeedItem.sid == 101 then --活动代币（恶灵入侵）
        myCount = require "MonsterSiegeManager":GetInstance():GetCoinActivity()
    elseif NeedItem.sid == 103 then
        myCount = require "ArenaFairManager":GetInstance():GetCoin()
    elseif NeedItem.sid == 104 then
        myCount = require "GuessGameModel":GetInstance():GetCoin()
    elseif NeedItem.sid == 109 then
        myCount = require "SixVsSixCoinModel":GetInstance():GetCoin()
    elseif NeedItem.sid == 125 then
        myCount = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
    else
        local _, storageId = _G.StorageManager:GetInstance():CheckSidType(NeedItem.sid)
        myCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, NeedItem.sid)
    end
    local IsCanTake = myCount >= NeedItem.num and data.State == 1
    --_G.GameUtil.SetActiveByCondition(tb.aorimage_gou, data.isGou > 0)
    tb.aorbtn_Btn:SetActiveE(data.State == 1 and 1 or 0)
    --tb.aorbtn_gray:SetGray(data.State == 0)
    tb.obj_SellOut:SetActiveE(data.State == 0 and 1 or 0)
    tb.exchange = nil
    tb.aorimage_recommend:SetActiveE(data.recommend == 1 and 1 or 0)
    tb.aortext_itemname.text = _G.StorageManager:GetInstance():GetItemName(GetItem.sid)
    -- tb.obj_isTips:SetActiveE(data.ShowGou and 1 or 0)
    -- tb.aorbtn_gou:SetActiveE(data.ShowGou and 1 or 0)
    -- _G.GameUtil.SetActiveByCondition(tb.obj_getEff, data.ShowGou and IsCanTake and data.isGou > 0)
    if myCount >= NeedItem.num then
        -- tb.aortext_rootPercent.text = _G.GameUtil.NumberToUnitStrFight(myCount) .. "/" .. NeedItem.num
        tb.aortext_num.text = NeedItem.num
    else
        tb.exchange = tipId.noItem
        tb.aortext_num.text =
            --"<color=red>" .. _G.GameUtil.NumberToUnitStrFight(myCount) .. "</color>" .. "/" .. NeedItem.num
        NeedItem.num
    end
    local remainCount = data.LimitTime - data.ExchangeTime --剩余可兑换次数
    if data.State == 1 then
        if remainCount <= 0 then
            tb.aortext_num.text =
                GetLangPackValue(90000000961) ..
                "(" .. "<color=red>" .. remainCount .. "</color>" .. "/" .. data.LimitTime .. ")"
        else
            tb.aortext_num.text =
                GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.LimitTime .. ")"
        end
    else
        tb.exchange = tipId.limitCount
        --tb.aortext_percent.text = remainCount .. "/" .. data.LimitTime
        if remainCount <= 0 then
            tb.aortext_num.text =
                GetLangPackValue(90000000961) .. "(<color=red>" .. remainCount .. "</color>/" .. data.LimitTime .. ")"
        else
            tb.aortext_num.text =
                GetLangPackValue(90000000961) .. "(" .. remainCount .. "/" .. data.LimitTime .. ")"
        end
    end
    --getItem(NeedItem, tb.obj_itemfrom, false)
    getItem(GetItem, tb.obj_itemRoot, true, IsCanTake)
end

function LimitTimeDropShopView:ResUpdata(data)
    for _, v in pairs(data) do
        if v.type[1] == 125 then
            self.go_table.aortext_num.text = require "LimitTimeDropCoinModel":GetInstance():GetCoin()
        end
    end
end

---按钮点击事件在这里派发
function LimitTimeDropShopView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then 
        self:Close()
    elseif go == self.go_table.aorbtn_add then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 125)
    end
end

---界面的销毁函数
function LimitTimeDropShopView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return LimitTimeDropShopView