function NoviceGiftPackView:InitToggle()
    self.toggles = {
        [1] = _G.GetAutoGoTable(
            self.go_table.toggle_gift1,
            _G.handlerbind(self, self.OnClickToggle, 1, _G.handler(self, self.InitView))
        ),
        [2] = _G.GetAutoGoTable(
            self.go_table.toggle_gift2,
            _G.handlerbind(self, self.OnClickToggle, 2, _G.handler(self, self.RefreshTotalCash))
        ),
        [3] = _G.GetAutoGoTable(
            self.go_table.toggle_gift3,
            _G.handlerbind(self, self.OnClickToggle, 3, _G.handler(self, self.RefreshContinueCash))
        )
    }
    self.redpointIds = {
        _G.ConfigManager.redpoint_cfg.NoviceGiftPack.id
    }
    for key, v in pairs(self.toggles) do
        if self.redpointIds[key] then
            v.obj_redpoint:UpdateRedPointItemIDAndParam(self.redpointIds[key])
        end
    end
    self.toggles[1].isOn = true
    self:OnClickToggle(self.go_table.toggle_gift1, true, 1, _G.handler(self, self.InitView))
end

function NoviceGiftPackView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOff:SetActiveE(not isOn and 1 or 0)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    if isOn and call then
        call()
    end
end

function NoviceGiftPackView:RefreshListViewTop(index, obj)
    local data = self.giftListTop[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGiftItem, data))
    if not data then
        return
    end
    if not data.name or data.name == 0 then
        tb.aortext_title.text = ""
        tb.obj_special:SetActiveE(1)
        tb.obj_awardGrid:ClearChildren()
        if data.goods then
            for _, v in ipairs(data.goods) do
                _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        v,
                        tb.obj_awardGrid,
                        function(item)
                            item.gameObject:SetLocalScaleXYZ(0.85)
                            if self:IsNil() then
                                _G.DestroyObject(item.gameObject)
                                return
                            end
                            if item.ShowNumText then
                                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                            end
                            if item.SetGradeNew then
                                item:SetGradeNew(false)
                            end
                        end
                )
            end
        end
        if #data.goods > 4 then
            tb.obj_ScrollRect:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).horizontal = true
        end
        local buyCount = self.model.buyList[data.id] or 0
        tb.obj_sellOut:SetActiveE(buyCount >= data.count_limit and 1 or 0)
        tb.obj_btn:SetActiveE(buyCount < data.count_limit and 1 or 0)
        if buyCount < data.count_limit then
            if data.type_price == 3 and data.price ~= 0 then
                ---活跃度
                tb.aortext_limit.text = _G.GetLangPackValue(90021600063, self.model.score, data.price)
                tb.aortext_buy.text = _G.GetLangPackValue(90023900001)
            else
                tb.aortext_limit.text = _G.GetLangPackValue(90000001107, data.count_limit - buyCount)
                local price = _G.GameUtil.RatioControl(data.price)
                if price == 0 then
                    tb.aortext_buy.text = _G.GetLangPackValue(90023900001)
                else
                    tb.aortext_buy.text = _G.GetLangPackValue(90000010819, price)
                end
            end
        end
    end
end

function NoviceGiftPackView:RefreshListView(index, obj)
    local data = self.giftListDown[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickGiftItem, data))
    if not data.name or data.name == 0 then
        tb.aortext_title.text = _G.GetLangPackValue(90023800105)
    else
        tb.aortext_title.text = _G.GetLangPackValue(data.name)
    end

    local target
    if #data.goods <= 4 then
        tb.obj_ScrollRect:SetActiveE(0)
        tb.obj_Content:SetActiveE(1)
        target = tb.obj_Content
    else
        tb.obj_ScrollRect:SetActiveE(1)
        tb.obj_Content:SetActiveE(0)
        target = tb.obj_awardGrid
    end

    tb.obj_special:SetActiveE(0)
    tb.obj_awardGrid:ClearChildren()
    tb.obj_Content:ClearChildren()
    if data.goods then
        for _, v in ipairs(data.goods) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                    v,
                    target,
                    function(item)
                        if self:IsNil() then
                            _G.DestroyObject(item.gameObject)
                            return
                        end
                        item.gameObject:SetLocalScaleXYZ(0.85)
                        if item.ShowNumText then
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                        item:SetGradeNew()
                    end
            )
        end
    end

    local buyCount = self.model.buyList[data.id] or 0
    tb.obj_sellOut:SetActiveE(buyCount >= data.count_limit and 1 or 0)
    tb.obj_btn:SetActiveE(buyCount < data.count_limit and 1 or 0)
    if buyCount < data.count_limit then
        if data.type_price == 3 and data.price ~= 0 then
            ---活跃度
            tb.aortext_limit.text = _G.GetLangPackValue(90021600063, self.model.score, data.price)
            tb.aortext_buy.text = _G.GetLangPackValue(90023900001)
        else
            tb.aortext_limit.text = _G.GetLangPackValue(90000001107, data.count_limit - buyCount)
            local price = _G.GameUtil.RatioControl(data.price)
            if price == 0 then
                tb.aortext_buy.text = _G.GetLangPackValue(90023900001)
            else
                tb.aortext_buy.text = _G.GetLangPackValue(90000010819, price)
            end
        end
    end
end

function NoviceGiftPackView:UpdateList()
    self:SortGiftData()

    local topNum = 0
    self.giftListTop = {}
    self.giftListDown = {}
    for i = 1, #self.giftList do
        local data = self.giftList[i]
        if not data.name or data.name == 0 then
            if self.model.buyList[data.id] then
                _G.table.insert(self.giftListDown, data)
            else
                topNum = topNum + 1
                _G.table.insert(self.giftListTop, data)
            end
        else
            _G.table.insert(self.giftListDown, data)
        end
    end
    if topNum > 0 then
        if topNum >= 2 then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(385)
            self.go_table.scrollloopvectical_top:SetRectTransformSize(650, 385)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(370)
            self.go_table.scrollloopvectical_item:SetRectTransformSize(650, 370)
        elseif topNum == 1 then
            self.go_table.scrollloopvectical_top:UpdateScrollRectHeight(200)
            self.go_table.scrollloopvectical_top:SetRectTransformSize(650, 200)
            self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(552)
            self.go_table.scrollloopvectical_item:SetRectTransformSize(650, 552)
        end
        self.go_table.scrollloopvectical_top:InitItemData(topNum, _G.handler(self, self.RefreshListViewTop))
    else
        self.go_table.scrollloopvectical_top:SetActiveE(0)
        self.go_table.scrollloopvectical_item:UpdateScrollRectHeight(720)
        self.go_table.scrollloopvectical_item:SetRectTransformSize(650, 720)
    end
    self.go_table.scrollloopvectical_item:InitItemData(#self.giftList - topNum, _G.handler(self, self.RefreshListView))
end

---函数功能注释
function NoviceGiftPackView:OnClickGiftItem(_, _, data)
    local buyCount = self.model.buyList[data.id] or 0
    if buyCount < data.count_limit then
        local cfg = _G.ConfigManager.season_gift_cfg[self.model.seasonId]
        if _G.table.indexof(cfg.activefree, data.id) then
            if self.model.score >= data.price then
                self.model:GetFreeAward(data.id, _G.handler(self, self.OnbuySucessCall))
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1000105)
            end
        elseif data.type_price == 1 then
            self.model:BuyActiveGift(data.price, data.id, _G.handler(self, self.OnbuySucessCall))
        end
    end
end

---购买成功回调
function NoviceGiftPackView:OnbuySucessCall()
    if self:IsNil() then
        return
    end
    self:UpdateList()
end

---界面的销毁函数
function NoviceGiftPackView:OnDestroy()
    ---界面已销毁不需要再执行匿名函数的回调
    if self.model.call then
        self.model.call = nil
    end
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function NoviceGiftPackView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_shadow then
        self:Close()
    end
end

return NoviceGiftPackView
