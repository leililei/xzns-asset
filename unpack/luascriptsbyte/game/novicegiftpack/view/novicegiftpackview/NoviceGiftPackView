local NoviceGiftPackView = _G.BaseClass("NoviceGiftPackView", _G.UIBaseView)

function NoviceGiftPackView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function NoviceGiftPackView:OnCreate()
    self.model = require("NoviceGiftPackModel"):GetInstance()
    if self.model.isFirstEnter == 0 then
        self.model:SaveFirstEnterState()
    end
    self:RefreshActivityTime()
    --self:InitToggle()
    self:InitView()
end

function NoviceGiftPackView:RefreshActivityTime()
    self.endTime = self.model:GetEndTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime()
end

function NoviceGiftPackView:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime >= self.endTime then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(
            90000010360,
            _G.TimeUtil.TranslateSecondForStr(self.endTime - serverTime)
        )
    end
end

---函数功能注释
function NoviceGiftPackView:SortGiftData()
    _G.SortList(
        self.giftList,
        function(data)
            local buyCount = self.model.buyList[data.id] or 0
            local state = buyCount >= data.count_limit and 0 or 1
            return state, -data.id
        end
    )
end

---刷新界面
function NoviceGiftPackView:InitView()
    local cfg = _G.ConfigManager.season_gift_cfg[self.model.seasonId]
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("未获取到配置，赛季id: " .. _G.tostring(self.model.seasonId))
        end
    end
    local storeCfg = _G.ConfigManager.store_extra_cfg
    self.giftList = {}
    if cfg.activefree then
        for _, v in pairs(cfg.activefree) do
            _G.table.insert(self.giftList, storeCfg[v])
        end
    end
    if cfg.active then
        for _, v in pairs(cfg.active) do
            _G.table.insert(self.giftList, storeCfg[v])
        end
    end
    self:UpdateList()

    if _G.ConfigManager.season_gift_cfg[self.model.seasonId].title then
        self.go_table.aorrawimage_title:LoadImage(
            _G.ConfigManager.season_gift_cfg[self.model.seasonId].title,
            function()
                self.go_table.aorrawimage_title:SetNativeSize()
            end
        )
    end

