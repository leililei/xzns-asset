        local endTime = require("NoviceGiftPackModel"):GetInstance():GetEndTime()
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        return endTime > serverTime
    end,
    [2] = function()
        local actT = require "ActivitySynManager":GetInstance():GetActivityByType(10052) or {}
        return actT[1] ~= nil
    end,
    -- [3] = function()
    --     local actT = require "ActivitySynManager":GetInstance():GetActivityByType(10007) or {}
    --     return actT[1] ~= nil
    -- end,
}

local ShowViewFunc = {
    [1] = function()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NoviceGiftPackView.Name)
    end,
    [10052] = function()
        local dataT = require "ActivitySynManager":GetInstance():GetActivityByType(10052)
        local data = dataT[1]
        if data.curState == AState.Close or data.curState == AState.Settlement or data.curState == AState.Notice then
            data:CheckActivityInteractable()
