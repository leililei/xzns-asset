    --     if data.curState == AState.Close or data.curState == AState.Settlement or data.curState == AState.Notice then
    --         data:CheckActivityInteractable()
    --         return
    --     end
    --     data:EnterActivity()
    -- end
}


function NoviceGiftPackToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
end

---界面的入口函数
function NoviceGiftPackToggleView:OnCreate(activityData, index)
    self.activityData = activityData
    self.index = index or 1
--[[    self.uiNameIndex = {
        [_G.ConfigManager.ui_cfg.NoviceGiftPackView.Name] = 1, 
        [_G.ConfigManager.ui_cfg.LimitTimeDropView.Name] = 2,
        [_G.ConfigManager.ui_cfg.SpiritualDrawCumulativeAwardsView.Name] = 3,
        }]]
    self.views = {}
    self:InitToggle()
end

function NoviceGiftPackToggleView:InitView(actType)
    if ShowViewFunc[actType] then
        ShowViewFunc[actType]()
    else
        print("没有找到对应的活动显示函数: ", actType)
    end
end


function NoviceGiftPackToggleView:InitRedPoint()
    self.redpointIds = {}
    -- NoviceGiftPackView 对应活动类型 1
    self.redpointIds[1] = _G.ConfigManager.redpoint_cfg.NoviceGiftPack.id
    local data52 = require "ActivitySynManager":GetInstance():GetActivityByType(10052) or {}
    if data52[1] then
        self.redpointIds[10052] = data52[1].typeClass:GetRedpointIDByIndex(1)
    end
    -- local data07 = require "ActivitySynManager":GetInstance():GetActivityByType(10007) or {}
    -- if data07[1] then
    --     self.redpointIds[10007] = data07[1].typeClass:GetRedpointIDByIndex(1)
    -- end
end

function NoviceGiftPackToggleView:InitToggle()
    local seasonId = require("NoviceGiftPackModel"):GetInstance().seasonId
    local noviceGiftName = _G.ConfigManager.season_gift_cfg[seasonId].name

    local activityConfigs = {
        [10007] = { text = _G.GetLangPackValue(90021000027), viewName = _G.ConfigManager.ui_cfg.SpiritualDrawCumulativeAwardsView.Name },
        [10052] = { text = _G.GetLangPackValue(90027600006), viewName = _G.ConfigManager.ui_cfg.LimitTimeDropView.Name },
        [1]    = { text = _G.GetLangPackValue(noviceGiftName), viewName = _G.ConfigManager.ui_cfg.NoviceGiftPackView.Name }
    }
    
    local availableActivities = {}
    -- if CheckToggleShowFunc[3]() then
    --     table.insert(availableActivities, { actType = 10007, toggleName = "toggle_gift3", viewName = activityConfigs[10007].viewName })
    -- end
    if CheckToggleShowFunc[2]() then
        table.insert(availableActivities, { actType = 10052, toggleName = "toggle_gift2", viewName = activityConfigs[10052].viewName })
    end
    if CheckToggleShowFunc[1]() then
        table.insert(availableActivities, { actType = 1,    toggleName = "toggle_gift1", viewName = activityConfigs[1].viewName })
    end

    -- 没有可用的活动，打开NoviceGiftPackView
    if #availableActivities == 0 then
        ShowViewFunc[1]()
        return
    end
    
    self.availableActivities = availableActivities
    self.toggles = {}
    
    self:InitRedPoint()

    -- 动态生成页签,回调 显示文本及红点更新
    for i, actInfo in ipairs(availableActivities) do
        self.toggles[i] = _G.GetAutoGoTable(
                self.go_table[actInfo.toggleName],
                _G.handlerbind(self, self.OnClickToggle, i, _G.handlerbind(self, self.InitView, actInfo.actType))
        )
        local actName = activityConfigs[actInfo.actType].text
        self.toggles[i].aortext_label1.text = actName
        self.toggles[i].aortext_label.text  = actName

        --红点
        if self.redpointIds[actInfo.actType] then
            self.toggles[i].obj_redpoint:UpdateRedPointItemIDAndParam(self.redpointIds[actInfo.actType])
        end

        -- 确保当前页签物体显示
        self.go_table[actInfo.toggleName]:SetActiveE(1)
    end

    -- 隐藏没加入availableActivities的页签物体
    local allToggleNames = {"toggle_gift1", "toggle_gift2", "toggle_gift3"}
    for _, tName in ipairs(allToggleNames) do
        local isAvailable = false
        for _, actInfo in ipairs(availableActivities) do
            if actInfo.toggleName == tName then
                isAvailable = true
                break
            end
        end
        if not isAvailable then
            self.go_table[tName]:SetActiveE(0)
        end
    end

    -- 根据传入的 self.index 选中默认页签（如果 index 超出范围，则选中第一个）
    local selectIndex = self.index
    if selectIndex > #availableActivities then
        selectIndex = 1
    end
    self:OnClickToggle(self.go_table[availableActivities[selectIndex].toggleName], true, selectIndex, _G.handlerbind(self, self.InitView, availableActivities[selectIndex].actType))
end

function NoviceGiftPackToggleView:OnClickToggle(go, isOn, key, call)
    -- 取消选中除当前页签外的所有页签
    for k, tb in pairs(self.toggles) do
        if k ~= key then
            tb.isOn = false
            tb.aorimage_isOff:SetActiveE(1)
            tb.aorimage_isOn:SetActiveE(0)
            self.go_table["obj_view" .. k]:SetActiveE(0)
        end
    end

    -- 处理当前点击的页签
    local tb = self.toggles[key]
    tb.isOn = true
    tb.aorimage_isOff:SetActiveE(0)
    tb.aorimage_isOn:SetActiveE(1)
    self.go_table["obj_view" .. key]:SetActiveE(1)
    
    if isOn and call then
        call()
    end
end

function NoviceGiftPackToggleView:OnUIOpened(name)
    for i, actInfo in ipairs(self.availableActivities or {}) do
        if actInfo.viewName == name then
            self.views = self.views or {}
            self.views[i] = _G.UIManager:GetInstance():GetWindowCtrl(name)
            -- 将页面作为对应页签的子物体
            self.views[i].transform:SetParentE(self.go_table["obj_view" .. i])
            break
        end
    end
end

---按钮点击事件在这里派发
function NoviceGiftPackToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_shadow then
        self:CloseView()
    end
end

function NoviceGiftPackToggleView:CloseView(...)
    self:Close()
end

function NoviceGiftPackToggleView:Dispose()
    if self.availableActivities then
        for _, actInfo in ipairs(self.availableActivities) do
            _G.UIManager:GetInstance():CloseWindow(actInfo.viewName)
        end
    end
    self:RemoveAllListener()
end

return NoviceGiftPackToggleView
