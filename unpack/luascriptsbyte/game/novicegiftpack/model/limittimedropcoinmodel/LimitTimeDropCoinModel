---@class LimitTimeDropCoinModel : Singleton	中文描述
local LimitTimeDropCoinModel = _G.BaseClass("LimitTimeDropCoinModel", _G.Singleton)
local CS = _G.CS
local typeof = _G.typeof

---@return LimitTimeDropCoinModel LimitTimeDropCoinModel
function LimitTimeDropCoinModel:GetInstance()
    return self.super.GetInstance(self)
end

function LimitTimeDropCoinModel:__init()
    self.CoinList = {}
    _G.Events:GetInstance():AddListener(_G.eArena.SetLimitTimeDropCoin, self.AddCoin, self)
end

---销毁对象时,析构函数
function LimitTimeDropCoinModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eArena.SetLimitTimeDropCoin, self.AddCoin, self)
end

---设置活动
function LimitTimeDropCoinModel:SetActivity(activity)
    self.activity = activity
end
---增加代币
---@param data table<table<number>>
function LimitTimeDropCoinModel:SetCoin(activityID, data, initBol)
    if self.CoinList then
        if not self.CoinList[activityID] then
            self.CoinList[activityID] = {}
        end
        if self.CoinList[activityID][data.key] then
            if initBol then 
                self.CoinList[activityID][data.key] = data.value
            else 
                self.CoinList[activityID][data.key] = self.CoinList[activityID][data.key] + data.value
            end
        else
            self.CoinList[activityID][data.key] = data.value
        end
        local tmp = {}
        _G.table.insert(tmp, data.key)
        _G.table.insert(tmp, data.value)
        _G.table.insert(tmp, self.CoinList[activityID][data.key])
        _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})
    end
end
---使用代币
function LimitTimeDropCoinModel:UseCoin(activityID, data)
    if self.CoinList[activityID] then
        self.CoinList[activityID][data.type[1]] = self.CoinList[activityID][data.type[1]] - data.type[2]
    end
end
---获取代币数量
function LimitTimeDropCoinModel:GetCoin(activityID, sid)
    if self.CoinList and self.CoinList[activityID] and table.count(self.CoinList[activityID]) > 0 then
        for k,v in pairs(self.CoinList[activityID]) do
            if k == sid then
                return v
            end
        end
    end
    return 0
end

function LimitTimeDropCoinModel:GetCoinIdList(sid)
    for k, v in pairs(self.CoinList or {}) do 
        for key, value in pairs(v) do 
            if key == sid then 
                return value
            end
        end
    end 
end
