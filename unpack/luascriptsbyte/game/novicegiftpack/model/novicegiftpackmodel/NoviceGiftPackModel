---@class NoviceGiftPackModel : Singleton	中文描述
local NoviceGiftPackModel = _G.BaseClass("NoviceGiftPackModel", _G.GameDataModelBase)

---@return NoviceGiftPackModel NoviceGiftPackModel
function NoviceGiftPackModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function NoviceGiftPackModel:__init()
    self.curFunctionOpenID = 269
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.game_season_gift_score.Cmd, self.OnScoreChange, self)
end

---销毁对象时,析构函数
function NoviceGiftPackModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.game_season_gift_score.Cmd, self.OnScoreChange, self)
end

---函数功能注释
function NoviceGiftPackModel:GetDataFormServer()
    require("NoviceGiftPackNet"):GetInstance():GetInfo(_G.handler(self, self.GetInfoCall))
end

---函数功能注释
function NoviceGiftPackModel:GetInfoCall(msg)
    self.seasonId = msg.season_id or 1
    local cfg = _G.ConfigManager.season_gift_cfg
    local maxSeasonId = #cfg
    if self.seasonId > maxSeasonId then
        self.seasonId = maxSeasonId
    end

    ---从2016年1月1日开始计算的
    self.startDay = msg.start_day * 86400 + 1451577600
    self.startDay = _G.TimeUtil.GetServerUnixTime()
    self.score = msg.score or 0
    ---已购买礼包数据
    self.buyList = {}
    if msg.buy_list then
        for _, v in pairs(msg.buy_list) do
            self.buyList[v.key] = v.value
        end
    end
    self.isFirstEnter = _G.PlayerPrefsManager.GetInt("NoviceGiftPackModel", 0)
    self:RefreshRedPoint()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.NoviceGiftPackView.Name)
    if view then
        view:InitView()
    end
    self:ParseData()
end

---活动结束时间
function NoviceGiftPackModel:GetEndTime()
    local cfg = _G.ConfigManager.season_gift_cfg[self.seasonId]
    return self.startDay + cfg.duration * 86400
end

---是否可以购买礼包
function NoviceGiftPackModel:CanBuyGift()
end

---领取免费奖励
function NoviceGiftPackModel:GetFreeAward(sid, callBack)
    require("NoviceGiftPackNet"):GetInstance():GetAward(
        { sid = sid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if not self.buyList[sid] then
                self.buyList[sid] = 1
            else
                self.buyList[sid] = self.buyList[sid] + 1
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.PopWindowManager:GetInstance():AddAwardPopQuene(msg)
            self:RefreshRedPoint()
            if callBack then
                callBack()
            end
        end
    )
end

---函数功能注释
function NoviceGiftPackModel:BuyActiveGift(price, id, call)
    self.call = call
    require("MallManager"):GetInstance():BuyActiveGift(price, nil, id)
end

---购买回调
function NoviceGiftPackModel:OnMallCashListener(data)
    if not self.buyList then
        return
    end
    if self.buyList[data.sid] then
        self.buyList[data.sid] = self.buyList[data.sid] + 1
    else
        self.buyList[data.sid] = 1
    end
    if self.call then
        self.call()
        self.call = nil
    end
end

---积分变化
function NoviceGiftPackModel:OnScoreChange(msg)
    if msg.score then
        self.score = msg.score
    end
end

---函数功能注释
function NoviceGiftPackModel:CheckRedPoint()
    if not self.seasonId then
        return 0
    end
    if self.isFirstEnter == 0 then
        return 1
    end
    local cfg = _G.ConfigManager.season_gift_cfg[self.seasonId]
    if #cfg.activefree > 0 then
        local storeCfg = _G.ConfigManager.store_extra_cfg
        for _, v in pairs(cfg.activefree) do
            local count = self.buyList[storeCfg[v].id] or 0
            if count < storeCfg[v].count_limit then
                local finalPrice = require "MallManager":GetInstance():GetFinalPrice(storeCfg[v].price_id)
                if storeCfg[v].type_price == 3 and self.score >= finalPrice then
                    return 1
                end
            end
        end
    end
    return 0
end

---函数功能注释
function NoviceGiftPackModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.NoviceGiftPack.id)
end

---函数功能注释
function NoviceGiftPackModel:SaveFirstEnterState()
    self.isFirstEnter = 1
    _G.PlayerPrefsManager.SetInt("NoviceGiftPackModel", 1)
    self:RefreshRedPoint()
end

return NoviceGiftPackModel
