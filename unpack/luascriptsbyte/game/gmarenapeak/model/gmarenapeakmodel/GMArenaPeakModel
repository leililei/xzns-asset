---创建主界面刷新计时器
function GMArenaPeakModel:CreateMainViewTimer()
    if self.mainTimer then
        self.mainTimer:Stop()
        self.mainTimer = nil
    end
    local timeArray = self:GetDayOpenTimeArray()
    local now = TimeUtil.GetSecondsOfDay()
    _G.table.insert(timeArray, 86400)
    self.stepPoint = 1
    for i = 1, #timeArray do
        if now < timeArray[i] then
            self.stepPoint = i
            break
        end
    end
    self.mainTimer = _G.TimerManager:GetInstance():GetTimer(timeArray[self.stepPoint] - now + 1, self.UpdateMainView, self, true, false, true)
    self.mainTimer:Start()
end

---刷新主界面
function GMArenaPeakModel:UpdateMainView()
    local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
    if mainView then
        mainView:UpdateView()
    end
    if self.mainTimer then
        self.mainTimer:Stop()
        self.mainTimer = nil
    end
    local timeArray = self:GetDayOpenTimeArray()
    local now = TimeUtil.GetSecondsOfDay()
    if self.stepPoint < #timeArray then
        self.stepPoint = self.stepPoint + 1
        self.mainTimer = _G.TimerManager:GetInstance():GetTimer(timeArray[self.stepPoint] - now + 1, self.UpdateMainView, self, true, false, true)
        self.mainTimer:Start()
    end
end

