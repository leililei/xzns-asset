                    bool = false
                end
            end
            if bool then
                _G.table.insert(self.taskInfo.day_curr, value)
            end
            self:OnDayCurr(value)
        end
    end
    if self.taskInfo.season_curr == nil then
        self.taskInfo.season_curr = {}
    end
    if msg.season_curr then
        for key, value in pairs(msg.season_curr) do
            local bool = true
