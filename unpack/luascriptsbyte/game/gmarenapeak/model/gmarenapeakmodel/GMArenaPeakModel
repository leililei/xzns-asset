                if _G.table.sameByCount(value.t_key, v.t_key) then
                    self.taskInfo.season_curr[k] = value
                    bool = false
                end
            end
            if bool then
                _G.table.insert(self.taskInfo.season_curr, value)
            end
            self:OnSeasonCurr(value)
        end
    end
    --self:RefreshRedPointArenaQuest()
end
