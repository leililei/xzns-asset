---刷新排名
---@param callback function 回调
function GMArenaPeakModel:RefreshRankNum(callback)
    GMArenaPeakNet:GetInstance():GetRankNum(
        function(msg)
            if msg.ack == 1 then 
                local beforeKingFlag, afterKingFlag
                beforeKingFlag = self:CheckKingCondition()
                if msg.index and msg.index > 0 then 
                    self.rankNum = msg.index
                else 
                    self.rankNum = 0
                end 
                --XZNS-7269 这个接口给的分是错的，不用这个分数覆盖
                --if msg.value and msg.value > 0 then 
                --    self.score = msg.value
                --end
                afterKingFlag = self:CheckKingCondition()
                self.isKing = afterKingFlag
                if not beforeKingFlag and afterKingFlag then 
                    self.showDanUp = true
                    self.danCfg = self:GetDanCfgByScore(self.score)
                    self.danID = self.danCfg.id
                    self:UpdateHistoryMaxDanID()
                end
                local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
                if ctrl then
                    ctrl:UpdateView(true)
                end
                if callback then
                    callback()
                end
            end
        end
    )
end

function GMArenaPeakModel:CheckKingCondition(rankNum, score)
    rankNum = rankNum or self.rankNum
    score = score or self.score
    if rankNum ~= 0 then 
        local cfg = self:GetDanCfgByScore(score)
        if cfg and cfg.id == self.kingID then 
            if cfg.rank_con ~= 0 then 
                return rankNum <= cfg.rank_con
            else 
                return true
            end
        end
    end
    return false 
end

function GMArenaPeakModel:CheckScoreIsKing(score)
    score = score or self.score
    return score >= ConfigManager.arena_peak_league_cfg[self.kingID].min_score
end

