---查找背包卡牌最大天赋点，最大魂链等级（规则修改为读配置，此方法停用）
---@return number,number,number 最大天赋数量，魂链是否有卡牌解锁，最大魂链等级
function GMArenaPeakModel:FindMaxInbornAndSoulChain()
    local cards = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local inbornNum = 0
    local isActive = 0
    local soulLinkLv = 0
    for _, card in pairs(cards) do
        if #card.open_inborn > inbornNum then
            inbornNum = #card.open_inborn
        end
        if card.soulLink_IsActivate > isActive then
            isActive = card.soulLink_IsActivate
        end
        if card.soulLink_lv > soulLinkLv then
            soulLinkLv = card.soulLink_lv
        end
    end
    return inbornNum, isActive, soulLinkLv
end

---根据配置读取天赋和魂链
---@return number,boolean,number 最大天赋数量，魂链是否有卡牌解锁，最大魂链等级
function GMArenaPeakModel:GetInbornAndSoulChain()
    if self.danID == nil then
        return 0, 0, 0
    end
    local inbornNum, soulLinkLv = 0, 0
    local cfg = ConfigManager.discrete_cfg[discreteID.support]
    for _, v in pairs(cfg) do
        if self.danID >= v[1] then
            inbornNum = v[3]
            soulLinkLv = v[2]
        end
    end
    return inbornNum, 1, soulLinkLv
end

---计算解锁的天赋列表
---@param inbornList number[] 天赋配置列表
---@param inbornNum number 激活天赋数量
---@return number[] 已激活的天赋列表
function GMArenaPeakModel:CalOpenInborn(inbornList, inbornNum)
    local inborn = {}
    for i = 1, #inbornList do
        if inbornNum == 0 then
            break
        end
        for j = 1, #inbornList[i] do
            if inbornNum == 0 then
                break
            end
            _G.table.insert(inborn, inbornList[i][j])
            inbornNum = inbornNum - 1
        end
    end
    return inborn
end

---更新所有助战卡牌属性
function GMArenaPeakModel:UpdateAllSupportAttr()
    local inbornNum, isActive, soulLinkLv = self:GetInbornAndSoulChain()
    local inbornList
    for _, card in pairs(self.supportCards) do
        inbornList = ConfigManager.card_cfg[card.sid].talent
        card.inborn_num = inbornNum
        card.open_inborn = self:CalOpenInborn(inbornList, inbornNum)
        card.soulLink_IsActivate = isActive
        card.soulLink_lv = soulLinkLv
        card:CalcNowSumProp()
    end
end

