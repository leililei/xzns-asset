---已完成任务添加
---@param id number 任务id
function GMArenaPeakModel:IsFinishTask(id)
    if self.taskInfo == nil then
        self.taskInfo = {}
        self.taskInfo.finish_task = {}
    elseif self.taskInfo.finish_task == nil then
        self.taskInfo.finish_task = {}
    end

    _G.table.insert(self.taskInfo.finish_task, id)

    for key, value in pairs(self.taskOne) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
        end
    end
    for key, value in pairs(self.taskTwo) do
        if value.id == id then
            value.i_task.state = _G.TaskEnum.ETaskState.Completed
        end
    end
end

---预完成添加
---@param id number 任务id
function GMArenaPeakModel:IsUidTask(id)
    for key, value in pairs(self.taskInfoId) do
        if value == id then
            return
        end
    end
    if self.taskInfo and self.taskInfo.finish_task then
        for key, value in pairs(self.taskInfo.finish_task) do
            if value == id then
                return
            end
        end
    end

    _G.table.insert(self.taskInfoId, id)
end

---完成任务
---@param id number 任务id
---@param call function 完成回调
function GMArenaPeakModel:ChessAward(id, call)
    local data = {}
    data.t_id = id
    if #id < 1 then
        if call ~= nil then
            call()
        end
        return
    end
    require "GMArenaPeakNet":GetInstance():TaskFinish(
            data,
            function(msg)
                if _G.table.count(id) > 1 then
                    for key, value in pairs(id) do
                        self:IsFinishTask(value)
                    end
                    self.taskInfoId = {}
                else
                    for key, value in pairs(id) do
                        local num
                        for k, v in pairs(self.taskInfoId) do
                            if v == value then
                                num = k
                            end
                        end
                        if num then
                            table.remove(self.taskInfoId, num)
                        end
                        self:IsFinishTask(value)
                    end
                end

                if msg.ack ~= 1 then
                    return
                end

                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                self:RefreshRedPointArenaQuest()

                if call ~= nil then
                    call()
                end
            end
    )
end

