function GMArenaPeakModel:TaskID()
    local task = {}
    for key, value in pairs(self.taskTwo) do
        local data = self:ListTask(task, value.idList)
        if data then
            if task[data].id > value.id then
                if not self:GetFinish_taskTask(value.id) then
                    task[data] = value
                end
            else
                if self:GetFinish_taskTask(task[data].id) then
                    task[data] = value
                end
            end
        else
            _G.table.insert(task, value)
        end
    end
    local tasks = {}
    for key, value in pairs(task) do
        _G.table.insert(tasks, value)
    end

    return tasks
end

