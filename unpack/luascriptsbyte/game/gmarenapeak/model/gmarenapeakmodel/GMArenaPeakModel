---根据积分获取段位配置
---@param score number 积分
---@return arena_peak_league_cfg 段位配置
function GMArenaPeakModel:GetDanCfgByScore(score)
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        if score >= cfg.min_score and score <= cfg.max_score then
            return cfg
        end
    end
    return nil
end

---根据积分获取段位配置（做王者判断）
---@param score number 积分
---@return arena_peak_league_cfg 段位配置
function GMArenaPeakModel:GetDanCfgByScoreAndKing(score, isKing)
    if isKing then
        return ConfigManager.arena_peak_league_cfg[self.kingID]
    end
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        if score >= cfg.min_score and score <= cfg.max_score then
            if cfg.id == self.kingID then
                return ConfigManager.arena_peak_league_cfg[self.masterID]
            end
            return cfg
        end
    end
    return nil
end

function GMArenaPeakModel:GetMinDanCfg()
    local minScore, minCfg
    for key, cfg in pairs(ConfigManager.arena_peak_league_cfg) do
        minScore = minScore or cfg.min_score
        minCfg = minCfg or cfg
        if cfg.min_score < minScore then 
            minScore = cfg.min_score
            minCfg = cfg
        end
    end
    return minCfg
end

