---初始化任务
function GMArenaPeakModel:ArenaPeakTask()
    self.taskOne = {}
    self.taskTwo = {}

    for key, value in pairs(arena_peak_task_cfg) do
        local states = _G.TaskEnum.ETaskState.Claimed

        local target
        if self:GetFinish_taskTask(value.id) then
            states = _G.TaskEnum.ETaskState.Completed
        end

        if value.type_mission == 1 then
            local data = {}
            for k, v in pairs(value.condition[1]) do
                if k < _G.table.count(value.condition[1]) then
                    _G.table.insert(data, v)
                end
            end
            target = self:IsWeek_curr(data)

            local taskDatas =
            require "ArenaPeakTaskData".New(
                    {
                        sid = value.id,
                        target = {target},
                        state = states,
                        cfg = value,
                        id = data,
                        Type = 1
                    }
            )
            _G.table.insert(self.taskOne, taskDatas)
        elseif value.type_mission == 2 then
            local data = {}
            for k, v in pairs(value.condition[1]) do
                if k < _G.table.count(value.condition[1]) then
                    _G.table.insert(data, v)
                end
            end
            target = self:IsSeason_curr(data)

            local taskDatas =
            require "ArenaPeakTaskData".New(
                    {
                        sid = value.id,
                        target = {target},
                        state = states,
                        cfg = value,
                        id = data,
                        Type = 2
                    }
            )
            _G.table.insert(self.taskTwo, taskDatas)
        end
    end
end

