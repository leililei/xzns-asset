function GMArenaPeakModel:UpdateActivityTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if serverTime >= self.nextTime then
        self:ChangeStatusAndNextTimeLine()
    end
    if serverTime > self.end_time then
        if self.activityTimer then
            self.activityTimer:Stop()
            self.activityTimer = nil
        end
    end
end

function GMArenaPeakModel:GetNextAward()
    local activity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(10007,
        self.curActivityClass:GetJumpType(self.curActivityClass.activityID))
    if activity then
        local list = activity.typeClass:GetTaskListByPage(1)
        _G.table.sort(list, function(a, b)
            return a.Cfg.count < b.Cfg.count
        end)
        for _, v in ipairs(list) do
            if v.Cfg.page == 1 and self.totalNum < v.Cfg.count then
                return v, activity
            end
        end
        return list[#list], activity
    end
end

