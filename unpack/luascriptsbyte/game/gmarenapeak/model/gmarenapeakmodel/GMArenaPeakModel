--更改活动状态和下一个时间节点
function GMArenaPeakModel:ChangeStatusAndNextTimeLine()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local fightHour = self.dayOpenCfg
    if serverTime >= self.open_time and serverTime <= self.enroll_time then
        self.status = self.ArenaStatus.sign
        self.nextTime = self.enroll_time
    elseif serverTime > self.enroll_time and serverTime < self.fight_time then
        --serverTime为本地时区的服务器时间戳, 转为服务器时区
        --下方调用_G.TimeUtil.timeReverse转回本地时区
        local zeroTime = _G.TimeUtil.GetDayBySix(serverTime)
        local fightStartTime = zeroTime + (fightHour[1][1] * 3600) + (fightHour[1][2] * 60)
        local fightEndTime = zeroTime + (fightHour[2][1] * 3600) + (fightHour[2][2] * 60)
        local timetable = _G.TimeUtil.date("*t", serverTime)
        if serverTime >= fightStartTime and serverTime < fightEndTime then
            self.status = self.ArenaStatus.fight
            timetable.hour = fightHour[2][1]
            timetable.min = fightHour[2][2]
            timetable.sec = 0
            self.nextTime = _G.TimeUtil.timeReverse(timetable)
        elseif serverTime < fightStartTime then
            self.status = self.ArenaStatus.idle
            timetable.hour = fightHour[1][1]
            timetable.min = 0
            timetable.sec = 0
            self.nextTime = _G.TimeUtil.timeReverse(timetable)
        elseif serverTime >= fightEndTime then
            self.status = self.ArenaStatus.idle
            timetable.hour = fightHour[1][1]
            timetable.min = 0
            timetable.sec = 0
            self.nextTime = _G.TimeUtil.timeReverse(timetable) + 86400
        end
    elseif serverTime >= self.fight_time and serverTime <= self.end_time then
        self.status = self.ArenaStatus.settle
        self.nextTime = self.end_time
    elseif serverTime > self.end_time and serverTime <= self.close_time then
        self.status = self.ArenaStatus.eggTime
        self.nextTime = self.close_time
    else
        self.status = self.ArenaStatus.close
    end
    --_G.Events:GetInstance():Broadcast(_G.eRelicTeam.RelicTeamChangeStatus, self.status, self.nextTime)
    local ctrl = UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
    if ctrl then 
        ctrl:UpdateView()
    end
    local ctrl2 = UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakSignUpView.Name)
    if ctrl2 and self.status ~= self.ArenaStatus.sign then 
        if not self:CheckSign() then 
            GMArenaPeakModel:Sign(function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
                ctrl2:Close()
            end)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
            ctrl2:Close()
        end
    end
    return self.status, self.nextTime
end

--获取活动状态和下一个时间节点
function GMArenaPeakModel:GetStatusAndNextTimeLine()
    return self.status, self.nextTime
end

--获取活动状态和下一个阶段时间节点
function GMArenaPeakModel:GetStatusAndNextStatusTimeLine()
    if self.status == self.ArenaStatus.sign then 
        return self.status, self.enroll_time, 90049800034
    elseif self.status == self.ArenaStatus.fight then 
        return self.status, self.nextTime, 90049800025
    elseif self.status == self.ArenaStatus.idle then
        return self.status, self.nextTime, 90049800026
    elseif self.status == self.ArenaStatus.settle then 
        return self.status, self.end_time, 90049800033
    end
end

---解析基本信息
---@param msg arena_peak.s2c_arena_peak_info
function GMArenaPeakModel:ParseData(msg)
    self.waitFriday = false
    if msg.is_open then
        self.waitFriday = true
        self:TryToDestroyRoom()
    elseif msg.ack == 1 then 
        self.hisDan = 1
        self.curActivityClass = require "ActivitySynManager":GetInstance():GetActivityWithTypeId(10082)
        self.serverOpenTime = msg.open_time or _G.PlayerModel:GetInstance().open_time
        local sInfo = msg.info or {}
        self.seasonID = sInfo.season_id
        self.seasonStartTime = sInfo.open_time
        self.open_time = sInfo.open_time
        self.enroll_time = sInfo.open_time + sInfo.enroll_time
        self.fight_time = sInfo.open_time + sInfo.fight_time
        self.end_time = sInfo.open_time + sInfo.end_time
        self.close_time = sInfo.close_time
        self:ChangeStatusAndNextTimeLine()
        self:SetState(0)
        if self.status and self.status ~= 0 then
            self.activityTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateActivityTimer, self, false, false,
                true)
            self.activityTimer:Start()
            self:UpdateActivityTimer()
            --require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.RelicTeamFullEnergy.id)
        end
        self.supportList = sInfo.season_support or {} --周免支援角色
        self.taskInfoId = {}
        --self:InitSupportCards()
        local info = msg.role_info or {}
        self.hisCoinNum = info.his_coin_num or 0
        self.EggAwardFlag = info.easter_egg
        self.EggEndTime = self.close_time
        self.pre_pick = info.pre_pick or {}
        self.pre_ban = info.pre_ban or {0, 0, 0, 0, 0, 0}
        self.score = info.score or 0
        self.signTime = info.enroll_time
        self.rankNum = info.rank_num or 0
        self.rankTimes = info.rank_times
        self.isKing = info.is_king
        self.isKing = self:CheckKingCondition()
        self.danCfg = self:GetDanCfgByScoreAndKing(self.score, self.isKing) or self:GetMinDanCfg()
        self.danID = self.danCfg.id or 0
        if not info.fights then 
            info.fights = {0, 0}
        end
        self.totalNum = info.fights[1] or 0
        self.winNum = info.fights[2] or 0
        self.hisDan = info.his_dan
        self.coin = info.coin
        self.coins = info.coins or {{key = 19, value = 0}}
        self.fightTimes = info.fight_times
        self.taskInfo = info.task_info
        self.roomID = info.room_uid
        if info.room_uid then --对局中，则重连回房间
            local embattleItem = require("EmbattleController"):GetInstance():GetCurEmbattleItem()
            local peakView = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.GMArenaPeakView.Name)
            if embattleItem then
                -- GMArenaPeakNet:GetInstance():GetRoomInfo({room_uid = self.roomID},
                --     function(data)
                --         if data.ack == 1 then
                --             local ctrl =
                --                 UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.GMArenaPeakBPView.Name)
                --             if ctrl then
                --                 ctrl:InitView(data.room_info)
                --             end
                --         end
                --     end
                -- )
            elseif peakView then
                self:UpdateAllSupportAttr()
                GMArenaPeakNet:GetInstance():GetRoomInfo({room_uid = self.roomID},
                    function(data)
                        if data.ack == 1 then
                            peakView:CloseOtherView()
                            self:OnChallenge(data.room_info)
                        end
                    end
                )
            else
                --_G.Events:GetInstance():AddListener(_G.eScene.EnterWorldOver, self.OnWorldLoadOver, self)
                local MainOpenViewFunItem = {}
                MainOpenViewFunItem.OpenViewFun = function()
                GMArenaPeakNet:GetInstance():GetRoomInfo({room_uid = self.roomID},
                        function(data)
                            if data.ack == 1 then
                                self:OnChallenge(data.room_info)
                            end
                        end
                    )
                end
                _G.MainManager:GetInstance():AddMainFunQueue(MainOpenViewFunItem, _G.MainViewShowOrder.GMArenaPeakFight)
            end
        else --正常状态
            self:TryToDestroyRoom()
        end
        local ctrl = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.GMArenaPeakView.Name)
        if ctrl then --断线重连主页面处理
            ctrl:CancelMatch()
            ctrl:InitView()
        end
        -- self:ArenaPeakTask()
        -- ctrl = UIManager:GetInstance():GetWindowCtrl(ConfigManager.ui_cfg.ArenaPeakTaskView.Name)
        -- if ctrl then --断线重连任务界面处理
        --     ctrl:ItemNew()
        -- end
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        local settleStartTime = self:GetSettlementStartTime() - TimeUtil.GetServerUnixTime()
        if settleStartTime > 0 then
            self.timer =
                _G.TimerManager:GetInstance():GetTimer(
                settleStartTime,
                self.EnterSettlement,
                self,
                true,
                false,
                true
            )
            self.timer:Start()
        end
        self:InitSupportCards()
        --self:CreateMainViewTimer()
        --require "ShopModel":GetInstance():GetShopInServer(_G.ShopID.ArenaPeak)
    end
    self:RefreshAllRedPoint()
    self.isOpen = self:CheckIsOpen()
    self.super.ParseData(self)
end

---获取结算后全服奖励
function GMArenaPeakModel:GetEggAward(callback)
    require "ActivitySynNet":GetInstance():GetAward(
        self.curActivityClass:GetActivityID(),
        {},
        function(msg)
            if msg.ack == 1 then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                self.EggAwardFlag = true
                self.curActivityClass.typeClass:RefreshRedPoint()
                if callback then
                    callback()
                end
            end 
        end
    )
end

function GMArenaPeakModel:CheckInEggAwrdStatus()
