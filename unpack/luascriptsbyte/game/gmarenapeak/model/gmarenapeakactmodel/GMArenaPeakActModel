local base = require "ActivitySynTypeBase"
---@class GMArenaPeakActModel : ActivitySynTypeBase	
local GMArenaPeakActModel = _G.BaseClass("GMArenaPeakActModel", base)

---创建对象时,入口构造函数
function GMArenaPeakActModel:__init()
    self.ActivityId = self.curActivityClass:GetActivityID()
    require "GMArenaPeakModel":GetInstance():GetDataFormServer()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamChangeStatus, self.RefreshRedPoint, self)
    --self:RefreshRedPoint()
end

---获取服务器数据
function GMArenaPeakActModel:GetDataFormServer()
    self:ParseData()
    --require "RelicTeamModel":GetInstance():GetDataFormServer()
end

function GMArenaPeakActModel:JumpFunction()
    --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityDispatchView.Name)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
end

function GMArenaPeakActModel:OnEnterActivity()
    local endTime = self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time
    local GMArenaPeakModel = require "GMArenaPeakModel":GetInstance()
    if GMArenaPeakModel:CheckInEggAwrdStatus() then 
        local rankType = require("RankUtils").RankType.GMArenaPeak
        if not self.CurRankData then 
            require("RecordRankModel"):GetInstance():GetListInfoByPage(rankType, 
                function()
                    self.CurRankData = require("RecordRankModel"):GetInstance():GetRankData(rankType)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakChampionView.Name, self.CurRankData)
                end,
                1
            )
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakChampionView.Name, self.CurRankData)
        end
        return 
    end
    
    local status = GMArenaPeakModel:GetStatusAndNextTimeLine()
    require("GMArenaPeakModel"):GetInstance():SetBackIng(false)
    if status == GMArenaPeakModel.ArenaStatus.sign then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakSignUpView.Name)
    elseif not GMArenaPeakModel.signTime or GMArenaPeakModel.signTime == 0 then 
        GMArenaPeakModel:Sign(function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
        end)
    else
        if require("GMArenaPeakModel"):GetInstance():GetFightIng() then 
            _G.BattleManager:GetInstance():SetRendererActive(true)
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        end
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.GMArenaPeakBPView.Name)
        if ctrl then 
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.GMArenaPeakBPView.Name)
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        elseif require("GMArenaPeakModel"):GetInstance():GetFightIng() then 
            _G.BattleManager:GetInstance():SetRendererActive(true)
            _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
        else 
            GMArenaPeakModel:GetDataFormServer()
            if GMArenaPeakModel:CheckScoreIsKing() then 
                GMArenaPeakModel:RefreshRankNum(function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
                end)
            else 
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenaPeakView.Name)
            end
        end
    end
    require "GMArenaPeakNet":GetInstance():EnterOrQuit({type = 1})
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end
---初始化红点树
function GMArenaPeakActModel:InitRedPointTree()
    self.checkRedPointFunc = { self.CheckRedPoint }
    self.redpointTree = { false }
end

---所有活动解析完成后运行
function GMArenaPeakActModel:LaterInitFunction()
    local redPointId = self:GetRedpointIDByIndex(1)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamTeam.id)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamRelic.id)
    require "RedPointManager":GetInstance():AddRedPointChild(redPointId, _G.ConfigManager.redpoint_cfg.RelicTeamAttacked.id)
    local giftActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10014, 100081)
    if giftActivity then 
        require "RedPointManager":GetInstance():AddRedPointChild(redPointId, giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1))
    end
end

function GMArenaPeakActModel:ReConnect(endcall)
    if endcall ~= nil then
        endcall(self.__cname)
    end
    require "GMArenaPeakModel":GetInstance():GetDataFormServer()
end

---解析数据
---@param data table 服务器返回数据
function GMArenaPeakActModel:ParseData(data)
    self:InitFunction()
    if self.endCallback then
        self.endCallback(self.__cname)
    end
    require "GMArenaPeakModel":GetInstance():GetDataFormServer()
    self.endCallback = nil
    self.OnSixUpdateTag = nil
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function GMArenaPeakActModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---检查红点
function GMArenaPeakActModel:CheckRedPoint()
    if require "GMArenaPeakModel":GetInstance():CheckInEggAwrdStatus() then 
        if not require "GMArenaPeakModel":GetInstance().EggAwardFlag then 
            return 1
        end
    end
    return 0
end

---获取子活动的功能id
---@return table {10001} 活动功能id
function GMArenaPeakActModel:GetOtherActivityRedPointIds()
    return {10007, 10005, 10014}
end

---刷新奖励红点
function GMArenaPeakActModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

function GMArenaPeakActModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshRedPoint, self)
    self.super.Dispose(self)
end

return GMArenaPeakActModel
