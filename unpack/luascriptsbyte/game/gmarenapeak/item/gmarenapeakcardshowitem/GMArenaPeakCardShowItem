local CardInfoManager = require("CardInfoManager")

---@class GMArenaPeakCardShowItem    中文描述
---@field public go_table ArenaPeakBPView._obj_cardItem_GoTable
local GMArenaPeakCardShowItem = _G.BaseClass("GMArenaPeakCardShowItem", _G.Component)

local CS = _G.CS
local typeof = _G.typeof
local ConfigManager = _G.ConfigManager
local UIUtils = _G.UIUtils
local ElementEnum = {
    [1] = "ui_ty_btn_shaixuan_lei",
    [2] = "ui_ty_btn_shaixuan_feng",
    [3] = "ui_ty_btn_shaixuan_shui",
    [4] = "ui_ty_btn_shaixuan_huo",
    [5] = "ui_ty_btn_shaixuan_tu",
    [6] = "ui_ty_btn_shaixuan_shen",
}
local ProfessionalEnum = _G.ProfessionalIcon

---类的构造函数
---@field go_table ArenaPeakBPView._obj_card1_GoTable
function GMArenaPeakCardShowItem:__init(obj, index, callback)
    self.index = index
    self.callback = callback
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

---@param cardInfo arena_peak.i_room_card
function GMArenaPeakCardShowItem:Show(cardInfo, showEff, showBan, isEnemy)
    if cardInfo == nil then
        self.go_table.aorrawimage_role.Alpha = 0
        self.go_table.obj_card:SetActiveE(0)
    else
        self.go_table.obj_card:SetActiveE(1)
        --local cfg = ConfigManager.card_cfg[cardInfo.card_sid]
        local skinId
        if cardInfo.skin_id == nil then
            skinId = 0
        else
            skinId = cardInfo.skin_id > 0 and cardInfo.skin_id or cardInfo.card_sid
        end
        local cfg = require "CardCommentManager":GetInstance():CardData(skinId, false)

        if not self.cardItems then
            self.cardItems = require "ItemCardBodyBaseView".New(self.go_table.obj_node)
        end
        self.cardItems:Show(cardInfo)
    end
    self.go_table.aorimage_lock:SetActiveE((cardInfo == nil and not showEff) and 1 or 0)
    self:ShowEff(showEff)
    self.go_table.obj_ban:SetActiveE(showBan and 1 or 0)
end

---显示ban
function GMArenaPeakCardShowItem:ShowBan(isShow)
    self.go_table.obj_ban:SetActiveE(isShow and 1 or 0)
end

---显示特效
function GMArenaPeakCardShowItem:ShowEff(isShow)
    if isShow then
        self.go_table.obj_eff:SetLocalPositionToZero()
        self:LoadEffect()
    else
        self.go_table.obj_eff:SetLocalPosition(10000, 0, 0)
    end
end

---重新显示特效
function GMArenaPeakCardShowItem:ReshowEffect()
    self.go_table.obj_eff:SetActiveE(0)
    self.go_table.obj_eff:SetActiveE(1)
    self:LoadEffect()
    self.go_table.obj_eff:SetLocalPositionToZero()
end

---加载特效
function GMArenaPeakCardShowItem:LoadEffect()
    if self.go_table.obj_eff:GetChildCountE() == 0 then
        local eff = self.index < 7 and ConfigManager.ui_effect_cfg.ef_icon_jin or ConfigManager.ui_effect_cfg.ef_icon_hong
        UIUtils.LoadEffectByCfg(
                eff,
                self.go_table.obj_eff,
                function(trans)
                    if self == nil then
                        UIUtils.RemoveEffect(trans)
                        return
                    end
                end
        )
    end
end

---点击按钮
function GMArenaPeakCardShowItem:OnClickBtn(go, isOn)
    if self.callback then
        self.callback(go, isOn, self.index)
    end
end

---类的析构函数
function GMArenaPeakCardShowItem:Dispose()
end

return GMArenaPeakCardShowItem