    UIManager:GetInstance():CloseWindow(ConfigManager.ui_cfg.GMArenaPeakPromotionView.Name)
    UIManager:GetInstance():CloseWindow(ConfigManager.ui_cfg.BattleStatisticsPVEView.Name)
end

---@private
function GMArenaPeakView:OnDisable()
    if self.isMatching and not self.isCanceling then
        self.isCanceling = true
        self:QuitMatch()
    end
end

---界面的销毁函数
function GMArenaPeakView:OnDestroy()
    if self.isMatching and not self.isCanceling then
        self.isCanceling = true
        self:QuitMatch()
    end
    self:CloseOtherView()
    self:RemoveAllListener()
    Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
    Events:GetInstance():RemoveListener(_G.eArenaPeak.AutoNext, self.AutoNext, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.timerMatch then
        self.timerMatch:Stop()
        self.timerMatch = nil
    end
    --关闭内嵌页面
    if self.views then
        for k, view in pairs(self.views) do
            if k ~= 1 then
                view:Close()
            end
        end
        self.views = nil
    end
    require "GMArenaPeakNet":GetInstance():EnterOrQuit({type = 2})
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdata, self)
end

---按钮点击事件在这里派发
function GMArenaPeakView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_fight then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        if GMArenaPeakModel:GetInstance():IsCoinLimit() then
            if _G.StorageManager:GetInstance():GetItemCountBySid(self.costID) < _G.ConfigManager.discrete_cfg[108137][1][2] then
                self.go_table.toggle_hosting.isOn = false
                _G.PopWindowManager:GetInstance():ShowAllTips(880129)
                self:OpenGiftView()
                return
            end
            _G.PopWindowManager:GetInstance():ShowAllTips(880105)
            return
        end
        local state, tipsID = GMArenaPeakModel:GetInstance():CheckInOpenTime()
        if state ~= 0 then
            if tipsID then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipsID)
            end
            return
            
        end
        if not self.isMatching then
            if self.go_table.toggle_hosting.isOn == true and self:CheckPresetPosEmpty() then
                _G.PopWindowManager:GetInstance():ShowBtnWindowByToggle(
                    880128,
                    function()
                        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.GMArenaPeakPresetsView.Name)
                    end,
                    _G.handler(self, self.StartMatch),
                    _G.handler(self, self.StartMatch)
                )
            else
                self:StartMatch()
            end
        else
            self:QuitMatch()
        end
    elseif go == self.go_table.aorbtn_close then
        if self.curToggle ~= 1 then 
            self.toggleCom[1].isOn = true
        else 
            self:Close()
        end
    elseif go == self.go_table.aorbtn_skin then
        if not _G.AppSetting.IsXzns then
            --- 获取卡牌数据 查找此皮肤是否已经挂载在卡牌上了
            local skinData = {cardID = self.cardid, skinID = self.skinid}--GMArenaPeakModel:GetInstance():GetSkinData()

            local cardData = require("CardData").GetPreviewData(skinData.cardID)
            local skinList = cardData.cfg.skin
            local show = #skinList > 0 and cardData.type ~= _G.CardType.Timer
            local haveSkin = false
            if show then
                for i = 1, #skinList do
                    if skinList[i] == skinData.skinID then
                        haveSkin = true
                    end
                end
            end

            if haveSkin then
                cardData:SetSkin(0)
                _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.CardShowView.Name,
                        { CardData = cardData },
                        nil,
                        true,
                        nil,
                        skinData.skinID)
            end
        end
    elseif go == self.go_table.aorbtn_rank then
        self.toggleCom[4].isOn = true
    elseif go == self.go_table.aorbtn_help then
        UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 214)
    elseif go == self.go_table.aorbtn_group then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenPeakGroupStatisticsView.Name)
    elseif go == self.go_table.aorbtn_presets then
        -- if HostingLimit > GMArenaPeakModel:GetInstance():GetTotalNum() then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(880123)
        --     return
        -- end
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.GMArenaPeakPresetsView.Name)
    elseif go == self.go_table.toggle_hosting then
        local noArray = true
        local preChoose = require("GMArenaPeakModel"):GetInstance():GetPrePick() 
        if preChoose then
            for _, v in pairs(preChoose) do
                if v > 0 then
                    noArray = false
                    break
                end
            end
        end
        if noArray then
            self.go_table.toggle_hosting.isOn = false
            _G.PopWindowManager:GetInstance():ShowAllTips(880125)
            return
        end
        -- 获取 代币的获得信息，判断是否达到上限
        if not self.init and GMArenaPeakModel:GetInstance():IsCoinLimit() then
            self.go_table.toggle_hosting.isOn = false
            _G.PopWindowManager:GetInstance():ShowAllTips(880129)
            self:OpenGiftView()
            return
        end
        _G.PlayerPrefsManager.SetInt(HostingKey, isOn and 1 or 0)
    elseif go == self.go_table.aorbtn_serverList then
        GMArenaPeakNet:GetServerList(
            function(data)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
            end
        )
    elseif go == self.go_table.aorbtn_gift then
        --打开礼包界面
        local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10014,
            self.activity:GetJumpType(self.activityID))
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name, activity, 2)
    elseif go == self.go_table.aorbtn_taskAward then
        --打开限时任务界面
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.activity.activityID))
    elseif go == self.go_table.aorbtn_peakReport then 
        self.peakReportBol = true
        for i = 1, 6 do 
            self.go_table["toggle_tag" .. i].isOn = (i == 2)
        end
    end
end

function GMArenaPeakView:OpenGiftView()
    --打开礼包界面
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(10014,
    self.activity:GetJumpType(self.activityID))
    if activity then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GiftPackGMCommonView.Name, activity, 2)
    end
end

return GMArenaPeakView
