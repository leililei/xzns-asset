---更新时间
function GMArenaPeakSettlementView:UpdateTime(elapsed)
    if self:IsNil() then
        return
    end
    if self.countDown <= 0 then
        self:CloseCall(SettlementModel.FunctionEnum.None)
        return
    end
    self.countDown = self.countDown - elapsed
    self.go_table.aortext_tip.text = _G.GetLangPackValue(90029400196, _G.Mathf.RoundToInt(self.countDown))
end

