    if isHosting then
        self.countDown = 3
        self.go_table.aortext_tip.text = _G.GetLangPackValue(90029400196, _G.Mathf.RoundToInt(self.countDown))
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
