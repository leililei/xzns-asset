function GMArenaPeakSettlementView:SortAttacker()
    if self.isWin then
        if self.Attacker ~= nil then
            _G.SortList(
                self.Attacker,
                function(a)
                    return a.DmgOut
                end
            )
            return self.Attacker[1]
        end
    else
        if self.Attacker ~= nil then
            _G.SortList(
                self.Attacker,
                function(a)
                    return a.HpRecover, a.DmgIn
                end
            )
            return self.Attacker[1]
        end
    end
    return nil
end

function GMArenaPeakSettlementView:SortDefender()
    if self.isWin then
        if self.Defender ~= nil then
            _G.SortList(
                self.Defender,
                function(a)
                    return a.DmgOut
                end
            )
            return self.Defender[1]
        end
    else
        if self.Defender ~= nil then
            _G.SortList(
                self.Defender,
                function(a)
                    return a.HpRecover, a.DmgIn
                end
            )
            return self.Defender[1]
        end
    end
    return nil
end

function GMArenaPeakSettlementView:GetMvp(statisticsData, statisticsIndex, mvpData)
    ---@type Card CardData
    local Card = _G.CardData.New()
    if mvpData then
        Card:Parse(mvpData)
        self.CardData = Card
        self.showStatisticsBtn = false
        return
    end
    --默认一个sid保证一定会有模型生成
    --ZHJH-6671【战斗】战斗完后结算界面卡死且报错: 原本默认的card_cfg配置已被删除
    Card:Parse({ sid = 111070000, uid = 111070000 })
    self.CardData = Card
    if not _G.PlayerModel:GetInstance():CheckCreateRole() then
        return
    end

    --没传战报数据
    local hasFightArgs = self.fightArgTable and #self.fightArgTable > 0
    if not self.statisticsData then
        if _G.BattleManager:GetInstance():HasStatisticsCached() then
            self.statisticsData = _G.BattleManager:GetInstance():GetStatistics() --直接返回缓存数据
        elseif not hasFightArgs then
            self.statisticsData = _G.BattleManager:GetInstance():GetStatistics() --走C#打一遍纯逻辑战斗
            if _G.AppSetting.DEBUG then
                _G.LogError("没有战报数据和统计数据, 默认执行C#战斗统计")
            end
        end
    end

    if self.mvpCardSid then
        Card:Parse({ sid = self.mvpCardSid, uid = self.mvpCardSid })
        self.CardData = Card
    elseif self.statisticsData then
        --通过统计数据获取mvp
        local lastTeamIndex = #self.statisticsData.FighterInfo
        if self.statisticsData.FighterInfo[lastTeamIndex].Attacker ~= nil then
            self.Attacker = self.statisticsData.FighterInfo[lastTeamIndex].Attacker
        end
        if self.statisticsData.FighterInfo[lastTeamIndex].Defender ~= nil then
            self.Defender = self.statisticsData.FighterInfo[lastTeamIndex].Defender
        end
        local cardData
        cardData = self:SortAttacker()
        if cardData then
            if string.len(tostring(cardData.Uid)) < 12 then
                if card_cfg[cardData.Sid] then
                    Card:Parse({ sid = cardData.Sid, uid = cardData.Uid })
                elseif monster_cfg[cardData.Sid] then
                    Card:Parse({ sid = monster_cfg[cardData.Sid].CardID, uid = cardData.Uid })
                end
                self.CardData = Card
            else
                self.CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardData.Uid)
                --判断是不是空，如果是空 （去千机黑煞 卡牌库，拿数据）
                if self.CardData == nil then
                    Card:Parse({ sid = cardData.Sid, uid = cardData.Uid })
                    self.CardData = Card
                end
            end
        else
            self.showStatisticsBtn = false
            if _G.AppSetting.DEBUG then
                _G.LogError("没有进攻方数据")
            end
        end
    elseif hasFightArgs then
        --通过战报数据获取mvp
        ---@type fight.i_fight_arg
        local fightArg = self.fightArgTable[#self.fightArgTable]
        ---@type fight.i_fight_team[]
        local teamData = self.defender == 1 and fightArg.attacker_team or fightArg.defender_team
        if teamData and #teamData > 0 then
            ---@type fight.i_fight_fighter,number
            local cardArg, cardPower = nil, 0
            --计算卡牌属性战力
            ---@type AttributeClass
            local pc = _G.AttributeClass.New()
            pc:OnInit(nil, nil)
            for _, fight in pairs(teamData[1].fights) do
                pc.attribute = fight.attrs
                local power = pc:CalculatePower()
                if not cardArg or power > cardPower or power == cardPower and fight.lv > cardArg.lv then
                    cardArg = fight
                    cardPower = power
                end
            end
            if cardArg then
                if string.len(tostring(cardArg.uid)) < 12 then
                    if card_cfg[cardArg.sid] then
                        Card:Parse({ sid = cardArg.sid, uid = cardArg.uid })
                    elseif monster_cfg[cardArg.sid] then
                        Card:Parse({ sid = monster_cfg[cardArg.sid].CardID, uid = cardArg.uid })
                    end
                    self.CardData = Card
                else
                    self.CardData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, cardArg.uid)
                    --判断是不是空，如果是空 （去千机黑煞 卡牌库，拿数据）
                    if self.CardData == nil then
                        Card:Parse({ sid = cardArg.sid, uid = cardArg.uid })
                        self.CardData = Card
                    end
                end
            end
        else
            self.showStatisticsBtn = false
            if _G.AppSetting.DEBUG then
                _G.LogError("战报数据无团队信息, 无法获取mvp信息")
            end
        end
    else
        --是否展示统计数据按钮
        self.showStatisticsBtn = false
        if _G.AppSetting.DEBUG then
            _G.LogError("没有战报数据和统计数据, 无法获取mvp信息")
        end
    end
    if self.CardData then 
        local rolePath = _G.ConfigManager.card_cfg[self.CardData.sid].ModelPathHi
        require("CardInfoManager").GetRole(
                rolePath,
                _G.ePoolType.UIItem,
                self.go_table.trans_Mvp,
                _G.RoleEffTypeEnum.RoleShow,
                function(trans)
                    if trans == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("角色无法加载 path:" .. rolePath .. "    CardInfoself LoadRoleScene")
                        end
                        return
                    end
                    local myCard_show_cfg =
                    _G.ConfigManager.card_show_cfg[self.CardData.skin_id] or
                            _G.ConfigManager.card_show_cfg[self.CardData.sid]
                    if myCard_show_cfg == nil then
                        if _G.AppSetting.DEBUG then
                            _G.LogError("card_show_cfg 未找到配置 sid:" .. self.CardData.sid)
                        end
                    end

                    -- --设置  缩放
                    local scale = myCard_show_cfg and myCard_show_cfg.size4 or 1
                    trans:SetLocalScaleXYZ(scale)
                end
        )
    end
end

function GMArenaPeakSettlementView:GetMvp1()
    local dataList = self.PveData[1].statisticsData.Attacker
    if dataList ~= nil then
        local score = 0
        local index = 0
        for i = 1, #dataList do
            local data = dataList[i]
            local count = data.CreateGuard + data.DmgIn + data.DmgOut + data.HpRecover
            if count > score then
                score = count
                index = i
            end
        end
        if index ~= 0 then
            local cardData = dataList[index]
            local rolePath = _G.ConfigManager.card_cfg[cardData.Sid].ModelPathHi
            require("CardInfoManager").GetRole(
                    rolePath,
                    _G.ePoolType.UIItem,
                    self.go_table.trans_Mvp,
                    _G.RoleEffTypeEnum.RoleShow,
                    function(trans)
                        if trans == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("角色无法加载 path:" .. rolePath .. "    CardInfoself LoadRoleScene")
                            end
                            return
                        end
                        local myCard_show_cfg =
                        _G.ConfigManager.card_show_cfg[cardData.skin_id] or
                                _G.ConfigManager.card_show_cfg[cardData.Sid]
                        if myCard_show_cfg == nil then
                            if _G.AppSetting.DEBUG then
                                _G.LogError("card_show_cfg 未找到配置 sid:" .. cardData.Sid)
                            end
                        end

                        -- --设置  缩放
                        local scale = myCard_show_cfg and myCard_show_cfg.size4 or 1
                        trans:SetLocalScaleXYZ(scale)
                    end
            )
        end
    end
end

function GMArenaPeakSettlementView:SetAwardCount()
    local count = 0
    local count1 = 0
    if self.AwardData and not _G.table.isEmptyOrNil(self.AwardData) then
        count = _G.table.count(self.AwardData)
    end
    if self.ExtraAward and not _G.table.isEmptyOrNil(self.ExtraAward) then
        count1 = _G.table.count(self.ExtraAward)
    end
    self.awardCount = count + count1
end

function GMArenaPeakSettlementView:LoadAwardView()
    if self.awardCount > 0 then
        if self.AllItem == nil then
            self.AllItem = {}
        end
        self.CreateCount = 0
        self:ParseAward(self.AwardData, self.ExtraAward, self.privilegeData)
        self:CreateItem(self.Award)
    end
end

function GMArenaPeakSettlementView:ParseAward(award, extraAward, privilegeData)
    self.Award = {}
    local Award = {}
    if award and not _G.table.isEmptyOrNil(award) then
        for k, v in pairs(award.item or award) do
            _G.table.insert(Award, { _award = v.type or v, _extra = false })
        end
    end
    if extraAward and not _G.table.isEmptyOrNil(extraAward) then
        for k, v in pairs(extraAward.item or extraAward) do
            _G.table.insert(Award, { _award = v.type or v, _extra = true })
        end
    end
    if privilegeData and not _G.table.isEmptyOrNil(privilegeData) then
        for k, v in pairs(privilegeData.item or privilegeData) do
            _G.table.insert(Award, { _award = v.type or v, _privilege = true })
        end
    end
    if not _G.table.isEmptyOrNil(Award) and self.AwardDataSort ~= 0 then
        _G.SortList(
            Award,
            function(a)
                local storageID = _G.StorageManager:GetInstance():CheckSidType(a._award[1])
                local extra = a._extra and 0 or 1
                return storageID, a._award[1], extra
            end
        )
    end
    self.Award = Award
end

function GMArenaPeakSettlementView:CreateItem(award)
    local awardItem
    -- local sid
    -- local count
    if award and not _G.table.isEmptyOrNil(award) then
        --按照货币，道具，装备，id的顺序排序
        if self.AwardDataSort ~= 0 then
            for i = 1, #award do
                local type = _G.StorageManager:GetInstance():CheckSidType(award[i]._award[1])
                type = tonumber(type)
                if type == 4 then
                    award[i].Order = 1
                elseif type == 1 then
                    award[i].Order = 2
                elseif type == 5 then
                    award[i].Order = 3
                else
                    award[i].Order = 4
                end
            end
            _G.SortList(
                award,
                function(a)
                    if not _G.table.isEmptyOrNil(self.privilegeData) then
                        local privilege = a._privilege and 0 or 1
                        return privilege, -a.Order, -a._award[1]
                    end
                    return -a.Order, -a._award[1]
                end
            )
        end
        for _, v in ipairs(award) do
            local goTable
            awardItem = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_AwardContent)
            awardItem:SetActiveE(1)
            _G.table.insert(self.AllItem, awardItem:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform)))
            goTable = _G.GetAutoGoTable(awardItem)
            goTable.sid = v._award[1]
            goTable.data = v._award
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                v._award,
                goTable.obj_root,
                function(tran)
                    if self:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran.gameObject:SetLocalPosition(0, 0, 0)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    self.CreateCount = self.CreateCount + 1
                end,
                function()
                    self:ClickAward(goTable)
                end
            )
            _G.GameUtil.SetActiveByCondition(goTable.aorimage_extra, v._extra)
            _G.GameUtil.SetActiveByCondition(goTable.aorimage_zengyi, v._privilege)
        end
    end
end

function GMArenaPeakSettlementView:ClickAward(goTable)
    local type = _G.StorageManager:GetInstance():CheckSidType(goTable.sid)
    if type == _G.StorageType.Card then
        ---@type DynamicCfg
        local dc = {}
        dc.HideWorld = false
        require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid, nil, dc)
    elseif type == _G.StorageType.Decoration then
        local uid = goTable.data and goTable.data[2] or 0
        local cfg = _G.ConfigManager.decoration_cfg[goTable.sid]
        local data = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Decoration, uid)
        if _G.table.isEmptyOrNil(data) then
            data = nil
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name, data, cfg, false, nil, nil, false, true)
    else
        require("CommonTipManager"):GetInstance():OpenTip(goTable.gameObject, goTable.sid)
    end
end

function GMArenaPeakSettlementView:OnUIOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    view.transform:SetParentE(self.go_table.trans_view)
    view:RegiestEffectViewOpen(function(isWin)
    end)
    _G.PopWindowManager:GetInstance():SetNowPopping(true)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
end

---界面的销毁函数
function GMArenaPeakSettlementView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

---按钮点击事件在这里派发
function GMArenaPeakSettlementView:OnClickBtn(go)
    if go == self.go_table.aorbtn_bg then
        self:CloseCall(SettlementModel.FunctionEnum.None)
        GMArenaPeakModel:GetInstance():ReturnPanel(nil, false)
    elseif go == self.go_table.aorbtn_close then
        self:CloseCall(SettlementModel.FunctionEnum.None)
        GMArenaPeakModel:GetInstance():ReturnPanel(nil, true)
    elseif go == self.go_table.aorbtn_statistics then
        self:UpdateData(_G.BattleManager:GetInstance():GetStatisticsRecord(self.fight_arg))
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
                self.PveData,
                self.winnerTable,
                nil,
                nil,
                self.otherPlayer,
                1,
                true,
                self.fight_arg,
                nil,
                {self.playback_uid},
                nil,   --先屏蔽分享 self.reportType
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                true,
                {nil, self.result.def_role.name}
        )
    end
end

return GMArenaPeakSettlementView
