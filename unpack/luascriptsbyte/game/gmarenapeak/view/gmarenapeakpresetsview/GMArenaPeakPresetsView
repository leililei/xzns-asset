function GMArenaPeakPresetsView:RefreshBanCardItem(index, obj)
    index = index + 1
    local cfg = self.curIlls[index]
    ---@type _obj_Choose._obj_cardItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickBanCardItem, index, cfg))
    if tb.card then
        if tb.card ~= true then
            tb.card:Show(cfg.id, nil, 24, nil, 300)
        end
    else
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_card,
            function(item)
                tb.card = item
                item:Show(cfg.id, nil, 24, nil, 300)
            end
        )
    end
    tb.aorimage_mask:SetActiveE(_G.table.ContainsValue(self.preBan, cfg.id) and 1 or 0)
end

function GMArenaPeakPresetsView:UpdateCardIllList()
    self.curIlls = {}
    for _, v in pairs(self.ills) do
        if v.Elements == self.curBElement or self.curBElement == elementType.None then
            if v.EquipmentType == self.curBEquipment or self.curBEquipment == 0 then
                if v.Professional == self.curBProf or self.curBProf == profType.None then
                    _G.table.insert(self.curIlls, v)
                end
            end
        end
    end
    self.banTb.scrollloopvectical_card:UpdateCount(#self.curIlls)
end

function GMArenaPeakPresetsView:OnClickBanItem(go, isOn, index)
    if self.preBan[index] > 0 then
        self.preBan[index] = 0
        self.banItems[index].obj_card:SetActiveE(0)
        self.banTb.scrollloopvectical_card:UpdateAllItem()
    end
end

function GMArenaPeakPresetsView:OnClickBanCardItem(go, isOn, index, cfg)
    local pos
    for i = 1, #self.preBan do
        if self.preBan[i] == cfg.id then --下阵
            self.preBan[i] = 0
            self:ShowPresetsCard(self.banItems[i], nil)
            self.banTb.scrollloopvectical_card:UpdateItemSingle(index - 1)
            return
        elseif self.preBan[i] == 0 and pos == nil then
            pos = i
        end
    end
    if pos == nil then
        return
    end
    self.preBan[pos] = cfg.id
    self:ShowPresetsCard(self.banItems[pos], cfg)
    self.banTb.scrollloopvectical_card:UpdateItemSingle(index - 1)
end

function GMArenaPeakPresetsView:OnClickBan(go, isOn)
    if go == self.banTb.aorbtn_lei then
        self:ChangeListType(elementType.Thunder)
    elseif go == self.banTb.aorbtn_feng then
        self:ChangeListType(elementType.Wind)
    elseif go == self.banTb.aorbtn_shui then
        self:ChangeListType(elementType.Water)
    elseif go == self.banTb.aorbtn_huo then
        self:ChangeListType(elementType.Fire)
    elseif go == self.banTb.aorbtn_tu then
        self:ChangeListType(elementType.Earth)
    elseif go == self.banTb.aorbtn_shen then
        self:ChangeListType(elementType.God)
    elseif go == self.banTb.aorbtn_all then
        self:ChangeListType(elementType.None)
    elseif go == self.banTb.aorbtn_pAll then
        self:ChangeProfListType(profType.None)
    elseif go == self.banTb.aorbtn_pTK then
        self:ChangeProfListType(profType.Tank)
    elseif go == self.banTb.aorbtn_pZS then
        self:ChangeProfListType(profType.Warrior)
    elseif go == self.banTb.aorbtn_pFS then
        self:ChangeProfListType(profType.Master)
    elseif go == self.banTb.aorbtn_pFZ then
        self:ChangeProfListType(profType.Support)
    elseif go == self.banTb.aorbtn_pYX then
        self:ChangeProfListType(profType.Ranger)
    elseif go == self.banTb.aorbtn_eAll then
        self:ChangeEquipmentListType(0)
    elseif go == self.banTb.aorbtn_eLiliang then
        self:ChangeEquipmentListType(equipmentType.Plank)
    elseif go == self.banTb.aorbtn_eMinjie then
        self:ChangeEquipmentListType(equipmentType.Coat)
    elseif go == self.banTb.aorbtn_eZhili then
        self:ChangeEquipmentListType(equipmentType.Cloth)
    elseif go == self.banTb.aorbtn_check1 or go == self.banTb.aorbtn_check2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenPeakGroupStatisticsView.Name, "ban")
    elseif go == self.banTb.aorbtn_typeList then
        self:ShowBanTypeListView(not self.showBanTypeListTag)
    else
        self:OnToggleElement(go, isOn)
    end
end

