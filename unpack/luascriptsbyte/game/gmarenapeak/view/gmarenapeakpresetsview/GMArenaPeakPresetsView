function GMArenaPeakPresetsView:ShowChooseTypeListView(show)
    self.showChooseTypeListTag = show
    _G.GameUtil.SetActiveByCondition(self.chooseTb.obj_equipment, show)
    _G.GameUtil.SetActiveByCondition(self.chooseTb.obj_prof, show)
