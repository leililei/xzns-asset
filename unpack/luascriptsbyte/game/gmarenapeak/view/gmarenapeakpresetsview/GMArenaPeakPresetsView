function GMArenaPeakPresetsView:ShowPresetsCard(tb, card)
    tb.obj_card:SetActiveE(card ~= nil and 1 or 0)
    if card == nil then
        return
    end
    if self.curPage == 1 then
        if tb.card then
            if tb.card ~= true then
                tb.card:ShowCardData(card, nil, true, true)
            end
        else
            tb.card = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_card,
                function(item)
                    tb.card = item
                    item:ShowCardData(card, nil, true, true)
                end
            )
        end
    else
        if tb.card then
            if tb.card ~= true then
                tb.card:Show(card.id, nil, 24, nil, 300)
            end
        else
            tb.card = true
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                tb.obj_card,
                function(item)
                    tb.card = item
                    item:Show(card.id, nil, 24, nil, 300)
                end
            )
        end
    end
end

--region ------------- 预设选择 -------------

function GMArenaPeakPresetsView:RefreshChooseCardItem(index, obj)
    index = index + 1
    local cardData = self.curCards[index]
    ---@type _obj_Choose._obj_cardItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickChooseCardItem, index, cardData))
    if tb.card then
        if tb.card ~= true then
            tb.card:ShowCardData(cardData, nil, true, true)
        end
    else
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_card,
            function(item)
                tb.card = item
                item:ShowCardData(cardData, nil, true, true)
            end
        )
    end
    tb.aorimage_mask:SetActiveE(_G.table.ContainsValue(self.preChoose, cardData.uid) and 1 or 0)
end

function GMArenaPeakPresetsView:UpdateCardList()
    self.curCards = {}
    for _, v in pairs(self.cards) do
        if v:GetElement() == self.curCElement or self.curCElement == elementType.None then
            if v.cfg.EquipmentType == self.curCEquipment or self.curCEquipment == 0 then
                if v.cfg.Professional == self.curCProf or self.curCProf == profType.None then
                    _G.table.insert(self.curCards, v)
                end
            end
        end
    end
    self.chooseTb.scrollloopvectical_card:UpdateCount(#self.curCards)
end

function GMArenaPeakPresetsView:OnClickChooseItem(go, isOn, index)
    if self.preChoose[index] and self.preChoose[index] > 0 then
        self.preChoose[index] = 0
        self.chooseItems[index].obj_card:SetActiveE(0)
        self.chooseTb.scrollloopvectical_card:UpdateAllItem()
    end
end

function GMArenaPeakPresetsView:OnClickChooseCardItem(go, isOn, index, cardData)
    local preData, pos
    for i = 1, #self.preChoose do
        if self.preChoose[i] == cardData.uid then --下阵
            self.preChoose[i] = 0
            self:ShowPresetsCard(self.chooseItems[i], nil)
            self.chooseTb.scrollloopvectical_card:UpdateItemSingle(index - 1)
            return
        elseif self.preChoose[i] > 0 then --同名
            preData = self:GetEmbattleCardData(self.preChoose[i])
            if preData and cardData.sid == preData.sid then
                _G.PopWindowManager:GetInstance():ShowAllTips(220101)
                return
            end
        elseif pos == nil then
            pos = i
        end
    end
    if pos == nil then
        return
    end
    self.preChoose[pos] = cardData.uid
    self:ShowPresetsCard(self.chooseItems[pos], cardData)
    self.chooseTb.scrollloopvectical_card:UpdateItemSingle(index - 1)
end

function GMArenaPeakPresetsView:OnClickChoose(go, isOn)
    if go == self.chooseTb.aorbtn_lei then
        self:ChangeListType(elementType.Thunder)
    elseif go == self.chooseTb.aorbtn_feng then
        self:ChangeListType(elementType.Wind)
    elseif go == self.chooseTb.aorbtn_shui then
        self:ChangeListType(elementType.Water)
    elseif go == self.chooseTb.aorbtn_huo then
        self:ChangeListType(elementType.Fire)
    elseif go == self.chooseTb.aorbtn_tu then
        self:ChangeListType(elementType.Earth)
    elseif go == self.chooseTb.aorbtn_shen then
        self:ChangeListType(elementType.God)
    elseif go == self.chooseTb.aorbtn_all then
        self:ChangeListType(elementType.None)
    elseif go == self.chooseTb.aorbtn_pAll then
        self:ChangeProfListType(profType.None)
    elseif go == self.chooseTb.aorbtn_pTK then
        self:ChangeProfListType(profType.Tank)
    elseif go == self.chooseTb.aorbtn_pZS then
        self:ChangeProfListType(profType.Warrior)
    elseif go == self.chooseTb.aorbtn_pFS then
        self:ChangeProfListType(profType.Master)
    elseif go == self.chooseTb.aorbtn_pFZ then
        self:ChangeProfListType(profType.Support)
    elseif go == self.chooseTb.aorbtn_pYX then
        self:ChangeProfListType(profType.Ranger)
    elseif go == self.chooseTb.aorbtn_eAll then
        self:ChangeEquipmentListType(0)
    elseif go == self.chooseTb.aorbtn_eLiliang then
        self:ChangeEquipmentListType(equipmentType.Plank)
    elseif go == self.chooseTb.aorbtn_eMinjie then
        self:ChangeEquipmentListType(equipmentType.Coat)
    elseif go == self.chooseTb.aorbtn_eZhili then
        self:ChangeEquipmentListType(equipmentType.Cloth)
    elseif go == self.chooseTb.aorbtn_check1 or go == self.chooseTb.aorbtn_check2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenPeakGroupStatisticsView.Name, "bp")
    elseif go == self.chooseTb.aorbtn_typeList then
        self:ShowChooseTypeListView(not self.showChooseTypeListTag)
    else
        self:OnToggleElement(go, isOn)
    end
end

