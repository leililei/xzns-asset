---按钮点击事件在这里派发
function GMArenaPeakPresetsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close2 then
        local pb = {}
        local num = 0
        for k, v in pairs(self.preChoose) do
            if v ~= 0 then
                num = num + 1
            end
        end
        if num < 12 then
            _G.PopWindowManager:GetInstance():ShowAllTips(880132, nil, function()
                self:Close()
            end)
        else
            pb.pre_pick = self.preChoose
            pb.pre_ban = self.preBan
            require("GMArenaPeakModel"):GetInstance():PreSet(pb, _G.handler(self, self.Close))
        end
        self:Close()
    elseif go == self.go_table.aorbtn_check1 or go == self.go_table.aorbtn_check2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GMArenPeakGroupStatisticsView.Name)
    end
end

return GMArenaPeakPresetsView
