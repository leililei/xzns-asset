---Toggle点击事件
function GMArenaPeakPresetsView:OnToggleElement(go, isOn)
    local name = go:GetName()
    if not _G.string.contains(name, "toggle") then
        return
    end
    local str = _G.string.replace(name, "$_toggle_", "")
    local element = _G.tonumber(str)
    if element == 5 then
        element = 6
    end
    self:ChangeListType(element)
end

function GMArenaPeakPresetsView:RefreshChooseRankItem(index, obj)
    index = index + 1
    ---@type _obj_Choose._obj_rankItem_GoTable
    local tb = _G.GetAutoGoTable(obj)
    local data = self.cardInfo[index]
    tb.aortext_rankNum.text = index
    if tb.card then
        if tb.card ~= true then
            tb.card:Show(data.card_sid, nil, 24)
            tb.card:HideOrShowLevel(false)
        end
    else
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_card,
            function(item)
                tb.card = item
                item:Show(data.card_sid, nil, 24)
                item:HideOrShowLevel(false)
            end
        )
    end
    tb.aortext_rate.text = data.win_rate / 100 .. "%"
end

