---@class GMArenaPeakPromotionView : UIBaseView    中文描述
---@field public go_table SpiritualRealmPromotionView_GoTable GoTable
local GMArenaPeakPromotionView = _G.BaseClass("GMArenaPeakPromotionView", _G.UIBaseView)
local UIUtils = _G.UIUtils

function GMArenaPeakPromotionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GMArenaPeakPromotionView:OnCreate(score)
    local arena_layer_league_cfg = require "GMArenaPeakModel":GetInstance():GetDanCfgByScore(score)
    self.go_table.aorrawimage_dan:LoadImage(arena_layer_league_cfg.icon)
    self.go_table.aortext_rank.text = _G.GetLangPackValue(arena_layer_league_cfg.name)
    self:ShowEffect()
end

---显示特效
function GMArenaPeakPromotionView:ShowEffect()
end

---界面的销毁函数
function GMArenaPeakPromotionView:OnDestroy()
end

---按钮点击事件在这里派发
function GMArenaPeakPromotionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    end
end

return GMArenaPeakPromotionView
