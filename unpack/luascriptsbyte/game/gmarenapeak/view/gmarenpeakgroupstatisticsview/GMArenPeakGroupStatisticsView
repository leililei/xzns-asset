---@class GMArenPeakGroupStatisticsView : UIBaseView	中文描述
---@field public go_table GMArenPeakGroupStatisticsView_GoTable GoTable
---@field curRankList card_use_rate.i_peak_card[]
---@field scoreList arena_peak_league_cfg[]         @段位分段数据(只取最高星级)
---@field curScoreIndex number                      @当前选中的段位序号
local GMArenPeakGroupStatisticsView = _G.BaseClass("GMArenPeakGroupStatisticsView", _G.UIBaseView)
local GMArenaPeakModel = require "GMArenaPeakModel"
local GetAutoGoTable = _G.GetAutoGoTable
local GetLangPackValue = _G.GetLangPackValue
local sortType = {
    bp = "bp",
    win = "win",
    ban = "ban"
}

local LanguageIds = {
    ---第%s赛季
    Seation = 90029400091,
    ---段位:%s
    Dan = 90029400092,
    ---全部段位
    AllDan = 90029400093,
    --详情
    Detail = 90029400094
}
local ScoreLanguageIds = {
    [1] = 0,
    [2] = 90029400209, --钻石
    [3] = 90029400208, --黄金
    [4] = 90029400207, --白银
    [5] = 90029400206, --青铜
}
function GMArenPeakGroupStatisticsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GMArenPeakGroupStatisticsView:OnCreate(type)
    self.rankList = {}
    self.curRankList = {}
    self.playerSectionId = GMArenaPeakModel:GetInstance():GetCurSeasonID()
    self.playerDan = GMArenaPeakModel:GetInstance():GetCurDanCfg().id
    self.curScoreIndex = 0
    self.curSectionId = self.playerSectionId
    self.sortCondition = { bp = 1, win = 1, ban = 1 }
    self.maxSection = _G.ConfigManager.discrete_cfg[108121][1][1]
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshRankItem))
    self:InitScoreData()
    self:RefreshPanel()
    self.sortType = type
end

---初始化段位信息
---@return void
function GMArenPeakGroupStatisticsView:InitScoreData()
    --遍历arena_peak_league_cfg表, 获取每阶段最高星级的段位
    --arena_peak_league_cfg表id必需从1开始且连续???
    self.scoreList = {}
    ---@type arena_peak_league_cfg
    local last
    ---@param v arena_peak_league_cfg
    for _, v in ipairs(_G.ConfigManager.arena_peak_league_cfg) do
        if last and (last.quantity <= 0 or v.art ~= last.art) then
            table.insert(self.scoreList, last)
            last = nil
        end
        if not last or v.quantity > last.quantity then
            last = v
        end
    end
    if last then
        table.insert(self.scoreList, last)
    end
    table.sort(self.scoreList, function(a, b)
        return a.min_score > b.min_score
    end)
end

---显示界面
function GMArenPeakGroupStatisticsView:ShowView()
    local danCfg = self.scoreList[self.curScoreIndex]
    if danCfg then
        self.curRankList = self.rankList[danCfg.id] or {}
    else
        self.curRankList = self.rankList[0] or {}
    end

    self.go_table.obj_no:SetActiveE(_G.table.isEmptyOrNil(self.curRankList) and 1 or 0)
    self.go_table.scrollloopvectical_rankList:UpdateCount(#self.curRankList)

    if danCfg then
        local name = ScoreLanguageIds[self.curScoreIndex]
        if not name or name == 0 then
            name = danCfg.name
        end
        self.go_table.aortext_curDan.text = GetLangPackValue(LanguageIds.Dan, GetLangPackValue(name))
    else
        self.go_table.aortext_curDan.text = GetLangPackValue(LanguageIds.Dan, GetLangPackValue(LanguageIds.AllDan))
    end
    self.go_table.aortext_curSeason.text = GetLangPackValue(LanguageIds.Seation, self.curSectionId)
end

---获取排行数据
---@param seasonId number 赛季id
---@param dan number 段位
function GMArenPeakGroupStatisticsView:GetRankData(seasonId, dan, call)
    require "ArenaPeakNet":GetInstance():GetCardUseRate(
        {
            season_id = seasonId,
            duan_id = dan
        },
        function(msg)
            self.rankList[dan] = msg.card_info
            if call then
                call()
            end
        end
    )
end

---刷新排行榜物体
function GMArenPeakGroupStatisticsView:RefreshRankItem(index, obj)
    ---@type GMArenPeakGroupStatisticsView._obj_rankItem_GoTable
    local tb = GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickRank, index + 1))
    local rank = self.curRankList[index + 1]
    if not tb.card then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { rank.card_sid, 1 },
            tb.obj_card,
            function(item)
                ---@type ItemCardBaseView
                tb.card = item
                tb.card.mItemCardAllView:Show(rank.card_sid, nil, 24)
                tb.card:ShowLv(false)
            end,
            _G.handlerbind(self, self.OnClickCard, tb)
        )
    else
        tb.card.mItemCardAllView:Show(rank.card_sid, nil, 24)
    end
    tb.index = index + 1
    tb.aortext_bp.text = rank.choose_rate / 100 .. "%"
    tb.aortext_ban.text = rank.ban_rate / 100 .. "%"
    tb.aortext_winRate.text = rank.win_rate / 100 .. "%"
    tb.aortext_name.text = _G.StorageManager:GetInstance():GetItemName(rank.card_sid)
    if not tb.extendText then
        local str = _G.string.format("<%s@%s>", GetLangPackValue(LanguageIds.Detail), 1)
        tb.extendText = tb.obj_detail:GetComponentE(_G.typeof(_G.CS.ExtendText))
        tb.extendText.text = str
    end
end

