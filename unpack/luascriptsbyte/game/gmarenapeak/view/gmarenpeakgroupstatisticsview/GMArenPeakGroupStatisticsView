---按钮点击事件在这里派发
function GMArenPeakGroupStatisticsView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_danArrow then
        self:ShowDanSelect()
    elseif go == self.go_table.aorbtn_seasonArrow then
        self:ShowSeasonSelect()
    elseif go == self.go_table.aorbtn_ban then
        self:OnClickSort(sortType.ban)
    elseif go == self.go_table.aorbtn_bp then
        self:OnClickSort(sortType.bp)
    elseif go == self.go_table.aorbtn_win then
        self:OnClickSort(sortType.win)
    end
end

---显示赛季选择
function GMArenPeakGroupStatisticsView:ShowSeasonSelect()
    if self.go_table.obj_isSeasonSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isSeasonSelect:SetActiveE(1)
        self.go_table.aorimage_seasonArrow:SetRotation(0, 0, 180)

        if not self.zoneInit then
            local count = self.playerSectionId > self.maxSection and self.maxSection or self.playerSectionId
            self.endSectionId = count
            self.go_table.scrollloopvectical_seasonList:InitItemData(count, _G.handler(self, self.RefreshSeasonItem))
            self.zoneInit = true
        else
            self.go_table.scrollloopvectical_seasonList:UpdateCount(self.endSectionId)
        end
        if self.go_table.obj_isDanSelect:GetActiveSelf() == 1 then
            self.go_table.obj_isDanSelect:SetActiveE(0)
            self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
        end
    else
        ---合上
        self.go_table.obj_isSeasonSelect:SetActiveE(0)
        self.go_table.aorimage_seasonArrow:SetRotation(0, 0, 0)
    end
end

---刷新大区item
function GMArenPeakGroupStatisticsView:RefreshSeasonItem(index, obj)
    ---@type _obj_zoneRank._obj_zoneItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelectSeason, index + 1))
    tb.aortext_season.text = GetLangPackValue(LanguageIds.Seation, index + 1)
    if index + 1 == self.curSectionId then
        tb.obj_isMySeason:SetActiveE(1)
        tb.aortext_season.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMySeason:SetActiveE(0)
        tb.aortext_season.color = _G.ColorTools.FormatColorByString("808199")
    end
    tb.obj_line:SetActiveE(index + 1 == self.endSectionId and 0 or 1)
end

function GMArenPeakGroupStatisticsView:OnSelectSeason(_, _, season)
    self.go_table.obj_isSeasonSelect:SetActiveE(0)
    self.go_table.aorimage_seasonArrow:SetRotation(0, 0, 0)
    if self.curSectionId == season then
        return
    end

    self.curSectionId = season
    self:RefreshPanel()
end

function GMArenPeakGroupStatisticsView:ShowDanSelect()
    if self.go_table.obj_isDanSelect:GetActiveSelf() == 0 then
        ---展开
        self.go_table.obj_isDanSelect:SetActiveE(1)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 180)
        if not self.zoneDanInit then
            self.go_table.scrollloopvectical_danList:InitItemData(#self.scoreList + 1,
                _G.handler(self, self.RefreshDanItem))
            self.zoneDanInit = true
        else
            self.go_table.scrollloopvectical_danList:UpdateCount(#self.scoreList + 1)
        end
        if self.go_table.obj_isSeasonSelect:GetActiveSelf() == 1 then
            self.go_table.obj_isSeasonSelect:SetActiveE(0)
            self.go_table.aorimage_seasonArrow:SetRotation(0, 0, 0)
        end
    else
        ---合上
        self.go_table.obj_isDanSelect:SetActiveE(0)
        self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    end
end

---刷新段位显示
function GMArenPeakGroupStatisticsView:RefreshDanItem(index, obj)
    ---@type GMArenPeakGroupStatisticsView._obj_danItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnSelectDan, index))
    if index == 0 then
        tb.aortext_zone.text = GetLangPackValue(LanguageIds.AllDan)
        tb.obj_isMyZone:SetActiveE(0)
        tb.obj_star:SetActiveE(0)
        tb.aorrawimage_dan.Alpha = 0
    else
        ---@type arena_peak_league_cfg
        local cfg = self.scoreList[index]
        local isKing = cfg.quantity <= 0 and cfg.id ~= 1

        tb.aortext_zone.text = "" -- GetLangPackValue(data.name)
        if isKing then
            tb.aorrawimage_dan:LoadImage(cfg.icon, function(image)
                if _G.IsNil(image) then
                    return
                end
                image.Alpha = 1
            end)
        else
            local defaultStarImage = GMArenaPeakModel:GetInstance():GetDefaultStarImage()
            tb.aorimage_star4.SpriteName = cfg.quantity <= 0 and defaultStarImage or cfg.art
            for i = 1, 3 do
                if i <= cfg.quantity then
                    tb["aorimage_star" .. i].SpriteName = cfg.art
                else
                    tb["aorimage_star" .. i].SpriteName = defaultStarImage
                end
            end
        end
        tb.obj_star:SetActiveE(isKing and 0 or 1)
        if cfg.quantity > 0 then
            tb.aorrawimage_dan.Alpha = 0
        end
    end
    if index == self.curScoreIndex then
        --tb.aortext_zone.text = ""
        tb.obj_isMyZone:SetActiveE(1)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("ffffff")
    else
        tb.obj_isMyZone:SetActiveE(0)
        tb.aortext_zone.color = _G.ColorTools.FormatColorByString("808199")
    end
end

---选择段位
function GMArenPeakGroupStatisticsView:OnSelectDan(_, _, index)
    self.go_table.obj_isDanSelect:SetActiveE(0)
    self.go_table.aorimage_danArrow:SetRotation(0, 0, 0)
    if self.curScoreIndex == index then
        return
    end
    self.curScoreIndex = index
    self:RefreshPanel()
end

---刷新界面
function GMArenPeakGroupStatisticsView:RefreshPanel()
    self.sortIndexT = { bp = 1, win = 1, ban = 1 }
    --获取此段位包含的id
    ---@type number[]
    local ids = {}
    if self.curScoreIndex == 0 then
        table.insert(ids, 0)
    else
        local curCfg = self.scoreList[self.curScoreIndex]
        table.insert(ids, curCfg.id)
        for id = curCfg.id - 1, 1, -1 do
            local cfg = _G.ConfigManager.arena_peak_league_cfg[id]
            if not cfg or cfg.quantity <= 0 or cfg.art ~= curCfg.art then
                break
            end
            table.insert(ids, cfg.id)
        end
    end

    --整合多段位数据(加权平均)
    local function resolve()
        local num = #ids
        if num <= 1 then
            --只有一个id, 直接使用
            self:ShowView()
            return
        end

        ---获取主显段位列表
        ---@type card_use_rate.i_peak_card[]
        local main = self.rankList[ids[1]]
        if not main then
            self:ShowView()
            return
        end

        --重新进行平均加权平均
        ---@type table<number, card_use_rate.i_peak_card>
        local map = {}
        for _, v in pairs(main) do
            map[v.card_sid] = v
        end
        for i = 2, #ids do
            ---@type card_use_rate.i_peak_card[]
            local lst = self.rankList[ids[i]] or {}
            for _, v in pairs(lst) do
                local exists = map[v.card_sid]
                if exists then
                    exists.ban_rate = exists.ban_rate + v.ban_rate
                    exists.choose_rate = exists.choose_rate + v.choose_rate
                    exists.win_rate = exists.win_rate + v.win_rate
                    exists.play_num = exists.play_num + v.play_num
                else
                    map[v.card_sid] = v
                    table.insert(main, v)
                end
            end
        end
        for _, exists in pairs(main) do
            exists.ban_rate = math.floor(exists.ban_rate / num)
            exists.choose_rate = math.floor(exists.choose_rate / num)
            exists.win_rate = math.floor(exists.win_rate / num)
            exists.play_num = math.floor(exists.play_num / num)
        end
        ---重新进行排序(上阵率)
        table.sort(main, function(a, b)
            return a.play_num > b.play_num
        end)

        self:ShowView()
    end
    --发起段位信息请求
    ---@param index number
    local function next(index)
        if self:IsNil() then
            return
        end
        if index > #ids then
            resolve()
            return
        end
        local id = ids[index]
        ---@param msg card_use_rate.s2c_rate_arena_peak
        require "ArenaPeakNet":GetInstance():GetCardUseRate(
            {
                season_id = self.curSectionId,
                duan_id = id
            },
            function(msg)
                local lst = msg.card_info or {}
                --过滤品质<=2的卡牌(奇卡和凡卡)
                for i = #lst, 1, -1 do
                    local cfg = _G.ConfigManager.card_cfg[lst[i].card_sid]
                    if not cfg or cfg.Order <= 2 then
                        table.remove(lst, i)
                    end
                end
                self.rankList[id] = lst
                next(index + 1)
            end
        )
    end
    next(1)
end

