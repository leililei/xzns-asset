---数据排序
---@param type string sortType
function GMArenPeakGroupStatisticsView:SortList(type)
    if type and self.sortCondition[type] then
        local value = self.sortCondition[type]
        self.sortCondition.bp = 1
        self.sortCondition.win = 1
        self.sortCondition.ban = 1
        self.sortIndexT[type] = self.sortIndexT[type] + 1
        local index = self.sortIndexT[type] % 3
        for k, v in pairs(self.sortIndexT) do 
            if k == type then 
                self.go_table["aorimage_" .. k .. 1]:SetActiveE(index == 2 and 1 or 0)
                self.go_table["aorimage_" .. k .. 2]:SetActiveE(index == 0 and 1 or 0)
            else 
                self.sortIndexT[k] = 1
                for i = 1, 2 do 
                    self.go_table["aorimage_" .. k .. i]:SetActiveE(0)
                end
            end
        end
        local flag = index == 0 and -1 or 1
        self.sortCondition[type] = value * flag
        if index == 1 then 
            self:RefreshPanel()
            return
        end
    end
    if type == sortType.bp then
        ---@param data card_use_rate.i_peak_card
        _G.SortList(
            self.curRankList,
            function(data)
                return data.play_num * self.sortCondition.bp, data.choose_rate * self.sortCondition.bp, data.win_rate *
                    self.sortCondition.win, data.ban_rate * self.sortCondition.ban
            end
        )
    elseif type == sortType.win then
        ---@param data card_use_rate.i_peak_card
        _G.SortList(
            self.curRankList,
            function(data)
                return data.win_rate * self.sortCondition.win, data.play_num * self.sortCondition.bp, data.choose_rate *
                    self.sortCondition.bp, data.ban_rate * self.sortCondition.ban
            end
        )
    elseif type == sortType.ban then
        ---@param data card_use_rate.i_peak_card
        _G.SortList(
            self.curRankList,
            function(data)
                return data.ban_rate * self.sortCondition.ban, data.play_num * self.sortCondition.bp, data.choose_rate *
                    self.sortCondition.bp, data.win_rate * self.sortCondition.win, data.ban_rate *
                    self.sortCondition.ban
            end
        )
    end
end

return GMArenPeakGroupStatisticsView
