function GMArenaPeakBPView:InitAllState()
    self.myPunish = false
    self.eyPunish = false
    self.myTurnFinish = false
    self.eyTurnFinish = false
end

function GMArenaPeakBPView:CalMyTurnFinish()
    if self.step == Step.Ban then
        if self.eyBanInfo > 0 then
            return true
        end
    elseif self.step == Step.Array then
        if self.mySits and self.mySits[1] > 0 then
            return true
        end
    end
    return false
end

---刷新时间
function GMArenaPeakBPView:UpdateTime(elapsed)
    if self.countDown > 0 then
        self.countDown = self.countDown - elapsed
        self.go_table.aorimage_chahuaming.fillAmount = self.countDown / self.nowStepTime
        self.go_table.aortext_times:SetActiveE(self.countDown <= 5 and 1 or 0)
        self.go_table.aortext_midTip:SetActiveE(self.countDown <= 5 and 0 or 1)
        self.go_table.aortext_times.text = Mathf.RoundToInt(self.countDown)
        if self.isHosting and not self:CalMyTurnFinish() then
            self:HostingRandomEnsure()
        end
    elseif self.countDown <= 0 then
        self.go_table.aortext_times:SetActiveE(0)
        self.go_table.aorimage_chahuaming.fillAmount = 0
        self.go_table.aortext_midTip:SetActiveE(1)
        if not self:IsNil() and self:IsMyTurn() and not self:CalMyTurnFinish() then
            self:AutoEnsure()
            self.countDown = -1
        end
        if self.step == Step.Ban and self:CalMyTurnFinish() and (not self.myBan or self.myBan == 0) then 
            self:AutoEnemyBan()
        end
    end
end

--region ------------- 托管 -------------
function GMArenaPeakBPView:HostingRandomEnsure()
    local curStepTime = self:GetStepTime()
    if not curStepTime then
        return
    end
    local delta = curStepTime - Mathf.RoundToInt(self.countDown)
    if delta == 0 then
        return
    end
    if delta >= 1 then
        self:AutoEnsure(true)
    end
end
--endregion ----------- 托管 end -----------



---是否是我的操作轮次
function GMArenaPeakBPView:IsMyTurn()
    local remainder = self.isFirst and 1 or 0
    return self.step >= Step.Ban or self.step % 2 == remainder
end

