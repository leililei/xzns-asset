    dic.tran = nil
    dic.sid = 0
    dic.lv = 0
    dic.uid = 0
    dic.soulLinkLv = -1
    dic.talents = nil
    dic.head = nil
    if dic.effect then
        _G.UIUtils.RemoveEffect(dic.effect, 1)
        dic.effect = nil
    end
    -- if dic.shadow then
    --     _G.UIUtils.RemoveEffect(dic.shadow, 1)
