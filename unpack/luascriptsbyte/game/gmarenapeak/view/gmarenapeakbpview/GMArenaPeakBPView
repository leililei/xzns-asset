    if not _G.IsNil(dic.head) then
        x, y = _G.CS.UIUtils.WorldPointToLocalPointInRect(dic.head, self.go_table.rect_moveRoot)
        x = x < -290 and -290 or x
        x = x > 290 and 290 or x
        self.modelTitleTable[index].transform:SetLocalPosition(x, y, 0)
        if self.showDtagTipsTag then
            x, y, z = self.modelTitleTable[index].transform:GetLocalPosition()
            self.go_table.trans_tips:SetLocalPosition(x, y, z)
        end
    end
end

