---获取最终编队
function GMArenaPeakBPView:GetArray()
    local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
    local array = {}
    self.myBan = (not self.myBan or self.myBan == 0) and self:EnemyAutoGetBanCard() or self.myBan
    for i = 1, #data do
        if data[i].uid ~= 0 and data[i].uid ~= self.myCards[self.myBan] then
            _G.table.insert(array, data[i].uid)
        end
        if #array == 5 then
            break
        end
    end
    self.curEmbattleItem:ClearEmbattle()
    for i = 1, 5 do
        self.curEmbattleItem:SetEmbattleDataSingle(i, array[i])
    end
    self.curEmbattleItem:SetEmbattleDataSingle(6, 0)
    return array
end

---获取当前编队
function GMArenaPeakBPView:GetCurArray()
    local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)
    local array = {}
    local count = 0
    for i = 1, #data do
        _G.table.insert(array, data[i].uid)
        if data[i].uid ~= 0 then
            count = count + 1
        end
    end
    return array, count
end

function GMArenaPeakBPView:EnemyAuto()
    if self.step < Step.Ban then
        local indexes = self:CalIndexByStep()
        self.tempIndexes = indexes
        local pos
        local info = _G.DeepCopy(self.info)
        info["choose_card_" .. self.ey] = info["choose_card_" .. self.ey] or {}
        self.tempEyChoose = {}
        for i = 1, #indexes do
            pos = indexes[i]
            if not info["choose_card_" .. self.ey][pos] then
                pos = indexes[i]
                info["choose_card_" .. self.ey][pos] = self:EnemyAutoGetCard()
            end
        end
        info.step = info.step + 1
        local eyCardsInfo = _G.DeepCopy(info["choose_card_" .. self.ey]) 
        for i = 1, #eyCardsInfo do
            for k, v in pairs(self.info.def_pre_pick or {}) do 
                if eyCardsInfo[i] == v.uid then 
                    eyCardsInfo[i] = v
                end
            end
        end
        self:SaveRoom(self.step, info, function()
            if #self.tempIndexes > 1 then 
                self.cardItems[6 + self.tempIndexes[1]]:Show(eyCardsInfo[self.tempIndexes[1]], true, false, true)
                _G.DelayDo(2, function()
                    if self:IsNil() then
                        return
                    end
                    self:InitView(info, true)
                end)
            else 
                self:InitView(info, true)
            end
        end)
    elseif self.step == Step.Ban then
        local info = _G.DeepCopy(self.info)
        info["ban_index_" .. self.my] = self:EnemyAutoGetBanCard()
        info.step = self.step > info.step and self.step or info.step
        self:SaveRoom(self.step, info, function()
            self:InitView(info, true)
        end)
    elseif self.step == Step.Array then
        local info = _G.DeepCopy(self.info)
        info["sits_" .. self.ey] = self:GetEnemyArray()
        info.is_ready = true
        info.step = self.step > info.step and self.step or info.step
        self:SaveRoom(self.step, info, function()
            self:InitView(info, true)
        end)
    end
end

function GMArenaPeakBPView:GetEnemyArray()
    local array = {}
    self.eyBan = (not self.eyBan or self.eyBan == 0) and self:AutoGetBanCard() or self.eyBan
    for i = 1, #self.info["choose_card_" .. self.ey] do
        if self.eyBan > 0 then
            if self.info["choose_card_" .. self.ey][i] ~= self.eyCardsInfo[self.eyBan].uid then
                _G.table.insert(array, self.info["choose_card_" .. self.ey][i])
            end
        end
        if #array == 5 then
            break
        end
    end
    return array
end

---阶段转换
function GMArenaPeakBPView:ChangeStep()
    self.step = self.step + 1
    -- local txt = self:IsMyTurn() and "我的" or "他的"
    -- _G.LogError("现在是第几轮" .. self.step .. "         " .. txt .. "轮次")
    self.handleType = 0
    self.curChoose = {}
    self.playCardsSound = {}
    self.myTurnFinish = false
    self.eyTurnFinish = false
    self:UpdateTurnDescribe()
    self.nowStepTime = self:GetStepTime() - 1
    self.countDown = self.nowStepTime
    self.go_table.aortext_times.text = self.countDown
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.enemytimer then
        self.enemytimer:Stop()
        self.enemytimer = nil
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    if (not self:IsMyTurn()) or (self.step == Step.Array and not self.eyTurnFinish) or (self.step == Step.Ban and not self.eyTurnFinish) then 
        self.enemytimer = _G.TimerManager:GetInstance():GetTimer(2, self.EnemyAuto, self, true, false, true)
        self.enemytimer:Start()
    end
    if self.step < Step.Ban then
        self:GetCurIndexes()
        self.myCardsInfo = _G.DeepCopy(self.info["choose_card_" .. self.my]or {}) 
        self.eyCardsInfo = _G.DeepCopy(self.info["choose_card_" .. self.ey]or {}) 
        self.myCards = {0, 0, 0, 0, 0, 0}
        self.eyCards = {0, 0, 0, 0, 0, 0}
        self.eyCardSkin = {0, 0, 0, 0, 0, 0}
        for i = 1, #self.myCardsInfo do
            self.myCards[i] = self.myCardsInfo[i]
            -- if self.myCardsInfo[i].uid == self.myCardsInfo[i].sid then
            --     GMArenaPeakModel:GetInstance():SetUseSupport(true)
            -- end
            self.myCardsInfo[i] = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,self.myCardsInfo[i])
        end
        for i = 1, #self.eyCardsInfo do
            self.eyCards[i] = self.eyCardsInfo[i]
            for k, v in pairs(self.info.def_pre_pick or {}) do 
                if self.eyCards[i] == v.uid then 
                    self.eyCardSkin[i] = v.skin
                    self.eyCardsInfo[i] = v
                    self.eyCards[i] = v.sid
                end
            end
        end
        for i = 1, #self.curIndexes do
            self.cardItems[self.curIndexes[i]]:Show(nil, true, false)
        end
    --else
    --    self:ShowTopEff(TopEff.All)
    end
    if self.step == Step.Ban then
        for i = 1, 6 do
            self.cardItems[i + 6]:Show(self.eyCardsInfo[i], false, false, true)
            self.cardItems[i + 6]:ReshowEffect()
        end
    elseif self.step > Step.Ban then
        for i = 1, 12 do
            self.cardItems[i]:ShowEff(false)
        end
    end
    if self.step == Step.Array then
        self.go_table.obj_bg:SetActiveE(0)
        self.go_table.obj_cardList:SetActiveE(0)
        self.go_table.aorrawimage_showRole:SetActiveE(0)
        self.go_table.aorimage_banRole:SetActiveE(0)
        self.go_table.obj_cloudEff:SetActiveE(1)
        self.go_table.aorbtn_sure.enabled = false
        if self:IsNil() then
            return
        end
        _G.DelayDo(
            3,
            function()
                if self:IsNil() then
                    return
                end
                self.go_table.aorbtn_sure.enabled = true
            end
        )
        self.go_table.obj_cloudEff:SetActiveE(0)
        self.go_table.obj_cloudEff1:SetActiveE(1)
        self:ResetEmbattleData()
        self.curEmbattleItem:GetAutoArenaPeakEMData()
        --self.initAllRoleModel = false 
        self:UpdateAllModel()
    end
end

