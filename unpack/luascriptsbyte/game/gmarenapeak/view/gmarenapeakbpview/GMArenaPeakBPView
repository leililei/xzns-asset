        if uid == self.myCards[i] then
            return i
        end
    end
    return 0
end

---获取可上阵空位
function GMArenaPeakBPView:CheckEmptyPos(indexes)
    for i = 1, #indexes do
        if self.myCards[indexes[i]] == 0 then
            return indexes[i]
        end
    end
    return indexes[#indexes]
end

---获取当前阶段持续时间
function GMArenaPeakBPView:GetStepTime()
    local curTurnTime
    if self.step < Step.Ban then
        curTurnTime = self.turnTime[1]
        if self:IsMyTurn() then
            if self.myPunish then
                curTurnTime = _G.Mathf.Floor(curTurnTime / 2)
            end
        elseif self.eyPunish then
            curTurnTime = _G.Mathf.Floor(curTurnTime / 2)
        end
    else
        curTurnTime = self.turnTime[self.step - Step.Ban + 2]
        if self.step < Step.Ready then
            if self.myPunish or self.eyPunish then
                curTurnTime = _G.Mathf.Floor(curTurnTime / 2)
            end
        end
    end
    return curTurnTime
end

