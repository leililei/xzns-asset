        showEff = table.ContainsValue(self.curIndexes, i)
        reshow = false
        if isBaning and i > 6 then
            reshow = true
            showEff = false
        end
        showBan = i == self.myBan or (self.eyBan > 0 and i == self.eyBan + 6)
        cardInfo = i <= 6 and self.myCardsInfo[i] or self.eyCardsInfo[i - 6]
