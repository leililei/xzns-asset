---重置布阵数据（更新模型前用）
function GMArenaPeakBPView:ResetEmbattleData()
    local array = self:GetArray()
    if not array[1] or array[1] == 0 then 
        self.curEmbattleItem:ClearEmbattle()
        local index = 1
        for i = 1, 6 do
            if i ~= self.myBan then
                self.curEmbattleItem:SetEmbattleDataSingle(index, self.myCards[i])
                index = index + 1
            end
        end
        if not self.myTurnFinish and self.step > Step.Ban then 
            self.curEmbattleItem:GetAutoArenaPeakEMData()
        end
    end
end

