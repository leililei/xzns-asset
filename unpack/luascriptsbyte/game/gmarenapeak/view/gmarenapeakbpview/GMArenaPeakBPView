---@private
function GMArenaPeakBPView:InitView(roomInfo, isSend)
    GMArenaPeakModel:GetInstance():SetState(1)
    self.cacheCardSids = EmbattleController:GetInstance():GetCacheCardSids()
    self.info = roomInfo
    self.beforeStep = self.step
    self.step = roomInfo.step or 1
    self.isFirst = roomInfo.is_first == 0
    self.my = self.isFirst and "a" or "b"
    self.ey = self.isFirst and "b" or "a"
    self.myCardsInfo = _G.DeepCopy(roomInfo["choose_card_" .. self.my]or {}) 
    self.eyCardsInfo = _G.DeepCopy(roomInfo["choose_card_" .. self.ey]or {}) 
    self.myCards = {0, 0, 0, 0, 0, 0}
    self.eyCards = {0, 0, 0, 0, 0, 0}
    self.eyCardSkin = {0, 0, 0, 0, 0, 0}
    for i = 1, #self.myCardsInfo do
        self.myCards[i] = self.myCardsInfo[i]
        -- if self.myCardsInfo[i].uid == self.myCardsInfo[i].sid then
        --     GMArenaPeakModel:GetInstance():SetUseSupport(true)
        -- end
        self.myCardsInfo[i] = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,self.myCardsInfo[i])
    end
    for i = 1, #self.eyCardsInfo do
        self.eyCards[i] = self.eyCardsInfo[i]
        for k, v in pairs(self.info.def_pre_pick or {}) do 
            if self.eyCards[i] == v.uid then 
                self.eyCardSkin[i] = v.skin
                self.eyCardsInfo[i] = v
                self.eyCards[i] = v.sid
            end
        end
    end
    self.mySits = roomInfo["sits_" .. self.my]
    self.eySits = roomInfo["sits_" .. self.ey]
    self.myBan = roomInfo["ban_index_" .. self.my] or 0
    self.eyBanInfo = roomInfo["ban_index_" .. self.ey] or 0 --存储服务器ban人数据
    self.eyBan = self.eyBanInfo
    self:ShowRole(self.go_table.obj_my, roomInfo["role_info_" .. self.my])
    self:ShowRole(self.go_table.obj_enemy, roomInfo["role_info_" .. self.ey])
    self:SetVsDescription(roomInfo["role_info_" .. self.my].role_info.name, roomInfo["role_info_" .. self.ey].role_info.name)
    self.curChoose = {}
    self.cardList = self.curEmbattleItem:GetCardList()
    if not self.modelInit then
        self:InitModelPos()
        self.modelInit = true
    end
    self.handleType = 0
    self:ShowByStep(isSend)
      ---部分图片与特效显示
    if self.step > Step.Ban then
        self.go_table.aorrawimage_showRole:SetActiveE(0)
        self.go_table.aorimage_banRole:SetActiveE(0)
        self.go_table.obj_bg:SetActiveE(0)
        self.go_table.obj_cardList:SetActiveE(0)
    end
end

