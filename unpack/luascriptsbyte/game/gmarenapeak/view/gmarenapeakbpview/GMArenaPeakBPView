---超时对面自动ban
function GMArenaPeakBPView:AutoEnemyBan()
    if not self.autoEnemyBanFlag then 
        local info = _G.DeepCopy(self.info)
        info["ban_index_" .. self.my] = 3
        info.step = self.step > info.step and self.step or info.step
        self:SaveRoom(self.step, info, function()
            self:InitView(info, true)
            self.autoEnemyBanFlag = false
        end)
    end
    self.autoEnemyBanFlag = true
end

---超时自动操作
function GMArenaPeakBPView:AutoEnsure(isHosting)
    if not self:IsMyTurn() or self:CalMyTurnFinish() or self.ready or self.autoEnsureFlag then
        return
    end
    self.autoEnsureFlag = true
    if self.step < Step.Ban then
        local indexes = self:CalIndexByStep()
        local simpleRoomCard, roomCard, card, pos
        for i = 1, #indexes do
            if not self.curChoose[i] then
                pos = indexes[i]
                card = self:AutoGetCard(i)
                simpleRoomCard = self:CreateSimpleRoomCard(card, pos)
                roomCard = self:CreateRoomCard(card, pos)
                self.curChoose[i] = simpleRoomCard
                self.myCards[pos] = card.uid
                self.curEmbattleItem:SetEmbattleDataSingle(pos, card.uid)
                self.cardItems[pos]:Show(roomCard, false, false)
            end
            self:UpdateCardList(true)
            if roomCard then
                self:PlayCardSound(roomCard.sid)
            end
        end
        self:ChooseCard(function()
            --self.autoEnsureFlag = false
        end)
        -- if card then
        --     self:GetPortraitBySid(card.sid, card.skin)
        -- end
    elseif self.step == Step.Ban then
        self:AutoSetBan(function()
            for i = 7, 12 do
                self.cardItems[i]:ShowBan(self.eyBan + 6 == i)
            end
            --self.autoEnsureFlag = false
        end)
    elseif self.step == Step.Array then
        --self.curEmbattleItem:GetAutoArenaPeakEMData()
        self:AutoSetArray()
    end
end

function GMArenaPeakBPView:HasChoose(sid)
    for _, v in pairs(self.curChoose) do
        if sid == v.sid then
            return true
        end
    end
    return false
end

function GMArenaPeakBPView:ChooseCardByPower(i)
    local card
    for j = i, #self.sortDic[2] do
        card = self.cardList[self.sortDic[2][j]]
        if not self:HasChoose(card.sid) then
            return card
        end
    end
end

function GMArenaPeakBPView:AutoGetCard(i, call)
    if self.isHosting then
        local card
        for _, uid in pairs(self.preChoose) do
            if uid > 0 then
                for j = 1, #self.sortDic[2] do
                    card = self.cardList[self.sortDic[2][j]]
                    if card.uid == uid and not self:HasChoose(card.sid) then
                        return card
                    end
                end
            end
        end
        return self:ChooseCardByPower(i)
    else
        return self:ChooseCardByPower(i)
    end
end

function GMArenaPeakBPView:HasChooseByInfo(info)
    for _, v in pairs(self.myCardsInfo) do
        if info.sid == v.sid then
            return true
        end
    end
    for _, v in pairs(self.info["choose_card_" .. self.ey] or {}) do 
        if info.uid == v then 
            return true
        end
    end
    for _, v in pairs(self.tempEyChoose) do
        if info.uid == v then
            return true
        end
    end
    return false
end

function GMArenaPeakBPView:EnemyAutoGetCard()
    for k, v in ipairs(self.info.def_pre_pick) do 
        if not self:HasChooseByInfo(v) then 
            table.insert(self.tempEyChoose, v.uid)
            return v.uid
        end
    end
end

function GMArenaPeakBPView:EnemyAutoGetBanCard()
    local powerIndex = math.random(1, 6)
    local power = 0
    for k, v in ipairs(self.info.def_pre_ban or {}) do 
        for i = 1, #self.info["choose_card_" .. self.my] do 
            local card =_G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card,self.info["choose_card_" .. self.my][i])
            if card.sid == v then 
                return i
            end
            if card.power > power then 
                powerIndex = i 
                power = card.power 
            end
        end
    end
    return powerIndex
end

function GMArenaPeakBPView:ChooseCard(call, isAuto)
    local info = _G.DeepCopy(self.info)
    info["choose_card_".. self.my] = info["choose_card_".. self.my] or {}
    local indexes = self:CalIndexByStep()
    for k, v in pairs(self.curChoose) do 
        info["choose_card_".. self.my][indexes[k]] = v.uid
    end
    self:SaveRoom(self.step, info, call, isAuto)
end

function GMArenaPeakBPView:AutoSetBan(call)
    -- if self.eyBan and self.eyBan ~= 0 then 
    --     return 
    -- end
    if not self.eyBan or self.eyBan == 0 then 
        if self.isHosting then
            for i, bSid in pairs(self.preBan) do
                for j, sid in pairs(self.eyCards) do
                    if bSid == sid then
                        self.eyBan = j
                        break
                    end
                end
                if self.eyBan and self.eyBan ~= 0 then 
                    break
                end
            end
            if not self.eyBan or self.eyBan == 0 then 
                self.eyBan = 1
            end
        else
            self.eyBan = 1
        end
    end
    local info = _G.DeepCopy(self.info)
    info["ban_index_".. self.ey] = self.eyBan
    self:SaveRoom(self.step, info, call)
end

function GMArenaPeakBPView:AutoGetBanCard()
    local index = 1
    for i, bSid in pairs(self.preBan) do
        for j, sid in pairs(self.eyCards) do
            if bSid == sid then
                index = j
                break
            end
        end
    end
    return index
end

