---更换角色模型
---@param index number 序列号
---@param data CardData 卡牌数据
---@param call function 改变模型回调
function GMArenaPeakBPView:ChangeModel(index, data, call)
    self:ClearModelCall(index)
    local dic = self.modelDataArray[index]
    if data then
        -- 创建新的模型
        dic.path = require "CardInfoManager".GetBattleModelPath(data.skin or data.sid, false)
        dic.sid = data.sid
        dic.lv = data:GetLevel()
        dic.uid = data.uid
        dic.soulLinkLv = (data.soulLink_IsActivate and data.soulLink_IsActivate == 1) and data.soulLink_lv or -1
        dic.talents = data.open_inborn
        dic.star = data:GetStar()
        self.modelIndex = index
        self.onChangeModelCall = call
        self:CreateModelCall(index, self.setModelHandler, true)
    else
        -- 创建站位特效
        _G.PoolsManager:GetInstance():Spawn(
                StarColorPaths[1],
                _G.ePoolType.Temporary,
                self.sceneRoot,
                function(tran)
                    dic.effect = tran
                    local pos = dic.pos
                    tran:SetPosition(
                            pos[1] + ShadowPositionOffsets.x,
                            pos[2] + ShadowPositionOffsets.y,
                            pos[3] + ShadowPositionOffsets.z
                    )
                end
        )
    end
end
---使用编队后，更换所有模型
---@param enemy boolean 是否刷新敌方
function GMArenaPeakBPView:UpdateAllModel(enemy)
    if self.initAllRoleModel then
        return
    end
    self.initAllRoleModel = true

    local monsterCfgs = _G.ConfigManager.monster_cfg
    local cfg, card, skinId, cardData
    local IsNil = _G.IsNil
    self.modelIndex = 1
    local function handleCard(cards)
        for i = 1, #cards do
            self:ClearModelCall(i + self.updateModelCount)
            card = self.modelDataArray[i + self.updateModelCount]
            if card then
                if cards[i].sid > 0 then
                    -- 新模型
                    card.sid = cards[i].sid
                    skinId = self:GetSkinBySid(card.sid)
                    card.path = require "CardInfoManager".GetBattleModelPath(skinId, false)
                    --card.lv = cards[i].level
                    card.lv = 300
                    card.uid = cards[i].uid
                    card.star = cards[i].star
                    card.scale = cards[i].scale or 1
                    card.skin = skinId
                    cardData = self.curEmbattleItem:GetCardData(cards[i].uid)
                    card.soulLinkLv =
                        (cardData.soulLink_IsActivate and cardData.soulLink_IsActivate == 1) and cardData.soulLink_lv or
                        -1
                    card.talents = cardData.open_inborn
                else
                    card.sid = 0
                    card.path = nil
                    card.lv = 0
                    card.uid = 0
                    card.star = 0
                    card.skin = 0
                    card.soulLinkLv = -1
                    card.talents = nil
                end
            end
        end
    end
    local data = self.curEmbattleItem:GetEmbattleData(self.curEmbattleIndex)

    self.updateModelCount = 0
    handleCard(data)
    self.updateModelCount = 5
    if enemy then
        data = self.curEmbattleItem:GetEnemyEmbattleData(self.curEmbattleIndex)
        handleCard(data)
        self.updateModelCount = self.updateModelCount + #data
    end
    if self.modelIndex > 0 then
        self.onUpdateAllModelHandler = _G.handler(self, self.OnUpdateAllModelCall)
        self:CreateModelCall(self.modelIndex, self.onUpdateAllModelHandler, true)
    else
        self.updateModelCount = 0
        self.onBtnFuncRun = false
    end
end
function GMArenaPeakBPView:OnUpdateAllModelCall(tran)
    if tran then
        self:SetModelData(tran)
    end
    for i = self.modelIndex + 1, self.updateModelCount do
        self.modelIndex = i
        self:CreateModelCall(self.modelIndex, self.onUpdateAllModelHandler, true)
        return
    end
    self.modelIndex = 0
    self.updateModelCount = 0
    self.onUpdateAllModelHandler = nil
    self.onBtnFuncRun = false
end
---更新布阵位置
function GMArenaPeakBPView:UpdateScenePos()
    local mgpID = self.curEmbattleItem:GetMonsterGroupID(self.curEmbattleIndex)
    local cfg = _G.ConfigManager.monster_group_cfg[mgpID]
    if not cfg then
        return
    end
    self.centerPos = cfg.FightAreaPos
    cfg = _G.ConfigManager.pos_cfg[cfg.pos]
    for i = 1, #self.attackPos do
        self.attackPos[i][1] = cfg.AttackerPos[i][1] + self.centerPos[1]
        self.attackPos[i][2] = cfg.AttackerPos[i][2] + self.centerPos[2]
        self.attackPos[i][3] = cfg.AttackerPos[i][3] + self.centerPos[3]
    end
    for i = 1, #self.defencePos do
        self.defencePos[i][1] = cfg.DefenserPos[i][1] + self.centerPos[1]
        self.defencePos[i][2] = cfg.DefenserPos[i][2] + self.centerPos[2]
        self.defencePos[i][3] = cfg.DefenserPos[i][3] + self.centerPos[3]
    end
    self.sceneRoot:SetPosition(self.centerPos[1], self.centerPos[2], self.centerPos[3])
end

