---拖动
function GMArenaPeakBPView:OnDragBtnDrag()
    if self.step ~= Step.Array or self.myTurnFinish then
        return
    end
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end

    self.dragHit, self.dragPosX, self.dragPosY, self.dragPosZ =
        _G.CS.UIUtils.GetWorldPosByScreenPointInMainCamera(self.centerPos[1], self.centerPos[2], self.centerPos[3])
    if self.dragHit then
        self:SetModelPos(self.curDragModelIndex, self.dragPosX, self.dragPosY, self.dragPosZ)
        for i = 1, #self.moveBtns do
            if self.moveBtns[i]:GetActiveSelf() == 1 and CheckMousePointInRect(self.moveBtns[i]) then
                -- 拖动到位置上
                self.moveEffectTrans:SetActiveE(1)
                local pos = self.modelDataArray[i].pos
                self.moveEffectTrans:SetPosition(pos[1], pos[2], pos[3])
                return
            end
        end
        self.moveEffectTrans:SetActiveE(0)
    end
end
---检测松开
---@param go UnityEngine.GameObject 按钮对象
function GMArenaPeakBPView:OnDragBtnPressUp(go, ed)
    if self.step ~= Step.Array or self.myTurnFinish then
        return
    end
    if self.onBtnFuncRun then
        return
    end
    if self.isRecommend then
        return
    end
    ---是否是引导对应步骤
    local isGuide10013 = false
    if isGuide10013 then
        if self.IsGuideDrag then
            self.curDragModelIndex = 2
        else
            self.curDragModelIndex = 0
        end
    end
    if not self.curDragModelIndex or self.curDragModelIndex == 0 then
        return
    end
    --self:ShowDragTips(false, self.curDragModelIndex)
    local curDic = self.modelDataArray[self.curDragModelIndex]
    if self.showCardListTag then
        -- 选人界面打开
        if not isGuide10013 then
            if CheckMousePointInRect(self.go_table.obj_choose) then
                -- 拖动到选人界面，下阵
                --region 镇魂特训 ，特殊阵容，手动拖拽，无法下阵
                local flag = false
                flag = self.curEmbattleItem:SetEmbattleDataSingle(self.curDragModelIndex, 0, self.curEmbattleIndex)
                if not flag then
                    local pos = curDic.pos
                    self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
                    self.curDragModelIndex = 0
                    return
                end
                --endregion
                self:ChangeModel(self.curDragModelIndex)
                self:RefreshCardList()
                self:ShowAllPower()
                self.curDragModelIndex = 0
                return
            end
        end
    end
    local dragPos = 0
    if isGuide10013 then
        dragPos = 3
    else
        for i = 1, #self.moveBtns do
            if
            i ~= self.curDragModelIndex and self.moveBtns[i]:GetActiveSelf() == 1 and
                    CheckMousePointInRect(self.moveBtns[i])
            then
                -- 拖动到别的位置上
                dragPos = i
                break
            end
        end
    end
    if dragPos > 0 then
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2049)
        local dic = self.modelDataArray[dragPos]
        if dic.tran then
            -- 交换
            -- tran = curDic.shadow
            -- curDic.shadow = dic.shadow
            -- dic.shadow = tran
            local tran = curDic.tran
            curDic.tran = dic.tran
            dic.tran = tran
            curDic.sid = curDic.sid + dic.sid
            dic.sid = curDic.sid - dic.sid
            curDic.sid = curDic.sid - dic.sid
            curDic.uid = curDic.uid + dic.uid
            dic.uid = curDic.uid - dic.uid
            curDic.uid = curDic.uid - dic.uid
            curDic.lv = curDic.lv + dic.lv
            dic.lv = curDic.lv - dic.lv
            curDic.lv = curDic.lv - dic.lv
            tran = curDic.head
            curDic.head = dic.head
            dic.head = tran
            tran = curDic.effect
            curDic.effect = dic.effect
            dic.effect = tran
            local soulLinkLv = curDic.soulLinkLv
            curDic.soulLinkLv = dic.soulLinkLv
            dic.soulLinkLv = soulLinkLv
            local talents = curDic.talents
            curDic.talents = dic.talents
            dic.talents = talents
        else
            -- 在此上阵
            dic.tran = curDic.tran
            dic.sid = curDic.sid
            dic.lv = curDic.lv
            dic.head = curDic.head
            dic.uid = curDic.uid
            local tran = dic.effect
            dic.effect = curDic.effect
            curDic.effect = tran
            dic.soulLinkLv = curDic.soulLinkLv
            dic.talents = curDic.talents
            -- tran = dic.shadow
            -- dic.shadow = curDic.shadow
            -- curDic.shadow = tran
            curDic.tran = nil
            curDic.sid = 0
            curDic.lv = 0
            curDic.uid = 0
            curDic.head = nil
            curDic.soulLinkLv = -1
            curDic.talents = nil
        end
        local pos = dic.pos
        self:SetModelPos(dragPos, pos[1], pos[2], pos[3])
        dic.effect:SetPosition(
                pos[1] + ShadowPositionOffsets.x,
                pos[2] + ShadowPositionOffsets.y,
                pos[3] + ShadowPositionOffsets.z
        )
        --dic.shadow:SetPosition(pos[1], pos[2], pos[3])
        pos = curDic.pos
        self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
        curDic.effect:SetPosition(
                pos[1] + ShadowPositionOffsets.x,
                pos[2] + ShadowPositionOffsets.y,
                pos[3] + ShadowPositionOffsets.z
        )
        --curDic.shadow:SetPosition(pos[1], pos[2], pos[3])
        local cardData = self.curEmbattleItem:GetCardData(dic.uid)
        self.modelTitleTable[dragPos]:Show(dic.sid, dic.lv, dic.uid, cardData)
        cardData = self.curEmbattleItem:GetCardData(curDic.uid)
        self.modelTitleTable[self.curDragModelIndex]:Show(curDic.sid, curDic.lv, curDic.uid, cardData)
        if not self.curEmbattleItem.notShowMySoulAndTalents then
            self.modelTitleTable[dragPos]:SetSoulLinkAndTalent(dic.soulLinkLv, dic.talents)
            self.modelTitleTable[self.curDragModelIndex]:SetSoulLinkAndTalent(curDic.soulLinkLv, curDic.talents)
        end
        -- 数据交换
        self.curEmbattleItem:ChangeCardPos(dragPos, self.curDragModelIndex, self.curEmbattleIndex)
        self.curDragModelIndex = 0
        return
    end
    local pos = curDic.pos
    self:SetModelPos(self.curDragModelIndex, pos[1], pos[2], pos[3])
    self.curDragModelIndex = 0
end

