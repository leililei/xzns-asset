---监听选择卡牌
function GMArenaPeakBPView:OnChooseCard(msg)
    local cards = msg.cards
    local type = msg.type
    if self:IsMyTurn() and type == 2 then
        --系统强制确认
        self.myPunish = true
        for _, v in pairs(cards) do
            if self.myCards[v.index] ~= v.uid then
                --防止下阵
                self.curEmbattleItem:SetEmbattleDataSingle(v.index, v.uid)
            end
            self.cardItems[v.index]:Show(v, false, false)
            self.myCards[v.index] = v.uid
            --self:ChangeModel(v.index, self:FindCardByUid(v.uid))
        end
        self:UpdateCardList(true)
        self:ChangeStep()
    else
        if type == 3 then
            local idx
            local indexes = self:CalIndexByStep()
            for _, v in pairs(cards) do
                self.cardItems[6 + v.index]:Show(nil, true, false, true)
                self.eyCards[v.index] = 0
                self.playCardsSound[v.index] = false
                idx = _G.table.indexof(indexes, v.index)
                if #indexes == 2 and self.eyCards[indexes[3 - idx]] == 0 then
                    self.cardItems[6 + v.index]:ReshowEffect()
                    self.cardItems[6 + indexes[3 - idx]]:ReshowEffect()
                end
            end
        else
            for _, v in pairs(cards) do
                self.cardItems[6 + v.index]:Show(v, false, false, true)
                self.eyCards[v.index] = v.sid
                self.playCardsSound[v.index] = true
            end
            --self:GetPortraitBySid(cards[#cards].sid, cards[#cards].skin)
            if #cards > 0 then
                self:PlayCardSound(cards[#cards].sid)
            end
        end
        if type == 2 then
            self:UpdateCardList(true)
            self:ChangeStep()
        end
    end
end

---监听ban卡牌
function GMArenaPeakBPView:OnBanCard(msg)
    if msg.role_uid ~= self.uid then
        --系统强制ban人
        self.eyBan = msg.card_index
        for i = 7, 12 do
            self.cardItems[i]:ShowBan(self.eyBan + 6 == i)
        end
        self.myTurnFinish = true
    else
        self.myBan = msg.card_index
        self.cardItems[self.myBan]:ShowBan(true)
        self.eyTurnFinish = true
        self:UpdateTurnDescribe()
    end
    if self.myBan > 0 and self.myTurnFinish then
        self:ChangeStep()
    end
end

---监听确认站位
function GMArenaPeakBPView:OnEnsureArray(msg)
    if msg.role_uid == self.uid then
        --系统强制确认
        self.myTurnFinish = true
    else
        self.eyTurnFinish = true
        self:UpdateTurnDescribe()
    end
    if self.myTurnFinish then
        self:ReadyToFight()
    end
end

---超时推送
function GMArenaPeakBPView:OnTimeOut(msg)
    if msg.role_uid == self.uid then
        self.myPunish = msg.type == 0
    else
        self.eyPunish = msg.type == 0
    end
end

