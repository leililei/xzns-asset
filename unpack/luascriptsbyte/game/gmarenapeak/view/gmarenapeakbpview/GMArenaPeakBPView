        end
    end)
end

function GMArenaPeakBPView:SaveRoom(step, roomData, callBack, isAuto)
    local info = {}
    info.room_uid = roomData.room_uid
    info.step = roomData.step
    info.state_start_time = roomData.state_start_time
    info.time_out_role = roomData.time_out_role
    info.is_ready = roomData.is_ready
    info.choose_card_a = roomData.choose_card_a
    info.choose_card_b = roomData.choose_card_b
    info.ban_index_a = roomData.ban_index_a
    info.ban_index_b = roomData.ban_index_b
    info.sits_a = roomData.sits_a
    info.sits_b = roomData.sits_b
    --info.def_pre_pick = roomData.def_pre_pick
    local pbData = {room_info = info}
    GMArenaPeakNet:GetInstance():SaveRoom(
        pbData,
        function(msg)
            if self:IsMyTurn() and not self:CalMyTurnFinish() and self.step == step then
                if msg.ack == 1 then
                    self.info = roomData
                    if not isAuto then
                        self.myPunish = false
                    end
                    if self.step < Step.Ban then
                        local info = _G.DeepCopy(self.info)
                        info.step = info.step + 1
                        self:SaveStep(function(roomInfo)
                            self.info = roomInfo
                            self:ChangeStep()
                            if self.step < Step.Ban then
                                self:SetFightBtnGray(true)
                            end
                            self.autoEnsureFlag = false
                        end)
                    elseif self.step == Step.Ban then
                        self.eyBanInfo = self.eyBan
                        if self.myBan > 0 then
                            self:SaveStep(function(roomInfo)
                                self.info = roomInfo
                                self:ChangeStep()
                                self.autoEnsureFlag = false
                            end)
                        else
                            self:UpdateTurnDescribe()
                            self:SetFightBtnGray(true)
                            self.autoEnsureFlag = false
                        end
                    elseif self.step == Step.Array then
                        if self.eyTurnFinish then
                            self:SaveStep(function(roomInfo)
                                self.info = roomInfo
                                self:ReadyToFight()
                                self.autoEnsureFlag = false
                            end)
                        else
                            self:UpdateTurnDescribe()
                            self:SetFightBtnGray(true)
                            self.autoEnsureFlag = false
                        end
                    end
                    if callBack then 
                        callBack()
                    end 
                else
                    --self.myTurnFinish = false
                    _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                    self:SetFightBtnGray(true)
                end
            elseif self.step == step then 
                if msg.ack == 1 then
                    self.info = roomData
                    if callBack then 
                        callBack()
                    end
                    -- if self.step < Step.Ban then
                    --     self:SetFightBtnGray(true)
                    -- end
                else 
                    _G.PopWindowManager:GetInstance():ShowAllTips(880122)
                    self:SetFightBtnGray(true)
                end
            end
        end
    )
end

