    info.sid = cardData.sid
    info.uid = cardData.uid
    info.skin = cardData.skin
    info.soul_state = cardData.soulLink_IsActivate
    info.soul_lv = cardData.soulLink_lv
    info.open_inborn = self:CalTalentsNum(cardData.open_inborn)
    return info
end

---@private
function GMArenaPeakBPView:CalTalentsNum(talents)
    local num = 0
    if _G.IsNumber(talents) then
        num = talents
    else
        local tCfg
        for i = 1, #talents do
            tCfg = _G.ConfigManager.attribute_cfg[talents[i]]
            if tCfg.skill > 0 then
                num = num + 1
            end
        end
    end
    return num
end

