local GMArenaPeakModel = require("GMArenaPeakModel")
---@class GMArenaPeakPopView : UIBaseView    中文描述
---@field public go_table ActivityDispatchPopView_GoTable GoTable
local GMArenaPeakPopView = _G.BaseClass("GMArenaPeakPopView", _G.UIBaseView)

---构造函数
---@protected
function GMArenaPeakPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
--
---界面的入口函数
function GMArenaPeakPopView:OnCreate()
    self.activity = GMArenaPeakModel:GetInstance():GetActivity()
    self.activityID = self.activity.activityID
end
--
---界面的销毁函数
function GMArenaPeakPopView:OnDestroy()
end

---按钮点击事件在这里派发
function GMArenaPeakPopView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    elseif go == self.go_table.aorbtn_skip then
        self.activity = GMArenaPeakModel:GetInstance():GetActivity()
        if self.activity ~= nil then
            _G.GlobalInterface.JumpActivityByGM(10082, self.activity:GetJumpType(self.activity.activityID))
            self:Close()
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        end
    end

    if self.go_table.toggle_eject.isOn then
        _G.PlayerPrefsManager.SetInt("GMArenaPeakPopView" .. self.activityID,
            _G.TimeUtil.GetDayBySix(_G.TimeUtil.GetServerUnixTime()))
    end
end

return GMArenaPeakPopView