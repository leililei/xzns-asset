local GMArenaPeakModel = require "GMArenaPeakModel"

---@class GMArenaPeakChampionView : UIBaseView	中文描述
local GMArenaPeakChampionView = _G.BaseClass("GMArenaPeakChampionView", _G.UIBaseView)

function GMArenaPeakChampionView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function GMArenaPeakChampionView:OnCreate(curRankData)
    self.curRankData = curRankData
    self.Time = GMArenaPeakModel:GetInstance().EggEndTime and
        GMArenaPeakModel:GetInstance().EggEndTime - _G.TimeUtil.GetServerUnixTime() or 0

    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.OnTimeRemaining, self, false)
    self.Timer:Start()

    self:InitEffct()
    self:InitView()
    self:UpdateIcon()
end

function GMArenaPeakChampionView:UpdateIcon()
    local icon
    if not GMArenaPeakModel:GetInstance().EggAwardFlag then
        icon = "ImagesH5/nAFK/ui_box1"
        self.go_table.obj_redpoint:SetActiveE(1)
    else
        icon = "ImagesH5/nAFK/ui_box3"
        self.go_table.obj_redpoint:SetActiveE(0)
    end
    self.go_table.aorrawimage_box:LoadImage(icon)
end

function GMArenaPeakChampionView:OnTimeRemaining(elapsed)
    self.Time = self.Time - elapsed
    if self.Time > 0 then
        local _time = _G.TimeUtil.TranslateSecond(self.Time)
        local str = ""
        if _time.day > 0 then
            str = _G.GetLangPackValue(90028010120, _time.day, _time.hour, _time.min)
        elseif _time.hour > 0 then
            str = _G.GetLangPackValue(90028010121, _time.hour, _time.min)
        else
            str = _G.GetLangPackValue(90028010122, _time.min, _time.sec)
        end
        self.go_table.aortext_time.text = _G.GetLangPackValue(90033400154) .. str
    else
        self:Close()
    end
end

function GMArenaPeakChampionView:InitEffct()
    local tbOur = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)

    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_SociatyMobaGuessView_our,
        tbOur.obj_ourEff,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function GMArenaPeakChampionView:InitView()
    self:InitFameHall()
end

---名人堂
---@param msg guild.s2c_other_guild_pos_info
function GMArenaPeakChampionView:InitFameHall()
    ---@type GMArenaPeakChampionView._obj_fameHallOur_GoTable|GMArenaPeakChampionView._obj_fameHallEnemy_GoTable
    local tb = _G.GetAutoGoTable(self.go_table.obj_fameHallOur)
    local cfg = _G.ConfigManager.player_portrait_cfg
    local icon = "ImagesH5/zRoles/" ..  cfg[self.curRankData.listRankDatas[1].playData.portrait].portrait1
    tb.aortext_sociatyName.text = self.curRankData.listRankDatas[1].playData.name
    self.go_table.aortext_tips.text = _G.GetLangPackValue(90033406005, self.curRankData.listRankDatas[1].playData.name)
    tb.aorrawimage_icon:LoadImage(icon)
    self:CreateRole(tb.obj_player1, self.curRankData.listRankDatas[1])
    self:CreateRole(tb.obj_player2, self.curRankData.listRankDatas[2])
    self:CreateRole(tb.obj_player3, self.curRankData.listRankDatas[3])
    self:CreateRole(tb.obj_player4, self.curRankData.listRankDatas[4])
    self:CreateRole(tb.obj_player5, self.curRankData.listRankDatas[5])
end

function GMArenaPeakChampionView:CreateRole(obj, role)
    if role then
        ---@type _obj_fameHallOur._obj_player1_GoTable
        local playerTb = _G.GetAutoGoTable(obj)
        playerTb.aortext_name.text = role.playData.name
        playerTb.aortext_power.text = _G.GameUtil.NumberToUnitWord(role.playData.power)
        -- playerTb.aorimage_official.SpriteName = officialBg[pos]
        -- playerTb.aortext_offName.text = _G.GetLangPackValue(_G.ConfigManager.guild_position_cfg[pos].name)
        -- playerTb.aortext_offName.color = officialColor[pos]
        -- playerTb.aortext_offName:GetComponentE(_G.typeof(_G.CS.TextOutline)).OutlineColor = officialOutlineColor[1]
        local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(nil, role.playData.city_style_id)
        local useBattle = _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView)
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        _G.PoolsManager:GetInstance():Spawn(
            useBattle and path or cfg.ModelPathHi,
            _G.ePoolType.Temporary,
            playerTb.obj_spine,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
                trans:SetLocalScaleXYZ(cfg.size2)
            end
        )
    else
        obj:SetActiveE(0)
    end
end

---按钮点击事件在这里派发
function GMArenaPeakChampionView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_AwardBox then
        ---点击领取宝箱
        if not GMArenaPeakModel:GetInstance().EggAwardFlag then
            GMArenaPeakModel:GetInstance():GetEggAward(function()
                self:UpdateIcon()
            end)
        end
    end
end

function GMArenaPeakChampionView:OnStartClose()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
end

function GMArenaPeakChampionView:Dispose()
end

return GMArenaPeakChampionView
