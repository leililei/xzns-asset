local CommonTipManager = require("CommonTipManager")
local GMArenaPeakNet = require("GMArenaPeakNet")

---@class GMArenaPeakReportView : UIBaseView    中文描述
---@field public go_table ArenaGlobalReportView_GoTable GoTable
local GMArenaPeakReportView = _G.BaseClass("GMArenaPeakReportView", _G.UIBaseView)

function GMArenaPeakReportView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

local Alphas = {"255", "255"}
local Colors = {
    Win = {"FFE465", "FFFFFF"},
    Lose = {"8096C7", "FFFFFF"}
}
local Tag = {
    Win = "0ui_img_shengliqi",
    Lose = "0ui_img_shibai"
}
local Arrow = {
    Win = "0ui_icon_shangsheng",
    Lose = "0ui_icon_xiajiang"
}

---界面的入口函数
function GMArenaPeakReportView:OnCreate(isPeak, activityClass)
    -- self.activityClass = activityClass
    -- self.typeClass = activityClass.typeClass
    self.name = _G.PlayerModel:GetInstance():GetName()
    self.uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    self.go_table.obj_peak:SetActiveE(0)
    self.go_table.obj_self:SetActiveE(0)
    self:InitToggle()
    self:InitView()
    self.go_table.obj_emptySelf:SetActiveE(0)
    self.go_table.obj_emptyPeak:SetActiveE(0)
    if isPeak then
        self.go_table.toggle_peak.isOn = false
        self.go_table.toggle_peak.isOn = true
    else
        self.go_table.toggle_self.isOn = false
        self.go_table.toggle_self.isOn = true
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

---初始化页面
function GMArenaPeakReportView:InitView()
end

function GMArenaPeakReportView:InitToggle()
    self.toggles = {
        peak = _G.GetAutoGoTable(
            self.go_table.toggle_peak,
            _G.handlerbind(self, self.OnClickToggle, "peak", _G.handler(self, self.OnPeak))
        ),
        mySelf = _G.GetAutoGoTable(
            self.go_table.toggle_self,
            _G.handlerbind(self, self.OnClickToggle, "mySelf", _G.handler(self, self.OnMySelf))
        )
    }
end

function GMArenaPeakReportView:OnClickToggle(go, isOn, key, call)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if call then
        call(isOn)
    end
end

function GMArenaPeakReportView:OnPeak(isOn)
    self.go_table.obj_peak:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.inPeakPage = true
    self:UpdatePeakReport()
end

function GMArenaPeakReportView:OnMySelf(isOn)
    self.go_table.obj_self:SetActiveE(isOn and 1 or 0)
    if not isOn then
        return
    end
    self.inPeakPage = false
    self:UpdateSelfReport()
end

function GMArenaPeakReportView:UpdatePeakReport()
    if self.gettingPeakReport then
        return
    end
    self.gettingPeakReport = true
    GMArenaPeakNet:GetInstance():GetPeakReport(
        function(msg)
            self.gettingPeakReport = nil
            self.peakReport = msg.reports or {}
            if not self.peakInit then
                self.peakInit = true
                self.go_table.scrollloopvectical_peakReport:InitItemData(
                    #self.peakReport,
                    _G.handler(self, self.RefreshPeakItem)
                )
            else
                self.go_table.scrollloopvectical_peakReport:UpdateCount(#self.peakReport)
            end
            self.go_table.obj_emptyPeak:SetActiveE(#self.peakReport == 0 and 1 or 0)
        end
    )
end

function GMArenaPeakReportView:RefreshPeakItem(index, obj)
    index = index + 1
    ---@type arena_global.i_peak_log
    local data = self.peakReport[index]
    ---@type GMArenaPeakReportView._obj_peakReportItem_GoTable
    local tb =
        _G.GetAutoGoTable(
        obj,
        _G.handlerbind(self, self.OnClickReport, data.playback_uid, data.attack_role.name, data.def_role.name, nil, true)
    )
    tb.aortext_nameLeft.text = data.attack_role.name
    tb.aortext_nameRight.text = data.def_role.name
    tb.aortext_stateLeft.text = _G.GetLangPackValue(data.winner and 90021800510 or 90021800511)
    tb.aortext_stateRight.text = _G.GetLangPackValue(data.winner and 90021800511 or 90021800510)
    CommonTipManager:GetInstance():SetTextGradient(data.winner and Colors.Win or Colors.Lose, Alphas, tb.aortext_stateLeft)
    CommonTipManager:GetInstance():SetTextGradient(
        data.winner and Colors.Lose or Colors.Win,
        Alphas,
        tb.aortext_stateRight
    )
    tb.obj_bg:SetLocalEulerAngles(0, 0, data.winner and 0 or 180)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemLeft, data.attack_role, 1, true, true, true)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemRight, data.def_role, 1, true, true, true)
end

function GMArenaPeakReportView:UpdateSelfReport()
    if self.selfReport then
        return
    end
    self.selfReport = true
    GMArenaPeakNet:GetInstance():GetSelfReport(
        function(msg)
            self.selfReport = msg.reports or {}
            if not self.selfInit then
                self.selfInit = true
                self.go_table.scrollloopvectical_selfReport:InitItemData(
                    #self.selfReport,
                    _G.handler(self, self.RefreshSelfItem)
                )
            else
                self.go_table.scrollloopvectical_selfReport:UpdateCount(#self.selfReport)
            end
            self.go_table.obj_emptySelf:SetActiveE(#self.selfReport == 0 and 1 or 0)
        end
    )
end

function GMArenaPeakReportView:RefreshSelfItem(index, obj)
    index = index + 1
    ---@type arena_global.i_fight_log
    local data = self.selfReport[index]
    local aName, dName
    if data.attack_uid == self.uid then --1进攻2防守
        aName = self.name
        dName = data.def_role.name
    else
        aName = data.def_role.name
        dName = self.name
    end
    ---@type GMArenaPeakReportView._obj_selfReportItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickReport, data.playback_uid, aName, dName, data.winner))
    tb.aorimage_resultTag.SpriteName = data.winner and Tag.Win or Tag.Lose
    tb.aorimage_arrow.SpriteName = data.winner and Arrow.Win or Arrow.Lose
    tb.aortext_name.text = data.def_role.name
    if data.score == 0 then
        tb.aorimage_arrow:SetActiveE(0)
        tb.aortext_score.text = _G.GetLangPackValue(90033404093) .. data.new_score
    else
        tb.aorimage_arrow:SetActiveE(1)
        local add = _G.string.AddColor((data.winner and " +" or " -") .. data.score, data.winner and "00721D" or "C02214")
        tb.aortext_score.text = _G.GetLangPackValue(90033404093) .. data.new_score .. add
    end
    tb.aortext_time.text = self:TranslateTime(data.time)
    tb.aortext_timeFight.text = _G.TimeUtil.date("%m-%d %H:%M:%S", data.time)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.def_role, 1, true, true, true)
end

function GMArenaPeakReportView:TranslateTime(time)
    local servertime = _G.TimeUtil.GetServerUnixTime()
    time = _G.TimeUtil.TranslateSecond(servertime - time)
    if time.day > 0 then
        time.day = time.day > 30 and 30 or time.day
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100085), time.day)
    end
    if time.hour > 0 then
        return _G.string.format(_G.LangUtil.GetLangPackValue(90022100086), time.hour)
    end
    time.min = time.min > 0 and time.min or 1
    return _G.string.format(_G.LangUtil.GetLangPackValue(90022100083), time.min)
end

function GMArenaPeakReportView:OnEnable()
    if self.inPeakPage then
        self:UpdatePeakReport()
    end
end

function GMArenaPeakReportView:OnClickReport(go, isOn, playback_uid, aName, dName, win, hideResultFlag)
    self.leftName = aName
    self.rightName = dName
    self.playback_uid = playback_uid
    self.win = win
    self.hideResultFlag = hideResultFlag
    local pbData = {playback_uid = playback_uid}
    GMArenaPeakNet:GetInstance():Playback(pbData, _G.handler(self, self.OnReplayReportCall))
end

function GMArenaPeakReportView:OnReplayReportCall(msg)
    if msg.ack ~= 1 then
        return
    end
    self.fight_arg = msg.fight_arg
    _G.LogError("111")
    local battleInfo = _G.BattleManager:GetInstance():GetStatisticsRecord(msg.fight_arg)
    _G.LogError("222")
    self:UpdateData(battleInfo)
end

---@param data table 伤害数据
function GMArenaPeakReportView:UpdateData(data)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCount = _G.table.count(data.FighterInfo)
    self.PveData = self:InitData(data)
    
    _G.LogError("333")
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        {self.win and 0 or 1},
        nil,
        {hideResultFlag = self.hideResultFlag},
        nil,
        1,
        true,
        self.fight_arg,
        nil,
        {self.playback_uid}, --战报uid暂不支持分享
        nil,  --先屏蔽分享23
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        true,
        { self.leftName, self.rightName, self.hideResultFlag }
    )
end

function GMArenaPeakReportView:InitData(data)
    local tb = {}
    for i = 1, self.maxCount do
        local tempData = data.FighterInfo[i]
        local temp = {}
        temp.AtkUid = data.AtkUid
        temp.DefUid = data.DefUid
        temp.statisticsMax = {DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1}
        temp.statisticsData = tempData
        for j = 1, #tempData.Attacker do
            if temp.statisticsMax.DmgOut < tempData.Attacker[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Attacker[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Attacker[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Attacker[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Attacker[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Attacker[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Attacker[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #tempData.Defender do
            if temp.statisticsMax.DmgOut < tempData.Defender[j].DmgOut then
                temp.statisticsMax.DmgOut = tempData.Defender[j].DmgOut
            end

            if temp.statisticsMax.DmgIn < tempData.Defender[j].DmgIn then
                temp.statisticsMax.DmgIn = tempData.Defender[j].DmgIn
            end

            if temp.statisticsMax.HpRecover < tempData.Defender[j].HpRecover then
                temp.statisticsMax.HpRecover = tempData.Defender[j].HpRecover
            end
            if temp.statisticsMax.CreateGuard < tempData.Defender[j].CreateGuard then
                temp.statisticsMax.CreateGuard = tempData.Defender[j].CreateGuard
            end
        end
        temp.CombMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.AtkCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.AtkCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.AtkCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.AtkCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.AtkCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefCombineSkills[1] do
            if temp.CombMax.DmgOut < tempData.DefCombineSkills[1][j].DmgOut then
                temp.CombMax.DmgOut = tempData.DefCombineSkills[1][j].DmgOut
            end

            if temp.CombMax.CreateGuard < tempData.DefCombineSkills[1][j].CreateGuard then
                temp.CombMax.CreateGuard = tempData.DefCombineSkills[1][j].CreateGuard
            end

            if temp.CombMax.HpRecover < tempData.DefCombineSkills[1][j].HpRecover then
                temp.CombMax.HpRecover = tempData.DefCombineSkills[1][j].HpRecover
            end
        end
        temp.PetMax = {DmgOut = 1, CreateGuard = 1, HpRecover = 1}
        for j = 1, #tempData.AtkPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.AtkPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.AtkPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.AtkPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.AtkPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.AtkPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #tempData.DefPetSkills[1] do
            if temp.PetMax.DmgOut < tempData.DefPetSkills[1][j].DmgOut then
                temp.PetMax.DmgOut = tempData.DefPetSkills[1][j].DmgOut
            end

            if temp.PetMax.CreateGuard < tempData.DefPetSkills[1][j].CreateGuard then
                temp.PetMax.CreateGuard = tempData.DefPetSkills[1][j].CreateGuard
            end

            if temp.PetMax.HpRecover < tempData.DefPetSkills[1][j].HpRecover then
                temp.PetMax.HpRecover = tempData.DefPetSkills[1][j].HpRecover
            end
        end
        temp.TeamIndex = tempData.TeamIndex
        _G.table.insert(tb, temp)
    end
    return tb
end

