local base = require("BaseGameNet")

---@class GMArenaPeakNet : BaseGameNet    通信协议
local GMArenaPeakNet = _G.BaseClass("GMArenaPeakNet", base)
---@return GMArenaPeakNet GMArenaPeakNet
function GMArenaPeakNet:GetInstance()
    return base.GetInstance(self)
end

function GMArenaPeakNet:AddMessageListeners()
    --self:AddMessageListener(_G.ConfigManager.net_map.p2c_ban_pick_log_notice.Cmd, self.OnP2CLog)
    self:AddMessageListener(_G.ConfigManager.net_map.p2c_ban_pick_fight_result.Cmd, self.OnP2CCampsite)
end

---获取信息
function GMArenaPeakNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_ban_pick_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

