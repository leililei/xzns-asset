---战斗日志推送
---@param msg ban_pick.p2c_log_notice
function GMArenaPeakNet:OnP2CLog(msg)
    require "GMArenaPeakModel":GetInstance():AddLog(msg)
end

---战斗日志推送
---@param msg ban_pick.p2c_fight_result
function GMArenaPeakNet:OnP2CCampsite(msg)
    if msg.ack == 1 then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
    end
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GMArenaPeakNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return GMArenaPeakNet