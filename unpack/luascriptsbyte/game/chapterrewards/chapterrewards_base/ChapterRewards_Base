---@class ChapterRewards_Base : ChapterRewards_Base	中文描述
---@field ParentView ChapterRewardsView
---@field ChapterId number 章节id
---@field RewardsType EChapterRewardsType 章节类型
---@field ChapterCfg table 章节配置
---@field call function 领取后回调(刷新显示 主界面默认刷新)
local ChapterRewards_Base = _G.BaseClass("ChapterRewards_Base", _G.Component)

---创建对象时,入口构造函数
function ChapterRewards_Base:OnCreate(ParentView)
    self.ParentView = ParentView
    self.ChapterId = ParentView.ChapterId
    self.call = ParentView.call
    self.RewardsType = _G.EChapterRewardsType.Prop
    self.ChapterCfg = _G.ConfigManager.main_chapter_cfg[self.ChapterId]
end

function ChapterRewards_Base:Dispose()
end

---通讯 领取奖励
function ChapterRewards_Base:GetChapterAward(parmas)
    require("ChapterModel"):GetInstance():GetChapterAward(
        parmas,
        function(data)
            if data.ack == 1 then
                if self.call then
                    self.call()
                end
                ---主界面默认刷新
                _G.MainManager:GetInstance():UpdataChapterRaward()
            -- elseif data.ack == "no_ pass_ section" then
            --     self:TipsNoPass()
            -- else
            --     _G.PopWindowManager:GetInstance():ShowAllTips(260101, data.ack)
            end
            self:CloseView()
        end
    )
end
function ChapterRewards_Base:CheckSectionPass()
    -- 检测关卡是否通关
    if
        require("ChapterModel"):GetInstance():CheckSectionPass(self.ChapterCfg.Section[#self.ChapterCfg.Section]) ==
            false
     then
        self:TipsNoPass()
        self:CloseView()
        return false
    end

    return true
end

---没有通关
function ChapterRewards_Base:TipsNoPass()
    if self.ChapterCfg ~= nil then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            260101,
            _G.LangUtil.GetLangPackValue(90022200009, self.ChapterCfg.ChapterNum, #self.ChapterCfg.Section)
        )
    end
end

---关闭界面
function ChapterRewards_Base:CloseView()
    self.ParentView:CloseView()
end

---销毁对象时,析构函数
function ChapterRewards_Base:OnDestroy()
    self.ParentView = nil
    self.ChapterId = nil
    self.call = nil
    self.RewardsType = nil
    self.ChapterCfg = nil
end

return ChapterRewards_Base
