local ChapterRewards_Base = require("ChapterRewards_Base")
---@class ChapterRewards_CardSelect : ChapterRewards_Base	中文描述
local ChapterRewards_CardSelect = _G.BaseClass("ChapterRewards_CardSelect", ChapterRewards_Base)

---创建对象时,入口构造函数
---@param ParentView ChapterRewardsView
---@param CardIds number[]
function ChapterRewards_CardSelect:OnCreate(ParentView)
    self.super.OnCreate(self, ParentView)
    self.CardIDs = require("ChapterModel"):GetInstance():GetChapterRawardParmas(self.ChapterId)
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    --当前选中角色
    self.CurIndex = nil
    self.ShowView = _G.GetAutoGoTable(self.go_table.obj_ShowView, _G.handler(self, self.OnClickBtn))

    self.CardDatas = {}
    for i = 1, #self.CardIDs do
        local sid = self.CardIDs[i]
        local data = _G.CardData.New()
        data:Parse({sid = sid, uid = sid, count = 1})
        data:SetCardMax()
        self.CardDatas[sid] = data
    end

    local initGrayIndex = 1
    while initGrayIndex >= 1 do
        local namebg = self:GetRoleNameBgGoTager(initGrayIndex)
        if namebg == nil then
            break
        end
        namebg:SetName(tostring(initGrayIndex))
        self:SetGray(initGrayIndex, true)

        _G.SetEventTrigger(namebg, "onEnter", _G.handler(self, self.OnRoleEnter))
        _G.SetEventTrigger(namebg, "onExit", _G.handler(self, self.OnRoleExit))
        _G.SetEventTrigger(namebg, "onClick", _G.handler(self, self.OnRoleClick))

        local roleBg = self:GetRoleGoTager(initGrayIndex)
        if roleBg ~= nil then
            roleBg.alphaHitTestMinimumThreshold = 0.1
            roleBg:SetName(tostring(initGrayIndex))
            _G.SetEventTrigger(roleBg, "onEnter", _G.handler(self, self.OnRoleEnter))
            _G.SetEventTrigger(roleBg, "onExit", _G.handler(self, self.OnRoleExit))
            _G.SetEventTrigger(roleBg, "onClick", _G.handler(self, self.OnRoleClick))
        end

        self:InitRoleInfo(initGrayIndex)

        initGrayIndex = initGrayIndex + 1
    end

    self:SetCardsAvatar()
    if self.ChapterCfg ~= nil then
        self.go_table.aortext_pz_1.text = _G.LangUtil.GetLangPackValue(90022200003, self.ChapterCfg.ChapterNum)
    end

    self:ClosShowView()

    self.CurIndex = 1
    self:SetGray(1, false)
end

---@param eventData UnityEngine.EventSystems.PointerEventData
function ChapterRewards_CardSelect:OnRoleEnter(go, eventData)
    local initGrayIndex = tonumber(go:GetName())
    if initGrayIndex ~= nil then
        if self.CurIndex ~= initGrayIndex then
            self:SetGray(initGrayIndex, false)
        end
    end
end
---@param eventData UnityEngine.EventSystems.PointerEventData
function ChapterRewards_CardSelect:OnRoleExit(go, eventData)
    local initGrayIndex = tonumber(go:GetName())
    if initGrayIndex ~= nil then
        if self.CurIndex ~= initGrayIndex then
            self:SetGray(initGrayIndex, true)
        end
    end
end
---@param eventData UnityEngine.EventSystems.PointerEventData
function ChapterRewards_CardSelect:OnRoleClick(go, eventData)
    local initGrayIndex = tonumber(go:GetName())
    if initGrayIndex ~= nil then
        self:SelectCard(initGrayIndex)
    end
end

function ChapterRewards_CardSelect:SelectCard(initGrayIndex)
    if initGrayIndex ~= nil then
        ---@type CardData
        local mCardData = self:GetCardData(initGrayIndex)
        if mCardData == nil then
            return
        end
        if mCardData.cfg.is_effective_hero == false then
            --- 防止变选中状态
            self:SetBtnIsOn(nil, false, initGrayIndex)
            _G.PopWindowManager:GetInstance():ShowAllTips(1001, "该角色未配置完成 无法查看")
            return
        end

        if self.CurIndex ~= nil then
            self:SetGray(self.CurIndex, true)
            self:SetBtnIsOn(nil, false, self.CurIndex)
        end

        self.CurIndex = initGrayIndex
        self:SetBtnIsOn(nil, true, initGrayIndex)
        self:SetGray(initGrayIndex, false)
        self:UpdateShowItemView()
    end
end

function ChapterRewards_CardSelect:SetGray(index, isGray)
    local rawimage = self:GetRoleGoTager(index)
    if rawimage == nil then
        return
    end
    rawimage:SetGray(isGray)

    local namebg = self:GetRoleNameBgGoTager(index)
    if not _G.IsNil(namebg) then
        namebg:SetGray(isGray)
    end

    self:RoleInfoSetGray(index, isGray)
end

function ChapterRewards_CardSelect:InitRoleInfo(index)
    local cardid = self.CardIDs[index]
    if cardid == nil then
        return
    end
    ---@type card_cfg
    local cardCfg = _G.ConfigManager.card_cfg[cardid]
    if cardCfg == nil then
        return
    end

    local infoStr = "aortext_info_" .. index

    local info_go = self:GetGo(infoStr)
    if info_go ~= nil then
        info_go.text = _G.LangUtil.GetLangPackValue(cardCfg.desc)
    end
    local nameStr = "aortext_name_" .. index
    local name_go = self:GetGo(nameStr)
    if name_go ~= nil then
        name_go.text = _G.LangUtil.GetLangPackValue(cardCfg.Name)
    end
end

function ChapterRewards_CardSelect:RoleInfoSetGray(index, isGray)
    local cardid = self.CardIDs[index]
    if cardid == nil then
        return
    end
    ---@type card_cfg
    local cardCfg = _G.ConfigManager.card_cfg[cardid]
    if cardCfg == nil then
        return
    end

    local infoStr = "aortext_info_" .. index

    local info_go = self:GetGo(infoStr)
    if info_go ~= nil then
        local color = nil
        if isGray then
            color = require("CardInfoManager").GetColorFromRGB("b8b8b8")
        else
            color = require("CardInfoManager").GetColorFromRGB("ff7283")
        end
        info_go.color = color
    end
end

---@return AorRawImage
function ChapterRewards_CardSelect:GetRoleGoTager(index)
    local nameStr = "aorimage_role (" .. index .. ")"
    return self:GetGo(nameStr)
end

---@return AorImage
function ChapterRewards_CardSelect:GetRoleNameBgGoTager(index)
    local nameStr = "aorimage_rolename (" .. index .. ")"
    return self:GetGo(nameStr)
end
function ChapterRewards_CardSelect:GetGo(nameStr)
    if _G.IsNil(self.go_table) then
        return nil
    end
    return self.go_table[nameStr]
end

function ChapterRewards_CardSelect:UpdateShowItemView()
    local cardid = self.CardIDs[self.CurIndex]
    if cardid == nil or _G.IsNil(self.ShowView) then
        return
    end
    ---@type card_cfg
    local cardcfg = _G.ConfigManager.card_cfg[cardid]
    if cardcfg == nil then
        return
    end
    ---@type CardData
    local mCardData = self.CardDatas[cardid]
    if mCardData == nil then
        return
    end

    local BG = {
        [1] = "Images/Draw/ui-zh-bg-R",
        [2] = "Images/Draw/ui-zh-bg-R",
        [3] = "Images/Draw/ui-zh-bg-sr",
        [4] = "Images/Draw/ui-zh-bg-SSR",
        [5] = "Images/Draw/ui-zh-bg-sr"
    }

    local Grade = {
        [1] = {
            Icon = "ui_ty_icon_n",
            BG = "ui-zh-bg-di3"
        },
        [2] = {
            Icon = "ui_ty_icon_r",
            BG = "ui-zh-bg-zidi"
        },
        [3] = {
            Icon = "ui_ty_icon_sr",
            BG = "ui-zh-bg-di3"
        },
        [4] = {
            Icon = "ui_ty_icon_ssr",
            BG = "ui-zh-bg-di4"
        },
        [5] = {
            Icon = "ui_ty_icon_ssr",
            BG = "ui-zh-bg-di4"
        }
    }

    self.ShowView.aorrawimage_BG:LoadImage(
        BG[mCardData.cfg.Order],
        function(image)
            if image ~= nil then
                image:SetActiveE(1)
            end
        end
    )
    self.ShowView.aorrawimage_Icon.Alpha = 0
    self.ShowView.aorrawimage_Icon:LoadImage(
        mCardData.cfg.Portrait,
        function(image)
            if image ~= nil then
                image:SetActiveE(1)
                image:SetNativeSize()
                image:SetLocalPosition(
                    mCardData.cfg.pos_portrait1[1],
                    mCardData.cfg.pos_portrait1[2],
                    mCardData.cfg.pos_portrait1[3]
                )
                image:SetLocalScaleXYZ(mCardData.cfg.size3)
            end
        end
    )
    -- for i = 1, 4 do
    --     self.BG[i]:SetActiveE(0)
    -- end
    -- self.BG[mCardData.cfg.Order]:SetActiveE(1)

    ---五行
    local type_elements_cfg = _G.ConfigManager.type_elements_cfg[mCardData.cfg.Elements]
    if not _G.IsNil(type_elements_cfg) then
        require("CardInfoManager").LoadRawImage(self.ShowView.aorrawimage_Element, type_elements_cfg.icon)
    end

    --职业
    local type_professional_cfg = _G.ConfigManager.type_professional_cfg[mCardData.cfg.Professional]
    if table.isEmptyOrNil(type_professional_cfg) then
        require("CardInfoManager").LoadRawImage(self.ShowView.aorrawimage_Prop, type_professional_cfg.icon)
    end
    self:SetSkillInfo(mCardData)

    self.ShowView.aortext_Name.text = _G.LangUtil.GetLangPackValue(mCardData.cfg.Name)
    ---背景介绍
    local desc2 = _G.LangUtil.GetLangPackValue(mCardData.cfg.desc2)
    if desc2 ~= nil then
        desc2 = "\t" .. desc2
    end
    self.ShowView.aortext_desc2.text = desc2

    -- local slogan = _G.LangUtil.GetLangPackValue(mCardData.cfg.slogan)
    -- local isNull_slogan = string.IsNullOrEmpty(slogan)
    -- if not isNull_slogan then
    --     self.ShowView.aortext_slogan.text = slogan
    -- end
    -- _G.GameUtil.SetActiveByCondition(self.ShowView.aorimage_DesBG, not isNull_slogan)

    self.ShowView.aortext_desc.text = _G.LangUtil.GetLangPackValue(mCardData.cfg.desc)
    self.ShowView.aorimage_GradeBG.SpriteName = Grade[mCardData.cfg.Order].BG
    self.ShowView.aorimage_Grade.SpriteName = Grade[mCardData.cfg.Order].Icon
    -- self.ShowView.aorimage_New:SetActiveE(mCardData.isNew and 1 or 0)
    self.go_table.obj_ShowView:SetActiveE(1)
end

function ChapterRewards_CardSelect:SetSkillInfo(mCardData)
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local SetSkill = function(rawimage, aortext, skillid)
        rawimage.Alpha = 0
        if skillid ~= nil and skillid > 0 then
            local skillCfg = card_skills_cfg[skillid]
            if skillCfg then
                rawimage:LoadImage(skillCfg.icon)
                aortext.text = _G.LangUtil.GetLangPackValue(skillCfg.name1)
            else
            end
        end
    end
    local skillid = mCardData.Skills.skill_1
    SetSkill(self.ShowView.aorrawimage_skill1, self.ShowView.aortext_skill1, skillid)
    skillid = mCardData.Skills.skill_3
    SetSkill(self.ShowView.aorrawimage_skill2, self.ShowView.aortext_skill2, skillid)
    skillid = mCardData.Skills.skill_4
    SetSkill(self.ShowView.aorrawimage_skill3, self.ShowView.aortext_skill3, skillid)
    skillid = mCardData.Skills.skill_5
    SetSkill(self.ShowView.aorrawimage_skill4, self.ShowView.aortext_skill4, skillid)
end

function ChapterRewards_CardSelect:SetCardsAvatar()
    local SetInfo = function(btn, index)
        local cardid = self.CardIDs[index]
        if cardid == nil then
            return
        end

        ---@type CardData
        local mCardData = self.CardDatas[cardid]
        if mCardData == nil then
            return
        end

        local tGoTable = _G.GetAutoGoTable(btn)

        if not _G.IsNil(tGoTable) then
            tGoTable.aorrawimage_card.Alpha = 0
            tGoTable.aorrawimage_card:LoadImage(mCardData.Icon)
        end
    end

    SetInfo(self.ShowView.aorbtn_Card1, 1)
    SetInfo(self.ShowView.aorbtn_Card2, 2)
    SetInfo(self.ShowView.aorbtn_Card3, 3)
    SetInfo(self.ShowView.aorbtn_Card4, 4)
end

function ChapterRewards_CardSelect:OnClickBtn(go, isOn)
    local name = go:GetName()
    if isOn == false then
        return
    end
    --关闭
    if name == "@_aorbtn_sure" then
        if self.super.CheckSectionPass(self) then
            if self.CurIndex == nil then
                _G.PopWindowManager:GetInstance():ShowAllTips(260101)
                return
            end
            self:GetChapterAward()
        end
    elseif name == "@_aorbtn_BG" then
        self:ClosShowView()
    elseif name == "$_aorbtn_Card1" or name == "$_aorbtn_Card2" or name == "$_aorbtn_Card3" or name == "$_aorbtn_Card4" then
        local index = tonumber(string.sub(name, #name))

        self:SelectCard(index)
    else
    end
end

---关闭 角色信息界面
function ChapterRewards_CardSelect:ClosShowView()
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_ShowView, false)
    -- 重置isOn
    for i = 1, 4 do
        self:SetBtnIsOn(nil, false, i)
    end
end

---获取CardData
---@param Index number 根据索引获取
---@param id number 根据id获取
---@return CardData
function ChapterRewards_CardSelect:GetCardData(Index, id)
    local mCardData = nil
    local cardid = id or self.CardIDs[Index]
    if cardid == nil then
        return mCardData
    end

    return self.CardDatas[cardid]
end

--- 设置Btn isOn
function ChapterRewards_CardSelect:SetBtnIsOn(aorbtn_Card, isOn, index)
    local btn = aorbtn_Card or self.ShowView["aorbtn_Card" .. index]
    if not _G.IsNil(btn) then
        local tGoTable = _G.GetAutoGoTable(btn)
        if not _G.IsNil(tGoTable) then
            tGoTable.obj_isOn:SetActiveE(isOn and 1 or 0)
        end
    end
end

---通讯 领取奖励
function ChapterRewards_CardSelect:GetChapterAward()
    ---@type instance.c2s_instance_get_reward_chapter
    local parmas = {}
    parmas.sid = self.ChapterId
    parmas.type = 2
    parmas.card_sid = self.CardIDs[self.CurIndex]
    self.super.GetChapterAward(self, parmas)
end

---没有通关
function ChapterRewards_CardSelect:TipsNoPass()
    self.super.TipsNoPass(self)
end

---关闭界面
function ChapterRewards_CardSelect:CloseView()
    self.super.CloseView(self)
end

---销毁对象时,析构函数
function ChapterRewards_CardSelect:OnDestroy()
    self.CardIDs = nil
    self.go_table = nil
    self.CurIndex = nil
end

return ChapterRewards_CardSelect
