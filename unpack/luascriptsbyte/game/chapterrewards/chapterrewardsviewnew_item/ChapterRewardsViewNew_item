---@class ChapterRewardsViewNew_item : Component	中文描述
---@field go_table ChapterRewardsViewNew._obj_item_GoTable
---@filed item BaseAwardNewItem
local ChapterRewardsViewNew_item = _G.BaseClass("ChapterRewardsViewNew_item", _G.Component)
local effect = {
    "ef_BaseItemWithCount_lv",
    "ef_BaseItemWithCount_lan",
    "ef_BaseItemWithCount_zi",
    "ef_BaseItemWithCount_cheng",
    "ef_BaseItemWithCount_hong",
    "ef_BaseItemWithCount_jin"
}
function ChapterRewardsViewNew_item:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
---创建对象时,入口构造函数
function ChapterRewardsViewNew_item:OnCreate(call)
    self.call = call
    self.item = require "BaseAwardNewItem".New(self.go_table.obj_Root, nil, 83)
    self.effect = nil
    self.inited = false
end
----更新显示
---@param index number 下标
---@param data ChapterRewardData
function ChapterRewardsViewNew_item:Show(index, data)
    self.index = index
    self.data = data
    self:UpdateShow()
end
---更新显示
function ChapterRewardsViewNew_item:UpdateShow()
    self.item:Show(self.data.reward)
    if self.data.afkCfg then
        self.go_table.aortext_section.text =
            _G.string.format("%d-%d", self.data.afkCfg.chapter, self.data.afkCfg.section)
    end

    self.go_table.obj_Root:SetLocalScaleXYZ(self.data.isBag and 1.2 or 1)
    self.go_table.obj_mask:SetLocalScaleXYZ(self.data.isBag and 1.2 or 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_Tips, self.data.isBag)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_light, false)
    if self.data.isBag then
        self.go_table.aortext_tips.text = self.data.reward:GetName() .. "x" .. self.data.reward:GetCount()
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_mask, self.data.isGet)

    self.grade = _G.StorageManager:GetInstance():GetItemGrade(self.data.reward.sid, self.data.reward.uid)
    if not self.effect then
        if not self.spawnEff then
            self.spawnEff = true

            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_BaseItemWithCount_jin,
                self.go_table.obj_Root,
                function(trans)
                    self.spawnEff = false
                    self.effect = trans
                    trans:SetAnchorPosition(0, 0)
                    _G.GameUtil.SetActiveByCondition(self.effect, self.data.CanTake)
                    local item = trans:GetComponentE(_G.typeof(_G.CS.ParticleClipRect))
                    if not self.inited then
                        self.inited = true
                        self.co =
                            _G.DelayDo(
                            0.3,
                            function()
                                item.enabled = false
                                item.enabled = true
                            end
                        )
                    end
                end
            )
        end
    else
        _G.GameUtil.SetActiveByCondition(self.effect, self.data.CanTake)
    end
end

---点击奖励item回调
function ChapterRewardsViewNew_item:OnClickBtn(go, isOn)
    if self.call then
        self.call(go, isOn, self)
    end
end

---销毁对象时,析构函数
function ChapterRewardsViewNew_item:OnDestroy()
    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end

return ChapterRewardsViewNew_item
