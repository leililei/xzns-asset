---@class ChapterRewardData	中文描述
---@field sid number 任务sid
---@field cfg afk_stage_cfg|afk_stage2_cfg
---@field afkCfg afk_cfg
---@field isStage2 boolean 是否为通关豪礼
---@field isGet boolean 是否被领取
---@field CanTake boolean 是否可领取
local ChapterRewardData = _G.BaseClass("ChapterRewardData")

---类的构造函数
function ChapterRewardData:__init()
end

---类的析构函数
function ChapterRewardData:Dispose()
end

--- 解析数据
---@param cfg afk_stage_cfg|afk_stage2_cfg
---@param isStage2 boolean 是否为通关豪礼
function ChapterRewardData:Parse(cfg, isStage2)
    self.sid = cfg.id
    self.cfg = cfg
    self.afkCfg = _G.ConfigManager.afk_cfg[cfg.afk]
    self.isStage2 = isStage2
    if isStage2 then
        self.isGet = require "AfkTaskModel":GetInstance():CheckIsGet2(self.sid)
    elseif self.cfg.stage > 0 then
        self.isGet = require "AfkTaskModel":GetInstance():CheckIsGet(self.sid)
    else
        self.isGet = false --require "AfkTaskModel":GetInstance().Data.c_sid >= self.sid
    end
    if not isStage2 then
        self.reward = _G.StorageManager:GetInstance():GetItemDataClassByCfg(cfg.reward_show[1])
        self.isBag = not _G.string.IsNullOrEmpty(self.cfg.image)
    end
    self.realReward = cfg.reward[1]
    self:UpdateCanTake()
end

function ChapterRewardData:UpdateCanTake()
    if self.isGet then
        self.CanTake = false
        return
    end

    if self.cfg.stage == 0 then
        local afk = require("AfkModel"):GetInstance():GetCurSection()
        local curMainID = _G.ConfigManager.afk_cfg[afk].chapter
        if self.cfg.chapter == curMainID then
            if
                require("AfkModel"):GetInstance():CheckSectionIsEnd(afk) and
                require("AfkModel"):GetInstance():CheckSectionIsPass(afk)
            then
                self.CanTake = true
            else
                self.CanTake = false
            end
        else
            self.CanTake = self.cfg.chapter < curMainID
        end
    else
        self.CanTake = require "AfkModel":GetInstance():CheckSectionIsPass(self.cfg.afk)
    end
end

return ChapterRewardData
