---@class ChapterRewardsView : UIBaseView	章节奖励界面
---@field public go_table ChapterRewardsView_GoTable GoTable
local ChapterRewardsView = _G.BaseClass("ChapterRewardsView", _G.UIBaseView)

function ChapterRewardsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    --按钮点击对应的方法
    self.clickFunction = {
        --界面关闭
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["nilFnc"] = function(self, go)
            if _G.AppSetting.DEBUG then
                _G.Log("未设置点击事件", "<color=red>" .. ">>>" .. go:GetName() .. "</color>")
            end
        end
    }
end

---界面的入口函数
function ChapterRewardsView:OnCreate(eChapterRewardsType, chapterid, call)
    if eChapterRewardsType == nil then
        eChapterRewardsType = _G.EChapterRewardsType.Prop
    end
    if chapterid == nil then
        chapterid = require("ChapterModel"):GetInstance():GetNoGetAwardChapterId()
    end

    self.RewardsType = eChapterRewardsType
    self.ChapterId = chapterid
    self.call = call
    self.ResLoadCompleteCall = _G.handler(self, self.SetData)

    self:AddRest()
end

---资源加载
function ChapterRewardsView:AddRest()
    self.resKey = {
        CardSelect = "CardSelect",
        item = "item"
    }
    self.go_View = nil

    if self.RewardsType == _G.EChapterRewardsType.CardN1 then
        self:AddResToList(
            self.resKey.CardSelect,
            _G.UIResType.pool,
            "UI/ChapterRewards/ChapterRewards_CardSelect",
            nil,
            self.go_table.obj_node
        )
    elseif self.RewardsType == _G.EChapterRewardsType.Prop then
        self:AddResToList(
            self.resKey.item,
            _G.UIResType.pool,
            -- "UI/ChapterRewards/ChapterRewards_Item",
            _G.ConfigManager.ui_effect_cfg.Ef_ChapterRewards_Item.Path,
            nil,
            self.go_table.obj_node
        )
    end
end

function ChapterRewardsView:SetData()
    if self.RewardsType == _G.EChapterRewardsType.CardN1 then
        local tran = self.ResList[self.resKey.CardSelect]

        local lua = reimport("Game.ChapterRewards.ChapterRewards_CardSelect")
        self.go_View = self:AddComponent(tran, lua.New(self))
    elseif self.RewardsType == _G.EChapterRewardsType.Prop then
        local tran = self.ResList[self.resKey.item]

        local lua = reimport("Game.ChapterRewards.ChapterRewards_Item")
        self.go_View = self:AddComponent(tran, lua.New(self))
    else
    end
end

function ChapterRewardsView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function ChapterRewardsView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn, name)
    else
        self.clickFunction["nilFnc"](self, go)
    end
end

return ChapterRewardsView
