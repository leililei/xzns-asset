local ChapterRewards_Base = require "ChapterRewards_Base"
---@class ChapterRewards_Item : ChapterRewards_Base	中文描述
local ChapterRewards_Item = _G.BaseClass("ChapterRewards_Item", ChapterRewards_Base)

local CS = _G.CS
local typeof = _G.typeof

---创建对象时,入口构造函数
function ChapterRewards_Item:OnCreate(ParentView)
    --- 是否可以点击关闭了
    self.isClose = false

    self.super.OnCreate(self, ParentView)

    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
    local ChapterModel = require("ChapterModel"):GetInstance()
    local parmas = ChapterModel:GetChapterRawardParmas(self.ChapterId)
    local cfg = _G.ConfigManager.main_chapter_cfg[self.ChapterId]
    if cfg ~= nil and parmas ~= nil then
        self.go_table.aortext_info.text = _G.LangUtil.GetLangPackValue(90022200007, cfg.ChapterNum, parmas[2])

        self.go_table.aortext_Count.text = "x" .. parmas[2]
    end

    local delay = _G.ConfigManager.discrete_cfg[_G.DiscreteCfg_Enum.viewCloseDelay]
    delay = tonumber(delay) or 1
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        delay,
        self.TimerFunc,
        self,
        true,
        false,
        false,
        ChapterModel
    )
    self.timer:Start()
end

function ChapterRewards_Item:TimerFunc(ChapterModel)
    local sectionid = self.ChapterCfg.Section[#self.ChapterCfg.Section]
    if sectionid ~= nil then
        local isPass = ChapterModel:CheckSectionPass(sectionid)
        self.go_table.aorbtn_sure:SetActiveE(isPass and 1 or 0)
        self.go_table.aorbtn_Go:SetActiveE((not isPass) and 1 or 0)
        self.sectionid = sectionid
    end

    self.isClose = true
end

---通讯 领取奖励
function ChapterRewards_Item:GetChapterAward()
    ---@type instance.c2s_instance_get_reward_chapter
    local parmas = {}
    parmas.sid = self.ChapterId
    parmas.type = 1
    self.super.GetChapterAward(self, parmas)
end

---没有通关
function ChapterRewards_Item:TipsNoPass()
    self.super.TipsNoPass(self)
end

---关闭界面
function ChapterRewards_Item:CloseView()
    if self.isClose == false then
        return
    end
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self.super.CloseView(self)
end

---销毁对象时,析构函数
function ChapterRewards_Item:OnDestroy()
    self.go_table = nil
end

function ChapterRewards_Item:OnClickBtn(go, isOn)
    local name = go:GetName()
    --关闭
    if name == "@_aorbtn_CloseView" or name == "@_aorbtn_CloseView2" then
        --关闭
        self:CloseView()
    elseif name == "@_aorbtn_sure" then
        if self.super.CheckSectionPass(self) then
            self:GetChapterAward()
        end
    elseif name == "@_aorbtn_Go" then
        --关闭
        self:CloseView()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SelectSectionMapView.Name, self.ChapterId)
    end
end

return ChapterRewards_Item
