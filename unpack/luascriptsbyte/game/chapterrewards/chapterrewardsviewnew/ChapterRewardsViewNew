local ChapterRewardData = require "ChapterRewardData"
local ChapterRewardsViewNew_item = require "ChapterRewardsViewNew_item"
---@class ChapterRewardsViewNew : UIBaseView	中文描述
---@field public go_table ChapterRewardsViewNew_GoTable GoTable
---@field awardItemList ChapterRewardsViewNew_item[] 奖励列表
---@field AwardDatas ChapterRewardData[]
---@field afkID number 当前玩家所在afk
---@field chapter number 当前玩家已经完成的章节（包括有没有领取奖励）
---@field Box  ChapterRewardsViewNew._obj_Box_GoTable
---@field bagData ChapterRewardData
local ChapterRewardsViewNew = _G.BaseClass("ChapterRewardsViewNew", _G.UIBaseView)

function ChapterRewardsViewNew:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, _G.AudioClipTypeEnum.openPanel)
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
end

---界面的入口函数
function ChapterRewardsViewNew:OnCreate()
    self.grid = self.go_table.obj_Content:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
    if require "AfkTaskModel":GetInstance().Data then
        self:Init()
    else
        require "AfkTaskModel":GetInstance():GetAfkData(_G.handler(self, self.Init))
    end
end

---界面初始化
function ChapterRewardsViewNew:Init()
    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    self.isInited = false
    self.Data = require "AfkTaskModel":GetInstance().Data
    self.chapter = require "AfkTaskModel":GetInstance():GetCurChapter()
    self.Box = _G.GetAutoGoTable(self.go_table.obj_Box, _G.handler(self, self.OnClickBtn))
    self:InitAwardDatas()
    self:initUnit()
    self.afkID = require "AfkModel":GetInstance():GetCurSection()
    self.awardItemList = {}
    self.go_table.scrollloophorizontal_itemList:SetContentPosChangeCall(_G.handler(self, self.OnDrag))
    self:InitView()
    self.isInited = true
end

---初始化每个章节的单位
function ChapterRewardsViewNew:initUnit()
    self.count = #self.AwardDatas
    self.unit = 131.5
    if self.count <= 6 then
        if self.count > 1 then
            self.grid.spacing = _G.Vector2((758 - 88 * self.count) / (self.count - 1), 0)
            self.unit = self.grid.spacing.x + 88
        else
            self.grid.padding.bottom = _G.Vector2(758, 0)
            self.unit = 758
        end
        self.grid.enabled = true
        self.maxValue = 758
    else
        self.grid.enabled = false
        self.grid.spacing = _G.Vector2(43.5, 0)
        self.maxValue = (self.count - 1) * 131.5 + 88
        self.go_table.slider_Chapter:SetRectTransformSize(self.maxValue, 23)
    end
end
---初始化奖励数据
function ChapterRewardsViewNew:InitAwardDatas()
    self.AwardDatas = require "AfkTaskModel":GetInstance().AwardDatas
    self.getCount = 0
    for _, v in ipairs(self.AwardDatas) do
        if v.CanTake then
            self.getCount = self.getCount + 1
        end
        if not v.CanTake and not v.isGet then
            break
        end
    end
end

function ChapterRewardsViewNew:InitView()
    if not self.AwardDatas then
        return
    end
    local count = 0
    local get = 0
    for i = 1, self.count do
        if not self.AwardDatas[i].isGet then
            count = i
            break
        end
    end
    if count == 0 then
        count = self.count
    end
    for i = count, self.count do
        if self.AwardDatas[i].isBag and not self.AwardDatas[i].isGet then
            self.startBox = self.AwardDatas[i].sid
            break
        end
    end
    local max = 1
    for i = 1, self.count do
        if self.AwardDatas[i].cfg.afk >= self.afkID then
            break
        else
            max = i
        end
    end
    self.startIndex = 0
    self:InitSlider()
    self.go_table.scrollloophorizontal_itemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect)).inertia =
        false
    if not self.isInited then
        self.go_table.scrollloophorizontal_itemList:InitItemData(
            _G.math.min(max + 24, self.count),
            _G.handler(self, self.RefreshItem),
            _G.math.min(_G.math.max(count - 2, 0), self.count - 6)
        )
    else
        self.go_table.scrollloophorizontal_itemList:UpdateCount(self.count)
    end
    self.co3 =
        _G.DelayDo(
        0.3,
        function()
            local rect =
                self.go_table.scrollloophorizontal_itemList:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
            rect.inertia = true
            rect.horizontal = true
        end
    )
    self:InitBox(count)
    --self:UpdateBox(self.boxItem)
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_get, self.getCount > 1)
end

---初始化左边显示
function ChapterRewardsViewNew:InitBox(count)
    if count > 1 then
        local start = _G.math.max(count - 1, 1)
        local data = nil
        for i = start, self.count do
            if not self.AwardDatas[i].isGet and self.AwardDatas[i].isBag then
                data = self.AwardDatas[i]
                break
            end
        end
        if not data then
            for i = start - 1, 1, -1 do
                if self.AwardDatas[i] and self.AwardDatas[i].isBag then
                    data = self.AwardDatas[i]
                    break
                end
            end
        end
        self:UpdateBox(data)
    else
        for i = 1, self.count do
            if not self.AwardDatas[i].isGet and self.AwardDatas[i].isBag then
                self:UpdateBox(self.AwardDatas[i])
                break
            end
        end
    end
end

---初始化Slider显示
function ChapterRewardsViewNew:InitSlider()
    self.go_table.slider_Chapter.maxValue = self.maxValue
    local progress = 0
    local data = self.AwardDatas[1]
    local lastData = data
    local count = 1
    for i = 1, self.count do
        if not self.AwardDatas[i].CanTake and not self.AwardDatas[i].isGet then
            data = self.AwardDatas[i]
            break
        else
            count = i
            lastData = self.AwardDatas[i]
        end
    end
    if count == self.count then
        progress = self.maxValue
    else
        if self.afkID <= self.AwardDatas[1].cfg.afk then
            local unit = 46 / (self.AwardDatas[1].cfg.afk % 100)
            progress = unit * (self.afkID % 100 - 1)
        else
            local allCount = 0
            local overCount = 0
            if _G.math.floor(data.cfg.afk / 1000) - _G.math.floor(lastData.cfg.afk / 1000) >= 1 then
                if _G.math.floor(self.afkID / 1000) - _G.math.floor(lastData.cfg.afk / 1000) >= 1 then
                    for i = 1, 1000 do
                        if not _G.ConfigManager.afk_cfg[lastData.cfg.afk + i] then
                            break
                        end
                        overCount = overCount + 1
                    end
                    overCount = overCount + self.afkID % 100 - 1
                    allCount = overCount + data.cfg.afk % 100
                else
                    overCount = self.afkID % 100 - lastData.cfg.afk % 100 - 1
                    allCount = overCount + data.cfg.afk % 100
                end
            else
                allCount = data.cfg.afk % 100 - lastData.cfg.afk % 100
                overCount = self.afkID % 100 - lastData.cfg.afk % 100 - 1
            end
            progress = 46 + (count - 1) * self.unit + overCount / allCount * self.unit
        end
    end

    self.go_table.slider_Chapter.value = progress
end

---初始化顶部内容
---@param item ChapterRewardsViewNew_item
function ChapterRewardsViewNew:UpdateBox(data)
    if not data then
        return
    end
    if self.bagData and data.sid == self.bagData.sid then
        return
    end
    if self.bagData then
        self.bagData.isChoose = false
    end
    self.bagData = data
    self.bagData.isChoose = true
    if self.bagData then
        if self.bagData.afkCfg then
            self.Box.aortext_content.text =
                _G.string.format(
                _G.LangUtil.GetLangPackValue(90000010056),
                self.bagData.afkCfg.chapter,
                self.bagData.afkCfg.section,
                self.bagData.reward:GetName(),
                self.bagData.reward:GetCount()
            )
        else
            self.Box.aortext_content.text =
                _G.string.format(
                _G.LangUtil.GetLangPackValue(90000010056),
                1,
                1,
                self.bagData.reward:GetName(),
                self.bagData.reward:GetCount()
            )
        end
        self.Box.aorrawimage_icon:LoadImage(
            self.bagData.cfg.image,
            function()
                self.Box.aorrawimage_icon:SetNativeSize()
            end
        )

        local pos = self.bagData.cfg.pos_portrait1
        self.Box.aorrawimage_icon:SetLocalPosition(pos[1], pos[2], pos[3])
    end
    self:ShowBoxEffect()
    --_G.LangUtil.GetLangPackValue()
end
---显示左边奖励特效
function ChapterRewardsViewNew:ShowBoxEffect()
    if not self.bagData then
        return
    end
    local data = self.bagData
    if self.effect then
        _G.DestroyObject(self.effect)
        self.effect = nil
    end
    local type = _G.StorageManager:GetInstance():CheckSidType(self.bagData.reward.sid)
    local parent = self.go_table.trans_Effect1
    if type == _G.StorageType.Card then
        parent = self.go_table.trans_Effect2
    end
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg[self.bagData.cfg.effec],
        parent,
        function(trans)
            if _G.IsNil(self.go_table) or data ~= self.bagData then
                _G.DestroyObject(trans)
                return
            end
            self.effect = trans
        end
    )
end

---获取下一个领取奖励的章节
function ChapterRewardsViewNew:GetNextChapterData()
    local count = #self.AwardDatas
    for i = 1, count do
        if self.AwardDatas[i].cfg.chapter > self.chapter then
            return self.AwardDatas[i]
        end
    end
    return self.AwardDatas[count]
end

function ChapterRewardsViewNew:GetCurChapter()
    local count = #self.AwardDatas
    local chapter = 1
    for i = 1, count do
        if self.AwardDatas[i].cfg.chapter <= self.chapter then
            chapter = i
        else
            break
        end
    end
    return chapter
end

function ChapterRewardsViewNew:RefreshItem(index, obj)
    local newIndex = index + 1
    local instanceID = obj:GetInstanceIDE()
    local awardItem = self.awardItemList[instanceID]
    if not awardItem then
        awardItem = self:AddComponent(obj, ChapterRewardsViewNew_item.New(_G.handler(self, self.OnClickItem)))
        self.awardItemList[instanceID] = awardItem
    end

    awardItem:Show(newIndex, self.AwardDatas[newIndex])
    obj:SetName(index + 1)
end

