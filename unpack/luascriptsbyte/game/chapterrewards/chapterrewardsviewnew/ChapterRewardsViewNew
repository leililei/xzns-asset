---获取下一章节
function ChapterRewardsViewNew:ChangeNextChapter()
    self.chapter = require "AfkTaskModel":GetInstance():GetCurChapter()
    self:InitAwardDatas()
    self:initUnit()
    self.afkID = require "AfkModel":GetInstance():GetCurSection()
    self:InitView()
end

function ChapterRewardsViewNew:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        if not self.isClose then
            self:CloseView()
        end
    elseif go == self.go_table.aorbtn_CloseView2 then
        if not self.isClose then
            self:CloseView()
        end
    elseif go == self.go_table.aorbtn_get then
        self:GetAllAward()
    elseif go == self.Box.aorbtn_box then
        if self.bagData then
            require "CommonTipManager":GetInstance():OpenTip(go, self.bagData.reward.sid, self.bagData.reward.uid)
        end
    end
end

---一键领取奖励
function ChapterRewardsViewNew:GetAllAward()
    require "AfkTaskModel":GetInstance():GetAllAward(
        function(awardData, sids)
            self.msgData = awardData
            self.showTb = {}
            for _, v in ipairs(sids) do
                local id = require "AfkTaskModel":GetInstance():GetStoryID(v)
                if id then
                    self.showTb[v] = id
                end
            end
            self.showTb = _G.table.toArray(self.showTb)
            self.showIndex = 1
            self.showCount = #self.showTb
            if self.showCount > 0 then
                _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnClosedView, self)
                _G.AutomaticPlayStory.PlayStoryByID(_G.tonumber(self.showTb[self.showIndex]))
            else
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.msgData)
            end

            self.go_table.scrollloophorizontal_itemList:UpdateAllItem()
            self.getCount = 0
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_get, false)
        end
    )
end

function ChapterRewardsViewNew:OnClosedView(name)
    if name == _G.ConfigManager.ui_cfg.StoryItemDisplayView.Name then
        self.showIndex = self.showIndex + 1
        if self.showIndex > self.showCount then
            _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
            _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnClosedView, self)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, self.msgData)
            return
        end
        _G.AutomaticPlayStory.PlayStoryByID(_G.tonumber(self.showTb[self.showIndex]))
    end
end

function ChapterRewardsViewNew:IsGetAll()
    for _, v in pairs(self.AwardDatas) do
        if not v.isGet and v.stage > 0 then
            return false
        end
    end
    return true
end
