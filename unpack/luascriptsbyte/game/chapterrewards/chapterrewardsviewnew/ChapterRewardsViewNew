function ChapterRewardsViewNew:OnDrag(x)
    if x > 0 then
        return
    end
    local item = nil
    for _, v in pairs(self.awardItemList) do
        if v.data and v.data.isBag then
            local x1 = v.gameObject:GetLocalPosition()
            if not item then
                if _G.math.abs(x) + 811 > _G.math.abs(x1) then
                    item = v
                end
            else
                if v.data.sid > item.data.sid then
                    if _G.math.abs(x) + 811 > _G.math.abs(x1) then
                        item = v
                    end
                end
            end
        end
    end
    if item then
        self:UpdateBox(item.data)
    end
end

function ChapterRewardsViewNew:OnDisable()
    self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator)).enabled = false
end

return ChapterRewardsViewNew
