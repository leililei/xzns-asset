local DiscoveryRewardItem = require("DiscoveryRewardItem")

---@class MiningRewardView : UIBaseView
---@field private go_table MiningRewardView_GoTable GoTable
local MiningRewardView = BaseClass("MiningRewardView",_G.UIBaseView)

---@class MiningRewardView.RewardData
---@field min_rank number 层数
---@field rewards number[] 奖励列表

function MiningRewardView:OnCreate()
    self:InitData()
    self:RefreshData()
    self:InitUI()
    self:RefreshUI()
end

function MiningRewardView:InitData()

    local RelicTeamModel = require("RelicTeamModel"):GetInstance()
    local RelicCfg = RelicTeamModel:GetRelicCfgNow()
    local cfgIds = RelicCfg.dropid
    local cfgIdDict = {}
    local count = #cfgIds
    for i = 1, count do
        cfgIdDict[cfgIds[i]] = cfgIds[i]
    end

    ---@type drop_cfg[]
    self.cfgs = {}
    ---@type MiningRewardView.RewardData[]
    self.rewardList = {}

    local cfg = _G.ConfigManager.drop_cfg
    for id, v in pairs(cfg) do
        if cfgIdDict[id] then
            table.insert(self.cfgs, v)
        end
    end

    table.sort(self.cfgs, function(a, b)
        return a.sid < b.sid
    end)

    count = #self.cfgs
    local cfg = self.cfgs[1]
    for i = 1, count do
        ---@type MiningRewardView.RewardData
        local rewardData= {
            min_rank = i,
            rewards = { }
        }
        local diDict = {}
        cfg = self.cfgs[i]
        if cfg.sub_drop then
            self:AddCfgId(cfg.sub_drop, rewardData.rewards,diDict)
        end
        if cfg.fixed_drop then
            self:AddList(cfg.fixed_drop, rewardData.rewards,diDict)
        end
        if cfg.content1 then
            self:AddList(cfg.content1, rewardData.rewards,diDict)
        end
        if cfg.content2 then
            self:AddList(cfg.content2, rewardData.rewards,diDict)
        end
        table.sort(rewardData.rewards, function(a, b)
            local aQuality = StorageManager:GetInstance():GetItemQuality(a[1])
            local bQuality = StorageManager:GetInstance():GetItemQuality(b[1])
            if aQuality and bQuality then
                if aQuality == bQuality then
                    return a[1] < b[1]
                end
                return aQuality > bQuality
            else
                return a[1] < b[1]
            end
        end)
        table.insert(self.rewardList, rewardData)
    end
end

function MiningRewardView:AddCfgId(rewardlistcfg,list,diDict)
    local childDataCount = #rewardlistcfg
    for i = 1, childDataCount do
        local id = rewardlistcfg[i]
        local cfg = _G.ConfigManager.drop_cfg[id]
        if cfg.sub_drop then
            self:AddCfgId(cfg.sub_drop, list,diDict)
        end
        if cfg.fixed_drop then
            self:AddList(cfg.fixed_drop, list,diDict)
        end
        if cfg.content1 then
            self:AddList(cfg.content1, list,diDict)
        end
        if cfg.content2 then
            self:AddList(cfg.content2, list,diDict)
        end
    end
end

function MiningRewardView:AddList(rewardlistcfg,list,diDict)
    local childDataCount = #rewardlistcfg
    for i = 1, childDataCount do
        if diDict[rewardlistcfg[i][1]] == nil then
            table.insert(list, rewardlistcfg[i])
            diDict[rewardlistcfg[i][1]] = true
        end
    end
end

function MiningRewardView:RefreshData()

end

function MiningRewardView:InitUI()
    self.go_table = GetAutoGoTable(self.transform,handler(self,self.OnClickBtn))

    if self.go_table.looplist2_propT then
        self.go_table.looplist2_propT:InitListView(0, _G.handler(self, self.OnRefreshContent))
    end
end

function MiningRewardView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = self.rewardList[newIndex]

    local rewardCount = #cfg.rewards
    local itemName = "$_obj_ActiveDisRewardItem1"
    if rewardCount > 5 and rewardCount <= 10 then
        itemName = "$_obj_ActiveDisRewardItem2"
    elseif rewardCount > 10 then
        itemName = "$_obj_ActiveDisRewardItem3"
    end
    local item = listView2:NewListViewItem(itemName)
    ---@type DiscoveryRewardItem
    local itemLua = DiscoveryRewardItem.New(item, _G.handler(self, self.GetCall))
    itemLua:RefreshItem(cfg, newIndex)
    _G.GameUtil.ReBuildRTF(item)

    return item
end

function MiningRewardView:RefreshUI()
    if self.cfgs == nil then
        return
    end
    self.go_table.looplist2_propT:SetListItemCount(#self.rewardList, true)
end

---OnClickBtn按钮点击事件
---@protected
---@param go GameObject 按钮对象
---@param isOn boolean 状态（toggle使用）
function MiningRewardView:OnClickBtn(go, isOn)
    if self.go_table.aorbtn_close == go or self.go_table.aorbtn_Close == go then
        self:Close()
    end
end

---@return MiningRewardView
return MiningRewardView