---@param data ArchaeoIntegralRankData.RankData
---@param rankData ArchaeoIntegralRankData
---@param isEmpty boolean
function ArchaeologyRankItem:RefreshItem(data,index,rankData,isEmpty)
    self.data = data
    local rank = data.rank or index


    RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg,index)
    if rank <= 3 then
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.obj_SpecialRankNode:SetActiveE(1)
        RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
    else
        self.go_table.aortext_rank:SetActiveE(1)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.aortext_rank.text = rank
    end
    if isEmpty then
        self.go_table.obj_content:SetActiveE(0)
        self.go_table.obj_noBody:SetActiveE(1)
        return
    end
    self.go_table.obj_content:SetActiveE(1)
    self.go_table.obj_noBody:SetActiveE(0)

    self:RefreshDescIcon(rankData)
    self.go_table.aortext_desc.text = data.value // 1
    --self.go_table.aortext_name.text = data.playData.name or "???"
    self.go_table.aortext_name.text = rankData:GetItemShowName(rank)
    local uid = data.playData.uid
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.UIUtils.SetPlayerHeadItemNew(
                self.go_table.obj_head,
                _G.PlayerModel:GetInstance():GetIRroleTable(),
                1,
                true,
                true,
                true
        )
    else
        _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_head,
                RankUtils.i_record_rankToi_role(data.playData)
        , 1, true, true, true)
    end
    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

---@param data rank.i_record_rank
---@param rank number
---@param value number 积分值
---@param rankData ArchaeoIntegralRankData
function ArchaeologyRankItem:Refresh_MyRank(data,rank,value,rankData)
    _G.UIUtils.SetPlayerHeadItemNew(
            self.go_table.obj_head,
            data,
            1,
            true,
            true,
            true
    )
    if rank == nil then
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.obj_noRank:SetActiveE(1)
    else
        self.go_table.obj_noRank:SetActiveE(0)
        if rank <= 3 then
            self.go_table.aortext_rank:SetActiveE(0)
            self.go_table.obj_SpecialRankNode:SetActiveE(1)
            RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
        else
            self.go_table.aortext_rank:SetActiveE(1)
            self.go_table.obj_SpecialRankNode:SetActiveE(0)
            self.go_table.aortext_rank.text = rank
        end
    end

    self:RefreshDescIcon(rankData)
    self.go_table.aortext_desc.text = value // 1
    self.go_table.aortext_name.text = data.name or "???"

    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

