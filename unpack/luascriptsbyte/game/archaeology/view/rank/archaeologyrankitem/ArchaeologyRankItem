function ArchaeologyRankItem:__init(obj)
    ---@type PersonalPointsRankView._obj_rankItem_GoTable|PersonalPointsRankView._obj_selfRank_GoTable
    self.go_table = GetAutoGoTable(obj,self.onlick)

