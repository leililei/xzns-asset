local IconName = {
    [1] = "0ui_icon_diyi",
    [2] = "0ui_icon_dier",
    [3] = "0ui_icon_disan",
}

local Gradient = {
    [1] = { "FFCB28", "ffffff", "110802" },
    [2] = { "E930FF", "ffffff", "110802" },
    [3] = { "1F7296", "ffffff", "110802" },
}

---@class ArchaeologySociatyRankItem
local ArchaeologySociatyRankItem = _G.BaseClass("ArchaeologySociatyRankItem")

function ArchaeologySociatyRankItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, self.onlick)
end

---@param data ArchaeoIntegralRankData.RankData
---@param rankData ArchaeoIntegralRankData
---@param isEmpty boolean
function ArchaeologySociatyRankItem:RefreshItem(data, index, rankData, isEmpty)
    self.data = data
    self.go_table.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
    self.go_table.aortext_name.text = data.name
    self.go_table.aortext_president.text = data.president_name
    self.go_table.aortext_level.text = _G.LangUtil.GetLangPackValue(9002010022, data.level)
    self.go_table.aortext_num.text = data.score
    self.go_table.aorimage_rankBg:SetActiveE(index <= 3 and 1 or 0)
    self.go_table.aortext_Rank:SetActiveE(index <= 3 and 1 or 0)
    self.go_table.obj_rankBg2:SetActiveE(index <= 3 and 0 or 1)
    local power = data.power or 0
    self.go_table.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(power)
    self:SetItemRankInfo(self.go_table, index)
end

function ArchaeologySociatyRankItem:SetItemRankInfo(go, index)
    local ctrl = go
    local eIndex = index
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = IconName[eIndex]

        ctrl.aortext_Rank.text = eIndex
        local gradient = ctrl.aortext_Rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
        local c1 = _G.ColorTools.FormatColorByString(Gradient[eIndex][1])
        local c2 = _G.ColorTools.FormatColorByString(Gradient[eIndex][2])
        local color1 = _G.CS.UnityEngine.GradientColorKey()
        local color2 = _G.CS.UnityEngine.GradientColorKey()
        color1.color = c1
        color1.time = 1
        color2.color = c2
        color2.time = 0

        local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
        local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

        alpha1.alpha = 255
        alpha1.time = 1
        alpha2.alpha = 255
        alpha2.time = 0

        gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
    elseif eIndex == 100000 then
        ctrl.aortext_rankNum.text = _G.ConfigManager.language_package_cfg[90022900040]
    else
        ctrl.aortext_rankNum.text = eIndex
    end
end

---@param data rank.i_record_rank
---@param rank number
---@param value number 积分值
---@param rankData ArchaeoIntegralRankData
function ArchaeologySociatyRankItem:Refresh_MyRank(data, rank, value, rankData)
    self.go_table.aorrawimage_Icon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.Banner].portrait)
    self.go_table.aortext_name.text = data.Name
    self.go_table.aortext_num.text = value == 0 and "" or value
    self.go_table.aorimage_rankBg:SetActiveE(rank <= 3 and 1 or 0)
    self.go_table.aortext_Rank:SetActiveE(rank <= 3 and 1 or 0)
    self.go_table.obj_rankBg2:SetActiveE(rank <= 3 and 0 or 1)
    self:SetItemRankInfo(self.go_table, rank)
end

function ArchaeologySociatyRankItem:onlick(go)
end

---@return ArchaeologySociatyRankItem
return ArchaeologySociatyRankItem