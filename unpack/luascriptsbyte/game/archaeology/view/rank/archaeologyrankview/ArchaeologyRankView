---加载顶部展示玩家数据
function ArchaeologyRankView:LoadTopInfos()
    if self.CurRankData.listRankDatas == nil or self.CurRankData.listRankDatas[1] == nil then
        return
    end

    self.TopPlayLoadAsCount = 0
    self.Init_LoadTopInfos = false
    ---@type role.i_role_info[]
    self.RoleInfos = {}
    local SystemSettingNet = require("SystemSettingNet"):GetInstance()
    local count = #self.CurRankData.listRankDatas
    if count > 3 then
        count = 3
    end
    for i = 1, count do
        self.TopPlayLoadAsCount = self.TopPlayLoadAsCount + 1
        if self.CurSelectRankType == RankUtils.RankType.AncientGodAllianceTeam then
            SystemSettingNet:GetPlayerInfo(
                    { uid = self.CurRankData.listRankDatas[i].playData[1].playData.uid },
                    handlerbind(self, self.LoadCompCall, i))
        else
            SystemSettingNet:GetPlayerInfo(
                    { uid = self.CurRankData.listRankDatas[i].playData.uid },
                    handlerbind(self, self.LoadCompCall, i))
        end
    end
    self.Init_LoadTopInfos = true
end

function ArchaeologyRankView:LoadCompCall(msg, index)
    if self:IsNil() then
        return
    end
    if not msg.info then
        return
    end
    self.RoleInfos[index] = msg.info
    self.TopPlayLoadAsCount = self.TopPlayLoadAsCount - 1
    if self.TopPlayLoadAsCount == 0 and self.Init_LoadTopInfos then
        --加载完成
        self:RefreshTopPlay()
    end
end

