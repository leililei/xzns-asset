function ArchaeologyRankView:LoadRankView(callbask)
    if self.LoadRankViewDict[self.CurSelectRankType] then
        if callbask then
            callbask()
        end
        return
    end
    local curPanel = self.CurRankData:GetPanelPath()
    local parent = self.go_table.obj_view
    _G.PoolsManager:GetInstance():Spawn(
        curPanel,
        ePoolType.UIItem,
        parent,
        function(obj)
            if self:IsNil() then
                DestroyObject(obj)
                return
            end

            obj:SetActiveE(1)
            self.LoadRankViewDict[self.CurSelectRankType] = require(self.rankDatas[self.CurSelectRankType]:GetViewLuaName()).New(obj, self)
            self.personalPointsRankView = self.LoadRankViewDict[self.CurSelectRankType]
            self.personalPointsRankView:InitData(self.CurSelectRankType)
            if callbask then
                callbask()
            end
        end)
end

function ArchaeologyRankView:InitUI()

    for i = 1, 3 do
        ---@type RankTopRoleItem[]
        self.RankShowNode[i] = RankTopRoleItem.New(self.go_table["obj_info" .. i], self)
    end

    self:LoadRankView(function()
        if self.DataRequestComp then
            self:RefreshUI()
        end
    end)
    self:GeneTagBtn()

    local endTime = self.CurRankData:GetEndTimestamp()
    if endTime then
        local time = _G.TimeUtil.GetServerUnixTime()
        self.RTS = endTime - time
        self:UpdateTimeShow(true)
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimeShow, self, false, false, true, false)
        self.timer:Start()
        self.go_table.obj_CountdownTimeNode:SetActiveE(1)
    else
        self.go_table.obj_CountdownTimeNode:SetActiveE(0)
    end

    local resources = self.resources
    if resources and #resources > 0 then
        self:AddComponent(
            self.go_table.obj_GoldInfo,
            require("ResourceCompont").New(self.go_table.obj_GoldInfo, resources)
        )
    end
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function ArchaeologyRankView:UpdateTimeShow(show, elapsed)
    if not show then
        self.RTS = self.RTS - elapsed
    end
    self.go_table.aortext_CountdownTime.text = TimeUtil.TimeToString(Mathf.RoundToInt(self.RTS), 1)
    if self.RTS <= 0 then
        if self.timer then
            self.timer:Stop()
            self.timer = nil
        end
        --self:Close()
    end
end

function ArchaeologyRankView:RefreshUI()
    self:RefreshTagSequence()
    self:RefreshTagBtn()

    if self.personalPointsRankView then
        if self.CurSelectRankType == 98 then
            self.personalPointsRankView:RefreshData(self.CurSelectRankType, self.CurRankData)
        else
            self.personalPointsRankView:RefreshData(self.CurSelectRankType)
        end
        self.personalPointsRankView:RefreshUI()
    end

    for rankType, view in pairs(self.LoadRankViewDict) do
        view.go_table.gameObject:SetActiveE(rankType == self.CurSelectRankType and 1 or 0)
    end
    self.go_table.aorimage_tip.SpriteName = self.CurRankData:GetTipSpriteName()
    self.go_table.aorimage_tip:SetNativeSize()
    self:RefreshTopPlay()
end

function ArchaeologyRankView:RefreshTopPlay()
    if self.CurRankData.listRankDatas == nil or self.CurRankData.listRankDatas[1] == nil then
        self.Init_LoadTopInfos = false
    end
    if self.TopPlayLoadAsCount == 0 and self.Init_LoadTopInfos then
        self:ClearAllRoleModel()
        self:UpdateTopInfos()
        for i = 1, 3 do
            local playerInfo = self.RoleInfos[i]
            if playerInfo and playerInfo then
                local cfg = require "CardCommentManager":GetInstance():CardData(playerInfo.city_style_id, false)
                local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
                self:LoadRoleModel(path, i, _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) and cfg.size2 or cfg.size4,playerInfo)
            end
        end
        return
    elseif self.Init_LoadTopInfos == false and #self.CurRankData.listRankDatas <= 0 then
        self:ClearAllRoleModel()
        self:UpdateTopInfos()
    end
end

