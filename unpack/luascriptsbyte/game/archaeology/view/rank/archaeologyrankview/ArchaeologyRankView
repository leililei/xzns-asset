function ArchaeologyRankView:RefreshData()
    self.CurRankData = self.model:GetRankData(self.CurSelectRankType)
    if self.CurRankData == nil or #self.CurRankData.listRankDatas == 0 then
        self.DataRequestComp = false
        if self.CurSelectRankType == 98 then
            require("ActivityDispatchModel"):GetInstance():GetMemberInfo(function(msg)
                self.DataRequestComp = true
                self.CurRankData = RankUtils.NewRankDataBase(98, msg)
                if self.personalPointsRankView then
                    self:RefreshUI()
                    self:LoadTopInfos()
                end
            end)
        elseif self.CurSelectRankType == RankUtils.RankType.AncientGodPersonalPoints or self.CurSelectRankType == RankUtils.RankType.AncientGodAllianceTeam then
            self.model:GetListInfoByPage(self.CurSelectRankType, 
                function()
                    self.DataRequestComp = true
                    self.CurRankData = self.model:GetRankData(self.CurSelectRankType)
                    if self.CurSelectRankType == 100 then 
                        for k, v in ipairs(self.CurRankData.listRankDatas or {}) do 
                            v.t_name =  string.format("%s%s", v.t_name, _G.GetLangPackValue(90033500235))
                        end
                        if self.CurRankData.serverData and self.CurRankData.serverData.ranks then 
                            for k, v in ipairs(self.CurRankData.serverData.ranks or {}) do 
                                v.t_name =  string.format("%s%s", v.t_name, _G.GetLangPackValue(90033500235))
                            end
                        end
                    end
                    if self.personalPointsRankView then
                        self:RefreshUI()
                    end
                    if self.CurSelectRankType ~= 97 then
                        self:LoadTopInfos()
                    end
                end,
                2
            )
        else
            self.model:GetListInfo(self.CurSelectRankType, function()
                self.DataRequestComp = true
                self.CurRankData = self.model:GetRankData(self.CurSelectRankType)
                if self.personalPointsRankView then
                    self:RefreshUI()
                end
                if self.CurSelectRankType ~= 97 then
                    self:LoadTopInfos()
                end
            end)
        end
    else
        self.DataRequestComp = true
        self:RefreshUI()
        if self.CurSelectRankType ~= 97 then
            self:LoadTopInfos()
        end
    end
    --require("ArenaNet"):GetInstance():GetRankListFair(0, 100, _G.handler(self, self.ParseRankList))
end

