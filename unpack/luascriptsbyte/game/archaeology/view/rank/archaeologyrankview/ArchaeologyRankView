---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function ArchaeologyRankView:LoadRoleModel(rolepath, posIndex, scale,data)
    ---@type RecordRankListView._obj_info1_GoTable
    local info = self.RankShowNode[posIndex].go_table
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                end
                return
            end
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(info.trans_role)
            trans:SetLocalPosition(0, 0, 0)
            trans:SetLocalScaleXYZ(scale)
            self.roleTrans[posIndex] = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            -- self:UpdateHalo(posIndex, rolePoint)
            -- self:UpdateTitle(posIndex, rolePoint)
            if _G.AppSetting.IsXzns then
                local godHaloID = data.god_halo
                if godHaloID ~= 0 then
                    local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                    --- 神环路径，父级路径(加载角色的下面)
                    _G.UIUtils.LoadGodHalo(effCfg, trans,godHaloID)
                end
                if not table.isEmptyOrNil(data.artifact_skin) then
                    _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
                end
            end
        end
    )
end

function ArchaeologyRankView:ClearAllRoleModel()
    for i = 1, 3 do
        --回收角色模型
        ---@type RecordRankListView._obj_info1_GoTable
        local temp = self.RankShowNode[i].go_table
        local tempCount = temp.trans_role:GetChildCountE()
        if tempCount > 0 then
            _G.PoolsManager:GetInstance():Despawn(temp.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
    end
end

function ArchaeologyRankView:GeneTagBtn()
    self.TagIsLoadComp = false
    self.AsCount = 0
    self.AssAsCountComp = false

    local tagBtnPath = ""
    local count = #self.rankDatas
    for i, data in pairs(self.rankDatas) do
        self.AsCount = self.AsCount + 1
        tagBtnPath = data:GetTagBtnPath()
        _G.PoolsManager:GetInstance():Spawn(
            tagBtnPath,
            ePoolType.UIItem,
            self.go_table.obj_handoverNode,
            handlerbind(self, self.onLoadTagBtnComp, data)
        )
    end
    self.go_table.obj_handoverNode:SetActiveE(self.hideNode and 0 or 1)
    self.AssAsCountComp = true
end

---@param data ArchaeoIntegralRankData
function ArchaeologyRankView:onLoadTagBtnComp(obj, _, data)
    if self.go_table == nil then
        DestroyObject(obj)
        return
    end
    local tagBtnName = data:GetTagBtnName()
    self.BtnNodeList[data.rankType] = GetAutoGoTable(obj,
        handlerbind(self, self.SetRankTag, data.rankType))
    self.BtnNodeList[data.rankType].aortext_rankName.text = tagBtnName
    self.BtnNodeList[data.rankType].aortext_rankNameS.text = tagBtnName
    self.BtnNodeList[data.rankType].transform:SetName(data.rankType)
    self.AsCount = self.AsCount - 1
    if self.AsCount == 0 and self.AssAsCountComp then
        self.TagIsLoadComp = true
        self:RefreshTagSequence()
        self:RefreshTagBtn()
    end
end

function ArchaeologyRankView:RefreshTagBtn()
    for type, item in pairs(self.BtnNodeList) do
        item.obj_selectNode:SetActiveE(type == self.CurSelectRankType and 1 or 0)
        item.obj_normalNode:SetActiveE(type == self.CurSelectRankType and 0 or 1)
    end
end

function ArchaeologyRankView:RefreshTagSequence()
    if self.isSetTagSequence then
        return
    end

    local count = #self.SortingType
    for i = 1, count do
        local tagBtn = self.BtnNodeList[self.SortingType[i]]
        if tagBtn == nil then
            return
        end
        tagBtn.transform:SetSiblingIndexE(i)
    end
    self.isSetTagSequence = true
end

