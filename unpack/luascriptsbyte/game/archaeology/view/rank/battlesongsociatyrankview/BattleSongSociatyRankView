local ArchaeologySociatyRankItem = require("ArchaeologySociatyRankItem")
---@class BattleSongSociatyRankView : UIBaseView    中文描述
---@field public go_table BattleSongSociatyRankView_GoTable GoTable
local BattleSongSociatyRankView = _G.BaseClass("BattleSongSociatyRankView")

function BattleSongSociatyRankView:__init(obj, view)
    ---@type ArchaeologyRankView
    self.view = view
    self.gameObject = obj
    ---@type PersonalPointsRankView_GoTable
    self.go_table = GetAutoGoTable(obj, self.onlick)

    ---@type ArchaeologyRankItem[]
    self.itemList = {}
    self.go_table.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshItem))
    ---@type ArchaeologyRankItem
    self.myRankItem = ArchaeologySociatyRankItem.New(self.go_table.obj_selfRank)
end

function BattleSongSociatyRankView:InitData(CurSelectRankType)
    self.model = require("RecordRankModel"):GetInstance()

    self.curRankType = CurSelectRankType

    ---@type table<RankUtils.RankType, ArchaeoIntegralRankData>
    self.CurRankDataList = {}
end

function BattleSongSociatyRankView:RefreshData(CurSelectRankType)
    self.curRankType = CurSelectRankType
    ---@type ArchaeoIntegralRankData|BattleSongRankData
    self.CurRankData = self.model:GetRankData(self.curRankType)
    self.isShowMyRankNode = self.CurRankData:IsShowPlayInfo()
end

function BattleSongSociatyRankView:SetTag(item, _, rankType)
    self.curRankType = rankType
    self.view:SetRankTag(rankType)
end

function BattleSongSociatyRankView:RefreshUI()
    if self.CurRankData ~= nil and #self.CurRankData.listRankDatas > 0 then
        local count = #self.CurRankData.listRankDatas
        self.go_table.scrollloopvectical_rankList:UpdateCount(count)
        self.go_table.scrollloopvectical_rankList:UpdateAllItem()
    end

    if self.isShowMyRankNode then
        self.go_table.obj_selfRoot:SetActiveE(1)
        self:RefreshMyRank()
        -- left,bottpm,right,top
        self.go_table.rect_loopNode:SetRectTransformOffset(2, 296, 2, -557)
    else
        self.go_table.obj_selfRoot:SetActiveE(0)
        self.go_table.rect_loopNode:SetRectTransformOffset(2, 213, 2, -557)
    end

    self.go_table.aortext_rankTitle2.text = _G.GetLangPackValue(self.CurRankData:GetRankTitle2Tip())
    self.go_table.aortext_rankTitle3.text = _G.GetLangPackValue(self.CurRankData:GetRankTitle3Tip())

    self:ShowTop()
end

---@param listview2 SuperScrollView.LoopListView2
function BattleSongSociatyRankView:RefreshItem(index, obj)
    local newIndex = index + 1
    ---@type ArchaeoIntegralRankData.RankData
    local data = {}
    local isEmpty = false
    if self.CurRankData.listRankDatas[newIndex] == nil then
        isEmpty = true
    else
        data = self.CurRankData.listRankDatas[newIndex]
    end
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = ArchaeologySociatyRankItem.New(obj)
        self.itemList[id] = item
    end
    item:RefreshItem(data, newIndex, self.CurRankData, isEmpty)
end

function BattleSongSociatyRankView:RefreshMyRank()
    local userData = require "SociatyModel":GetInstance().SociatySelf
    local myData = self.CurRankData:GetMyRank()
    self.myRankItem:Refresh_MyRank(userData, myData, self.CurRankData:GetMyIntegral(), self.CurRankData)
    --自己的队伍名字需要等功能完成之后才能在对应的model里面取
    self.myRankItem.go_table.aortext_name.text = self.CurRankData:GetItemShowName()
end

function BattleSongSociatyRankView:ShowTop()
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_rank" .. i])
        if self.CurRankData.listRankDatas[i] then
            local data = self.CurRankData.listRankDatas[i]
            item.aorrawimage_SociatyIcon:LoadImage(_G.ConfigManager.guild_portrait_cfg[data.banner].portrait)
            item.aortext_name.text = data.name
            item.aortext_active.text = data.seven_day_live or 0
            item.obj_have:SetActiveE(1)
            item.aortext_nil:SetActiveE(0)
        else
            item.obj_have:SetActiveE(0)
            item.aortext_nil:SetActiveE(1)
        end
    end
end

function BattleSongSociatyRankView:onlick(go)

end

return BattleSongSociatyRankView