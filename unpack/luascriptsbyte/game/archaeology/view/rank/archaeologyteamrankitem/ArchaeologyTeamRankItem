local RankUtils = require("RankUtils")

---@class ArchaeologyTeamRankItem
---@field view AllianceRankView
local ArchaeologyTeamRankItem = _G.BaseClass("ArchaeologyTeamRankItem")


function ArchaeologyTeamRankItem:__init(obj,view)
    self.view=view
    ---@type PersonalPointsRankView._obj_rankItem_GoTable|PersonalPointsRankView._obj_selfRank_GoTable
    self.go_table = GetAutoGoTable(obj,_G.handler(self,self.onlick))

    ---@type _obj_SpecialRankNode_GoTable
    self.SpecialRankNode = GetAutoGoTable(self.go_table.obj_SpecialRankNode)
end

---@param data AllianceTribesRankData.RankData
---@param rankData ArchaeoIntegralRankData
---@param isEmpty boolean
function ArchaeologyTeamRankItem:RefreshItem(data,index,rankData,isEmpty)
    self.data = {}
    self.data = data
    local rank = data.rank or index
    RankUtils.SetRankItemBgIcon(self.go_table.aorimage_bg,index)
    if rank <= 3 then
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.obj_SpecialRankNode:SetActiveE(1)
        RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
    else
        self.go_table.aortext_rank:SetActiveE(1)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.aortext_rank.text = rank
    end
    if isEmpty then
        self.go_table.obj_content:SetActiveE(0)
        self.go_table.obj_noBody:SetActiveE(1)
        return
    end
    self.go_table.obj_content:SetActiveE(1)
    self.go_table.obj_noBody:SetActiveE(0)

    self:RefreshDescIcon(rankData)
    self.go_table.aortext_desc.text = data.gem
    --self.go_table.aortext_name.text = data.playData.name or "???"
    self.go_table.aortext_name.text = _G.GetLangPackValue(90033500125, rankData:GetItemShowName(rank))
    local uid = data.playData[1].playData.uid
    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        _G.UIUtils.SetPlayerHeadItemNew(
                self.go_table.obj_head,
                _G.PlayerModel:GetInstance():GetIRroleTable(),
                1,
                true,
                true,
                true
        )
    else
        _G.UIUtils.SetPlayerHeadItemNew(self.go_table.obj_head,
                RankUtils.i_record_rankToi_role(data.playData[1].playData)
        , 1, true, true, true)
    end
    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

---@param data rank.i_record_rank
---@param rank number
---@param value number 积分值
---@param rankData ArchaeoIntegralRankData
function ArchaeologyTeamRankItem:Refresh_MyRank(data,rank,value,rankData)
    self.data=rankData:GetMyTeam()
    _G.UIUtils.SetPlayerHeadItemNew(
            self.go_table.obj_head,
            data,
            1,
            true,
            true,
            true
    )
    if rank == nil then
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.obj_noRank:SetActiveE(1)
    else
        self.go_table.obj_noRank:SetActiveE(0)
        if rank <= 3 then
            self.go_table.aortext_rank:SetActiveE(0)
            self.go_table.obj_SpecialRankNode:SetActiveE(1)
            RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
        else
            self.go_table.aortext_rank:SetActiveE(1)
            self.go_table.obj_SpecialRankNode:SetActiveE(0)
            self.go_table.aortext_rank.text = rank
        end
    end

    self:RefreshDescIcon(rankData)
    self.go_table.aortext_desc.text = value
    self.go_table.aortext_name.text = data.name and _G.GetLangPackValue(90033500125, data.name) or "???"

    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

function ArchaeologyTeamRankItem:RefreshDescIcon(rankData)
    if rankData and rankData.TopDescIcon and rankData:TopDescIcon() ~= "" then
        self.go_table.aorrawimage_desc:SetActiveE(1)
        self.go_table.aorrawimage_desc:LoadImage(rankData:TopDescIcon())
        local layoutGroup = self.go_table.obj_autoDescNode:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
        layoutGroup.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleLeft
    else
        self.go_table.aorrawimage_desc:SetActiveE(0)
        local layoutGroup = self.go_table.obj_autoDescNode:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
        layoutGroup.childAlignment = _G.CS.UnityEngine.TextAnchor.MiddleCenter
    end
end

function ArchaeologyTeamRankItem:onlick(go)
    if go==self.go_table.aorbtn_bg then
        self.view:ShowTeam(self.data)
    end
end


