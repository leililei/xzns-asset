local RankTopRoleItem = _G.BaseClass("RankTopRoleItem")

---__init构造函数
---@protect
function RankTopRoleItem:__init(cardRoot,view)
    self.root = cardRoot
    ---@type ArchaeologyRankView
    self.view = view
    self.go_table = GetAutoGoTable(self.root, handler(self, self.OnLinkClickBtn))
    self.go_table.obj_link:SetActiveE(0)

    self.model = require("RecordRankModel"):GetInstance()
end

