            tb.aortext_name.text =  _G.GetLangPackValue(90033500125, self.roleData.name or self.roleData.name.t_name)
        else
            tb.aortext_name.text =  self.roleData.name or self.roleData.name.t_name
        end
        local desc = ""
        if rankDataBase.TopDescIcon and rankDataBase:TopDescIcon() ~= "" then
            desc = rankData.value or rankData.gem
            tb.aorrawimage_desc:SetActiveE(1)
            tb.aorrawimage_desc:LoadImage(rankDataBase:TopDescIcon())
        else
            tb.aorrawimage_desc:SetActiveE(0)
            desc = rankDataBase:GetProgressDescription(self.rankId, rankData.value or rankData.gem, true)
        end
        tb.aortext_desc.text = desc
        GameUtil.ReBuildRTF(self.go_table.obj_autoNode)
        --点赞状态
        --local uid = rankData.playData.uid
        --local isLinked = self.model:IsLinked(rankId, uid)
        --local point = rankData.playData.point + self.model:GetLinkPlayerCount(uid)
        --if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
        --    point = _G.PlayerModel:GetInstance():GetPoint()
        --end
        --tb.obj_link:SetActiveE(self.rankId ~= 10 and 1 or 0)
        --tb.aortext_linkNum.text = tostring(point)
        --tb.aorbtn_link:SetActiveE(isLinked and 0 or 1)
        --tb.obj_linked:SetActiveE(isLinked and 1 or 0)
        --tb.obj_redpoint:SetActiveE((isLinked or not self.model:HasLinkAward()) and 0 or 1)
        if rankData.playData.title then
            self:UpdateTop3Title(tb, rankData.playData.title)
        elseif  rankData.playData[1].playData.title then
            self:UpdateTop3Title(tb, rankData.playData[1].playData.title)
        end
    else
        tb.aorrawimage_norole:SetActiveE(1)
        tb.obj_titleEffect:RemoveAllChildren()
