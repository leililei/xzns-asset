---处理点赞事件
---@param item {rank:number, data:RecordRankData, aorbtn_playerInfo:AorButton, aorbtn_link:AorButton}
function RankTopRoleItem:OnLinkClickBtn(go)
    if not self.roleData then
        return
    end

    if go == self.go_table.aorbtn_link then
        local playerUid = self.rankData.playData.uid
        ---检查能否点赞
        local ok, tipId = self.model:CanLink(self.rankId, playerUid)
        if not ok then
            if tipId and tipId > 0 then
                _G.PopWindowManager:GetInstance():ShowAllTips(tipId)
            end
            return
        end
        ---执行点赞请求
        self.model:DoLink(
                self.rankId,
                playerUid,
                function(msg)
                    --刷新节点状态
                    self.view:LoadTopInfos()
                    --如果是自己
                    if playerUid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                        self.view:RankMyRankUI()
                    end

                    --如果有奖励信息
                    if msg and msg.award then
                        require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
                                _G.ConfigManager.redpoint_cfg.RecordRankLink.id
                        )
                        _G.UIUtils.ShowCommonAward(msg)
                        if AppSetting.IsXzns then
                            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                    _G.ConfigManager.redpoint_cfg.RecordRankChallenge.id
                            )
                            require "RedPointManager":GetInstance():RefreshNodeByAllParams(
                                    _G.ConfigManager.redpoint_cfg.RecordRankDevelop.id
                            )
                        end
                    end
                end
        )
    elseif go == self.go_table.aorbtn_playerInfo and self.rankData.playData.uid then
        _G.SystemSettingManager:GetInstance():OpenView(self.rankData.playData.uid)
    end
end


---@return RankTopRoleItem
return RankTopRoleItem