function GMArenaPeakRankItem:Refresh_MyRank(data,rank,value,rankData)
    _G.UIUtils.SetPlayerHeadItemNew(
            self.go_table.obj_head,
            data,
            1,
            true,
            true,
            true
    )
    if rank == nil then
        self.go_table.aortext_rank:SetActiveE(0)
        self.go_table.obj_SpecialRankNode:SetActiveE(0)
        self.go_table.obj_noRank:SetActiveE(1)
    else
        self.go_table.obj_noRank:SetActiveE(0)
        if rank <= 3 then
            self.go_table.aortext_rank:SetActiveE(0)
            self.go_table.obj_SpecialRankNode:SetActiveE(1)
            RankUtils.SetObj_SpecialRankNode(self.SpecialRankNode,rank)
        else
            self.go_table.aortext_rank:SetActiveE(1)
            self.go_table.obj_SpecialRankNode:SetActiveE(0)
            self.go_table.aortext_rank.text = rank
        end
    end
    self:RefreshDescIcon(rankData)
    local GMArenaPeakModel = require "GMArenaPeakModel":GetInstance()
    local cfg = GMArenaPeakModel:GetDanCfgByScoreAndKing(value, GMArenaPeakModel:CheckKingCondition(rank, value))
    self.go_table.aorrawimage_rankIcon:LoadImage(
        cfg.icon,
        function(item)
            if self.go_table == nil then
                _G.GameObject.Destroy(item.gameObject)
                return
            end
        end
    )
    self.go_table.aortext_desc.text = value
    self.go_table.aortext_name.text = data.name or "???"
    self.go_table.aortext_dan.text = cfg and _G.GetLangPackValue(cfg.name) or "" 

    GameUtil.ReBuildRTF(self.go_table.aortext_desc)
    GameUtil.ReBuildRTF(self.go_table.obj_autoDescNode)
end

