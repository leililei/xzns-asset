local base = require "BaseItemData"
---@class PropData:BaseItemData    道具类
---@param maxCount number 最大物品
---@param args BasePropDataArgs 特殊参数
local PropData = _G.BaseClass("PropData", base)

_G.PropData = PropData

function PropData:__init()
end
---类的析构函数
function PropData:Dispose()
end

--region 子类重写
---物品数据解析(类重写数据解析)
---@param msg prop.NormalProp 物品PB数据
function PropData:ParseInitMsg(msg)
    self.sid = msg.sid
    self.count = msg.num or msg.count
    self.args = msg.args
    local StorageItemData = _G.StorageManager:GetInstance():GetStorageItemData(self.sid)
    if StorageItemData ~= nil then
        self.cfg = StorageItemData.Cfg
        self.Icon = StorageItemData.Icon
        self.Grade = StorageItemData.Grade
        ---最大上限 9223372036854775807 unit64
        self.maxCount = self.cfg.MaxCount or 9223372036854775807
        ---是否可以一键开启
        self.clickon = self.cfg.clickon == 1
        ---是否可以一键合成
        self.clickcompositing = self.cfg.clickcompositing == 1

        if self.cfg.UseType == _G.ItemUseType.ProgressChest then
            ---进度宝箱类型
            -- 镇魂街ZHJ-11107 五月功能优化任务ZHJ-12662
            -- 【客户端】进度奖励类道具界面需求

            ---领取进度 服务器发的数量就是领取进度 0一个都没领取
            self.progress = self.count

            ---数量只会为1 多余的获得服务器会忽略
            self.count = 1
        elseif self.cfg.UseType == _G.ItemUseType.RechargeAccumulate then
            ---累计金额
            self.progress = self.count
            ---数量只会为1 多余的获得服务器会忽略
            self.count = 1
        end

        self.Count = self.count

        if self.cfg.UseType == _G.ItemUseType.RechargeAccumulate and self.args then
            require("RechargeAccumulateModel"):GetInstance():AddItem(self)
        end
        if self.cfg.UseType == _G.ItemUseType.VoucherDiscount and self.args then
            require("VoucherDiscountModel"):GetInstance():AddItem(self)
        end
    end
end

---@class ProgressChestArgs:BasePropDataArgs    进度宝箱类型参数
---@field time number 获取的时间

---@return ProgressChestArgs
function PropData:GetProgressChestArgs()
    return self.args
end

---获取可领取的天数，无可领取则为nil
function PropData:GetProgressChestSelectNum()
    if self.cfg.UseType ~= _G.ItemUseType.ProgressChest then
        return
    end
    local boxId = _G.tonumber(self.cfg.UseParameter[1][1])
    ---@type item_box_con_cfg
    local boxConCfg = _G.ConfigManager.item_box_con_cfg[boxId]

    ---可领取索引 1->  nil不能领取
    local curSelectNum = nil
    local ispass
    for i, v in pairs(boxConCfg.rewards) do
        local condition_params = boxConCfg.condition_params[i]
        if condition_params ~= nil then
            if boxConCfg.condition_type == 0 then
                ispass = _G.GlobalConditionManager.CheckCondition(
                    _G.GlobalConditionManager.ConditionType.createRoleDay,
                    condition_params,
                    self:GetProgressChestArgs().time
                )
            else
                ispass = _G.GlobalConditionManager.CheckCondition(boxConCfg.condition_type, condition_params)
            end
            if ispass then
                curSelectNum = i
            else
                break
            end
        end
    end

    if curSelectNum and curSelectNum <= self.progress then
        curSelectNum = nil
    end
    return curSelectNum
end

function PropData:GetGrade()
    return self.Grade
end

function PropData:GetCashCfg()
    if not self.cashCfg then
        self.cashCfg = _G.ConfigManager.item_accumulate_cfg[_G.tonumber(self.cfg.UseParameter[1][1])]
    end
    return self.cashCfg
end

function PropData:GetRechargeAccMaxProgress()
    if not self.maxProgress then
        local cashCfg = self:GetCashCfg()
        local gearCfg = _G.ConfigManager.store_gear_cfg[cashCfg.price_max_id]
        self.maxProgress = _G.Mathf.Floor(gearCfg.price * 10000 / cashCfg.ratio_recharge)
    end
    return self.maxProgress
end

function PropData:GetRechargeAccEndTime()
    if not self.endTime then
        if self.args then
            local cashCfg = self:GetCashCfg()
            self.endTime = cashCfg.duration * 86400 + self.args.time
        else
            self.endTime = 0 --容错
        end
    end
    return self.endTime
end
--endregion

---@class BasePropDataArgs 物品参数基类
---
return PropData
