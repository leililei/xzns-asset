local base = require "ResourcesStorage"
local PropData = require "PropData"
---@class MaterialStorage:BaseStorage	道具仓库
local MaterialStorage = _G.BaseClass("MaterialStorage", base)

---仓库数据解析(类重写数据解析)
---@param msg storage.MaterialStorage 物品PB数据
function MaterialStorage:ParseInit(msg)
    self:ParseInitData(msg.materials)
end

---重连进来
function MaterialStorage:ParseReconnectInit(msg)
    self:ParseReconnectInitData(msg.materials)
end
---解析单条奖励
---@param data MaterialStorage 材料数据
function MaterialStorage:ParseSingle(data)
    local sid = data.sid
    local material = self.list[sid]
    if not material then ---新增
        self:AddItemByData(sid, data.factNum)
    else ---数量变动
        self:ChangeCount(sid, data.factNum, true)
    end
end
---新增物品
---@param ... any 动态参数
---@return number 返回添加的对象ID(0 为失败)
function MaterialStorage:AddItem(sid, num)
    local material = PropData.New()
    material:Parse({sid = sid, num = num})
    return sid, material
end
---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function MaterialStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
    ---刷新下共鸣神石的 红点 2 是默认解锁
    -- require("CardGuangMingShenShiManager"):GetInstance():RedPointStoneRefresh(add, rem, change)
    require("CardHunLianManger"):GetInstance():RedPointRefreshHunLianStorage(add, rem, change)
    ---刷新合击技
    for _, v in pairs(add) do
        if v == 202010211 then
            require("CombineModel"):GetInstance():RefreshRedPoint({_G.ActiveTaskEnum.ConditionEnum.GetHero})
        end
    end
end

return MaterialStorage
