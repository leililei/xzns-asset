local base = require "ResourcesStorage"
local PropData = require "PropData"
---@class RemainsStorage:BaseStorage	道具仓库
local RemainsStorage = _G.BaseClass("RemainsStorage", base)

---仓库数据解析(类重写数据解析)
---@param msg storage.RemainsStorage 物品PB数据
function RemainsStorage:ParseInit(msg)
    self:ParseInitData(msg.remains_fragment)
end

---重连进来
function RemainsStorage:ParseReconnectInit(msg)
    self:ParseReconnectInitData(msg.remains_fragment)
end
---解析单条奖励
---@param data RemainsStorage 材料数据
function RemainsStorage:ParseSingle(data)
    local sid = data.sid
    local prop = self.list[sid]

    if _G.StorageManager:GetInstance():IsUnloclItem(sid) then
        if prop then
            self:ChangeCount(sid, 0, true)
            ---原本有 则全用了
        end
        _G.StorageManager:GetInstance():UsePropToServer(sid, data.factNum)
        return
    end

    if not prop then ---新增
        self:AddItemByData(sid, data.factNum, data.args)
    else ---数量变动
        self:ChangeCount(sid, data.factNum, true)
    end
end
---新增物品
---@param ... any 动态参数
---@return number 返回添加的对象ID(0 为失败)
function RemainsStorage:AddItem(sid, num, args)
    local prop = PropData.New()
    prop:Parse({
        sid = sid,
        num = num,
        args = args
    })
    prop.isNew = true
    return sid, prop
end
---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function RemainsStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
end

return RemainsStorage
