local base = require "ResourcesStorage"
local PropData = require "PropData"
---@class PropStorage:BaseStorage    道具仓库
local PropStorage = _G.BaseClass("PropStorage", base)

--region 子类重写
---仓库数据解析(类重写数据解析)
---@param msg storage.PropStorage 物品PB数据
function PropStorage:ParseInit(msg)
    self:ParseInitData(msg.item)

    ---进度宝箱 算道具 进道具仓库 进度宝箱[Sid,数量]  数量就是当前领取进度
    self:ParseInitDataTimeBox(msg.item_box)
    ---充值返利卡
    self:ParseInitDataCashCard(msg.cash_card)
    ---代金券折扣卡
    self:ParseInitDataVoucherDiscount(msg.v_discount)
end

--region 内部方法
function PropStorage:ParseInitDataTimeBox(data)
    if data ~= nil then
        for _, value in pairs(data) do
            self:AddItemByData(value.sid, value.num, { time = value.time })
        end
    end
end

--region 内部方法
function PropStorage:ParseInitDataCashCard(data)
    if data ~= nil then
        local success, item
        for _, value in pairs(data) do
            self:AddItemByData(value.sid, value.value, { time = value.start_time })
        end
    end
end

--region 内部方法
function PropStorage:ParseInitDataVoucherDiscount(data)
    if data ~= nil then
        for _, value in pairs(data) do
            self:AddItemByData(value.sid, 1, { time = value.out_time })
        end
    end
end

---重连进来
function PropStorage:ParseReconnectInit(msg)
    self:ParseReconnectInitData(msg.item)

    --self:ParseReconnectInitData(msg.item_box)
end
---解析单条奖励
---@param data PropAwardSimple 道具数据
function PropStorage:ParseSingle(data)
    local sid = data.sid

    local prop = self.list[sid]

    if _G.StorageManager:GetInstance():IsUnloclItem(sid) then
        if prop then
            if prop.cfg.Type1 == 23 then
                require("VoucherDiscountModel"):GetInstance():AddItem(prop)
            else
                self:ChangeCount(sid, 0, true)
            end
            ---原本有 则全用了
        end
        _G.StorageManager:GetInstance():UsePropToServer(sid, data.factNum)
        return
    end

    if not prop then
        ---新增
        self:AddItemByData(sid, data.factNum, data.args)
    else
        ---数量变动
        if prop.cfg.Type1 == 23 then
            local item = self:GetItemByKey(sid)
            item.args = data.args
            require("VoucherDiscountModel"):GetInstance():AddItem(prop)
        else
            self:ChangeCount(sid, data.factNum, true)
        end
    end
end
---新增物品
---@param sid number id
---@param num number 数量
---@param args BasePropDataArgs
---@return number 返回添加的对象ID(0 为失败)
function PropStorage:AddItem(sid, num, args)
    local prop = PropData.New()
    prop:Parse({ sid = sid, num = num, args = args })
    prop.isNew = true
    return sid, prop
end
---道具使用
function PropStorage:OnUseProp(data)
    self:ChangeCount(data.sid, -data.num)
end
---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function PropStorage:RefreshRedPoint(add, rem, change)
    local redpointManager = require("RedPointManager"):GetInstance()
    local cfg = _G.ConfigManager.redpoint_cfg
    if not _G.table.isEmptyOrNil(add) then
        for uid, sid in pairs(add) do
            redpointManager:AddRedPointParam(cfg.BackpackItem.id, uid)
            self:zhaomuNum(uid)
        end
        require("PetModel"):GetInstance():CheckCompsePetRedPoint(add)
    end
    if not _G.table.isEmptyOrNil(rem) then
        for uid, sid in pairs(rem) do
            redpointManager:RemoveRedPointParam(cfg.BackpackItem.id, uid)
            self:zhaomuNum(uid)
        end
    end
    if not _G.table.isEmptyOrNil(change) then
        for uid, sid in pairs(change) do
            redpointManager:RefreshNode(cfg.BackpackItem.id, uid)
            self:zhaomuNum(sid)
        end
    end
    redpointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Playtreeprofessional.id)
    -- redpointManager:RefreshNode(cfg.ArenaBattleButton.id)
    -- redpointManager:RefreshNode(cfg.ArenaBattleButton.id)
end
---招募红点数据更新
function PropStorage:zhaomuNum(uid)
    if uid == 203020100 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.NomalDraw.id, uid)
    elseif uid == 203020200 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawButton.id, uid)
    elseif uid == _G.ResPropID.Friendship then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FriendDraw.id, uid)
    elseif uid == 203020300 then
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.GodDraw.id, uid)
    end
end

--endregion
return PropStorage
