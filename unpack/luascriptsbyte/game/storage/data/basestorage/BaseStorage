--region 对外接口
---解析初始化数据
---@param msg table 初始化数据
function BaseStorage:Parse(msg, ReConnect)
    if nil == ReConnect then
        ReConnect = false
    end
    self.isInit = true
    if not ReConnect then
        self:ParseInit(msg)
    else
        self:ParseReconnectInit(msg)
    end
    self.isInit = nil
end
---解析单条奖励数据
---@param data table 奖励数据
---@return BaseItemData 数据对象
function BaseStorage:ParseSimpleAward(data)
    return self:ParseSingle(data)
end
---获得指定Uid或Sid的物品
---@param key string|number 物品Uid或Sid
---@return BaseItemData 道具数据对象
function BaseStorage:GetItemByKey(key)
    return self.list[key]
end
---获取道具数量
---@param id number sid
---@param ... any 其余参数
---@return number 数量
function BaseStorage:GetItemCount(id, ...)
    return self:CalulateItemCount(id, ...)
end
---改变数量
---@param sidoruid number 物品Sid或者uid
---@param num number 数量
---@param fact boolean 是否是实际数量
function BaseStorage:ChangeCount(sidoruid, num, fact)
    local item = self:GetItemByKey(sidoruid)
    if item ~= nil then
        local count = item:GetCount()
        item:ChangeCount(num, fact)
        num = item:GetCount()
        if num == 0 then
            local data = self:GetRedPointFreshData(sidoruid)
            self:RemoveItem(sidoruid)
            if not item.isTemp then
                self:OnRefreshRedPoint(nil, {data})
            end
        else
            if num ~= count then
                if not item.isTemp then
                    self:OnRefreshRedPoint(nil, nil, {self:GetRedPointFreshData(sidoruid)})
                end
            end
        end
    end
end
---检查仓库剩余空间是否足够
---@param num number 指定数量
---@param ... any 额外参数
function BaseStorage:CheckSize(num, ...)
    return self:CheckSizeEnough(num, ...)
end
---获得仓库剩余空间
function BaseStorage:GetFreeSize()
    return self.capacity - #self.idList
end
---获取仓库总容量
---@return number 仓库总容量
function BaseStorage:GetSumCapacity()
    return self.capacity
end
---获取仓库内道具种类数量
---@return 变量类型 中文描述
function BaseStorage:GetKindCount()
    return #self.idList
end
---获取所有的物品id数组
---@return table 物品ID数组
function BaseStorage:GetAllIds()
    if _G.AppSetting.DEBUG then
        return _G.readOnlyEasy(self.idList)
    else
        return self.idList
    end
end
---获取仓库所有道具数据
---@return table 道具组
function BaseStorage:GetAllItems()
    return self.list
end
---添加物品
---@param ... any 动态参数
---@return boolean 是否添加成功
function BaseStorage:AddItemByData(...)
    local id, item = self:AddItem(...)
    if id > 0 then
        self.list[id] = item
        table.insert(self.idList, id)
        if not item.isTemp then
            self:OnRefreshRedPoint({self:GetRedPointFreshData(id)})
        end
    end
    return id > 0, item
end

---新增 装备实体对象 (玩家身上装备 卸下)
---@param Equip EquipmentItem
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function BaseStorage:AddItemByEntity(...)
    local id, item = self:AddItemByEntity(...)
    if id > 0 then
        self.list[id] = item
        table.insert(self.idList, id)
    end
    return id > 0, item
end

---添加临时物品
---@param ... any 动态参数
---@return boolean 是否添加成功
function BaseStorage:AddTempItemByData(...)
    local id, item = self:AddItem(...)
    if id > 0 then
        self.list[id] = item
        table.insert(self.idList, id)
    end
    return id > 0, item
end

---仓库扩容次数增加
---@param times number 扩容次数
function BaseStorage:AddCapacityTimes(times)
    self.capacity_times = self.capacity_times + times
    self.capacity = self.cfg.Capacity + self.capacity_times * self.cfg.extension
end
---获取仓库扩容次数
---@return number 总扩容次数
function BaseStorage:GetSumCapacityTimer()
    return self.capacity_times
end
---使用道具
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
function BaseStorage:UseProp(data)
    self:OnUseProp(data)
end
---当数据改变时调用
---@param uid number 物品UID
---@param type CardChangeType 以什么操作改变
function BaseStorage:ItemDataChanged(uid, type)
    self:OnItemDataChanged(uid, type)
end
--endregion

--region 内部方法
function BaseStorage:RemoveItem(id)
    local item = self.list[id]
    item:Dispose()
    self.list[id] = nil
    for i = 1, #self.idList do
        if id == self.idList[i] then
            table.remove(self.idList, i)
            break
        end
    end
end
