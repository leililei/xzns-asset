---刷新红点
---@param add table 新增id数组
---@param rem table 删除id数组
---@param change table 改变id数组
---@param type CardChangeType 以什么操作改变
function BaseStorage:OnRefreshRedPoint(add, rem, change, type)
    if self.isInit then
        return
    end
    AddTable(self.addTable, add)
    AddTable(self.remTable, rem)
    AddTable(self.changeTable, change)
    self.changeType = type
    if self.freshRedPoint then
        return
    end
    self.freshRedPoint = true
    self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.RefreshRedPointCall, self, true, true):Start()
end
---刷新红点计时回调
function BaseStorage:RefreshRedPointCall()
    -- local keys = table.keys
    -- local add = keys(self.addTable)
    -- local rem = keys(self.remTable)
    -- local change = keys(self.changeTable)
    self:RefreshRedPoint(self.addTable, self.remTable, self.changeTable, self.changeType)
    self.freshRedPoint = nil
    self.addTable = {}
    self.remTable = {}
    self.changeTable = {}
end
