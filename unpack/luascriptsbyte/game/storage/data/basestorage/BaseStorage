---@param num number 需要检测的数量
---@return boolean 是否足够
function BaseStorage:CheckSizeEnough(num, ...)
    return self:GetFreeSize() >= num
end
---使用道具返回
---@param data table 使用后数据
function BaseStorage:OnUseProp(data)
end
---当道具数据改变时调用
---@param uid number 物品UID
---@param type CardChangeType 以什么操作改变
function BaseStorage:OnItemDataChanged(uid, type)
    local item = self:GetItemByKey(uid)
    if not item.isTemp then
        self:OnRefreshRedPoint(nil, nil, {self:GetRedPointFreshData(uid)}, type)
    end
end
function BaseStorage:GetRedPointFreshData(uid)
    return {uid, uid}
end
