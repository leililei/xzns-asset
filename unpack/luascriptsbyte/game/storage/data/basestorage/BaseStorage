---@class BaseStorage	仓库基类
---@field public list table<string|number, BaseItemData> 所有物品
---@field public cfg storage_cfg 配置信息
---@field public capacity number 仓库容量 = 基础配置容量 + f(扩容次数，每次扩格子配置表)
---@field public capacity_times number 扩容次数
---@field public isU boolean 是否唯一物品，用来判断是否可堆叠入库
local BaseStorage = _G.BaseClass("BaseStorage")

local table = _G.table

---构造函数
---@param 变量名 变量类型 中文描述
function BaseStorage:__init(id, capTimes)
    if not id then
        return
    end
    self.list = {}
    self.cfg = _G.ConfigManager.storage_cfg[id]
    self.capacity_times = capTimes or 0
    self.capacity = self.cfg.Capacity + self.capacity_times * self.cfg.extension
    self.isU = false
    self.idList = {}
    self.addTable = {}
    self.remTable = {}
    self.changeTable = {}
    self:Init()
end

---类的析构函数
function BaseStorage:Dispose()
    self.list = nil
    self.cfg = nil
    self.capacity = nil
    self.capacity_times = nil
    self.isU = nil
    self.idList = nil
    self.addTable = nil
    self.remTable = nil
    self.changeTable = nil
end
