local base = require "BaseStorage"
local CarvingData = require "CarvingData"
---@class CarvingStorage:BaseStorage	卡牌仓库
local CarvingStorage = _G.BaseClass("CarvingStorage", base)

function CarvingStorage:Init()
    self.isU = true
end

---仓库数据解析(类重写数据解析)
---@param msg storage.CarvingStorage 物品PB数据
function CarvingStorage:ParseInit(msg)
    local props = msg.carving
    if props ~= nil then
        for _, value in pairs(props) do
            self:AddItemByData(value)
        end
    end
end

---重连进来
function CarvingStorage:ParseReconnectInit(msg)
    local props = msg.carving
    if props ~= nil then
        for _, value in pairs(props) do
            if nil == self:GetItemByKey(value.uid) then
                self:AddItemByData(value)
            end
        end
    end
end

---解析单条奖励
---@param data prop.CarvingData 单条卡牌数据
function CarvingStorage:ParseSingle(data)
    local uid = data[2]
    self:AddItemByData(data)
    return self.list[uid]
end

---新增物品
---@param data table 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function CarvingStorage:AddItem(data)
    ---@type CarvingData
    local carving = CarvingData.New()
    if data.sid then
        carving:Parse(data)
    else
        carving:ParseAward(data)
    end

    return carving.uid, carving
end

---计算道具数量
---@param sid number sid
---@return number 数量
function CarvingStorage:CalulateItemCount(sid)
    return 1
end

function CarvingStorage:GetRedPointFreshData(uid)
    return {uid, self.list[uid].sid}
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function CarvingStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
    require("CardInfoManager"):GetInstance():RedPointRefreshCarvingStorage(add, rem, change)
end

return CarvingStorage
