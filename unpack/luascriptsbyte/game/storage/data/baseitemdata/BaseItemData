---@class BaseItemData	仓库物品基类
---@field public sid number 模板Sid
---@field public uid string 唯一Uid
---@field public count number 数量
---@field public maxCount number 最大数量(需要子类赋值)
---@field public isNew boolean 是否新获得
---@field public isTemp boolean 是否是临时数据
local BaseItemData = _G.BaseClass("BaseItemData")

_G.BaseItemData = BaseItemData
---类的构造函数
function BaseItemData:__init()
    self.cfg = nil
    self.sid = 0
    self.uid = nil
    self.count = 0
    self.maxCount = 0
    self.isNew = false
    self.isTemp = false
end

---类的析构函数
function BaseItemData:Dispose()
    self.cfg = nil
    self.sid = nil
    self.uid = nil
    self.count = nil
    self.maxCount = nil
    self.isNew = nil
    self.isTemp = nil
end

--region 子类重写
---物品数据解析(类重写数据解析)
---@param msg table 数据
function BaseItemData:ParseInitMsg(msg)
    if _G.AppSetting.DEBUG then
        _G.LogWarning("看到此输出代表子类没重写数据解析")
    end
end

---初始化交互数据
function BaseItemData:OnInitMutuallyData()
    --
    if _G.AppSetting.DEBUG then
        _G.Log(self.uid, "111111111111111111111")
    end
end

--endregion

--region 对外接口
---物品数据解析(类重写数据解析)
---@param msg table 数据
function BaseItemData:Parse(msg)
    self:ParseInitMsg(msg)
end

--region 对外接口
---额外数据解析(类重写数据解析)
function BaseItemData:ParseExtend(extend)
end

---初始化交互数据
function BaseItemData:InitMutuallyData()
    self:OnInitMutuallyData()
end

---获取数量
---@return number 数量
function BaseItemData:GetCount()
    return self.count
end

function BaseItemData:GetMaxCount()
    return self.maxCount
end

---获取名称
---@return string 名称
function BaseItemData:GetName()
    return _G.LangUtil.GetLangPackValue(self.cfg.name or self.cfg.Name)
end

---获取描述
---@return string 描述
function BaseItemData:GetDescribe()
    return _G.LangUtil.GetLangPackValue(self.cfg.Describe or self.cfg.describe)
end

---获取图标名
---@return string 图标路径
function BaseItemData:GetIconPath()
    return self.cfg.Icon or self.cfg.icon
end

---更改数量
---@param num number 数量
---@param fact boolean 是否是实际数量
function BaseItemData:ChangeCount(num, fact)
    self.count = fact and num or self.count + num
    if self.count < 0 then
        self.count = 0
    elseif self.maxCount > 0 and self.count > self.maxCount then
        self.count = self.maxCount
    end
end

---获取品质
function BaseItemData:GetGrade()
    return 0
end

--endregion

return BaseItemData
