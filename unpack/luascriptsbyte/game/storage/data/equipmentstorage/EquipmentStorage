local EquipmentItem = require "EquipmentItem"
local base = require "BaseStorage"
---@class EquipmentStorage:BaseStorage	装备仓库
local EquipmentStorage = _G.BaseClass("EquipmentStorage", base)
local table = _G.table
---构造函数
function EquipmentStorage:__init()
    self.sidTable = {}
end
---类的析构函数
function EquipmentStorage:Dispose()
    self.sidTable = nil
end

function EquipmentStorage:Init()
    self.isU = true
end
---仓库数据解析(类重写数据解析)
---@param msg storage.EquipmentStorage 物品PB数据
function EquipmentStorage:ParseInit(msg)
    local props = msg.equipment
    if props ~= nil then
        for _, value in pairs(props) do
            self:AddItemByData(value)
        end
    end
end

---重连进来
function EquipmentStorage:ParseReconnectInit(msg)
    local props = msg.equipment
    if props ~= nil then
        for _, value in pairs(props) do
            if nil == self:GetItemByKey(value.uid) then
                self:AddItemByData(value)
            end
        end
    end
end

---解析单条奖励
---@param msg prop.EquipmentProp 单条装备数据
function EquipmentStorage:ParseSingle(msg)
    --msg
    --装备 [装备Sid，Uid,Num,Element,固定词缀Sid,Num,随机词缀Sid,Num,随机词缀Sid,Num...]
    ---@type EquipmentItem_ServerMsg
    local data = {}
    data.sid = msg[1]
    data.uid = msg[2]
    data.count = msg[3] or 1
    data.element = msg[4] or 1
    data.addition = {}
    local IsAddition = false
    for i = 5, #msg do
        if i % 2 == 1 then
            local tmp = {k = msg[i], v = msg[i + 1]}
            table.insert(data.addition, tmp)
        end
    end

    local prop = self.list[data.uid]
    if not prop then ---新增
        self:AddItemByData(data)
    else ---数量变动 双倍奖励装备不
        self:ChangeCount(data.uid, data.count)
    end

    if table.count(self.sidTable[data.sid]) <= 1 then
        self.list[data.uid].isNew = true
    end
    return self.list[data.uid]
end
---新增物品
---@param data table 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function EquipmentStorage:AddItem(data)
    local equip = EquipmentItem.New()
    equip:Parse(data)
    if not self.sidTable[equip.sid] then
        self.sidTable[equip.sid] = {}
    end
    self.sidTable[equip.sid][equip.uid] = true
    return equip.uid, equip
end

---新增实体对象
---@param Equip EquipmentItem 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function EquipmentStorage:AddItemByEntity(Equip)
    local uid = Equip.uid
    local sid = Equip.sid
    local count = Equip.count
    local prop = self.list[uid]
    if not prop then ---新增
        self:AddItemByData(require("EquipmentItem").GetMsg(Equip))
    else ---数量变动
        self:ChangeCount(uid, count)
    end

    if table.count(self.sidTable[sid]) <= 1 then
        self.list[uid].isNew = true
    end
    return self.list[uid]
end

---计算道具数量
---@param sid number sid
---@return number 相同SID的装备数量
function EquipmentStorage:CalulateItemCount(sid)
    return self.sidTable[sid] and table.count(self.sidTable[sid]) or 0
end
---使用装备
---@param data table 使用返回数据
function EquipmentStorage:OnUseProp(data)
    local uids = data.uids
    local sid
    local equipment
    local remUids = {}
    for _, v in pairs(uids) do
        equipment = self.list[v]
        if equipment then
            sid = equipment
            if self.sidTable[sid] then
                for i = 1, #self.sidTable[sid] do
                    if self.sidTable[sid][i] == v then
                        table.remove(self.sidTable[sid], i)
                    end
                end
            end
            table.insert(remUids, self:GetRedPointFreshData(v))
            self:RemoveItem(v)
        end
    end
    self:OnRefreshRedPoint(nil, remUids)
end

function EquipmentStorage:GetRedPointFreshData(uid)
    return {uid, self.list[uid].sid}
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function EquipmentStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
    require("CardInfoManager"):GetInstance():RedPointRefreshEuipmentStorage(add, rem, change)
end

--region 对外接口

---获取同一SID的装备列表
---@param sid number 装备sid
---@return table|EquipmentItem 装备数组
function EquipmentStorage:GetEquipmentsBySid(sid)
    local equipments = {}
    if self.sidTable[sid] then
        return table.values(self.sidTable[sid])
    end
    return equipments
end
---获取所有的装备sid数组
---@return table 装备sid数组
function EquipmentStorage:GetAllEquipmentsSids()
    return table.keys(self.sidTable)
end

--endregion

return EquipmentStorage
