---获取分解材料
---@return table<number, table<number, number>> 分解材料数量 {{uid,数量}}
function ArtifactData:GetDecomposeData()
    local insert = _G.table.insert
    local material = {}
    ---本体及升星材料
    local selfNum = 1
    if self.star > 0 then
        local artifact_star_cfg = ConfigManager.artifact_star_cfg
        for i = 0, self.star - 1 do
            selfNum = selfNum + artifact_star_cfg[100 + i].materials_oneself
        end
    end
    ---觉醒
    if self:GetIsAwaken() then
        selfNum = selfNum + self:GetAwakenCost()
    end
    insert(material, { self.cfg.return_item, self.cfg.giveback * selfNum })

    ---升级材料
    if self.lv > 1 then
        local rate = ConfigManager.discrete_cfg[101205][1][1] / 10000
        local config = ConfigManager.artifact_level_cfg[self.lv]
        for _, v in pairs(config["material_" .. self.cfg.Order]) do
            insert(material, { v[1], _G.Mathf.Floor(v[2] * rate) })
        end
    end

    return material
end

---获取重置材料
function ArtifactData:GetResetMaterial()
    local insert = _G.table.insert
    local material = {}
    ---升星材料
    local selfNum = 0
    if self.star > 0 then
        local artifact_star_cfg = ConfigManager.artifact_star_cfg
        selfNum = artifact_star_cfg[100 + self.star].reset_oneself
    end
    ---觉醒
    if self:GetIsAwaken() then
        selfNum = selfNum + self:GetAwakenCost()
    end
    if selfNum > 0 then
        ---本体需要拆开单独显示
        for i = 1, selfNum do
            insert(material, { self.sid, 1 })
        end
    end

    ---升级材料
    if self.lv > 1 then
        local rate = ConfigManager.discrete_cfg[101209][1][1] / 10000
        local config = ConfigManager.artifact_level_cfg[self.lv]
        for _, v in pairs(config["material_" .. self.cfg.Order]) do
            insert(material, { v[1], _G.Mathf.Floor(v[2] * rate) })
        end
    end
    return material, selfNum
end

---是否能提升（升级，升星，觉醒）策划要刷红点，一起判断节省计算量
---@return boolean,boolean,boolean 能升级，能升星，能觉醒
function ArtifactData:CanDevelop()
    local canLvUp, canStarUp, canAwaken = true, true, false
    local StorageManager = _G.StorageManager:GetInstance()
    if self.lv < self:GetMaxLevel() then
        local curLv = ConfigManager.artifact_level_cfg[self.lv]["material_" .. self.cfg.Order]
        local nextLv = ConfigManager.artifact_level_cfg[self.lv + 1]["material_" .. self.cfg.Order]
        local propDic = {}
        for _, v in pairs(nextLv) do
            propDic[v[1]] = v[2]
        end
        for _, v in pairs(curLv) do
            if propDic[v[1]] then
                propDic[v[1]] = propDic[v[1]] - v[2]
            end
        end
        for k, v in pairs(propDic) do
            if not StorageManager:CheckItem(k, v) then
                canLvUp = false
                break
            end
        end
    else
        canLvUp = false
    end

    local count = self:SameCount()
    if self.star < self.cfg.Star then
        canAwaken = false
        if count < ConfigManager.artifact_star_cfg[100 + self.star].materials_oneself then
            canStarUp = false
        end
    else
        canStarUp = false
        canAwaken=self:CanAwaken()
    end
    --ZHJH5ZHJH-4457 【Beta0.0.1+CBT】【7日版本】BuglistZHJH-6629
    --【神器】神器升到满级满星后有报错，重新登录会卡loading
    --屏蔽神器觉醒
    -- if canAwaken then
    --     if self:GetAwakenCost() == 0 then --不可觉醒
    --         canAwaken = false
    --     elseif self:GetIsAwaken() then --已觉醒
    --         canAwaken = false
    --     else
    --         local count = self:SameCount()
    --         if count < self:GetAwakenCost() then
    --             canAwaken = false
    --         end
    --     end
    -- end
    return canLvUp, canStarUp, canAwaken
end

---能否升级
function ArtifactData:CanLvUp()
    local StorageManager = _G.StorageManager:GetInstance()
    if self.lv < self:GetMaxLevel() then
        local curLv = ConfigManager.artifact_level_cfg[self.lv]["material_" .. self.cfg.Order]
        local nextLv = ConfigManager.artifact_level_cfg[self.lv + 1]["material_" .. self.cfg.Order]
        local propDic = {}
        for _, v in pairs(nextLv) do
            propDic[v[1]] = v[2]
        end
        for _, v in pairs(curLv) do
            if propDic[v[1]] then
                propDic[v[1]] = propDic[v[1]] - v[2]
            end
        end
        for k, v in pairs(propDic) do
            if not StorageManager:CheckItem(k, v) then
                return false
            end
        end
        return true
    end
    return false
end

---能否升星
function ArtifactData:CanStarUp()
    if self.star < self.cfg.Star then
        local count = self:SameCount()
        if count < ConfigManager.artifact_star_cfg[100 + self.star].materials_oneself then
            return false
        end
        return true
    end
    return false
end

---能否觉醒
function ArtifactData:CanAwaken()
    --ZHJH5ZHJH-4457 【Beta0.0.1+CBT】【7日版本】BuglistZHJH-6629
    --【神器】神器升到满级满星后有报错，重新登录会卡loading
    --屏蔽神器觉醒
    -- if self.lv < self:GetMaxLevel() then
    --     return false
    -- end
    -- if self.star < self.cfg.Star then
    --     return false
    -- end
    -- if self.cfg.awaken_cost == 0 then --不可觉醒
    --     return false
    -- elseif self:GetIsAwaken() then --已觉醒
    --     return false
    -- else
    --     local count = self:SameCount()
    --     if count < self.cfg.awaken_cost then
    --         return false
    --     end
    -- end
    -- return true
    if self.cfg.card_id > 0 and (self.cfg.display and self.cfg.display == 1) then
        local awakenCfg = _G.ConfigManager.artifact_awaken_cfg[self.awaken + 101]
        if self.cfg and awakenCfg then
            local datas = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
            local count = awakenCfg.materials_oneself
            for _, v in pairs(datas) do
                if v.sid == self.sid and v.star == 0 then
                    count = count - 1
                    if count <= 0 then
                        break
                    end
                end
            end
            if count == 0 then
                return true
            end
        end
    end
    return false
end

function ArtifactData:SameCount()
    local artifactList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Artifact, _G.ArtifactType.NoWear)
    local count = 0
    for _, v in pairs(artifactList) do
        if v.sid == self.sid then ---本体
            if v.star == 0 then
                count = count + v.count
            end
        end
    end
    if self.cardUid == 0 and self.star == 0 then --自身也在未穿戴列表中
        count = count - 1
    end
    return count
end

