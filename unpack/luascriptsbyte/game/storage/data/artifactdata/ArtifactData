---设置觉醒技能
function ArtifactData:SetAwakeSkill(k, v)
    local hasset = false
    for i = 1, #self.awaken_set do
        if self.awaken_set[i].key == k then
            hasset = true
            self.awaken_set[i].value = v
        end
    end
    if not hasset then
        table.insert(self.awaken_set, {key = k, value = v})
    end
    self:UpdateAttribute()
end

---获取觉醒技能
function ArtifactData:GetAwakeSkill(k)
    local value = 0
    for i = 1, #self.awaken_set do
        if self.awaken_set[i].key == k then
            value = self.awaken_set[i].value
            break
        end
    end
    return value
end

---更改数量
---@param num number 数量
---@param fact boolean 是否是实际数量
function ArtifactData:ChangeCount(num, fact)
    self.count = fact and num or self.count + num
    if self.count < 0 then
        self.count = 0
    elseif self.maxCount > 0 and self.count > self.maxCount then
        self.count = self.maxCount
    end
end

