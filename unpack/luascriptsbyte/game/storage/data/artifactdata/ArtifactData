---获取基础属性
function ArtifactData:GetBaseAttr(attribute)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end

    local starCfg = ConfigManager.artifact_star_cfg[100 + self.star]
    local growth = (ConfigManager.artifact_level_cfg[self.lv].att_1_growth * starCfg.att_growth) / 100000000
    local cfg = self.cfg
    local atk = cfg.atk * growth
    local bre = cfg.bre * growth
    local def = cfg.def * growth
    local maxHp = cfg.max_hp * growth

    attribute:AddValueByName("atk", _G.Mathf.RoundToInt(atk), false)
    attribute:AddValueByName("bre", _G.Mathf.RoundToInt(bre), false)
    attribute:AddValueByName("def", _G.Mathf.RoundToInt(def), false)
    attribute:AddValueByName("max_hp", _G.Mathf.RoundToInt(maxHp), false)

    local toNum = _G.tonumber
    local attId = cfg.skill_id[self.star + 1]
    if attId > 0 then
        local atts = _G.ConfigManager.attribute_cfg[attId].attribute
        for _, v in pairs(atts) do
            local c2Attr1 = toNum(v[3])
            attribute:AddValueByName(
                v[1],
                AttributeClassManager:GetValueWithName(v[1], c2Attr1, toNum(v[2])),
                false,
                toNum(v[2])
            )
        end
    end
    return attribute
end

---获取觉醒属性
function ArtifactData:GetAwakenAttr(attribute)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end
    local toNum = _G.tonumber
    if self:GetIsAwaken() then
        local attrs = {}

        for i = 1, #self.awaken_set do
            --local cfgawken = ConfigManager.artifact_awaken_cfg[100 + self.awaken_set[i].key]
            local skillid = self.awaken_set[i].value--cfgawken.skill_id[self.awaken_set[i].value]
            if skillid > 0 then
                local cfgawkenskill = ConfigManager.artifact_awaken_skill[skillid]
                for j = 1, #cfgawkenskill.attribute do
                    table.insert(attrs, cfgawkenskill.attribute[j])
                end
            end
        end

        for _, att in pairs(attrs) do
            attribute:AddValueByName(
                att[1],
                AttributeClassManager:GetValueWithName(att[1], toNum(att[3]), toNum(att[2])),
                false,
                toNum(att[2])
            )
        end
    end
    return attribute
end
---更新属性
function ArtifactData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self:GetBaseAttr(self.attribute)
    self:GetAwakenAttr(self.attribute)
end

