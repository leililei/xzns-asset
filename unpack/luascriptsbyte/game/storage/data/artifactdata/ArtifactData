---类的构造函数
function ArtifactData:__init()
    ---true初始化完成 可以检测修改 刷新红点
    self.Init = false
    self.type = _G.ArtifactDataType.Normal
end

---物品数据解析(类重写数据解析)
---@param msg prop.i_artifact 数据
function ArtifactData:ParseInitMsg(msg)
    --LogError(msg)
    self.sid = msg.sid
    self.uid = msg.uid or self.sid
    self.star = msg.star or 0
    self.lv = msg.level or 1
    self.count = msg.num or 1
    self.awaken = msg.awaken or 0
    self.cardUid = msg.card_uid or 0
    self.cfg = ConfigManager.artifact_cfg[self.sid]
    self.awaken_set = msg.awaken_set or {}
    self:UpdateAttribute()
end

function ArtifactData:Reset()
    self.star = 0
    self.lv = 1
    self.awaken = 0
    self.cardUid = 0
    self.awaken_set = {}
    self:UpdateAttribute()
end

---初始化交互数据
function ArtifactData:OnInitMutuallyData()
end

