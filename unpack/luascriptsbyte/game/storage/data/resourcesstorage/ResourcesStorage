local base = require "BaseStorage"
local PropData = require "PropData"
---@class ResourcesStorage:BaseStorage    资源仓库
local ResourcesStorage = _G.BaseClass("ResourcesStorage", base)

---资源仓库数据解析(类重写数据解析)
---@param msg table PB数据
function ResourcesStorage:ParseInit(msg)
    self:ParseInitData(msg.res_prop)
    local id = _G.ResPropID.HoreExp
    local exp = _G.PlayerModel:GetInstance().exp
    local heroExp = self.list[id]
    if heroExp then
        heroExp:ChangeCount(exp, true)
    elseif exp > 0 then
        self:AddItemByData(id, exp)
    end
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.ResRefresh)
end

---重连进来
function ResourcesStorage:ParseReconnectInit(msg)
    self:ParseReconnectInitData(msg.res_prop)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.ResRefresh)
end

---资源仓库奖励数据解析(类重写数据解析)
---@param data PropAwardSimple PB数据
function ResourcesStorage:ParseSingle(data)
    local sid = data.sid
    local res = self.list[sid]
    if not res then
        ---新增
        self:AddItemByData(sid, data.factNum)
    else
        ---数量变动
        if data.factNum then
            self:ChangeCount(sid, data.factNum, true)
        else
            self:ChangeCount(sid, data.fixNum)
        end
    end
    -- 如果是玩家经验
    if sid == _G.ResPropID.HoreExp then
        if data.fixNum ~= nil then
            local PlayerModel = _G.PlayerModel:GetInstance()
            PlayerModel:UpdateExp(data.fixNum)
            self.list[sid]:ChangeCount(PlayerModel.exp, true)
        end
    elseif sid == _G.ResPropID.VipExp then
        ---VIP经验
        if data.fixNum then
            require("VIPPrivilegeModel"):GetInstance():NotificationExp(data.fixNum)
        end
        -- elseif sid == _G.ResPropID.LimitDropCoin then
        --      ---限时掉落活动代币
        --     if data.fixNum then
        --         require("LimitTimeDropCoinModel"):GetInstance():AddCoin(data.fixNum)
        --     end
    end
end

---新增物品
---@param ... any 动态参数
---@return number 返回添加的对象ID(0 为失败)
function ResourcesStorage:AddItem(sid, num)
    local res = PropData.New()
    res:Parse({ sid = sid, num = num })
    return sid, res
end

---获取道具数量
---@param id number sid
---@return number 数量
function ResourcesStorage:CalulateItemCount(id)
    local res = self.list[id]
    if res then
        return res:GetCount()
    end
    return 0
end

---检测仓库是否足够
---@param num number 需要检测的数量
---@param sid number 道具sid
---@return boolean 是否足够
function ResourcesStorage:CheckSizeEnough(num, sid)
    local item = self.list[sid]
    if item then
        if item.cfg.Type1 == 23 then
            return true
        end
        local max = item:GetMaxCount()
        if max <= 0 then
            return true
        end
        return max - num >= item:GetCount()
    end
    return base.CheckSizeEnough(self, 1)
end

---获取所有的物品id数组
---@return table 物品ID数组
function ResourcesStorage:GetAllIds()
    local sids = table.keys(self.list)
    return sids
end
---当道具数据改变时调用
---@param uid number 物品UID
---@param type CardChangeType 以什么操作改变
function ResourcesStorage:OnItemDataChanged(uid, type)
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function ResourcesStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
    ---刷新下共鸣神石的 红点 2 是默认解锁
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(
        _G.ConfigManager.redpoint_cfg.Playtreeprofessional.id
    )
    -- require("CardGuangMingShenShiManager"):GetInstance():RedPointStoneRefresh(add, rem, change)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.GuildDonation.id)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.WheelOfFortune.id)
    require "VIPPrivilegeModel":GetInstance():AddorRemOrChange(add, rem, change)
end

--region 内部方法
function ResourcesStorage:ParseInitData(data)
    if data ~= nil then
        for _, value in pairs(data) do
            self:AddItemByData(value.sid, value.num)
        end
    end
end

---重连进来
function ResourcesStorage:ParseReconnectInitData(data)
    if data ~= nil then
        for _, value in pairs(data) do
            if nil == self:GetItemByKey(value.sid) then
                self:AddItemByData(value.sid, value.num)
            else
                self:ChangeCount(value.sid, value.num, true)
            end
        end
    end
end
--endregion

return ResourcesStorage
