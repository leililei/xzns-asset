local base = require "BaseItemData"
---@class DebrisData : BaseItemData	中文描述
local DebrisData = _G.BaseClass("DebrisData", base)
_G.DebrisData = DebrisData

function DebrisData:__init()
end

---物品数据解析(类重写数据解析)
function DebrisData:ParseInitMsg(msg)
    self.sid = msg.sid
    self.count = msg.num
    self.cfg = _G.ConfigManager.item_cfg[self.sid]
    ---是否可以一键合成
    self.clickcompositing = self.cfg.clickcompositing and self.cfg.clickcompositing == 1
    ---数据兼容
    self.Grade = self.cfg.Quality
end

---碎片数量
---@return number 数量
function DebrisData:GetCount()
    return self.count
end

function DebrisData:GetOrder()
    return self.cfg.Quality
end

function DebrisData:GetGrade()
    return self.Grade
end

return DebrisData
