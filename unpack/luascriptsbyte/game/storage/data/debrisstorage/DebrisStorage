local base = require "ResourcesStorage"
---@class DebrisStorage : BaseStorage	中文描述
local DebrisStorage = _G.BaseClass("DebrisStorage", base)

--region 子类重写
---仓库数据解析(类重写数据解析)
function DebrisStorage:ParseInit(msg)
    self:ParseInitData(msg.fragment)
end

---重连
function DebrisStorage:ParseReconnectInit(msg)
    self:ParseReconnectInitData(msg.fragment)
end

---解析单条数据
---@param data table 碎片数据
function DebrisStorage:ParseSingle(data)
    local _data = self.list[data.sid]
    if not _data then
        ---新增
        self:AddItemByData(data.sid, data.factNum, data.args)
    else ---数量变动
        self:ChangeCount(data.sid, data.factNum, true)
    end
end

---获得新碎片
function DebrisStorage:AddItem(sid, num)
    local debrisData = require("DebrisData").New()
    debrisData:Parse({sid = sid, num = num})
    return sid, debrisData
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function DebrisStorage:RefreshRedPoint(add, rem, change)
    local redpointManager = require("RedPointManager"):GetInstance()
    local cfg = _G.ConfigManager.redpoint_cfg
    if not _G.table.isEmptyOrNil(add) then
        for uid, sid in pairs(add) do
            redpointManager:AddRedPointParam(cfg.BackpackItemDebris.id, uid)
        end
        require("PetModel"):GetInstance():CheckCompsePetRedPoint(add)
    end
    if not _G.table.isEmptyOrNil(rem) then
        for uid, sid in pairs(rem) do
            redpointManager:RemoveRedPointParam(cfg.BackpackItemDebris.id, uid)
        end
    end
    if not _G.table.isEmptyOrNil(change) then
        for uid, sid in pairs(change) do
            redpointManager:RefreshNode(cfg.BackpackItemDebris.id, uid)
        end
    end
    redpointManager:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Playtreeprofessional.id)
    -- redpointManager:RefreshNode(cfg.ArenaBattleButton.id)
    -- redpointManager:RefreshNode(cfg.ArenaBattleButton.id)
end

--endregion

return DebrisStorage
