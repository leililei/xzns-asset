local base = require "BaseItemData"

---@class SpiritualData:BaseItemData    灵契数据类
---@field cfg spiritual_cfg
local SpiritualData = _G.BaseClass("SpiritualData", base)
_G.SpiritualData = SpiritualData

local ConfigManager = _G.ConfigManager

---类的构造函数
function SpiritualData:__init()
    ---true初始化完成 可以检测修改 刷新红点
    self.Init = false
end

---物品数据解析(类重写数据解析)
---@param msg prop.i_spiritual 数据
function SpiritualData:ParseInitMsg(msg)
    self.sid = msg.sid
    self.uid = msg.uid or self.sid
    self.star = msg.star or 0
    self.lv = msg.level or 1
    self.count = msg.num or 1
    self.unlock = msg.unlock
    self.index = msg.index
    self.cardUid = msg.cardUid or 0
    self.cfg = ConfigManager.spiritual_cfg[self.sid]
    if not self.cfg then
        _G.LogError(self.sid)
    end
    self:UpdateAttribute()
end

function SpiritualData:Reset(resetStar)
    if resetStar or self.lv <= 1 then
        self.star = 0
    end
    self.lv = 1
    self.index = nil
    self.cardUid = 0
    self:UpdateAttribute()
end

---额外数据解析(类重写数据解析)
function SpiritualData:ParseExtend(extend)
    if not extend then
        return
    end
    self.star = extend.star or self.star or 0
    self.lv = extend.lv or self.lv or 1
    self.count = extend.count or self.count or 0
end

---初始化交互数据
function SpiritualData:OnInitMutuallyData()
end

---初始化交互数据
function SpiritualData:InitMutuallyData()
    self:OnInitMutuallyData()
end

---更新属性
function SpiritualData:UpdateAttribute()
    self.attribute = _G.AttributeClassManager:GetInstance():GetAttribtueClass()
    self:GetBaseAttr(self.attribute)
end

-----获取卡牌计算属性
---@return AttributeClass
function SpiritualData:GetCardAddAttr()
    local cardAttr = self.attribute:Clone()
    cardAttr:AttributeToOther()
    return cardAttr
end

---获取基础属性
function SpiritualData:GetBaseAttr(attribute, level, star)
    local AttributeClassManager = _G.AttributeClassManager:GetInstance()
    if attribute == nil then
        attribute = AttributeClassManager:GetAttribtueClass()
    end

    level = level or self.lv
    star = star or self.star
    local starCfg = ConfigManager.spiritual_star_cfg[100 + star]
    local growth = (ConfigManager.spiritual_level_cfg[level].att_growth * starCfg.att_growth) / 100000000
    local atk = _G.Mathf.RoundToInt(self.cfg.atk * growth)
    local bre = _G.Mathf.RoundToInt(self.cfg.bre * growth)
    local def = _G.Mathf.RoundToInt(self.cfg.def * growth)
    local maxHp = _G.Mathf.RoundToInt(self.cfg.max_hp * growth)

    attribute:AddValueByName("atk", atk, false)
    attribute:AddValueByName("bre", bre, false)
    attribute:AddValueByName("def", def, false)
    attribute:AddValueByName("max_hp", maxHp, false)
    return attribute
end

---获取基础技能描述
---@return string 基础技能描述
function SpiritualData:GetTipSkillDescribe()
    return require("SpiritualModel").GetStarSkillDes(self.sid, 0)
end

---获取分解材料
---@return table<number, table<number, number>> 分解材料数量 {{uid,数量}}
function SpiritualData:GetDecomposeData()
    local material = {}
    ---升级材料返还
    if self.lv > 1 then
        local rate = ConfigManager.discrete_cfg[114002][1][1] / 10000
        local config = ConfigManager.spiritual_level_cfg[self.lv]
        for _, v in pairs(config["material_" .. self.cfg.Order]) do
            _G.table.insert(material, {v[1], _G.Mathf.Floor(v[2] * rate)})
        end
    end

    ---分解货币数量
    if self.cfg.giveback then
        local starCfgs = ConfigManager.spiritual_star_cfg
        local selfNum = starCfgs[self.star + 100].materials_oneself - starCfgs[100].materials_oneself
        _G.table.insert(material, {self.cfg.giveback[1], self.cfg.giveback[2] * (selfNum + 1)})
    end

    return material
end

---获取重置材料
function SpiritualData:GetResetMaterial()
    local insert = _G.table.insert
    local material = {}
    ---升星材料
    local resetStar = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SpiritualResetStar, 0)
    local selfNum = 0
    if resetStar == 0 or self.lv <= 1 then
        if self.star > 0 then
            local spiritual_star_cfg = ConfigManager.spiritual_star_cfg
            selfNum = spiritual_star_cfg[100 + self.star].materials_oneself
            ---本体需要拆开单独显示
            for i = 1, selfNum do
                insert(material, {self.sid, 1})
            end
        end 
    end

    ---升级材料
    if self.lv > 1 then
        local rate = ConfigManager.discrete_cfg[114006][1][1] / 10000
        local config = ConfigManager.spiritual_level_cfg[self.lv]
        for _, v in pairs(config["material_" .. self.cfg.Order]) do
            insert(material, {v[1], _G.Mathf.Floor(v[2] * rate)})
        end
    end
    return material, selfNum
end

---获取灵契数量
---@return number 数量
function SpiritualData:GetCount()
    return self.count
end

---获取名称
---@return string 名称
function SpiritualData:GetName()
    return _G.LangUtil.GetLangPackValue(self.cfg.Name)
end

---获取灵契战力
function SpiritualData:GetPower()
    return self.attribute:CalculateArtifactPower()
end

---获取星级
---@return number 星级
function SpiritualData:GetStar()
    return self.star
end

---升星
function SpiritualData:UpStar(star)
    if star then
        self.star = star
    else
        self.star = self.star + 1
    end
    self:UpdateAttribute()
end

---获取等级
---@return number 等级
function SpiritualData:GetLevel()
    return self.lv
end

---升级
function SpiritualData:UpLevel(lv)
    self.lv = lv
    self:UpdateAttribute()
end

---获取等级上限
---@return number 等级上限
function SpiritualData:GetMaxLevel()
    return ConfigManager.spiritual_star_cfg[100 + self.star].level_limit
end

---获取品阶
---@return number 品阶（1-紫；2-红；3-金；4-彩）
function SpiritualData:GetOrder()
    return self.cfg.Order
end

---获取配置
---@return artifact_cfg 配置
function SpiritualData:GetCfg()
    return self.cfg
end

---获取属性
function SpiritualData:GetAttribute()
    return self.attribute
end

---绑定卡牌
---@param uid number 卡牌uid
---@param index number 装备位索引
function SpiritualData:BindCard(uid, index)
    self.cardUid = uid
    self.index = index
end

---解绑卡牌
function SpiritualData:UnbindCard()
    self.cardUid = 0
    self.index = nil
end

---获取装备位
function SpiritualData:GetIndex()
    return self.index
end

---复刻神器数据
---@param spiritual SpiritualData
function SpiritualData.GetMsg(spiritual)
    --- 有培养属性的不会可堆叠 不用Copy
    ---@type prop.i_artifact
    local data = {}
    data.sid = spiritual.sid
    data.uid = spiritual.uid
    data.star = spiritual.star
    data.level = spiritual.lv
    data.unlock = spiritual.unlock
    data.count = 1
    data.index = spiritual.index
    return data
end

---释放对象
function SpiritualData:Dispose()
    self.cardUid = 0
    self.index = nil
end

---兼容背包内的分解
function SpiritualData:GetGrade()
    return self.cfg.Order
end

---是否满星
function SpiritualData:IsMaxStar()
    return self.star >= self.cfg.Star
end

return SpiritualData