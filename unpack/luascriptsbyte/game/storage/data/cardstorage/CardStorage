---卡牌交换饰品
function CardStorage:ReplaceDecoration(carduid, other_card_uid)
    local suitsID, _ = self.list[carduid]:GetDecorationSuitID()
    if suitsID == 0 then
        self:DownDecoartion(carduid)
    else
        self:UpDecoration(suitsID, carduid, 4)
    end
    if other_card_uid == 0 then
        return
    end
    suitsID, _ = self.list[carduid]:GetDecorationSuitID()
    if suitsID == 0 then
        self:DownDecoartion(other_card_uid)
    else
        self:UpDecoration(suitsID, other_card_uid, 4)
    end
end
