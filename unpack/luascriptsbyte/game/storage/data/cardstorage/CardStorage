function CardStorage:UpdateCapacity()
    self.capacity =
        self.cfg.Capacity + self.capacity_times * self.cfg.extension +
        require "HellRoadModel":GetInstance():GetNumber({_G.PrivilegeType.Bag.HeroCount, 201})
end
---更新卡牌星级统计
function CardStorage:UpdateStarCount(s_star, e_star)
    if (s_star and e_star) and s_star == e_star then
        return
    end
    if s_star then
        self.starTable[s_star] = self.starTable[s_star] - 1
    end

    if e_star then
        if not self.starTable[e_star] then
            self.starTable[e_star] = 0
        end
        self.starTable[e_star] = self.starTable[e_star] + 1
    end

    if s_star then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar, s_star},
            self:GetCardStarDy(s_star),
            nil,
            true
        )
    end

    if e_star then
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            {_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar, e_star},
            self:GetCardStarDy(e_star),
            nil,
            true
        )
        require "PopUpGiftBagModel":GetInstance():IsCardStarSure(e_star)
    end
end

---获取超过当前星级的卡数量
function CardStorage:GetCardStarDy(curStar)
    local cnum = 0
    for star, num in pairs(self.starTable) do
        if star >= curStar then
            cnum = cnum + num
        end
    end
    return cnum
end

---移除卡牌
---@param 卡牌uid
function CardStorage:RemoveItem(uid)
    local carddata = self.list[uid]
    if carddata then
        local index = require "FriendHelpModel":GetInstance():GetBorrowIndex(carddata.uid)
        if index then
            require "FriendHelpModel":GetInstance():SetBorrowCard({uid = carddata.uid, type = 2, index = index})
        end
        self:RemoveOtherTypeCard(uid, carddata.type)
    end

    self.super.RemoveItem(self, uid)
    _G.Events:GetInstance():Broadcast(_G.eCardStorage.RemoveCardData,carddata)
end
---获取对应星级的卡牌数
function CardStorage:GetCardStarCount(star)
    return self.starTable[star] or 0
end
---添加其他类型的卡牌
---@param cardData CardData
function CardStorage:AddSingleOtherTypeCard(cardData)
    if not self.otherTypeCardList then
        self.otherTypeCardList = {}
        self.otherTypeCardList[_G.CardType.Normal] = self.list
    end
    if not self.otherTypeCardList[cardData.type] then
        self.otherTypeCardList[cardData.type] = {}
    end
    _G.table.insert(self.otherTypeCardList[cardData.type], cardData)
end
---添加其他类型的卡牌
function CardStorage:AddOtherTypeCard(cardData)
    if not self.cardTypeList[cardData.type] then
        self.cardTypeList[cardData.type] = {}
    end
    _G.table.insert(self.cardTypeList[cardData.type], cardData)
    self.allList[cardData.uid] = cardData
end

---移除其他类型的卡牌
---@param uid number 卡牌uid
function CardStorage:RemoveOtherTypeCard(uid, type)
    if not self.cardTypeList[type] then
        return
    end
    self.cardTypeList[type][uid] = nil
    self.allList[uid] = nil
end
---获取所有item
function CardStorage:GetAllItems(type)
    if type then
        return self.cardTypeList[type] or {}
    else
        return self.allList
    end
end
---@param data prop.i_card
function CardStorage:AddItemByData(data)
    local uid = data.uid or data[2]
    local _, item = self.super.AddItemByData(self, data)
    self.allList[uid] = item
    if not self.cardTypeList[item.type] then
        self.cardTypeList[item.type] = {}
    end
    self.cardTypeList[item.type][item.uid] = item
    --621
end

function CardStorage:GetItemByKey(key)
    return self.allList[key]
end

