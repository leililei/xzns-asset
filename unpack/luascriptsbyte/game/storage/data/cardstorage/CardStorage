local base = require "BaseStorage"
local CardData = require "CardData"
---@class CardStorage:BaseStorage	卡牌仓库
local CardStorage = _G.BaseClass("CardStorage", base)

local table = _G.table

function CardStorage:__init()
    self.sidTable = {}
    self.starTable = {}
    self.decoration_use_count = 0
    self.decoration_suit_count = 0
    self.DSuit_list = {}
    self.decoration_suit_lists = {}
    self.allList = {}
    self.cardTypeList = {}
    _G.Events:GetInstance():AddListener(_G.eHellRoadPrivilegeEvent.HellRoadPrivilege, self.UpdateCapacity, self)
end
function CardStorage:Dispose()
    self.sidTable = nil
    _G.Events:GetInstance():RemoveListener(_G.eHellRoadPrivilegeEvent.HellRoadPrivilege, self.UpdateCapacity, self)
end

function CardStorage:Init()
    self.isU = true
end

---仓库数据解析(类重写数据解析)
---@param msg storage.CardStorage 物品PB数据
function CardStorage:ParseInit(msg)
    --赋值当前仓库的扩展次数
    if msg.times ~= nil then
        for key, value in pairs(msg.times) do
            if value.type == _G.StorageType.Card then
                self.capacity_times = value.times
            end
        end
    else
        self.capacity_times = 0
    end
    self.capacity = self.cfg.Capacity + self.capacity_times * self.cfg.extension

    local props = msg.card
    if props ~= nil then
        for _, value in pairs(props) do
            self:AddItemByData(value)
        end
    end
end

---重连进来
function CardStorage:ParseReconnectInit(msg)
    local props = msg.card
    if props ~= nil then
        local IllustrationModel = require "IllustrationModel":GetInstance()
        for _, value in pairs(props) do
            if nil == self:GetItemByKey(value.uid) then
                self:AddItemByData(value)
                IllustrationModel:JieSuoHunJiangNew(value.sid)
            end
        end
    end
end

---解析单条奖励
---@param data prop.CardProp 单条卡牌数据
function CardStorage:ParseSingle(data)
    local uid = data[2]
    local sid = data[1]
    self:AddItemByData(data)
    local card = self.list[uid]
    if data[3] ~= 0 then
        if card.type == _G.CardType.Normal then
            card:SetLevel(require("CardResonanceModel"):GetInstance():GetMinLevel())
        end
        card:upStarCardAward(data[3])
    end
    card:InitMutuallyData()

    if self.sidTable[sid] and #self.sidTable[sid] <= 1 then
        card.isNew = true
    end
    _G.Events:GetInstance():Broadcast(_G.eCardStorage.AddCardData,card)
    return card
end

---初始化交互数据
function CardStorage:InitMutuallyData()
    for _, card in pairs(self.list) do
        card:InitMutuallyData()
        --计算卡牌穿戴饰品的数量
        self:CalulateDecorationCount(card)
        self:CalulateDecoration_suit_Count(card)
    end
    self:InitGetDecoration_suitCount()
    require("EquipmentModel"):GetInstance():InitGradeCountDic()

    _G.StorageManager:GetInstance():GetServerCardPower()
end

---新增物品
---@param data table 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function CardStorage:AddItem(data)
    local card = _G.CardData.New()
    card:Parse(data)
    if not self.sidTable[card.sid] then
        self.sidTable[card.sid] = {}
    end
    table.insert(self.sidTable[card.sid], card.uid)
    self:UpdateStarCount(nil, card.star)
    -- if card.star >= 11 then
    --     self:XingJiPanDuan()
    -- end
    return card.uid, card
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
---@param type CardChangeType 以什么操作改变
function CardStorage:RefreshRedPoint(add, rem, change, type)
    local CardInfoManager = require("CardInfoManager"):GetInstance()
    local RedPointManagerIns = require("RedPointManager"):GetInstance()
    local isAdd = not _G.table.isEmptyOrNil(add)
    local isRem = not _G.table.isEmptyOrNil(rem)
    local isChange = not _G.table.isEmptyOrNil(change)
    if isAdd or isRem then
        if isAdd then
            for uid, sid in pairs(add) do
                CardInfoManager:RedPointItemCardDevelop_Add(uid)
                CardInfoManager:RedPointItemCardDevelopAllUpstar_Add(uid)
            end
        end

        if isRem then
            for uid, sid in pairs(rem) do
                CardInfoManager:RedPointItemCardDevelop_Remove(uid)
                CardInfoManager:RedPointItemCardDevelopAllUpstar_Remove(uid)
            end
        end

        CardInfoManager:BindCardRedPointSounl(add, rem)
        CardInfoManager:BindCardRedPointDecoration(add, rem)
        CardInfoManager:BindCardRedPointCarving(add, rem)
        CardInfoManager:BindCardRedPointFetter(add, rem)
        CardInfoManager:BindCardRedPointEquiment(add, rem)
        require("CardResonanceModel"):GetInstance():AddOrRemoveCard(add, rem)
        require("CardInheritModel"):GetInstance():AddOrRemoveCard(add, rem)
        require "RoleTeamModel":GetInstance():AddOrRemove(add, rem)
        require("CampsiteModel"):GetInstance():AddorRemoveOrChange(add, rem)
        require("TalentModel"):GetInstance():AddOrRemoveOrChange(add, rem)
        require("SeasonHeroGiftPackModel"):GetInstance():AddOrRemoveCard(add, rem)
    end
    if isChange then
        if type == _G.CardChangeType.UpLevel then
            ---升级才加处理的红点
            -- require("CardResonanceModel"):GetInstance():AddOrRemoveCard(nil, nil, change)
            -- CardInfoManager:BindCardRedPointEquiment(nil, nil, change)
        elseif type == _G.CardChangeType.UpStar then
            ---升星才加处理的红点
            CardInfoManager:BindCardRedPointDecoration(nil, nil, change)
            CardInfoManager:BindCardRedPointCarving(nil, nil, change)
            CardInfoManager:BindCardRedPointFetter(nil, nil, change)
            require("CampsiteModel"):GetInstance():AddorRemoveOrChange(nil, nil, change)
            require("TalentModel"):GetInstance():AddOrRemoveOrChange(nil, nil, change)
        else
            require("CardResonanceModel"):GetInstance():AddOrRemoveCard(nil, nil, change)
            CardInfoManager:BindCardRedPointDecoration(nil, nil, change)
            CardInfoManager:BindCardRedPointCarving(nil, nil, change)
            CardInfoManager:BindCardRedPointFetter(nil, nil, change)
            require("CampsiteModel"):GetInstance():AddorRemoveOrChange(nil, nil, change)
            require("TalentModel"):GetInstance():AddOrRemoveOrChange(nil, nil, change)
            CardInfoManager:BindCardRedPointEquiment(nil, nil, change)
        end
        CardInfoManager:BindCardRedPointSounl(nil, nil, change)
    end

    CardInfoManager:RedPointItemCard_UpdataAll()
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.Playtreeprofessional.id)
    RedPointManagerIns:RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpiritualPage.id)
    --RedPointManagerIns:RefreshNode(_G.ConfigManager.redpoint_cfg.AllHeroesBattleEmbattle.id)
end
