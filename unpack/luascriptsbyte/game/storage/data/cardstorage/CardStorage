---获取同一张卡牌组
---@param sid number 卡牌sid
---@return table|CardData 卡牌数组
function CardStorage:GetCardsBySid(sid)
    local cards = {}
    if self.sidTable[sid] then
        for i = 1, #self.sidTable[sid] do
            table.insert(cards, self.list[self.sidTable[sid][i]])
        end
    end
    return cards
end
---获取所有的卡牌sid数组
---@return table 卡牌sid数组
function CardStorage:GetAllCardSids()
    return table.keys(self.sidTable)
end

