    local item = self:GetItemByKey(sidoruid)
    if item ~= nil then
        local count = item:GetCount()
        item:ChangeCount(num, fact)
        num = item:GetCount()
        self:UpdateStarCount(item:GetStar())
        if num == 0 then
            -- _G.Events:GetInstance():Broadcast(
            --     _G.ePlayAactionEvent.PlayAaction,
            --     {_G.ActiveTaskEnum.ConditionEnum.CardLevel.assignCountAssignStar, item.star},
            --     -1
            -- )
            local data = self:GetRedPointFreshData(sidoruid)
            self:RemoveItem(sidoruid)
            self:OnRefreshRedPoint(nil, {data})
        else
            if num ~= count then
                self:OnRefreshRedPoint(nil, nil, {self:GetRedPointFreshData(sidoruid)})
            end
        end
    -- if item.star >= 11 then
