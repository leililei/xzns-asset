---仓库扩容次数增加
---@param times number 扩容次数
function CardStorage:AddCapacityTimes(times)
    self.capacity_times = self.capacity_times + times
    self.capacity =
        self.cfg.Capacity + self.capacity_times * self.cfg.extension +
        require "HellRoadModel":GetInstance():GetNumber({_G.PrivilegeType.Bag.HeroCount, 201})
end

function CardStorage:GetRedPointFreshData(uid)
    return {uid, self.list[uid].sid}
end
