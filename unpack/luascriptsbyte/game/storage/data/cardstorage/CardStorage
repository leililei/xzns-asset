---计算饰品套装的数量
---@field decoration_suit_lists table key = 套装id value = { uid = 卡牌的uid}
function CardStorage:CalulateDecoration_suit_Count(card)
    local suit_id, uid = card:GetDecorationSuitID()
    if suit_id == 0 then
        return
    end
    if _G.table.isEmptyOrNil(self.decoration_suit_lists[suit_id]) then
        self.decoration_suit_lists[suit_id] = {}
    end
    _G.table.insert(self.decoration_suit_lists[suit_id], uid)
end
---（对外接口初始化 计算一次饰品套装数量，后面直接调用...2直接获得不同套装数量）获得饰品套装的数量
function CardStorage:InitGetDecoration_suitCount()
    local count = 0
    if _G.table.isEmptyOrNil(self.decoration_suit_lists) then
        count = 0
    else
        local suit = {}
        --去掉重复的 套装id
        for key, value in pairs(self.decoration_suit_lists) do
            if _G.table.isEmptyOrNil(suit[key]) then
                suit[key] = {}
            end
            suit[key] = 1
        end
        if _G.table.isEmptyOrNil(suit) then
            count = 0
        else
            count = _G.table.count(suit)
        end
        self.DSuit_list = suit
    end
    self.decoration_suit_count = count
    return count
end
---获得套装数量
function CardStorage:GetSuit_count_noSame()
    return self.decoration_suit_count
end

---对外接口 设置 套装的数量
---@param isUpOrDown number 0 交换 1 穿戴 2 卸下
---@param carduid number 卡牌uid
function CardStorage:SetDecorationSuitCount(isUpOrDown, carduid, other_card_uid)
    if isUpOrDown == 1 then
        local suitsID, _ = self.list[carduid]:GetDecorationSuitID()
        self:UpDecoration(suitsID, carduid, suitsID == 0 and 0 or 4)
    elseif isUpOrDown == 2 then
        self:DownDecoartion(carduid)
    else
        self:ReplaceDecoration(carduid, other_card_uid)
    end
end
---卡牌穿戴 穿戴饰品()
function CardStorage:UpDecoration(suitID, carduid, number)
    --没有合成 套装
    if number < 4 then
        return
    end
    if _G.table.isEmptyOrNil(self.decoration_suit_lists[suitID]) then
        self.decoration_suit_lists[suitID] = {}
    end
    _G.table.insert(self.decoration_suit_lists[suitID], carduid)
    local flag = false
    if _G.table.isEmptyOrNil(self.DSuit_list) then
        flag = true
    else
        if self.DSuit_list[suitID] then
            self.DSuit_list[suitID] = 1
        else
            flag = true
        end
    end
    if flag then
        self.DSuit_list[suitID] = {}
        self.DSuit_list[suitID] = 1
        self.decoration_suit_count = self.decoration_suit_count + 1
    end
end
