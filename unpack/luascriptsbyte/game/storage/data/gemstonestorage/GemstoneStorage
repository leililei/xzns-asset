local GemstoneData = require "GemstoneData"
local base = require "BaseStorage"
---@class GemstoneStorage:BaseStorage	宝石仓库
local GemstoneStorage = _G.BaseClass("GemstoneStorage", base)
local table = _G.table
---构造函数
function GemstoneStorage:__init()
    self.sidTable = {}
end
---类的析构函数
function GemstoneStorage:Dispose()
    self.sidTable = nil
end

function GemstoneStorage:Init()
    self.isU = true
    self.gemstoneModel = require("GemstoneModel"):GetInstance()
end
---仓库数据解析(类重写数据解析)
---@param msg storage.GemstoneStorage 物品PB数据
function GemstoneStorage:ParseInit(msg)
    local props = msg.gem
    if props ~= nil then
        for _, value in pairs(props) do
            self:AddItemByData(value)
        end
    end
end

---重连进来
function GemstoneStorage:ParseReconnectInit(msg)
    local props = msg.gemstone
    if props ~= nil then
        for _, value in pairs(props) do
            if nil == self:GetItemByKey(value.uid) then
                self:AddItemByData(value)
            end
        end
    end
end

---解析单条奖励
---@param msg prop.GemstoneProp 单条宝石数据
function GemstoneStorage:ParseSingle(msg)
    --msg
    --宝石 [宝石Sid，Uid, 随机属性...]
    ---@type GemstoneData_ServerMsg
    local data = {}
    data.sid = msg[1]
    data.uid = msg[2]
    data.level = msg[3]
    data.star = msg[4]
    data.random_attrs = {}
    -- 随机属性处理，假设从第5个元素开始，每三个元素为一组 (index, 属性sid, 属性值)
    for i = 5, #msg do
        if i % 3 == 2 then
            local tmp = {index = msg[i], sid = msg[i+1], value = msg[i + 2]}
            table.insert(data.random_attrs, tmp)
        end
    end

    local prop = self.list[data.uid]
    if not prop then ---新增
        local _, gem =  self:AddItemByData(data)
        require("GemstoneModel"):GetInstance():AddGemstone(gem)
    end

    if self.sidTable[data.sid] and table.count(self.sidTable[data.sid]) <= 1 then
        self.list[data.uid].isNew = true
    end
    return self.list[data.uid]
end
---新增物品
---@param data table 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function GemstoneStorage:AddItem(data)
    local gemstone = GemstoneData.New()
    gemstone:Parse(data)
    if not self.sidTable[gemstone.sid] then
        self.sidTable[gemstone.sid] = {}
    end
    self.sidTable[gemstone.sid][gemstone.uid] = true
    return gemstone.uid, gemstone
end

---新增实体对象
---@param Gemstone GemstoneData 动态参数
---@return number|BaseItemData 返回添加的对象ID(0 为失败)|数据对象
function GemstoneStorage:AddItemByEntity(Gemstone)
    local uid = Gemstone.uid
    local sid = Gemstone.sid
    local prop = self.list[uid]
    if not prop then ---新增
        -- 构建宝石数据对象
        local data = {
            sid = Gemstone.sid,
            uid = Gemstone.uid,
            level = Gemstone.level or 0,
            star = Gemstone.star or 0,
            grade = Gemstone.grade or 1,
            professional = Gemstone.professional or 1,
            randomAttr = Gemstone.randomAttr or {},
            cardUid = Gemstone.cardUid or 0
        }
        self:AddItemByData(data)
    end

    if self.sidTable[sid] and table.count(self.sidTable[sid]) <= 1 then
        self.list[uid].isNew = true
    end
    return self.list[uid]
end

---计算道具数量
---@param sid number sid
---@return number 相同SID的宝石数量
function GemstoneStorage:CalulateItemCount(sid)
    return self.sidTable[sid] and table.count(self.sidTable[sid]) or 0
end

function GemstoneStorage:GetRedPointFreshData(uid)
    return {uid, self.list[uid].sid}
end

---刷新红点
---@param add table 新增id数组
---@param rem table 移除id数组
---@param change table 改变id数组
function GemstoneStorage:RefreshRedPoint(add, rem, change)
    if _G.AppSetting.DEBUG then
        _G.Log("仓库数据更新   " .. self.__cname)
    end
    -- 调用宝石相关的红点管理器，暂时留空，根据需要实现
    -- require("CardInfoManager"):GetInstance():RedPointRefreshGemstoneStorage(add, rem, change)
    -- 记录参数用于调试
    if _G.AppSetting.DEBUG then
        local addCount = add and _G.table.count(add) or 0
        local remCount = rem and _G.table.count(rem) or 0
        local changeCount = change and _G.table.count(change) or 0
        _G.Log(string.format("GemstoneStorage红点更新: add=%d, rem=%d, change=%d",
            addCount, remCount, changeCount))
    end
end

return GemstoneStorage