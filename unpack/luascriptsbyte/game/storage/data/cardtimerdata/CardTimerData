local base = _G.CardData
---@class CardTimerData:CardData
local CardTimerData = _G.BaseClass("CardTimerData", base)
---类的构造函数
function CardTimerData:__init()
    self.type = _G.CardType.Timer
end

function CardTimerData:SetTime(time)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.endTime = time
    local offset = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if offset < 0 then
        offset = 1
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(offset, self.OnTimeOver, self, true, false, true)
    self.timer:Start()
end

function CardTimerData:OnTimeOver()
    require "DemoModel":GetInstance():RemoveCard(self.uid)
    ---@type CardStorage
    local cardStorage = _G.StorageManager:GetInstance():GetDataStorageByID(_G.StorageID.Card)
    cardStorage:RemoveOtherTypeCard(self.uid, self.type)
    _G.Events:GetInstance():Broadcast(_G.eCard.CardTimerOver, self.uid)
end

---设置已使用次数（ZHJ-34096弃用）
---@param msg public.i_k_v
function CardTimerData:SetUseTimes(msg)
    self.useTimes = {}
    if msg then
        for _, v in pairs(msg) do
            self.useTimes[v.k] = v.v
        end
    end
end

---获取已使用次数（ZHJ-34096弃用）
---@param id number 布阵id
function CardTimerData:GetUseTimes(id)
    if self.useTimes == nil then
        return 0
    end
    return self.useTimes[id] or 0
end

---获取剩余使用次数（ZHJ-34096弃用）
---@param id number 布阵id
function CardTimerData:GetLastUseTimes(id)
    local times = self:GetUseTimes(id)
    local lastTimes = 0
    if id == _G.EmbattleType.AFKOnly then
        local cfg = _G.ConfigManager.discrete_cfg[114501]
        lastTimes = cfg and (cfg[1][1] - times) or 0
    elseif id == _G.EmbattleType.Tower then
        local cfg = _G.ConfigManager.discrete_cfg[114502]
        lastTimes = cfg and (cfg[1][1] - times) or 0
    end
    if lastTimes < 0 then
        lastTimes = 0
    end
    return lastTimes
end

---（ZHJ-34096弃用）
function CardTimerData:AddUseTimes(id, num)
    num = num or 1
    if self.useTimes[id] then
        self.useTimes[id] = self.useTimes[id] + num
    else
        self.useTimes[id] = num
    end
end

function CardTimerData:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function CardTimerData:ParseInitMsg(msg)
    ---@type  EquipmentItem[]
    self.EquipBar = {
        [_G.EquipmentPart.Head] = {},
        [_G.EquipmentPart.Clothes] = {},
        [_G.EquipmentPart.Trousers] = {},
        [_G.EquipmentPart.Shoes] = {},
        [_G.EquipmentPart.Weapon] = {}
    }
    base.ParseInitMsg(self, msg)
    --限时卡没有皮肤
    self.skin = 0
    self.cfg = require "CardCommentManager":GetInstance():CardData(self.sid, nil) or self.cfg
    self.Icon = "Images/zRoles/" .. self.cfg.Icon
end

function CardTimerData:SetSkin()
    --限时卡没有皮肤
end

function CardTimerData:GetPower(isView)
    if not isView then
        return base.GetPower(self)
    else
        return require "DemoModel":GetInstance():GetLowPower()
    end
end

return CardTimerData
