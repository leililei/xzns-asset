function CardData:GetLevel()
    local level = self.lv_Old
    if self.shenshiPosType == _G.StonePosType.PosZero then
        level = self.lv_Old
    elseif self.shenshiPosType == _G.StonePosType.PosTwo then
        if self.shenState == _G.StoneStateType.sceond then
            level = self.shenshiLv
        elseif self.shenState == _G.StoneEnum.first then
            level = self.lv_Old
        end
    else
        if self.shenState == nil or self.shenState == 0 then
            level = self.lv_Old
            return level
        end
        level = self.shenshiLv
    end
    return level
end

