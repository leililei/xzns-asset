---固定等级属性
function CardData:CalcNowSumPropByLevel(level)
    self:OnUpdateBaseAttrByLevel(level)
    self.NowSumPropByLevel:OnInit(self.cfg.Elements)
    self:AddAllAttr(self.BasePropByLevel, self.NowSumPropByLevel)
    self:CalculateRoleByLevel()
    self:CalculatePowerByLevel()
end

-----计算角色最终属性
---@param attrFunType AttrFunType 更新属性类型
function CardData:CalculateRoleByLevel()
    local attrtype = _G.AttrType
    local attributeManager = _G.AttributeClassManager:GetInstance()
    local mAttr = attributeManager:GetAttribtueClass(self.cfg.Elements)
    local nowSumProp = self.NowSumPropByLevel

    for _, value in pairs(attrtype) do
        local attrId = value.ID
        --- 伤害类属性  计算方式:∑各处数值
        if value.proptype == 3 then
            local addPercent1 = nowSumProp:GetValueByID(attrId, _G.AttCountType.base)
            local addPercent2 = nowSumProp:GetValueByID(attrId, _G.AttCountType.basePercent)
            local addPercent3 = nowSumProp:GetValueByID(attrId, _G.AttCountType.other)

            mAttr:SetValueByID(attrId, addPercent1 + addPercent2 + addPercent3, false, _G.AttCountType.base)
        else
            -- 其他属性  计算方式:  （∑基础属性数值）*（1+∑基础属性数值百分比）+∑各处数值
            -- 目前基础属性=（卡牌升级升星属性+共鸣神石属性+装备基础属性+装备强化属性）
            -- （∑基础属性数值）*（1+∑基础属性数值百分比）

            local addPercent = nowSumProp:GetValueByID(attrId, _G.AttCountType.base) *
                                   (1 + nowSumProp:GetValueByID(attrId, _G.AttCountType.basePercent))
            mAttr:SetValueByID(attrId, addPercent, false, _G.AttCountType.base)

            -- +∑各处数值
            mAttr:AddValueByID(attrId, nowSumProp:GetValueByID(attrId, _G.AttCountType.other), false,
                _G.AttCountType.base)

            -- 如果是数值
            if value.percentage == 0 then
                ---四舍五入
                mAttr:SetValueByID(attrId, _G.Mathf.RoundToInt(mAttr:GetValueByID(attrId, _G.AttCountType.base)), false,
                    _G.AttCountType.base)
            end
        end
    end
    attributeManager:PutAttribtueClass(nowSumProp)
    self.NowSumPropByLevel = mAttr
end

-----计算战力
---@param item EquipmentItem 装备item
function CardData:CalculatePowerByLevel()
    self.powerbylevel = self.NowSumPropByLevel:CalculatePower()
end

