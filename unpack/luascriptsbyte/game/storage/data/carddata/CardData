function CardData:AddAllAttr(baseProp, sumProp)
    local attributeManager = _G.AttributeClassManager:GetInstance()

    local attr = attributeManager:GetAttribtueClass(self.cfg.Elements)
    -- 魂链 是否激活
    if self.soulLink_IsActivate == 1 then
        self.Changehunlian_exclusive = require("CardHunLianManger"):GetInstance():CalAttributeBase(self.sid,
            self.soulLink_lv)
        attributeManager:AddAttribute(attr, self.Changehunlian_exclusive)
        self.Changehunlian_attribute = require("CardHunLianManger"):GetInstance():CalAttribute(self.sid,
            self.soulLink_lv)
        if not _G.table.isEmptyOrNil(self.Changehunlian_attribute) then
            attributeManager:AddAttribute(attr, self.Changehunlian_attribute)
        end
    end
    self.ChangeDecoration = self:GetDecorationProp()
    self.ChangeCarving = self:GetCarvingProp()
    attributeManager:AddAttribute(attr, baseProp, true)
    attributeManager:AddAttribute(attr, self.ChangeeuqipAttr, true)
    attributeManager:AddAttribute(attr, self.ChangeArtifactAttr, true)
