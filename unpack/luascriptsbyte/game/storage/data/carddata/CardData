    local indexs = {}

    for key, equip in pairs(self.EquipBar) do
        if not table.isEmptyOrNil(equip) then
            table.insert(indexs, key)
        end
    end
    if #indexs < 1 then
        call(true)
    else
        require("EquipmentModel"):GetInstance():UnfixEquip(self.uid, indexs, function()
            for _, equip in pairs(self.EquipBar) do
