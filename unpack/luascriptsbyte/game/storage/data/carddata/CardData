    else
        self.star = self.star + 1
    end
    self:OnUpdateBaseAttr()
    self:UpdataGetSkills()
    self:CalcNowSumProp()
    _G.StorageManager:GetInstance():OnChangeItemData(_G.StorageID.Card, self.uid, _G.CardChangeType.UpStar)
    _G.StorageManager:GetInstance():UpdateCardStarCount(s_star, self.star)
    require "IllustrationModel":GetInstance():ChangeMaxStar(self.sid, self.star)
    require "HeroGiftPackSynModel":GetInstance():StarDengJi(self.star, self.sid)
    require "HeroMegganModel":GetInstance():ExternalUnLockHero(self.sid, self.star)
    require "FriendHelpModel":GetInstance():RefreshSetPoint()
    _G.Events:GetInstance():Broadcast(_G.eCard.CardChangeStar, self, s_star, self.star)
end

