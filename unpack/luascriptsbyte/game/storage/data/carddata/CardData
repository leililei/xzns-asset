function CardData:UpdataGetSkills()
    local mySkills = {}
    local card_skills_cfg = _G.ConfigManager.card_skills_cfg
    local skillLvList
    if self.lv > 0 then
        local card_level_Item = _G.ConfigManager.card_level_cfg[self.lv]
        skillLvList = card_level_Item.level_skill[self.cfg.Order]
    end

    local skillid, skillCfg, skilllv
    local sid = require "CardCommentManager":GetInstance():CardData(self.sid, false)
    local id = self.sid
    if sid.CradSid then
        id = sid.CradSid
    end

    if skillLvList ~= nil then
        for i = 1, 8 do
            if i ~= 6 and i ~= 7 then
                if i ~= 8 then
                    skilllv = skillLvList[i]
                elseif self.cfg.Order and self.cfg.Order == 7 then
                    local conds = _G.ConfigManager.discrete_cfg[100148]
                    skilllv = 0
                    local condVal
                    for j = 1, #conds do
                        if conds[j][1] == 1 then
                            condVal = self.lv
                        elseif conds[j][1] == 2 then
                            condVal = self.star
                        elseif conds[j][1] == 3 then
                            condVal = self:GetPotentialLv()
                            -- elseif conds[j][1] == 4 then
                            --     condVal = _G.table.count(self.open_inborn)
                        end
                        if condVal < conds[j][2] then
                            break
                        end
                        skilllv = j
                    end
                end
                if skilllv ~= nil and skilllv > 0 then
                    skillid = id + i * 100 + skilllv
                    skillCfg = card_skills_cfg[skillid]
                    if skillCfg ~= nil then
                        mySkills[i] = {
                            skillId = skillid,
                            cfg = skillCfg
                        }
                    end
                end
            end
        end
        --- 当前技能
        self.Skills = {
            -- 绝招
            skill_1 = mySkills[1] and mySkills[1].skillId or 0,
            -- 普攻
            skill_2 = mySkills[2] and mySkills[2].skillId or 0,
            -- 小技能 1
            skill_3 = mySkills[3] and mySkills[3].skillId or 0,
            -- 小技能 2
            skill_4 = mySkills[4] and mySkills[4].skillId or 0,
            -- 小技能 3
            skill_5 = mySkills[5] and mySkills[5].skillId or 0
        }
        if self.cfg.Order and self.cfg.Order == 7 then
            self.Skills.skill_8 = mySkills[8] and mySkills[8].skillId or 0
        end
    end
end

