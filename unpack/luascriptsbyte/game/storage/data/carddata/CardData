---保存神器类
---@param msg table 服务器下发的卡牌数据
function CardData:SaveArtifactData(msg, isTemp)
    if msg == nil then
        return
    end
    if msg.artifact == nil or msg.artifact == 0 then
        return
    end
    if msg.artifact[1] == nil then
        return
    end
    local artifactMsg = msg.artifact[1]
    local artifact
    if msg.artifact_is_demo == 1 then
        artifact = require("ArtifactTimerData").New()
        isTemp = true -- 试玩一定不进库
    else
        artifact = _G.ArtifactData.New()
    end
    artifact:Parse(artifactMsg)
    artifact:BindCard(self.uid)
    self:PutOnArtifact(artifact)
    if not isTemp then
        _G.StorageManager:GetInstance():AddItemByArtifactData(artifact)
    end
end

---穿戴神器
function CardData:PutOnArtifact(artifactData)
    self.ArtifactBar = artifactData
end

---保存灵契类
---@param msg table 服务器下发的卡牌数据
function CardData:SaveSpiritualData(msg, isTemp, notClear)
    if msg == nil then
        return
    end
    if isTemp and not notClear then
        self.SpiritualBar = {}
    end
    if _G.table.isEmptyOrNil(msg.spiritual) then
        return
    end
    for _, v in pairs(msg.spiritual) do
        local spiritual = _G.SpiritualData.New()
        spiritual:Parse(v)
        spiritual:BindCard(self.uid, v.index)
        self:PutOnSpiritual(spiritual)
        if not isTemp then
            _G.StorageManager:GetInstance():AddItemBySpiritualData(spiritual)
        end
    end
end

---穿戴灵契
function CardData:PutOnSpiritual(spiritualData)
    if spiritualData.index and spiritualData.index > 0 then
        self.SpiritualBar[spiritualData.index] = spiritualData
    end
end

---脱下灵契
function CardData:TakeOffSpiritual(index)
    self.SpiritualBar[index] = nil
end

