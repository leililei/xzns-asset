---获取当前卡牌觉醒提供的属性加成
function CardData:GetCardAwakenAttr()
    local data = _G.AttributeClassManager:GetInstance():GetAttribtueClass(self.cfg.Elements)
    if self.awaken == 0 then
        return data
    end
    local mcard_awaken_cfg = _G.ConfigManager.card_awaken_cfg[self.sid]
    if mcard_awaken_cfg then
        local attribute = mcard_awaken_cfg.attribute
        if attribute then
            local attribute_cfg = _G.ConfigManager.attribute_cfg
            local index = self.awaken

            for i = 1, index do
                local tmp
                local attributeId = attribute[i]
                local attributeInfo = attribute_cfg[attributeId]
                if attributeInfo then
                    tmp = _G.tonumber(attributeInfo.attribute[1][3])

                    if _G.AttrType[attributeInfo.attribute[1][1]].proptype == 1 then
                        if _G.tonumber(attributeInfo.attribute[1][2]) == 1 then
                            data:AddValueByName(attributeInfo.attribute[1][1], tmp, false, _G.AttCountType.other)
                        else
                            tmp = tmp * 0.0001
                            data:AddValueByName(attributeInfo.attribute[1][1], tmp, false, _G.AttCountType.basePercent)
                        end
                    else
                        tmp = tmp * 0.0001
                        data:AddValueByName(attributeInfo.attribute[1][1], tmp, false, _G.AttCountType.basePercent)
                    end
                end
            end
        end
    end

    return data
end

---卡牌本身属性
---@param star number 星级  空-当前
---@param lv number 等级  空-当前
function CardData:CalcAttr(stype, star, lv)
    if star == nil then
        star = self.star
    end
    if lv == nil then
        lv = self.lv
    end

    local _value = 0

    -- （除以10000）
    local percentReckon = 1 / 10000

    ----@type card_cfg
    -- local cardConfig = _G.ConfigManager.card_cfg[self.sid]

    _value = self:CalcAttrSelfBase(stype, star, lv)
    if _value == nil then
        _value = self:CalcAttrSelfState(stype, star, lv)
        if _value == nil then
            -- 判断属性类型
            _value = self.cfg[stype]
            if _G.AttrType[stype].percentage == 0 then
            elseif _G.AttrType[stype].percentage == 1 then
                if _value ~= nil then
                    _value = _value * percentReckon
                end
            end
        end
    end

    return _value
end

---卡牌 属性计算 基础属性  生命.攻击.物防.法防
function CardData:CalcAttrSelfBase(stype, star, lv)
    local _value = nil

    -- 只计算此四属性
    if _G.AttrType[stype].proptype ~= 1 then
        return _value
    end

    ---@type card_cfg
    -- local cardConfig = _G.ConfigManager.card_cfg[self.sid]
    local card_starConfig = _G.ConfigManager.card_star_cfg[require("CardInfoManager"):GetInstance():GetStarCfgId(
        self.cfg.Elements_new, star)]
    local card_levelConfig = _G.ConfigManager.card_level_cfg[lv]

    if nil == self.cfg or nil == card_starConfig or nil == card_levelConfig then
        return 0
    end

    -- （除以10000）
    local percentReckon = 1 / 10000

    local cardValue = self.cfg[stype]
    if cardValue == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("!!! card_cfg 字段:" .. stype .. " 为空")
        end
        cardValue = 1
    end
    local card_starValue = card_starConfig.att_base
    if card_starValue == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("!!! card_star_cfg 字段:" .. stype .. " 为空")
        end
        card_starValue = 1
    end

    ---卡牌基础生命*(升星生命倍率 * 0.0001)
    _value = cardValue * (card_starValue * percentReckon)
    -- 计算   卡牌生命*升星生命倍率 + 卡牌生命成长*升星生命成长倍率*升级生命成长倍率

    local function getValue(growthKey)
        local cardGrowth = self.cfg[growthKey]
        if cardGrowth == nil then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("!!! card_cfg 字段:" .. stype .. " 为空")
            end
            cardGrowth = 1
        end
        local card_starGrowth = card_starConfig.att_growth
        if card_starGrowth == nil then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("!!! card_star_cfg 字段:" .. stype .. " 为空")
            end
            card_starGrowth = 1
        end
        local card_levelGrowth = card_levelConfig.att_growth
        if card_levelGrowth == nil then
            if _G.AppSetting.DEBUG then
                _G.LogWarning("!!! card_level_cfg 字段:" .. stype .. " 为空")
            end
            card_levelGrowth = 1
        end
        --- (卡牌生命成长 * 0.0001) * (升星生命成长倍率 * 0.0001) * (升级生命成长倍率 * 0.0001)
        return (cardGrowth * percentReckon) * (card_starGrowth * percentReckon) * (card_levelGrowth * percentReckon)
    end

    if stype == _G.AttrType.max_hp.key then
        _value = _value + getValue("hp_growth")
    elseif stype == _G.AttrType.atk.key then
        _value = _value + getValue("atk_growth")
    elseif stype == _G.AttrType.def.key then
        _value = _value + getValue("def_growth")
    elseif stype == _G.AttrType.bre.key then
        _value = _value + getValue("bre_growth")
    end

    -- 四舍五入
    if _value ~= nil then
        _value = _G.Mathf.RoundToInt(_value)
    end

    return _value
end

---卡牌 属性计算 状态属性 命中.闪避.暴击.抗暴击
function CardData:CalcAttrSelfState(stype, star)
    -- 【card_cfg中hit_rate字段/10000】
    ---@type card_cfg
    -- local cardConfig = _G.ConfigManager.card_cfg[self.sid]
    local _value = nil

    -- 只计算此四属性

    if _G.AttrType[stype].proptype ~= 2 then
        return _value
    end

    -- （除以10000）
    local percentReckon = 1 / 10000

    local t_cardValue = self.cfg[stype]
    if t_cardValue == nil then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("!!! card_cfg 字段:" .. stype .. " 为空")
        end
        t_cardValue = 1
    end

    _value = t_cardValue * percentReckon

    return _value
end

