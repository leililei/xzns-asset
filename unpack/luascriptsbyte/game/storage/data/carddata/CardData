------计算 卡牌 当前属性
---@param attrFunType AttrFunType 更新属性类型
function CardData:CalcNowSumProp(attrFunType)
    --     （∑基础属性数值）*（1+∑基础属性数值百分比）+∑各处数值
    -- 目前基础属性=（卡牌升级升星属性+共鸣神石属性+装备基础属性+装备强化属性）

    if nil == attrFunType then
        attrFunType = _G.AttrFunType.All
    end

    if attrFunType == _G.AttrFunType.All then
        --- 获取共鸣神石等级
        self.lv = self:GetLevel()
        self:UpdateAttr()
        self.NowSumProp:OnInit(self.cfg.Elements)

        ---装备属性
        self.ChangeeuqipAttr = self:GetEquipPropValueAll()
        ---神器属性
        self.ChangeArtifactAttr = self:GetArtifactAttribute()
        ---神器图鉴属性
        self.ChangeArtifactIllAttr = require("ArtifactIllustrationModel"):GetInstance():GetillAttr()
        if not _G.AppSetting.IsOverseas then
            ---灵契属性
            self.ChangeSpiritualAttr = self:GetSpiritualAttribute()
            ---灵契图鉴属性
            self.ChangeSpiritualIllAttr = require("SpiritualIllustrationModel"):GetInstance():GetillAttr()
        end
        ---职业树属性
        self.ChangeTreeAttr = require("PlayerTreeModel"):GetInstance():GetGrowProp(self:GetProfessional())
        ---营地（灵珠）
        -- self.ChangecampAttr =
        --     require("CampsiteModel"):GetInstance():GetCampOneAttribute(self.campid, self.Grade, self:GetCampStar())
        ---地狱道
        self.ChangehellAttr = require("HellRoadModel"):GetInstance():GetAllAttr()
        ---称号和光环
        self.ChangetitleAndHaloAttr = _G.SystemSettingManager:GetInstance():GetTitleAndHaloAttribute()
        ---合击技
        self.ChangecombineAttr = require "CombineModel":GetInstance():GetAllAttribute()
        ---羁绊
        -- self.ChangefetterAttr = require "CardFetterManager":GetInstance():GetCardActiveAttr(self.sid)
        ---藏品
        self.ChangeCollectionAttr = require("CollectionModel"):GetInstance():GetAllAttribute()
        -- 阵法全队
        -- self.ChangegeatherSoulAttrOnce = require "GeatherSoulArrayModel":GetInstance():GetAllAttrByOnce()
        -- 阵法阵上
        -- self.ChangegeatherSoulAttr = require "GeatherSoulArrayModel":GetInstance():GetAllAttribute(self.uid)
        ---公会奥义
        self.ChangeSociatyProfoundAttr = require "SociatyProfoundModel":GetInstance():GetAllAttribute(
            self:GetElement_new())
        -- 天赋
        self.ChangetalentAttr = self:GetTalentAttribute()
        -- 觉醒
        self.ChangePotentialAttr = self:GetPotentialAttribute()
        ---皮肤属性
        self.CardPF = require "CardCommentManager":GetInstance():GetCardPF(self.sid)
        ---全局皮肤属性
        self.CardPFAll = require "CardCommentManager":GetInstance():GetAllCardSkinAttr()
        ---VIP加成
        self.VipAttr = require("VIPPrivilegeModel"):GetInstance():GetAllAttribute()
        ---位面之子加成
        self.StoneAttr = require("CardResonanceModel"):GetInstance():GetAllAttribute()
        ---神石养成加成
