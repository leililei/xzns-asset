function CardData:SetCostCardList(sids)
    if sids == nil then
        return
    end
    -- (卡牌 5升6，不记录 5星 本体卡)
    if self.star == 6 then
        return
    end
    local sidDic = {}
    local sid
    for i = 1, #sids do
        sid = sids[i]
        if sidDic[sid] == nil then
            sidDic[sid] = 0
        end
        sidDic[sid] = sidDic[sid] + 1
    end
    for sid, num in pairs(sidDic) do
        self:SetCostCardList_2(sid, num)
    end
end

---设置
---@param sid number 被消耗的 卡牌sid
---@param value number 被消耗 卡牌的 数量
function CardData:SetCostCardList_2(sid, value)
    if _G.table.isEmptyOrNil(self.cost_card_list) then
        local data = {
            k = sid,
            v = value
        }
        _G.table.insert(self.cost_card_list, data)
        return
    end
    local flag = false
    local index = 0
    for i = 1, #self.cost_card_list do
        local temp = self.cost_card_list[i]
        if temp.k == sid then
            flag = true
            index = i
            break
        end
    end
    if flag then
        self.cost_card_list[index].v = self.cost_card_list[index].v + value
    else
        index = #self.cost_card_list + 1
        -- self.cost_card_list[index] = {}
        local data = {
            k = sid,
            v = value
        }
        _G.table.insert(self.cost_card_list, data)
    end
end

