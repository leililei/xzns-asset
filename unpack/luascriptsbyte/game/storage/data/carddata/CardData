function CardData:JiaShuJu(CardData)
    local illustrationsCaedData = _G.ConfigManager.illustrations_card_cfg[CardData.sid]
    ---@type  prop.i_card 数据
    local msg = {}
    msg.sid = illustrationsCaedData.id
    msg.lv = illustrationsCaedData.level
