        ---建筑图鉴（仅作用于卡牌）
        self.BuildFetterAttr = require("BuildFetterModel"):GetInstance():GetBuildFetterAttribute()
        ---建筑基础属性（仅计算建筑四维以及等级 星级的成长率）
