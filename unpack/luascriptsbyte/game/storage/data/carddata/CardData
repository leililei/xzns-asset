-- region 子类重写
---物品数据解析(类重写数据解析)
---@param msg prop.i_card 数据
function CardData:ParseInitMsg(msg)
    self.sid = msg.sid and msg.sid or msg[1]
    self.count = msg.count and msg.count or 1
    self.lv = msg.lv ~= nil and msg.lv or 1
    self.lv_Old = msg.lv ~= nil and msg.lv or 1
    self.exp = 0
    -- msg.base.exp

    self.cfg = require "CardCommentManager":GetInstance():CardData(self.sid, true)
    -- 設置營地 id
    self.campid = self.cfg.Elements + 100
    -- 卡牌的类型（1-人卡，2-灵卡，3-小怪，4-精英，5-boss）
    self.cardType = self.cfg.UnitType
    self.awaken = msg.awaken ~= nil and msg.awaken or 0

    self.Icon = "Images/zRoles/" .. self.cfg.Icon
    self.Grade = self.cfg.Order
    self:CardAwakenChoose()

    self.unlock = msg.unlock ~= nil and msg.unlock or 0
    --- 当前皮肤 默认0原皮
    self.skin = msg.skin or 0
    self.star = msg.star ~= nil and msg.star or self.cfg.Star
    self.uid = msg.uid and msg.uid or msg[2]
    self.quality = 1
    -- msg.quality_info.quality
    -- 魂链等级
    self.soulLink_lv = msg.soul_chain_lv or 0
    -- 魂链 是否激活
    self.soulLink_IsActivate = msg.soul_state or 0
    -- 天赋
    self.open_inborn = msg.open_inborn or {}
    -- 天赋点
    self.inborn_num = msg.inborn_num or 0
    ---天赋大点
    self.big_born_num = msg.big_born_num or 0
    -- 消耗材料获得的天赋点
    self.inborn_cost_num = msg.inborn_cost_num or 0
    -- 觉醒等级
    self.potential = msg.awaken_lv or 0
    local attributeManager = _G.AttributeClassManager:GetInstance()
    -- 卡牌自身计算后属性
    ---@type AttributeClass
    self.BaseProp = attributeManager:GetAttribtueClass(self.cfg.Elements)
    -- 卡牌总属性
    ---@type AttributeClass
    self.NowSumProp = attributeManager:GetAttribtueClass(self.cfg.Elements)

    -- 卡牌自身计算后属性
    ---@type AttributeClass
    self.BasePropByLevel = attributeManager:GetAttribtueClass(self.cfg.Elements)
    -- 卡牌总属性
    ---@type AttributeClass
    self.NowSumPropByLevel = attributeManager:GetAttribtueClass(self.cfg.Elements)

    if _G.AppSetting.IsXzns then
        self.awaken_cards = msg.awaken_cards
    end

    self.maxCount = 11
    -- local value, ID = require "CardCommentManager":GetInstance():CardWearSkin(self.sid)
    self.skin = 0
    self:InitAttrDic()
    self:UpdataGetSkills()
    self:SetSkin()
    self.msg = msg
    self.cost_card_list = msg.cost_card_list or {}

    -- require("RedPointManager"):GetInstance():RefreshNode(
    --     _G.ConfigManager.redpoint_cfg.SkinCard.id,
    --     self.uid
    -- )
end

function CardData:ParseExtend(extend)
    if not self.cfg then
        return
    end
    self.star = extend[1] or self.cfg.Star
end

--- 设置卡牌属性 访问其他功能模块
---初始化交互数据
function CardData:OnInitMutuallyData(isTemp, doCalc, notClear)
    if nil == doCalc then
        doCalc = true
    end
    self:SaveEquipmentData(self.msg, isTemp)
    self:SaveDecorationData(self.msg, isTemp)
    self:SaveCarvingData(self.msg, isTemp)
    if not _G.Application.IsOverseas then
        self:SaveSpiritualData(self.msg, isTemp, notClear)
    end
    self:SaveArtifactData(self.msg, isTemp)
    if doCalc then
        self:CalcNowSumProp()
    end

    self.msg = nil
end

-- endregion

function CardData:SaveEquipmentData(msg, isTemp)
    if msg == nil then
        return
    end
    if (msg.equip ~= nil) then
        msg.equipments = msg.equip
    end
    if msg.equipments == nil then
        return
    end
    local equips = msg.equipments
    local cfg = _G.ConfigManager.equipment_cfg
    ---身上装备不在入库
    -- local equipList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Equipment)
    local equip
    for i = 1, #equips do
        equip = _G.EquipmentItem.New()
        equip:Parse(equips[i])
        equip:PutEquip(self.uid, self.cfg.Elements_new, isTemp)
        ---处理未选择的随机属性
        equip:SelectReset(equips[i])
        equip:SelectResetElement(equips[i])

        self.EquipBar[cfg[equip.sid].parts] = equip
        -- equipList[equip.uid] = equip
    end
end

---保存饰品类
---@param msg table 服务器下发的卡牌数据
function CardData:SaveCarvingData(msg)
    if msg == nil then
        return
    end
    if not msg.carving_slot then
        return
    end

    local carvings = msg.carving_slot

    if carvings then
        local carving
        for _, v in pairs(carvings) do
            if v.carving then
                carving = _G.CarvingData.New()
                carving:Parse(v.carving)
                carving.slotLevel = v.level
                self.CarvingBar[v.index] = {
                    slotLevel = v.level,
                    carving = carving,
                    index = v.index
                }
            else
                self.CarvingBar[v.index] = {
                    slotLevel = v.level,
                    index = v.index
                }
            end
        end
    end
end

function CardData:MaxCarvingLv()
    for _, v in pairs(self.CarvingBar) do
        v.slotLevel = 100
    end
end

function CardData:GetTotalCarvingLv()
    local total = 0
    for _, v in pairs(self.CarvingBar) do
        if v.slotLevel then
            total = total + v.slotLevel
        end
    end
    return total
end

-- 更新符文数据
function CardData:UpdateCarvingData(data)
    for _, v in pairs(self.CarvingBar) do
        if v.carving and v.carving.uid == data.uid then
            v.carving:ParseInitMsg(data)
        end
    end
end

-- 根据类型获取抗魔值
function CardData:GetAbyssalMaw(parts)
    local resistance = 0
    for _, v in pairs(self.CarvingBar) do
        if v.carving and v.carving.parts == parts then
            resistance = resistance + v.carving:GetAbyssalMaw()
        end
    end
    return resistance
end

