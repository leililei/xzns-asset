local base = require "BaseItemData"
---@class RelicTeamBuffData : BaseItemData	中文描述
local RelicTeamBuffData = _G.BaseClass("RelicTeamBuffData", base)
_G.RelicTeamBuffData = RelicTeamBuffData

function RelicTeamBuffData:__init()
end

---物品数据解析(类重写数据解析)
function RelicTeamBuffData:ParseInitMsg(msg)
    self.sid = msg.sid
    self.count = msg.num
    self.cfg = _G.ConfigManager[_G.NoInitTypeToCfg[msg.sidType]][self.sid]
    ---数据兼容
    self.Grade = self.cfg.grade or self.cfg.Grade
end

---碎片数量
---@return number 数量
function RelicTeamBuffData:GetCount()
    return self.count
end

function RelicTeamBuffData:GetOrder()
    return self.Grade
end

function RelicTeamBuffData:GetGrade()
    return self.Grade
end

return RelicTeamBuffData
