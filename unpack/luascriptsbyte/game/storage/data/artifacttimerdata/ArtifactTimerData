local base = _G.ArtifactData
---@class ArtifactTimerData:ArtifactData
local ArtifactTimerData = _G.BaseClass("ArtifactTimerData", base)
---类的构造函数
function ArtifactTimerData:__init()
    self.type = _G.ArtifactDataType.Timer
end

function ArtifactTimerData:SetTime(time)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.endTime = time
    local offset = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if offset < 0 then
        offset = 1
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(offset, self.OnTimeOver, self, true, false, true)
    self.timer:Start()
end

function ArtifactTimerData:OnTimeOver()
    if self.cardUid ~= 0 then
        ---@type CardData
        local card = _G.StorageManager:GetInstance():GetDatasByUid(_G.StorageID.Card, self.cardUid)
        card.ArtifactBar = {}
        self:UnbindCard()
    end
    require "ArtifactDemoModel":GetInstance():RemoveArtifact(self.uid)
    _G.Events:GetInstance():Broadcast(_G.ArtifactShow.ArtifactTimeOver, self.uid)
    self:Dispose()
end

function ArtifactTimerData:GetCountDown()
    return self.endTime - _G.TimeUtil.GetServerUnixTime()
end

function ArtifactTimerData:CanDevelop()
    return false, false, false
end

function ArtifactTimerData:CanLvUp()
    return false
end

function ArtifactTimerData:CanStarUp()
    return false
end

function ArtifactTimerData:CanAwaken()
    return false
end

function ArtifactTimerData:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return ArtifactTimerData
