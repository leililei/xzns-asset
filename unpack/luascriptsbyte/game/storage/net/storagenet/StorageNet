---@class StorageNet : BaseGameNet	仓库通信协议
local StorageNet = _G.BaseClass("StorageNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return StorageNet StorageNet
function StorageNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---登录请求
---@param pbData table PB数据
---@param callback function 完成回调
function StorageNet:GetData(pbData, callback)
    local item = _G.ConfigManager.net_map.game_storage_get
    local port = base.Access(self, item, pbData, _G.handler(self, self.GetDataCall))
    self.Call[port] = callback
end

---登录请求回调
---@param port number 中文描述
---@param data login.ReplyLogin 返回PB数据
---@param error string 错误信息
function StorageNet:GetDataCall(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析

    if self.Call[port] then
        self.Call[port](data, port)
        self.Call[port] = nil
    end
end
---使用道具请求
---@param pbData table PB数据
---@param callback function 完成回调
function StorageNet:PropUse(pbData, callback, SucCall)
    local item = _G.ConfigManager.net_map.game_storage_use
    local port = base.Access(self, item, pbData, _G.handler(self, self.UseSuccessCall))
    self.Call[port] = callback
end

---批量使用道具
function StorageNet:PropBatchUse(pbData, callback)
    local item = _G.ConfigManager.net_map.game_storage_batch_use
    local port = base.Access(self, item, pbData, _G.handler(self, self.UseSuccessCall))
    self.Call[port] = callback
end

---物品使用成功回调
---@param port number 中文描述
---@param data login.ReplyLogin 返回PB数据
---@param error string 错误信息
function StorageNet:UseSuccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

--- 解锁背包栏位
---@param pbData storage.c2s_storage_unlock PB数据
---@param callback function 完成回调
function StorageNet:CardBag(pbData, callback, _)
    local item = _G.ConfigManager.net_map.game_storage_unlock
    local port = base.Access(self, item, pbData, _G.handler(self, self.CardBagSuccessCall))
    self.Call[port] = callback
end

---解锁背包栏位成功回调
---@param port number 中文描述
---@param data public.s2c_common_ack 返回PB数据
---@param error string 错误信息
function StorageNet:CardBagSuccessCall(port, data, error)
    if error then
        return
    end

    if data.ack == 1 then
        local manager = _G.StorageManager:GetInstance()
        manager:AddCapacityTimes(_G.StorageID.Card)
        local Diamond = _G.ResPropID.Diamond
        local consume = _G.ConfigManager.storage_cfg[_G.StorageID.Card].extension_consumption
        manager:ConsumeItem(Diamond, 0, consume)
        if self.Call[port] then
            self.Call[port](data)
            self.Call[port] = nil
        end
    end
end

---购买
---@param id number exchange_cfg_Item的id
---@param num number 购买数量
---@param type number 兑换类型(1:exchange_cfg 兑换;2:item_repeat_cfg)
---@param callback function 完成回调
function StorageNet:PropBuy(id, num, type, callback)
    local item = _G.ConfigManager.net_map.game_exchange_port_exchange
    local pbData = {sid = id, num = num, type = type}
    local port = base.Access(self, item, pbData, _G.handler(self, self.BuySuccessCall))
    self.Call[port] = callback
end
