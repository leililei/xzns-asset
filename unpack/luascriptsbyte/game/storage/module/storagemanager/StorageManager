---获取道具显示
---@param Parent UnityEngine.GameObject  Parent有GoTable组件
---@param call function<table,number>  Item加载完成返回<itemlua,storageType>
function StorageManager:GetItem(Parent, sid, num, call, OnBtnCall)
    local storageType, storageID = self:CheckSidType(sid)

    local ItemGoTable = _G.GetAutoGoTable(Parent)
    if ItemGoTable.DataDic == nil then
        ItemGoTable.DataDic = {}
    end
    ItemGoTable.DataDic[storageType] = {sid, num}

    if ItemGoTable.ItemLuaDic == nil then
        ItemGoTable.ItemLuaDic = {}
    end

    local ItemLua = ItemGoTable.ItemLuaDic[storageType]

    if ItemLua == nil then
        ItemGoTable.ItemLuaDic[storageType] = true
        local data = ItemData[storageType].New()
        data:Parse({
            sid = sid,
            uid = sid,
            count = num
        })
        ItemBase[storageType].Create(data, Parent, function(itemLua)
            ItemGoTable.ItemLuaDic[storageType] = itemLua
            if call ~= nil then
                call(itemLua, storageType)
            end
        end, OnBtnCall)
    elseif ItemLua ~= true then
        if storageType == _G.StorageType.Material or storageType == _G.StorageType.ResProp or storageType ==
            _G.StorageType.Debris then
            ---@type ItemViewBase
            local lua = ItemLua
            lua:ShowCount(num)
            lua:SetImage(sid)
        end
        if call ~= nil then
            call(ItemLua, storageType)
        end
    end
end

