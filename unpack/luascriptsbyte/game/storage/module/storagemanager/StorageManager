function StorageManager:GetItemView()
    if self.itemViewArray == nil or #self.itemViewArray <= 0 or self.isLoadItemView then
        return
    end
    local info = self.itemViewArray[1]
    local storageType, storageID = self:CheckSidType(info.Sid)
    if not ItemBase[storageType] or not info.Parent then
        _G.table.remove(self.itemViewArray, 1)
        self:GetItemView()
        return
    end
    self.isLoadItemView = true
    local data
    if info.Uid and info.Uid > 0 then
        data = self:GetItemDataByID(storageID, info.Uid)
    end
    if not data then
        data = self:GetItemDataClass(info.Sid, info.Count, info.Extend)
    end
    if data and not _G.IsNil(info.Parent) then
        ItemBase[storageType].Create(data, info.Parent, _G.handler(self, self.OnGetItemViewCall), info.OnBtnCall)
    else
        self:OnGetItemViewCall()
    end
end

