---解析灵契奖励
---@param data award.i_award_item
function StorageManager:ParseSpiritualAward(data)
    local Storages = self.Storages[_G.StorageID.Spiritual]
    if not Storages then
        if _G.AppSetting.DEBUG then
            _G.LogError("Spiritual Storages is nil")
        end
        return
    end
    ---@type SpiritualData
    local Spiritual = Storages:ParseSimpleAward(data)
    self:SaveAwardData(Spiritual, Spiritual:GetCount(), _G.StorageID.Spiritual)
    require "SpiritualIllustrationModel":GetInstance():GainSpiritual(Spiritual.sid)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SpiritualPage.id)
    ---自动分解检测
    local SpiritualAutoDecompose = _G.PlayerPrefsManager.GetTable(_G.PlayerPrefsKey.SpiritualAutoDecompose)
    local keepBol = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.SpiritualAutoDecomposeKeepBol, 1)
    if not SpiritualAutoDecompose or _G.TableIsEmpty(SpiritualAutoDecompose) then
        SpiritualAutoDecompose = {}
    end
    local grade = _G.StorageManager:GetInstance():GetItemGrade(data[1], data[2])
    if SpiritualAutoDecompose[grade] then
        if keepBol == 0 or require "SpiritualIllustrationModel":GetInstance():CheckSpiritualUnlock(data[1]) then
            self.spiritualDecomposeList = self.spiritualDecomposeList or {}
            local haveBol
            for k, v in pairs(self.spiritualDecomposeList) do
                if v.uid == data[2] then
                    v.num = v.num + data[3]
                    haveBol = true
                end
            end
            if not haveBol then
                self.spiritualDecomposeList[#self.spiritualDecomposeList + 1] = {
                    uid = data[2],
                    num = data[3]
                }
            end
            if not self.spiritualDecomposeTimer then
                -- 延迟两秒统一分解
                self.spiritualDecomposeTimer = _G.TimerManager:GetInstance():GetTimer(2, self.AutoDecomposeSpiritual,
                    self, true)
                self.spiritualDecomposeTimer:Start()
            end
            return
        end
    end
end

---灵契自动分解
function StorageManager:AutoDecomposeSpiritual()
    if self.spiritualDecomposeTimer ~= nil then
        self.spiritualDecomposeTimer:Stop()
        self.spiritualDecomposeTimer = nil
    end
    local decList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Spiritual)
    local selectList = {}
    for k, v in pairs(self.spiritualDecomposeList) do
        if decList[v.uid] then
            _G.table.insert(selectList, v)
        end
    end
    if #selectList == 0 then
        self.spiritualDecomposeList = {}
        return
    end
    local pbData = {
        uids = selectList
    }
    require "SpiritualNet":GetInstance():Decompose(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        for _, v in pairs(pbData.uids) do
            self:ConsumeSpiritual(v.uid, v.num)
        end
        self.spiritualDecomposeList = {}
        self:ReceiveAwardData(msg)
        local awardData = self:MergeAwardList(msg.award.item)
        if msg.award then
            _G.DelayDo(1, function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeTipsView.Name,
                    {{awardData[1][1], awardData[1][2]}})
            end)
        end
    end)
end

