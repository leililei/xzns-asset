---获取卡牌该部位是否有绑定装备
---@param sid number CardSid
---@param buwei number 部位
---@return boolean
function StorageManager:GetCardIsBound(sid, buwei)
    if not _G.table.isEmptyOrNil(self.boundCards) then
        if self.boundCards[sid] then
            for i = 1, #self.boundCards[sid] do
                if self.boundCards[sid][buwei] and self.boundCards[sid][buwei] > 0 then
                    return true
                end
            end
        end
    end
    return false
end

---设置卡牌绑定的装备
function StorageManager:SetCardEquipBound(csid, esid, buwei)
    if not csid then
        return
    end
    if self.boundCards then
        if self.boundCards[csid] then
            if self.boundCards[csid][buwei] == 0 then
                self.boundCards[csid][buwei] = esid
            end
        else
            self.boundCards[csid] = {}
            self.boundCards[csid][buwei] = esid
        end
    end
end

---获取卡牌装备绑定数据回调
function StorageManager:GetCardEquipBoundCall(msg)
    self.boundCards = {}
    if msg.bound then
        for _, v in pairs(msg.bound) do
            --- e_sids  {sid,sid,sid,sid,sid 没有为0}
            self.boundCards[v.c_sid] = v.e_sids
        end
    end
end

---获取已兑换次数
