-- region 初始化仓库数据
function StorageManager:GetGoodsStorageData()
    local asyncCombiner = _G.CS.YoukiaCore.AsyncCombiner()
    local ignoreType = {_G.StorageType.RelicTeamBuff, _G.StorageType.RingGod} -- 不用初始化的仓库类型
    for _, value in pairs(_G.StorageType) do
        if not _G.table.ContainsValue(ignoreType, value) then
            local asyncHandle = asyncCombiner:CreateAsyncHandle()
            local msg = {
                types = _G.tostring(value)
            }
            StorageNet:GetInstance():GetData(msg, function(curMsg)
                self.Storages[self.StorageTypeToStorageID[value]]:Parse(curMsg, nil ~= self.StorageReconnectCallback)
                asyncHandle:Finish()
            end)
        end
    end
    asyncCombiner:AddCompletionCall(_G.handler(self, self.GetGoodsStorageSucceed))
    asyncCombiner:RefreshAsyncHandles()
end

function StorageManager:GetGoodsStorageSucceed()
    base.ParseData(self)
    if self.StorageReconnectCallback then
        self.StorageReconnectCallback()
        self.StorageReconnectCallback = nil
    end
end

