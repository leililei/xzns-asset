    end
end

---解析奖励
---@param data award.i_award_item[] 奖励数据
---@return ShowAwardData[] 返回显示的奖励
function StorageManager:ParseAward(data)
    self.CurItemTable = {}
    if data == nil then
        return
    end
    local newData = {}
    local temp = {}
    local isActivityCoin
    for k, value in ipairs(data) do
        isActivityCoin = false
        if value.type[1] == 0 then
            local act = require("ActivitySynManager"):GetInstance():GetActivityClass(value.type[2])
            if act then
                local actType = act:GetTypeId()
                if _G.table.ContainsValue(haveCoinParseFuncActivity, actType) then
                    -- SGHS-6632【春节活动】第一期祈福罗盘抽奖道具消耗后，道具TIPS界面的数量没有及时刷新
                    -- 如果活动实例接受了货币数据, 则不要将数量放入Storages, 否则在消耗时默认不会处理Storages
                    -- GetItemWayView面板中, 当活动实例代币消耗剩余为0时, 展示的是Storages缓存的数据
                    if act:GetActivityTypeCls().AddCoin then
                        act:GetActivityTypeCls():AddCoin(value.type[4])
                        isActivityCoin = true
                    elseif act:GetActivityTypeCls().SetCoin then
                        act:GetActivityTypeCls():SetCoin({
                            key = value.type[3],
                            value = value.type[4]
                        })
                        isActivityCoin = true
                    end
                end
            end
            if not isActivityCoin then
                value.type = {value.type[3], value.type[4], value.type[5], value.type[2], value.type[1]}
            end
        elseif self:IsActivityRes(value.type[1]) then
            isActivityCoin = true --表示该资源不进背包，由活动数据中监听奖励事件，通过事件对活动自己的代币数量进行改变
        end
        if not isActivityCoin then
            local itemType = value.type
            local id = itemType[1]
            local type, storageId = self:CheckSidType(id)
            if storageId == _G.StorageID.ResProp or storageId == _G.StorageID.Prop or storageId == _G.StorageID.Material or
                storageId == _G.StorageID.Debris or storageId == _G.StorageID.Remains then
                local fix = itemType[2]
                local fact = itemType[3]
                if nil == temp[id] then
                    temp[id] = {fix, fact}
                else
                    if id == _G._G.ResPropID.VipExp or not fact then
                        ---VIP没有第三个参数，所以奖励特殊处理，单独合并奖励
                        temp[id] = {fix + temp[id][1], fact}
                    else
                        if fact > temp[id][2] then
                            temp[id] = {fix, fact}
                        end
                    end
                end
            elseif storageId == _G.StorageID.Card then
                if itemType[2] > 0 then
                    table.insert(newData, value)
                else
                    require "IllustrationModel":GetInstance():JieSuoHunJiang(itemType[1])
                end
            else
                table.insert(newData, value)
            end
        end
    end

    for k, v in pairs(temp) do
        local data1 = {}
        data1.type = {k, v[1], v[2]}
        table.insert(newData, data1)
    end
    for key, value in ipairs(newData) do
        self:ParseSimpleAward(value)
    end
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, data)
    return self.CurItemTable
end

