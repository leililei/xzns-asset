---整合奖励
---@param data table 服务器下发的public.i_award
---@return table 数组{{sid,count},{sid,count}
function StorageManager:MergeAward(data)
    local list = {}
    local storageType, storageID
    if data.award then
        if data.award.item then
            for _, v in pairs(data.award.item) do
                storageType, storageID = self:CheckSidType(v.type[1])
                if storageType == _G.StorageType.Card then
                    table.insert(list, {v.type[1], 1, v.type[3]})
                elseif storageType == _G.StorageType.Equipment then
                    table.insert(list, {v.type[1], 1, v.type[4]})
                else
                    table.insert(list, {v.type[1], v.type[2]})
                end
            end
        end
        if data.award.overflow then
            for _, v in pairs(data.award.overflow) do
                storageType, storageID = self:CheckSidType(v.type[1])
                if storageType == _G.StorageType.Card or storageType == _G.StorageType.Equipment then
                    table.insert(list, {v.type[1], v.type[2], v.type[3]})
                else
                    table.insert(list, {v.type[1], v.type[2]})
                end
            end
        end
    end
    return list
end

---整合奖励带额外奖励
---@param data table 服务器下发的public.i_award
---@param double boolean 是否在双倍期间
---@return table 数组{{sid,count},{sid,count}
function StorageManager:MergeExtraAward(data, double)
    if not double then
        return self:MergeAward(data), {}
    end
    local list = {}
    local awards = {}
    local extraAward = {}
    local tmp
    local storageType, storageID
    if data.award then
        if data.award.item then
            for _, v in pairs(data.award.item) do
                storageType, storageID = self:CheckSidType(v.type[1])
                if storageType == _G.StorageType.Card then
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], 1, v.type[3]}
                    else
                        extraAward[v.type[1]] = {v.type[1], 1, v.type[3]}
                    end
                elseif storageType == _G.StorageType.Equipment then
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], 1, v.type[4]}
                    else
                        extraAward[v.type[1]] = {v.type[1], 1, v.type[4]}
                    end
                elseif storageType == _G.StorageType.Decoration then
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], 1}
                    else
                        extraAward[v.type[1]] = {v.type[1], 1}
                    end
                elseif storageType == _G.StorageType.Carving then
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], 1}
                    else
                        extraAward[v.type[1]] = {v.type[1], 1}
                    end
                else
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], v.type[2]}
                    else
                        if awards[v.type[1]][2] >= v.type[2] then
                            extraAward[v.type[1]] = {v.type[1], v.type[2]}
                        else
                            tmp = extraAward[v.type[1]]
                            extraAward[v.type[1]] = awards[v.type[1]]
                            awards[v.type[1]] = tmp
                        end
                    end
                end
            end
        end
        if data.award.overflow then
            for _, v in pairs(data.award.overflow) do
                storageType, storageID = self:CheckSidType(v.type[1])
                if storageType == _G.StorageType.Card or storageType == _G.StorageType.Equipment then
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        awards[v.type[1]] = {v.type[1], v.type[2], v.type[3]}
                    else
                        extraAward[v.type[1]] = {v.type[1], v.type[2], v.type[3]}
                    end
                else
                    if _G.table.isEmptyOrNil(awards[v.type[1]]) then
                        if (_G.ConfigManager.item_cfg[v.type[1]] or _G.ConfigManager.currency_type_cfg[v.type[1]]) and
                            double then
                            local count = math.ceil(v.type[2] / 2)
                            awards[v.type[1]] = {v.type[1], count}
                            if v.type[2] - count > 0 then
                                extraAward[v.type[1]] = {v.type[1], v.type[2] - count}
                            end
                        else
                            awards[v.type[1]] = {v.type[1], v.type[2]}
                        end
                    else
                        if awards[v.type[1]][2] >= v.type[2] then
                            extraAward[v.type[1]] = {v.type[1], v.type[2]}
                        else
                            tmp = extraAward[v.type[1]]
                            extraAward[v.type[1]] = awards[v.type[1]]
                            awards[v.type[1]] = tmp
                        end
                    end
                end
            end
        end
    end
    local Awards = {}
    local ExtraAward = {}
    for i, v in pairs(awards) do
        table.insert(Awards, v)
    end
    if not _G.table.isEmptyOrNil(extraAward) then
        for i, v in pairs(extraAward) do
            table.insert(ExtraAward, v)
        end
    end
    return Awards, ExtraAward
end

---合并重复的奖励
---@param awardList table 传入奖励的内容
function StorageManager:MergeAwardList(awardList)
    local t = {}
    local checkAward = {}
    for i = 1, #awardList do
        local itemType = awardList[i].type or awardList[i]
        if itemType[1] ~= nil then
            local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
            if type == _G.StorageType.Card or type == _G.StorageType.Equipment or type == _G.StorageType.Decoration or
                type == _G.StorageType.Carving or type == _G.StorageType.Artifact or type == _G.StorageType.Spiritual then
                table.insert(t, itemType)
            else
                if checkAward[itemType[1]] == nil then
                    table.insert(t, itemType)
                    checkAward[itemType[1]] = t[#t]
                else
                    if checkAward[itemType[1]][2] then
                        checkAward[itemType[1]][2] = checkAward[itemType[1]][2] + itemType[2]
                    elseif checkAward[itemType[1]][3] then
                        checkAward[itemType[1]][3] = checkAward[itemType[1]][3] + itemType[3]
                    end
                end
            end
        end
    end
    return t
end

