function StorageManager:GetStrongestCardBySid(sid)
    local Card
    local CardList = self.Storages[_G.StorageID.Card]:GetCardsBySid(sid)
    for _, v in pairs(CardList) do
        if Card == nil then
            Card = v
        elseif Card.star < v.star then
