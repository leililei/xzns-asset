---刷新所有卡牌的战斗力
---@param func function
function StorageManager:UpdateCardProp(func)
    local cards = self:GetDataByID(_G.StorageID.Card)
    for _, card in pairs(cards) do
        if func then
            if func(card) then
                card:CalcNowSumProp()
            end
        else
            card:CalcNowSumProp()
        end
    end
end

-- region 卡牌仓库
---超过一定数量后分帧刷新所有卡牌的战斗力（已优化过，如果属性和战斗力计算开销依然过大，可以把分帧数量调小触发分帧）
---@param force boolean 强制分帧
function StorageManager:DelayUpdateAllCardProp(attrFunType, force)
    local cards = self:GetDataByID(_G.StorageID.Card)
    if force or _G.table.count(cards) >= 4000 then
        if self.Duacp then
            _G.coroutine.stopwaiting(self.Duacp)
            self.Duacp = nil
        end
        local index = 0
        self.Duacp = _G.coroutine.start(function()
            for _, card in pairs(cards) do
                card:CalcNowSumProp(attrFunType)
                index = index + 1
                if index > 20 then
                    index = 0
                    _G.coroutine.yield()
                end
            end
            _G.coroutine.yield()
            _G.Events:GetInstance():Broadcast(_G.GlobalEvents.DelayUpdateAllCardProp)
            _G.coroutine.stopwaiting(self.Duacp)
            self.Duacp = nil
        end)
    else
        for _, card in pairs(cards) do
            card:CalcNowSumProp(attrFunType)
        end
        _G.Events:GetInstance():Broadcast(_G.GlobalEvents.DelayUpdateAllCardProp)
    end
end

