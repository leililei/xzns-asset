---使用道具，向服务器发消息
---@param data storage.s2c_storage_use 服务器下发消息
---@param sid number 道具id
---@param num number 使用数量   (进度宝箱 该值代表领取进度 服务器定的)
---@param call function 使用完成回调
---@param hideAwardBol boolean 是否隐藏恭喜获得弹窗判断
function StorageManager:UsePropToServerSuc(data, sid, num, call, hideAwardBol)
    if data.ack ~= 1 then
        return
    end
    local UseType = _G.ItemUseType
    ---@type item_cfg
    local cfg = _G.ConfigManager.item_cfg[sid]
    local baseCount = 1
    if cfg.UseType == UseType.CompoundCard or cfg.UseType == UseType.DrawCard or cfg.UseType == UseType.CompoundProp then
        baseCount = cfg.UseParameter[1][1]
    end

    if cfg.UseType == UseType.ProgressChest then
        ---如果是进度宝箱
        local item_box_con_cfgID = tonumber(cfg.UseParameter[1][1])
        ---@type item_box_con_cfg
        local item_box_con_cfg = _G.ConfigManager.item_box_con_cfg[item_box_con_cfgID]
        if num >= #item_box_con_cfg.condition_params then
            ---如果都领取了就删道具
            self:ConsumeItem(sid, 0, 1)
        end
    elseif cfg.UseType ~= UseType.TreasureMap then
        self:ConsumeItem(sid, 0, num * tonumber(baseCount))
    end

    self:ReceiveAwardData(data)
    -- local cfg = _G.ConfigManager.item_cfg[sid]

    if cfg.UseType == UseType.DrawCard and data.award.item then
        local uidstemp = {}
        local cardUidList = {}
        for _, v in pairs(data.award.item) do
            cardUidList[v.type[2]] = true
        end
        local cardList = self:GetDataByID(_G.StorageID.Card)
        for _, v in pairs(cardList) do
            if cardUidList[v.uid] ~= nil then
                uidstemp[v.uid] = v
            end
        end
    end

    if cfg.UseType == UseType.GetFrame then
        local frameId = tonumber(cfg.UseParameter[1][1])
        local frameCfg = _G.ConfigManager.player_frame_cfg[frameId]
        local duration = frameCfg and frameCfg.time_duration or 0
        -- if duration > 0 then
        --     duration = duration + _G.PlayerModel:GetInstance():GetFrameRemainDuration(frameId)
        -- end

        _G.PlayerModel:GetInstance():SetUnlockFrame({
            sid = frameId,
            end_time = duration + _G.TimeUtil.GetServerUnixTime()
        })
        -- ZHJ-20396【客户端】头像、光环、称号重复兑换,type 1 2 3对应头像框，称号，光环
        local listFrame = {
