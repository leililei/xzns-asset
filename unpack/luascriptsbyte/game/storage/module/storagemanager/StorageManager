        :RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RoleArtifactUpgrade.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.ArtifactUpgrade.id)
    require "ArtifactIllustrationModel":GetInstance():GainArtifact(artifact.sid)
    require "PowerToTheTopModel":GetInstance():GetArtifact(artifact.sid)
    ---自动分解检测
    local ArtifactAutoDecompose = _G.PlayerPrefsManager.GetTable(_G.PlayerPrefsKey.ArtifactAutoDecompose)
    local keepBol = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.ArtifactAutoDecomposeKeepBol, 1)
    if not ArtifactAutoDecompose or _G.TableIsEmpty(ArtifactAutoDecompose) then
        ArtifactAutoDecompose = {}
    end
    local grade = _G.StorageManager:GetInstance():GetItemGrade(data[1], data[2])
    if ArtifactAutoDecompose[grade] then
        if keepBol == 0 or require "ArtifactIllustrationModel":GetInstance():CheckArtifactUnlock(data[1]) then
            self.artifactDecomposeList = self.artifactDecomposeList or {}
            local haveBol
            for k, v in pairs(self.artifactDecomposeList) do
                if v.uid == data[2] then
                    v.num = v.num + data[3]
                    haveBol = true
                end
            end
            if not haveBol then
                self.artifactDecomposeList[#self.artifactDecomposeList + 1] = {
                    uid = data[2],
                    num = data[3]
                }
            end
            if not self.artifactDecomposeTimer then
                -- 延迟两秒统一分解
                self.artifactDecomposeTimer = _G.TimerManager:GetInstance():GetTimer(2, self.AutoDecomposeArtifact,
                    self, true)
                self.artifactDecomposeTimer:Start()
            end
            return
        end
    end
end

---神器自动分解
function StorageManager:AutoDecomposeArtifact()
    if self.artifactDecomposeTimer ~= nil then
        self.artifactDecomposeTimer:Stop()
        self.artifactDecomposeTimer = nil
    end
    local decList = self:GetDataByID(_G.StorageID.Artifact)
    local selectList = {}
    for k, v in pairs(self.artifactDecomposeList) do
        if decList[v.uid] then
            _G.table.insert(selectList, v)
        end
    end
    if #selectList == 0 then
        self.artifactDecomposeList = {}
        return
    end
    local pbData = {
        artifact_list = selectList
    }
    require "ArtifactNet":GetInstance():Decompose(pbData, function(msg)
        if msg.ack ~= 1 then
            return
        end
        for k, v in pairs(pbData.artifact_list) do
            self.Storages[_G.StorageID.Artifact]:ChangeCount(v.uid, -v.num)
        end
        self.artifactDecomposeList = {}
        self:ReceiveAwardData(msg)
        local awardData = self:MergeAwardList(msg.award.item)
        if msg.award then
            _G.DelayDo(1, function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecomposeTipsView.Name,
