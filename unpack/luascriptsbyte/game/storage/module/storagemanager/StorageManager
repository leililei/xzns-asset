---@param data storage.s2c_storage_use 服务器下发消息
function StorageManager:BatchUsePropToServerSuc(data, info, call, hideAwardBol)
    if data.ack ~= 1 then
        return
    end
    for _, v in pairs(info) do
        local UseType = _G.ItemUseType
        ---@type item_cfg
        local cfg = _G.ConfigManager.item_cfg[v.sid]
        local baseCount = 1
        if cfg.UseType == UseType.CompoundCard or cfg.UseType == UseType.DrawCard or cfg.UseType == UseType.CompoundProp then
            baseCount = cfg.UseParameter[1][1]
        end

        if cfg.UseType == UseType.ProgressChest then
            ---如果是进度宝箱
            local item_box_con_cfgID = tonumber(cfg.UseParameter[1][1])
            ---@type item_box_con_cfg
            local item_box_con_cfg = _G.ConfigManager.item_box_con_cfg[item_box_con_cfgID]
            local itemData = self:GetItemDataByID(_G.StorageID.Prop, v.sid)
            itemData.progress = v.num
            if v.num >= #item_box_con_cfg.condition_params then
                ---如果都领取了就删道具
                self:ConsumeItem(v.sid, 0, 1)
            end
            require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BackpackItem.id, v.sid)
        elseif cfg.UseType ~= UseType.TreasureMap then
            self:ConsumeItem(v.sid, 0, v.num * _G.tonumber(baseCount))
        end
        -- 合成碎片的任务后端有推送注释掉
        -- if cfg.Type1 == 6 then
        --     ---卡牌碎片合成
        --     _G.Events:GetInstance():Broadcast(
        --             _G.ePlayAactionEvent.PlayAaction,
        --             { _G.ActiveTaskEnum.ConditionEnum.Item.SyntheticCardFragment, v.sid },
        --             v.num
        --     )
        -- end
    end
    self:ReceiveAwardData(data)
    if data.award then
        -- (竞技场宝箱)不要合并奖励数量丶不要排序
        if not hideAwardBol then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
        end
    end
    if call then
        call()
    end
end

---道具购买
---@param id number exchange_cfg_Item的id
---@param num number 购买数量
---@param type number  兑换类型(1:exchange_cfg 兑换;2:item_repeat_cfg)
function StorageManager:PropBuy(id, num, type, callback)
    self.onPropBuyCallback = callback
    ---2023/2/9前调用该接口处理
    if type == nil then
        type = 1
    end
    StorageNet:GetInstance():PropBuy(id, num, type, _G.handlerbind(self, self.OnPropBuyCall, id, num, type))
end

function StorageManager:OnPropBuyCall(msg, _, id, num, type)
    if msg.ack == 1 then
        self:ReceiveAwardData(msg)
        msg.consume = msg.consume or {}
        msg.consume.item = msg.consume.item or {}
        for i = 1, #msg.consume.item do
            self:ConsumeItem(msg.consume.item[i].item[1], 0, msg.consume.item[i].item[2])
        end
        if not self.bought_times[id] then
            self.bought_times[id] = 0
        end
        ---@type exchange_cfg
        local cfg_exchange = _G.ConfigManager.exchange_cfg[id]
        local cfg_item_repeat = _G.ConfigManager.item_repeat_cfg[id]
        if cfg_exchange and type == 1 then
            self.bought_times[id] = _G.math.floor(self.bought_times[id] + num / cfg_exchange.get_item[1][2])
        elseif cfg_item_repeat and type == 2 then
            self.bought_times[id] = _G.math.floor(self.bought_times[id] + num / cfg_item_repeat.get_item[2])
        end
        if type == 2 then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
        end
    end
    if self.onPropBuyCallback then
        self.onPropBuyCallback(msg)
    end
end

