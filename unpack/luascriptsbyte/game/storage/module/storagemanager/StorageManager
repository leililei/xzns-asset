function StorageManager:CheckIsShowRedPointUse(storageID, id)
    if not self.noShowRed or not self.noShowRed[id] then
        return true
    end
    ---@type item_cfg
    local cfg = _G.ConfigManager.item_cfg[id]
    if cfg and useTypes[cfg.UseType] then
        if cfg.UseType == _G.ItemUseType.CompoundCard or cfg.UseType == _G.ItemUseType.DrawCard then
            local num = _G.StorageManager:GetInstance():GetItemCountByID(storageID, id)
            local size = _G.tonumber(cfg.UseParameter[1][1])
            if math.floor(num / size) > math.floor(self.noShowRed[id] / size) then
                return true
            end
        elseif cfg.UseType == _G.ItemUseType.InterfaceJump then
            local resumeCfg = _G.ConfigManager.discrete_cfg[103712][1]
            if id == resumeCfg[1] then
                return true
            end
            return false
        else
            if self.noShowRed[id] == -1 then
                return false
            end
            return _G.StorageManager:GetInstance():GetItemCountByID(storageID, id) > self.noShowRed[id]
        end
    else
        return false
    end
end

