---获取指定活动代币数量
---@param activityID number 活动类型
---@param subType number 活动子类型
---@param sidOrUid number|string 模板Sid 或 唯一Uid
---@return number 物品数量
function StorageManager:GetActivityItemCountByID(activityID, subType, sidOrUid)
    if _G.table.ContainsValue(haveCoinParseFuncActivity, activityID) then
        -- 活动内代币
        local act = require("ActivitySynManager"):GetInstance():GetChildAcitivity(activityID, subType)
        if act and act:GetActivityTypeCls().GetCoin then
            return act:GetActivityTypeCls():GetCoin(sidOrUid)
        end
    end
    return 0
end

