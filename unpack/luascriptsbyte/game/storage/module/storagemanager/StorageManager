---解析单条奖励
---@param data award.Award 奖励数据
function StorageManager:ParseSimpleAward(data)
    ---@field ItemType ItemType 道具类型
    local itemType = data.type
    if itemType[1] ~= nil then
        local type, storageId = self:CheckSidType(itemType[1])
        if storageId == _G.StorageID.Prop then
            local Cfg = _G.ConfigManager.item_cfg[itemType[1]]
            if Cfg.UsePattern == _G.ItemUsePattern.Get and Cfg.UseType == _G.ItemUseType.GetSkin then
                local cfg = tonumber(Cfg.UseParameter[1][1])
                local ID = _G.ConfigManager.skin_cfg[cfg]
                -- 获得的皮肤道具数量
                local num = itemType[2]
                -- 当前是否拥有皮肤
                local isGotSkin = require "CardCommentManager":GetInstance():CradSid(ID.card, cfg)
                if not isGotSkin then
                    self.ParseFunc[storageId]({itemType[1], 1, 1})
                    num = num - 1
                end
                if num > 0 then
                    -- 没有皮肤且兑换皮肤后仍有剩余，则转化多余皮肤道具；拥有皮肤则全部转化
                    self:PropBuy(itemType[1], num, 2, function()
                        _G.PopWindowManager:GetInstance():ShowAllTips(1310001)
                    end)
                end
            elseif Cfg.UsePattern == _G.ItemUsePattern.Get and Cfg.UseType == _G.ItemUseType.Events then
                local cfg = tonumber(Cfg.UseParameter[1][1])
                if require "ChatManager":GetInstance():IsExpressionUnlocked(cfg) then
                    self:PropBuy(itemType[1], 1, 2)
                else
                    self.ParseFunc[storageId](itemType)
                end
            elseif Cfg.UsePattern == _G.ItemUsePattern.Get and Cfg.UseType == _G.ItemUseType.GetTitle then
                local titleId = tonumber(Cfg.UseParameter[1][1])
                local titleCfg = _G.ConfigManager.player_title_effect_cfg[titleId] -- 限时称号可叠加时间
                if _G.PlayerModel:GetInstance():GetTitleData(titleId) and (not titleCfg or titleCfg.time_duration <= 0) then
                    self:PropBuy(itemType[1], 1, 2)
                else
                    self.ParseFunc[storageId](itemType)
                end
            elseif Cfg.UsePattern == _G.ItemUsePattern.Get and Cfg.UseType == _G.ItemUseType.GetHalo then
                local haloId = tonumber(Cfg.UseParameter[1][1])
                local haolCfg = _G.ConfigManager.player_halo_effect_cfg[haloId] -- 限时光环可叠加时间
                if _G.PlayerModel:GetInstance():GetHaloData(haloId) and (not haolCfg or haolCfg.time_duration <= 0) then
                    self:PropBuy(itemType[1], 1, 2)
                else
                    self.ParseFunc[storageId](itemType)
                end
            elseif Cfg.UsePattern == _G.ItemUsePattern.Get and Cfg.UseType == _G.ItemUseType.GetChatFrame then
                local chatFrameId = tonumber(Cfg.UseParameter[1][1])
                local chatFrameCfg = _G.ConfigManager.player_bubble_cfg[chatFrameId] -- 限时聊天框可叠加时间
                if _G.PlayerModel:GetInstance():GetChatFrameData(chatFrameId) and
                    (not chatFrameCfg or chatFrameCfg.time_duration <= 0) then
                    self:PropBuy(itemType[1], 1, 2)
                else
                    self.ParseFunc[storageId](itemType)
                end
            else
                self.ParseFunc[storageId](itemType)
            end
        else
            if type == _G.StorageID.RingGod then
                _G.PlayerModel:GetInstance():AddUnlockGodHalo(itemType[1])
            else
                self.ParseFunc[storageId](itemType)
            end
        end
    end
end

