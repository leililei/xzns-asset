        elseif Card.star == v.star and Card.awaken < v.awaken then
            Card = v
        elseif Card.star == v.star and Card.awaken == v.awaken then
            Card = v
        elseif Card.star == v.star and Card.awaken == v.awaken and Card:GetEquipBarNumber() < v:GetEquipBarNumber() then
            Card = v
        elseif Card.star == v.star and Card.awaken == v.awaken and Card:GetEquipBarNumber() == v:GetEquipBarNumber() and
            Card.uid > v.uid then
            Card = v
        end
    end
    return Card
