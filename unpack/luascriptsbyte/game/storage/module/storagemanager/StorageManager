---消耗物品
function StorageManager:ConsumeItem(sid, uid, num, activityType, ActivitySubType)
    if sid ~= 0 and uid == 0 and not self:CheckItem(sid, num) then
        return
    end
    local _, storageId = self:CheckSidType(sid)
    if self.Storages[storageId] == nil then
        return
    end
    if storageId == _G.StorageID.Card or storageId == _G.StorageID.Decoration or storageId == _G.StorageID.Carving then
        self.Storages[storageId]:ChangeCount(uid, 0, true)
    elseif storageId == _G.StorageID.Equipment or storageId == _G.StorageID.Artifact then
        self.Storages[storageId]:ChangeCount(uid, -num)
    elseif storageId == _G.StorageID.Prop or storageId == _G.StorageID.ResProp or storageId == _G.StorageID.Material or
        storageId == _G.StorageID.Debris or storageId == _G.StorageID.Remains then
        self.Storages[storageId]:ChangeCount(sid, -num)

        ---@type award.i_award_item
        local i_award_item = {}
        i_award_item.type = {
            [1] = sid,
            [2] = -num,
            [3] = self.Storages[storageId]:GetAllItems()[sid] and self.Storages[storageId]:GetAllItems()[sid].count or 0
        }

