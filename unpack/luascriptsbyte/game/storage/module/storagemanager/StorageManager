----定时 触发战力同步  (卡牌仓库初始化完成后触发第一次)
function StorageManager:GetServerCardPower(callback, notExecuteCall)
    local nowTime = os.time()
    ---加个间隔 防止一时间触发多次
    if self.PowerIng_Time and nowTime - self.PowerIng_Time <= 2 then
        if not notExecuteCall and callback then
            callback()
        end
        return
    end
    self.PowerIng_Time = nowTime

    local sumPower = 0

    local Cards = self:GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    local CardsDic = {}

    ---@type power.i_uids
    local i_uids
    for uid, v in pairs(Cards) do
        if not v.isTemp then
            i_uids = {}
            i_uids.uid = uid
            i_uids.power = v.power

            sumPower = sumPower + (i_uids.power or 0)
            CardsDic[uid] = i_uids
        end
    end
    local sendPower = function()
        --- 战斗力与服务器相同的卡 【uid】=true
        local okUid = {}
        ---@param i_uids power.i_uids
        for _, i_uids in pairs(self.sever_power) do
            ---@type card CardData
            local card = CardsDic[i_uids.uid]
            if card ~= nil and card.power == i_uids.power then
                okUid[i_uids.uid] = true
            end
        end
        ---@type power.c2s_power_update
        local SendDIc = {}
        SendDIc.cards = {}
        ---@type power.i_uids
        local i_uids
        for uid, v in pairs(CardsDic) do
            if okUid[uid] == nil then
                table.insert(SendDIc.cards, v)
            end
        end
        if #SendDIc.cards > 0 then
            -- region --------------------------------------再验一次  防止期间有吃卡操作 导致服务器找不到该卡--------
            local tCards = self:GetDataByID(_G.StorageID.Card)
            for i = #SendDIc.cards, 1, -1 do
                if tCards[SendDIc.cards[i].uid] == nil then
                    table.remove(SendDIc.cards, i)
                    self.sever_power[SendDIc.cards[i].uid] = nil
                end
            end

            -- start ZHJH5ZHJH-11856 9月程序主任务ZHJH-13304
            -- 【客户端】战力统计规则调整
            _G.SortList(SendDIc.cards, function(item)
                return item.power
            end)

            for i = 51, #SendDIc.cards do
                SendDIc.cards[i] = nil
            end

            ---end

            -- endregion------------------------------------再验一次  防止期间有吃卡操作 导致服务器找不到该卡--------
            StorageNet:GetInstance():UpDateServerCardPower(SendDIc, function(msg)
                if msg.ack ~= 1 then
                    return
                end
                self.sumFightPower = sumPower
                for _, v in pairs(SendDIc.cards) do
                    if self.sever_power[v.uid] then
                        self.sever_power[v.uid].power = v.power
                    end
                end
                if callback then
                    callback()
                end
                _G.PlayerModel:GetInstance():SetPower(sumPower)
                ---任务目标战力计算规则: 只看共鸣神石上的卡牌
                local power = self:GetPlayerPower()
                _G.Events:GetInstance():Broadcast(_G.ePlayAactionEvent.PlayAaction,
                    {_G.ActiveTaskEnum.ConditionEnum.Power.TotalPowerW}, power // 10000)
            end)
        else
            if callback then
                callback()
            end
        end
    end
    if sumPower ~= self.sumFightPower then
        if not self.sever_power then
            StorageNet:GetInstance():GetServerCardPower(function(s2c_get_power)
                self:InitSeverPower(s2c_get_power)
                sendPower()
            end)
        else
            sendPower()
        end
    else
        if callback then
            callback()
        end
    end
    _G.PlayerModel:GetInstance():SetPower(sumPower)
end

---@param msg power.s2c_get_power
function StorageManager:InitSeverPower(msg)
    self.sever_power = {}
    if not _G.table.isEmptyOrNil(msg.cards) then
        for _, v in pairs(msg.cards) do
            self.sever_power[v.uid] = v
        end
    end
end

---获取玩家战力
function StorageManager:GetPlayerPower()
    local power = 0
    local cards
    -- local cards = self:GetDataByID(_G.StorageID.Card)
    if require("CardResonanceModel"):GetInstance():CheckSelfOpen() then
        cards = require("CardResonanceModel"):GetInstance():GetAllPosCards()
        for _, v in pairs(cards) do
            power = power + v.power
        end
    else
        cards = self:GetDataByID(_G.StorageID.Card)
        ---最强战力的五张卡
        cards = _G.table.toArray(cards)
        _G.SortList(cards, function(data)
            return data.power
        end)
        for index, v in ipairs(cards) do
            power = power + v.power
            if index >= 5 then
                break
            end
        end
    end

    return power
end

