---获取根据符文槽位等级排序后CarDataList<角色 卡牌背包>(同样卡筛选战力最高一张)
function StorageManager:GetCardDataSortByTotalDecorationLv(order)
    local T = self:GetMaxPowerCards()
    T = table.toArray(T)
    local items = {}
    if order then
        for k, v in ipairs(T) do
            if v.cfg.Order >= order then
                table.insert(items, v)
            end
        end
    else
        items = T
    end
    ---@param item CardData
    for k, v in ipairs(items) do
        v.totalDecorationLv = v:GetTotalDecorationLv()
    end
    table.sort(items, function(a, b)
        local totalDecorationLvA = a.totalDecorationLv
        local totalDecorationLvB = b.totalDecorationLv
        local decorationLvMaxA = totalDecorationLvA >= 400 and 1 or 0
        local decorationLvMaxB = totalDecorationLvB >= 400 and 1 or 0
        if decorationLvMaxA ~= decorationLvMaxB then
            return decorationLvMaxA < decorationLvMaxB
        elseif totalDecorationLvA ~= totalDecorationLvB then
            return totalDecorationLvA > totalDecorationLvB
        elseif a.power ~= b.power then
            return a.power > b.power
        elseif a.star ~= b.star then
            return a.star > b.star
        else
            return a.sid < b.sid
        end
    end)
    return items
end

