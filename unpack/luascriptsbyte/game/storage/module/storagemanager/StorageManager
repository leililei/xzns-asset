---使用道具，向服务器发消息
---@param sid number 道具id
---@param num number 使用数量
---@param call function 使用完成回调
---@param param number 额外参数
---@param hideAwardBol boolean 是否隐藏恭喜获得弹窗判断
function StorageManager:UsePropToServer(sid, num, call, param, param1, hideAwardBol)
    local msg = {}
    msg.sid = sid
    local cfg = _G.ConfigManager.item_cfg[sid]
    if num > cfg.limit_num then
        num = cfg.limit_num
    end
    msg.num = _G.math.floor(num)
    if param then
        local arg = {}
        for i, v in pairs(param) do
            table.insert(arg, {
                k = i,
                v = v
            })
        end
        msg.param2 = arg
    end
    if param1 then
        msg.param1 = {param1}
    end

    ---皮肤宝箱判定，皮肤是非重复道具
    local isSkinBos, id = self:CheckSkinBox(sid, param)
    if isSkinBos then
        local irc = _G.ConfigManager.item_repeat_cfg[id]
        if irc then
            _G.PopWindowManager:GetInstance():ShowAllTips(628, nil, function()
                StorageNet:GetInstance():PropUse(msg, _G.handlerbind(self, self.UsePropToServerSuc, sid, num, call,
                    hideAwardBol))
            end, nil, nil, false, irc.get_item[2])
            return
        end
    end

    local isSkinItem = self:CheckSkinItem(sid)
    if isSkinItem then
        local irc = _G.ConfigManager.item_repeat_cfg[sid]
        if irc then
            _G.PopWindowManager:GetInstance():ShowAllTips(628, nil, function()
                self:PropBuy(sid, num, 2, call)
            end, nil, nil, false, irc.get_item[2])
            return
        end
    end

    StorageNet:GetInstance():PropUse(msg, _G.handlerbind(self, self.UsePropToServerSuc, sid, num, call, hideAwardBol))
end

---判断是不是皮肤宝箱
---@return boolean 是否存在皮肤或兑换多个皮肤, number 皮肤id
function StorageManager:CheckSkinBox(sid, param)
    ---ZHJH5ZHJH-8086 【7月版本】程序主单号ZHJH-9715
    ---【客户端】时装-玩家重复获得的二次提示
    if param then
        for index, num in pairs(param) do
            local type, storageId = self:CheckSidType(sid)
            if storageId == _G.StorageID.Prop then
                local cfgTemp = _G.ConfigManager.item_cfg[sid]
                ---道具类型匹配到自选箱
                if (cfgTemp.UseType == 5 or cfgTemp.UseType == 6) and cfgTemp.UsePattern == 2 and
                    cfgTemp.UseParameter2[index] then
                    local cfg = _G.ConfigManager.item_cfg[cfgTemp.UseParameter2[index][1]]
                    ---自选箱为皮肤箱子
                    if cfg and cfg.UsePattern == _G.ItemUsePattern.Get and cfg.UseType == _G.ItemUseType.GetSkin then
                        local id = tonumber(cfg.UseParameter[1][1])
                        local skinCfg = _G.ConfigManager.skin_cfg[id]
                        local isGotSkin = require "CardCommentManager":GetInstance():CradSid(skinCfg.card, id)
                        ---存在些皮肤
                        if isGotSkin or num > 1 then
                            return true, cfg.ID
                        end
                    end
                end
            end
        end
    end
    return false
end

