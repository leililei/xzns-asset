---根据sid,星级获取该卡牌某星级 等级最低的多张
function StorageManager:GetWeakestCardsBySidStar(sid, star, num, uidT)
    local tempCards = {}
    local cards = {}
    local cardList = self.Storages[_G.StorageID.Card]:GetCardsBySid(sid)
    for _, v in pairs(cardList) do
        local bol = true
        if uidT then
            for i = 1, #uidT do
                if v.uid == uidT[i] then
                    bol = false
                end
            end
        end
        if bol then
            if v.star == star then
                _G.table.insert(tempCards, v)
            end
        end
    end
    _G.SortList(tempCards, function(a)
        return -a.lv
    end)
    local CardResonanceModel = require("CardResonanceModel"):GetInstance()
    for i = 1, #tempCards do
        if #cards < num then
            local ca = tempCards[i]
            if ca and not CardResonanceModel:CheckCardIsInPos(ca.uid) then
                _G.table.insert(cards, ca)
            end
        else
            break
        end
    end
    return cards
end

