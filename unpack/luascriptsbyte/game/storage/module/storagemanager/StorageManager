---@param ignoreWarning? boolean 是否忽略打印信息
---@return BaseItemData 物品数据(可能为nil)
function StorageManager:GetItemDataByID(id, sidOrUid, ignoreWarning)
    if not id or not sidOrUid or sidOrUid <= 0 then
        return nil
    end
    local storage = self.Storages[id]
    if not storage then
        if _G.AppSetting.DEBUG and not ignoreWarning then
            -- _G.LogError("未找到仓库 类型id=" .. id, "StorageManager:GetItemDataByID")
        end
        return nil
    end
    local data = storage:GetItemByKey(sidOrUid)
    if not data then
        if _G.AppSetting.DEBUG and not ignoreWarning then
            -- _G.LogWarning("仓库 类型id=" .. id .. ",未找到物品 sidOrUid=" .. sidOrUid, "StorageManager:GetItemDataByID")
        end
    end
    return data
end

