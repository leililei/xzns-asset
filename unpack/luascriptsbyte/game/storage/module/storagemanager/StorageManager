---@field star number
---@field num number 卡牌指定数量
---检测背包 拥有指定等级卡牌的数量
function StorageManager:CheckCardStarCount(star, num)
    ---@type CardStorage
    local tb = self.Storages[_G.StorageID.Card]
    local count = 0
    for k, v in pairs(tb.starTable) do
        if k >= star then
            count = count + tb:GetCardStarCount(k)
            if num and count >= num then
                count = num
                break
            end
        end
    end

    return count
end

