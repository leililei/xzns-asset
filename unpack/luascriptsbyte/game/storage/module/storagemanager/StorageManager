---新建指定类型的仓库
---@param value StorageConfig_Itemf
function StorageManager:CreateStorage(value)
    local type = value.Id
    if type == _G.StorageID.Prop then
        return require("PropStorage").New(_G.StorageID.Prop)
    elseif type == _G.StorageID.Material then
        return require("MaterialStorage").New(_G.StorageID.Material)
    elseif type == _G.StorageID.Equipment then
        return require("EquipmentStorage").New(_G.StorageID.Equipment)
    elseif type == _G.StorageID.Card then
        return require("CardStorage").New(_G.StorageID.Card)
    elseif type == _G.StorageID.ResProp then
        return require("ResourcesStorage").New(_G.StorageID.ResProp)
    elseif type == _G.StorageID.Decoration then
        return require("DecorationStorage").New(_G.StorageID.Decoration)
    elseif type == _G.StorageID.Artifact then
        return require("ArtifactStorage").New(_G.StorageID.Artifact)
    elseif type == _G.StorageID.Spiritual then
        return require("SpiritualStorage").New(_G.StorageID.Spiritual)
    elseif type == _G.StorageID.Remains then
        return require("RemainsStorage").New(_G.StorageID.Remains)
    elseif type == _G.StorageID.Debris then
        return require("DebrisStorage").New(_G.StorageID.Debris)
    elseif type == _G.StorageID.Carving then
        return require("CarvingStorage").New(_G.StorageID.Carving)
    elseif type == _G.StorageID.Gemstone then
        return require("GemstoneStorage").New(_G.StorageID.Gemstone)
    end

    if _G.AppSetting.DEBUG then
        _G.LogError(" Storage is nil", value.Key)
    end
    return require("BaseStorage").New()
end

