---获取物体品质
function StorageManager:GetItemGrade(sid, uid)
    local type = self:CheckSidType(sid)
    local grade = 1
    if type == _G.StorageType.Card then
        if uid and uid > 0 and uid > sid then
            local data = self:GetItemDataByID(_G.StorageID.Card, uid)
            grade = require "CardInfoManager":GetInstance():GetOrderStarCount(data.star)
        else
            local cfg = _G.ConfigManager.card_cfg[sid]
            if cfg then
                ---ZHJ-19443【8日登录】角色奖励特效显示错误 +1,3改为4
                grade = require "CardInfoManager":GetInstance():GetOrderStarCount(cfg.Star) + 1
            end
        end
    elseif type == _G.StorageType.Equipment then
        local cfg = _G.ConfigManager.equipment_cfg[sid]
        if cfg then
            ----没有白 按道具来
            grade = cfg.grade
        end
    elseif type == _G.StorageType.Decoration then
        local cfg = _G.ConfigManager.decoration_cfg[sid]
        if cfg then
            grade = cfg.grade
        end
    elseif type == _G.StorageType.Carving then
        local cfg = _G.ConfigManager.carving_cfg[sid]
        if cfg then
            grade = cfg.grade
        end
    elseif type == _G.StorageType.Artifact then
        local cfg = _G.ConfigManager.artifact_cfg[sid]
        if cfg then
            grade = cfg.Order
        end
    elseif type == _G.StorageType.Spiritual then
        local cfg = _G.ConfigManager.spiritual_cfg[sid]
        if cfg then
            grade = cfg.Order
        end
    else
        grade = self:GetItemQuality(sid)
    end
    return grade, type
end

