function StorageManager:Consume(data)
    local T = data.item or data.type or data
    if T[1] == 0 and _G.table.ContainsValue(haveCoinParseFuncActivity, T[2]) then
        -- 活动内代币
        local act = require("ActivitySynManager"):GetInstance():GetChildAcitivity(T[2], T[3])
        if act:GetActivityTypeCls().AddCoin then
            act:GetActivityTypeCls():AddCoin(-T[5])
        elseif act:GetActivityTypeCls().SetCoin then
            act:GetActivityTypeCls():SetCoin({
