---解析活动代币奖励: 活动代币奖励从0开始
---@param awardList number[][]
---@return number[][]
function StorageManager:ResoveActivityAwardCfg(awardList)
    local hasActivityAward = false
    for i, v in ipairs(awardList) do
        if v[1] == 0 and #v >= 5 then
            hasActivityAward = true
            break
        end
    end
    if not hasActivityAward then
        return awardList
    end
    awardList = {table.unpack(awardList)}
    for i, v in ipairs(awardList) do
        if v[1] == 0 and #v >= 5 then
            v = {v[4], v[5], v[1], v[2], v[3]}
            awardList[i] = v
        end
    end
    return awardList
end
