function StorageManager:GetCommonLightEffect(sid, uid)
    local grade, type = self:GetItemGrade(sid, uid)
    if type == _G.StorageType.Artifact then
        if grade < 3 then
            grade = grade + 4
        else
            grade = grade + 5
        end

    elseif type == _G.StorageType.Spiritual then
        if grade < 4 then
            grade = grade + 3
        else
            grade = grade + 4
