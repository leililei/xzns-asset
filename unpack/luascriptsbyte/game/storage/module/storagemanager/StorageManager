---@field sid number
---@field lv number
---@class params_CheckCardLvCount 检测背包 拥有指定等级卡牌的数量
---检测背包 拥有指定等级卡牌的数量
------@param data params_CheckCardLvCount
function StorageManager:CheckCardLvCount(data, num)
    local lv = data.lv
    local sid = data.sid
    local count = 0
    if lv or sid then
        ---@param card CardData
        local func = function(k, card)
            if sid and sid ~= card.sid then
                return false
            end
            return card.lv >= lv
        end
        local tb = self.Storages[_G.StorageID.Card].list
        for k, v in pairs(tb) do
            if func(k, v) then
                count = count + 1
                if num ~= nil and count >= num then
                    break
                end
            end
        end
    end
    if num ~= nil then
        return count >= num
    else
        return count
    end
end

