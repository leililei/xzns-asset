---获取排序后CarDataList<角色 卡牌背包>  lv-star-grade-sid-uid
---@param includeDemo boolean 是否包含试玩卡
function StorageManager:GetCardDataSortList(includeDemo)
    local items = self:GetDataByID(_G.StorageID.Card)
    items = table.toArray(items)
    if includeDemo then
        local demoData = require("DemoModel"):GetInstance():GetAllCards()
        for _, v in pairs(demoData) do
            _G.table.insert(items, v)
        end
    end
    ---@param item CardData
    SortList(items, function(item)
        ---self.sortEnum  取排序字段
        local sort1 = item.lv or 0
        local sort2 = item.star or 0
        local sort3 = item.Grade or 0
        local sort4 = item.sid
        local sort5 = item.uid
        return sort1, sort2, sort3, sort4, sort5
    end)
    return items
end

