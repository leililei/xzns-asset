local base = require("BaseGameNet")

---@class GoblinTycoonRankingNet : BaseGameNet    通信协议
local GoblinTycoonRankingNet = _G.BaseClass("GoblinTycoonRankingNet", base)
---@return GoblinTycoonRankingNet GoblinTycoonRankingNet
function GoblinTycoonRankingNet:GetInstance()
    return base.GetInstance(self)
end

---监听推送
function GoblinTycoonRankingNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.game_goblin_tycoon_anonymous_award.Cmd, self.P2CAward)
end

---奖励推送
---@param msg
function GoblinTycoonRankingNet:P2CAward(msg)
    _G.StorageManager:GetInstance():ReceiveAwardData({ award = msg })
end

---前100名上榜排行榜数据
---@param callback function 回调方法
function GoblinTycoonRankingNet:AccessAfk(activityId, callback)
    self:Access(_G.ConfigManager.net_map.game_rank_activity_goblin_tycoon_rank, { page = 1, id = activityId }, callback)
end

---获取个人排名
function GoblinTycoonRankingNet:GetPlayerRank(activityId, callback)
    self:Access(_G.ConfigManager.net_map.game_rank_get_rank_num, { type = activityId }, callback)
end

---发送玩家匿名情况
function GoblinTycoonRankingNet:SetPlayerAnonymous(activityId, is_anonymous, callback)
    self:Access(_G.ConfigManager.net_map.game_activity_module_port_goblin_tycoon_anonymous, { activity_id = activityId, is_anonymous = is_anonymous }, callback)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function GoblinTycoonRankingNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function GoblinTycoonRankingNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return GoblinTycoonRankingNet