---构造函数
---@protected
function TavernPartyCumulativeAwardsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eDrawUpBattlePass.DrawUpBattlePassRefeshTask, self.RefreshTask)
end

---界面的入口函数
function TavernPartyCumulativeAwardsView:OnCreate(activity)
    self.activity = activity
    self.activityCls = self.activity:GetActivityTypeCls()
    self.curIndex = 1
    self.isInited = false
    self:RefreshTask()
    self.isInited = true
    self.subType = self.activity:GetJumpType()

    --倒计时
    self.endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if self.Timer == nil then
        self:UpdateTime()
        self.Timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.Timer:Start()
    end
end

function TavernPartyCumulativeAwardsView:UpdateTime()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        local view1 = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawGiftPackToggleView.Name)
        if view1 then
            view1:Close()
        end
        return
    end
    local str = _G.TimeUtil.GodSpecialGiftForStr(time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, string.format("<color=#a5f37f>%s</color>", str))
end

---任务刷新
function TavernPartyCumulativeAwardsView:RefreshTask()
    self.taskDatas = self.activityCls:GetTaskListByPage(1)
    self:SortTask()
    self:RefreshTaskIndex()
    self:RefreshTaskItem2()
end

function TavernPartyCumulativeAwardsView:RefreshTaskIndex()
    for i = 1, 3 do
        local index = (self.curIndex - 1) * 3 + i
        if index > #self.taskDatas then
            self.go_table["obj_item" .. i]:SetActiveE(0)
        else
            self.go_table["obj_item" .. i]:SetActiveE(1)
            self:RefreshTaskItem(index, self.go_table["obj_item" .. i])
        end
    end
    self.go_table.aorbtn_left:SetActiveE(self.curIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(((self.curIndex - 1) * 3 + 4) <= #self.taskDatas and 1 or 0)
end

function TavernPartyCumulativeAwardsView:RefreshTaskItem(index, obj)
    ---@type SpiritualDrawCumulativeAwardsView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index))
    go_table.obj_items:ClearChildren()
    go_table.obj_items2:ClearChildren()
    local data = self.taskDatas[index]
    go_table.aortext_info.text = data.Cfg.desc
    go_table.aorimage_over:SetGray(true)
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        --go_table.aortext_jd.text = _G.string.format("<color=#3E6709>%s</color>/%s", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        go_table.aorbtn_way:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorimage_over:SetActiveE(isGet and 1 or 0)
        --go_table.aortext_jd:SetActiveE(not isGet and 1 or 0)

        go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90025600002)
    else
        --go_table.aortext_jd.text = _G.string.format("<color=#AA3932>%s</color>/%s", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        go_table.aorimage_get:SetActiveE(1)
        go_table.aorbtn_way:SetActiveE(1)
        --if data.Cfg.link and data.Cfg.link ~= 0 then
        --    go_table.aorbtn_way:SetGray(false)
        --    go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(90022200010)
        --    go_table.aorbtn_way.interactable = true
        --else
        go_table.aorbtn_way:SetGray(true)
        go_table.aortext_label.text = _G.LangUtil.GetLangPackValue(92010300021)
        go_table.aortext_label.color = _G.ColorTools.FormatColorByString("313131")
        --go_table.aorbtn_way.interactable = false
        --end
        go_table.aorimage_over:SetActiveE(0)
        --go_table.aortext_jd:SetActiveE(1)
    end

    for i = 1, 2 do
        --#data.Cfg.reward do
        local info = data.Cfg.reward[i]
        if info then
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                data.Cfg.reward[i].type,
                go_table.obj_items,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.85)
                    if data.Cfg.reward[i].type[2] > 1 then
                        tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    else
                        tran:ShowNumText(false)
                    end
                    tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                    if tran.ShowEffectOrder and tran.cfg then
                        tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                    end
                end
            )
        end
    end
    for i = 3, #data.Cfg.reward do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data.Cfg.reward[i].type,
            go_table.obj_items2,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.85)
                if data.Cfg.reward[i].type[2] > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
    if data.Cfg.other_award and data.Cfg.other_award[1] then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { data.Cfg.other_award[1].sid, data.Cfg.other_award[1].num },
            go_table.obj_items2,
            function(tran)
                tran.gameObject:SetLocalScaleXYZ(0.85)
                if data.Cfg.other_award[1].num > 1 then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                else
                    tran:ShowNumText(false)
                end
                tran:SetGou(self.activityCls:CheckIsGet(data.Cfg.id))
                if tran.ShowEffectOrder and tran.cfg then
                    tran:ShowEffectOrder(tran.cfg.ef_item == 1 and true or false)
                end
            end
        )
    end
end

function TavernPartyCumulativeAwardsView:RefreshTaskItem2()
    ---@type SpiritualDrawCumulativeAwardsView._obj_item_GoTable
    local go_table = _G.GetAutoGoTable(self.go_table["obj_item" .. 4], _G.handlerbind(self, self.OnClickTask, 0))
    --go_table.obj_items:ClearChildren()
    local data = self.activityCls:GetTaskListByPage(2)[1]
    self.bigAward = data
    go_table.aortext_info.text = _G.GetLangPackValue(92010300003, data.Cfg.count)   --data.Cfg.desc
    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        go_table.aortext_jd.text = _G.GetLangPackValue(92010300004, data.Cfg.count) --_G.string.format("<color=#3E6709>%s</color>/%s", data.Cfg.count, data.Cfg.count)
        local isGet = self.activityCls:CheckIsGet(data.Cfg.id)
        go_table.aorbtn_get:SetActiveE(isGet and 0 or 1)
        --go_table.aorbtn_way:SetActiveE(0)
        --go_table.aorimage_get:SetActiveE(1)
        go_table.obj_over:SetActiveE(isGet and 1 or 0)
        self.go_table.obj_effect1:ClearChildren()
        self.go_table.obj_effect2:ClearChildren()
        self.go_table.obj_effect3:ClearChildren()
        if isGet == true then
            self.go_table.obj_effect1:SetActiveE(0)
            self.go_table.obj_effect2:SetActiveE(0)
            self.go_table.obj_effect3:SetActiveE(0)
        else
            self.go_table.obj_effect1:SetActiveE(1)
            self.go_table.obj_effect2:SetActiveE(0)
            self.go_table.obj_effect3:SetActiveE(0)

            self.go_table.obj_effect1:ClearChildren()
            local check = function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                end
            end
            _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TavernPartyCumulativeAwardsView_bgcheng,
                self.go_table.obj_effect1, check)
        end
    else
        go_table.aortext_jd.text = _G.GetLangPackValue(92010300004, data.i_task.target[1]) --_G.string.format("<color=#AA3932>%s</color>/%s", data.i_task.target[1], data.Cfg.count)
        go_table.aorbtn_get:SetActiveE(0)
        --go_table.aorimage_get:SetActiveE(1)
        go_table.obj_over:SetActiveE(0)
        self.go_table.obj_effect1:SetActiveE(0)
        self.go_table.obj_effect2:SetActiveE(1)
        self.go_table.obj_effect3:SetActiveE(1)

        self.go_table.obj_effect2:ClearChildren()
        self.go_table.obj_effect3:ClearChildren()
        local check = function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TavernPartyCumulativeAwardsView_bg,
            self.go_table.obj_effect2, check)
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_TavernPartyCumulativeAwardsView_front,
            self.go_table.obj_effect3, check)
    end

    local cfg = _G.ConfigManager.heroic_icons_cfg[data.Cfg.reward[1].type[1]]
    go_table.aortext_name.text = _G.GetLangPackValue(cfg.name)
    go_table.aorrawimage_nameBg:LoadImage(
        iconNameBg[cfg.grade],
        function(tran)
            if self:IsNil() then
                tran:DestroyObject()
                return
            end
            tran:SetNativeSize()
        end
    )
    go_table.aorrawimage_icon:LoadImage(
        cfg.hero_image,
        function(tran)
            if self:IsNil() then
                tran:DestroyObject()
                return
            end
            --tran:SetNativeSize()
            --tran:SetLocalScaleXYZ(1.1)
        end
    )
end

