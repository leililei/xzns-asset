---@class MilitaryRankTaskItem	中文描述
---@field go_table MilitaryRankView._obj_Task_GoTable
---@field AwardList BaseAwardNewItem[]
local MilitaryRankTaskItem = _G.BaseClass("MilitaryRankTaskItem")
local state = {
    Last = 1,
    Current = 2,
    Next = 3
}
---类的构造函数
function MilitaryRankTaskItem:__init(obj, callback)
    self.gameObject = obj
    self.transform = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self.AwardList = {}
    self.callback = callback
    self.go_table.scrollloophorizontal_AwardList:InitItemData(0, _G.handler(self, self.RefreshAward))
end
---@param data MilitaryRankTaskData
function MilitaryRankTaskItem:Show(data, curState)
    self.data = data
    self.state = curState
    self.go_table.aortext_name.text = _G.LangUtil.GetLangPackValue(data.Cfg.desc)
    local v1, v2 = self.data:GetCount()
    if self.state == state.Next then
        v1 = 0
    elseif self.state == state.Last then
        v1 = v2
    end
    self.go_table.slider_TaskProgress.value = v1 / v2
    self.go_table.aortext_Slider.text = _G.string.format("%d/%d", v1, v2)
    local count = #self.data.Cfg.reward
    self:ChangeState()
    --self.go_table.scrollloophorizontal_AwardList:UpdateScrollRectWeight(count <= 1 and 81 or 149)
    self.go_table.scrollloophorizontal_AwardList:UpdateCount(count)
end

function MilitaryRankTaskItem:RefreshAward(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.AwardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73)
        self.AwardList[id] = item
    end
    if self.data:CheckIsCanTake() and self.state == state.Current then 
        self.canGetBol = true
    else 
        self.canGetBol = false
    end
    item:ShowWithID(self.data.Cfg.reward[index + 1], nil, function()
        if self.canGetBol then 
            if not self.eff then 
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                    item.item.go_table.obj_uieffect,
                    function(tran)
                        --- 防止 异步后
                        if _G.IsNil(self.go_table.gameObject) then
                            tran:DestroyObject()
                            return
                        end
                        
                        if tran ~= nil then
                            tran:SetLocalScaleXYZ(1)
                            tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                            self.eff = tran
                        end
                    end
                )
            else 
                self.eff:SetActiveE(1)
            end
        else 
            if self.eff then 
                self.eff:SetActiveE(0)
            end
        end
    end)
    _G.GameUtil.SetActiveByCondition(item.go_table.obj_get, self.data:CheckIsGet())
end

function MilitaryRankTaskItem:ChangeState()
    local canGo = self.data.i_task.state ~= _G.TaskEnum.ETaskState.Submited and not self.data:CheckIsCanTake()
    local isPass = self.state <= state.Current
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_get,
        self.data:CheckIsCanTake() and isPass
    )
    _G.GameUtil.SetActiveByCondition(
            self.go_table.aorbtn_Get,
            self.data:CheckIsCanTake() and isPass
    )
    _G.GameUtil.SetActiveByCondition(
        self.go_table.aorbtn_Go,
        canGo and isPass
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.aorimage_Get, self.data:CheckIsGet() and isPass)
end

---更新奖励显示
function MilitaryRankTaskItem:UpdateAllAwardMask()
    for _, v in pairs(self.AwardList) do
        _G.GameUtil.SetActiveByCondition(v.go_table.obj_get, self.data.i_task.state == _G.TaskEnum.ETaskState.Submited)
    end
end

function MilitaryRankTaskItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get or go == self.go_table.aorbtn_Get then
        require "HellRoadModel":GetInstance():FinishTask(
            self.data,
            function()
                self:ChangeState()
                self:UpdateAllAwardMask()
                if self.callback then
                    self.callback(go)
                end
            end
        )
    elseif go == self.go_table.aorbtn_Go then
        _G.JumpManager:GetInstance():Jump(self.data.Cfg.link)
    end
end

---类的析构函数
function MilitaryRankTaskItem:Dispose()
end

return MilitaryRankTaskItem
