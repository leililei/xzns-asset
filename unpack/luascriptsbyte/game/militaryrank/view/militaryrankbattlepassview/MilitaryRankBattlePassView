        itemLua:ShowEffectOrder(true)
    end)
end

---内部方法，向table中累加奖励
function MilitaryRankBattlePassView:AddAward(tb, sid, num)
    if tb[sid] == nil then
        tb[sid] = num
    else
        tb[sid] = tb[sid] + num
    end
end

function MilitaryRankBattlePassView:RefreshList(index, obj)
    if index < 0 then
        return
    end
    index = index + 1
    local cfg = self.awardCfgArray[index]
    local id = cfg.id
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, id))
    obj:SetName(index)
    if not table.ContainsValue(self.itemList, obj) then
        self.itemList[index] = obj
    end
    -- for i = 1, #self.itemList do
    --     _G.SortList(
    --         self.itemList,
    --         function(a)
    --             return -a:GetName()
    --         end
    --     )
    --     self.itemList[i]:SetSiblingIndexE(i)
    -- end

    local freeState, payState
    local lvEnough = self.lv >= cfg.conditions[2]
    freeState = lvEnough and ItemState.Unlock or ItemState.Lock
    payState = (lvEnough and self.isBuy) and ItemState.Unlock or ItemState.Lock
    tb.freeState = self.model:CheckAwardIsGet(self.id, id, true) and ItemState.Received or freeState
    tb.payState = self.model:CheckAwardIsGet(self.id, id, false) and ItemState.Received or payState

    local rewards = cfg.rewards_normal
    if not tb.item1 then
        tb.item1 =
            BaseAwardNewItem.New(tb.obj_item1, _G.handlerbind(self, self.OnClickAward, tb, false), 88, tb.obj_item1)
    end
    tb.item1:ShowWithID(rewards[1], nil, _G.handlerbind(self, self.itemLoadedCall, tb, false, 1, rewards[1]))

    rewards = cfg.rewards_pay[1]
    if not tb.item2 then
        tb.item2 = BaseAwardNewItem.New(tb.obj_item21, _G.handlerbind(self, self.OnClickAward, tb, true), 88,
            tb.obj_item21)
    end
    tb.item2:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 21, rewards[1]))

    rewards = cfg.rewards_pay[2]
    tb.obj_item22:SetActiveE(rewards and 1 or 0)
    if rewards then
        if not tb.item3 then
            tb.item3 =
                BaseAwardNewItem.New(
                    tb.obj_item22,
                    _G.handlerbind(self, self.OnClickAward, tb, true),
                    88,
                    tb.obj_item22
                )
        end
        tb.item3:ShowWithID(rewards, nil, _G.handlerbind(self, self.itemLoadedCall, tb, true, 22, rewards[1]))
    end

    ---是否显示第二个
    tb.obj_gou22:SetActiveE(rewards and 1 or 0)
    tb.obj_suo22:SetActiveE(rewards and 1 or 0)
    local isGet1 = tb.freeState == ItemState.Unlock
    local isGet2 = tb.payState == ItemState.Unlock
    local Got1 = tb.freeState == ItemState.Received
    local Got2 = tb.payState == ItemState.Received
    ---已领打勾
    tb.obj_gou1:SetActiveE(Got1 and 1 or 0)
    tb.obj_gou2:SetActiveE(Got2 and 1 or 0)
    ---可领

    tb.aorimage_get:SetActiveE(0)
    tb.aorbtn_get.onClick:RemoveAllListeners()
    tb.aorbtn_get:SetActiveE(1)
    local spriteName = "ui_ty_kuang_00"
    local color = "8C2D14"
    if _G.AppSetting.IsXzns then
        spriteName = "ui_zssd_cheng_btn"
        color = "91522E"
    end
    tb.aorimage_getaward.color = _G.ColorTools.FormatColorByString("FFFFFF")
    if (isGet2 or isGet1) then
        -- 可领取
        tb.aorimage_getaward.SpriteName = spriteName
        tb.aorimage_getaward:SetGray(false)
        tb.aortext_text.text = _G.GetLangPackValue(90027500003)
        tb.aortext_text.color = _G.ColorTools.FormatColorByString(color)
        tb.aorbtn_get.onClick:AddListener(_G.handlerbind(self, self.OnClick_item, id))
    elseif Got1 and not Got2 then
        --  普通奖励领取，但是没有氪金
        tb.aorimage_getaward.SpriteName = spriteName
        tb.aorimage_getaward:SetGray(false)
        tb.aortext_text.text = _G.GetLangPackValue(90025200011)
        tb.aortext_text.color = _G.ColorTools.FormatColorByString(color)
        tb.aorbtn_get.onClick:AddListener(_G.handler(self, self.ShowBuyTips))
    elseif Got1 and Got2 then
        -- 奖励都被领取
        tb.aorbtn_get:SetActiveE(0)
        tb.aorimage_get:SetActiveE(1)
    elseif not isGet1 and not isGet2 then
        -- 都不能领取（没有达到条件）
        if _G.AppSetting.IsXzns then
            tb.aorimage_getaward.SpriteName = "ui_zssd_lan_btn"
            tb.aortext_text.color = _G.ColorTools.FormatColorByString("DDE2E6")
        else
            tb.aorimage_getaward.SpriteName = spriteName
            tb.aorimage_getaward:SetGray(true)
            tb.aorimage_getaward.color = _G.ColorTools.FormatColorByString("A9A9A9")

            tb.aortext_text.color = _G.ColorTools.FormatColorByString("434343")
        end
        tb.aortext_text.text = _G.GetLangPackValue(90020400086)
    end
    ---未解锁上锁
    -- tb.obj_suo1:SetActiveE(tb.freeState == ItemState.Lock and 1 or 0)
    -- tb.obj_suo2:SetActiveE(tb.payState == ItemState.Lock and 1 or 0)

    tb.aortext_lv.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.hell_title_cfg[cfg.conditions[2]].name)
    -- --等级经验
    -- local exp = self.typeClass:GetLvExpByLv(cfg.level)
    -- tb.aortext_exp.text = exp

    --进度条
    tb.aorimage_DayBar:SetActiveE(index == 1 and 0 or 1)
    tb.aorimage_DayBar:SetRectTransformSize(22, self.showItemExp and 78 or 85)
    if cfg.conditions[2] - 1 < self.lv then
        tb.aorimage_dayBar:SetLocalScale(1, 1, 1)
    else
        tb.aorimage_dayBar:SetLocalScale(1, 0, 1)
    end
    return obj
end

function MilitaryRankBattlePassView:FindFirstAwardIndex()
    local maxIndex = self.isBuy and #self.awardCfgArray - 5 or #self.awardCfgArray - 3
    local cfg
    local index = 1
    for i = 1, #self.awardCfgArray do
        cfg = self.awardCfgArray[i]
        if self.lv >= cfg.conditions[2] then
            if not self.model:CheckAwardIsGet(self.id, cfg.id, true) then
                return i > maxIndex and maxIndex - 1 or i - 1
            elseif self.isBuy and not self.model:CheckAwardIsGet(self.id, cfg.id, false) then
                return i > maxIndex and maxIndex - 1 or i - 1
            else
                index = i
            end
        end
    end
    return index > maxIndex and maxIndex - 1 or index - 1
end

---刷新高级战令显示
function MilitaryRankBattlePassView:UpdateBattlePassSenior()
    local itemDic = {}
    local itemNowDic = {}
    local sid
    for i = 1, #self.awardCfgArray do
        for j = 1, #self.awardCfgArray[i].rewards_pay do
            sid = self.awardCfgArray[i].rewards_pay[j][1]
            if itemDic[sid] == nil then
                itemDic[sid] = self.awardCfgArray[i].rewards_pay[j][2]
            else
                itemDic[sid] = itemDic[sid] + self.awardCfgArray[i].rewards_pay[j][2]
            end
            if self.awardCfgArray[i].conditions[2] <= self.lv then
                if itemNowDic[sid] == nil then
                    itemNowDic[sid] = self.awardCfgArray[i].rewards_pay[j][2]
                else
                    itemNowDic[sid] = itemNowDic[sid] + self.awardCfgArray[i].rewards_pay[j][2]
                end
            end
        end
    end
    for _, v in pairs(self.cfg.goods) do
        sid = v[1]
        if itemNowDic[sid] == nil then
            itemNowDic[sid] = v[2]
        else
            itemNowDic[sid] = itemNowDic[sid] + v[2]
        end
    end
    self.allRewards = {}
    for k, v in pairs(itemDic) do
        _G.table.insert(self.allRewards, { k, v })
    end
    self.nowRewards = {}
    for k, v in pairs(itemNowDic) do
        _G.table.insert(self.nowRewards, { k, v })
    end
    if not self.allAndNowInit then
        self.go_table.scrollloophorizontal_seniorAward:InitItemData(
            #self.allRewards,
            _G.handler(self, self.RefreshSeniorAllItem)
        )
        self.go_table.scrollloophorizontal_nowAward:InitItemData(
            #self.nowRewards,
            _G.handler(self, self.RefreshSeniorNowItem)
        )
        self.allAndNowInit = true
    else
        self.go_table.scrollloophorizontal_seniorAward:UpdateCount(#self.allRewards)
        self.go_table.scrollloophorizontal_nowAward:UpdateCount(#self.nowRewards)
    end
end

