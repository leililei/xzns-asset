function MilitaryRankBattlePassView:ShowBuyTips(go, isOn, id)
    self.Lua_buyTips:Show()
end

function MilitaryRankBattlePassView:OnAniEnd()
    --ZHJH-7257 动画缩放导致遮罩对特效的遮挡效果更新异常，延迟加载道具特效
    _G.DelayDo(0.5, function()
        self.loadEff = true
        self:UpdateBattlePass()
    end)
end

function MilitaryRankBattlePassView:OnClickAward(item, tb, isBuy)
    local state = isBuy and tb.payState or tb.freeState
    local canReceived = state == ItemState.Unlock
    if canReceived then
        self:GetAllAward(self.awardLis)
    else
        if item.go_table then
            require "CommonTipManager":GetInstance():OpenTip(item.go_table.gameObject, item.data.sid)
        else
            require "CommonTipManager":GetInstance():OpenTip(item.gameObject, item.data.sid)
        end
    end
end

