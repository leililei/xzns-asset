function MilitaryRankBattlePassView:OnMallCashListener(data)
    self.model.bpInfo[tonumber(data.sid)].is_buy = 1
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.HellBattlePass.id)
    self:UpdateView()
end

function MilitaryRankBattlePassView:GetAward(awardLis)
    self.model:GetBPAward(self.id, awardLis, _G.handler(self, self.OnGetAwardEnd))
end

function MilitaryRankBattlePassView:GetAllAward(awardLis)
    self.model:GetAllBPAward(self.id, awardLis, _G.handler(self, self.OnGetAwardEnd))
end

function MilitaryRankBattlePassView:OnGetAwardEnd()
    self.canSwitch = false
    self:UpdateBattlePass()
end

