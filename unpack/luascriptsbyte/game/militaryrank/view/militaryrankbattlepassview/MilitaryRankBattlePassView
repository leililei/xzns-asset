---刷新战令
function MilitaryRankBattlePassView:UpdateBattlePass()
    self.isBuy = self.model:GetIsBuy(self.id)
    local rect =
        self.go_table.scrollloopvectical_items.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))

    if self.isBuy then
        --self.go_table.obj_senior:SetActiveE(0)
        --self.go_table.obj_bought:SetActiveE(1)
        -- self.go_table.aortext_money.color = _G.Color.New(65 / 255, 65 / 255, 65 / 255, 1)
        self.go_table.aortext_money.text = GetLangPackValue(90022500421)
        self.go_table.aortext_money.color = _G.ColorTools.FormatColorByString("434343")
    else
        --self.go_table.obj_senior:SetActiveE(1)
        --self.go_table.obj_bought:SetActiveE(0)
        self.go_table.aortext_money.color = _G.ColorTools.FormatColorByString("8C2D14")
        local content = _G.GameUtil.SetPriceByChannel(self.cfg.price_id)
        if _G.GameUtil.IsNotPlatformSpecial() then
            self.go_table.aortext_money.text = content
        else
            self.go_table.aortext_money.text = GetLangPackValue(90025500017, content)
        end
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_money.color = _G.ColorTools.FormatColorByString(self.isBuy and "DDE2E6" or "50341D")
        local image = self.go_table.aorbtn_buy:GetComponentE(_G.typeof(_G.CS.AorImage))
        image.SpriteName = self.isBuy and "ui_zssd_lan_btn" or "ui_zssd_cheng_btn"
    end

    local array = self.cfg.content
    local store_season_battlecon_cfg = _G.ConfigManager.store_season_battlecon_cfg
    local cfg
    self.awardCfgArray = {}
    for _, v in pairs(array) do
        cfg = store_season_battlecon_cfg[v]
        _G.table.insert(self.awardCfgArray, cfg)
    end
    self.awardLis = self.model:GetAllUnlockAwards(self.id, self.lv)
    self.go_table.aorbtn_buy:SetActiveE(self.isBuy and 0 or 1)
    self.go_table.aorbtn_oneKey:SetActiveE(0)
    self.go_table.aorbtn_oneKey:SetGray(#self.awardLis == 0)
    self.go_table.aorbtn_oneKey:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(#self.awardLis == 0 and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_oneKey.color = _G.ColorTools.FormatColorByString(#self.awardLis == 0 and "434343" or "8C2D14")
    self.go_table.obj_senior:SetActiveE(self.isBuy and 0 or 1)
    self.go_table.scrollloopvectical_items:SetRectTransformOffset(15, self.isBuy and 16 or 125, -20, -66)
    if not self.bpInit then
        self.go_table.scrollloopvectical_items:InitItemData(#self.awardCfgArray, _G.handler(self, self.RefreshList),
            self:FindFirstAwardIndex())
        self.bpInit = true
    else
        self.go_table.scrollloopvectical_items:UpdateAllItem()
        self.go_table.scrollloopvectical_items:ScrollToIndex(self:FindFirstAwardIndex())
    end
    --self:UpdateBattlePassSenior()

    if not self.isBuy then
        if not self.seniorInit then
            self.seniorInit = true
            self.seniorAwards = self:GetSeniorAwardList()
            self.go_table.scrollloophorizontal_seniorAward:InitItemData(#self.seniorAwards,
                _G.handler(self, self.RefreshSeniorItem))
        end
    end
end

function MilitaryRankBattlePassView:GetSeniorAwardList()
    -- local contentIds = self.bpCfg.content
    local rewardsSumDic = {}
    for _, v in pairs(self.cfg.goods) do
        self:AddAward(rewardsSumDic, v[1], v[2])
    end
    local seniorAwardList = {}
    for k, v in pairs(rewardsSumDic) do
        _G.table.insert(seniorAwardList, { k, v })
    end
    return seniorAwardList
end

function MilitaryRankBattlePassView:RefreshSeniorItem(index, obj)
