function MilitaryRankBattlePassView:CloseView()
    self:Close()
end

function MilitaryRankBattlePassView:OnDestroy()
    self.Lua_buyTips:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return MilitaryRankBattlePassView
