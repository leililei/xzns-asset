local MilitaryRankBattlePassToggleView = _G.BaseClass("MilitaryRankBattlePassToggleView", _G.UIBaseView)

local AState = {
    Close = 1,
    Notice = 2,
    Open = 3,
    Settlement = 4
}

local idList = _G.ConfigManager.discrete_cfg[118002][1]
function MilitaryRankBattlePassToggleView:Awake()
    self.model = require "HellRoadModel":GetInstance()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
end

---界面的入口函数
function MilitaryRankBattlePassToggleView:OnCreate(activityData)
    self.views = {}
    self.color = {
        require("CardInfoManager").GetColorFromRGB("400E0E"), --选中
        require("CardInfoManager").GetColorFromRGB("C6B69D"),
        require("CardInfoManager").GetColorFromRGB("391503"), --选中
        require("CardInfoManager").GetColorFromRGB("e4d3af")
    }
    -- self:InitToggle()
    self.panelInit = {}
    self.panelLua = {}
    self.go_table.aorbtn_chooseSeason:SetActiveE(0)
    self:InitSeason()
    self:UpdateView()
    -- self.toggles[1].gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = false
    -- self.toggles[1].gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.Toggle)).isOn = true
    -- self.militaryRankView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MilitaryRankView.Name)
    -- if self.militaryRankView then
    --     self.militaryRankView:Hide()
    -- end
end

function MilitaryRankBattlePassToggleView:InitSeason()
    self.curSelectIdx = self.model:GetBattlePassJumpID()
    self.curNum = self.model:GetBattlePassNum()
    self.seasonIdLis = _G.ConfigManager.discrete_cfg[118002][1]
    local x,y,z = self.go_table.aorbtn_chooseSeason:GetLocalPosition()
    local bol = self.curNum == 1
    self.go_table.aorbtn_chooseSeason:SetLocalPosition(bol and 1000 or -139,bol and 1000 or y, z)
    self.go_table.scrollloopvectical_season:InitItemData(
        self.curNum,
        _G.handler(self, self.RefreshItem),
        self.curSelectIdx - 1
    )
    self.isSelect = true
    self:UpdateSelect()
end

function MilitaryRankBattlePassToggleView:RefreshItem(index, obj)
    index = index + 1
    ---@type MilitaryRankBattlePassToggleView._obj_seasonItem_GoTable
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local name = _G.ConfigManager.store_season_battle_cfg[self.seasonIdLis[index]].name
    tb.aortext_seasonName.text = name and _G.GetLangPackValue(name) or ""
    tb.aortext_seasonName.color = index == self.curSelectIdx and self.color[3] or self.color[4]
    tb.aorrawimage_select:SetActiveE(index == self.curSelectIdx and 1 or 0)
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.HellBattlePass.id, index)
end

function MilitaryRankBattlePassToggleView:OnClickItem(go, isOn, index)
    if index ~= self.curSelectIdx then
        self.curSelectIdx = index
        self.go_table.scrollloopvectical_season:UpdateAllItem()
        self:UpdateView()
        self:UpdateSelect()
    end
end

function MilitaryRankBattlePassToggleView:UpdateView()
    local sid = self.seasonIdLis[self.curSelectIdx]
    local name = _G.ConfigManager.store_season_battle_cfg[sid].name
    self.go_table.aortext_curSeasonName.text = name and _G.GetLangPackValue(name) or ""
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassView.Name)
    if view then
        view:OnCreate(sid, true)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassView.Name, sid)
    end
end

function MilitaryRankBattlePassToggleView:UpdateSelect()
    self.isSelect = not self.isSelect
    self.go_table.obj_seasonLis:SetActiveE(self.isSelect and 1 or 0)
    self.go_table.aorbtn_selectMask:SetActiveE(self.isSelect and 1 or 0)
    self.go_table.aorimage_selectArray:SetLocalScale(1, self.isSelect and 1 or -1, 1)
end

---ZHJH-2868废弃，改用下拉选择滑动列表
function MilitaryRankBattlePassToggleView:InitToggle()
    self.toggles = {}
    local idList = _G.ConfigManager.discrete_cfg[118002][1]
    local tb, obj
    for i = 1, #idList do
        obj = _G.InstantiateObject(self.go_table.toggle_item, self.go_table.obj_toggles)
        obj:SetActiveE(1)
        obj:SetName("toggle_item" .. i)
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickToggle, i))
        local name = _G.ConfigManager.store_season_battle_cfg[idList[i]].name
        tb.aortext_text.text = name and _G.LangUtil.GetLangPackValue(name) or ""
        self.toggles[i] = tb
        local id = self.model:GetRedpointIDByIndex(idList[i])
        --require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.HellBattlePass.id, i)
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.HellBattlePass.id, i)
    end
end

function MilitaryRankBattlePassToggleView:OnClickToggle(go, isOn, key)
    local idList = _G.ConfigManager.discrete_cfg[118002][1]
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aortext_text.color = isOn and self.color[1] or self.color[2]
    --self.go_table["obj_view" .. key]:SetActiveE(isOn and 1 or 0)
    if isOn then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassView.Name)
        if view then
            view:OnCreate(idList[key], true)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassView.Name, idList[key])
        end
    end
end

function MilitaryRankBattlePassToggleView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.MilitaryRankBattlePassView.Name then
        self.views = _G.UIManager:GetInstance():GetWindowCtrl(name)
        _G.UIManager:GetInstance():ChangeCanvasOrder(
            name,
            self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 10
        )
        self.views.transform:SetParentE(self.go_table["obj_view"])
        self.go_table.aorbtn_chooseSeason:SetActiveE(1)
    end
end

---按钮点击事件在这里派发
function MilitaryRankBattlePassToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_selectMask then
        self:UpdateSelect()
    elseif go == self.go_table.aorbtn_chooseSeason then
        self:UpdateSelect()
    end
end

function MilitaryRankBattlePassToggleView:CloseView(...)
    self:Close()
    -- if self.militaryRankView then
    --     self.militaryRankView:Show()
    --     self.militaryRankView:ShowBattlePass()
    -- end
end

function MilitaryRankBattlePassToggleView:Dispose()
    if self.views then
        self.views:CloseView()
    end
    self:RemoveAllListener()
end

return MilitaryRankBattlePassToggleView
