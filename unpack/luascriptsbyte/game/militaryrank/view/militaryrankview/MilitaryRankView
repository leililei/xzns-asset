local HellRoadModel = require "HellRoadModel"
---@class MilitaryRankView : UIBaseView	中文描述
---@field public go_table MilitaryRankView_GoTable GoTable
---@field TaskItems MilitaryRankTaskItem[]
---@field curHellCfg hell_title_cfg
---@field TaskDatas HellRoadTaskData[]
---@field curTaskDatas HellRoadTaskData[]
---@field PropItems MilitaryRankView._obj_AttrItem_GoTable[]
---@field Ranks MilitaryRankView._obj_RankItem_GoTable
local MilitaryRankView = _G.BaseClass("MilitaryRankView", _G.UIBaseView)

local state = {
    Last = 1,
    Current = 2,
    Next = 3
}

local fadeTime = {
    [1] = 0.2,
    [2] = 0.12
}

function MilitaryRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MilitaryRankView:OnCreate(call)
    self:Init()
    local resources = _G.ConfigManager.ui_cfg.MilitaryRankView.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, resources))
    self.playerHead =
        self:AddComponent(
            self.go_table.trans_PlayerHead,
            require("PlayerComponent").New(self.go_table.trans_PlayerHead)
        )
    -- if not HellRoadModel:GetInstance():CheckGetDaily() then
    --     self:GetDaily()
    -- end
    self.go_table.obj_battlePassObj:SetActiveE(_G.AppSetting.IsArraigned and 0 or 1)
    self.BubbleTimer =
        _G.TimerManager:GetInstance():GetTimer(
            self.BubbleCol + self.BubbleDur,
            self.UpdateBubble,
            self,
            false,
            false,
            true
        )
    self.BubbleTimer:Start()
    if call then
        self.call = call
    end

    self:AddListener(_G.eHellRoad.RefreshPanel, self.UpdateDailyAward)
    self:AddListener(_G.eHellRoad.HellGetAwardEnd, self.ShowBattlePass)
end

function MilitaryRankView:OnDisable()
    self:StopTimer()
end

function MilitaryRankView:Init()
    self:InitData()
    self:InitView()
end

---初始化数据
function MilitaryRankView:InitData()
    self.AwardList = {}
    self.TaskItems = {}
    self.PropItems = {}
    self.Ranks = {}
    self.RankIndexT = {} 
    local BubbleSetting = _G.ConfigManager.discrete_cfg[118001]
    self.BubbleDur = BubbleSetting[1][1]
    self.BubbleCol = BubbleSetting[1][2]
    self.HellCfgs = _G.ConfigManager.hell_title_cfg
    self.TaskCount = 0
    self.BubbleIndex = 0
    self.MaxCount = #self.HellCfgs
    HellRoadModel:GetInstance():SortData()
    self.TaskDatas = HellRoadModel:GetInstance().TaskDatas
    self.CurId = require "HellRoadModel":GetInstance().hellData.h_id
    self.curHellCfg = self.HellCfgs[self.CurId]
    self.curTaskDatas = self.TaskDatas[self.CurId] or {}
end

---初始化界面
function MilitaryRankView:InitView()
    self.go_table.scrollloopvectical_TaskList:InitItemData(0, _G.handler(self, self.RefreshTaskItem))
    self.go_table.scrollloopvectical_AttrList:InitItemData(0, _G.handler(self, self.RefreshPropItem))
    --self.go_table.scrollloophorizontal_AwardList:InitItemData(0, _G.handler(self, self.RefreshAward))
    self.go_table.scrollloophorizontal_RankList:InitItemData(self.MaxCount, _G.handler(self, self.RefreshRank))
    self.curHellCfg = HellRoadModel:GetInstance().curHellCfg
    local isMax = self.curHellCfg.id < self.MaxCount
    self.go_table.aorbtn_Upgrade:SetActiveE(isMax and 1 or 0)
    self.go_table.aortext_MaxLevel:SetActiveE(0)
    self:Change()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
        self.go_table.aorrawimage_portrait:LoadImage("ImagesH5/hMilitaryRank/ui_portrait_nazigelin")
    end
end

function MilitaryRankView:StopTimer()
    if self.BubbleTimer then
        self.BubbleTimer:Stop()
        self.BubbleTimer = nil
    end
end

function MilitaryRankView:Change()
    local id = self.curHellCfg.id
    self:SetCurHell(id)
end

function MilitaryRankView:ShowBattlePass()
    self.BPEff                       = self.BPEff or {}
    local nowIndex, nextIndex, bpSid = HellRoadModel:GetInstance():GetNowBPCfgId()
    local index                      = nil


    local buyBol = HellRoadModel:GetInstance():GetIsBuy(bpSid)
    local canGetBol = HellRoadModel:GetInstance():CheckBPCanTake()
    local normalCanGet = false
    local advanceCanGet = false
    local count = 0
    for i = 1, #_G.ConfigManager.discrete_cfg[118002][1] do
        local newSid = _G.ConfigManager.discrete_cfg[118002][1][i]
        local BPContent = _G.ConfigManager.store_season_battle_cfg[newSid].content
        for j = 1, #BPContent do
            local newIndex = BPContent[j]
            if not HellRoadModel:GetInstance():CheckAwardIsGet(newSid, newIndex, true) then
                normalCanGet = true
                if not index then
                    index = 901000 + count + j
                end
            end
            if not HellRoadModel:GetInstance():CheckAwardIsGet(newSid, newIndex, false) then
                advanceCanGet = true
            end
        end
        count = count + #BPContent
    end

    local isGet = not normalCanGet
    if buyBol then
        isGet = isGet and not advanceCanGet
    end
    if not index then
        index = nowIndex or nextIndex
    end
    local level = index
    if isGet and _G.ConfigManager.store_season_battlecon_cfg[index + 1] then
        level = index + 1
    end
    local ItemList = {
        _G.ConfigManager.store_season_battlecon_cfg[level].rewards_normal[1],
        _G.ConfigManager.store_season_battlecon_cfg[level].rewards_pay[1]
    }
    local name =
        _G.LangUtil.GetLangPackValue(
            _G.ConfigManager.hell_title_cfg[_G.ConfigManager.store_season_battlecon_cfg[level].conditions[2]].name
        )
    self.go_table.aortext_BP.text = _G.LangUtil.GetLangPackValue(90023900010, name)
    self.go_table.obj_eff1:SetActiveE(normalCanGet and 1 or 0)
    self.go_table.obj_eff2:SetActiveE(advanceCanGet and 1 or 0)
    for i = 1, 2 do
        self.go_table["obj_Root" .. i]:ClearChildren()
        local item = require "BaseAwardNewItem".New(self.go_table["obj_Root" .. i], nil, 73)
        item:ShowWithID(ItemList[i])
        if canGetBol then
            if i == 1 or (i == 2 and buyBol) then
                if not self.BPEff[i] then
                    self.BPEff[i] = true
                    _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
                        self.go_table["obj_eff" .. i],
                        function(tran)
                            --- 防止 异步后
                            if _G.IsNil(self.go_table.gameObject) then
                                tran:DestroyObject()
                                return
                            end

                            if tran ~= nil then
                                tran:SetLocalScaleXYZ(0.8)
                                tran:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                                self.BPEff[i] = tran
                            end
                        end
                    )
                elseif self.BPEff[i] ~= true then
                    self.BPEff[i]:SetActiveE(1)
                end
            end
        elseif self.BPEff[i] and self.BPEff[i] ~= true then
            self.BPEff[i]:SetActiveE(0)
        end
    end
    --self.go_table.obj_suo2:SetActiveE(buyBol and 0 or 1)
    self.go_table.obj_BPredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.HellBattlePass.id, -1)
end

---头衔置灰
---@param obj UnityEngine.GameObject
function MilitaryRankView:SetGray(obj, bool)
    local image = obj:FindE("@_obj_Bg"):GetComponentE(_G.typeof(_G.CS.AorImage))
    image:SetGray(bool)
end

---设置当前显示的地狱道
function MilitaryRankView:SetCurHell(id)
    self.isCur = id == self.CurId
    if HellRoadModel:GetInstance().curHellCfg.id == id then
        self.state = state.Current
    elseif HellRoadModel:GetInstance().curHellCfg.id > id then
        self.state = state.Last
    else
        self.state = state.Next
    end

    --self.go_table.aortext_DailyAwardText.text = _G.ConfigManager.language_package_cfg[_G.ConfigManager.hell_title_cfg[id].name] .. _G.GetLangPackValue(90023900009)

    if self.inited ~= nil then
        self.inited = true
        self:RefreshTask()
    else
        self.inited = false
        _G.TimerManager:GetInstance():GetTimer(0.2, self.RefreshTask, self, true, false, false):Start()
    end

    self.attrData = HellRoadModel:GetInstance():GetAllAttr(id)
    self:UpdateDailyAward()
    self:UpdateProp()
    self:UpdateRankList()
    self:UpdateTaskProgress()
    self:ShowBattlePass()
end

function MilitaryRankView:GetTaskProgress()
    local count = HellRoadModel:GetInstance():GetFinishCount()
    local taskCount = self.curTaskDatas and #self.curTaskDatas or 0
    if self.state == state.Last then
        count = taskCount
    elseif self.state == state.Next then
        count = 0
    end
    return count, taskCount
end

function MilitaryRankView:GetDaily()
    HellRoadModel:GetInstance():GetDaily(
        function()
            self:UpdateDailyMask()
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Daily, false)
        end
    )
end

function MilitaryRankView:FinishTask(go)
    if _G.IsNil(self.gameObject) then
        return
    end
    self.inited = true
    self:UpdateTaskProgress()
    if HellRoadModel:GetInstance():GetFinishCount() == 0 then
        self:UpdatePanel()
    else
        self.go_table.scrollloopvectical_TaskList:UpdateAllItem()
    end
end

function MilitaryRankView:ShowItem(tb)
    tb.timer = nil
    _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
end

function MilitaryRankView:ShowBtn()
    if self.isCur then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Daily, not HellRoadModel:GetInstance():CheckGetDaily())
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_Daily, false)
    end
end

function MilitaryRankView:Promote()
    HellRoadModel:Promote(self.CurId, self.power)

    self:Init()
end

function MilitaryRankView:UpdateRankList()
    local nowId = self.CurId
    local index = nowId <= 2 and 0 or nowId - 2
    self.go_table.scrollloophorizontal_RankList:ScrollToIndex(index)
end

function MilitaryRankView:UpdateBubble()
    local text = self.curHellCfg.text
    local count = #text
    local index = _G.math.random(1, count)
    local tb = self.go_table
    while index == self.BubbleIndex do
        index = _G.math.random(1, count)
    end
    self.BubbleIndex = index
    self.go_table.aorimage_Bubble:DOFade(1, fadeTime[2])
    self.go_table.aortext_BubbleText.text = _G.GetLangPackValue(text[index])
    self.go_table.aortext_BubbleText:DOFade(1, fadeTime[1])
    _G.DelayDo(
        self.BubbleDur,
        function()
            if self:IsNil() then
                return
            end
            tb.aorimage_Bubble:DOFade(0, fadeTime[1])
            tb.aortext_BubbleText:DOFade(0, fadeTime[2])
        end
    )
end

