---更新界面显示
function MilitaryRankView:UpdatePanel()
    self.TaskDatas = HellRoadModel:GetInstance().TaskDatas
    self:Change()
end

function MilitaryRankView:UpdateProp()
    self.go_table.scrollloopvectical_AttrList:UpdateCount(#HellRoadModel:GetInstance().curHellCfg.attribute)
end

function MilitaryRankView:UpdateDailyMask()
    for _, v in pairs(self.AwardList) do
        _G.GameUtil.SetActiveByCondition(
            v.go_table.obj_mask,
            HellRoadModel:GetInstance():CheckGetDaily() and self.isCur
        )
    end
    self:ShowBtn()
end

---更新任务进度
function MilitaryRankView:UpdateTaskProgress()
    local count, taskCount = self:GetTaskProgress()
    local index = self.CurId + 1
    if index > self.MaxCount then
        index = self.MaxCount
        for k, v in pairs(self.RankIndexT) do 
            if v == index then 
                k.slider_Progress.value = 1
            end
        end
    else
        for k, v in pairs(self.RankIndexT) do 
            if v == index then 
                k.slider_Progress.value = count / taskCount
            end
        end
    end
    local btn = self.go_table.aorbtn_Upgrade
    local bool = count < taskCount
    btn:SetGray(bool)
    btn:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(bool and "A9A9A9" or "FFFFFF")
    btn:FindE("Label"):GetComponentE(_G.typeof(_G.CS.AorText)).color =
        _G.ColorTools.FormatColorByString(bool and "434343" or "8C2D14")
end

function MilitaryRankView:RefreshTask()
    self.go_table.scrollloopvectical_TaskList:UpdateCount(#self.curTaskDatas)
end

---刷新任务显示
function MilitaryRankView:RefreshTaskItem(index, item)
    local instanceID = item:GetInstanceIDE()
    local tb = self.TaskItems[instanceID]
    local data = self.curTaskDatas[index + 1]
    if not tb then
        tb = require "MilitaryRankTaskItem".New(item, _G.handler(self, self.FinishTask))
        self.TaskItems[instanceID] = tb
    end
    tb = self.TaskItems[instanceID]
    tb:Show(data, self.state)
    tb.gameObject:SetName(index)
    if tb.timer then
        tb.timer:Stop()
        tb.timer = nil
    end
    if not self.inited then
        _G.GameUtil.SetActiveByCondition(item, false)
        tb.timer = _G.TimerManager:GetInstance():GetTimer(index * 1, self.ShowItem, self, true, true, true, tb)
        tb.timer:Start()
    end
end

---刷新奖励
function MilitaryRankView:RefreshAward(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.AwardList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73)
        self.AwardList[id] = item
    end
    item:ShowWithID(self.awardCfg.reward[index + 1])
end

---刷新军衔
function MilitaryRankView:RefreshRank(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    local tb = self.Ranks[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.Ranks[id] = tb
    end
    self.RankIndexT[tb] = index
    tb.slider_Progress:SetActiveE(index == 1 and 0 or 1)
    if index - 1 > self.CurId then
        tb.slider_Progress.value = 0
    elseif index - 1 < self.CurId then
        tb.slider_Progress.value = 1
    else
        self:UpdateTaskProgress()
    end
    tb.obj_UnlockBg:SetLocalScaleXYZ(index == self.CurId and 1 or 0.84)

    tb.obj_UnlockBg:SetActiveE(index == self.CurId and 1 or 0)
    self:SetGray(tb.gameObject, index > self.CurId)
    HellRoadModel:GetInstance():ShowRank(tb.transform, index)
end

---刷新属性显示
function MilitaryRankView:RefreshPropItem(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    local tb = self.PropItems[id]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.PropItems[id] = tb
    end
    local data = HellRoadModel:GetInstance().curHellCfg.attribute[index]
    tb.aortext_AttrName.text =
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[data[1]].ID].name)
    local cfg = _G.AttributeClassManager:GetInstance():GetAttaributeCfgWithName(data[1])
    local value =
        self.attrData:GetValueByName(
            data[1],
            _G.tonumber(data[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
        )
    if cfg.value_type == 1 then
        if value < 1 then
            tb.aortext_AttrNum.text = _G.math.floor(value * 100) .. "%"
        else
            tb.aortext_AttrNum.text = _G.math.floor(value)
        end
    elseif cfg.value_type == 2 then
        tb.aortext_AttrNum.text = _G.math.floor(value * 100) .. "%"
    end
end

---按钮点击事件在这里派发
function MilitaryRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
        self:StopTimer()
        if self.call then
            self.call()
        end
    elseif go == self.go_table.aorbtn_Daily then
        --self:GetDaily()
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassToggleView.Name)
    elseif go == self.go_table.aorbtn_Upgrade then
        local now, max = self:GetTaskProgress()
        if now < max then
            return
        else
            --self:Promote()
            self.power = _G.StorageManager:GetInstance():GetPlayerPower()
            HellRoadModel:GetInstance():Upgrade(function()
                self:Promote()
            end)
        end
    end
end

function MilitaryRankView:OnDestroy()
    self:RemoveListener(_G.eHellRoad.RefreshPanel, self.UpdateDailyAward)
    self:RemoveListener(_G.eHellRoad.HellGetAwardEnd, self.ShowBattlePass)
end

return MilitaryRankView
