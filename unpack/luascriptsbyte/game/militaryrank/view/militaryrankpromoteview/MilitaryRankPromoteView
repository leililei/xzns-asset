local HellRoadModel = require "HellRoadModel"
---@class MilitaryRankPromoteView : UIBaseView	中文描述
---@field public go_table MilitaryRankPromoteView_GoTable GoTable
---@field AttrItems MilitaryRankPromoteView._obj_AttrItem_GoTable[]
---@field AwardItems MilitaryRankPromoteView._obj_Award_GoTable[]
local MilitaryRankPromoteView = _G.BaseClass("MilitaryRankPromoteView", _G.UIBaseView)

function MilitaryRankPromoteView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MilitaryRankPromoteView:OnCreate(id, power)
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.MilitaryRankPromoteView, self.go_table)
    self.CurId = id
    self:Init()
    local offset = _G.StorageManager:GetInstance():GetPlayerPower() - power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(power, offset)
    end
end

function MilitaryRankPromoteView:Init()
    self:InitData()
    self:InitView()
    _G.AudioManager.PlayAudioByAudioCfgID(2057)
    local view = self.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
    view.sortingOrder = view.sortingOrder + 110
end

---初始化数据
function MilitaryRankPromoteView:InitData()
    self.AttrItems = {}
    self.AwardItems = {}
    self.RightAwardCfg, self.battlePassId = HellRoadModel:GetInstance():GetBattlePassAwardByID(self.CurId + 1)
    self.isBuy = HellRoadModel:GetInstance():GetIsBuy(self.battlePassId)
    -- self.LeftAwardCfg = _G.ConfigManager.hell_title_cfg[self.CurId].reward
    -- self.RightAwardCfg = _G.ConfigManager.hell_title_cfg[self.CurId + 1].reward
end

---初始化界面
function MilitaryRankPromoteView:InitView()
    self.go_table.aortext_Content.text =
        _G.GetLangPackValue(
            90012200001,
            _G.PlayerModel:GetInstance():GetName(),
            "【" .. _G.ConfigManager.language_package_cfg[_G.ConfigManager.hell_title_cfg[self.CurId + 1].name] .. "】"
        )
    HellRoadModel:GetInstance():ShowRank(self.go_table.obj_Left, self.CurId)
    HellRoadModel:GetInstance():ShowRank(self.go_table.obj_Right, self.CurId + 1)
    self.attrData = HellRoadModel:GetInstance():GetAllAttr(self.CurId)
    self.attrData2 = HellRoadModel:GetInstance():GetAllAttr(self.CurId + 1)
    self.go_table.scrollloopvectical_AttrList:InitItemData(
        #HellRoadModel:GetInstance().curHellCfg.attribute,
        _G.handler(self, self.RefreshAttrItem)
    )
    -- self.go_table.scrollloophorizontal_LeftAward:InitItemData(#self.LeftAwardCfg, _G.handler(self, self.RefreshLeftAward))
    if not _G.AppSetting.IsArraigned then
        self.go_table.scrollloophorizontal_RightAward:InitItemData(
            #self.RightAwardCfg,
            _G.handler(self, self.RefreshRightAward)
        )
    else
        self.go_table.scrollloophorizontal_RightAward:SetActiveE(0)
        self.go_table.obj_AwardTitle:SetActiveE(0)
        self.go_table.aorbtn_get:SetActiveE(0)
    end
    self:InitEffect()
end

function MilitaryRankPromoteView:InitEffect()
    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_sunlight, self.go_table.obj_EffNode)
    _G.UIUtils.LoadEffectByPath(
        "UIH5/UI_effect/junxianjingsheng_effect/ef_jinshengguangxiao",
            self.go_table.obj_EffNode,
            nil,
            nil,
            0,
            {-2, 415, 0},
            1,
            0,
            true,
            false,
            false
    )
end

---刷新属性显示
function MilitaryRankPromoteView:RefreshAttrItem(index, obj)
    index = index + 1
    local tb = self.AttrItems[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.AttrItems[index] = tb
    end
    local data = HellRoadModel:GetInstance().curHellCfg.attribute[index]
    tb.aortext_AttrName.text =
        _G.LangUtil.GetLangPackValue(_G.ConfigManager.type_attribute_cfg[_G.AttrType[data[1]].ID].name)
    local cfg = _G.AttributeClassManager:GetInstance():GetAttaributeCfgWithName(data[1])
    local value =
        self.attrData:GetValueByName(
            data[1],
            _G.tonumber(data[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
        )
    local value2 =
        self.attrData2:GetValueByName(
            data[1],
            _G.tonumber(data[2]) == 1 and _G.AttCountType.other or _G.AttCountType.basePercent
        )
    if cfg.value_type == 1 then
        if value < 1 then
            tb.aortext_AttrOldNum.text = _G.math.floor(value * 100) .. "%"
            tb.aortext_AttrNewNum.text = _G.math.floor(value2 * 100) .. "%"
        else
            tb.aortext_AttrOldNum.text = _G.math.floor(value)
            tb.aortext_AttrNewNum.text = _G.math.floor(value2)
        end
    elseif cfg.value_type == 2 then
        tb.aortext_AttrOldNum.text = _G.math.floor(value * 100) .. "%"
        tb.aortext_AttrNewNum.text = _G.math.floor(value2 * 100) .. "%"
    end
    if not tb.eff then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_shuxingsaoguang,
            tb.obj_eff,
            function(obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
                tb.eff = obj
                obj:SetLocalPositionToZero()
            end)
    end
end

---刷新左侧奖励
function MilitaryRankPromoteView:RefreshLeftAward(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.AwardItems[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 88)
        self.AwardItems[id] = item
    end
    item:ShowWithID(self.LeftAwardCfg[index + 1])
end

---刷新右侧奖励
function MilitaryRankPromoteView:RefreshRightAward(index, obj)
    index = index + 1
    local id = obj:GetInstanceIDE()
    local item = self.AwardItems[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, _G.handler(self, self.OnClickAward), 88)
        self.AwardItems[id] = item
    end
    item:ShowWithID(self.RightAwardCfg[index])
    local tb = _G.GetAutoGoTable(obj)
    if index == 1 then
        tb.aortext_type.text = _G.GetLangPackValue(90023900011)
    elseif index == 2 then
        tb.aortext_type.text = _G.GetLangPackValue(90023900012)
    end
    if not tb.eff then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
            tb.obj_Root,
            function(trans)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(trans)
                    return
                end
                tb.eff = trans
            end
        )
    end
    -- if index == 1 or self.isBuy and index > 1 then
    _G.DelayDo(0.5, _G.handlerbind(self, self.LoadItemEffect, tb.obj_Root))     --动画延迟
    -- end
end

function MilitaryRankPromoteView:LoadItemEffect(obj)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_kelingqukuang,
        obj,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function MilitaryRankPromoteView:OnClickAward()
    self:Close()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassToggleView.Name)
end

---按钮点击事件在这里派发
---@param go UnityEngine.GameObject
function MilitaryRankPromoteView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_get then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MilitaryRankBattlePassToggleView.Name)
        self:Close()
    end
end

return MilitaryRankPromoteView
