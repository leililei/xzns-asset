local ActivitySynManager = require "ActivitySynManager"
local base = require "ActivitySynTypeBase"
---@class TarotModel : ActivitySynTypeBase 塔罗牌
local TarotModel = _G.BaseClass("TarotModel", base)

function TarotModel:__init(activity)
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    base.__init(self, activity)
end

---进入活动主体
function TarotModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TarotView.Name, self.activity)
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function TarotModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.TarotView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end

function TarotModel:GetInfo(call)
    self.CallBack = call
    require("ActivitySynNet"):GetInstance():InitActivity(
        self.curActivityClass:GetActivityID(),
        _G.handler(self, self.UpdateInitData)
    )
end
function TarotModel:UpdateInitData(msg)
    if msg.ack == 1 then
        self:OnHandleGMData(msg.activity[1].self_info)
    end
end

---获取GM数据
---@param info activity.i_activity_self_info
function TarotModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function TarotModel:ParseData(info)
    self:SetSelfData(info)
    base.ParseData(self)
end

---获取活动代币id
function TarotModel:GetCoinId()
    return self.Info.cfg_info.coin_id
end

---获取活动代币数量
function TarotModel:GetCoinNum()
    return self.Info.coin
end

---初始化数据
---@param info activity.i_activity_self_info
function TarotModel:SetSelfData(info)
    self.Info = info.tarot
    if _G.AppSetting.DEBUG then
        _G.Log(self.Info, "塔罗牌完整数据")
        _G.Log(self.Info.coin, "塔罗牌代币数量")
        _G.Log(self.Info.cfg_info.coin_id, "塔罗牌代币id")
    end
    require "TarotManager":GetInstance():SetData(self)

    if nil == self.Info.info or #self.Info.info <= 0 then
        local msg = {}
        local infokv = {}
        local drawInfo = {}
        for i = 1, 22 do
            local kv = {}
            kv.k = i
            kv.v = i
            table.insert(infokv, kv)
            local dinfo = {}
            dinfo.index = i
            dinfo.image = i
            dinfo.a_index = 0
            table.insert(drawInfo, dinfo)
        end
        msg.info = infokv
        msg.activity_id = self.curActivityClass.activityID
        require "TarotNet":GetInstance():SetImage(msg)
        self.Info.info = drawInfo
    end

    _G.SortList(
        self.Info.info,
        function(a)
            return -a.index
        end
    )

    self.SyTime = self:GetTime()
    if self.SyTime > 0 then
        self.SyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.GoSyTime, self, false, false, true)
        self.SyTimer:Start()
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DrawFLOR.id)
    end

    if self.CallBack then
        self.CallBack()
        self.CallBack = nil
    end
end

function TarotModel:GoSyTime(elapsed)
    self.SyTime = self.SyTime - elapsed
    if self.SyTime <= 0 then
        self.curActivityClass:ChangeState(ActivitySynManager.State.Close)
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
end

---剩余时间计算
function TarotModel:GetTime()
    local timeShengYu = 0
    if self.curActivityClass and self.curActivityClass.cfg then
        timeShengYu =
            self.curActivityClass.cfg.time.start_time + self.curActivityClass.cfg.time.run_time -
            _G.TimeUtil.GetServerUnixTime()
    end
    return timeShengYu
end

---增加代币
function TarotModel:AddCoin(num)
    self.Info.coin = self.Info.coin + num
    local tmp = {}
    _G.table.insert(tmp, self.Info.cfg_info.coin_id)
    _G.table.insert(tmp, num)
    _G.table.insert(tmp, self.Info.coin)
    _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, {{type = tmp}})

    self:RefreshRedPoint()
end

---获取基础奖励数据
function TarotModel:GetBaseAward(aindex)
    if aindex == 1 then
        return self.Info.big_award
    else
        return self.Info.cfg_info.base_award[aindex - 1].award
    end
end

---获取大奖奖励数据
function TarotModel:GetBigAward(aindex)
    return self.Info.cfg_info.big_award[aindex]
end

---修改当前奖励
function TarotModel:ChangeFaceByIndex(aindex, index)
    for i = 1, #self.Info.info do
        if self.Info.info[i].index == index then
            self.Info.info[i].a_index = aindex
            break
        end
    end
end

function TarotModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
    end
    if self.SyTimer then
        self.SyTimer:Stop()
        self.SyTimer = nil
    end
    base.Dispose(self)
end

---绑定子活动
function TarotModel:GetOtherActivityRedPointIds()
    return {10007, 10014}
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function TarotModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

---检测活动条件（没开到大奖并且有券）
function TarotModel:CheckRedPoint()
    local isOpenBig = false
    local len = #self.Info.info
    for i = 1, len do
        if self.Info.info[i].a_index == 1 then
            isOpenBig = true
            break
        end
    end
    if not isOpenBig and _G.StorageManager:GetInstance():CheckItem(_G.ConfigManager.discrete_cfg[115104][1][1]) then
        return 1
    end
    return 0
end

---刷新奖励红点
function TarotModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end
---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function TarotModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

return TarotModel
