local TarotNet = require "TarotNet"
local TarotManager = require "TarotManager"
---@class TarotCardFace : Component	中文描述
---@field cfg card_cfg
local TarotCardFace = _G.BaseClass("TarotCardFace", _G.Component)

---创建对象时,入口构造函数
function TarotCardFace:OnCreate(obj, index, faceindex, view)
    self.Index = index
    self.FaceIndex = faceindex
    self.View = view
    self.go_table = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickCardFace))
    self.TarotClass = TarotManager:GetInstance():GetData()
    self.FaceInfo = self.TarotClass.Info.info[index]
    self.IsOpen = self.FaceInfo.a_index > 0
    self:UpdateBtn()
    self.View.go_table.aorbtn_bag:SetActiveE(0)
    self:UpdatePos()
    self:ShowFace()
    self.ShowTime = _G.ConfigManager.discrete_cfg[115101][1][1]
    self.OneKeyShowTime = _G.ConfigManager.discrete_cfg[115102][1][1]
    self.ToNextShowTime = _G.ConfigManager.discrete_cfg[115103][1][1]
end

function TarotCardFace:UpdateBtn()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_do, not self.IsOpen)
end

function TarotCardFace:UpdatePos()
    local x, y, z = self.go_table.gameObject:GetPosition()
    self.x = x
    self.y = y
    self.z = z
end

function TarotCardFace:ShowFace()
    if nil == self.BigAwardOpenEffect then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_fanpaixiaoguo,
                self.go_table.obj_openEffect,
                function(tran)
                    if self.go_table==nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    self.BigAwardOpenEffect = tran
                    self.go_table.obj_openEffect:SetActiveE(0)
                end
        )
    end
    if self.IsOpen then
        local award = self.TarotClass:GetBaseAward(self.FaceInfo.a_index)
        if not self.go_table.LoadTans then
            self.go_table.LoadTans = 1
            _G.StorageManager:GetInstance():GetItemBaseView(
                award[1],
                award[2],
                self.go_table.obj_item,
                function(item)
                    self.go_table.LoadTans = item
                    self.go_table.gameObject:SetEulerAngles(0, 0, 0)
                    self.go_table.obj_item:SetLocalScale(0.8, 0.8, 1)
                    --self.go_table.obj_item:SetLocalPosition(0, 15, 0)
                    _G.GameUtil.SetActiveByCondition(item.gameObject, true)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)

                    if self.FaceInfo.a_index==1  then
                        _G.UIUtils.LoadEffectByCfg(
                                _G.ConfigManager.ui_effect_cfg.ef_dajiang,
                                self.go_table.obj_bigLoopEffect,
                                function(tran)
                                    if self.go_table==nil then
                                        _G.DestroyObject(tran)
                                        return
                                    end
                                    self.BigAwardEffect = tran
                                    self.BigAwardEffect:SetLocalPosition(0, 0, 0)
                                end
                        )
                        self.go_table.obj_bigLoopEffect:SetActiveE(1)
                    else
                        item:ShowOrHideEffect(false)
                    end
                    self.go_table.aorimage_cardbg.SpriteName = "ui_jgtl_zjm_card"

                    self.go_table.aorimage_cardbg:SetNativeSize()
                    --self.go_table.aorimage_cardface:SetActiveE(0)
                    self.go_table.obj_item:SetActiveE(1)
                end
            )
        end
    else
        --self.go_table.aorimage_cardface.SpriteName = "ui_wangnvtaluo_tuxing" .. self.FaceIndex
        self.go_table.obj_item:SetLocalScale(0.8, 0.8, 1)
        --self.go_table.obj_item:SetLocalPosition(0, 15, 0)
        self.go_table.obj_item:SetActiveE(0)
    end
end

---点击上面
function TarotCardFace:ClickCardFace()
    if _G.AppSetting.DEBUG then
        _G.Log(self.Index, "当前翻牌位置为")
        _G.Log(self.FaceIndex, "当前翻牌上面为")
    end

    if self.View.IsOpenCarding then
        return
    end

    if self.View.ActionState == _G.TaortCardState.OneKey then
       return 
    end

    if not _G.StorageManager:GetInstance():CheckItem(_G.ConfigManager.discrete_cfg[115104][1][1]) then
        --if _G.AppSetting.DEBUG then
        --LogError("代币不足")
        --end
        --_G.PopWindowManager:GetInstance():ShowAllTips(930103)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.discrete_cfg[115104][1][1])
        return
    end

    local curAward = self.TarotClass.Info.big_award or {}
    if #curAward <= 0 then
        --if _G.AppSetting.DEBUG then
        --LogError("还未选择大奖")
        --end
        _G.PopWindowManager:GetInstance():ShowAllTips(930102)
        return
    end

    if self.View.GetBigAward then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            930106,
            nil,
            function()
                self:ChooseAward()
            end
        )
        return
    end

    if self.IsOpen then
        --if _G.AppSetting.DEBUG then
        --LogError("当前卡面已开奖")
        --end
        return
    end

    self:ChooseAward()
end

function TarotCardFace:ChooseAward()
    local msg = {}
    msg.index = self.Index
    msg.activity_id = self.TarotClass.curActivityClass.activityID
    TarotNet:GetInstance():ChooseAward(
        msg,
        function(data)
            if data.ack == 1 then
                if data.award.overflow then 
                    self.FaceId = data.award.overflow[1].type[1]
                    self.FaceNum = data.award.overflow[1].type[2]
                else 
                    self.FaceId = data.award.item[1].type[1]
                    self.FaceNum = data.award.item[1].type[2]
                end
                --奖励
                _G.StorageManager:GetInstance():ReceiveAwardData(data)

                self.IsOneKey = false
                self.FaceInfo.a_index = data.c_a[1].a_index
                self:CreateItem(
                    function()
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, data)
                    end,
                    true
                )

                --require "TarotManager":GetInstance():AddCoin(-1)
                _G.StorageManager:GetInstance():ConsumeItem(_G.ConfigManager.discrete_cfg[115104][1][1], 0, 1)
                self.TarotClass:ChangeFaceByIndex(self.FaceInfo.a_index, self.Index)

                self.TarotClass:RefreshRedPoint()
            end
        end
    )
end

---一键翻牌接口
function TarotCardFace:OneKeyDoOne(awardItem, c_a, callBack, gotoBag, animation)
    self.IsOneKey = true
    -- self.FaceId = awardItem.type[1]
    -- self.FaceNum = awardItem.type[2]
    local award = self.TarotClass:GetBaseAward(c_a.a_index)
    self.FaceId = award[1]
    self.FaceNum = award[2]
    self.FaceInfo.a_index = c_a.a_index
    self:CreateItem(callBack, gotoBag, animation)
end

---创建物品
function TarotCardFace:CreateItem(callBack, gotoBag, animation)
    self.IsOpen = true
    self:UpdateBtn()
    self.go_table.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseView(
        self.FaceId,
        self.FaceNum,
        self.go_table.obj_item,
        function(item)
            self.go_table.LoadTans = item
            item.gameObject:SetLocalScaleXYZ(1)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            if self.FaceInfo.a_index == 1 then
                item:ShowEffect(true)
            else
                item:ShowOrHideEffect(false)
            end
            if animation then
                self:ShowDrawFace(callBack, gotoBag)
            else
                self:DoFace(callBack, gotoBag)
            end
        end
    )
end

---直接开牌
function TarotCardFace:DoFace(callBack, gotoBag)
    if self.FaceInfo.a_index == 1 then
        oldParent = self.go_table.gameObject:GetParent()
        local sx, sy = oldParent:GetRectTransformSize()
        local x, y, z = oldParent:GetLocalPosition()
        self.View.go_table.obj_bigTempParent:SetRectTransformSize(sx, sy)
        self.View.go_table.obj_bigTempParent:SetLocalPosition(x, y, z)
        self.go_table.gameObject:SetParentE(self.View.go_table.obj_bigTempParent)
    end
    self.go_table.aorimage_cardbg.SpriteName = "ui_jgtl_zjm_card"
    self.go_table.aorimage_cardbg:SetNativeSize()
    self.go_table.gameObject:SetEulerAngles(0, 0, 0)
    self.go_table.obj_item:SetActiveE(1)
    --self.go_table.obj_openEffect:SetActiveE(0)
    if nil == self.BigAwardEffect then
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_dajiang,
                self.go_table.obj_bigLoopEffect,
                function(tran)
                    if self.go_table==nil then
                        _G.DestroyObject(tran)
                        return
                    end
                    self.BigAwardEffect = tran
                    self.BigAwardEffect:SetLocalPosition(0, 0, 0)
                end
            )
        self.BigAwardEffect = 1
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_bigLoopEffect, self.FaceInfo.a_index == 1)
    if self.FaceInfo.a_index == 1 then
        if not self.IsOneKey then
            self.View.GetBigAward = true
            self.View:CreatePortal(true)
        end
        self.go_table.gameObject:SetParentE(oldParent)
        self.go_table.gameObject:SetLocalScale(1, 1, 1)
    end

    if callBack then
        callBack()
    end
end

---翻牌效果
function TarotCardFace:ShowDrawFace(callBack, gotoBag)
    local time = self.ShowTime / 2
    if self.IsOneKey then
        time = self.OneKeyShowTime / 2
    end
    local oldParent
    local openCard = function()
        self.go_table.obj_openEffect:SetActiveE(1)
        _G.DelayDo(0.8,function()
            self.go_table.obj_openEffect:SetActiveE(0)
        end)
        self.DtRotate =
            self.go_table.transform:DOLocalRotate(_G.Vector3.New(0, -90, 0), time):OnComplete(
            function()
                self.go_table.aorimage_cardbg.SpriteName = "ui_jgtl_zjm_card"
                self.go_table.aorimage_cardbg:SetNativeSize()
                --self.go_table.aorimage_cardface:SetActiveE(0)
                --大奖ui_wangnvtaluo_taluopaizhengmian_dajiang
                self.DtRotate =
                    self.go_table.transform:DOLocalRotate(_G.Vector3.New(0, -180, 0), time):OnComplete(
                    function()
                        self.go_table.gameObject:SetEulerAngles(0, 0, 0)
                        self.go_table.obj_item:SetActiveE(1)
                        --self.go_table.obj_openEffect:SetActiveE(0)
                        if nil == self.BigAwardEffect then
                             _G.UIUtils.LoadEffectByCfg(
                                 _G.ConfigManager.ui_effect_cfg.ef_dajiang,
                                 self.go_table.obj_bigLoopEffect,
                                 function(tran)
                                     if self.go_table==nil then
                                         _G.DestroyObject(tran)
                                         return
                                     end
                                     self.BigAwardEffect = tran
                                     self.BigAwardEffect:SetLocalPosition(0, 0, 0)
                                 end
                             )
                            self.BigAwardEffect = 1
                        end
                        _G.GameUtil.SetActiveByCondition(self.go_table.obj_bigLoopEffect, self.FaceInfo.a_index == 1)
                        if self.FaceInfo.a_index == 1 then
                            if not self.IsOneKey then
                                self.View.GetBigAward = true
                                self.View:CreatePortal(true)
                            end
                            self.go_table.gameObject:SetParentE(oldParent)
                            _G.DelayDo(0.3,
                                function()
                                    self.go_table.gameObject:DOScale(1, 1, 1, 0.6):OnComplete(
                                        function()
                                            if callBack then
                                                callBack()
                                            end
                                            -- if gotoBag then
                                            --     self:ShowMovetoBag()
                                            -- end
                                        end
                                    )
                                end
                            )
                        else
                            _G.DelayDo(0.15,function()
                                if callBack then
                                    callBack()
                                end
                            end)
                            -- if gotoBag then
                            --     self:ShowMovetoBag()
                            -- end
                        end
                    end
                )
            end
        )
    end

    if self.FaceInfo.a_index == 1 then
        oldParent = self.go_table.gameObject:GetParent()
        local sx, sy = oldParent:GetRectTransformSize()
        local x, y, z = oldParent:GetLocalPosition()
        self.View.go_table.obj_bigTempParent:SetRectTransformSize(sx, sy)
        self.View.go_table.obj_bigTempParent:SetLocalPosition(x, y, z)
        self.go_table.gameObject:SetParentE(self.View.go_table.obj_bigTempParent)
        self.go_table.gameObject:DOScale(1.5, 1.5, 1, 0.3):OnComplete(
            function()
                openCard()
            end
        )
        time = time * 5
    else
        openCard()
    end
end

