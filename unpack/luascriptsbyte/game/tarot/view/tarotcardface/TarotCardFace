function TarotCardFace:Reset()
    self.IsOpen = false
    self.go_table.obj_openEffect:SetActiveE(0)
    self.go_table.obj_bigLoopEffect:SetActiveE(0)
    self:UpdateBtn()
    --self.go_table.aorimage_cardface.SpriteName = "ui_wangnvtaluo_tuxing" .. self.FaceIndex
    --self.go_table.aorimage_cardface:SetActiveE(1)
    self.go_table.obj_item:SetActiveE(0)
    self.go_table.aorimage_cardbg.SpriteName = "ui_jgtl_zjm_card_b"
    self.go_table.aorimage_cardbg:SetNativeSize()
    self.go_table.gameObject:SetEulerAngles(0, 0, 0)
end

function TarotCardFace:GotoNext(aa, callBack)
    self:Reset()
    self.GotoIndex = 1
    self.GotoAA = aa
    self.GoIndex = 1
    self.DoNextCallBack = callBack
    self:GotoAAs()
end

function TarotCardFace:GotoAAs()
    self.Index = self.GotoAA[#self.GotoAA][4]
    if _G.AppSetting.DEBUG then
        _G.Log(self.Index, "当前卡面索引")
    end
    local num = _G.Mathf.Random(1, self.ToNextShowTime / 4 * 10)
    self.go_table.gameObject:DoMove(
        self.GotoAA[self.GoIndex][1],
        self.GotoAA[self.GoIndex][2],
        self.GotoAA[self.GoIndex][3],
        nil,
        num / 10
    ):SetEase(_G.CS.DG.Tweening.Ease.InOutQuint):OnComplete(
        function()
            self.GoIndex = self.GoIndex + 1
            if self.GoIndex > #self.GotoAA then
                --if _G.AppSetting.DEBUG then
                --LogError("结束")
                --end
                self:UpdatePos()
                if self.DoNextCallBack then
                    self.DoNextCallBack()
                    self.DoNextCallBack = nil
                end
            else
                self:GotoAAs()
            end
        end
    )
end

---销毁对象时,析构函数
function TarotCardFace:OnDestroy()
    if self.DtRotate then
        self.DtRotate:Kill()
        self.DtRotate = nil
    end
    if self.DtMove then
        self.DtMove:Kill()
        self.DtMove = nil
    end
end
return TarotCardFace
