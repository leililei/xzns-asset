---@class TarotManager : Singleton	中文描述
---@field TarotClass TarotModel 塔罗牌数据
local TarotManager = _G.BaseClass("TarotManager", _G.Singleton)

---@return TarotManager TarotManager
function TarotManager:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function TarotManager:__init()
    self.rankAwardList = {}
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.UIClosed, self)
end

function TarotManager:UIClosed(name)
    if name == _G.ConfigManager.ui_cfg.TarotPackView.Name then
        local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.TarotView.Name)
        if nil == view then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TarotView.Name)
        end
    end
end

---获取五行招募累计GM数据
function TarotManager:GetData()
    if self.TarotClass and self.TarotClass:GetTime() > 0 then
        return self.TarotClass
    end
    return nil
end

---设置五行招募累计GM数据
function TarotManager:SetData(class)
    self.TarotClass = class
end

---获取代币id
function TarotManager:GetCoinId()
    if self.TarotClass then
        return self.TarotClass:GetCoinId()
    end
    return 0
end

---获取代币数量
function TarotManager:GetCoinNum()
    if self.TarotClass then
        return self.TarotClass:GetCoinNum()
    end
    return 0
end

---添加代币
function TarotManager:AddCoin(num)
    if self.TarotClass then
