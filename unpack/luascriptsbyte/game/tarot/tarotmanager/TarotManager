function TarotManager:GetRankType()
    if self.TarotClass then
        if self.TarotClass.rank_type then
            return self.TarotClass.rank_type
        end
    end
    return 1
end

---获取排行榜数据
---@param activityId number 活动id
---@param page number 排行榜页数
---@param rankCall Function 所有排行榜回调
---@param mineRankCall Function 个人排行榜回调
function TarotManager:GetRankInfo(activityId, page, rankCall, mineRankCall)
    self:RequestRankInfo(
        activityId,
        page,
        function(allRankData)
            if not allRankData then
                allRankData = {}
            end
            local rank3 = _G.ConfigManager.discrete_cfg[108603][1][1]
            local updateIndex = 0
            local newRankData = {}
            local totalNum = #allRankData
            for i = 1, 3 do
                if not allRankData[i] or allRankData[i].value[1] < rank3 then
                    newRankData[i] = {}
                else
                    updateIndex = i
                    newRankData[i] = allRankData[i]
                end
            end

            local offset = 3 - updateIndex
            for i = updateIndex + 1, totalNum do
                ---前三后移后后面的也一起移动
                newRankData[i + offset] = allRankData[i]
            end
            if rankCall then
                rankCall(newRankData)
            end

            ---个人排行榜数据必须等总榜的数据下发后才请求，两者有依赖关系
            self:RequestMineRankInfo(
                activityId,
                function(msg)
                    if msg.value < rank3 and msg.index > 0 then
                        msg.index = msg.index + offset
                    end
                    if mineRankCall then
                        mineRankCall(msg.index, msg.value)
                    end
                end
            )
        end
    )
end

---请求排行榜数据
---@param activityId number 活动id
---@param page number 排行榜页数
---@param callback Function 回调
function TarotManager:RequestRankInfo(activityId, page, callback)
    local pbData = {page = page, id = activityId}
    require("TarotNet"):GetInstance():GetTarotRankInfo(
        pbData,
        function(msg)
            if callback then
                callback(msg.ranks)
            end
        end
    )
end

--region 排行榜
---请求个人排行榜数据
---@param activityId number 活动id
---@param callback Function 回调
function TarotManager:RequestMineRankInfo(activityId, callback)
    require("TarotNet"):GetInstance():GetSelfRank1(
        activityId,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if callback then
                callback(msg)
            end
        end
    )
end

