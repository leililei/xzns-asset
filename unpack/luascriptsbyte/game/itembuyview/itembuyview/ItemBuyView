---@class ItemBugView : UIBaseView	中文描述
---@field public go_table ItemBuyView_GoTable GoTable
---@field cfg exchange_cfg
local ItemBuyView = _G.BaseClass("ItemBugView", _G.UIBaseView)
--_G.ItemBugView = ItemBugView

local CS = _G.CS
local typeof = _G.typeof

function ItemBuyView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.aorbtn_Max:SetActiveE(0)
    _G.Events:GetInstance():AddListener(_G.eStorageRefreshType.ExchangeLimit, self.RefreshCountLimitCallback, self)
end

function ItemBuyView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.eStorageRefreshType.ExchangeLimit, self.RefreshCountLimitCallback, self)
    self.go_table.input_inputBox.onEndEdit:RemoveListener(_G.handler(self, self.OnInputEndEdit))
end

---界面的入口函数
function ItemBuyView:OnCreate(id, buyCall, buyNumber)
    self.cfg = _G.ConfigManager.exchange_cfg[id]
    if not self.cfg then
        self:Close()
    end
    self.buyEndCall = buyCall
    self.curExChangeID = id
    self.curNumber = 0
    self.singleNum = self.cfg.get_item[1][2]
    self.need_tiem_const = _G.Mathf.RoundToInt(self.cfg.need_item[1][2] / self.singleNum)
    self.need_item_id = self.cfg.need_item[1][1]
    self.buyCount = _G.StorageManager:GetInstance():GetExChangeCount(self.cfg.id) or 0

    consumeIcon = self.need_item_id and _G.StorageManager:GetInstance():GetItemIcon(self.need_item_id) or nil
    if consumeIcon then
        self.go_table.aorrawimage_costimage:LoadImage(consumeIcon)
    end

    local buyCur = 1
    if buyNumber then
        buyCur = buyNumber
    end
    self:ChangeNum(buyCur)
    self:ShowItem()
    self.go_table.input_inputBox.onEndEdit:AddListener(_G.handler(self, self.OnInputEndEdit))
end

function ItemBuyView:OnInputEndEdit(text)
    self.curNumber = tonumber(text) or self.curNumber
    self:SetPropNum(self.curNumber)
end

---购买次数限制刷新回调
function ItemBuyView:RefreshCountLimitCallback()
    if self:IsNil() then
        return
    end
    self.buyCount = _G.StorageManager:GetInstance():GetExChangeCount(self.cfg.id) or 0
    self:ChangeNum(0)
    self:ShowItem()
end

