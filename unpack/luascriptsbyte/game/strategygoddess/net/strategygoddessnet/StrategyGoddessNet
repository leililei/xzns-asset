local base = require("BaseGameNet")

---@class StrategyGoddessNet : BaseGameNet	通信协议
local StrategyGoddessNet = _G.BaseClass("StrategyGoddessNet", base)
---@return StrategyGoddessNet StrategyGoddessNet
function StrategyGoddessNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function StrategyGoddessNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_goddess_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---互动
function StrategyGoddessNet:Interact(pbData, callback)
    local item = _G.ConfigManager.net_map.game_goddess_interact
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---告白
function StrategyGoddessNet:Confess(pbData, callback)
    local item = _G.ConfigManager.net_map.game_goddess_confess
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务
function StrategyGoddessNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_goddess_task_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领取任务奖励
function StrategyGoddessNet:GetTaskAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_goddess_mission_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---解锁
function StrategyGoddessNet:Unlock(pbData, callback)
    local item = _G.ConfigManager.net_map.game_goddess_unlock
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function StrategyGoddessNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return StrategyGoddessNet
