---@class StrategyGoddessBubbleItem : Component    攻略女神弹窗
---@field go_table StrategyGoddessBubbleItem_GoTable
local StrategyGoddessBubbleItem = _G.BaseClass("StrategyGoddessBubbleItem", _G.Component)

function StrategyGoddessBubbleItem:__init(obj, langId, time, callback)
    self.go_table = _G.GetAutoGoTable(obj)
    self:Show(langId, time, callback)
end

function StrategyGoddessBubbleItem:Show(langId, time, callback)
    local go = self.go_table.gameObject
    local canvasGroup = go:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    self.go_table.aortext_BubbleText.text = _G.GetLangPackValue(langId)
    _G.DelayDo(
        time,
        function()
            canvasGroup:DOFade(0, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
                function()
                    self:Dispose()
                    if callback then
                        callback()
                    end
                end
            )
        end
    )
end

---类的析构函数
function StrategyGoddessBubbleItem:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessBubbleItem
