---@class StrategyGoddessGoldItem : Component    女神攻略代币组件
---@field go_table StrategyGoddessGoldItem_GoTable
local StrategyGoddessGoldItem = _G.BaseClass("StrategyGoddessGoldItem", _G.Component)

function StrategyGoddessGoldItem:__init(obj)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eStrategyGoddessEvent.PointChange, _G.handlerbind(self, self.OnPointChange))
end

---界面入口
function StrategyGoddessGoldItem:OnCreate()
    self:InitData()
    self.go_table.aorrawimage_GiftPointIcon:LoadImage(_G.ConfigManager.currency_type_cfg[self.model:GetCoin()[1][1]].icon)
    self.go_table.aorrawimage_InteractPointIcon:LoadImage(_G.ConfigManager.currency_type_cfg[self.model:GetCoin()[2][1]].icon)
end

function StrategyGoddessGoldItem:InitData()
    self.model = require("StrategyGoddessModel"):GetInstance()
    self:UpdatePoint()
end

function StrategyGoddessGoldItem:UpdatePoint()
    self.gift = self.model:GetPoint(1)
    self.interact = self.model:GetPoint(2)
    self.go_table.aortext_GiftPoint.text = self.gift
    self.go_table.aortext_InteractPoint.text = self.interact
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Gold)
end

function StrategyGoddessGoldItem:OnPointChange()
    self:UpdatePoint()
end

function StrategyGoddessGoldItem:OnClickBtn(go, isOn)
    if not self.model:CheckIsFinishGuide() then
        return
    end
    if go == self.go_table.aorbtn_Gift then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.model:GetCoin()[1][1])
    elseif go == self.go_table.aorbtn_Interact then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.model:GetCoin()[2][1])
    end
end

---类的析构函数
function StrategyGoddessGoldItem:OnDestroy()
    self.go_table = nil
    self:RemoveListener(_G.eStrategyGoddessEvent.PointChange, _G.handlerbind(self, self.OnPointChange))
end

return StrategyGoddessGoldItem
