---@class StrategyGoddessPopItem : Component    攻略女神弹窗
---@field go_table StrategyGoddessPopItem_GoTable
local StrategyGoddessPopItem = _G.BaseClass("StrategyGoddessPopItem", _G.Component)

local cfg = {
    [1] = {
        image = "ImagesH5/hStrategyGoddess/ui_nsgl_diban_hgdss"
    },
    [2] = {
        image = "ImagesH5/hStrategyGoddess/ui_nsgl_dibanqmdts"
    }
}

function StrategyGoddessPopItem:__init(obj, type, num, callback)
    self.go_table = _G.GetAutoGoTable(obj)
    self.callback = callback
    self:Show(type, num)
    self:Move()
end

function StrategyGoddessPopItem:Show(type, num)
    self.go_table.aorrawimage_PopImage:LoadImage(
        cfg[type].image,
        function(image)
            image:SetNativeSize()
        end
    )
    self.go_table.aortext_PopNum.text = num >= 0 and ("+" .. num) or num
end

function StrategyGoddessPopItem:Move()
    local go = self.go_table.gameObject
    local canvasGroup = go:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    local _, y = go:GetLocalPosition()
    go:SetLocalPosition(0, y)
    local time = 3
    local moveY = 360
    canvasGroup:DOFade(0, time):SetEase(_G.CS.DG.Tweening.Ease.Linear)
    go:DOLocalMoveY(y + moveY, time):OnComplete(
        function()
            self:Dispose()
            if self.callback then
                self.callback()
            end
        end
    )
end

---类的析构函数
function StrategyGoddessPopItem:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessPopItem
