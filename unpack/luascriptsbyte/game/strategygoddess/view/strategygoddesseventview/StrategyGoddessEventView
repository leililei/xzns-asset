---@class StrategyGoddessEventView : UIBaseView    女神攻略信息界面
---@field go_table StrategyGoddessEventView_GoTable
local StrategyGoddessEventView = _G.BaseClass("StrategyGoddessEventView", _G.UIBaseView)

function StrategyGoddessEventView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function StrategyGoddessEventView:OnCreate(cfg, index, sid)
    local model = require("StrategyGoddessModel"):GetInstance()
    local path = cfg.photo_confession
    if index and model:CheckRandom(cfg.id) then
        local randomIndex = _G.math.random(1, #cfg.random_photos)
        path = cfg.random_photos[randomIndex]
    end
    self.go_table.aorrawimage_Bg:LoadImage(
        path,
        function(image)
            image:SetNativeSize()
        end
    )
    local interactCfg = sid and _G.ConfigManager.goddess_strategy_cfg[sid]
    self.go_table.aortext_EventName.text = _G.GetLangPackValue(interactCfg and interactCfg.name or 91010000015)
    self.go_table.aortext_BubbleText.text = _G.GetLangPackValue(index and cfg.tips_intimate[index] or cfg.tips_confession)
    local step = model:GetGuideStep()
    if step == 4 and not self.model:CheckGuideIsBlock() then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
            self.go_table.obj_Guide4,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    end
end

---点击按钮
function StrategyGoddessEventView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---类的析构函数
function StrategyGoddessEventView:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessEventView
