---@class StrategyGoddessShowView : UIBaseView    女神攻略写真界面
---@field go_table StrategyGoddessShowView_GoTable
local StrategyGoddessShowView = _G.BaseClass("StrategyGoddessShowView", _G.UIBaseView)

function StrategyGoddessShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function StrategyGoddessShowView:OnCreate(cfg)
    self:InitData(cfg)
    self:UpdateView()
end

function StrategyGoddessShowView:InitData(cfg)
    self.model = require("StrategyGoddessModel"):GetInstance()
    self.cfg = cfg
    self.sid = cfg.id
    self.list = self.model:GetPhotoList(self.sid)
    self.curPage = self.model:CheckNewUnlockPhoto(self.sid) or 1
end

function StrategyGoddessShowView:UpdateView()
    local unlock = self.model:CheckPhotoUnlock(self.sid, self.curPage)
    local key = _G.PlayerPrefsKey.StrategyGoddess .. "PhotoCheck" .. self.sid .. "_" .. self.curPage
    if unlock and _G.PlayerPrefsManager.GetInt(key, 0) == 0 then
        _G.PlayerPrefsManager.SetInt(key, 1)
    end
    self.go_table.obj_Lock:SetActiveE(unlock and 0 or 1)
    if self.curPage > #self.list then--最后一张是告白写真
        self.go_table.aortext_Lock1.text = _G.GetLangPackValue(91010000018)
        self.go_table.aortext_Lock2.text = _G.GetLangPackValue(91010000018)
    else
        self.go_table.aortext_Lock1.text = _G.GetLangPackValue(91010000026, self.list[self.curPage][1])
        self.go_table.aortext_Lock2.text = _G.GetLangPackValue(91010000026, self.list[self.curPage][1])
    end
    self.go_table.aorrawimage_Photo:LoadImage(
        #self.list >= self.curPage and self.list[self.curPage][2] or self.cfg.photo_confession,
        function(image)
            image:SetNativeSize()
            self:CheckIsFirstShowPhoto()
        end
    )
    self.go_table.aorbtn_Left:SetActiveE(self.curPage > 1 and 1 or 0)
    self.go_table.aorbtn_Right:SetActiveE(#self.list >= self.curPage and 1 or 0)
    self:UpdateSetBtn(unlock)
end

function StrategyGoddessShowView:UpdateSetBtn(unlock)
    if not unlock then
        unlock = self.model:CheckPhotoUnlock(self.sid, self.curPage)
    end
    if unlock then
        self.go_table.aorbtn_SetBg:SetActiveE(self.curPage ~= self.model:GetBgIndex(self.sid) and 1 or 0)
        self.go_table.aorbtn_ResetBg:SetActiveE(self.curPage == self.model:GetBgIndex(self.sid) and 1 or 0)
    else
        self.go_table.aorbtn_SetBg:SetActiveE(0)
        self.go_table.aorbtn_ResetBg:SetActiveE(0)
    end
end

function StrategyGoddessShowView:CheckIsFirstShowPhoto()
    local isFirst = false
    local key = _G.PlayerPrefsKey.StrategyGoddess .. "FirstUnlock" .. self.sid .. "_" .. self.curPage
    if self.model:CheckPhotoUnlock(self.sid, self.curPage) and _G.PlayerPrefsManager.GetInt(key, 0) == 0 then
        _G.PlayerPrefsManager.SetInt(key, 1)
        isFirst = true
    end
    if isFirst then
        local root = self.go_table.obj_Root:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
        local bottomBar = self.go_table.obj_BottomBar:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
        root.alpha = 0
        bottomBar.alpha = 0
        local delayTime = 3
        _G.DelayDo(
            delayTime,
            function()
                if self.go_table then
                    root:DOFade(1, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
                    bottomBar:DOFade(1, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
                end
            end
        )
    end
end

---点击按钮
function StrategyGoddessShowView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    elseif go == self.go_table.aorbtn_Left then
        self.curPage = _G.math.max(self.curPage - 1, 1)
        self:UpdateView()
    elseif go == self.go_table.aorbtn_Right then
        self.curPage = _G.math.min(self.curPage + 1, #self.list + 1)
        self:UpdateView()
    elseif go == self.go_table.aorbtn_SetBg then
        if self.model:CheckPhotoUnlock(self.sid, self.curPage) and self.model:GetBgIndex(self.sid) ~= self.curPage then
            self.model:SetBgIndex(self.sid, self.curPage)
            self:UpdateSetBtn()
        end
    elseif go == self.go_table.aorbtn_ResetBg then
        if self.model:CheckPhotoUnlock(self.sid, self.curPage) and self.model:GetBgIndex(self.sid) == self.curPage then
            self.model:SetBgIndex(self.sid)
            self:UpdateSetBtn()
        end
    end
end

---类的析构函数
function StrategyGoddessShowView:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessShowView
