---@class StrategyGoddessLevelUpView : UIBaseView    女神攻略升级弹出界面
---@field go_table StrategyGoddessLevelUpView_GoTable
local StrategyGoddessLevelUpView = _G.BaseClass("StrategyGoddessLevelUpView", _G.UIBaseView)

function StrategyGoddessLevelUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function StrategyGoddessLevelUpView:OnCreate(type, sid, num)
    self.model = require("StrategyGoddessModel"):GetInstance()
    self.cfg = self.model:GetGoddessCfg(sid)
    self.go_table.aorrawimage_Portrait:LoadImage(
        self.cfg.icon,
        function(image)
            image:SetNativeSize()
        end
    )
    self.go_table.aorrawimage_Title:LoadImage(
            type == 1 and "ImagesH5/hStrategyGoddess/ui_hgdts_bt" or "ImagesH5/hStrategyGoddess/ui_hgdts_bt2"
    )
    self.go_table.aortext_LeftText.text = self.model:GetScore(type, sid) - num
    self.go_table.aortext_RightText.text = self.model:GetScore(type, sid)
    self.go_table.aortext_Title.text = type == 1 and _G.GetLangPackValue(91010000016) or _G.GetLangPackValue(91010000017)
end

---点击按钮
function StrategyGoddessLevelUpView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---类的析构函数
function StrategyGoddessLevelUpView:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessLevelUpView
