---@class StrategyGoddessMainView : UIBaseView    女神攻略主界面
---@field go_table StrategyGoddessMainView_GoTable
local StrategyGoddessMainView = _G.BaseClass("StrategyGoddessMainView", _G.UIBaseView)

local PosCfg = {
    [1] = {
        ["aorrawimage_Bg"] = { -120, 0, 0 },
        ["obj_PortraitRoot"] = { -280, 48, 0 },
        ["obj_Info"] = { 16, -38, 0 },
        ["obj_Level"] = { -48, 76, 0 },
        ["aorrawimage_Lock"] = { 0, 0, 0 },
        ["aorimage_Condition"] = { 0, -74, 0 },
    },
    [2] = {
        ["aorrawimage_Bg"] = { 114, 0, 0 },
        ["obj_PortraitRoot"] = { 280, 48, 0 },
        ["obj_Info"] = { -20, -38, 0 },
        ["obj_Level"] = { 72, 76, 0 },
        ["aorrawimage_Lock"] = { -24, 0, 0 },
        ["aorimage_Condition"] = { -8, -74, 0 },
    },
}

local guideCfg = { 1, 2, 5 }

function StrategyGoddessMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eStrategyGoddessEvent.ScoreChange, self.OnScoreChange)
    self:AddListener(_G.eStrategyGoddessEvent.LvUp, self.OnUpLv)
    self:AddListener(_G.eStrategyGoddessEvent.NextGuide, self.OnGuideChange)
end

---界面入口
function StrategyGoddessMainView:OnCreate(isJump, callback)
    self.callback = callback
    self:InitData()
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.StrategyGoddess .. "ShowEnter", 0) == 0 then
        self:Hide()
        if not isJump then
            local model = require("MiniGameJumpManager"):GetInstance()
            local cfg = model.cfg or model:GetCfg(2)
            if cfg then
                if cfg.showEnter.checkFirst(true) then
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.MiniGameEnterView.Name,
                        cfg.showEnter
                    )
                end
            end
        end
        return
    end
    self:InitView()
end

function StrategyGoddessMainView:InitData()
    self.model = require("StrategyGoddessModel"):GetInstance()
    self.cfg = self.model:GetGoddessCfg()
    self.isFinishGuide = self.model:CheckIsFinishGuide()
end

function StrategyGoddessMainView:InitView()
    self.itemList = {}
    self.itemForward = {}
    if self.model.taskRedpointId ~= 0 then
        self.go_table.obj_taskRedpoint:UpdateRedPointItemIDAndParam(self.model.taskRedpointId)
    end
    self.go_table.scrollloopvectical_List:InitItemData(#self.cfg, _G.handler(self, self.RefreshList))
    self.gold = self:AddComponent(self.go_table.obj_Gold, require("StrategyGoddessGoldItem").New(self.go_table.obj_Gold))
    if not self.isFinishGuide then
        self.guideStep = self.model:GetGuideStep()
        self:OnGuideChange(self.guideStep)
    end
    self.scrollRect = self.go_table.scrollloopvectical_List:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    self.scrollRect.vertical = self.isFinishGuide
    self.go_table.aorbtn_Close:SetActiveE(self.model:CheckGuideStep(4) and 1 or 0)
    self.go_table.aorbtn_Task:SetActiveE(self.isFinishGuide and 1 or 0)
end

function StrategyGoddessMainView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    self.itemList[index] = tb
    self:UpdateSingleItem(index, tb)
end


---更新亲密、好感度
function StrategyGoddessMainView:UpdateScore(type, sid)
    local index = self.model.idDic[sid]
    local tb = self.itemList[index]
    if tb then
        local lv, value = self.model:GetScore(type, sid)
        if type == 2 then
            tb.aortext_IntimacyNum.text = self.model.maxIntimacyLv == lv and _G.GetLangPackValue(91010000021) or value
        else
            tb.aortext_FavorabilityNum.text = self.model.maxFavorLv == lv and _G.GetLangPackValue(91010000021) or value
        end
    end
end

---更新亲密、好感度等级
function StrategyGoddessMainView:UpdateLv(type, sid)
    local index = self.model.idDic[sid]
    local tb = self.itemList[index]
    if tb then
        local lv, _ = self.model:GetScore(type, sid)
        if type == 2 then
            tb.aortext_IntimacyLv.text = lv
        else
            tb.aortext_FavorabilityLv.text = lv
        end
    end
end

function StrategyGoddessMainView:UpdateSingleItem(index, tb)
    local isRight = index % 2 == 0
    tb.gameObject:SetName(index)
    tb.aorrawimage_Bg:SetLocalScale(isRight and -1 or 1, 1, 1)
    for k, v in pairs(PosCfg[isRight and 2 or 1]) do
        tb[k]:SetLocalPosition(v[1], v[2], v[3])
    end
    if self.model.confessRedpointId ~= 0 then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(self.model.confessRedpointId, index)
    end
    local cfg = self.cfg[self.model.cfgDic[index]]
    tb.aortext_Name.text = _G.GetLangPackValue(cfg.name)
    local isUnlock, str = self.model:CheckGoddessUnlock(cfg.id)
    tb.obj_Level:SetActiveE(isUnlock and 1 or 0)
    tb.aorrawimage_Portrait:LoadImage(
            cfg.icon,
            function(image)
                image:SetNativeSize()
            end
    )
    tb.aorrawimage_PortraitMask:LoadImage(
            cfg.icon,
            function(image)
                image:SetNativeSize()
            end
    )
    tb.obj_Unlock:SetActiveE(isUnlock and 0 or 1)
    local canUnlock = not isUnlock and not str
    if canUnlock then
        tb.aorimage_Condition:SetActiveE(1)
        tb.aorrawimage_PortraitMask:SetActiveE(1)
        tb.aorrawimage_Lock:SetActiveE(0)
    elseif not isUnlock then
        tb.aorimage_Condition:SetActiveE(1)
        tb.aorrawimage_Portrait:SetActiveE(0)
        tb.aorrawimage_PortraitMask:SetActiveE(1)
        tb.aorrawimage_Lock:SetActiveE(0)
    else
        tb.aorimage_Condition:SetActiveE(0)
        tb.aorrawimage_Portrait:SetActiveE(1)
        tb.aorrawimage_PortraitMask:SetActiveE(0)
        tb.aorrawimage_Lock:SetActiveE(0)
    end
    tb.obj_CanUnlock:SetActiveE(canUnlock and 1 or 0)
    tb.aortext_Condition.text = str
    --tb.aortext_Condition.color = _G.ColorTools.FormatColorByString(canUnlock and "5FDB3B" or "CD4C37")
    _G.GameUtil.ReBuildRTF(tb.obj_Unlock)
    if isUnlock then
        for i = 1, 2 do
            self:UpdateScore(i, cfg.id)
            self:UpdateLv(i, cfg.id)
        end
    end
end

function StrategyGoddessMainView:OnScoreChange(type, sid)
    self:UpdateScore(type, sid)
end

function StrategyGoddessMainView:OnUpLv(type, sid)
    self:UpdateLv(type, sid)
end

function StrategyGoddessMainView:OnGuideChange(step)
    if self.model:CheckGuideIsBlock() then
        return
    end
    self.isFinishGuide = self.model:CheckIsFinishGuide()
    self.go_table.aorbtn_Close:SetActiveE(self.model:CheckGuideStep(4) and 1 or 0)
    self.go_table.aorbtn_Task:SetActiveE(self.isFinishGuide and 1 or 0)
    if self.isFinishGuide or not self.model:CheckIsGuide() then
        return
    end
    for _, v in pairs(guideCfg) do
        local obj = v == 5 and self.go_table or self.itemList[1]
        obj["obj_Guide" .. v]:SetActiveE(step == v and 1 or 0)
        if step ~= v then
            obj["obj_Guide" .. v]:RemoveAllChildren()
        else
            _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
                obj["obj_Guide" .. v],
                function(trans)
                    if not self.go_table then
                        _G.DestroyImmediate(trans)
                        return
                    end
                end
            )
        end
    end
end

function StrategyGoddessMainView:OnClickItem(go, isOn, index, tb)
    local id = self.cfg[index].id
    local isUnlock, str = self.model:CheckGoddessUnlock(id)
    local canUnlock = not isUnlock and not str
    if canUnlock and not isUnlock then--可以解锁
        self.model:Unlock(
            id,
            function()
                self:UpdateSingleItem(index, self.itemList[index])
                _G.UIUtils.LoadEffectByCfg(
                    _G.ConfigManager.ui_effect_cfg.ef_gongluejiesuo,
                    self.itemList[index].obj_PortraitRoot,
                    function(obj)
                        if not self.go_table then
                            _G.DestroyImmediate(obj)
                            return
                        end
                    end
                )
                if id == 1 and self.model:GetGuideStep() == 1 then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "GuideOperation" .. 1, 1)--引导步骤1
                    self.model:ShowNextGuide()
                end
            end
        )
        return
    end
    if isUnlock then
        if id == 1 and self.model:GetGuideStep() == 2 then
            _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "GuideOperation" .. 2, 1)--引导步骤2
            self.model:ShowNextGuide()
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.StrategyGoddessView.Name,
            tonumber(go:GetParent():GetParent():GetName())
        )
    end
end

---点击按钮
function StrategyGoddessMainView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:OnClose()
    elseif go == self.go_table.aorbtn_Task then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessTaskView.Name)
    end
end

function StrategyGoddessMainView:OnClose()
    if self.callback then
        self.callback()
    end
    if self.model:GetGuideStep() == 5 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "GuideOperation" .. 5, 1)--引导步骤5
        self.model:ShowNextGuide()
    end
    self:Close()
end

---类的析构函数
function StrategyGoddessMainView:OnDestroy()
    self.go_table = nil
    self:RemoveListener(_G.eStrategyGoddessEvent.ScoreChange, self.OnScoreChange)
    self:RemoveListener(_G.eStrategyGoddessEvent.LvUp, self.OnUpLv)
    self:RemoveListener(_G.eStrategyGoddessEvent.NextGuide, self.OnGuideChange)
end

return StrategyGoddessMainView
