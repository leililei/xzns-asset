---@class StrategyGoddessView : UIBaseView    女神攻略详情界面
---@field go_table StrategyGoddessView_GoTable
local StrategyGoddessView = _G.BaseClass("StrategyGoddessView", _G.UIBaseView)

local BubbleLifeTime = 5
local PopIntervalTime = 0.1
local PopMaxTimes = 10

function StrategyGoddessView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eStrategyGoddessEvent.PointChange, self.OnPointChange)
    self:AddListener(_G.eStrategyGoddessEvent.ScoreChange, self.OnScoreChange)
    self:AddListener(_G.eStrategyGoddessEvent.LvUp, self.OnLvUp)
    self:AddListener(_G.eStrategyGoddessEvent.NextGuide, self.OnGuideChange)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
end

---界面入口
function StrategyGoddessView:OnCreate(sid)
    self:InitData(sid)
    if self.model.confessRedpointId ~= 0 then
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.model.confessRedpointId, self.sid)
    end
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.StrategyGoddess .. "Info" .. sid, 0) == 0 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "Info" .. sid, 1)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessInfoView.Name, self.cfg)
    end
    self:OnGuideChange(self.model:GetGuideStep())
end

function StrategyGoddessView:InitData(sid)
    self.model = require("StrategyGoddessModel"):GetInstance()
    self.isFinishGuide = self.model:CheckIsFinishGuide()
    self.giftCfg = self.model:GetInteractCfg(1)
    self.interactCfg = self.model:GetInteractCfg(2)
    self.allCfg = self.model:GetGoddessCfg()
    self.interactItem = {}
    self.interactIdDic = {}
    self.giftItem = {}
    self.giftIdDic = {}
    self.times = 0
    self.gold = self:AddComponent(self.go_table.obj_Gold, require("StrategyGoddessGoldItem").New(self.go_table.obj_Gold))
    self:UpdateData(sid)
end

function StrategyGoddessView:InitSingleItem(obj, cfg)
    local tb = _G.GetAutoGoTable(obj,  _G.handlerbind(self, self.OnUp, cfg.type_section, cfg.id))
    _G.SetEventTrigger(
            tb.aorbtn_Click,
            "onLongPress",
            _G.handlerbind(self, self.OnLongPress, cfg.type_section, cfg.id, function()
                self:UpdatePointText(tb, cfg.id)
            end)
    )
    _G.SetEventTrigger(
            tb.aorbtn_Click,
            "onUp",
            _G.handlerbind(self, self.OnUp, cfg.type_section, cfg.id)
    )
    return tb
end

---初始化循环气泡
function StrategyGoddessView:InitLoopBubble()
    self:StopTimer()
    self.loopList = self.cfg.standby_text
    if #self.loopList == 0 then
        return
    end
    self.loopIndex = 1
    self:UpdateTimer()
end

function StrategyGoddessView:UpdateTimer()
    if self.loopBubbleTimer then
        self.loopIndex = self.loopIndex + 1
        self:StopTimer()
        if self.loopIndex > #self.loopList then
            return
        end
    end
    self.loopTime = self.loopList[self.loopIndex][1]
    self.loopBubbleTimer = _G.TimerManager:GetInstance():GetTimer(
        self.loopTime,
        self.UpdateLoopBubble,
        self,
        false,
        false,
        true
    )
    self.loopBubbleTimer:Start()
end

function StrategyGoddessView:UpdateData(sid)
    self.cfg = self.model:GetGoddessCfg(sid)
    self.confessItem = self.cfg.confession_id[1]
    self.sid = self.cfg.id
    self.index = self.model.idDic[sid]
    self.bubbleCount = 0
    self:UpdateView()
end

function StrategyGoddessView:UpdateView()
    self:UpdatePageBtn()
    for i = 1, 2 do
        self:UpdateScore(i, self.sid)
        self:UpdateLv(i, self.sid)
    end
    self:UpdateGoddess()
    self:UpdateInteract()
    self:UpdateGift()
    self:UpdateConfess()
    self:UpdateShowBubble()
    self:InitLoopBubble()
end

function StrategyGoddessView:UpdatePageBtn()
    local preSid = self.model:GetPreSid(self.sid)
    local nextSid = self.model:GetNextSid(self.sid)
    self.go_table.aorbtn_Left:SetActiveE(preSid ~= 0 and 1 or 0)
    local nextUnlock = false
    if nextSid ~= 0 then
        nextUnlock = self.model:CheckGoddessIsOpen(nextSid)
    end
    self.go_table.aorbtn_Right:SetActiveE(nextUnlock and 1 or 0)
end

function StrategyGoddessView:UpdateScore(type, sid)
    if sid and sid ~= self.sid then
        return
    end
    if self.go_table then
        local lv, value = self.model:GetScore(type, sid or self.sid)
        local cfg = self.model:GetProgressCfg(type, lv, true)
        if type == 2 then
            if lv == self.model.maxIntimacyLv then
                self.go_table.aortext_Intimacy.text = _G.GetLangPackValue(91010000021)
            else
                self.go_table.aortext_Intimacy.text = value .. "/" .. cfg.exp
            end
        else
            if lv == self.model.maxFavorLv then
                self.go_table.aortext_Favorability.text = _G.GetLangPackValue(91010000021)
            else
                self.go_table.aortext_Favorability.text = value .. "/" .. cfg.exp
            end
            
        end
    end
end

function StrategyGoddessView:UpdateLv(type, sid)
    if sid and sid ~= self.sid then
        return
    end
    if self.go_table then
        local lv, _ = self.model:GetScore(type, sid or self.sid)
        if type == 2 then
            self.go_table.aortext_IntimacyLv.text = lv
        else
            self.go_table.aortext_FavorabilityLv.text = lv
        end
    end
end

function StrategyGoddessView:UpdateGoddess()
    self.go_table.aortext_Name.text = _G.GetLangPackValue(self.cfg.name)
    local path = self.cfg.photo
    local bgIndex = self.model:GetBgIndex(self.sid)
    local photoList = self.model:GetPhotoList(self.sid)
    if bgIndex > 0 and bgIndex <= #photoList then
        path = photoList[bgIndex][2]
    elseif bgIndex > #photoList then
        path = self.cfg.photo_confession
    end
    self.go_table.aorrawimage_Bg:LoadImage(
        path,
        function(image)
            image:SetNativeSize()
        end
    )
    if self.spine then
        _G.DestroyImmediate(self.spine)
        self.spine = nil
    end
    if self.cfg.photo_spine and #self.cfg.photo_spine > 0 and self.model:GetBgIndex(self.sid) == 0 then
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.photo_spine,
            _G.ePoolType.Temporary,
            self.go_table.obj_Spine,
            function(trans)
                if not self.go_table or self.spine then
                    _G.DestroyImmediate(trans)
                    return
                end
                if self.cfg.offset and #self.cfg.offset > 0 then
                    trans:SetLocalPosition(self.cfg.offset[1], self.cfg.offset[2], self.cfg.offset[3])
                end
                if self.cfg.size and self.cfg.size > 0 then
                    trans:SetLocalScaleXYZ(self.cfg.size)
                end
                self.spine = trans
            end
        )
    end
    local confessItem = _G.ConfigManager.item_cfg[self.confessItem[1]]
    self.go_table.aorrawimage_ConfessIcon:LoadImage(
        confessItem.Icon,
        function(image)
            image:SetNativeSize()
        end
    )
    self.go_table.aortext_Confess.text = _G.GetLangPackValue(confessItem.Name)
end

function StrategyGoddessView:UpdateInteract()
    for k, v in pairs(self.interactCfg) do
        self:UpdateSingleInteract(_G.ConfigManager.goddess_strategy_cfg[v])
        self.interactIdDic[v] = k
    end
end

function StrategyGoddessView:UpdateGift()
    for k, v in pairs(self.giftCfg) do
        self:UpdateSingleGift(_G.ConfigManager.goddess_strategy_cfg[v])
        self.giftIdDic[v] = k
    end
end

function StrategyGoddessView:UpdateSingleInteract(cfg)
    local tb = self.interactItem[cfg.id]
    if not tb then
        local obj = _G.InstantiateObject(self.go_table.obj_InteractItem, self.go_table.obj_InteractList)
        tb = self:InitSingleItem(obj, cfg)
        self.interactItem[cfg.id] = tb
    end
    tb.gameObject:SetName(cfg.id)
    local lv = self.model:GetScore(1, self.sid)
    local unlock = lv >= cfg.favorability_level
    tb.obj_Unlock:SetActiveE(unlock and 1 or 0)
    tb.obj_Lock:SetActiveE(unlock and 0 or 1)
    if unlock then
        tb.aorrawimage_Icon:LoadImage(cfg.icon)
        tb.aortext_Name.text = _G.GetLangPackValue(cfg.name)
    else
        tb.aorrawimage_IconMask:LoadImage(cfg.icon)
        tb.aortext_Condition.text = _G.GetLangPackValue(91010000014, cfg.favorability_level)
    end
    self:UpdatePointText(tb, cfg.id)
end

function StrategyGoddessView:UpdateSingleGift(cfg)
    local tb = self.giftItem[cfg.id]
    if not tb then
        local obj = _G.InstantiateObject(self.go_table.obj_GiftItem, self.go_table.obj_GiftList)
        tb = self:InitSingleItem(obj, cfg)
        self.giftItem[cfg.id] = tb
    end
    tb.gameObject:SetName(cfg.id)
    tb.aorrawimage_Icon:LoadImage(cfg.icon)
    self:UpdatePointText(tb, cfg.id)
end

function StrategyGoddessView:UpdatePointText(tb, id)
    local cfg = _G.ConfigManager.goddess_strategy_cfg[id]
    local tempNum = self.popTimes and 0 or self.times * cfg.consume[1][2]
    tb.aortext_Progress.text = self.model:GetPoint(cfg.type_section) - tempNum .. "/" .. cfg.consume[1][2]
end

function StrategyGoddessView:UpdateConfess()
    local isConfess = self.model:CheckGoddessIsConfess(self.sid)
    if isConfess then
        self.go_table.aorbtn_Confess:SetActiveE(0)
        return
    end
    self.go_table.aorbtn_Confess:SetActiveE(1)
    local unlock = self.model:CheckGoddessCanConfess(self.sid)
    local btnImage = self.go_table.aorbtn_Confess:GetComponentE(_G.typeof(_G.CS.AorImage))
    btnImage:SetGray(not unlock)
    self.go_table.aorrawimage_ConfessIcon:SetGray(not unlock)
end

function StrategyGoddessView:UpdateShowBubble()
    local list = self.model:GetPhotoList(self.sid)
    for i = 1, #list + 1 do
        local key = _G.PlayerPrefsKey.StrategyGoddess .. "PhotoCheck" .. self.sid .. "_" .. i
        local isCheck = _G.PlayerPrefsManager.GetInt(key, 0)
        if self.model:CheckPhotoUnlock(self.sid, i) and isCheck == 0 then
            self.go_table.obj_ShowBubble:SetActiveE(1)
            break
        end
    end
end

function StrategyGoddessView:UpdateBubble(type, sid)
    self:ResetTimer()
    local index = type == 1 and self.giftIdDic[sid] or self.interactIdDic[sid]
    local cfg = type == 1 and self.cfg.tips_favor[index] or self.cfg.tips_intimate[index]
    local bubble = _G.InstantiateObject(self.go_table.obj_Bubble, self.go_table.obj_PopContent)
    bubble:SetActiveE(1)
    self.bubbleCount = self.bubbleCount + 1
    self:AddComponent(bubble, require("StrategyGoddessBubbleItem").New(
        bubble,
        cfg,
        BubbleLifeTime,
        function()
            _G.DestroyImmediate(bubble)
            self.bubbleCount = _G.math.max(self.bubbleCount - 1, 0)
        end
    ))
end

---更新循环气泡
function StrategyGoddessView:UpdateLoopBubble()
    if not self.go_table then
        self:StopTimer()
        return
    end
    if _G.table.isEmptyOrNil(self.loopList) then
        return
    end
    self.loopBubble = _G.InstantiateObject(self.go_table.obj_Bubble, self.go_table.obj_PopContent)
    self.loopBubble:SetActiveE(1)
    self:AddComponent(self.loopBubble, require("StrategyGoddessBubbleItem").New(
        self.loopBubble,
        self.loopList[self.loopIndex][2],
        BubbleLifeTime,
        function()
            if self.go_table then
                _G.DestroyImmediate(self.loopBubble)
                self:UpdateTimer()
            end
        end
    ))
end

function StrategyGoddessView:ClearLoopBubble()
    if self.loopBubble and self.go_table then
        _G.DestroyImmediate(self.loopBubble)
    end
end

function StrategyGoddessView:ResetTimer()
    if self.loopBubbleTimer then
        self.loopBubbleTimer:Reset()
        self:ClearLoopBubble()
    end
end

function StrategyGoddessView:StopTimer()
    if self.loopBubbleTimer then
        self.loopBubbleTimer:Stop()
        self.loopBubbleTimer = nil
    end
end

function StrategyGoddessView:OnPointChange()
    for k, v in pairs(self.giftItem) do
        self:UpdatePointText(v, k)
    end
    for k, v in pairs(self.interactItem) do
        self:UpdatePointText(v, k)
    end
end

function StrategyGoddessView:OnScoreChange(type, sid, num)
    self:UpdateScore(type, sid)
    local loopTimes = _G.math.min(self.popTimes, PopMaxTimes)
    local loopIndex = 1
    local loopFun
    loopFun = function()
        if not self.go_table or loopIndex > loopTimes then
            return
        end
        local pop = _G.InstantiateObject(self.go_table.obj_Pop, self.go_table.obj_PopContent)
        pop:SetActiveE(1)
        self:AddComponent(pop, require("StrategyGoddessPopItem").New(
            pop,
            type,
            num,
            function()
                _G.DestroyImmediate(pop)
            end
        ))
        loopIndex = loopIndex + 1
        _G.DelayDo(PopIntervalTime, loopFun)
    end
    loopFun()
    self.times = 0
    self.popTimes = nil
    self:UpdateShowBubble()
end

function StrategyGoddessView:OnLvUp(type, sid, num)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessLevelUpView.Name, type, sid, num)
    self:UpdateLv(type, sid, num)
    self:UpdateInteract()
    self:UpdateConfess()
end

function StrategyGoddessView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.StrategyGoddessInfoView.Name then
        if not self.isFinishGuide and self.sid == 1 then
            self.guideStep = self.model:GetGuideStep()
            if self.guideStep == 3 then
                self:OnGuideChange(self.guideStep)
            end
        end
    end
end

function StrategyGoddessView:OnGuideChange(step)
    if self.model:CheckIsFinishGuide() or not self.model:CheckIsGuide() or self.model:CheckGuideIsBlock() then
        return
    end
    self.isFinishGuide = self.model:CheckGuideStep(3)
    self.go_table.aorbtn_Close:SetActiveE(self.isFinishGuide and 1 or 0)
    self.interactItem[201].obj_Guide3:SetActiveE(step == 3 and 1 or 0)
    self.giftItem[101].obj_Guide3:SetActiveE(step == 3 and 1 or 0)
    self.go_table.obj_Guide4:SetActiveE(step == 4 and 1 or 0)
    if step == 3 then
        self.interactItem[201].obj_Guide3:RemoveAllChildren()
        self.giftItem[101].obj_Guide3:RemoveAllChildren()
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
            self.interactItem[201].obj_Guide3,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
            self.giftItem[101].obj_Guide3,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    else
        self.interactItem[201].obj_Guide3:RemoveAllChildren()
        self.giftItem[101].obj_Guide3:RemoveAllChildren()
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.Ef_yindaoshoushi,
            self.go_table.obj_Guide4,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    end
end

function StrategyGoddessView:OnLongPress(_, _, type, sid, updateCall)
    if (self.isLongPress and self.isLongPress ~= sid) or self.endPress then
        return
    end
    self.isLongPress = sid
    local canUp = self.model:CheckCanInteract(sid, self.times)
    if not canUp then
        self.times = self.times - 1
        self:OnUp(_, _, type, sid, updateCall)
        self.endPress = true
        return
    end
    if updateCall then
        updateCall()
    end
    self.times = self.times + 1
end

function StrategyGoddessView:OnUp(_, _, type, sid, updateCall)
    if self.isLongPress and self.isLongPress ~= sid or self.isUp then
        return
    end
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name)
    if view then
        return
    end
    if self.times == 0 then
        self.times = 1
    end
    self.isUp = true
    self.popTimes = self.times
    self.model:Interact(
        self.sid,
        type,
        sid,
        self.times,
        function()
            self.times = 0
            self.isLongPress = nil
            self.endPress = nil
            self.isUp = nil
            if updateCall then
                updateCall()
            end
            local hasRandom = self.model:CheckRandom(self.sid)
            if not (type == 2 and hasRandom) then
                self:UpdateBubble(type, sid)
            end
            if not self.model:CheckIsFinishGuide() and self.model:GetGuideStep() == 3 then
                _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "GuideOperation" .. 3, 1)--引导步骤3
                self.model:ShowNextGuide()
            end
        end
    )
end

---点击按钮
function StrategyGoddessView:OnClickBtn(go, isOn)
    self:ResetTimer()
    if go == self.go_table.aorbtn_Close then
        self:OnClose()
    elseif go == self.go_table.aorbtn_Left then
        if self.bubbleCount > 0 then
            return
        end
        self:UpdateData(self.model:GetPreSid(self.sid))
    elseif go == self.go_table.aorbtn_Right then
        if self.bubbleCount > 0 then
            return
        end
        self:UpdateData(self.model:GetNextSid(self.sid))
    elseif go == self.go_table.aorbtn_Show then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessShowView.Name, self.cfg)
        self.go_table.obj_ShowBubble:SetActiveE(0)
    elseif go == self.go_table.aorbtn_Info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessInfoView.Name, self.cfg)
    elseif go == self.go_table.aorbtn_Confess then
        local hasItem = self.model:CheckHasConfessItem(self.sid)
        if hasItem then
            if self.model:CheckGoddessCanConfess(self.sid) then
                self.model:Confess(
                        self.sid,
                        self.confessItem,
                        function()
                            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessEventView.Name, self.cfg)
                            self:UpdateConfess()
                            self:UpdateShowBubble()
                        end
                )
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(91010000020))
            end
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.StrategyGoddessTaskView.Name, 4)
        end
    elseif go == self.go_table.aorbtn_Intimacy then
        _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(91010000025))
    elseif go == self.go_table.aorbtn_Favorability then
        _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(91010000024))
    end
end

function StrategyGoddessView:OnClose()
    if not self.model:CheckIsFinishGuide() and self.model:GetGuideStep() == 4 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.StrategyGoddess .. "GuideOperation" .. 4, 1)--引导步骤4
        self.model:ShowNextGuide()
    end
    self:StopTimer()
    self:Close()
end

---类的析构函数
function StrategyGoddessView:OnDestroy()
    self.go_table = nil
    self:RemoveListener(_G.eStrategyGoddessEvent.PointChange, self.OnPointChange)
    self:RemoveListener(_G.eStrategyGoddessEvent.ScoreChange, self.OnScoreChange)
    self:RemoveListener(_G.eStrategyGoddessEvent.LvUp, self.OnLvUp)
    self:RemoveListener(_G.eStrategyGoddessEvent.NextGuide, self.OnGuideChange)
    self:RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
end

return StrategyGoddessView
