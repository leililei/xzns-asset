---@class StrategyGoddessTaskView : UIBaseView    女神攻略任务界面
---@field go_table StrategyGoddessTaskView_GoTable
local StrategyGoddessTaskView = _G.BaseClass("StrategyGoddessTaskView", _G.UIBaseView)

function StrategyGoddessTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eStrategyGoddessEvent.OnlineTimeIncrease, self.UpdateOnlineTimeTask)
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateTask)
end

---界面入口
function StrategyGoddessTaskView:OnCreate(jumpPage)
    self:InitData()
    self:InitView(jumpPage)
end

function StrategyGoddessTaskView:InitData()
    self.model = require("StrategyGoddessModel"):GetInstance()
    self.cfg = {}
    self.missionCfg = _G.ConfigManager.mission_cfg
    self.taskList = {}
    self.listInit = {}
    self.taskItemList = {}
    self.preFinishList = {}
    self.idDic = {}
end

function StrategyGoddessTaskView:InitView(jumpPage)
    self:InitPage(jumpPage)
end

function StrategyGoddessTaskView:InitPage(jumpPage)
    self.pageItem = {}
    for i = 1, 4 do
        self.taskItemList[i] = {}
        local obj = _G.InstantiateObject(self.go_table.toggle_Page, self.go_table.obj_ToggleContent)
        obj:SetActiveE(1)
        local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPage, i))
        self.pageItem[i] = tb
        local name = 91010000002 + i
        tb.aortext_isOff.text = _G.GetLangPackValue(name)
        tb.aortext_isOn.text = _G.GetLangPackValue(name)
        if self.model.taskRedpointId ~= 0 then
            tb.obj_redpoint:UpdateRedPointItemIDAndParam(self.model.taskRedpointId, i)
        end
    end
    if not jumpPage then
        jumpPage = 1
    end
    self:OnClickPage(nil, false, 1)
    self:OnClickPage(nil, true, jumpPage)
end

function StrategyGoddessTaskView:RefreshList(index, obj)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickTask, index))
    self.taskItemList[self.curPage][index] = tb
    self:UpdateSingleTask(index)
end

function StrategyGoddessTaskView:UpdateSingleTask(index)
    local tb = self.taskItemList[self.curPage][index]
    if not tb then
        return
    end
    local curTask = self.taskList[self.curPage][index]
    local cfg = self.missionCfg[curTask.sid]
    local isFinish, progress, text = self.model:CheckTaskProgress(cfg, self.curPage)
    local isGet = curTask.state == _G.TaskEnum.ETaskState.Completed
    tb.aortext_Name.text = _G.GetLangPackValue(cfg.name) .. progress
    tb.aorbtn_Go:SetActiveE(not isFinish and 1 or 0)
    tb.aorbtn_Get:SetActiveE((isFinish and not isGet) and 1 or 0)
    tb.aorimage_IsGet:SetActiveE(isGet and 1 or 0)
    tb.aortext_Go.text = text
    tb.obj_AwardContent:RemoveAllChildren()
    for _, v in pairs(cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            tb.obj_AwardContent,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans.go_table.obj_ItemNum:SetActiveE(1)
                trans:SetGou(isGet)
            end
        )
    end
end

function StrategyGoddessTaskView:UpdatePage(page)
    self.curPage = page
    self:UpdateData(page)
    if self.listInit[self.curPage] then
        self.go_table["scrollloopvectical_Task" .. self.curPage]:UpdateCount(#self.taskList[self.curPage])
    else
        self.listInit[self.curPage] = true
        self.go_table["scrollloopvectical_Task" .. self.curPage]:InitItemData(#self.taskList[self.curPage], _G.handler(self, self.RefreshList))
    end
end

function StrategyGoddessTaskView:UpdateData(page)
    local startIndex = 1
    local endIndex = 4
    if page then
        startIndex = page
        endIndex = page
    end
    for i = startIndex, endIndex do
        self.cfg[i] = self.model:GetTaskList(i)
        self.taskList[i] = {}
        self.idDic[i] = {}
        self.taskDic = {}
        for _, v in pairs(self.cfg[i].taskList) do
            _G.table.insert(self.taskList[i], v)
            self.taskDic[v.sid] = true
        end
        for _, v in pairs(self.cfg[i].finishList) do
            if not self.taskDic[v] then
                _G.table.insert(
                    self.taskList[i],
                    {
                        sid = v,
                        state = _G.TaskEnum.ETaskState.Completed,
                    }
                )
            end
        end
        _G.SortList(
            self.taskList[i],
            function(task)
                local isFinish = (task.state == _G.TaskEnum.ETaskState.Completed or task.state == _G.TaskEnum.ETaskState.Submited) and -999 or 0
                return isFinish, -task.sid
            end
        )
        for k, v in pairs(self.taskList[i]) do
            self.idDic[i][k] = v.sid
        end
    end
    self.preFinishList[self.curPage] = {}
    for _, v in pairs(self.taskList[self.curPage]) do
        if self.model:CheckTaskProgress(self.missionCfg[v.sid], self.curPage) and 
                (v.state ~= _G.TaskEnum.ETaskState.Completed and v.state ~= _G.TaskEnum.ETaskState.Submited) 
        then
            _G.table.insert(self.preFinishList[self.curPage], v.sid)
        end
    end
end

function StrategyGoddessTaskView:UpdateOnlineTimeTask(time)
    if self.curPage ~= 2 then--只在在线页签刷新
        return
    end
    self:UpdatePage(self.curPage)
end

function StrategyGoddessTaskView:UpdateTask()
    self:UpdatePage(self.curPage)
end

function StrategyGoddessTaskView:OnClickTask(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_Get" then
        self.model:FinishTask(
            self.preFinishList[self.curPage],
            self.curPage,
            function() 
                self:UpdatePage(self.curPage)
            end
        )
    elseif name == "@_aorbtn_Go" then
        if self.curPage == 4 then--累计充值跳转到商城
            _G.JumpManager:GetInstance():Jump(108001)
        end
    end
end

function StrategyGoddessTaskView:OnClickPage(go, isOn, page)
    if isOn == true then
        self:UpdatePage(page)
        for i = 1, 4 do
            self.pageItem[i].aorimage_isOn:SetActiveE(page == i and 1 or 0)
            self.go_table["scrollloopvectical_Task" .. i]:SetActiveE(page == i and 1 or 0)
        end
    end
end

---点击按钮
function StrategyGoddessTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:Close()
    end
end

---类的析构函数
function StrategyGoddessTaskView:OnDestroy()
    self:RemoveListener(_G.eStrategyGoddessEvent.OnlineTimeIncrease, self.UpdateOnlineTimeTask)
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateTask)
    self.go_table = nil
end

return StrategyGoddessTaskView
