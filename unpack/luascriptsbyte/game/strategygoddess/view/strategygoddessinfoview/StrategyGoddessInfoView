---@class StrategyGoddessInfoView : UIBaseView    女神攻略信息界面
---@field go_table StrategyGoddessInfoView_GoTable
local StrategyGoddessInfoView = _G.BaseClass("StrategyGoddessInfoView", _G.UIBaseView)

function StrategyGoddessInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function StrategyGoddessInfoView:OnCreate(cfg)
    self:InitData(cfg)
    self:InitView()
end

function StrategyGoddessInfoView:InitData(cfg)
    self.cfg = cfg
end

function StrategyGoddessInfoView:InitView()
    self.go_table.aorrawimage_Portrait:LoadImage(
        self.cfg.icon, 
        function(image) 
            image:SetNativeSize()
        end
    )
    for i = 1, 3 do
        self.go_table["aortext_Text" .. i].text = _G.GetLangPackValue(self.cfg.archive[i])
    end
end

---点击按钮
function StrategyGoddessInfoView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:OnClose()
    end
end

function StrategyGoddessInfoView:OnClose()
    self:Close()
end

---类的析构函数
function StrategyGoddessInfoView:OnDestroy()
    self.go_table = nil
end

return StrategyGoddessInfoView
