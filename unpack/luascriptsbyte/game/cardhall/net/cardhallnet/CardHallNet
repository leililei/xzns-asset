local base = require("BaseGameNet")

---@class CardHallNet : BaseGameNet    通信协议
local CardHallNet = _G.BaseClass("CardHallNet", base)
---@return CardHallNet CardHallNet
function CardHallNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function CardHallNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_card_hall_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---激活
function CardHallNet:Mark(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_hall_mark
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---完成任务
function CardHallNet:FinishTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_card_hall_finish
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end


---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CardHallNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CardHallNet