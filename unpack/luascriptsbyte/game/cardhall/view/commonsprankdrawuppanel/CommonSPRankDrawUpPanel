function CommonSPRankDrawUpPanel:InitNewScroll(data, isRank)
    local obj
    if data.popBol then
        obj = self.go_table.obj_Reward
        self.go_table.obj_Reward:SetActiveE(1)
        self.go_table.aorbtn_rank1:SetActiveE(1)
    else
        obj = _G.InstantiateObject(self.go_table.obj_scrollPrefab, self.go_table.obj_scrollLists)
    end
    obj:SetActiveE(1)
    ---@type _obj_main._obj_scrollPrefab_GoTable
    local scrollTb = GetAutoGoTable(obj)
    if data.type == 2 then
        --总榜
        if isRank then
            _G.InstantiateObject(self.go_table.obj_rankZone, scrollTb.obj_listItem)
            _G.InstantiateObject(self.go_table.obj_rankZoneSelf, scrollTb.obj_player)
        else
            _G.InstantiateObject(self.go_table.obj_rankZoneAward, scrollTb.obj_listItem)
        end
    else
        if #data.itemName > 0 and not data.popBol then
            if isRank then
                scrollTb.scrollloopvectical_listBase:SetRectTransformSize(682, -878.5)
                scrollTb.scrollloopvectical_listBase:SetAnchorPosition(0, 277.81)
            else
                scrollTb.scrollloopvectical_listBase:SetRectTransformSize(682, -600)
                scrollTb.scrollloopvectical_listBase:SetAnchorPosition(0, -320)
            end
            local _, y = scrollTb.scrollloopvectical_listBase:GetRectTransformSize()
            scrollTb.scrollloopvectical_listBase:UpdateScrollRectHeight(y)
        end
        local objItem = _G.InstantiateObject(self.tempTable[data.itemName], scrollTb.obj_listItem)
        objItem:SetLocalPositionToZero()
        if not data.hideSelf then
            local objSelf = _G.InstantiateObject(self.tempTable[data.selfName], scrollTb.obj_player)
            objSelf:SetLocalPositionToZero()
        end
    end
    scrollTb.obj_player:SetActiveE(data.hideSelf and 0 or 1)
    return scrollTb
end

function CommonSPRankDrawUpPanel:OnCreate(parent, activityId)
    self.showNoRole = true
    self.model = require("DrawUpMainModel"):GetInstance()
    self.net = require "DrawUpMainNet":GetInstance()
    self.ActivityID = activityId
    self.cardSid = self.model:GetItemId(self.ActivityID)
    self.limited_roller_cfg = self.model:Getlimited_roller_cfg(self.ActivityID)
    self.myScore = require "DrawUpMainModel":GetInstance():GetTotalTimes(self.ActivityID)

    self.itemPath = "UIH5/CommonRank/$_obj_CommonSPRankDrawUp"
    local GetCfgData = require "DrawUpMainModel":GetInstance():GetCfgData(self.ActivityID)
    local isBattleArea = GetCfgData.rank_type == 2
    self.rankTgLis = {
        {
            type = 1,
            title = isBattleArea and 90029300039 or 90029300038,
            tip = nil,
            func = self.OnRank,
            itemName = "obj_rank",
            selfName = "obj_rankSelf",
            roles = {},
            hideSelf = false
        }
    }
    self.awardTgLis = {
        {
            label = 90029400051,
            type = 1,
            title = 90029300040,
            tip = 90029300035,
            func = self.OnSeasonAward,
            itemName = "obj_seasonAward",
            selfName = "obj_seasonAwardSelf",
            hideSelf = true,
            popBol = true   --奖励改成弹窗形式
        }
    }
    self.myRank = 0
    base.OnCreate(self)
    self.go_table.obj_PlayerHead:SetActiveE(0)
end

