function CommonSPRankDrawUpPanel:UpdateAllRoleModel()
    local roles = self.rankTgLis[self.curRankIndex].roles
    local data
    for i = 1, 3 do
        data = roles[i]
        if data and i == 1 then
            ---@type card_cfg
            local cfg = require "CardCommentManager":GetInstance():CardData(data.sid, false)
            if cfg then
                local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
                self:LoadRoleModel(path, i, cfg.size4)
            end
            --self.shadowNode[i]:SetActiveE(1)
            --self.top3Tb[i].aorimage_bg:SetActiveE(1)
        else
            self.shadowNode[i]:SetActiveE(0)
            self.top3Tb[i].aorimage_bg:SetActiveE(0)
        end
    end
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonSPRankDrawUpPanel:OnRank(tb)
    ---@param data rank.s2c_rank_activity_lucky_draw
    self.net:GetRank(
        function(data, delayRanks)
            self.rankList = data.ranks or {}
            local count = #self.rankList
            if self.rankList[1] and self.rankList[1].rank == 1 then 
                self.have1st = true
                count = count - 1 
            end
            tb.scrollloopvectical_listBase:InitItemData(count, _G.handler(self, self.RefreshRankItem))
            local pbData = { roles = {} }
            local roles = {}
            for i = 1, 3 do
                ---@type rank.i_role_activity_lucky_draw
                local info = self.rankList[i]
                if info and info.rank <= 3 then
                    _G.table.insert(pbData.roles, info.role_info.uid)
                    _G.table.insert(
                        roles,
                        {
                            sid = 0,
                            uid = info.role_info.uid,
                            name = info.role_info.name,
                            score = _G.GetLangPackValue(90029300037, info.draw_times)
                        }
                    )
                else
                    _G.table.insert(roles, { sid = 0 })
                end
            end
            if #pbData.roles > 0 then
                CommonRankNet:GetInstance():GetRoleStyle(
                    pbData,
                    function(msg)
                        local roleSkin = {}
                        for _, v in pairs(msg.roles) do
                            roleSkin[v.uid] = v
                        end
                        local data
                        for _, v in pairs(roles) do
                            data = roleSkin[v.uid]
                            if data then
                                v.sid = data.skin
                                v.halo = data.circle
                                v.title = data.title
                            end
                        end
                        self.rankTgLis[1].roles = roles
                        self:OnInitRankEnd()
                    end
                )
            else
                self.rankTgLis[1].roles = roles
                self:OnInitRankEnd()
            end
            ---@param msg rank.s2c_get_rank_num
            self.net:GetSelfRank(
                function(msg)
                    if msg.ack ~= 1 then
                        return
                    end
                    self.myRank = msg.index
                    self:InitRankPlayer(tb.obj_player, self.myRank, self.myScore)
                end, self.ActivityID, delayRanks
            )
        end, self.ActivityID
    )
end

