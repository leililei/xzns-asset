function CommonSPRankDrawUpPanel:GetAwardByRank(rank)
    for k, v in ipairs(self.limited_roller_cfg.draw_rank) do 
        local rankCfg = _G.ConfigManager.system_rank_cfg[v]
        if rank >= rankCfg.min_rank and rank <= rankCfg.max_rank then 
            return rankCfg.rewards
        end
    end
    return {}
end

---刷新排行榜
function CommonSPRankDrawUpPanel:RefreshRankItem(csIndex, obj)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rank_GoTable
    local tb = GetAutoGoTable(obj1)
    local luaIndex = csIndex + 1
    if self.have1st then 
        luaIndex = luaIndex + 1
    end
    local data = self.rankList[luaIndex]
    local rank = data.rank
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(rank <= 3 and 0 or 1)

    if rank <= 3 then
        tb.aorimage_rank.SpriteName = rankIcon[rank]
    else
        tb.aortext_rank.text = rank
    end
    for i = 1, 3 do
        tb["aortext_rankNum" .. i]:SetActiveE(i == rank and 1 or 0)
    end
    tb.aortext_name.text = data.role_info.name
    tb.aortext_server.text = _G.ServerManager:GetInstance():GetServerNameByServerID(data.role_info.server_id) 
    tb.aortext_score.text = _G.GetLangPackValue(90029300037, data.draw_times)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data.role_info, 0.7, true, true, false)
    local award = self:GetAwardByRank(rank)
    tb.obj_content:ClearChildren()
    for i = 1, #award do 
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            award[i],
            tb.obj_content,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                item.gameObject:SetLocalScaleXYZ(0.8)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                if item.HideOrShowLevel then 
                    item:HideOrShowLevel(false)
                end 
                if item.HideOrShowSpEffect then 
                    item:HideOrShowSpEffect(false)
                end 
                if item.ShowCount then 
                    item:ShowCount(award[i][2])
                end
            end
        )
    end
end

function CommonSPRankDrawUpPanel:InitRankPlayer(obj, index, score)
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_rankSelf_GoTable
    local tb = GetAutoGoTable(obj1, _G.handlerbind(self, self.OnClickTitle, index))
    tb.aortext_noRank:SetActiveE((index <= 0 and score <= 0) and 1 or 0)
    tb.obj_rank:SetActiveE((index <= 0 and score <= 0) and 0 or 1)
    if index > 0 then
        tb.aortext_rank.text = index
    else
        tb.aortext_rank.text = "1000+"
    end
    local data = _G.PlayerModel:GetInstance():GetIRroleTable()
    tb.aortext_name.text = data.name
    tb.aortext_score.text = _G.GetLangPackValue(90029300037, score)
    _G.UIUtils.SetPlayerHeadItemNew(tb.obj_HeadItemBase, data, 0.7, true, true, false)
end

function CommonSPRankDrawUpPanel:OnClickTitle(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_go" then 
        self.parent:Close()
    end
end

---@param tb _obj_main._obj_scrollPrefab_GoTable
function CommonSPRankDrawUpPanel:OnSeasonAward(tb, index)
    self.rewardList = self.limited_roller_cfg.draw_rank
    self.count = #self.rewardList
    --tb.scrollloopvectical_listBase:SetRectTransformSize(682, -600)
    --tb.scrollloopvectical_listBase:SetAnchorPosition(0, -320)
    --local _, y = tb.scrollloopvectical_listBase:GetRectTransformSize()
    --tb.scrollloopvectical_listBase:UpdateScrollRectHeight(y)
    tb.scrollloopvectical_listBase:InitItemData(self.count, _G.handler(self, self.RefreshAwardItem))
    self.net:GetRank(
        function(data, delayRanks)
            self.rankList = data.ranks or {}
            ---@param msg rank.s2c_get_rank_num
            self.net:GetSelfRank(
                function(msg)
                    if msg.ack ~= 1 then
                        self:InitSeasonAwardPlayer(tb.obj_player, index)
                        return
                    end
                    self.myRank = msg.index
                    self:InitSeasonAwardPlayer(tb.obj_player, index)
                end, self.ActivityID, delayRanks
            )
        end, self.ActivityID
    )
end

function CommonSPRankDrawUpPanel:RefreshAwardItem(csIndex, obj)
    local luaIndex = csIndex + 1
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAward_GoTable
    local tb = GetAutoGoTable(obj1)
    local rankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[luaIndex]]
    if not rankCfg then
        return
    end
    local rankStr
    if rankCfg.min_rank == rankCfg.max_rank then
        rankStr = string.format("%d", rankCfg.max_rank)
    elseif not rankCfg.min_rank or rankCfg.min_rank <= 0 then
        rankStr = string.format("%d", rankCfg.max_rank)
    elseif not rankCfg.max_rank or rankCfg.max_rank <= 0 then
        rankStr = string.format("%d", rankCfg.min_rank)
    else
        rankStr = string.format("%d-%d", rankCfg.min_rank, rankCfg.max_rank)
    end
    tb.aortext_score.text = _G.GetLangPackValue(90023300031, rankStr)

    tb.rewards = rankCfg.rewards
    self:ShowAward(tb, tb.obj_Award, rankCfg.rewards)
end

function CommonSPRankDrawUpPanel:RefreshSingleAward(csIndex, obj, pTb)
    local luaIndex = csIndex + 1
    ---@type _obj_seasonAward._obj_awardItem_GoTable
    local tb = GetAutoGoTable(obj)
    local award = {} ---操作配置表有报错
    for _, v in pairs(pTb.rewards[luaIndex]) do
        _G.table.insert(award, v)
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_award,
        function(item)
            if _G.IsNil(self.go_table) then
                _G.DestroyObject(item.gameObject)
                return
            end
            if item.ShowNumText then
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    )
end

function CommonSPRankDrawUpPanel:ShowAward(tb, obj, award)
    if not tb.list then
        tb.list = {}
    end
    local count = #tb.list
    local count2 = #award
    for i = 1, count do
        if i <= count2 then
            tb.list[i]:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(award[i]), function()
                if tb.list[i].item.ShowEffectOrder then
                    tb.list[i].item:ShowEffectOrder(true)
                end
                if tb.list[i].type == _G.StorageType.Card then
                    tb.list[i].item.gameObject:SetLocalScaleXYZ(0.846)
                    tb.list[i].item:ShowCount(award[i][2])
                end
            end)
            tb.list[i].gameObject:SetActiveE(1)
        else
            tb.list[i].gameObject:SetActiveE(0)
        end
    end
    if count < count2 then
        for i = count + 1, count2 do
            local obj2 = _G.InstantiateObject(obj)
            obj2:SetParentE(tb.trans_Content)
            local item = require "BaseAwardNewItem".New(obj2, nil, 88, obj2:GetChildE(0))
            tb.list[i] = item
            local data = award[i]
            if data.type then
                data = data.type
            end
            item:Show(_G.StorageManager:GetInstance():GetItemDataClassByCfg(data), function()
                if item.item.ShowEffectOrder then
                    item.item:ShowEffectOrder(true)
                end
                if item.type == _G.StorageType.Card then
                    item.item.gameObject:SetLocalScaleXYZ(0.846)
                    item.item:ShowCount(data[2])
                end
            end)
            item.gameObject:SetActiveE(1)
        end
    end
end

function CommonSPRankDrawUpPanel:InitSeasonAwardPlayer(obj, index)
    if self.awardTgLis[index].hideSelf then
        return
    end
    local obj1 = obj:GetChildE(obj:GetChildCountE() - 1)
    ---@type _obj_CommonRankArenaPeak._obj_seasonAwardSelf_GoTable
    local tb = GetAutoGoTable(obj1)
    local myRankIndex = 0
    local rankCfg
    for i = 1, #self.rewardList do
        local curRankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[i]]
        if (not curRankCfg.min_rank or curRankCfg.min_rank <= 0) and self.myRank <= curRankCfg.max_rank then
            myRankIndex = i
            break
        elseif (not curRankCfg.max_rank or curRankCfg.max_rank <= 0) and (self.myRank >= curRankCfg.min_rank or (self.myRank <= 0 and self.myScore > 0)) then
            myRankIndex = i
            break
        elseif self.myRank >= curRankCfg.min_rank and self.myRank <= curRankCfg.max_rank then
            myRankIndex = i
            break
        end
    end
    if myRankIndex == 0 then
        myRankIndex = #self.rewardList
    end
    local isShowAward = true
    if self.myRank <= 0 then
        if self.myScore > 0 then
            tb.obj_rank:SetActiveE(1)
            tb.aortext_noRank:SetActiveE(0)
            tb.aortext_score.text = "1000+"
        else
            tb.obj_rank:SetActiveE(0)
            tb.aortext_noRank:SetActiveE(1)
            isShowAward = false
        end
    else
        tb.obj_rank:SetActiveE(1)
        tb.aortext_noRank:SetActiveE(0)
        tb.aortext_score.text = _G.GetLangPackValue(90023300031, self.myRank)
    end
    rankCfg = _G.ConfigManager.system_rank_cfg[self.rewardList[myRankIndex]]
    tb.rewards = rankCfg.rewards
    if isShowAward then
        self:ShowAward(tb, tb.obj_Award, rankCfg.rewards)
    end
end

return CommonSPRankDrawUpPanel
