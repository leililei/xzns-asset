---@class SPDrawUpRankView : UIBaseView	中文描述
---@field public go_table SPDrawUpRankView_GoTable GoTable
local SPDrawUpRankView = _G.BaseClass("SPDrawUpRankView", _G.UIBaseView)

function SPDrawUpRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SPDrawUpRankView:OnCreate(type, args, endTime)
    self.type = type
    self.ActivityID = args
    self.endTime = endTime
    self.viewPanel = self:AddComponent(self.go_table.obj_main, require("CommonSPRankDrawUpPanel").New(self, args))
    self:ZanDouTimer()
    if self.timeShengYus == nil then
        self.timeShengYus = _G.TimerManager:GetInstance():GetTimer(1, self.ZanDouTimer, self, false, false, true)
        self.timeShengYus:Start()
    end
end

---倒计时
function SPDrawUpRankView:ZanDouTimer()
    local timeShengYu = require "DrawUpMainModel":GetInstance():GetTime(self.ActivityID)
    if timeShengYu <= 0 and self.Tier then
        if self.Tier then
            self.Tier = false
            self.timeShengYus:Stop()
        end
        self.go_table.aortext_Timer.text = ""
        self:Close()
    else
        self.go_table.aortext_Timer.text =
            _G.GetLangPackValue(90029300004, _G.TimeUtil.TranslateSecondForStrMiaoHui(timeShengYu, 1))
    end
end

---按钮点击事件在这里派发
function SPDrawUpRankView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then 
        self:Close()
    end
end

function SPDrawUpRankView:OnDestroy()
    if self.timeShengYus then
        self.timeShengYus:Stop()
    end
end

return SPDrawUpRankView
