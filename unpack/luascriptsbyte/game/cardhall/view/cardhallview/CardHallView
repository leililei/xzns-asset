                goTable.aortext_prop.text, goTable.aortext_sumProp.text = _G.AttributeClassManager:GetInstance().GetAttrbuteDes1({k, key, value})
                goTable.aortext_sumProp.text = "+" .. goTable.aortext_sumProp.text
                index = index + 1
            end
        end
        -- for k, v in pairs(attT.attribute) do 
        --     local obj = _G.InstantiateObject(index % 2 == 0 and self.go_table.obj_att1 or self.go_table.obj_att2, self.go_table.obj_prop)
        --     local goTable = _G.GetAutoGoTable(obj)
        --     goTable.aortext_sumProp.text = attT:CalculateAttr_1(k)
        --     goTable.aortext_prop.text = _G.AttrType[k].des
        --     index = index + 1
        -- end 
        -- for k, v in pairs(attT.attributePercent) do 
        --     local obj = _G.InstantiateObject(index % 2 == 0 and self.go_table.obj_att1 or self.go_table.obj_att2, self.go_table.obj_prop)
        --     local goTable = _G.GetAutoGoTable(obj)
        --     goTable.aortext_sumProp.text = attT:CalculateAttr_1(k)
        --     goTable.aortext_prop.text = _G.AttrType[k].des
        --     index = index + 1
        -- end 
        -- for k, v in pairs(attT.attriOther) do 
        --     local obj = _G.InstantiateObject(index % 2 == 0 and self.go_table.obj_att1 or self.go_table.obj_att2, self.go_table.obj_prop)
        --     local goTable = _G.GetAutoGoTable(obj)
        --     goTable.aortext_sumProp.text = attT:CalculateAttr_1(k)
        --     goTable.aortext_prop.text = _G.AttrType[k].des
        --     index = index + 1
        -- end 
        self.go_table.aorbtn_closeAtt:SetActiveE(1)
    elseif go == self.go_table.aorbtn_closeAtt then 
        self.go_table.aorbtn_closeAtt:SetActiveE(0)
    elseif go == self.go_table.aorbtn_drawHero then 
        local drawUpAct = require "ActivitySynManager":GetInstance():GetChildAcitivity(10028, 100090)
        if drawUpAct then 
            drawUpAct.typeClass:OnEnterActivity()
        else 
            self.go_table.obj_drawPreview:SetActiveE(1)
        end
    elseif go == self.go_table.aorbtn_drawArtifact then 
        local artifactDrawUpAct = require "ActivitySynManager":GetInstance():GetChildAcitivity(10031, 100091)
        if artifactDrawUpAct then 
            artifactDrawUpAct.typeClass:OnEnterActivity()
        end
    elseif go == self.go_table.aorbtn_closeDrawPreview then 
        self.go_table.obj_drawPreview:SetActiveE(0)
    end
end

