function CardHallView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 175)
    elseif go == self.go_table.aorbtn_heroDetails then 
        local cardData = _G.StorageManager:GetInstance():GetMaxPowerCardBySid(self.cardHallCfg[self.nowIndex].id)
        local preViewBol
        if not cardData then 
            cardData = require("CardData").GetPreviewData(self.cardHallCfg[self.nowIndex].id)
            preViewBol = true
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardShowView.Name,
            { CardData = cardData },
            nil,
            preViewBol)
    elseif go == self.go_table.aorbtn_attribute then 
        local attT = CardHallModel:GetAllAttributeShow()
        self.go_table.obj_prop:ClearChildren(2)
