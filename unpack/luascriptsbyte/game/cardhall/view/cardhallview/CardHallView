---@class CardHallView : UIBaseView  下边栏菜单
---@field go_table HeroicIconView_GoTable
local CardHallView = _G.BaseClass("CardHallView", _G.UIBaseView)
local CardHallModel

function CardHallView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CardHallView:OnCreate(sid)
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.CardHallOpen, 0) == 0 then 
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.CardHallOpen, 1)
        _G.Events:GetInstance():Broadcast(_G.CardHallViewShow.Open)
    end
    CardHallModel = require "CardHallModel":GetInstance()
    self.cardHallCfg = {}
    for k, v in pairs(_G.ConfigManager.card_hall_cfg) do 
        local T = _G.DeepCopy(v)
        _G.table.insert(self.cardHallCfg, T)
    end
    _G.table.sort(self.cardHallCfg, function(a, b)
        return a.id > b.id 
    end)
    self.nowIndex = 1
    if sid then 
        for k, v in ipairs(self.cardHallCfg) do 
            if v.id == sid then 
                self.nowIndex = k 
                break
            end
        end 
    end
    self:LoadEffect()
    self:UpdateView()
end

---加载特效
function CardHallView:LoadEffect()
    self.go_table.obj_choose:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_TXkuang,
        self.go_table.obj_choose,
        function(trans)
            trans:SetLocalScaleXYZ(1.05)
        end
    )
    self.go_table.aorimage_Orderzi:ClearChildren()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_ItemCardBodyBaseViewSP_bg,
        self.go_table.aorimage_Orderzi,
        function(trans)
            trans:SetLocalScaleXYZ(1)
        end
    )
end

---刷新数据
function CardHallView:FreshData()
    self.cfgNumBol = (#self.cardHallCfg < 5)
end

function CardHallView:UpdateView()
    if self:IsNil() then
        return
    end
    self:FreshData()
    --self.go_table.obj_cardRoot:ClearChildren()
    if not self.initCard then
        self.go_table.scrollloophorizontal_cardList:InitItemData(0, _G.handler(self, self.RefreshList))
        self.go_table.scrollloophorizontal_cardList:UpdateCount(#self.cardHallCfg)
        self.initCard = true
    elseif not self.cfgNumBol then 
        self.go_table.scrollloophorizontal_cardList:UpdateCount(#self.cardHallCfg)
        self.go_table.scrollloophorizontal_cardList:UpdateAllItem()
    end
    self.go_table.scrollloophorizontal_cardList:ScrollToIndex(self.nowIndex - 1)
    self.go_table.scrollloophorizontal_cardList:SetActiveE(self.cfgNumBol and 0 or 1)
    self:OnClickChooseCardItem(nil, nil, self.nowIndex or 1, true)
    local artifactDrawUpAct = require "ActivitySynManager":GetInstance():GetChildAcitivity(10031, 100091)
    self.go_table.obj_artifactDraw:SetActiveE(artifactDrawUpAct and 1 or 0)
    if artifactDrawUpAct then 
        self.go_table.obj_redpointArtifact:UpdateRedPointItemIDAndParam(artifactDrawUpAct.typeClass:GetRedpointIDByIndex(1))
    end
    local drawUpAct = require "ActivitySynManager":GetInstance():GetChildAcitivity(10028, 100090)
    self.go_table.obj_draw:SetActiveE(drawUpAct and 1 or 0)
    if drawUpAct then 
        self.go_table.obj_redpointDraw:UpdateRedPointItemIDAndParam(drawUpAct.typeClass:GetRedpointIDByIndex(1))
    end
    self:FreshAttBtnShow()
end

function CardHallView:FreshTaskList()
    local count = #self.cardHallCfg[self.nowIndex].task_id + 1
    if not self.initTask then
        self.go_table.scrollloopvectical_taskList:InitItemData(0, _G.handler(self, self.RefreshTaskList))
        self.go_table.scrollloopvectical_taskList:UpdateCount(count)
        self.initTask = true
    else
        self.go_table.scrollloopvectical_taskList:UpdateCount(count)
        self.go_table.scrollloopvectical_taskList:UpdateAllItem()
    end
end

function CardHallView:RefreshList(index, obj)
    local data = self.cardHallCfg[index + 1]
    local cardData = CardHallModel:GetCardInfoBySid(data.id)
    cardData.star = require "IllustrationModel":GetInstance():GetCardMaxStar(data.id)

    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickChooseCardItem, index + 1))
    if tb.card then
        if tb.card ~= true then
            tb.card:ShowCardData(cardData, nil, true, true)
        end
    else
        tb.card = true
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            tb.obj_card,
            function(item)
                tb.card = item
                item:ShowCardData(cardData, nil, true, true)
                item:HideOrShowLevel(false)
            end
        )
    end
    if (index + 1) == self.nowIndex then 
        self.go_table.obj_choose:SetParentE(tb.obj_chooseRoot)
        self.go_table.obj_choose:SetLocalPositionToZero()
    end
    for i = 1, 5 do 
        tb["obj_taskLv" .. i]:SetActiveE(cardData.taskLv >= i and 1 or 0)
    end
    tb.obj_redpoint:UpdateRedPointItemIDAndParam(
        _G.ConfigManager.redpoint_cfg.CardHallTask.id,
        data.id
    )
    if self.cfgNumBol then 
        tb.gameObject:SetParentE(self.go_table.obj_cardRoot)
    end
end

function CardHallView:OnClickChooseCardItem(go, isOn, index, initBol)
    if index == self.nowIndex and not initBol then 
        return 
    end
    local data = self.cardHallCfg[index]
    local cardData = CardHallModel:GetCardInfoBySid(data.id)
    local num = CardHallModel:GetCardTaskShowIndex(cardData.sid)
    self:FreshTaskList()
    self.go_table.scrollloopvectical_taskList:ScrollToIndex(num)
    if go then 
        self.go_table.obj_choose:SetParentE(go)
        self.go_table.obj_choose:SetLocalPositionToZero()
    end
    --self.chooseTb.scrollloopvectical_card:UpdateItemSingle(index - 1)
    self:FreshCardShow(cardData)
end

function CardHallView:FreshCardShow(cardData)
    local sid = cardData.sid
    local cfg = _G.ConfigManager.card_hall_cfg[sid]
    self.go_table.aorrawimage_bg:LoadImage(
        cfg.background,
        function(raw)
            raw:SetNativeSize()
            raw:SetLocalPosition(cfg.pos3_bg_portrait[1], cfg.pos3_bg_portrait[2], cfg.pos3_bg_portrait[3])
            raw:SetLocalScaleXYZ(cfg.size3_bg)
        end
    )
    self.go_table.aortext_name.text = _G.GetLangPackValue(cardData.cfg.Name)
    require("CardInfoManager"):GetInstance():SetElementsProfessionalSP(self.go_table.aorimage_element, cardData.cfg.Elements_new)
    self.go_table.aorimage_Orderzi.SpriteName = require("CardInfoManager"):GetInstance():GetCardOrderZi(cardData.Grade)
    self.go_table.obj_bgEff:ClearChildren()
    _G.UIUtils.LoadEffectByPath(
        cfg.pos3_bg_effect[1][1],
        self.go_table.obj_bgEff,
        function(trans)
        end
    )
    self:UpdateSpine(cardData)
end

function CardHallView:FreshAttBtnShow()
    if CardHallModel.mark_cards and #CardHallModel.mark_cards > 0 then 
        self.go_table.aorbtn_attribute:SetActiveE(1)
    else 
        self.go_table.aorbtn_attribute:SetActiveE(0)
    end 
end

function CardHallView:UpdateSpine(cardData)
    local cfg = require("CardInfoManager").GetCardSkin_ShowCfg(cardData.skin, cardData.sid)
    local cardHllCfg = _G.ConfigManager.card_hall_cfg[cardData.sid]
    self.go_table.obj_cardSpine:SetActiveE(0)
    self.go_table.obj_cardSpine:SetLocalScaleXYZ(cardHllCfg.size3_portrait)
    local pos = cardHllCfg.pos3_portrait
    self.go_table.obj_cardSpine:SetLocalPosition(pos[1], pos[2], pos[3])
    --self.go_table.obj_cardLvEff:SetLocalPosition(pos[1], pos[2], pos[3])
    -- local x, _, z = self.go_table.aorrawimage_pingtai.gameObject:GetPosition()
    -- self.go_table.aorrawimage_pingtai.gameObject:SetLocalPosition(x, pos[2], z)
    self.go_table.obj_cardSpine:ClearChildren()
    
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.go_table.obj_cardSpine,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            self.go_table.obj_cardSpine:SetActiveE(1)
        end
    )
    
end

function CardHallView:RefreshTaskList(index, obj)
    local data = self.cardHallCfg[self.nowIndex]
    local cardData = CardHallModel:GetCardInfoBySid(data.id)
    index = index + 1
    local tb = _G.GetAutoGoTable(obj)
    tb["_onclick"] = _G.handlerbind(self, self.ClickTaskItemBtn, tb, index)
    
    tb.obj_taskAwardRoot:RemoveAllChildren()
    if index == 1 then 
        local attDes = _G.AttributeClassManager:GetInstance().GetAttrbuteDes(data.team_base_att)
        -- for k, v in ipairs(data.team_base_att) do
        --     attDes[k] = _G.AttributeClassManager:GetInstance().GetAttrbuteDes(v)
        -- end
        tb.aortext_taskAward1.text = _G.GetLangPackValue(90050200014) .. attDes
        tb.aortext_taskAward.text = ""
        -- for i = 1, #attDes do 
        --     tb.aortext_taskAward.text = tb.aortext_taskAward.text .. "," .. attDes[i]
        -- end
        tb.aortext_taskDes.text = _G.GetLangPackValue(90050200012)
        tb.aortext_link.text = _G.GetLangPackValue(90050200017)
        tb.obj_title:SetActiveE(0)
        tb.obj_frame:SetActiveE(0)
    else 
        local taskCfg = _G.ConfigManager.mission_extra_cfg[data.task_id[index - 1]] 
        tb.aortext_taskAward.text = _G.StorageManager:GetInstance():GetItemName(taskCfg.reward[1][1])
        tb.aortext_taskAward1.text = ""
        local itemCfg = _G.ConfigManager.item_cfg[taskCfg.reward[1][1]] 
        if itemCfg and (itemCfg.UseType == 12 or itemCfg.UseType == 13) then 
            local Data = {}
            if itemCfg.UseType == 12 then 
                Data.frame = itemCfg.UseParameter[1][1]
                self:SetPlayerHeadItemNew(tb.obj_frame, Data)
                tb.obj_title:SetActiveE(0)
                tb.obj_frame:SetActiveE(1)
            elseif itemCfg.UseType == 13 then 
                Data.title = itemCfg.UseParameter[1][1]
                self:SetPlayerHeadItemNew(tb.obj_title, Data)
                tb.obj_title:SetActiveE(1)
                tb.obj_frame:SetActiveE(0)
            end
        else 
            tb.obj_title:SetActiveE(0)
            tb.obj_frame:SetActiveE(0)
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                taskCfg.reward[1],
                tb.obj_taskAwardRoot,
                function(tran)
                    tran.gameObject:SetLocalScaleXYZ(0.8)
                end
            )
        end
        
        local star, a = require "CardInfoManager":GetInstance():GetCardColorName_1(taskCfg.count)
        if a == 0 then
            tb.aortext_taskDes.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
        else
            tb.aortext_taskDes.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
        end
        tb.aortext_link.text = _G.GetLangPackValue(90050200016)
    end
    local gotBol = CardHallModel:CheckTaskAwardGot(data.id, index - 1)
    local canFinishTaskBol = CardHallModel:CheckTaskAwardCanGet(data.id, index - 1)
    tb.obj_unlock:SetActiveE(gotBol and 1 or 0)
    tb.aorbtn_unlock:SetActiveE(canFinishTaskBol and 1 or 0)
    tb.aorbtn_link:SetActiveE((not gotBol and not canFinishTaskBol) and 1 or 0)
    local spriteName = gotBol and "shengtan1" or "shengtan2"
    tb.aorimage_unlock.SpriteName = spriteName
    tb.obj_eff:ClearChildren()
    tb.index = index
    if gotBol then 
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shengtandaiji,
            tb.obj_eff,
            function(trans)
                if tb.index ~= index then 
                    _G.DestroyObject(trans)
                end
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        )
    end
end

---@param obj UnityEngine.GameObject 头像item有gotbale   UIH5/Common/ItemView/HeadItemBase
---@param Data role.i_role 用户信息i_role
---@param scale number 头像缩放(默认为1)
---@param onClick function 头像点击回调(默认为通用)
function CardHallView:SetPlayerHeadItemNew(obj, Data, scale, onClick)
    local frame = 0
    local title = 0
    if Data then
        if Data.frame then
            frame = tonumber(Data.frame)
        end
        if Data.title then 
            title = tonumber(Data.title)
        end
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    ---@type _obj_HeadItemBase_GoTable
    local itemGoTable = _G.GetAutoGoTable(
        obj,
        function()
            if onClick then
                onClick()
            end
        end
    )
    if scale then
        itemGoTable.gameObject:SetLocalScaleXYZ(scale)
    end
    --头像框
    if frame > 0 then
        local player_frame = _G.ConfigManager.player_frame_cfg[frame]
        if player_frame and player_frame.type_title == 1 then
            itemGoTable.aorrawimage_frame:LoadImage(player_frame.frame)
            itemGoTable.aorrawimage_frame:SetActiveE(1)
            itemGoTable.obj_frameEffect:ClearChildren()
            itemGoTable.frame = nil
        elseif player_frame and player_frame.type_title == 2 then
            if itemGoTable.frame ~= player_frame.frame then
                itemGoTable.obj_frameEffect:ClearChildren()
                itemGoTable.frame = player_frame.frame
                UIUtils.LoadEffectTitleOrFrame(
                    player_frame.frame,
                    itemGoTable.obj_frameEffect,
                    function(trans)
                        if itemGoTable.frame ~= player_frame.frame then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                    end
                )
            end
            itemGoTable.aorrawimage_frame:SetActiveE(0)
        end
    else
        itemGoTable.obj_frameEffect:ClearChildren()
        itemGoTable.frame = nil
    end
    ---称号
    if title > 0 then
        local player_title = _G.ConfigManager.player_title_effect_cfg[title]
        if player_title.type_title == 1 then
            itemGoTable.aorrawimage_title:LoadImage(player_title.title)
            itemGoTable.aorrawimage_title:SetActiveE(1)
            itemGoTable.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
            itemGoTable.obj_titleEffect:ClearChildren()
            itemGoTable.title = nil
        elseif player_title.type_title == 2 then
            if itemGoTable.title ~= player_title.title then
                itemGoTable.obj_titleEffect:ClearChildren()
                itemGoTable.title = player_title.title
                UIUtils.LoadEffectTitleOrFrame(
                    player_title.title,
                    itemGoTable.obj_titleEffect,
                    function(trans)
                        if itemGoTable.title ~= player_title.title then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                        trans:SetLocalScaleXYZ(titleScale)
                    end
                )
            end
            itemGoTable.aorrawimage_title:SetActiveE(0)
        end
    else
        itemGoTable.aorrawimage_title:SetActiveE(0)
        itemGoTable.obj_titleEffect:ClearChildren()
        itemGoTable.title = nil
    end
end

function CardHallView:RecordPower()
    self.power = _G.StorageManager:GetInstance():GetPlayerPower()
end

function CardHallView:ShowPowerUp()
    local newPower = _G.StorageManager:GetInstance():GetPlayerPower()
    local offset = newPower - self.power
    if offset > 0 then
        require "CommonTipManager".OpenPowerUpView(self.power, offset)
    end
    self.power = newPower
end

function CardHallView:ShowUnlockEff(tb, call)
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_shengtandaijia_shengxing,
        tb.obj_eff,
        nil,
        function()
            if call then 
                call()
            end
        end
    )
end

function CardHallView:ClickTaskItemBtn(go, isOn, tb, index)
    local data = self.cardHallCfg[self.nowIndex]
    local cardData = CardHallModel:GetCardInfoBySid(data.id)
    if go == tb.aorbtn_unlock then
        if index == 1 then 
            self:RecordPower()
            CardHallModel:Mark({card_sid = cardData.sid}, function()
                self:FreshAttBtnShow()
                _G.StorageManager:GetInstance():DelayUpdateAllCardProp(_G.AttrFunType.CardHall)
                self:ShowPowerUp()
                self:ShowUnlockEff(tb, function()
                    self.go_table.scrollloopvectical_taskList:UpdateItemSingle(index - 1)
                    self.go_table.scrollloophorizontal_cardList:UpdateItemSingle(self.nowIndex - 1)
                end)
            end)
        else
            CardHallModel:FinishTask(cardData.sid, index - 1, function(msg)
                self:ShowUnlockEff(tb, function()
                    self.go_table.scrollloopvectical_taskList:UpdateItemSingle(index - 1)
                    self.go_table.scrollloophorizontal_cardList:UpdateItemSingle(self.nowIndex - 1)
                    if msg.award then
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                    end
                end)
            end)
        end
    elseif go == tb.aorbtn_link then
        local cardData = _G.StorageManager:GetInstance():GetMaxPowerCardBySid(self.cardHallCfg[self.nowIndex].id)
        if not cardData then 
            self:OnClickBtn(self.go_table.aorbtn_drawHero)
        else 
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CardShowView.Name,
                { CardData = cardData },
                nil,
                nil,
                "starUp")
        end
    end
end

