function SPDrawUpMainView:ShowSpine()
    local GetCfgData = require "DrawUpMainModel":GetInstance():GetCfgData(self.ActivityID)
    if GetCfgData ~= nil then
        if GetCfgData.coin ~= "test" then
            ---立绘图片更新
            self.go_table.aorrawimage_Qian:LoadImage(
                    GetCfgData.coin,
                    function(image)
                        if image ~= nil then
                            image:SetActiveE(1)
                            image:SetNativeSize()
                        end
                    end
            )
        else
            self.go_table.aorrawimage_Qian:SetActiveE(0)
        end
        if GetCfgData.coin_effects ~= "test" then
            self.go_table.aorrawimage_Qian:SetActiveE(1)

            local pos = {}
            local scale = 1
            local dev = _G.string.split(GetCfgData.coin_effects, "#")
            for _, v in pairs(dev) do
                if _G.string.contains(v, "|") then
                    scale = _G.string.split(v, "|")[2]
                    _G.table.insert(pos, _G.tonumber(_G.string.split(v, "|")[1]))
                else
                    _G.table.insert(pos, _G.tonumber(v))
                end
            end

            self.go_table.aorrawimage_Qian:SetLocalPosition(pos[1], pos[2], pos[3])
        end
        local id=require "DrawUpMainModel":GetInstance():GetItemId(self.ActivityID)
        id= id==0 and self.limited_item[1][1] or id

        if GetCfgData.role_dev ~= "test" then
            local devlist=_G.string.split(GetCfgData.role_dev, "|")
            local dev={}
            for i = 1, #devlist do
                dev=_G.string.split(devlist[i], "#")
                if _G.tonumber(dev[5])==id then
                    break
                end
            end
            self.go_table.obj_Sprie:SetLocalPosition(_G.tonumber(dev[1] or 0), _G.tonumber(dev[2] or 0),
                    _G.tonumber(dev[3] or 0))
            local scale = _G.tonumber(dev[4] or 1)
            self.go_table.obj_Sprie:SetLocalScaleXYZ(scale)
        end
        self.go_table.aorrawimage_di:SetActiveE(0)
        self.go_table.aorrawimage_Card:SetActiveE(0)
        if GetCfgData.background ~= "test" then
            local dev = _G.string.split(GetCfgData.background, "#")
            for k, v in pairs(dev) do
                if k == 1 then
                    self.go_table.aorrawimage_di:LoadImage(
                            v,
                            function(image)
                                if image ~= nil then
                                    image:SetActiveE(1)
                                    image:SetNativeSize()
                                end
                            end
                    )
                elseif k == 2 then
                    self.go_table.aorrawimage_Card:LoadImage(
                            v,
                            function(image)
                                if image ~= nil then
                                    image:SetActiveE(1)
                                    image:SetNativeSize()
                                end
                            end
                    )
                end
            end
        end

        if GetCfgData.background_effects ~= "test" then
            local dev = _G.string.split(GetCfgData.background_effects, "#")
            self.go_table.aorrawimage_di:RemoveAllChildren()
            for key, value in pairs(dev) do
                _G.UIUtils.LoadEffectByPath(value, self.go_table.aorrawimage_di,
                        function(item)
                            item:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                        end)
            end
        end


        -- 特效配置逻辑
        -- pos_dev字段里 每个特效位置用|分割
        -- 每个特效位置里的字段用$分割，分割后第一个填的是坐标（坐标用#分割）就是绝对值坐标位置，第一个是骨骼点名字就是骨骼位置（骨骼名不能是数字）
        -- 绝对值坐标位置的后面可以填一个数字代表缩放 （可填可不填）
        -- 骨骼坐标后面可以填一个坐标（坐标用#分割）（可填可不填），代表相对骨骼点偏移，坐标后面可以填一个数字代表缩放（可填可不填，如果要填也要填前面的偏移坐标）
        -- 示例 "0#0#0$2|bone3$0#0#0$2"
        if GetCfgData.pos ~= "test" and GetCfgData.pos ~= "" and id==self.limited_item[1][1] then
            self.spineEffPos = {}

            if GetCfgData.pos_dev ~= "test" then
                local scale = 1
                local dev = _G.string.split(GetCfgData.pos_dev, "|")
                for k, v in ipairs(dev) do
                    self.spineEffPos[k] = {}
                    if _G.string.contains(v, "$") then
                        local T = _G.string.split(v, "$")
                        for k1, v1 in ipairs(T) do
                            _G.table.insert(self.spineEffPos[k], v1)
                        end
                    else
                        _G.table.insert(self.spineEffPos[k], v)
                    end
                end
            end
            self.spineEff = _G.string.split(GetCfgData.pos, "|")
        end
        if GetCfgData.role_spine ~= "test" then
            local spinlist=_G.string.split(GetCfgData.role_spine, "|")
            local spin={}
            for i = 1, #spinlist do
                spin=_G.string.split(spinlist[i], "#")
                if _G.tonumber(spin[1])==id then
                    break
                end
            end
            local spinpath=#spin>1 and spin[2] or spin[1]
            self.go_table.obj_Sprie:RemoveAllChildren()
            _G.UIUtils.LoadEffectByPath(spinpath, self.go_table.obj_Sprie,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                        self:LoadSpineEffect(trans)
                        if _G.AppSetting.IsXzns then--星座给招募界面的spine增加点击效果
                            local words = _G.string.split(GetCfgData.word, "|")
                            local sid = words[1]
                            _G.PoolsManager:GetInstance():Spawn(
                                    "UIH5_xzns/Common/@_obj_SpineClick",
                                    _G.ePoolType.UIItem,
                                    self.go_table.obj_Sprie:GetParent(),
                                    function(tran)
                                        if not self.go_table then
                                            _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
                                            return
                                        end
                                        local index = trans:GetSiblingIndexE()
                                        tran:SetSiblingIndexE(index + 1)
                                        self.go_table.obj_SpineClick = tran
                                        tran:SetRectTransformSize(620, 1100)
                                        tran:SetLocalPosition(-50, 30)
                                        require("SpineClick").New(tran, trans, 0, 0, tonumber(sid))
                                    end
                            )
                        end
                    end)
        end
    end

    local data = _G.ConfigManager.card_hall_cfg[self.wish_card]
    local index = 1
    for i = 1, 4 do 
        if not require "CardHallModel":GetInstance():CheckTaskAwardGot(data.id, i) then 
            index = i 
            break
        end
    end
    local taskCfg = _G.ConfigManager.mission_extra_cfg[data.task_id[index]] 
    local star, a = require "CardInfoManager":GetInstance():GetCardColorName(taskCfg.count)
    if a == 0 then
        self.go_table.aortext_task.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
    else
        self.go_table.aortext_task.text = _G.GetLangPackValue(90029300057, _G.GetLangPackValue(star), a)
    end
    self.go_table.obj_awardRoot:RemoveAllChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        taskCfg.reward[1],
        self.go_table.obj_awardRoot,
        function(tran)
            tran.gameObject:SetLocalScaleXYZ(0.7)
        end
    )
    self:Skill()
end

