function SPDrawUpMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.Anim = self.go_table.transform:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    _G.Events:GetInstance():AddListener(_G.AnimationEvents.DrawUpMain, self.DrawUpMainAnim, self)
    self.kaiguan = _G.PlayerPrefsManager.GetInt("DrawUpMainViewkaiguan")
    --判断开关
    if self.kaiguan == nil or self.kaiguan == 0 then
        self.kaiguan = 0
        _G.PlayerPrefsManager.SetInt("DrawUpMainViewkaiguan", self.kaiguan)
    end
    require("DrawUpMainModel"):GetInstance().JianGe = false

    self.Tier = true

    _G.Events:GetInstance():AddListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():AddListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)
end

function SPDrawUpMainView:DrawUpMainAnim()
    if self.Anim then
        self.Anim:Play("lihui_loop")
    end
    _G.Events:GetInstance():RemoveListener(_G.AnimationEvents.DrawUpMain, self.DrawUpMainAnim, self)
end

