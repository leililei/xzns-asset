---点击抽卡按钮
function SPDrawUpMainView:DrawCard(type)
    if require("DrawUpMainModel"):GetInstance().JianGe then
        return
    end
    if #self.limited_item > 1 and self.wish_card == 0 then
        self:ShowGuide()
        return
    end

    local model = require("DrawUpMainModel"):GetInstance()
    --获取拥有的招募券数量
    local coinNum = require "DrawUpMainModel":GetInstance():GetPropNum(self.ActivityID)
    --获取魂玉召唤总次数
    local totalTimes = model:GetDiamondTotalTimes(self.ActivityID)
    local remainTimes = totalTimes - model:GetDiamondTimes(self.ActivityID)

    local tens = coinNum >= 10 and 10 or coinNum

    local num = type == 1 and 1 or (tens > 0 and tens or 10)
    local num1 = type == 1 and 1 or 10
    local list = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    if _G.table.count(list) + num > _G.StorageManager:GetInstance():GetStorageCapacity(_G.StorageID.Card) then
        _G.PopWindowManager:GetInstance():ShowAllTips(langugageId.CardBagIsFull)
        return
    end

    ---@type number 消耗模式: 1活动代币 2魂玉
    local consumeType
    local consumeNum = 0
    if coinNum >= num or totalTimes == 0 or remainTimes < num1 then
        --检查招募券数量
        if coinNum < num then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.coinId)
            return
        end
        consumeType = _G.DrawConsumeType.token
    else
        --检查魂玉数量
        consumeNum = model:GetDiamondConsume(self.ActivityID, num)
        if type == _G.DrawType.TenTimes then
            local limited_roller_cfg = require "DrawUpMainModel":GetInstance():Getlimited_roller_cfg(self.ActivityID)
            local discount = limited_roller_cfg.ticket_discount[1]
            if nil ~= discount then
                consumeNum = _G.Mathf.Floor(consumeNum * discount / 10000)
            end
        end
        local ownNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond)
        if ownNum < consumeNum then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)
            return
        end
        consumeType = _G.DrawConsumeType.diamond
    end

    if consumeType == _G.DrawConsumeType.diamond then
        _G.PopWindowManager:GetInstance():ShowDrawWindowByToggle(
            340605,
            _G.DrawRollerType.DrawUp,
            model:GetCfgId(self.ActivityID),
            num,
            consumeNum,
            function()
                require "IllustrationModel":GetInstance().NewChoKa = {}
                require("DrawUpMainModel"):GetInstance():DrawCard(
                    self.ActivityID,
                    consumeType,
                    num,
                    type,
                    _G.handler(self, self.Shuaxing),
                    _G.handlerbind(self, self.IsEff)
                )
            end,
            function()
            end
        )
    else
        require "IllustrationModel":GetInstance().NewChoKa = {}
        require("DrawUpMainModel"):GetInstance():DrawCard(
            self.ActivityID,
            consumeType,
            num,
            type,
            _G.handler(self, self.Shuaxing),
            _G.handlerbind(self, self.IsEff)
        )
    end
end

---特效显示隐藏
function SPDrawUpMainView:IsEff(num, call, Elements)
    self.var = self.go_table.aorimage_onceLan
    local it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_lan"].LifeTime

    if num == 1 then
        self.go_table.aorimage_onceLan:SetActiveE(1)
    elseif num == 2 then
        if Elements >= 6 then
            it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_jin"].LifeTime

            self.go_table.aorimage_onceJin:SetActiveE(1)
            self.var = self.go_table.aorimage_onceJin
        else
            it = _G.ConfigManager.ui_effect_cfg["ef_DrawUpMainView_once_zi"].LifeTime

            self.go_table.aorimage_onceZi:SetActiveE(1)
            self.var = self.go_table.aorimage_onceZi
        end
    end
    if self.eff == nil then
        self.eff = _G.TimerManager:GetInstance():GetTimer(it, self.EffClose, self, false, false, true, call)
        self.eff:Start()
    end
end

function SPDrawUpMainView:EffClose(call)
    if self.eff then
        self.eff:Stop()
        self.eff = nil
    end
    if self.var then
        self.var:SetActiveE(0)
    end
    if call then
        require("DrawUpMainModel"):GetInstance().JianGe = false

        call()
    end
end

function SPDrawUpMainView:Dispose()
    self.Anim = nil

    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.Updata, self.ResUpdate, self)
    _G.Events:GetInstance():RemoveListener(_G.eItemUpdata.ResRefresh, self.ResUpdate, self)
end

function SPDrawUpMainView:IsHuanXing(num)
    if num == 1 then
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SPDrawUpMainView.Name)
    else
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SPDrawUpMainView.Name)
    end
end

function SPDrawUpMainView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:Close()
    elseif name == "@_aorbtn_taskSP" then
        local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.CardHallView.Name)
        if ctrl then
            ctrl:UpdateView(self.wish_card)
        else 
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CardHallView.Name, self.wish_card)
        end
        self:Close()
    elseif name == "@_aorbtn_autoLeft" then
        self:kaiguanbut()
    elseif name == "@_aorbtn_CloseRank" then
        self.go_table.obj_rank:SetActiveE(0)
        self.go_table.aorbtn_Rank:SetActiveE(1)
    elseif name == "@_aorbtn_Rank" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SPDrawUpRankView.Name,
            _G.CommonRankType.DrawUp,
            self.ActivityID
        )
    elseif name == "@_aorbtn_Wenhao" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        local sid = require "DrawUpMainModel":GetInstance():GetItemId(self.ActivityID)
        require("CommonTipManager"):GetInstance():OpenTip(go, sid, nil, nil, nil, 1)
    elseif name == "@_aorbtn_DrawOnce" then
        self:DrawCard(_G.DrawType.once)
    elseif name == "@_aorbtn_DrawTenTimes" then
        self:DrawCard(_G.DrawType.TenTimes)
    elseif name == "@_aorbtn_LiBao" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_baodian" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_zhouka" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.GlobalInterface.JumpActivityByGM(10088, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_Yulan" then
        self:OnHrefClick()
    elseif name == "@_aorbtn_help1" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 223)
    elseif name == "@_aorbtn_task" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DrawUpBattlePassView.Name)
        if view then
            view:Close()
        end
        _G.GlobalInterface.JumpActivityByGM(10007, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_ZhuLi" then
        if require("DrawUpMainModel"):GetInstance().JianGe then
            return
        end

        _G.GlobalInterface.JumpActivityByGM(10030, self.activity:GetJumpType(self.ActivityID))
    elseif name == "@_aorbtn_gift" then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MallView.Name, _G.MallViewPage.HeroGiftPackSyn)
        local sub_type = self.activity:GetJumpType(self.ActivityID)
        local index = require ("HeroGiftPackSynModel"):GetInstance().activityCradIdList[sub_type]
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.HeroGiftPackView.Name, index)
    elseif name == "@_aorbtn_selectCard" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.DrawUpMainSelectView.Name,
            self.ActivityID,
            function(wish_card)
                self.wish_card = wish_card or 0
                self:InitWishCard()
                self:ShowNameAndOrder()
                self:TipData()
                self:ShowSpine()
            end,
            true
        )
        self.go_table.obj_finger:RemoveAllChildren()
    elseif name == "@_aorbtn_demo1" then
        if #self.limited_item > 1 and self.wish_card == 0 then
            self:ShowGuide()
            return
        end
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CardSkillPreview.Name,
            require "DrawUpMainModel":GetInstance():GetItemId(self.ActivityID))
        _G.PlayerPrefsManager.SetInt("HeroSkillRedPoint" .. self.ActivityID, 0)
        self.activity.typeClass:RefreshRedPoint(3)
    elseif name == "@_aorbtn_help" then
        -- 帮助提示
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 223)
    end
end

