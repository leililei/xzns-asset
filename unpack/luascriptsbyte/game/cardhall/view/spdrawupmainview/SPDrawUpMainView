--- 加载绑定在spine骨骼上的特效，需要在spine加载后调用
---@param spineTrans UnityEngine.Transform spine对象
function SPDrawUpMainView:LoadSpineEffect(spineTrans)
    if self.effectTb then
        for _, v in pairs(self.effectTb) do
            _G.DestroyObject(v)
        end
    else
        self.effectTb = {}
    end
    local check = function(obj)
        if self:IsNil() then
            _G.UIUtils.RemoveEffect(obj)
            return false
        end
        _G.table.insert(self.effectTb, obj)
        return true
    end
    local id=require "DrawUpMainModel":GetInstance():GetItemId(self.ActivityID)
    id= id==0 and self.limited_item[1][1] or id
    if id~=self.limited_item[1][1] then
        return
    end
    local spObj, bone, sg
    sg = spineTrans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
    for k, v in pairs(self.spineEff or {}) do
        local dev, scale, bonePos
        if self.spineEffPos[k] and self.spineEffPos[k][1] and not string.IsNullOrEmpty(self.spineEffPos[k][1])  then
            dev = _G.string.split(self.spineEffPos[k][1], "#")
            scale = 1
            if self.spineEffPos[k][2] then
                if tonumber(self.spineEffPos[k][2]) then
                    scale = tonumber(self.spineEffPos[k][2])
                else
                    local temp = _G.string.split(self.spineEffPos[k][2], "#")
                    bonePos = { tonumber(temp[1]), tonumber(temp[2]), tonumber(temp[3]) }
                    if self.spineEffPos[k][3] then
                        scale = tonumber(self.spineEffPos[k][3])
                    end
                end
            end
        else
            dev = { 0, 0, 0 }
            scale = 1
        end
        if tonumber(dev[1]) then
            local pos = { tonumber(dev[1]), tonumber(dev[2]), tonumber(dev[3]) }
            _G.UIUtils.LoadEffectByPath(v, self.go_table.obj_Sprie,
                function(item)
                    item:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                end,
                nil, nil, pos, scale)
        else
            bonePos = bonePos or { 0, 0, 0 }
            spObj = _G.InstantiateObject(self.go_table.obj_spineEff, spineTrans)
            bone = spObj:GetComponentE(_G.typeof(_G.CS.Spine.Unity.BoneFollowerGraphic))
            bone.skeletonGraphic = sg
            bone.boneName = self.spineEffPos[k][1]
            _G.UIUtils.LoadEffectByPath(
                v,
                spObj,
                function(obj)
                    check(obj)
                    obj:AddComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
                end,
                nil, nil, bonePos, scale)
        end
    end
end

function SPDrawUpMainView:OnGetRankInfo()
    ---@type DrawUpMainNet
    local net = require "DrawUpMainNet":GetInstance()
    net:GetRank(
        function(rankPb, delayRanks)
            ---@param selfRankPb rank.s2c_get_rank_num
            net:GetSelfRank(
                function(selfRankPb)
                    if selfRankPb.ack ~= 1 then
                        return
                    end
                    self:UpdateRank(rankPb, selfRankPb)
                end,
                self.ActivityID,
                delayRanks
            )
        end,
        self.ActivityID
    )
end

---刷新抽卡排行榜展示
---@param rankPb rank.s2c_rank_activity_lucky_draw
---@param selfRankPb rank.s2c_get_rank_num
function SPDrawUpMainView:UpdateRank(rankPb, selfRankPb)
    ---@type SPDrawUpMainView._obj_myrankItem_GoTable
    local myGoTable = _G.GetAutoGoTable(self.go_table.obj_myrankItem)
    local playerModel = _G.PlayerModel:GetInstance()
    myGoTable.aortext_rankname.text = playerModel:GetName()
    local myRank = selfRankPb.index
    if myRank >= 1 and myRank <= 3 then
        --myGoTable.aorimage_rankIcon:SetActiveE(1)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        --myGoTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", myRank))
        myGoTable.aortext_rankscore.text = myRank
    elseif selfRankPb.value == 0 then
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(1)
    else
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aortext_rankscore.text = (myRank == 0 or myRank > 1000) and "1000+" or myRank
    end
    if rankPb and rankPb.ranks then
        self.rankInfo = rankPb
    else
        self.rankInfo = { ranks = {} }
    end
    if not self.rankScroll then
        self.go_table.scrollloopvectical_rankList:InitItemData(SHOW_PLAYER_COUNT, _G.handler(self, self.UpdateRankItem))
        self.rankScroll = self.go_table.scrollloopvectical_rankList
    else
        self.rankScroll:UpdateCount(3)
    end
end

function SPDrawUpMainView:UpdateRankItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    local luaIndex = csIndex + 1
    ---@type SPDrawUpMainView._obj_rankItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local rankInfo = self.rankInfo.ranks[luaIndex]
    local posRank = luaIndex
    if posRank >= 1 and posRank <= 3 then
        goTable.aorimage_rankIcon:SetActiveE(1)
        goTable.aorimage_rankIcon:LoadSprite(rankIcon[posRank])
    else
        goTable.aorimage_rankIcon:SetActiveE(0)
    end
    goTable.aortext_rankscore.text = posRank
    if rankInfo and rankInfo.role_info and rankInfo.role_info.uid > 0 and rankInfo.rank == posRank then
        goTable.aortext_rankname.text = rankInfo.role_info.name
    else
        goTable.aortext_rankname.text = _G.GetLangPackValue(90022300109)
    end
end

