---@class MeiTuanSubscribeView : UIBaseView	中文描述
---@field public go_table MeiTuanSubscribeView_GoTable GoTable
local MeiTuanSubscribeView = _G.BaseClass("MeiTuanSubscribeView", _G.UIBaseView)

local LanguageKey = {
    ---订阅好礼
    subscribe = "90023800150",
    ---订阅文本1-点击下方“一键订阅”按钮
    subscribe_txt1 = "90023800151",
    ---订阅文本2-完成订阅后领取奖励
    subscribe_txt2 = "90023800152",
    ---按钮文本
    subscribe_btn = "90023800156",

    ---惊喜好礼，复访标题
    revisit = "90023800153",
    ---复访文本1-美团APP首页下拉进入
    revisit_txt1 = "90023800154",
    ---复访文本2-奖励领取
    revisit_txt2 = "90023800155",

    ---领取奖励
    award_btn = "90000011482",
    ---前往
    go_btn = "90022600038"
}

function MeiTuanSubscribeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function MeiTuanSubscribeView:OnCreate(isSubscribe, isRepeat)
    self.isSubscribe = isSubscribe
    self.isRepeat = isRepeat

    self:RefreshView()
end

function MeiTuanSubscribeView:RefreshView(isRepeat)
    if isRepeat then
        self.isRepeat = isRepeat
    end

    local isGetSubscribeAward = require("MeituanModel"):GetInstance():CheckSubscribeAward()
    self.go_table.aortext_title.text = _G.GetLangPackValue(
        isGetSubscribeAward and LanguageKey.revisit or LanguageKey.subscribe
    )
    self.go_table.aortext_tip1.text = _G.GetLangPackValue(
        isGetSubscribeAward and LanguageKey.revisit_txt1 or LanguageKey.subscribe_txt1
    )
    self.go_table.aortext_tip2.text = _G.GetLangPackValue(
        isGetSubscribeAward and LanguageKey.revisit_txt2 or LanguageKey.subscribe_txt2
    )

    if isGetSubscribeAward then
        self.go_table.aortext_btnName.text = _G.GetLangPackValue(
            self.isRepeat and LanguageKey.award_btn or LanguageKey.go_btn
        )
    else
        self.go_table.aortext_btnName.text = _G.GetLangPackValue(
            self.isSubscribe and LanguageKey.award_btn or LanguageKey.subscribe_btn
        )
    end

    local id = isGetSubscribeAward and 124003 or 124014
    self.go_table.obj_item:ClearChildren()
    for _, value in ipairs(_G.ConfigManager.discrete_cfg[id]) do
        local item = require "BaseAwardNewItem".New(self.go_table.obj_item, nil, 83.6)
        item:ShowWithID(value)
    end
end

---订阅回调
function MeiTuanSubscribeView:OnSunscribeCall()
    self.isSubscribe = true
    self:RefreshView()
end

---按钮点击事件在这里派发
function MeiTuanSubscribeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_go then
        local isGetSubscribeAward = require("MeituanModel"):GetInstance():CheckSubscribeAward()
        if isGetSubscribeAward then
            if self.isRepeat then
                if require("DouyinModel"):GetInstance():GetDouyinSideBarAwardBol() then
                    return
                end
                require "DouyinModel":GetInstance():GetAward({ 124003 }, _G.handlerbind(self, self.GetAwardCallBack, true))
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(1030002)
            end
        else
            if self.isSubscribe then
                if require("MeituanModel"):GetInstance():CheckSubscribeAward() then
                    return
                end
                require "DouyinModel":GetInstance():GetAward({ 124014 }, _G.handlerbind(self, self.GetAwardCallBack, false))
            else
                require("MeituanModel"):GetInstance():UpdateSecondFloorChannel(_G.handler(self, self.OnSunscribeCall))
            end
        end
    end
end

function MeiTuanSubscribeView:GetAwardCallBack(needClose)
    _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.DouyinSideBar)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.DouYinSide.id)
    if needClose then
        self:Close()
    else
        self:RefreshView()
    end
end

return MeiTuanSubscribeView
