---@class MeituanModel : GameDataModelBase	中文描述
---@field Instance MeituanModel
local MeituanModel = _G.BaseClass("MeituanModel", _G.GameDataModelBase)

---创建对象时,入口构造函数
function MeituanModel:__init()
    ---创建桌面的跳转链接和icon地址
    self.target =
    "imeituan://www.meituan.com/mgc?mgc_id=mgcmmsg5ewizuevx&inner_source=11382_desk&query=inner_source%3D11382_desk&lch=mhqN_TW-u0kBgiK_vBi78KQNw&_page_new=1"
    self.icon = "https://res.sofuture.top/static/yzzl.png"
end

---从服务器拉取数据
function MeituanModel:GetDataFormServer()
    self.super.ParseData(self)
end

---创建桌面图标
function MeituanModel:CreateShortCut()
    return {
        id = "gameid_" .. _G.AppSetting.GameAppId,
        label = _G.GetLangPackValue(90032900026),
        target = self.target,
        icon = self.icon
    }
end

---是否设置了桌面图标的参数
function MeituanModel:GetOnShowParam()
    return {
        id = "gameid_" .. _G.AppSetting.GameAppId, label = _G.GetLangPackValue(90032900026), target = self.target
    }
end

---获取是否领取订阅奖励
function MeituanModel:CheckSubscribeAward()
    local awards = _G.PlayerModel:GetInstance().desktop_award or {}
    for k, v in pairs(awards) do
        if v.key == 124014 then
            return true
        end
    end
    return false
end

---打开订阅界面
function MeituanModel:OpenSubscribeView()
    if _G.AppSetting.IsEditor then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView.Name, self.isSubscribe)
        return
    end

    if self.showEnable == nil then
        self:FetchSecondFloorIcon(function()
            if self.showEnable then
                self:QueryRepeat(function()
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView.Name,
                        self.isSubscribe, self.isRepeat)
                end)
            end
        end)
    else
        if self.showEnable then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView.Name, self.isSubscribe)
        else
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.DouyinSideBar)
        end
    end
end

---后台切回查询二次复访数据
function MeituanModel:GetRepeat()
    if not _G.AppSetting.IsMeituan then
        return
    end
    self:QueryRepeat(function()
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView.Name)
        if view then
            view:RefreshView(self.isRepeat)
        end
    end)
end

---是否应该展示二楼订阅（美团订阅就是设首）
function MeituanModel:FetchSecondFloorIcon(callBack)
    _G.SDKManager:GetInstance():FetchSecondFloorIcon(
        _G.handlerbind(self, self.FetchSecondFloorIconCallBack, callBack),
        { channelId = _G.AppSetting.GameAppId }
    )
end

---是否应该展示二楼订阅的回调
function MeituanModel:FetchSecondFloorIconCallBack(bol, data, callBack)
    if _G.AppSetting.DEBUG then
        _G.LogWarning(data, "查询是否应该展示二楼订阅的回调参数")
    end
    if not bol or not data then
        return
    end

    self.isSubscribe = data.isSubscribe or false
    self.showEnable = data.showEnable or false

    if not data.showEnable then
        ---@field showEnable boolean false-不可展示、true-可以展示
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MeiTuanSubscribeView.Name)
        if view then
            view:Close()
        end
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.DouyinSideBar)
    end
    if callBack then
        callBack()
    end
end

---进行二楼订阅
function MeituanModel:UpdateSecondFloorChannel(callBack)
    _G.SDKManager:GetInstance():UpdateSecondFloorChannel(
        _G.handlerbind(self, self.UpdateSecondFloorChannelCall, callBack),
        { channelId = _G.AppSetting.GameAppId, pageCid = "c_game_4zk2nelx", status = 1 }
    )
end

function MeituanModel:UpdateSecondFloorChannelCall(bol, data, callBack)
    if _G.AppSetting.DEBUG then
        _G.LogWarning(data, "进行二楼订阅的回调参数")
    end

    if not bol then
        return
    end

    self.isSubscribe = true
    if callBack then
        callBack()
    end
end

---查询是否复访
function MeituanModel:QueryRepeat(callBack)
    _G.SDKManager:GetInstance():QueryRepeat(_G.handlerbind(self, self.QueryRepeatCallBack, callBack))
end

function MeituanModel:QueryRepeatCallBack(bol, data, callBack)
    if _G.AppSetting.DEBUG then
        _G.LogWarning(data, "查询是否二楼复访的回调参数")
    end

    self.isRepeat = false
    if bol and data and data.isRepeat then
        self.isRepeat = data.isRepeat == 1
    end
    if callBack then
        callBack()
    end
end

---@param msg any
function MeituanModel:ParseData()
    self.super.ParseData(self)
end

function MeituanModel:GetAward(callBack)
end

---销毁对象时,析构函数
function MeituanModel:Dispose()
    self.isSubscribe = nil
    self.showEnable = nil
end

return MeituanModel
