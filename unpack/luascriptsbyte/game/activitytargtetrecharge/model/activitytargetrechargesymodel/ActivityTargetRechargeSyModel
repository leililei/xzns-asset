local ActivitySynManager = require "ActivitySynManager"
local Model = require("ActivityTargetRechargeModel")
local base = require "ActivitySynTypeBase"
---@class ActivityTargetRechargeSyModel : ActivitySynTypeBase    中文描述
local ActivityTargetRechargeSyModel = _G.BaseClass("ActivityTargetRechargeSyModel", base)

function ActivityTargetRechargeSyModel:__init()
    self.curActivityClass:AddStateChanged(self.StateChanged, self)
end

function ActivityTargetRechargeSyModel:OnHandleGMData(msg)
    self:ParseData(msg)
end

---@param msg activity_cash_standard.i_activity_cash_standard
function ActivityTargetRechargeSyModel:ParseData(msg)
    Model:GetInstance():ParseSimpleData(msg.cash_standard, self.curActivityClass)
    base.ParseData(self)
end

---进入活动主体
function ActivityTargetRechargeSyModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTargetRechargeView.Name,self.curActivityClass)
end

function ActivityTargetRechargeSyModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ActivityTargetRechargeView.Name)
    end
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function ActivityTargetRechargeSyModel:InitRedPointTree()
    self.checkRedPointFunc = {
        self.CheckRedPoint
    }
    self.redpointTree = {false}
end

function ActivityTargetRechargeSyModel:CheckRedPoint()
    return Model:GetInstance():CheckRedPoint()
end

---刷新红点
function ActivityTargetRechargeSyModel:UpdateRedpoint(index)
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(index))
end

---检测红点
---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function ActivityTargetRechargeSyModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

function ActivityTargetRechargeSyModel:JumpFunction()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.ActivityTargetRechargeView.Name)
end

---销毁对象时,析构函数
function ActivityTargetRechargeSyModel:Dispose()
    if self.curActivityClass then
        self.curActivityClass:RemoveStateChanged(_G.handler(self, self.StateChanged), self)
    end
end

return ActivityTargetRechargeSyModel
