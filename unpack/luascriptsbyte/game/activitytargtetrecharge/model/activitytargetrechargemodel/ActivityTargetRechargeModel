local ActivitySynManager = require "ActivitySynManager"
local ActivityTargetRechargeNet = require("ActivityDispatchNet")
---@class ActivityTargetRechargeModel : GameDataModelBase
local ActivityTargetRechargeModel = _G.BaseClass("ActivityTargetRechargeModel", _G.GameDataModelBase)
local ticketId = 203031201
---@return ActivityTargetRechargeModel ActivityTargetRechargeModel
function ActivityTargetRechargeModel:GetInstance()
    return self.super.GetInstance(self)
end

function ActivityTargetRechargeModel:__init()
    self.isOpen = false
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function ActivityTargetRechargeModel:OnMallCashListener(data)
    local cfg = _G.ConfigManager.store_recharge_cfg
    if not data.sid or (cfg[data.sid] and cfg[data.sid].type1 == 2) then
        -- 充值代金券
        return
    end

    if data.total_cash_bool and data.cash_rmb and data.cash_rmb > 0 then
        self:RefreshMaxPrice(data.cash_rmb)
    end
end

function ActivityTargetRechargeModel:ParseSimpleData(msg, curActivityClass)
    self.msg = msg
    self.activity = curActivityClass
    local cfg = self:GetCurStageCfg()
    if not cfg then
        self.activity:ChangeState(ActivitySynManager.State.Close)
    end
end

function ActivityTargetRechargeModel:RefreshMaxPrice(price)
    if price > self.msg.max_price then
        self.msg.max_price = price
        require("RedPointManager"):GetInstance():RefreshNode(self.activity.typeClass:GetRedpointIDByIndex(1))
    end
end

function ActivityTargetRechargeModel:GetCurStageCfg()
    for i = 1, #self.msg.cfg do
        if not table.ContainsValue(self.msg.id, self.msg.cfg[i].id) then
            return self.msg.cfg[i]
        end
    end
    return nil
end

function ActivityTargetRechargeModel:isCanGetAward()
    for i = 1, #self.msg.cfg do
        if self.msg.cfg[i].price <= self.msg.max_price and (not self.msg.id or not table.ContainsValue(self.msg.id, self.msg.cfg[i].id)) then
            return true
        end
    end
    return false
end

function ActivityTargetRechargeModel:GetAward(back)
    local cfg = self:GetCurStageCfg()
    require "ActivitySynNet":GetInstance():GetAward(self.activity.activityID, { cfg.id }, function(data)
        if data.ack == 1 then
            if not self.msg.id then
                self.msg.id = {}
            end
            table.insert(self.msg.id, cfg.id)
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                data
            )
            local cfg = self:GetCurStageCfg()
            if not cfg then
                self.activity:ChangeState(ActivitySynManager.State.Close)
            end
            if back then
                back()
            end
        end
    end)
end

function ActivityTargetRechargeModel:CheckRedPoint()
    if not self.isOpen then
        return 1
    end
    local isget = self:isCanGetAward()
    return isget and 1 or 0
end

function ActivityTargetRechargeModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

return ActivityTargetRechargeModel
