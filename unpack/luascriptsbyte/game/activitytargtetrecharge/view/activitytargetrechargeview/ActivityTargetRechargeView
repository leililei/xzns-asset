local ActivitySynManager = require "ActivitySynManager"
---@class ActivityTargetRechargeView : UIBaseView    中文描述
---@field public go_table ActivityTargetRechargeView_GoTable GoTable
local ActivityTargetRechargeView = _G.BaseClass("ActivityTargetRechargeView", _G.UIBaseView)

function ActivityTargetRechargeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function ActivityTargetRechargeView:OnCreate(activity)
    self.orderBG={
        [2]="ui_nszl_lv_frame",
        [3]="ui_nszl_lan_frame",
        [4]="ui_nszl_zi_frame",
        [5]="ui_nszl_cheng_frame",
        [6]="ui_nszl_hong_frame",
        [7]="ui_nszl_jin_frame",
        [8]="ui_nszl_cai_frame"
    }
    self.ColorType = {
        "ui-ghck-icon-hui",
        "ui-ghck-icon-hui",
        "ui-ghck-icon-lan",
        "ui-ghck-icon-zi",
        "ui-ghck-icon-cheng",
        "ui-ghck-icon-hong",
        "",
        "ui-ghck-icon-cai"
    }
    self.active = activity
    ---@type  ActivityTargetRechargeModel
    self.Model =  require("ActivityTargetRechargeModel"):GetInstance()
    self.Model.isOpen=true
    require("RedPointManager"):GetInstance():RefreshNode(self.active.typeClass:GetRedpointIDByIndex(1))
    self.Itemlist={
        [1]=self.go_table.obj_awarditem1,
        [2]=self.go_table.obj_awarditem2,
        [3]=self.go_table.obj_awarditem3,
        [4]=self.go_table.obj_awarditem4,
        [5]=self.go_table.obj_awarditem5
    }
    self.cfg=self.Model:GetCurStageCfg()
    self.endTime = self.active.cfg.time.start_time + self.active.cfg.time.run_time
    self:init()
end

function ActivityTargetRechargeView:init()
    local StorageManager=_G.StorageManager:GetInstance()
    for i=1,#self.Itemlist do
        if not self.cfg.award[i] then
            self.Itemlist[i]:SetActiveE(0)
        else
            self.Itemlist[i]:SetActiveE(1)
            local data =StorageManager:GetItemDataClassByCfg(self.cfg.award[i].type)
            local tb=_G.GetAutoGoTable(self.Itemlist[i],function() 
            require "CommonTipManager":GetInstance():OpenTip(
                self.Itemlist[i],
                data.sid,
                data.uid,
                data
                )
            end)
            local grade, type = StorageManager:GetItemGrade(data.sid)
            if type == _G.StorageType.Artifact then
                if grade<3 then
                    grade = grade + 4 
                else
                    grade = grade + 5         
                 end
        
            elseif type == _G.StorageType.Spiritual then
                if grade<4 then
                    grade = grade + 3
                else
                    grade = grade + 4
                end
            end
            local icon=data.cfg.Icon and data.cfg.Icon or data.cfg.icon
            tb.aorimage_quality.SpriteName=self.orderBG[grade]
            tb.aorrawimage_icon:LoadImage(icon)
            tb.aortext_num.text=_G.GameUtil.NumberToUnitStr(self.cfg.award[i].type[2])
            local tag = StorageManager:GetItemTag(data.sid)
            if _G.string.IsNullOrEmpty(tag) then
                tb.aorimage_tag:SetActiveE(0)
            else
                tb.aorimage_tag:SetActiveE(1)
                tb.aorimage_tag.SpriteName = tag
            end
            local cfg = _G.ConfigManager.item_cfg[data.sid]
            if tb.aorimage_element then
                if cfg then
                    local showElement = cfg.Type1 == 6 or cfg.Type1 == 13 or cfg.Type1 == _G.ItemCfgType.PetChip or
                        cfg.Type1 == _G.ItemCfgType.BuildChip or cfg.Type1 == 19 or cfg.Type1 == _G.ItemCfgType.BeastChip
                    _G.GameUtil.SetActiveByCondition(tb.aorimage_element, showElement)
                    if showElement then
                        self.setNativeSize = true
                        tb.aorimage_element.SpriteName = self.ColorType[cfg.Quality]
                    end
                else
                    _G.GameUtil.SetActiveByCondition(tb.aorimage_element, false)
                end
            end
        end
    end
    local price=self.cfg.price
    local maxprice=self.Model.msg.max_price and self.Model.msg.max_price or 0
    local maxpricestr=""
    local pricestr=_G.GameUtil.RatioControl(price)
    if price<=maxprice then
        maxpricestr=1
    else
        maxpricestr=string.format("<color=#FB7E7E>%s</color>",0)
    end
    self.go_table.aortext_target.text=_G.GetLangPackValue(90049700001,pricestr,maxpricestr,1)
     self:UpdateTimer()
    if not self.timer then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
        self.timer:Start()
    end
    if self.Model.msg.cut_in and not string.IsNullOrEmpty(self.Model.msg.cut_in) then
        local spinetab=string.split(self.Model.msg.cut_in,"|")
        self.go_table.aorrawimage_role:SetActiveE(0)
        local pos=string.split(spinetab[2],"#")
        self.go_table.obj_spine:SetLocalPosition(tonumber(pos[1]), tonumber(pos[2]), tonumber(pos[3]))
        self.go_table.obj_spine:SetLocalScaleXYZ(tonumber(spinetab[3]))
        _G.UIUtils.LoadEffectByPath(spinetab[1], self.go_table.obj_spine,
                    function(trans)
                        if self:IsNil() then
                            _G.DestroyObject(trans)
                            return
                        end
                    end)
    end
    if self.Model.msg.graphic and not string.IsNullOrEmpty(self.Model.msg.graphic) then
        self.go_table.aorrawimage_tip:LoadImage(self.Model.msg.graphic)
    end
    if self.Model:isCanGetAward() then
        self.go_table.aortext_get.text=_G.GetLangPackValue(90000010016)
    else
        self.go_table.aortext_get.text=_G.GetLangPackValue(90024200001)
    end
end

function ActivityTargetRechargeView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90000010360, _G.TimeUtil.TranslateSecondForStr(time))
end
function ActivityTargetRechargeView:OnClickBtn(go,isOn)
    if go==self.go_table.aorbtn_close then
        self:Close()
    elseif go==self.go_table.aorbtn_Close then
        self:Close()
    elseif go==self.go_table.aorbtn_getaward then
        if self.Model:isCanGetAward() then
            self.Model:GetAward(function()
                self.cfg=self.Model:GetCurStageCfg()
                if not self.cfg then
                    self:Close()
                end
            end)
        else
             _G.JumpManager:GetInstance():Jump(182001, nil)
        end 
    end
end
function ActivityTargetRechargeView:Dispose()
    self.timer:Stop()
    self.timer = nil
end

return ActivityTargetRechargeView