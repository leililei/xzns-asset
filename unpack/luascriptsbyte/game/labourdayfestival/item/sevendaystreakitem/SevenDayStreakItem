        --    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
        --end)
    end

    self.go_table.aorimage_slider:SetActiveE(isLast and 0 or 1)
end

function SevenDayStreakItem:LoadCompBack(item,index,data)
    if item == nil then
        return
    end
    if self.view.ItemLoadDict[self.itemId][index] ~= data.type[1] or self.go_table == nil then
        DestroyObject(item.gameObject)
        return
    end
    item.transform:SetLocalScaleXYZ(0.8)
    item:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
    self.view.ItemLoadDict[self.itemId][index] = nil
end

function SevenDayStreakItem:onLock(go)
    if go == self.go_table.aorbtn_getBtn then
        if self.curState ~= LabourDayUtils.RewardState.CanGet  then
            return
        end
        self.view.data:Send_GetReward(self.data.sid,function()
            --self:RefreshItem(self.data)
            self.view:RefreshUI()
        end)
    elseif go == self.go_table.aorbtn_signatureBtn then
        if self.curState ~= LabourDayUtils.RewardState.Signature  then
            return
        end
        self.view.data:Send_Signature(self.data,function()

        end)
    elseif go == self.go_table.aorbtn_goto then
        JumpManager:GetInstance():Jump(330022)
    end
end

return SevenDayStreakItem