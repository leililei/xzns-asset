    if cur_cash > need_cash then
        cur_cash = need_cash
    end
    local showDes = GetLangPackValue(90034800102,need_cash,cur_cash,need_cash)
    local BgIconPath = "ImagesH5/hLabourDayFestival/ui_qrlc_dikuang_teshu"

    local curState = self.view.data:GetRewardState(data.day)
    self.curState = curState
    self.go_table.aorimage_dayBg:SetGray(false)
    self.go_table.aorbtn_getBtn:SetGray(false)
    self.go_table.aorbtn_signatureBtn:SetActiveE(0)
    self.go_table.obj_received:SetActiveE(0)
    self.go_table.aorimage_jindu:SetActiveE(0)
    self.go_table.obj_redpoint:SetActiveE(0)
    self.go_table.aorbtn_goto:SetActiveE(0)
    if curState == LabourDayUtils.RewardState.Received then
        self.go_table.aorbtn_getBtn:SetActiveE(0)
        self.go_table.obj_received:SetActiveE(1)
        self.go_table.aorimage_jindu:SetActiveE(1)
        if cur_cash < need_cash then
            showDes = GetLangPackValue(90034800104)
        end
    elseif curState == LabourDayUtils.RewardState.CanGet then
        self.go_table.aorbtn_getBtn:SetActiveE(1)
        self.go_table.aorimage_jindu:SetActiveE(1)
        self.go_table.obj_redpoint:SetActiveE(1)
        self.go_table.aortext_getTxt:SetActiveE(0)
        self.go_table.aortext_getTxt2:SetActiveE(1)
    elseif curState == LabourDayUtils.RewardState.Signature then
        self.go_table.aorbtn_getBtn:SetActiveE(0)
        self.go_table.aorbtn_signatureBtn:SetActiveE(1)
        self.go_table.aorimage_jindu:SetActiveE(1)
        self.go_table.aortext_signature.text = GetLangPackValue(90000010819,signature_cask)
        if dayNum < data.need_cash  then
            showDes = GetLangPackValue(90034800104)
        end
    elseif curState == LabourDayUtils.RewardState.Gray then
        self.go_table.aorbtn_getBtn:SetActiveE(1)
        self.go_table.aorbtn_getBtn:SetGray(true)
        self.go_table.aorimage_dayBg:SetGray(true)
        self.go_table.aortext_getTxt:SetActiveE(1)
        self.go_table.aortext_getTxt2:SetActiveE(0)
        showDes = showDes:AddColor("535353")
        BgIconPath = "ImagesH5/hLabourDayFestival/ui_qrlc_dikuang_hui"
    elseif curState == LabourDayUtils.RewardState.NotGet then
        self.go_table.aorbtn_getBtn:SetActiveE(0)
        --self.go_table.aorbtn_getBtn:SetGray(true)
        self.go_table.aorimage_jindu:SetActiveE(1)
        self.go_table.aorbtn_goto:SetActiveE(1)
    end
    self.go_table.aortext_itemname.text = showDes
    self.go_table.aorrawimage_bg:LoadImage(BgIconPath)

    self.view.ItemLoadDict[self.itemId] = {}
    self.go_table.obj_itemRoot:RemoveAllChildren()
    for i = 1, #data.reward do
        if self.view.ItemLoadDict[self.itemId][i] == nil then
            self.view.ItemLoadDict[self.itemId][i] = data.reward[i].type[1]
        end
        _G.StorageManager:GetInstance():GetItemBaseViewNew(data.reward[i].type,self.go_table.obj_itemRoot,handlerbind(self,self.LoadCompBack,i,data.reward[i]))
        --LabourDayUtils.LoadItemBase(self,i,data.reward[i],self.go_table.obj_itemRoot,function(item)
