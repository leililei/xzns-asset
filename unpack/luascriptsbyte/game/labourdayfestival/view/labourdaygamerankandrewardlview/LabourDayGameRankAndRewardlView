---@class LabourDayGameRankAndRewardlView : UIBaseView
---@field go_table LabourDayGameRankAndRewardlView_GoTable
---@field model LabourDayGameModel
local LabourDayGameRankAndRewardlView = _G.BaseClass("LabourDayGameRankAndRewardlView", _G.UIBaseView)
local RankUtils = require("RankUtils")
function LabourDayGameRankAndRewardlView:Awake()
    
end
function LabourDayGameRankAndRewardlView:OnCreate(activity,type)
    self.activity=activity
    self.model=activity.typeClass.model
    self.curShowEffTitle={}
    _G.DelayFrameDo(function()
        self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
        self:UnDataView(type)
    end) 
end
function LabourDayGameRankAndRewardlView:OnDestroy()
    if not table.isEmptyOrNil(self.loopItemLuaBuffer) then
        for k,v in pairs(self.loopItemLuaBuffer) do
            v:Dispose()
        end
    end
end
function LabourDayGameRankAndRewardlView:UnDataView(type)
    self.go_table.obj_rankPanel:SetActiveE(type==1 and 1 or 0)
    self.go_table.obj_rewardPanel:SetActiveE(type==2 and 1 or 0)
    if type==1 then
        self:ShowRankPanel()
    else
        self:ShowPreward()
    end
end
function LabourDayGameRankAndRewardlView:ShowRankPanel()
    if not self.initRnankPanel then
        self.RankPanel=_G.GetAutoGoTable(self.go_table.obj_rankPanel)
        self.RankShowNode={}
        for i = 1, 3 do
            ---@type RankTopRoleItem[]
            self.RankShowNode[i] = _G.GetAutoGoTable(self.RankPanel["obj_info"..i],_G.handlerbind(self,self.OnClickTop3,i))
        end
        self.RankPanel.scrollloopvectical_rankList:InitItemData(0, _G.handler(self, self.RefreshItem))
        self.initRnankPanel=true
    end
    self.model:UpdateRank(function()
        self.CurRankData = self.model.RankData or {}
        if not table.isEmptyOrNil(self.CurRankData) then
            local count = #self.CurRankData
            if count < 10 then
                count = 10
            end
            self.RankPanel.scrollloopvectical_rankList:UpdateCount(count)
            self.RankPanel.scrollloopvectical_rankList:UpdateAllItem()
        else
            self.RankPanel.scrollloopvectical_rankList:UpdateCount(10)
            self.RankPanel.scrollloopvectical_rankList:UpdateAllItem()
        end
        self:RefreshItem(nil,self.RankPanel.obj_selfRank)
        self:LoadTopInfos()
    end)
    
end
function LabourDayGameRankAndRewardlView:ShowPreward()
    if not self.initRewardPanel then
        self.RewardPanel=_G.GetAutoGoTable(self.go_table.obj_rewardPanel)
        self.RewardPanel.looplist2_rankList:InitListView(0, _G.handler(self, self.OnRefreshContent))
        self.loopItemBuffer={}
        self.loopItemLuaBuffer={}
        self.ItemLua= require("LabourDayRankAwardItem")
        self.initRewardPanel=true
    end
    self.Rewardids=self.model.rankAward
    self.RewardPanel.looplist2_rankList:SetListItemCount(#self.Rewardids)
end

function LabourDayGameRankAndRewardlView:OnRefreshContent(listView2, index)
    local newIndex = index + 1
    local cfg = _G.ConfigManager.system_rank_cfg[self.Rewardids[newIndex]]
    local reward_appearance = cfg.rewards
    local itemName = "$_obj_RewardItem2"
    local iswaiguan=false
    local type, storageId
    for i = 1, #reward_appearance do
        local data=_G.StorageManager:GetInstance():GetItemDataClassByCfg(reward_appearance[i])
        type, storageId = _G.StorageManager:GetInstance():CheckSidType(reward_appearance[i][1])
        if storageId == _G.StorageID.Prop and data.cfg.Type1==7 then
            iswaiguan=true
            break
        end
    end
    if iswaiguan then
        --是有称号的奖励
        itemName = "$_obj_RewardItem"
    end

    local obj = listView2:NewListViewItem(itemName)
    local id = obj:GetInstanceIDE()
    local item = self.loopItemBuffer[id]
    ---@type ActiveDisRewardItem
    local ItemLua = self.loopItemLuaBuffer[id]
    if item == nil then
        item = obj
        self.loopItemBuffer[id] = item
        ItemLua = self.ItemLua.New(obj, _G.handler(self, self.GetCall))
        ---@type ActiveDisRewardItem[]
        self.loopItemLuaBuffer[id] = ItemLua
    end
    ItemLua:RefreshItem(cfg, newIndex)
    return item
end

---加载顶部展示玩家数据
function LabourDayGameRankAndRewardlView:LoadTopInfos()
    ---@type role.i_role_info[]
    self.RoleInfos = {}
    local SystemSettingNet = require("SystemSettingNet"):GetInstance()
    local count = #self.CurRankData
    if count > 3 then
        count = 3
    end
    for i = 1, 3 do
        if i<=count then
            SystemSettingNet:GetPlayerInfo(
                    { uid = self.CurRankData[i].role_info.uid },
                    handlerbind(self, self.LoadCompCall, i))
        end
        self:RefreshTopPlay(i)
    end
end

function LabourDayGameRankAndRewardlView:LoadCompCall(msg, index)
    if self:IsNil() then
        return
    end
    if not msg.info then
        return
    end
    self.RoleInfos[index] = msg.info
    if  msg.info  then
        local cfg = require "CardCommentManager":GetInstance():CardData(msg.info.city_style_id, false)
        local path = _G.UIUtils.GetBattleSpine(cfg, _G.UseBattleSpine.RankView)
        self:LoadRoleModel(path, index, _G.UIUtils.IsUseBattleSpine(_G.UseBattleSpine.RankView) and cfg.size2 or cfg.size4,msg.info)
    end
end

function LabourDayGameRankAndRewardlView:RefreshTopPlay(posIndex)
    local tb = self.RankShowNode[posIndex]
    local data= self.CurRankData[posIndex]
    local namestr,desc
    if data then
        tb.aorrawimage_norole:SetActiveE(0)
        namestr=data.role_info.name
        desc=_G.GetLangPackValue(90034800118,data.value[1])
    else
        tb.aorrawimage_norole:SetActiveE(1)
        if tb.trans_role:GetChildCountE()>0 then
            _G.PoolsManager:GetInstance():Despawn(tb.trans_role:GetChildE(0), _G.ePoolType.Temporary)
        end
        namestr =_G.GetLangPackValue(90022300109)
        desc=_G.GetLangPackValue(90022300109)
    end
    tb.aortext_name.text=namestr
    tb.aortext_desc.text=desc
    self:UpdateTop3Title(tb,  data and data.role_info.title or nil,posIndex)
end
function LabourDayGameRankAndRewardlView:RefreshItem(index, obj)
    local newIndex = 0
    local isself=false
    local Rank=0
    if index then
        newIndex=index + 1
    else
        isself=true
    end
    local data = {}
    local isEmpty = false
    if not isself then
        Rank=newIndex
        if self.CurRankData[newIndex] == nil then
            isEmpty = true
        else
            data = self.CurRankData[newIndex]
        end
    else
        data,Rank = self.model:GetMyRank()
    end
    local tb=_G.GetAutoGoTable(obj)
    tb.obj_content:SetActiveE(isEmpty and 0 or 1)
    if tb.obj_noBody then
        tb.obj_noBody:SetActiveE(isEmpty and 1 or 0)
    end
    tb.obj_SpecialRankNode:SetActiveE((Rank>0 and Rank<=3) and 1 or 0)
    if not isself then
        RankUtils.SetRankItemBgIcon(tb.aorimage_bg,Rank)
    end
    tb.aortext_rank:SetActiveE(0)
    if isself then
        tb.obj_noRank:SetActiveE(Rank>0 and 0 or 1)
    end
    if Rank>0 and Rank<=3 then
        local rankSpriteName=""
        if Rank==1 then
            rankSpriteName="0ui_icon_diyi"
        elseif Rank==2 then
            rankSpriteName="0ui_icon_dier"
        elseif Rank==3 then
            rankSpriteName="0ui_icon_disan"
        end
        tb.aorimage_rank.SpriteName=rankSpriteName
    elseif Rank>3 then
        tb.aortext_rank:SetActiveE(1)
        tb.aortext_rank.text=tostring(Rank)
    else
        tb.aortext_rank:SetActiveE(0)
    end
    if not table.isEmptyOrNil(data) then
        tb.aortext_name.text=data.role_info.name
        tb.aortext_desc.text=_G.GetLangPackValue(90034800118,data.value[1])
        local uid = data.role_info.uid
        if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
            _G.UIUtils.SetPlayerHeadItemNew(
                    tb.obj_head,
                    _G.PlayerModel:GetInstance():GetIRroleTable(),
                    1,
                    true,
                    true,
                    true
            )
        else
            _G.UIUtils.SetPlayerHeadItemNew(tb.obj_head,
                    data.role_info
            , 1, true, true, true)
        end
        _G.GameUtil.ReBuildRTF(tb.aortext_desc)
        _G.GameUtil.ReBuildRTF(tb.obj_autoDescNode)
    end
    return obj
end

---加载单个角色
---@param view table 视图
---@param rolepath string 模型路径
---@param posType number 摆放的位置
function LabourDayGameRankAndRewardlView:LoadRoleModel(rolepath, posIndex, scale,data)
    ---@type RecordRankListView._obj_info1_GoTable
    local info = self.RankShowNode[posIndex]
    if info.trans_role:GetChildCountE()>0 then
        _G.PoolsManager:GetInstance():Despawn(info.trans_role:GetChildE(0), _G.ePoolType.Temporary)
    end
    _G.PoolsManager:GetInstance():Spawn(
            rolepath,
            _G.ePoolType.Temporary,
            nil,
            function(trans)
                if trans == nil then
                    if _G.AppSetting.DEBUG then
                        _G.LogError("角色无法加载 path:" .. rolepath .. "    CardInfoView LoadRoleScene")
                    end
                    return
                end
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                trans:SetParentE(info.trans_role)
                trans:SetLocalPosition(0, 0, 0)
                trans:SetLocalScaleXYZ(scale)
                local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
                if rolePoint == nil then
                    rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
                end
                if _G.AppSetting.IsXzns then
                    local godHaloID = data.god_halo
                    if godHaloID ~= 0 then
                        local effCfg = _G.ConfigManager.god_halo_cfg[godHaloID].ui_effect_cfg
                        --- 神环路径，父级路径(加载角色的下面)
                        _G.UIUtils.LoadGodHalo(effCfg, trans,godHaloID)
                    end
                    if not table.isEmptyOrNil(data.artifact_skin) then
                        _G.UIUtils.LoadArtifacteffect(trans,nil,data.artifact_skin[1],data.artifact_skin[2])
                    end
                end
            end
    )
end
function LabourDayGameRankAndRewardlView:UpdateTop3Title(tb, data, index)
    if not data or  data.sid == 0 then
        if self.curShowEffTitle[index] ~= nil  then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = nil
        end
        tb.aorrawimage_title:SetActiveE(0)
        return
    end
    if self.curShowEffTitle == nil then
        self.curShowEffTitle = {}
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    local player_title = _G.ConfigManager.player_title_effect_cfg[data.sid]
    if player_title.type_title == 1 then
        tb.aorrawimage_title:LoadImage(player_title.title)
        tb.aorrawimage_title:SetActiveE(1)
        tb.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
        tb.obj_titleEffect:RemoveAllChildren()
        self.curShowEffTitle[index] = nil
    elseif player_title.type_title == 2 then
        if self.curShowEffTitle[index] == nil or (self.curShowEffTitle[index] ~= nil and self.curShowEffTitle[index] ~= player_title.title) then
            tb.obj_titleEffect:RemoveAllChildren()
            self.curShowEffTitle[index] = player_title.title
            _G.UIUtils.LoadEffectTitleOrFrame(
                    player_title.title,
                    tb.obj_titleEffect,
                    function(trans)
                        if self.curShowEffTitle[index] ~= player_title.title then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                        trans:SetLocalScaleXYZ(titleScale)
                    end
            )
        end
        tb.aorrawimage_title:SetActiveE(0)
    end
end
function LabourDayGameRankAndRewardlView:OnClickTop3(go,isOn,index)
    local data=self.CurRankData[index]
    if data then
        _G.SystemSettingManager:GetInstance():OpenView(data.role_info.uid)
    end
end

return LabourDayGameRankAndRewardlView