--加载事件模型
function LabourDayFestivalGameView:InitEventModel(initBol)
    local CardInfoManager = require("CardInfoManager")
    if self.Role[2] then
        _G.DestroyObject(self.Role[2])
        self.Role[2] = nil
    end
    if self.nowEventCfg.event_type == 6 or self.nowEventCfg.event_type == 7 then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg[self.nowEventCfg.obj_animation],
            self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01/2"),
            function(trans)
                self.Role[2] = trans
                self.Role[2]:SetLocalPositionToZero()
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end
        )
    elseif self.nowEventCfg.event_type <= 3 then 
        if not _G.string.IsNullOrEmpty(self.nowEventCfg.obj_adv) then
            local sid = self.nowEventCfg.obj_adv
            local path = CardInfoManager.GetBattleModelPath(sid, true)
            self.eventModel = CardInfoManager.GetRole(
                path,
                _G.ePoolType.Static,
                self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01/2"),
                _G.RoleEffTypeEnum.Fight,
                function(role)
                    if self:IsNil() then
                        _G.DestroyObject(role)
                        return
                    end
                    local scale = self.nowEventCfg.event_type == 2 and 0.8 or 1
                    role:SetLocalPosition(0.75, -1.06, -0.18)
                    role:SetLocalScaleXYZ(scale)
                    self.Role[2] = role
                    self.RoleAni[2] = _G.RoleAnimatorController.GetOrCreateAnimatorController(role)
                    self.RoleAni[2]:Play("idle_1", true)
                    local head = self:FindModelPoint(role)
                    self.modelX, self.modelY = _G.CS.UIUtils.WorldPointToLocalPointInRect(head,
                        self.go_table.rect_moveRoot)
                    local x, y, z = self.bgObj[1]:GetLocalPosition()
                    if initBol then
                        self:ShowModelTitle(true)
                    end
                end
            )
        end
    end
end

function LabourDayFestivalGameView:FindModelPoint(trans, forceUpdate)
    local rp = trans:GetComponentInChildrenE(_G.typeof(_G.CS.SkeletonBoneReferences))
    if not rp then
        return nil
    end
    local node = rp:Get("Point_Hp")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    local node = rp:Get("Point_Head")
    if not _G.IsNil(node) then
        rp:ForceUpdate(1) --立即同步一次骨骼位置
        return node
    end
    return nil
end

function LabourDayFestivalGameView:GetCameraAngleX()
    ---@type UnityEngine.Camera
    local mainCamera
    if _G.CS.FrameWork.Graphic.GraphicsManager.Instance then
        mainCamera = _G.CS.FrameWork.Graphic.GraphicsManager.Instance.MainCamera
    end
    return _G.CS.CameraUtils.GetCameraAngleX(mainCamera)
