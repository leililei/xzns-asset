---小游戏结束回调
function LabourDayFestivalGameView:GameEndCall(_,type)
    if type==1 then
        self.model:ComplatEvent(1, function(msg)
            self:FinishEventCallBack(msg)
            self:AnimOut(function()
                _G.UIManager:GetInstance():CloseWindow(self.minGameName)
            end)
        end)
    else
        self:AnimOut(function()
            _G.UIManager:GetInstance():CloseWindow(self.minGameName)
        end)
    end
    
end
function LabourDayFestivalGameView:FinishEventCallBack(msg)
    if msg.ack ~= 1 then
        return
    end
    if self:IsNil() then
        return
    end
    if  not table.isEmptyOrNil(msg) then
        _G.DelayDo(0.5, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name,
                    msg, function()
                        self.model:UpdateRank(function()
                            if self:IsNil() then
                                return
                            end
                            self:UpdateRank()
                        end)
                    end)
        end)
    else
        self.model:UpdateRank(function()
            if self:IsNil() then
                return
            end
            self:UpdateRank()
        end)
    end
    self:ShowEventView()
end
function LabourDayFestivalGameView:UpMulita()
    local maxMultiple=self.model.multiple
    local maxMultipleData= self.model.multipleDic[self.model.multiple]
    for i = 1, #self.model.multipleList do
        local isUnloclk=self.model.multipleList[i].value<=self.model.GoAll
        if isUnloclk and self.model.multipleList[i].key>= maxMultiple then
            maxMultiple=self.model.multipleList[i].key
            maxMultipleData=self.model.multipleList[i]
        end
    end
    if maxMultiple~=self.model.multiple and maxMultipleData.value<self.model.GoAll-self.model.multiple then
        self.model:SetMultiple(
                maxMultiple.key,
                function()
                    self:FreshEnergy()
                end
        )
    end
end

--加载场景
function LabourDayFestivalGameView:InitScene(initCall)
    self.Role = {}
    self.RoleAni = {}
    self.sceneRoot = _G.GameObject("RelicTeamRoot")
    local path = "Scenes/Gonghuizhudi/prefabs/Gushenyiji"
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.Static,
        self.sceneRoot,
        function(trans)
            if _G.IsNil(self.sceneRoot) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:ChangeCameraAdaption()
            self.curSceneTrans = trans
            trans:SetLocalPositionToZero()
            _G.TimerManager:GetInstance():GetTimer(1, self.InitRoleModel, self, true, true):Start()
            _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
            --相机高度降低固定值
            self.camera =
                self.curSceneTrans:FindE("Environment/Parent/Main Camera"):GetComponentE(
                    _G.typeof(_G.CS.FrameWork.Graphic.VisualCamera)
                )
            self.bgObj = {}
            self.bgObj[1] = self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01")
            local meshRenderer = self.bgObj[1]:GetComponentE(
                _G.typeof(_G.CS.UnityEngine.MeshRenderer)
            )
            _G.ResourcesManager:GetInstance():LoadTexture(
                "ImagesH5/hLabourDayFestival/ui_mjsy_bj",
                function(texture, resRef)
                    if self:IsNil() then
                        if resRef ~= nil then
                            resRef:Release()
                        end
                        return
                    end
                    self.PlayPngResRef = resRef
                    meshRenderer.material.mainTexture = texture
                end,
                self
            )

            if initCall then
                initCall()
            end
        end
    )
end

