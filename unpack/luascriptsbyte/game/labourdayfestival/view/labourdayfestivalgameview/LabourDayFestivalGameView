---界面的入口函数
---@param active ActivitySynBase
function LabourDayFestivalGameView:OnCreate(active)
    self.active=active
    self.model= active.typeClass.model
    self.showSort = false
    self.countDown=self.active.cfg.time.start_time+self.active.cfg.time.run_time-_G.TimeUtil.GetServerUnixTime()

    if not _G.IsNil(self.go_table.obj_goldInfo) and self.go_table.obj_goldInfo:GetctiveInHierarchy() == 1  then
        local resources = _G.GameUtil.GetVoucherResource({self.model.costSid})
         self.res=self:AddComponent(
                self.go_table.obj_goldInfo,
                require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
        )
    end
    self.model:GetRank(function()
        if self:IsNil() then
            return
        end
        self:UpdateRank()
    end)
    self:UpdateTime()
    self.energyTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self:UpdateView()
end

function LabourDayFestivalGameView:UpdateView()
    local activityManager = require("ActivitySynManager"):GetInstance()
    local jumpId = self.active:GetJumpType()
    local mainType = self.active:GetMainType()

    ---侧边活动栏
    for k,v in pairs(childActive) do
        local active = activityManager:GetChildAcitivity(k, jumpId, mainType)
        if not active and k ==10088 then
            active = activityManager:GetChildAcitivity(k, jumpId)
        end
        if active and not v.tb then
            local activeobj=_G.InstantiateObject(self.go_table.aorbtn_activeItem,self.go_table.obj_activitylist)
            local activeBtn=_G.GetAutoGoTable(activeobj,function()
                active.typeClass:EnterActivity()
            end)
            v.tb=activeBtn
            activeBtn.obj_redpoint:UpdateRedPointItemIDAndParam(
                    active:GetActivityTypeCls():GetRedpointIDByIndex(1)
            )
            activeBtn.aorimage_Icon.SpriteName=v.icon
            activeBtn.aortext_text.text=_G.GetLangPackValue(v.name)
        end
        if k==10088 then
           self.go_table.aorbtn_extraAward:SetActiveE(active and 1 or 0) 
        end
    end

    self.go_table.obj_extraredpoint:UpdateRedPointItemIDAndParam(
            self.active:GetActivityTypeCls():GetRedpointIDByIndex(4))
    self:ShowEventView()
end

--刷新事件页面
function LabourDayFestivalGameView:ShowEventView()
    self:FreshNowEvent(not self.inEventViewBol)
    self.inEventViewBol = true
    self:FreshEnergy()
    self:InitPigPrzie()
    if not self.IsFirst then
        self.go_table.looplist2_eventList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = true
    end
    self.go_table.looplist2_eventList:SetListItemCount(#self.eventShowTxtTable, true, true)
    self.go_table.looplist2_eventList:MovePanelToItemIndex(#self.eventShowTxtTable - 1)
    self.go_table.aortext_layerName.text=_G.GetLangPackValue(90034800114,self.model:GetNowGoAllPregress());
end
---刷新列表
function LabourDayFestivalGameView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local data = self.eventShowTxtTable[index + 1]
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local tb = _G.GetAutoGoTable(item)
    tb.aortext_event.text = data
    _G.GameUtil.ReBuildRTF(item)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_Content)
    return item
end


--刷新事件数据
function LabourDayFestivalGameView:FreshEventData()
    self.nowEvent = self.model.nowEvent
    self.eventShowTxtTable = self.model:GetEventShowTxtTable()
    if self.model.nowEvent>0 then
        self.nowEventCfg = self.model.cfg[self.nowEvent]
    else
        self.nowEventCfg = nil
    end
    if not self.IsFirst then
        self.go_table.looplist2_eventList:InitListView(0, _G.handler(self, self.RefreshList))
        self.IsFirst = true
    end
    self.go_table.looplist2_eventList:SetListItemCount(#self.eventShowTxtTable, true, true)
    self.go_table.looplist2_eventList:MovePanelToItemIndex(#self.eventShowTxtTable - 1)
    --self.go_table.looplist2_eventList:RefreshAllShownItem()
end


--刷新事件按钮
function LabourDayFestivalGameView:ChangeExploreBtnTxt()
    self.go_table.aorbtn_explore.enabled = true
    if self.model.nowEvent>0 then
        if self.nowEventCfg.event_type ==1 or self.nowEventCfg.event_type ==4 then
            self.go_table.aorbtn_explore:SetActiveE(1)
            self.go_table.aorbtn_explore1:SetActiveE(0)
            self.go_table.aorbtn_explore2:SetActiveE(0)
            self.go_table.aortext_exploreBtn.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][1])
        else
            self.go_table.aorbtn_explore:SetActiveE(0)
            self.go_table.aorbtn_explore1:SetActiveE(1)
            self.go_table.aorbtn_explore2:SetActiveE(1)
            self.go_table.aortext_exploreBtn1.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][1])
            self.go_table.aortext_exploreBtn2.text = _G.GetLangPackValue(self.nowEventCfg.btn_desc[1][2])
        end
    else
        self.go_table.aorbtn_explore:SetActiveE(1)
        self.go_table.aorbtn_explore1:SetActiveE(0)
        self.go_table.aorbtn_explore2:SetActiveE(0)
        self.go_table.aortext_exploreBtn.text = _G.GetLangPackValue(90033500055)
    end
end


--刷新当前事件
function LabourDayFestivalGameView:FreshNowEvent(initBol)
    self:FreshEventData()
    self:ChangeExploreBtnTxt()
    if not self.curSceneTrans then
        self:InitScene(function()
            self:FreshEventModel(initBol)
        end)
    else
        self:FreshEventModel(initBol)
    end
end

function LabourDayFestivalGameView:InitPigPrzie()
    if not self.PigPrzie then
        self.PigPrzie=_G.GetAutoGoTable(self.go_table.obj_maxAward,_G.handler(self,self.OnclickmaxawardBtn))
    end
    local Data=self.model:GetNowBigPrizeData()
    if not self.CurBigPriza or self.CurBigPriza.index~=Data.index then
        self.CurBigPriza=Data
        self.PigPrzie.obj_itemroot:ClearChildren()
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                Data.reward[1].type,
                self.PigPrzie.obj_itemroot,
                function(item)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
        )
    end
    if not self.initPigPrzieRedPoint then
        self.PigPrzie.obj_maxRewardredpoint:UpdateRedPointItemIDAndParam(
                self.active:GetActivityTypeCls():GetRedpointIDByIndex(3))
        self.initPigPrzieRedPoint=true
    end
    self.PigPrzie.obj_got:SetActiveE(table.ContainsValue(self.model.GotAward,Data.index) and 1 or 0)
    self.PigPrzie.aortext_value.text=string.format("%s/%s",(self.model.GoAll<=Data.count and self.model.GoAll or Data.count)*self.model.distance,Data.count*self.model.distance)
     local tf =self.PigPrzie.aorimage_slider:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if not _G.IsNil(tf) then
        tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, 
        71.5*(self.model.GoAll<=Data.count and self.model.GoAll/Data.count or 1))
    end
end
function LabourDayFestivalGameView:OnclickmaxawardBtn()
    local data=self.model:GetCanGetAllAccumulativeIndex()
    if table.isEmptyOrNil(data) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayGameAwardShowView.Name,self.active)
    else
        self.model:GetAllAccumulativeAward(function()
            self:InitPigPrzie()
        end)
    end
end

function LabourDayFestivalGameView:StopTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

function LabourDayFestivalGameView:UpdateTime(elapsed)
    if elapsed then
       self.countDown = self.countDown - elapsed
    end
    if self.countDown < 0 then
        self.countDown = 0
        self.go_table.obj_team:SetActiveE(0)
    end
    if self.go_table == nil then
        return
    end
    local time = _G.Mathf.RoundToInt(self.countDown)
    self.go_table.aortext_time.text =
        _G.GetLangPackValue(90028900002, _G.string.AddColor(_G.TimeUtil.GiftPackGroupTime(self.countDown), "5BA177"))
end

function LabourDayFestivalGameView:OnDestroy()
    self:RemoveAllListener() --todo 这个移除没用
    self:StopTimer()
    if self.doTween then
        for k, v in ipairs(self.doTween) do
            v:Kill()
        end
        self.doTween = nil
    end
    self.RoleAni = {}
    if self.curSceneTrans then
        _G.PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
        self.curSceneTrans = nil
    end
    if self.Role then
        for k, v in pairs(self.Role) do
            _G.DestroyObject(v)
            self.Role[k] = nil
        end
        self.myModel = nil
    end
    if self.sceneRoot then
        _G.DestroyObject(self.sceneRoot)
        self.sceneRoot = nil
    end
    if self.boxEffect then
        _G.DestroyObject(self.boxEffect)
        self.boxEffect = nil
    end
    if self.PlayPngResRef ~= nil then 
        self.PlayPngResRef:Release()
    end
    self.initBossBol = nil
    for k,v in pairs(childActive) do
        if v.tb then
           v.tb=nil
        end
    end
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.UpdateView, self)
end

---按钮点击事件在这里派发
function LabourDayFestivalGameView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_serverList then
        self.model:GetServerList(
                function(data)
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RelicTeamServerListView.Name, data)
                end
        )
    elseif go == self.go_table.aorbtn_tips then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 1041)
    elseif go == self.go_table.aorbtn_explore then
        if not self.finishEventAnimBol then
            self.go_table.aorbtn_explore.enabled = false
            if self.model.nowEvent == 0 then
                if not self.model:CheckEnoughCostToNext() then
                    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, self.model.costSid)
                    return
                end
                self.model:NextEvent( function()
                    if self:IsNil() then
                        return
                    end
                    self.res:ResRefresh()
                    self:FreshEventData()
                    self:ShowEventAnim()
                    self:FreshEnergy()
                end)
            else
                self:FinishEvent()
            end
        end
    elseif go == self.go_table.aorbtn_explore1 then
        self:FinishEvent(1)
    elseif go == self.go_table.aorbtn_explore2 then
        self:FinishEvent(2)
    elseif go == self.go_table.aorbtn_arrow then
        self.showSort = not self.showSort
        self:ExtendSortList()
    elseif go == self.go_table.aorbtn_rank then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LabourDayFestivalToggleView.Name)
        if view then
            view.go_table.toggle_rank.isOn=true
        end
    elseif go == self.go_table.aorbtn_Rankaward then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LabourDayFestivalToggleView.Name)
        if view then
            view.go_table.toggle_award.isOn=true
        end
    elseif go == self.go_table.aorbtn_extraAward then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayGameExtraAwardView.Name, self.active)
    end
end
function LabourDayFestivalGameView:GetToday()
    local nowtime=_G.TimeUtil.GetServerUnixTime()
    local startTime=self.model.active_StartTime
    local today=_G.TimeUtil.GetIntervalDayBySix1(startTime,nowtime)+1
    return today
end

---设置下拉列表
function LabourDayFestivalGameView:ExtendSortList()
    self.go_table.obj_isSorting:SetActiveE(self.showSort and 1 or 0)
    if self.showSort and not self.initmultipleList then
        self.go_table.scrollloopvectical_powerSort:InitItemData(
                #self.model.multipleList,
                _G.handlerbind(self, self.RefreshSortItem)
        )
        self.initmultipleList=true
    else
        self.go_table.scrollloopvectical_powerSort:UpdateAllItem()
    end
end

function LabourDayFestivalGameView:RefreshSortItem(index, obj)
    local _index = index + 1
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSortItem, _index))
    local data=self.model.multipleList[_index]
    local isSelect=self.model.multiple==data.key
    local isUnloclk=data.value<=self.model.GoAll
    tb.aortext_sortType.text=self.model:GetNowMultipleTxtByIndex(_index)
    tb.obj_isCurSort:SetActiveE(isSelect and 1 or 0)
    tb.aorimage_suo:SetActiveE(isUnloclk and 0 or 1)
end


function LabourDayFestivalGameView:OnClickSortItem(go, isOn, index)
    self.showSort = not self.showSort
    self:ExtendSortList()
    local data=self.model.multipleList[index]
    if self.model.multiple==data.key then
        return
    end
    local isUnloclk=data.value<=self.model.GoAll
    if not isUnloclk then
        _G.PopWindowManager:GetInstance():ShowAllTips(1150003,_G.GetLangPackValue(90034800116,data.value))
        return
    end
    if data.key>self.model:GetCoinNumber() then
        _G.PopWindowManager:GetInstance():ShowAllTips(1150004)
        return
    end
    self.model:SetMultiple(
            data.key,
            function()
                self:FreshEnergy()
            end
    )
end
