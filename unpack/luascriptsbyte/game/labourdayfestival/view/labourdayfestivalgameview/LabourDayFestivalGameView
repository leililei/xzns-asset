--加载事件模型
function LabourDayFestivalGameView:FreshEventModel(initBol)
    if self.nowEventCfg then
        local x, y, z = self.bgObj[1]:GetLocalPosition()
        self.bgObj[1]:SetLocalPosition(x, y, -22.9)
        if initBol then
            if self.nowEventCfg.event_type == 4 then
                self:ShowBoxAnim()
            elseif self.nowEventCfg.event_type > 3 then
                self:ShowModelTitle(true)
            end
        end
        self:InitEventModel(initBol)
        self.go_table.obj_select:SetActiveE(0)
        self.go_table.obj_firstTips:SetActiveE(0)
        self.go_table.obj_nextRole:SetActiveE(0)
    else
        for k, v in pairs(self.Role) do
            if k ~= 1 then
                _G.DestroyObject(v)
                self.Role[k] = nil
            end
        end
        self.go_table.obj_select:SetActiveE(1)
        self:ShowModelTitle(false)
        if self.boxEffect then
            _G.DestroyObject(self.boxEffect)
            self.boxEffect = nil
        end
    end
end

--探索动画
function LabourDayFestivalGameView:ShowEventAnim()
    self:FreshEventModel()
    local x, y, z = self.bgObj[1]:GetLocalPosition()
    self.bgObj[1]:SetLocalPosition(x, y, 11.4)
    self.finishEventAnimBol = true
    self.RoleAni[1]:Play("run_1", true)
    self.doTween = self.doTween or {}
    self.boxEffect = nil
    self.doTween[1] = self.bgObj[1]:DOLocalMoveZ(-22.9, 2):OnComplete(
        function()
            self.RoleAni[1]:Play("idle_1", true)
            if self.nowEventCfg.event_type == 4 then
                self:ShowBoxAnim()
            else
                self.finishEventAnimBol = false
                self:ChangeExploreBtnTxt()
                self:ShowModelTitle(true)
            end
        end)
end

function LabourDayFestivalGameView:ShowModelTitle(bol)
    local eventY = {
        [4] = -150,
        [5] = 123,
        [6] = -28,
        [7] = -18
    }
    if bol then
        self.go_table.obj_eventModelRoot:SetActiveE(1)
        self.go_table.aortext_event1.text = _G.GetLangPackValue(self.nowEventCfg.name)
        if self.nowEventCfg.event_type < 3 then
            self.go_table.obj_eventModelRoot:SetLocalPosition(215, self.modelY - 158 , 0)
        else
            self.go_table.obj_eventModelRoot:SetLocalPosition(215, eventY[self.nowEventCfg.event_type] or 123, 0)
        end
        self.go_table.aortext_event1:SetActiveE(1)
    else
        self.go_table.obj_eventModelRoot:SetActiveE(0)
    end
end

function LabourDayFestivalGameView:ShowBoxAnim()
    local id = self.nowEventCfg.id
    id = math.floor(id / 100) % 10
    local cfg = id == 3 and _G.ConfigManager.ui_effect_cfg.ef_baoxiangbaokaijing or
        _G.ConfigManager.ui_effect_cfg.ef_baoxiangbaokaiputong
    _G.UIUtils.LoadEffectByCfg(
        cfg,
        self.go_table.obj_eventRoot,
        function(trans)
            self.boxEffect = trans
            self.boxEffect:SetLocalPosition(198, -211, 0)
            self.boxEffect:SetLocalScaleXYZ(1.8)
            trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            _G.DelayDo(1, function()
                self:ChangeExploreBtnTxt()
                self.finishEventAnimBol = false
                self:ShowModelTitle(true)
            end)
        end
    )
end

--重置动画
function LabourDayFestivalGameView:ResetEventAnim()
    if self.curSceneTrans then
        self:FreshEventModel(true)
        self.RoleAni[1]:Play("idle_1", true)
        self.finishEventAnimBol = false
        self:ChangeExploreBtnTxt()
        self:ShowModelTitle(false)
        local x, y, z = self.bgObj[1]:GetLocalPosition()
        self.bgObj[1]:SetLocalPosition(x, y, 11.4)
        if self.doTween then
            for k, v in ipairs(self.doTween) do
                v:Kill()
            end
            self.doTween = nil
        end
    end
end

