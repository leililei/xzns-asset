function LabourDayFestivalGameView:ShowNextRole()
    if not self.initNextRole then
        self.NextRoleTable=_G.GetAutoGoTable(self.go_table.obj_nextRole)
        self.nextRoleInfos={}
        self.initNextRole=true
    end
    self.model:UpDateNextRole(function()
        if table.isEmptyOrNil(self.model.nextRole) or self.model.nextRole[1]==0 or self.model.nextRole[1]==_G.PlayerModel:GetInstance():GetPlayerUid() then
            self.go_table.obj_nextRole:SetActiveE(0)
            self.go_table.obj_firstTips:SetActiveE(self.model.GoAll>0 and 1 or 0)
        elseif self.model.nowEvent==0 then
            self.go_table.obj_nextRole:SetActiveE(1)
            self.go_table.obj_firstTips:SetActiveE(0)
            if table.isEmptyOrNil(self.nextRoleInfos) or not self.nextRoleInfos[self.model.nextRole[1]] then
                require "SystemSettingNet":GetInstance():GetPlayerInfo(
                        { uid = self.model.nextRole[1] },
                        handlerbind(self, self.LoadCompCall, self.model.nextRole[1]))
            end
            self.NextRoleTable.aortext_distance.text=_G.GetLangPackValue(90034800118,(self.model.nextRole[2]-self.model.GoAll)*self.model.distance)
        end
    end)
end
function LabourDayFestivalGameView:LoadCompCall(msg,uid)
    self.nextRoleInfos[uid]=msg.info
    self.NextRoleTable.aortext_Name.text=msg.info.name
    _G.UIUtils.SetPlayerHeadItemNew(
            self.NextRoleTable.obj_HeadItemBase,
            msg.info,
            1,
            true,
            true,
            true
    )
end

function LabourDayFestivalGameView:UpdateRank()
    ---@type DrawUpMainView._obj_myrankItem_GoTable
    local myGoTable = _G.GetAutoGoTable(self.go_table.obj_myrankItem)
    local selfRankPb,myRank=self.model:GetMyRank()
    --myGoTable.aortext_rankname.text = playerModel:GetName()
    if myRank >= 1 and myRank <= 3 then
        --myGoTable.aorimage_rankIcon:SetActiveE(1)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        --myGoTable.aorimage_rankIcon:LoadSprite(string.format("tz_qjhs_phb_mingci_0%d", myRank))
        myGoTable.aortext_rankscore.text = myRank
    elseif myRank ==0 and  selfRankPb.value[1] == 0 then
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(0)
        myGoTable.aortext_rankno:SetActiveE(1)
    else
        --myGoTable.aorimage_rankIcon:SetActiveE(0)
        myGoTable.aortext_rankscore:SetActiveE(1)
        myGoTable.aortext_rankno:SetActiveE(0)
        myGoTable.aortext_rankscore.text = (myRank == 0 or myRank > 1000) and "1000+" or myRank
    end
    self.rankInfo=self.model.RankData
    if not self.rankScroll then
        self.go_table.scrollloopvectical_rankList:InitItemData(3, _G.handler(self, self.UpdateRankItem))
        self.rankScroll = self.go_table.scrollloopvectical_rankList
    else
        self.rankScroll:UpdateCount(3)
    end
    self:ShowNextRole()
end

local rankIcon = {
    "0ui_icon_diyi",
    "0ui_icon_dier",
    "0ui_icon_disan"
}

function LabourDayFestivalGameView:UpdateRankItem(csIndex, obj)
    if csIndex < 0 then
        return
    end
    local luaIndex = csIndex + 1
    ---@type DrawUpMainView._obj_rankItem_GoTable
    local goTable = _G.GetAutoGoTable(obj)
    local rankInfo = (self.rankInfo and self.rankInfo[luaIndex]) and self.rankInfo[luaIndex] or nil
    local posRank = luaIndex
    if posRank >= 1 and posRank <= 3 then
        goTable.aorimage_rankIcon:SetActiveE(1)
        goTable.aorimage_rankIcon:LoadSprite(rankIcon[posRank])
    else
        goTable.aorimage_rankIcon:SetActiveE(0)
    end
    if rankInfo and rankInfo.role_info and rankInfo.role_info.uid > 0 then
        goTable.aortext_rankname.text = rankInfo.role_info.name
        goTable.aortext_rankscore.text = _G.GetLangPackValue(90034800118,rankInfo.value[1])
    else
        goTable.aortext_rankname.text = _G.GetLangPackValue(90022300109)
        goTable.aortext_rankscore.text = ""
    end
end

function LabourDayFestivalGameView:AnimOut(zoomOutCall, zoomInCall)
    if self:IsNil() then
        return
    end
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn(zoomInCall)
                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn(zoomInCall)
                end
        )
    end
end

function LabourDayFestivalGameView:AnimIn(callBack)
    _G.DelayDo(0.1, function()
        local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
        )
        if transforView then
            transforView:Show()
            transforView:SetAction(
                    "zoom_in",
                    function()
                        if callBack then
                            callBack()
                        end
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                    "zoom_in",
                    function()
                        if callBack then
                            callBack()
                        end
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        end
    end)
end

--完成事件
function LabourDayFestivalGameView:FinishEvent(chooseNum)
    if self.nowEventCfg.event_type == 1  then
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shizizhan,
            self.curSceneTrans:FindE("Scene/static/fbx_Gonghuizhudi_01/2"),
            function(trans)
                self.effect = trans
                self.effect:SetLocalPosition(0, -1.53, -1.03)
                trans:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
            end,
            function(trans)
                self.model:ComplatEvent(nil, function(msg)
                    self:FinishEventCallBack(msg)
                end)
            end
        )
    elseif self.nowEventCfg.event_type == 4 then
        self.model:ComplatEvent(nil, function(msg)
            self:FinishEventCallBack(msg)
        end)
    elseif self.nowEventCfg.event_type == 6  then
        self.model:ComplatEvent(chooseNum, function(msg)
            self:FinishEventCallBack(msg)
        end)
    elseif self.nowEventCfg.event_type == 7 then
        if chooseNum==1 then
            self:StartGame()
        else
            local today=self:GetToday()
            local lastRecord=_G.PlayerPrefsManager.GetInt(tostring(self.active.activityID),0)
            if today~=lastRecord then
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayGameReturnTipsView.Name, function(istrue,isrecord)
                    if isrecord then
                        _G.PlayerPrefsManager.SetInt(tostring(self.active.activityID),today)
                    end
                    if istrue then
                        self.model:ComplatEvent(chooseNum, function(msg)
                            self:FinishEventCallBack(msg)
                        end)
                    end
                end)
            else
                self.model:ComplatEvent(chooseNum, function(msg)
                    self:FinishEventCallBack(msg)
                end)
            end
        end
    end
end

---开始小游戏
function LabourDayFestivalGameView:StartGame()
    local uiname=""
    local cfg=nil
    ---1 红包 2 赛车 3 剑之修行 4 打地鼠
    if self.nowEventCfg.event_params[1][1]== 1 then
        uiname=_G.ConfigManager.ui_cfg.LabourDayRedPareView.Name
        cfg=_G.ConfigManager.min_descend_cfg[self.nowEventCfg.event_params[1][2]]
    elseif self.nowEventCfg.event_params[1][1]== 2 then
        uiname=_G.ConfigManager.ui_cfg.LabourDayTakeOutGameView.Name
        cfg=_G.ConfigManager.min_parkour_cfg[self.nowEventCfg.event_params[1][2]]
    elseif self.nowEventCfg.event_params[1][1]== 3 then
        uiname=_G.ConfigManager.ui_cfg.LabourDaySwordCasualView.Name
        cfg=_G.ConfigManager.jzxx_stage_cfg[self.nowEventCfg.event_params[1][2]]
    elseif self.nowEventCfg.event_params[1][1]== 4 then
        uiname=_G.ConfigManager.ui_cfg.LabourDayEventCureView.Name
