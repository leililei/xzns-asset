---@class LabourDayGameBigPrizeShowView : UIBaseView	中文描述
---@field  model LabourDayGameModel
---@field public go_table LabourDayGameBigPrizeShowView_GoTable GoTable
local LabourDayGameBigPrizeShowView = _G.BaseClass("LabourDayGameBigPrizeShowView", _G.UIBaseView)
function LabourDayGameBigPrizeShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function LabourDayGameBigPrizeShowView:OnCreate(activity)
    self.model= activity.typeClass.model
    self:InitJianglilist()
    self:InitDaJiangList()
    self.go_table.aorrawimage_role:LoadImage("ImagesH5/hLabourDayFestival/ui_xddj_img_js",function()
        if self:IsNil() then
            return
        end
        self.go_table.aorrawimage_role:SetNativeSize()
    end)
    self.go_table.toggle_tips.isOn=false
end
function  LabourDayGameBigPrizeShowView:InitJianglilist()
    self.awawrdPreviewList=self.model.awardPreview
    self.dajiangList={}
    for k,v in pairs(self.awawrdPreviewList)do
        if v.big_award==1 then
            table.insert(self.dajiangList,v)
        end
    end
    _G.SortList(self.dajiangList,function(a)
        return -a.index
    end)
end

function LabourDayGameBigPrizeShowView:InitDaJiangList()
    local index=0
    for i = 1, #self.dajiangList do
        if table.ContainsValue(self.model.GotAward,self.dajiangList[i]) and i>index then
            index=i
        end
    end
    index=index-1
    self.go_table.scrollloophorizontal_dajianglist:InitItemData(#self.dajiangList,_G.handler(self,self.InitDaJiangItem),index)
end
function LabourDayGameBigPrizeShowView:InitDaJiangItem(index, obj)
    local item=self.dajiangList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    local goId = obj:GetInstanceIDE()
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            item.reward[1].type,
            tb.obj_item,
            function(tran)
                if _G.IsNil(tb) or goId ~= obj:GetInstanceIDE() then
                    return
                end
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGradeNew(false)
            end
    )
end

function LabourDayGameBigPrizeShowView:OnClickBtn(go,isOn)
    if go==self.go_table.aorbtn_close2 or go==self.go_table.aorbtn_Close then
		if self.go_table.toggle_tips.isOn then
            _G.PlayerPrefsManager.SetString("LabourDayGameBigPrize",tostring(_G.TimeUtil.GetServerUnixTime()))
		end
        self:Close()
    elseif go==self.go_table.aorbtn_sure then
        _G.JumpManager:GetInstance():Jump(330026)
        if self.go_table.toggle_tips.isOn then
            _G.PlayerPrefsManager.SetString("LabourDayGameBigPrize",tostring(_G.TimeUtil.GetServerUnixTime()))
        end
        self:Close()
    end
end
function LabourDayGameBigPrizeShowView:Dispose()
    self.dajiangList={}
    self.awawrdPreviewList={}
end
return LabourDayGameBigPrizeShowView