---@class LabourDayGameAwardShowView : UIBaseView	中文描述
---@field  model LabourDayGameModel
---@field public go_table LabourDayGameAwardShowView_GoTable GoTable
local LabourDayGameAwardShowView = _G.BaseClass("LabourDayGameAwardShowView", _G.UIBaseView)
function LabourDayGameAwardShowView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function LabourDayGameAwardShowView:OnCreate(activity)
    self.model= activity.typeClass.model
    self:InitJianglilist()
    self:InitAwardPreviewLuist()
    self:InitDaJiangList()

end
function  LabourDayGameAwardShowView:InitJianglilist()
    self.awawrdPreviewList=self.model.awardPreview
    self.dajiangList={}
    for k,v in pairs(self.awawrdPreviewList)do
        if v.big_award==1 then
            table.insert(self.dajiangList,v)
        end
    end
    _G.SortList(self.dajiangList,function(a)
        return -a.index
    end)
end

function LabourDayGameAwardShowView:InitAwardPreviewLuist()
    local index=#self.model.GotAward
    index=index-1
    self.go_table.scrollloopvectical_jiangliList:InitItemData(#self.awawrdPreviewList,_G.handler(self,self.InitJiangliItem),index)
end

function LabourDayGameAwardShowView:InitJiangliItem(index, obj)
    local item=self.awawrdPreviewList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    tb.aortext_title.text=_G.GetLangPackValue(90034800121,item.count*self.model.distance)
    tb.obj_items:ClearChildren()
    local isget=table.ContainsValue(self.model.GotAward,item.index)
    for i = 1, #item.reward do
        local itemob=_G.InstantiateObject(self.go_table.obj_awarditem2,tb.obj_items)
        itemob:SetActiveE(1)
        local goId = itemob:GetInstanceIDE()
        local itemtb=_G.GetAutoGoTable(itemob)
        itemtb.obj_gou:SetActiveE(isget and 1 or 0)
        
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                item.reward[i].type,
                itemtb.obj_Root,
                function(tran)
                    if _G.IsNil(tb) or goId ~= itemob:GetInstanceIDE() then
                        return
                    end
                    tran.gameObject:SetLocalScaleXYZ(0.9)
                    itemtb.obj_gou:SetLocalScaleXYZ(0.9)
                    tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    tran:SetGradeNew(i ~= 1)
                end
        )
    end
end

function LabourDayGameAwardShowView:InitDaJiangList()
    local index=0
    for i = 1, #self.dajiangList do
        if table.ContainsValue(self.model.GotAward,self.dajiangList[i]) and i>index then
            index=i
        end
    end
    index=index-1
    self.go_table.scrollloophorizontal_dajianglist:InitItemData(#self.dajiangList,_G.handler(self,self.InitDaJiangItem),index)
end
function LabourDayGameAwardShowView:InitDaJiangItem(index, obj)
    local item=self.dajiangList[index+1]
    local tb=_G.GetAutoGoTable(obj)
    local goId = obj:GetInstanceIDE()
    local isget=table.ContainsValue(self.model.GotAward,item.index)
    tb.obj_gou:SetActiveE(isget and 1 or 0)
    tb.aortext_round.text=_G.GetLangPackValue(90034800118,item.count*self.model.distance)
    tb.obj_item:ClearChildren()
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
            item.reward[1].type,
            tb.obj_item,
            function(tran)
                if _G.IsNil(tb) or goId ~= obj:GetInstanceIDE() then
                    return
                end
                tran.gameObject:SetLocalScaleXYZ(1)
                tran:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                tran:SetGradeNew(false)
            end
    )
end

function LabourDayGameAwardShowView:OnClickBtn(go,isOn)
    if go==self.go_table.aorbtn_close then
        self:Close()
    elseif go==self.go_table.aorbtn_Close then
        self:Close()
    end
end
function LabourDayGameAwardShowView:Dispose()
    self.dajiangList={}
    self.awawrdPreviewList={}
end
return LabourDayGameAwardShowView