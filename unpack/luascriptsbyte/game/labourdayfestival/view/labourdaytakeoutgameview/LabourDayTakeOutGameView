local base= require "TakeOutGameView"
---@class LabourDayTakeOutGameView : TakeOutGameView	外卖小游戏
---@field public go_table LabourDayTakeOutGameView_GoTable GoTable
local LabourDayTakeOutGameView = _G.BaseClass("LabourDayTakeOutGameView", base)

function LabourDayTakeOutGameView:OnCreate(callback,cfg)
    self.callback=callback
    base.OnCreate(self,nil,nil,nil,cfg)
end


---固定帧 更新
function LabourDayTakeOutGameView:FixedUpdateRoad()
    if not self.GameStart then
        return
    end
    self.startHp = require "TakeOutGameModel":GetInstance().startHp
    if self.startHp <= 0 then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOutToMain then
            if require "TakeOutGameModel":GetInstance():GetGrade() >= 1 then
                self.go_table.aorbtn_restart:SetActiveE(0)
            end
        end
        self:SetGameEnd()
        _G.UpdateManager:GetInstance():RemoveFixedUpdate(self.FixedUpdateRoad, self)
        return
    end
    self:MoveBgCity()
    self:MoveRoad()
end

function LabourDayTakeOutGameView:UpdateBtn()
    self.go_table.aorbtn_entry:SetActiveE(0)
    self.go_table.aorbtn_customer:SetActiveE(0)
end


---设置游戏结束
function LabourDayTakeOutGameView:SetGameEnd()
    if self.callback then
        self:callback(1)
        self.callback = nil
    end
end


function LabourDayTakeOutGameView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        if self.callback then
            self:callback(0)
            self.callback = nil
        end
    else
        base.OnClickBtn(self,go)
    end

end
return LabourDayTakeOutGameView