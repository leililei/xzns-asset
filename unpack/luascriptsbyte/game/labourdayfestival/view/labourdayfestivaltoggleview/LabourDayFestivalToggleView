---@class LabourDayFestivalToggleView : UIBaseView  下边栏菜单
---@field go_table LabourDayFestivalToggleView_GoTable
---@field toggles table<string,LabourDayFestivalToggleView._toggle_reset_GoTable> 切换按钮
---@field curToggle string  @当前选中的界面
---@field views table<string, number|Component|UIBaseView> @界面实例
local LabourDayFestivalToggleView = _G.BaseClass("LabourDayFestivalToggleView", _G.UIBaseView)
local LabourDayGameSynModel
local keyName = {
    [1] = "relic",
    [2] = "rank",
    [3] = "award",
}

function LabourDayFestivalToggleView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
    _G.Events:GetInstance():AddListener(_G.eRelicTeam.RelicTeamRefresh, self.UpdateView, self)
end

function LabourDayFestivalToggleView:UpdateTeamPushCall(msg)
    if msg.state == 3 then 
        _G.PopWindowManager:GetInstance():ShowAllTips(1070027)
        self:UpdateView()
        return 
    end
    if msg.state ~= 4 and msg.state ~= 6 then  
        --LabourDayGameSynModel:GetTeam(_G.handler(self, self.UpdateView))
    end 
end

function LabourDayFestivalToggleView:UpdateView()
    if self.views then
        for _, view in pairs(self.views) do
            if view ~= 0 and view.gameObject:GetActiveSelf() == 1 and view.UpdateView then 
                view:UpdateView()
            end 
        end
    end
end
---界面的入口函数
---@param toggleIndex number|string|nil 切换界面的索引
function LabourDayFestivalToggleView:OnCreate(activity,toggleIndex)
    self.mainActive=activity
    self:InitToggles()
    ---@type string
    local key
    if type(toggleIndex) == "string" then
        key = toggleIndex
    elseif type(toggleIndex) == "number" then
        key = keyName[toggleIndex]
    end
    key = key or self:GetDefaultToggleKey()
    local tog = self.go_table["toggle_" .. key] or self.go_table.toggle_relic
    if tog then
        tog.isOn = false
        tog.isOn = true
    end
    local jumpId = self.mainActive:GetJumpType()
    local Activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, jumpId)
    if Activity then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(Activity:GetGameMainViewName())
        if view then
            view:Hide()
        end
    end
end

function LabourDayFestivalToggleView:SwitchToggle(toggleName)
    if self.curToggle ~= toggleName then 
        local tog = self.go_table["toggle_" .. toggleName]
        if tog then
            tog.isOn = false
            tog.isOn = true
        end
    end
end

function LabourDayFestivalToggleView:OnDestroy()
    self:RemoveAllListener()
    self.views = nil 
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamUpdateTeam, self.UpdateTeamPushCall, self)
    _G.Events:GetInstance():RemoveListener(_G.eRelicTeam.RelicTeamRefresh, self.UpdateView, self)
end

---根据功能获取当前可打开的toggle节点
function LabourDayFestivalToggleView:GetDefaultToggleKey()
    return "relic"
end

function LabourDayFestivalToggleView:InitToggles()
    self.views = {}
    self.toggles = {
        relic = _G.GetAutoGoTable(
            self.go_table.toggle_relic,
            _G.handlerbind(self, self.OnClickToggle, "relic", _G.handler(self, self.OnRelic))
        ),
        rank = _G.GetAutoGoTable(
            self.go_table.toggle_rank,
            _G.handlerbind(self, self.OnClickToggle, "rank", _G.handler(self, self.OnRank))
        ),
        award = _G.GetAutoGoTable(
            self.go_table.toggle_award,
            _G.handlerbind(self, self.OnClickToggle, "award", _G.handler(self, self.OnAward))
        )
    }
    local jumpId = self.mainActive:GetJumpType()
    local mainType = self.mainActive:GetMainType()
    self.giftActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10048, jumpId)
    self.go_table.aorbtn_exchange:SetActiveE(self.giftActivity and 1 or 0)
    if self.giftActivity then 
        self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(self.giftActivity:GetActivityTypeCls():GetRedpointIDByIndex(1) or 0)
    end
end
---监听Toggle点击事件
---@param key string
---@param callback function
function LabourDayFestivalToggleView:OnClickToggle(_, isOn, key, callback)
    local tb = self.toggles[key]
    if key=="award" or key=="rank" then
        key="rankandaward"
    end
    local view = self.views[key]
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    self.curToggle = key

    --节点显隐
    if view and view ~= 0 then
        view.gameObject:SetActiveE(isOn and 1 or 0)
    end

    if isOn and callback then
        callback()
    end
end

function LabourDayFestivalToggleView:OnRelic()
    local view = self.views.relic
    if not view then
        self.views.relic = 0
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayFestivalGameView.Name,self.mainActive)
    elseif view ~= 0 then
        view:UpdateView()
    end
end
function LabourDayFestivalToggleView:OnRank()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LabourDayGameRankAndRewardlView.Name)
    if not view then
        self.views.rankandaward = 0
        if view then
            view:UnDataView(1)
        else
            self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayGameRankAndRewardlView.Name,self.mainActive,1)
        end
    elseif view ~= 0 then
        view:UnDataView(1)
    end
end

function LabourDayFestivalToggleView:OnAward()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LabourDayGameRankAndRewardlView.Name)
    if not view then
        self.views.rankandaward = 0
        if view then
            view:UnDataView(2)
        else
            self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayGameRankAndRewardlView.Name,self.mainActive,2)
        end
    elseif view ~= 0 then
        view:UnDataView(2)
    end
end

---加载界面
function LabourDayFestivalToggleView:OnUIOpened(name)
    ---@type string
    local key
    if name == _G.ConfigManager.ui_cfg.LabourDayFestivalGameView.Name then
        key = "relic"
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    elseif name == _G.ConfigManager.ui_cfg.LabourDayGameRankAndRewardlView.Name then
        key = "rankandaward"
    end
    if not key then 
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)

    local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
    if self:IsNil() then
        view:Close()
        return
    end
    view.transform:SetParentE(self.go_table.obj_view)
    _G.UIManager:GetInstance():ChangeCanvasOrder(
        name,
        self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
    )
    self.views[key] = view
    if (self.curToggle ~= key and key == "relic") and (self.curToggle=="relic" and key ~= "rankandaward") then
        view:Hide()
    end
end

function LabourDayFestivalToggleView:Hide()
    if self.views.relic and self.views.relic ~= 0 then 
        self.views.relic:Hide()
    end
end

function LabourDayFestivalToggleView:Show()
    if self.views.relic and self.views.relic ~= 0 then 
        self.views.relic:Show()
    end
end

function  LabourDayFestivalToggleView:AnimOut(zoomOutCall)
    if self:IsNil() then
        return
    end
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn()
                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn()
                end
        )
    end
end

function LabourDayFestivalToggleView:AnimIn()
    _G.DelayDo(0.1, function()
        local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
        )
        if transforView then
            transforView:Show()
            transforView:SetAction(
                    "zoom_in",
                    function()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                    "zoom_in",
                    function()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        end
    end)
end


---按钮点击事件在这里派发
function LabourDayFestivalToggleView:Close()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    local jumpId = self.mainActive:GetJumpType()
    local mainType = self.mainActive:GetMainType()
    local Activity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10043, jumpId)
    if Activity then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(Activity:GetGameMainViewName())
        if view then
            view:Show()
        end
    end
    self.super.Close(self)
    --关闭内嵌页面
    if self.views then
        for _, view in pairs(self.views) do
            view:Close()
        end
        self.views = nil
    end
end

---按钮点击事件在这里派发
function LabourDayFestivalToggleView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_close then
        if self.curToggle ~= "relic" then 
            self:SwitchToggle("relic")
        else 
            if self.views.relic.inEventViewBol then
                self:AnimOut(function()
                    self:Close()
                end)
            end
        end
    elseif go==self.go_table.aorbtn_exchange then
        ---兑换界面为新的界面
        local jumpId = self.mainActive:GetJumpType()
        local mainType = self.mainActive:GetMainType()
        local exchangeActivity = require "ActivitySynManager":GetInstance():GetChildAcitivity(10048, jumpId)
        exchangeActivity:EnterActivity()
    end
end

return LabourDayFestivalToggleView