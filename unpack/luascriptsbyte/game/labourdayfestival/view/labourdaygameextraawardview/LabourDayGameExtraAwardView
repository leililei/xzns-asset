---@class LabourDayGameExtraAwardView : UIBaseView	赛车小游戏_额外奖励页面
---@field go_table LabourDayGameExtraAwardView_GoTable
---@field activity ActivitySynGMActivity
---@field model LabourDayGameModel
local LabourDayGameExtraAwardView = _G.BaseClass("LabourDayGameExtraAwardView", _G.UIBaseView)

function LabourDayGameExtraAwardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function LabourDayGameExtraAwardView:OnCreate(activity)
    self.activity = activity
    self.model =self.activity.typeClass.model

    self:UpdateView()
end

function LabourDayGameExtraAwardView:OnDestroy()
    self:RemoveAllListener()
end

function LabourDayGameExtraAwardView:UpdateView()
    local extraAward,canGetcouunt = self.model:GetExtraAwardData()
    local isEmpty = canGetcouunt == 0
    self.go_table.obj_has:SetActiveE(isEmpty and 0 or 1)
    self.go_table.obj_empty:SetActiveE(isEmpty and 1 or 0)

    self.go_table.obj_newItem1:ClearChildren()
    for _, v in ipairs(extraAward) do
        local awardT
        if v.type[1] == 0 then
            awardT = { v.type[4], v.type[5] }
        else
            awardT = v.type
        end
        _G.StorageManager:GetInstance():GetItemBaseView(
            awardT[1],
            awardT[2]*canGetcouunt,
            self.go_table.obj_newItem1,
            function(item)
                if _G.IsNil(self.go_table) then
                    _G.DestroyObject(item.go_table.gameObject)
                    return
                end
                item.go_table.gameObject:SetLocalScaleXYZ(0.8)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
            end
        )
    end

    local battlePassActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
        10088,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    ---@type DrawUpBattlePassModel
    local battlePassModel = battlePassActivity and battlePassActivity:GetActivityTypeCls()
    local isBuy = battlePassModel and battlePassModel.isBuy
    self.go_table.aorbtn_comfirm:SetActiveE(isBuy and 1 or 0)
    self.go_table.aorbtn_buy:SetActiveE(isBuy and 0 or 1)
end

---按钮点击事件在这里派发
---@private
function LabourDayGameExtraAwardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_close1 then
        self:Close()
    elseif go == self.go_table.aorbtn_comfirm then
        local extraAward,count = self.model:GetExtraAwardData()
        if not extraAward or count == 0 then
            self:Close()
            return
        end
        self.model:GetAllExtraAward(function(msg)
            self:Close()
        end)
    elseif go == self.go_table.aorbtn_buy then
        local battlePassActivity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(
            10088,
            self.activity:GetJumpType(),
            self.activity:GetMainType()
        )
        if battlePassActivity then
            battlePassActivity:GetActivityTypeCls():OnEnterActivity()
            self:Close()
        end
    end
end

return LabourDayGameExtraAwardView