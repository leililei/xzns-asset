local PersonalRankRewardItem = require("PersonalRankRewardItem")

---@class LabourDayRankAwardItem : PersonalRankRewardItem 联盟排行奖励item
---@field go_table AllianceRewardsBaseView._obj_ActiveDisRewardItem_GoTable
---@field super PersonalRankRewardItem
local LabourDayRankAwardItem = BaseClass("LabourDayRankAwardItem", PersonalRankRewardItem)

local item_cfg_Dict = nil

---@param data arena_rank_cfg
function LabourDayRankAwardItem:RefreshItem(data,index)
    self.rewardList = self:GetShowCfgRewardList(data)
    LabourDayRankAwardItem.super.RefreshItem(self,data,index)

    self.isLoadTitle = false
    self:LoadTitle()
end

function LabourDayRankAwardItem:LoadTitle()
    if self.isLoadTitle then
        return
    end
    self.isLoadTitle = true
    self.go_table.obj_TitleNode:RemoveAllChildren()

    self.reward_appearance = self.data.rewards
    if self.reward_appearance and self.reward_appearance[1] then
        local AppearanceType = {}
        local type, storageId
        local data
        for i = 1, #self.reward_appearance do
            data=_G.StorageManager:GetInstance():GetItemDataClassByCfg(self.reward_appearance[i])
            type, storageId = _G.StorageManager:GetInstance():CheckSidType(self.reward_appearance[i][1])
            if storageId == _G.StorageID.Prop and data.cfg.Type1==7 then
                AppearanceType=self.reward_appearance[i]
                break
            end
        end
        if AppearanceType and data.cfg.UseType==13 then
            --称号
            local player_frame = _G.ConfigManager.player_title_effect_cfg[tonumber(data.cfg.UseParameter[1][1])]
            self.go_table.obj_TitleNode:RemoveAllChildren()
            if player_frame then
                _G.UIUtils.LoadEffectTitleOrFrame(
                        player_frame.title,
                        self.go_table.obj_TitleNode,
                        function(trans)
                            trans:SetLocalScaleXYZ(1)
                            self.isLoadTitle = false
                        end
                )
            end
        elseif AppearanceType[1] == 14 then
            --光环

        end
    end
end

function LabourDayRankAwardItem:GetRewardData(index)
    return self.rewardList[index]
end

function LabourDayRankAwardItem:GetRewardList()
    return self.rewardList
end

---@param cfg arena_rank_cfg
function LabourDayRankAwardItem:GetShowCfgRewardList(cfg)
    local awardsTit = {}
    local awards = {}
    local type, sid
    if not _G.table.isEmptyOrNil(cfg.reward_appearance) then
        if item_cfg_Dict == nil then
            item_cfg_Dict = {}
            for _, item in pairs(_G.ConfigManager.item_cfg) do
                if item.UseType and item.UseParameter and #item.UseParameter > 0 then
                    local key = item.UseParameter[1] and item.UseParameter[1][1]
                    if key then
                        if item_cfg_Dict[item.UseType] == nil then
                            item_cfg_Dict[item.UseType] = {}
                        end
                        if item_cfg_Dict[item.UseType][key] == nil then
                            item_cfg_Dict[item.UseType][key] = {}
                        end
                        item_cfg_Dict[item.UseType][key] = item
                    end
                end
            end
        end
        for _, eff in pairs(cfg.reward_appearance) do
            type = eff[1]
            sid = _G.tostring(eff[2])
            local item = item_cfg_Dict[type][sid]
            if type then
                _G.table.insert(awardsTit, {item.ID, 1})
                break
            end
        end
    end
    for _, a in pairs(cfg.rewards) do
        _G.table.insert(awards, a)
    end

    table.sort(awards,function(a,b)
        local aQuality = StorageManager:GetInstance():GetItemQuality(a[1])
        local bQuality = StorageManager:GetInstance():GetItemQuality(b[1])
        if aQuality and bQuality then
            if aQuality == bQuality then
                return a[1] < b[1]
            end
            return aQuality > bQuality
        else
            return a[1] < b[1]
        end
    end)
    local count = #awards
    for i = 1, count do
        table.insert(awardsTit,awards[i])
    end

    return awardsTit
end


---@return LabourDayRankAwardItem
return LabourDayRankAwardItem