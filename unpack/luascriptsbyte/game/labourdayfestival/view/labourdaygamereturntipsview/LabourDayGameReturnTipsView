---@class LabourDayGameReturnTipsView : UIBaseView	赛车小游戏_额外奖励页面
---@field go_table LabourDayGameReturnTipsView_GoTable
---@field activity ActivitySynGMActivity
---@field model LabourDayGameModel
local LabourDayGameReturnTipsView = _G.BaseClass("LabourDayGameReturnTipsView", _G.UIBaseView)

function LabourDayGameReturnTipsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function LabourDayGameReturnTipsView:OnCreate(callback,istrue)
    self.callback=callback
    self.isTrue = istrue 
    self.go_table.toggle_tips.isOn = false
end

---按钮点击事件在这里派发
---@private
function LabourDayGameReturnTipsView:OnClickBtn(go,isOn)
    if go == self.go_table.aorbtn_close2 then
        self:Close()
    elseif go == self.go_table.aorbtn_cancel then
        if self.callback then
            self.callback(false,self.go_table.toggle_tips.isOn)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_sure then
        if self.callback then
            self.callback(true,self.go_table.toggle_tips.isOn)
        end
        self:Close()
    end
end

return LabourDayGameReturnTipsView