    local activity1 = require "ActivitySynManager":GetInstance():GetChildAcitivity(10027, self.activity:GetJumpType(self.activityID), mainType)
    if activity1 then
        self.go_table.obj_redpointbaodian:UpdateRedPointItemIDAndParam(
                activity1:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )

        self.go_table.aorbtn_baodian:SetActiveE(1)
    else
        self.go_table.aorbtn_baodian:SetActiveE(0)
    end
end

function LabourDayDrawCardView:OnClickBtn(go)
    if go == self.go_table.aorbtn_gift then
        --任务
        if JointActivityDrawUpModel.InDrawing then
            return
        end
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10014, self.activity:GetJumpType(self.ActivityID), false, mainType)
    elseif go == self.go_table.aorbtn_baodian then
        --战令
        if JointActivityDrawUpModel:GetInstance().InDrawing then
            return
        end
        local mainType = self.activity.cfg.info.front.main_type
        _G.GlobalInterface.JumpActivityByGM(10027, self.activity:GetJumpType(self.ActivityID), false, mainType)
    else
        TreasureBlissView.OnClickBtn(self, go)
    end
end

function LabourDayDrawCardView:OnRefreshLoopListItem(i, item)
    TreasureBlissView.OnRefreshLoopListItem(self,i, item)
    local eIndex = i + 1
    local side = eIndex % 2
    if side == 0 then
        side = 2
    end
    local id = item:GetInstanceIDE()
    local ctrl = self.rewardItemList[id]
    local go_table = ctrl
    local num = self.rewardsCount[eIndex]
    go_table.aortext_numDraw.text = _G.GetLangPackValue(90025500020, num)
end

function LabourDayDrawCardView:GetSelectWishData()
    ---@type JointActivityDrawUpMainData
    local data = JointActivityDrawUpModel:GetInstance().activityList[self.activityID]
    return data.wish_prop2
end

function LabourDayDrawCardView:SetWishAward()
    TreasureBlissView.SetWishAward(self)
    local wishData = JointActivityDrawUpModel:GetInstance():GetWishProp(self.activityID)
    local name = StorageManager:GetInstance():GetItemName(wishData[1])
    self.go_table.aortext_rewardName.text = name
end

function LabourDayDrawCardView:LoadConsumesInfos()
    TreasureBlissView.LoadConsumesInfos(self)
    local isUseDiamode = false
    local leftIcon, leftNum, rightNum, rightIcon
    rightNum = 1
    ---获取代币数量
    local coinNum = JointActivityDrawUpModel:GetInstance():GetPropNum(self.activityID)
    ---获取魂玉召唤次数
    local totalTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTotalTimes(self.activityID)
    local usedTimes = JointActivityDrawUpModel:GetInstance():GetDiamondTimes(self.activityID)
    local remainTimes = totalTimes - usedTimes

    ---单抽
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 1 then
        leftNum = 1
        leftIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        leftNum = JointActivityDrawUpModel:GetInstance():GetDiamondConsume(self.activityID, 1)
        leftIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)

        isUseDiamode = true
    end
    if coinNum >= 1 or totalTimes == 0 or remainTimes < 10 then
        if coinNum >= 10 then
            rightNum = 10
        else
            rightNum = coinNum > 0 and coinNum or 10
        end
        rightIcon = self:getCurrencyTypeIcon(self.coinId)
    else
        rightNum = JointActivityDrawUpModel:GetInstance():GetDiamondConsume(self.activityID, 10)
        rightIcon = _G.StorageManager:GetInstance():GetItemIcon(_G.ResPropID.Diamond)
        isUseDiamode = true
    end

    if isUseDiamode then
        self.drawConsumeType = _G.DrawConsumeType.diamond
        self.go_table.aortext_PropRight.text =
        _G.GetLangPackValue(90022500377)
    else
        self.drawConsumeType = _G.DrawConsumeType.token
        self.go_table.aortext_PropRight.text =
        _G.GetLangPackValue(90000011229, _G.GameUtil.NumberToWordByLanguage(rightNum))
    end
end


return LabourDayDrawCardView