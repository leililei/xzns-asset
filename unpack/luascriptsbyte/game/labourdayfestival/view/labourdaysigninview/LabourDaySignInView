local base = require("EasterSignInView")
local LabourDayUtils = require("LabourDayUtils")

---@class LabourDaySignInView:EasterSignInView
---@field go_table LabourDaySignInView_GoTable
local LabourDaySignInView = BaseClass("LabourDaySignInView",base)

function LabourDaySignInView:InitView()
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.RefreshItem))
    ---@type LabourDaySignInView._obj_itemDown_GoTable
    self.lastRewardItem = GetAutoGoTable(self.go_table.obj_itemDown,handlerbind(self, self.OnClickItemAward, self.count))
    base.InitView(self)
end

function LabourDaySignInView:RefreshItem(index,obj)
    local newIndex = index + 1
    self:SetItem(newIndex,GetAutoGoTable(obj))
end

function LabourDaySignInView:RefreshView()
    -- 根据剩余签到天数，修改界面页签数量
    --local count = self.count - (self.page - 1) * 7

    if self.page == 1 then
        self.go_table.aorbtn_qiehuan1:SetActiveE(0)
    else
        self.go_table.aorbtn_qiehuan1:SetActiveE(1)
    end

    if self.page == self.maxPage then
        self.go_table.aorbtn_qiehuan2:SetActiveE(0)
    else
        self.go_table.aorbtn_qiehuan2:SetActiveE(1)
    end

    self.go_table.scrollloopvectical_list:UpdateCount(self.count - 1)
    --self.go_table.scrollloopvectical_list:UpdateAllItem()
    self:SetItem(self.count,self.lastRewardItem)
    self.lastRewardItem.obj_noGet:SetActiveE(0)
    local data = self.model.item[self.count].award[2]
    local isGou = false
    if self.model:CheckSignId(self.count) then
        isGou = true
    end
    self.lastRewardItem.obj_awards2:RemoveAllChildren()
    LabourDayUtils.LoadItemBase(self,self.count,data,self.lastRewardItem.obj_awards2,function(item)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(item.gameObject)
            return
        end
        item.gameObject:SetLocalScaleXYZ(0.8)
        item:ShowEffect(not isGou and self.count <= self.signInDays)
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGou(isGou)
    end)
end

---@param go LabourDaySignInView._obj_item_GoTable
function LabourDaySignInView:SetItem(index, go)
    local count = index

    --- 是否已经领取
    local isGou = false
    if self.model:CheckSignId(count) then
        isGou = true
    end
    go.aortext_title.text = index
    -- 根据是否能够领取进行设置
    if count <= self.signInDays and not isGou then
        -- 可领取
        go.aorbtn_getAward:SetActiveE(1)
        go.obj_got:SetActiveE(1)
        go.obj_get:SetActiveE(0)
        go.obj_noGet:SetActiveE(0)
        go.obj_redpoint:SetActiveE(1)
        go.aorbtn_getAward.onClick:RemoveAllListeners()
        go.aorbtn_getAward.onClick:AddListener(_G.handlerbind(self, self.OnClickItemAward, index, go))
    elseif isGou then
        -- 已经领取
        go.obj_get:SetActiveE(1)
        go.aorbtn_getAward:SetActiveE(0)
        go.obj_got:SetActiveE(1)
        go.obj_noGet:SetActiveE(0)
        go.obj_redpoint:SetActiveE(0)
    else
        -- 不可领取(没到时间)
        go.obj_get:SetActiveE(0)
        go.aorbtn_getAward:SetActiveE(0)
        go.obj_got:SetActiveE(0)
        go.obj_noGet:SetActiveE(1)
        go.obj_redpoint:SetActiveE(0)
    end

    -- 创建奖励item
    -- 获取奖励数据
    local data = self.model:GetSignItem(count)
    local sid = data[1] == 0 and data[4] or data[1]
    local num = data[1] == 0 and data[5] or data[2]
    if not self.awardItemList[index] then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
                {sid, num},
                go.obj_awards,
                function(item)
                    if _G.IsNil(go.obj_awards) then
                        _G.DestroyObject(item.gameObject)
                        return
                    end
                    self.awardItemList[index] = item
                    item.gameObject:SetLocalScaleXYZ(0.8)
                    item:ShowEffect(not isGou and count <= self.signInDays)
                    if item.ShowNumText then
                        item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                    end
                    item:SetGou(isGou)
                end,
                function(go, isOn)
                    require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1] > 0 and data[1] or data[4] )
                end
        )
    else
        local item = self.awardItemList[index]
        local sid = data[1] > 0 and data[1] or data[4]
        local info = _G.StorageManager:GetInstance():GetItemDataClass(sid, data[1] > 0 and data[2] or data[5], {})
        item:UpdateData(item.gameObject, info)
        item:UpdateFunction()
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGou(isGou)
        item:ShowEffect(not isGou and count <= self.signInDays)
    end
end



return LabourDaySignInView