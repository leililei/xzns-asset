local ActivitySynManager = require "ActivitySynManager"
---@class LabourDayFestivalMainView : UIBaseView	新春活动主界面
---@field go_table LabourDayFestivalMainView_GoTable
local LabourDayFestivalMainView = _G.BaseClass("LabourDayFestivalMainView", _G.UIBaseView)
--灯笼入口
local activityItemCfg = {
    [1] = {--鸿运冲刺
        name = 90034800134,
        jumpType = 10044,
        period = 1
    },
    [2] = {
        name = 92010600005,
        jumpType = 10095,
        period = 1
    }
}
--按钮入口
local activityBtnCfg = {
    [1] = {--签到
        name = 90034800131,
        jumpType = 10010,
        period = 3
    },
    [2] = {--七日连充
        name = 90034800132,
        jumpType = 10094,
        period = 3
    },
    [3] = {--兑换
        name = 90034800133,
        jumpType = 10048,
        period = 3
    }
}

function LabourDayFestivalMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSixUpdate.SixClockUpdate, _G.handler(self, self.InitActivityItem))
end

function LabourDayFestivalMainView:OnCreate(activity)
    self.activityId = activity:GetActivityID()
    self.activity = activity
    self.jumpType = self.activity:GetJumpType(self.activityId)
    self:InitView()
end

---初始化界面
function LabourDayFestivalMainView:InitView()
    self:InitActivityTime()
    self:InitActivityItem()
    self:InitEffect()
end

function LabourDayFestivalMainView:InitActivityTime()
    local startT, _ = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Open)
    local endT, _ = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    local startTime = _G.TimeUtil.GetDateTime(startT)
    local endTime = _G.TimeUtil.GetDateTime(endT)
    local str = startTime.month .. "." .. startTime.day .. "~" .. endTime.month .. "." .. endTime.day
    self.go_table.aortext_Time.text = _G.GetLangPackValue(90025800003, str)
    self.curPeriod = (_G.TimeUtil.GetServerUnixTime() - startT) > (86400 * 7) and 2 or 1
    if (_G.TimeUtil.GetServerUnixTime() - startT) > (86400 * 14) then
        self.curPeriod = 3--兑换期
    end
end

function LabourDayFestivalMainView:InitActivityItem()
    if not self.activityItemList then
        self.activityItemList = {}
    end
    for k, _ in pairs(activityItemCfg) do
        self:RefreshActivityItem(k, self.go_table["obj_ActivityItem" .. k])
    end
    for k, _ in pairs(activityBtnCfg) do
        self:RefreshActivityBtn(k, self.go_table["obj_ActivityBtn" .. k])
    end
end

function LabourDayFestivalMainView:InitEffect()
    _G.UIUtils.LoadEffectByPath(
    "UIH5/UI_effect/mijingyouzong_effect/ef_mijingyouzong_main",
        self.go_table.obj_Eff,
        function(trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
        end,
        nil,
        0,
        nil,
        nil,
        nil,
        true
    )
end

function LabourDayFestivalMainView:RefreshActivityItem(index, obj)
    local tb = self.activityItemList[index]
    local data = activityItemCfg[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickActivity, index))
        self.activityItemList[index] = tb
    end
    self:RefreshActivityInfo(tb, data)
end

function LabourDayFestivalMainView:RefreshActivityBtn(index, obj)
    local tb = self.activityItemList[index + #activityItemCfg]
    local data = activityBtnCfg[index]
    if not tb then
        tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickActivity, index + #activityItemCfg))
        self.activityItemList[index + #activityItemCfg] = tb
    end
    self:RefreshActivityInfo(tb, data)
end

function LabourDayFestivalMainView:RefreshActivityInfo(tb, data)
    tb.interValDay = 0
    tb.tipContent = nil
    tb.jumpType = data.jumpType
    tb.period = data.period
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(data.jumpType,
            self.activity:GetJumpType(self.activityId))
    tb.aortext_Name.text = _G.GetLangPackValue(data.name)
    if tb.aortext_LockName then
        tb.aortext_LockName.text = _G.GetLangPackValue(data.name)
    end
    
    if activity then
        tb.obj_redpoint:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        if tb.obj_Lock then
            tb.obj_Lock:SetActiveE(0)
            tb.obj_Unlock:SetActiveE(1)
        end
    else
        tb.obj_redpoint:SetActiveE(0)
        activity = ActivitySynManager:GetInstance():GetNotOpenAcitivity(data.jumpType,
                self.activity:GetJumpType(self.activityId))
        if activity then
            local isPass, content = self:CheckConditionPatams(activity.info)
            if not isPass then
                tb.tipContent = content
            else
                tb.interValDay = _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(),
                        activity.time.start_time)
            end
        end
        if tb.obj_Lock then
            tb.obj_Lock:SetActiveE(1)
            tb.obj_Unlock:SetActiveE(0)
        else
            --tb.gameObject:SetActiveE(0)
        end
    end
end

function LabourDayFestivalMainView:CheckConditionPatams(params)
    params = params.front
    if not params then
        return true
    end
    params = params.con
    if not params then
        return true
    end
    for i = 1, #params do
        local isPass, _, content = _G.GlobalConditionManager.CheckConditionArrays(
                { { params[i].type, params[i].value, params[i].list } }
        )
        if not isPass then
            return false, content
        end
    end
    return true
end

function LabourDayFestivalMainView:OnCloseActivity(id)
    if id == self.activityId then
        self:Close()
    end
end

function LabourDayFestivalMainView:OnClickActivity(_, _, index)
    local tb = self.activityItemList[index]
    if not tb then
        return
    end
    if tb.jumpType and tb.jumpType == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(280104)
        return
    end
    if tb.tipContent then
        _G.PopWindowManager:GetInstance():ShowAllTips(1515, tb.tipContent)
        return
    end
    if tb.interValDay > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
                1515,
                nil,
                nil,
                nil,
                nil,
                nil,
                tb.interValDay
        )
        return
    end
    local activity = require("ActivitySynManager"):GetInstance():GetChildAcitivity(tb.jumpType, self.jumpType)
    if not activity then
        if tb.period > self.curPeriod then
            _G.PopWindowManager:GetInstance():ShowAllTips(1, _G.GetLangPackValue(92010600034))
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(650104)
        end
        return
    end
    if tb.jumpType==10095 then
        self:AnimOut(function()
            _G.GlobalInterface.JumpActivityByGM(tb.jumpType, self.jumpType) 
        end)
    else
        _G.GlobalInterface.JumpActivityByGM(tb.jumpType, self.jumpType)
    end
end

function LabourDayFestivalMainView:AnimOut(zoomOutCall)
    if self:IsNil() then
        return
    end
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn()
                end
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                "zoom_out",
                function()
                    if zoomOutCall then
                        zoomOutCall()
                    end
                    self:AnimIn()
                end
        )
    end
end

function LabourDayFestivalMainView:AnimIn()
    _G.DelayDo(0.1, function()
        local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
        )
        if transforView then
            transforView:Show()
            transforView:SetAction(
                    "zoom_in",
                    function()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        else
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
                    "zoom_in",
                    function()
                        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name)
                    end
            )
        end
    end)
end


---按钮点击事件
function LabourDayFestivalMainView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_Close" then
        self:Close()
    end
end

function LabourDayFestivalMainView:OnDestroy()
    self:RemoveListener(_G.eSixUpdate.SixClockUpdate, _G.handler(self, self.InitActivityItem))
end

return LabourDayFestivalMainView