
local base = require("BaseGameNet")

---@class LabourDayGameNet : BaseGameNet	通信协议
local LabourDayGameNet = _G.BaseClass("LabourDayGameNet", base)
---@return LabourDayGameNet LabourDayGameNet
function LabourDayGameNet:GetInstance()
    return base.GetInstance(self)
end

---下一个事件
---@param pbData table PB数据
---@param callback function 完成回调
function LabourDayGameNet:NextEvent(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_secret_trail_next_event
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---完成事件
---@param pbData table PB数据
---@param callback function 完成回调
function LabourDayGameNet:ComplateEvent(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_secret_trail_finish_event
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---获取参与服务器列表
---@param pbData table PB数据
---@param callback function 完成回调
function LabourDayGameNet:GetServeList(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_secret_trail_server_list
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
