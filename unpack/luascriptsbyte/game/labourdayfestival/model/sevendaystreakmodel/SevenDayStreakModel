---检查红点
function SevenDayStreakModel:CheckRedPoint()
    for i = 1, #self.dayData do
        if self:GetRewardState(i) == LabourDayUtils.RewardState.CanGet then
            return 1
        end
    end
    if self:GetRewardState_Week() == LabourDayUtils.RewardState.CanGet then
        return 1
    end
    local time = _G.PlayerPrefsManager.GetString("_SevenDayStreakModel_Login")
    time = tonumber(time)
    if  _G.string.IsNullOrEmpty(time) then
        return 1
    else
        local timeNormal = TimeUtil.GetDayBegin(time)
        local norTime = TimeUtil.GetServerUnixTime()
        local nowNormal =  TimeUtil.GetDayBegin(norTime)
        if timeNormal ~= nowNormal then
            return 1
        end
    end
    return 0
end

---@return LabourDayUtils.RewardState
function SevenDayStreakModel:GetRewardState(index)
    local data = self.dayData[index]
    if self.receivedDict[data.sid] then
        return LabourDayUtils.RewardState.Received
    end

    if self.rechargeDict[index] and self.rechargeDict[index] >= data.need_cash then
        return LabourDayUtils.RewardState.CanGet
    else
        if index > self.curDay then
            return LabourDayUtils.RewardState.Gray
        elseif index < self.curDay then
            return LabourDayUtils.RewardState.Signature
        end
        return LabourDayUtils.RewardState.NotGet
    end
end

function SevenDayStreakModel:GetRewardState_Week()
    if self.big_award == 1 then
        return LabourDayUtils.RewardState.Received
    end

    if self.rechargeDay >= #self.dayData then
        return LabourDayUtils.RewardState.CanGet
    else
        return LabourDayUtils.RewardState.NotGet
    end
end

function SevenDayStreakModel:IsGray(day)
    if day > self.curDay then
        return true
    end
    return false
end

