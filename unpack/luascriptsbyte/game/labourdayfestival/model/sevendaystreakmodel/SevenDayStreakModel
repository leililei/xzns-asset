local base = require("ActivitySynTypeBase")
local LabourDayUtils = require("LabourDayUtils")
local SevenDayStreakNet = require("SevenDayStreakNet")
local SDKDef = require("SDKDef")

---@class SevenDayStreakModel: ActivitySynTypeBase 七日连充
local SevenDayStreakModel = BaseClass("SevenDayStreakModel", base)

function SevenDayStreakModel:__init()
    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
    _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.pay_failed, self.OnPay_failed, self)
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.AddDay, self)
end

function SevenDayStreakModel:OnHandleGMData(data)
    self:SetSelfInfo(data.day_continue_cash)
    base.ParseData(self)
end

function SevenDayStreakModel:AddDay()
    self.curDay = self.curDay + 1
    if self.curDay > 7 then
        self.curDay = 7
    end
end

function SevenDayStreakModel:OnMallCashListener(msg)
    if self.rechargeDict[self.curDay] == nil then
        self.rechargeDict[self.curDay] = msg.cash_rmb
    else
        self.rechargeDict[self.curDay] = self.rechargeDict[self.curDay] + msg.cash_rmb
    end

    self:RefreshRechargeDay()
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
    if self.buyBack then
        self.buyBack(msg)
        self.buyBack = nil
    end
end

function SevenDayStreakModel:OnPay_failed()
    self.buyBack = nil
end

function SevenDayStreakModel:RefreshRechargeDict()
    ---@type table<number,number> 天数,金额
    self.rechargeDict = {}
    if self.cash_list == nil then
        return
    end
    for i = 1, #self.cash_list do
        self.rechargeDict[self.cash_list[i].key] = self.cash_list[i].value
    end
    self:RefreshRechargeDay()
end

function SevenDayStreakModel:RefreshRechargeDay()
    self.rechargeDay = 0
    for i = 1, #self.dayData do
        local state = self:GetRewardState(i)
        if state == LabourDayUtils.RewardState.Received or state == LabourDayUtils.RewardState.CanGet then
            self.rechargeDay = self.rechargeDay + 1
        else
            break
        end
    end
end

---@param data activity_day_continue_cash.i_activity_day_continue_cash
function SevenDayStreakModel:SetSelfInfo(data)
    self.cash_list = data.cash_list --充值金额[{day,cash_num}]
    self.award_sids = data.award_sids or {} --已领取奖励sid列表
    self.big_award = data.big_award  --是否领取最终奖励
    self.gm_cfg = data.gm_cfg  --GM配置

    --连续充值天数
    self.rechargeDay = 0
    ---@type activity_day_continue_cash.i_day_award[]
    self.dayData = {}
    self.targetData = data.gm_cfg.reward
    for i = 1, #data.gm_cfg.award_list do
        self.dayData[i] = data.gm_cfg.award_list[i]
    end
    ---@type table<number,boolean> 已领取字典
    self.receivedDict = {}
    if data.award_sids then
        for i = 1, #data.award_sids do
            self.receivedDict[data.award_sids[i]] = true
        end
    end

    self.curDay = 0
    local stratTime = self.curActivityClass.cfg.time.start_time
    local notTime = TimeUtil.GetServerUnixTime()
    local left = notTime - stratTime
    self.curDay  = math.ceil(left/86400)
    self:RefreshRechargeDict()
    _G.Events:GetInstance():Broadcast(_G.eGMBigChallenge.UpdateView)
    require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end


