--发送领取请求
function SevenDayStreakModel:Send_GetReward(sid,call)
    SevenDayStreakNet:GetInstance():Access(_G.ConfigManager.net_map.game_activity_seventday_get_award,{
        id = self.curActivityClass.activityID,
        prams = {sid},
    },function(msg)
        if msg.ack ~= 1 then
            return
        end

        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonAwardView.Name,msg)
        self.receivedDict[sid] = true
        if sid == 0 then
            self.big_award = 1
        end
        require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
        if call then
            call()
        end
    end)
end

function SevenDayStreakModel:GetCurDayIsComp()
    local state = self:GetRewardState(self.curDay)
    if state == LabourDayUtils.RewardState.Received or state == LabourDayUtils.RewardState.CanGet then
        return true
    end
    return false
end

