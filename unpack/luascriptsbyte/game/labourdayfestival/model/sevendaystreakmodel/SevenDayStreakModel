    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.pay_failed, self.OnPay_failed, self)
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.AddDay, self)
    base.Dispose(self)
end

return SevenDayStreakModel