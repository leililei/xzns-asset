    end
    self.buyBack = function(msg)
        --msg.cash_rmb
        --self.rechargeDict[data.day] = data.need_cash
        --self.rechargeDay = self.rechargeDay + 1

        local pbdata = {}
        pbdata.award = {}
        ---@type award.i_award_item[]
        pbdata.award.item = data.reward

        --_G.StorageManager:GetInstance():ReceiveAwardData(pbdata)
        --UIManager:GetInstance():OpenWindow(ConfigManager.ui_cfg.CommonAwardView.Name,pbdata)
        self.receivedDict[data.sid] = true
        self:RefreshRechargeDay()
        require "RedPointManager":GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
