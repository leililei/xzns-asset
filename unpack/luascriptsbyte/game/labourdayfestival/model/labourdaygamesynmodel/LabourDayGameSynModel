local base = require("ActivitySynTypeBase")
---@class LabourDayGameSynModel : ActivitySynTypeBase	中文描述
---@field curActivityClass ActivitySynBase
---@field model LabourDayGameModel
local LabourDayGameSynModel = _G.BaseClass("LabourDayGameSynModel",base)
local ActivitySynManager = require("ActivitySynManager")
---类的构造函数
function LabourDayGameSynModel:__init()
    self.model = require("LabourDayGameModel"):GetInstance()
    self.curActivityClass:AddStateChanged(_G.handler(self, self.OnActivityStateChanged), self)
end

function LabourDayGameSynModel:GetDataFormServer()
    base.ParseData(self)
end

function LabourDayGameSynModel:OnHandleGMData()
    self.model:GetInfoCall(self.curActivityClass)
    if not table.isEmptyOrNil(self.curActivityClass.cfg.self_info.secret_trail.coin_list) then
        self.CoinNum=self.curActivityClass.cfg.self_info.secret_trail.coin_list[1].value
    end
    base.ParseData(self)
end

function LabourDayGameSynModel:GetOtherActivityRedPointIds()
    return {10088,10007,10014,10048}
end
function LabourDayGameSynModel:InitRedPointTree()
    self.checkRedPointFunc = {nil,self.CheckHasCoinOrEvent,self.CanGetGoAward,self.CanGetExtraAward}
    self.redpointTree = {{2,3,4},false,false,false}
end

function LabourDayGameSynModel:CheckRedPointNumChild(index,param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self,param)
    end
    return 0
end
function LabourDayGameSynModel:CheckHasCoinOrEvent()
    return  self.model:CheckHasCoinOrEvent()
end

function LabourDayGameSynModel:CanGetGoAward()
    return  self.model:CanGetGoAward()
end

function LabourDayGameSynModel:CanGetExtraAward()
    return  self.model:CanGetExtraAward()
end

---进入活动主体
function LabourDayGameSynModel:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LabourDayFestivalToggleView.Name,self.curActivityClass,1)
end
function LabourDayGameSynModel:OnActivityStateChanged(_, state)
    if state == ActivitySynManager:GetInstance().State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.LabourDayFestivalToggleView.Name)
        if view then
            view:Close()
        end
        --活动已关闭
        _G.PopWindowManager:GetInstance():ShowAllTips(930101)
    end
end
---增加门票
function LabourDayGameSynModel:AddCoin(num)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(self:GetRedpointIDByIndex(2))
    if self.CoinNum then
        self.CoinNum=self.CoinNum+num
    else
        self.CoinNum=num
    end
    
end

---获取当前代币数量
---@return number
function LabourDayGameSynModel:GetCoinNumber()
    return self.CoinNum or 0
end


return LabourDayGameSynModel