local BountyDispatchQuest = require "BountyDispatchQuest"
---@class BountyDispatchView : UIBaseView	一键派遣界面
---@field public go_table BountyDispatchView_GoTable GoTable
---@field TaskList BountyQuestData[] 任务列表
local BountyDispatchView = _G.BaseClass("BountyDispatchView", _G.UIBaseView)
--_G.BountyDispatchView = BountyDispatchView

local color = _G.Color(1, 1, 1, 0.5)
function BountyDispatchView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data BountyQuestData[] 需要派遣的任务
function BountyDispatchView:OnCreate(data, callback)
    self.TaskList = _G.table.toArray(data)
    require("BountySystemManager"):GetInstance():SortEvilTask(self.TaskList)
    self.TaskItems = {}
    self.ChooseItems = {}
    self.ChooseItems.Count = 0
    self.go_table.aorbtn_startBtn.targetGraphic.color = color
    self:AddAllTask()
    self.go_table.scrollloopvectical_QuestList:InitItemData(
        require("BountySystemManager"):GetInstance().isDefult and 1 or #self.TaskList,
        _G.handler(self, self.InitTaskList)
    )
    self.callback = callback
end

---初始化任务列表
function BountyDispatchView:InitTaskList(index, obj)
    index = index + 1
    local instanceID = obj:GetInstanceIDE()
    if not self.TaskItems[instanceID] then
        self.TaskItems[instanceID] = BountyDispatchQuest.CreateItem(obj, _G.handler(self, self.AddTask))
    end
    self.TaskItems[instanceID]:InitData(self.TaskList[index])
end

function BountyDispatchView:AddAllTask()
    self.ChooseItems.Count = #self.TaskList
    if require("BountySystemManager"):GetInstance().isDefult then
        self.ChooseItems.Count = 1
    end
    for i = 1, self.ChooseItems.Count do
        self.TaskList[i].isChoose = true
        self.ChooseItems[self.TaskList[i].mission.sid] = self.TaskList[i]
    end
    self.go_table.aorbtn_startBtn.targetGraphic.color = _G.Color.white
end

---添加选中的任务
---@param data BountyQuestData
function BountyDispatchView:AddTask(data, isAdd)
    if isAdd then
        self.ChooseItems[data.mission.sid] = data
        self.ChooseItems.Count = self.ChooseItems.Count + 1
    else
        self.ChooseItems[data.mission.sid] = nil
        self.ChooseItems.Count = self.ChooseItems.Count - 1
    end
    if self.ChooseItems.Count > 0 and self.go_table.aorbtn_startBtn.targetGraphic.color.a == color.a then
        self.go_table.aorbtn_startBtn.targetGraphic.color = _G.Color.white
    elseif self.ChooseItems.Count == 0 then
        self.go_table.aorbtn_startBtn.targetGraphic.color = color
    end
end

---按钮点击事件在这里派发
function BountyDispatchView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_closeBtn" then
        self:Close()
    elseif name == "@_aorbtn_anyClose" then
        self:Close()
    elseif name == "@_aorbtn_startBtn" then
        if self.go_table.aorbtn_startBtn.targetGraphic.color.a == color.a then
            _G.PopWindowManager:GetInstance():ShowAllTips(350105)
        else
            if self.callback then
                self.ChooseItems.Count = nil
                self.callback(self.ChooseItems)
            end
            self:Close()
        end
    end
end

function BountyDispatchView:EscClose()
    self:Close()
end

return BountyDispatchView
