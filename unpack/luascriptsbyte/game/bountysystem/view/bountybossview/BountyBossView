---获取符合条件的卡牌
---@return CardData
function BountyBossView:GetRequireCards()
    local Cards = {}
    local limitCard = require("BountySystemManager"):GetInstance():GetIdleCardsNoLimit()

    Cards[0] = limitCard
    local count = #limitCard
    for i = 1, count do
        if not Cards[limitCard[i].cfg.Elements] then
            Cards[limitCard[i].cfg.Elements] = {}
        end
        limitCard[i].isHave = true
        _G.table.insert(Cards[limitCard[i].cfg.Elements], limitCard[i])
    end
    return Cards
end

