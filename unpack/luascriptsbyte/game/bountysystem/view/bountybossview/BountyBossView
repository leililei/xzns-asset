---点击下部的卡牌
---@param data CardData
function BountyBossView:ClickDownCard(data)
    if self:CheckCardChoose(data.uid) > 0 then
        self:RemoveCard(data)
    else
        self:AddCard(data)
    end
end

---接受boss任务
function BountyBossView:OnStart()
    local cards = {}
    for i = 1, #self.MidCardItems do
        if self.MidCardItems[i].CardData == nil then
            break
        end
        cards[#cards + 1] = self.MidCardItems[i].CardData.uid
    end
    if #cards >= 10 and self.power >= self.cfg.power[1][2] then
        require("BountySystemManager"):GetInstance():AcceptBossTask(
            cards,
            _G.handler(self, self.AcceptBossTaskCall),
            self.power
        )
    else
        if #cards < 10 then
            _G.PopWindowManager:GetInstance():ShowAllTips(350109, _G.LangUtil.GetLangPackValue(90021700033))
            return
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(350113)
    end
end

---接受boss任务回调
---@param msg dispatch.s2c_dispatch_accept_boss
function BountyBossView:AcceptBossTaskCall(msg)
    _G.StorageManager:GetInstance():ConsumeItem(52, nil, self.cfg.points_boss)
    if self.callback then
        self.callback()
    end
    self:Close()
end

---一键派遣
function BountyBossView:OnDispathAll()
    if #self.RequirdCards[0] < self.cfg.condition[1] then
        _G.PopWindowManager:GetInstance():ShowAllTips(350101)
        return
    end
    local index = 1
    for i = 1, #self.MidCardItems do
        if self.MidCardItems[i].CardData then
            self.ChooseCardList[self.MidCardItems[i].CardData.uid] = nil
        end

        self.MidCardItems[i].CardData = nil
    end
    for _, v in ipairs(self.RequirdCards[0]) do
        if index > 10 then
            break
        end
        self:AddCard(v)
        index = index + 1
    end
end

function BountyBossView:CloseView()
    self:Close()
end

---按钮点击事件在这里派发
function BountyBossView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_close" then
        self:Close()
    elseif name == "@_aorbtn_Auto" then
        self:OnDispathAll()
    elseif name == "@_aorbtn_Start" then
        self:OnStart()
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    end
end
---更新玩家阵容
function BountyBossView:UpdatePlayerPower()
    if not self.Player then
        self.Player = _G.GetAutoGoTable(self.go_table.obj_node0)
    end
    self.power = self:GetPower()
    self.Player.aortext_power.text = _G.GameUtil.NumberToUnitStrFight(self.power)
    self:UpdateNode(self.power)
    if self.power > self.cfg.power[1][2] and _G.table.count(self.ChooseCardList) >= 10 then
        self.go_table.aortext_btntxt.color = _G.ColorTools.FormatColorByString("914801")
        self.go_table.aorbtn_Start:SetGray(false)
        self.go_table.aorbtn_Start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("FFFFFF")
    end
end

function BountyBossView:GetPower()
    local power = 0
    for _, v in pairs(self.MidCardItems) do
        if v.CardData then
            power = power + v.CardData.power
        end
    end
    return power
end

function BountyBossView:UpdateNode(power)
    local slider = 0
    local isEnd = false
    for i = 1, 5 do
        if self.nodeList[i].power > power then
            --self.nodeList[i].aorimage_nodeBg.SpriteName = "ui-tzy-bar-jindu06"
            --self.nodeList[i].aortext_power.color = _G.ColorTools.FormatColorByString("a2a9da")
            -- self.nodeList[i].aorimage_box.SpriteName = _G.tostring((6 - i) + 10)
            -- self.nodeList[i].aorimage_box:SetNativeSize()
            if self.nodeList[i].effect then
                self.nodeList[i].effect:SetActiveE(0)
            end
            if not isEnd then
                isEnd = true
                if i == 1 then
                    slider = 0.08 * power / self.nodeList[i].power + 0.095
                else
                    slider =
                        0.07 * (power - self.nodeList[i - 1].power) /
                        _G.math.abs(self.nodeList[i].power - self.nodeList[i - 1].power) +
                        slider
                end
            end
        else
            -- self.nodeList[i].aorimage_box.SpriteName = "0" .. _G.tostring((6 - i))
            -- self.nodeList[i].aorimage_box:SetNativeSize()
            --self.nodeList[i].aorimage_nodeBg.SpriteName = "ui-tzy-bar-jindu08"
            --self.nodeList[i].aortext_power.color = _G.ColorTools.FormatColorByString("1d1e30")
            if self.nodeList[i].effect then
                self.nodeList[i].effect:SetActiveE(1)
            end

            if i == 1 then
                slider = 0.285
            elseif i == 5 then
                slider = 1
            else
                slider = 0.175 + 0.07 * (i - 1) + 0.11 * i
            end
        end
        --_G.GameUtil.SetActiveByCondition(self.nodeList[i].aorimage_di, self.nodeList[i].power <= power)
    end
    self.go_table.slider_progress.value = slider
end

function BountyBossView:OnCompleteTimer()
    self.CardFilterPanel.aorbtn_close:SetActiveE(1)
    self.CardFilterPanel.gameObject:SetActiveE(0)
end

return BountyBossView
