function BountyBossView:CareatItem(tb, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        tb,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.7)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            --endregion------------------------------------物品 特效 防止因异步加载 延迟导致显示错误--------

            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, tb[1])
        end
    )
end

---初始化任务奖励
function BountyBossView:InitAward()
    for i = 1, #self.cfg.reward do
        _G.PoolsManager:GetInstance():Spawn(
            awardPath,
            _G.ePoolType.Default,
            self.go_table.obj_AwardRoot,
            function(trans)
                self.AwardItems[i] = BaseAwardItem.CreatAwardItem(trans)

                self.AwardItems[i]:UpdateItem(
                    {
                        sid = self.cfg.reward[i][1],
                        number = self.cfg.reward[i][2]
                    }
                )
            end
        )
    end
end

function BountyBossView:TimeToString(time)
    local str = string.split(_G.TimeUtil.TimeToString(time, 1), ":")
    local hour = math.ceil(tonumber(str[1]))

    return hour
end

---刷新任务奖励
---@param trans UnityEngine.Transform
---@param index number 物体下标
function BountyBossView:RefreshAward(trans, index)
    index = index + 1
    local instance = trans:GetInstanceIDE()
    if not self.AwardItems[instance] then
        self.AwardItems[instance] = BaseAwardItem.CreatAwardItem(trans)

        self.AwardItems[instance]:UpdateItem(
            {
                sid = self.cfg.reward[index][1],
                number = self.cfg.reward[index][2]
            }
        )
    end
end

---初始化下面的卡牌
function BountyBossView:InitMidCard()
    for i = 1, 10 do
        self.MidCardItems[i] =
            BountyCardItem.CreateCardItem(self.go_table["obj_card" .. i], _G.handler(self, self.ClickMidCard))
    end
end

---点击中间的卡牌
---@param item BountyCardItem
function BountyBossView:ClickMidCard(item)
    if item.CardData then
        self:RemoveCard(item.CardData)
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyBossCardView.Name,
            self.RequirdCards,
            _G.handler(self, self.CheckCardChoose),
            _G.handler(self, self.ClickDownCard)
        )
    end
end

function BountyBossView:CheckCardChoose(uid)
    return self.ChooseCardList[uid] or 0
end

---移除卡牌
---@param item BaseAwardItem 卡牌
function BountyBossView:RemoveCard(data)
    local index = self:CheckCardChoose(data.uid)
    self.MidCardItems[index]:Init(nil)
    self.ChooseCardList[data.uid] = nil
    self.go_table.aortext_btntxt.color = _G.ColorTools.FormatColorByString("474747")
    self.go_table.aorbtn_Start:SetGray(true)
    self.go_table.aorbtn_Start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    _G.ColorTools.FormatColorByString("808080")
    self:UpdatePlayerPower()
end

---添加卡牌
---@param item CardData
function BountyBossView:AddCard(data)
    local index = 0
    for i = 1, #self.MidCardItems do
        if self.MidCardItems[i].CardData == nil then
            index = i
            break
        end
    end
    if index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(350111)
        return
    end
    self.MidCardItems[index]:Init(data)
    self.ChooseCardList[data.uid] = index
    self:UpdatePlayerPower()
end

