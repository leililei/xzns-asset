---@class BountyUpgradeView : UIBaseView	中文描述
---@field public go_table BountyUpgradeView_GoTable GoTable
---@field level number 当前贪字营等级
local BountyUpgradeView = _G.BaseClass("BountyUpgradeView", _G.UIBaseView)
local GetLangPackValue = _G.GetLangPackValue
local QuestQualityItem = "UI/Bounty/@_aorimage_State"
function BountyUpgradeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param data dispatch.s2c_dispatch_info 当前贪字营等级
function BountyUpgradeView:OnCreate(data)
    self.data = data
    self.level = data.level
    self.cfg = _G.ConfigManager.bounty_level_cfg[self.level]
    self.go_table.aortext_title.text = GetLangPackValue(90021700008, self.level)
    self:InitLvInfoItemL(self.level)
    self:InitLvInfoItemR(self.level + 1)
    self:InitUpLevelRequirement()
    -- _G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, true, 0.2)
end

---显示当前等级信息
---@param level number 当前等级
function BountyUpgradeView:InitLvInfoItemL(level)
    self.lvInfoItemL = _G.GetAutoGoTable(self.go_table.obj_LvInfoItemL)
    local cfg = _G.ConfigManager.bounty_level_cfg[level]
    if cfg then
        self.lvInfoItemL.aortext_Lv.text = GetLangPackValue(90020600039, level)
        local min = _G.math.floor(cfg.bounty[1][1] / 1000)
        local max = min
        for _, v in pairs(cfg.bounty) do
            for _2, v2 in pairs(v) do
                if v2 > 1000 then
                    local value = _G.math.floor(v2 / 1000)
                    if value < min then
                        min = value
                    end
                    if value > max then
                        max = value
                    end
                end
            end
        end
        self.lvInfoItemL.aortext_content.text = GetLangPackValue(90022500404, min, max)
    end
end

---显示下一等级信息
---@param level number 下一等级
function BountyUpgradeView:InitLvInfoItemR(level)
    self.lvInfoItemR = _G.GetAutoGoTable(self.go_table.obj_LvInfoItemR)
    if level <= #_G.ConfigManager.bounty_level_cfg then
        local cfg = _G.ConfigManager.bounty_level_cfg[level]
        if cfg then
            self.lvInfoItemR.aortext_Lv.text = GetLangPackValue(90020600039, level)
            local min = _G.math.floor(cfg.bounty[1][1] / 1000)
            local max = min
            for _, v in pairs(cfg.bounty) do
                for _2, v2 in pairs(v) do
                    if v2 > 1000 then
                        local value = _G.math.floor(v2 / 1000)
                        if value < min then
                            min = value
                        end
                        if value > max then
                            max = value
                        end
                    end
                end
            end
            self.lvInfoItemR.aortext_content.text = GetLangPackValue(90022500404, min, max)
        end
    else
        _G.GameUtil.SetActiveByCondition(self.lvInfoItemR.obj_task, false)
        _G.GameUtil.SetActiveByCondition(self.lvInfoItemR.aortext_Maxlevel, true)
    end
end

---初始化升级要求
function BountyUpgradeView:InitUpLevelRequirement()
    if self.slider == nil then
        self.slider = _G.GetAutoGoTable(self.go_table.slider_Progress)
    end
    if self.level >= #_G.ConfigManager.bounty_level_cfg then
        _G.GameUtil.SetActiveByCondition(self.go_table.aortext_LeveLimit, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_down, false)
    else
        self.slider.aortext_Slider.text = "(" .. self.data.boss_kill_num .. "/" .. self.cfg.num_boss .. ")"
        self.go_table.slider_Progress.value = self.data.boss_kill_num / self.cfg.num_boss
    end
end

function BountyUpgradeView:CloseView()
    self:Close()
