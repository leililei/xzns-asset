    --     self.go_table.obj_window,
    --     false,
    --     0.2,
    --     function()
    --         self:Close()
    --     end
    -- )
end

---按钮点击事件在这里派发
function BountyUpgradeView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:CloseView()
    elseif go == self.go_table.aorbtn_close then
        self:CloseView()
    end
end

return BountyUpgradeView
