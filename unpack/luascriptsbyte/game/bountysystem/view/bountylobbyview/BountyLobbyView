---刷新恶灵任务
function BountyLobbyView:RefreshEvilTask(index, obj)
    index = index + 1
    local item = obj
    --listView2:NewListViewItem("$_obj_QuestItem")
    obj:SetName(index)
    local instanceID = item:GetInstanceIDE()
    if not self.EvilTasks[instanceID] then
        self.EvilTasks[instanceID] = BountyQuestBase.CreateBountyQuest(
            item,
            _G.handler(self, self.AcceptEvilTask),
            _G.handler(self, self.OnFinishEvilTask),
            _G.handler(self, self.SortEvilTask2),
            self
        )
        if not self.isInited then
            self:DelayDo(
                0.1 * index,
                function()
                    _G.GameUtil.SetActiveByCondition(obj, false)
                    _G.GameUtil.SetActiveByCondition(obj, true)
                end
            )
            self.EvilTasks[instanceID]:InitData(index, true, true)
            _G.GameUtil.SetActiveByCondition(obj, false)
        else
            self.EvilTasks[instanceID]:InitData(index, true)
        end
    elseif self.EvilTaskDatas[index] then
        self.EvilTasks[instanceID]:InitData(
            index,
            self:CheckIsNew(self.EvilTaskDatas[index].cfg.id),
            nil,
            self:CheckIsUnDisposeTask(self.EvilTaskDatas[index].cfg.id)
        )
    end
    -- return item
end

---检测是否为新的任务
function BountyLobbyView:CheckIsNew(id)
    if not self.NewDatas then
        return false
    end
    local isNew = self.NewDatas[id]
    self.NewDatas[id] = nil
    return isNew
end

function BountyLobbyView:DelayDo(time, call)
    if not self.DelayTb then
        self.DelayTb = {}
    end
    self.DelayTb[call] = _G.DelayDo(
        time,
        function()
            self.DelayTb[call] = nil
            call()
        end
    )
end

---检测是否为未派遣任务
function BountyLobbyView:CheckIsUnDisposeTask(id)
    local isTrue = self.unDisposeTask[id]
    self.unDisposeTask[id] = nil
    return isTrue
end

---接取恶灵任务
function BountyLobbyView:AcceptEvilTask(id)
    self.unDisposeTask = {}
    for _, v in pairs(self.EvilTaskDatas) do
        if v.id ~= id and v.taskState == BountyEnum.BountyQuestStateEnum.DNS then
            self.unDisposeTask[v.id] = true
        end
    end
    self:SortEvilTask2()
end

