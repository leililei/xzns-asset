---完成Boss任务
---@param msg dispatch.s2c_dispatch_finish_boss
function BountyLobbyView:FinishBossTask(msg)
    if msg.ack ~= 1 then
        return
    end
    self.bountyData.boss.boss_start_time = 0
    _G.Events:GetInstance():Broadcast(
        _G.ePlayAactionEvent.PlayAaction,
        { _G.ActiveTaskEnum.ConditionEnum.Section.TzyBossTaskOver },
        -- 贪字营 boss任务完成x次
        --- #次数
        1
    )

    self.bountyData.boss_kill_num = self.bountyData.boss_kill_num + 1
    --检测升级
    if self.bountyData.level < #_G.ConfigManager.bounty_level_cfg then
        if self.bountyData.boss_kill_num >= _G.ConfigManager.bounty_level_cfg[self.bountyData.level].num_boss then
            self.bountyData.boss_kill_num = 0
            self.bountyData.level = self.bountyData.level + 1

            require "PopUpGiftBagModel":GetInstance():IsCampLevel(self.bountyData.level)

            self.cfg = _G.ConfigManager.bounty_level_cfg[self.bountyData.level]
            self.go_table.slider_BossTime.maxValue = self.cfg.duration
            self.go_table.aortext_count.text = "x" .. self.cfg.points_boss
            self.go_table.aortext_Level.text = string.replace(self.go_table.aortext_Level.text, self.bountyData.level - 1,
                self.bountyData.level)
            _G.Events:GetInstance():Broadcast(
                _G.ePlayAactionEvent.PlayAaction,
                { _G.ActiveTaskEnum.ConditionEnum.Section.TzyLevel },
                -- 贪字营等级达到X级
                --- #等级
                self.bountyData.level
            )
        end
    end

    ---奖励飞入位置
    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        local awardData = require("BountySystemManager"):GetInstance():ParaseAward(msg.award)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
            msg,
            function()
                self:ShowBoss()
            end,
            true,
            nil,
            true
        )
    else
        --TODO 提示背包已满，奖励发送至邮件
    end
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_boss, true)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_BossUnDispath, true)
    local isWaiting = require("BountySystemManager"):GetInstance().BountyData.boss.boss_start_time > 0
    local bool = _G.StorageManager:GetInstance():GetItemCountBySid(52) < self.cfg.points_boss or isWaiting
    self.go_table.obj_tip:SetActiveE(bool and 0 or 1)
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_getBoss, false)
    if not msg.award then
        self:ShowBoss()
    end
    if msg.missions then
        _G.table.insertto(self.bountyData.missions, msg.missions)
        require("BountySystemManager"):GetInstance():AddQuest(msg.missions)
        --self.QuestPanel.looplist2_QuestList:SetListItemCount(#self.bountyData.missions)
        self:UpdateList()
        self:SortEvilTask2(true)
        self:ShowNoTask()
    end
end

