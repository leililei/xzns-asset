        self.isDefult and 1 or #self.bountyData.missions,
        _G.handler(self, self.RefreshEvilTask)
    )
    self.NewDatas = {}
    self.isInited = true
    -- self.QuestPanel.looplist2_QuestList:InitListView(#self.bountyData.missions, _G.handler(self, self.RefreshEvilTask))
