---显示按钮
function BountyLobbyView:ShowBtn()
    local isHave = false
    for _, v in pairs(self.EvilTaskDatas) do
        if v.taskState == BountyEnum.BountyQuestStateEnum.DNS or v.taskState == BountyEnum.BountyQuestStateEnum.Award then
            isHave = true
            break
        end
    end
    local flag = false
    local data = require "PrivilegeManager":GetInstance():GetPrivilegeData({ _G.PrivilegeType.Trial.Bounty })
    local level = require "VIPPrivilegeModel":GetInstance().currentVipLevel

    if data[1] then
        local needLevel = _G.ConfigManager.discrete_cfg[101504][1][1]
        flag = level >= needLevel
    end

    local isShowBtn = not self.isDefult and isHave and flag
    self.go_table.obj_Btn:SetActiveE(isShowBtn and 1 or 0)
    self.go_table.obj_UnlockTips:SetActiveE(flag and 0 or 1)
    if not self.scrollInit then
        local _, height = self.go_table.scrollloopvectical_QuestList:GetRectTransformWidthHeight()
        self.height = height
        self.scrollInit = true
    end
    if not _G.table.isEmptyOrNil(self.bountyData.missions) then
        self.go_table.scrollloopvectical_QuestList:UpdateScrollRectHeight(isShowBtn and self.height or self.height + 60)
    end

    --self.go_table.scrollloopvectical_QuestList:UpdateScrollRectHeight(flag and 414 or 487)
    if (not isShowBtn) then
        self.go_table.aortext_unlockTip.text = _G.GetLangPackValue(90021700037)
        local _, height = self.go_table.scrollloopvectical_QuestList:GetRectTransformWidthHeight()
        self.scrollInit = true
    end
end

function BountyLobbyView:InitBoss()
    self.BossRTS = 0
    if self.bountyData.boss.boss_start_time > 0 then
        self.BossRTS = _G.TimeUtil.GetServerUnixTime() - self.bountyData.boss.boss_start_time
        if self.BossRTS > self.cfg.duration then
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_boss, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_getBoss, true)
            self.BossRTS = 0
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_getBoss, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_boss, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_BossDispath, true)
            _G.GameUtil.SetActiveByCondition(self.go_table.obj_BossUnDispath, false)
            self.go_table.obj_tip:SetActiveE(0)
            self.BossRTS = self.cfg.duration - self.BossRTS
            self.go_table.aortext_Slider.text = _G.TimeUtil.TimeToString(self.BossRTS, 1)
            self.go_table.slider_BossTime.maxValue = self.cfg.duration
            self.go_table.slider_BossTime.value = self.cfg.duration - self.BossRTS
            if self.bossTimer == nil then
                self.bossTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateBossTimer, self, false, false, true)
                self.bossTimer:Start()
            end
        end
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_getBoss, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_boss, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_BossUnDispath, true)
        local isWaiting = require("BountySystemManager"):GetInstance().BountyData.boss.boss_start_time > 0
        local bool = _G.StorageManager:GetInstance():GetItemCountBySid(52) < self.cfg.points_boss or isWaiting
        self.go_table.obj_tip:SetActiveE(bool and 0 or 1)
    end
    local nowCount = _G.StorageManager:GetInstance():GetItemCountBySid(52)
    local maxCount = self.cfg.points_boss
    self.go_table.slider_BossTime.maxValue = self.cfg.duration
    --self.go_table.aorrawimage_icon:LoadImage(_G.ConfigManager.currency_type_cfg[52].icon)
    if nowCount > maxCount then
        self.go_table.slider_count.value = 1
    else
        self.go_table.slider_count.value = nowCount / maxCount
    end
    self.go_table.aortext_count.text = nowCount .. "/" .. maxCount
    local bool = nowCount < maxCount
    self.go_table.aorbtn_Changllenge:SetGray(bool)
    self.go_table.aorbtn_Changllenge:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString(bool and "A9A9A9" or "FFFFFF")
    self.go_table.aortext_name.color =
        _G.ColorTools.FormatColorByString(bool and "434343" or "8C2D14")
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_gray, bool)
    _G.GameUtil.SetActiveByCondition(self.go_table.aortext_name, not bool)

    if not self.bossEff then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg.ef_xuanshangemoshoulie, self.go_table.obj_eff,
            function(obj)
                if self:IsNil() then
                    _G.UIUtils.RemoveEffect(obj)
                    return
                end
                self.bossEff = obj
            end)
    end
end

function BountyLobbyView:UpdateBossTimer(elapsed)
    if self:IsNil() then
        return
    end
    self.BossRTS = self.BossRTS - elapsed
    self.go_table.aortext_Slider.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.BossRTS), 1)
    self.go_table.slider_BossTime.value = Mathf.RoundToInt(math.max(self.cfg.duration - self.BossRTS, 0))
    if self.BossRTS <= 0 then
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_boss, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_BossDispath, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_getBoss, true)
        self.bossTimer:Stop()
        self.bossTimer = nil
    end
end

---初始化恶灵任务刷新时间
function BountyLobbyView:InitTimer()
    self.RTS = _G.TimeUtil.GetSixClockTimer()
    self:UpdateEvilRefreshTime(self.RTS)
    if self.refreshTimer == nil then
        self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(1, self.OnChangeRTS, self, false, false, true)
        self.refreshTimer:Start()
    end
end

function BountyLobbyView:OnChangeRTS(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.RTS = 86400 + self.RTS
    end
    self:UpdateEvilRefreshTime(self.RTS)
end

---更新恶灵任务刷新时间
function BountyLobbyView:UpdateEvilRefreshTime(RTS)
    self.QuestPanel.aortext_TimeLeft.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(RTS), 1)
end

