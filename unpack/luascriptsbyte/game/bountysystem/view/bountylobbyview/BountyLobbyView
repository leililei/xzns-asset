    if self.EvilTaskDatas then
        for _, v in pairs(self.EvilTaskDatas) do
            v:Dispose()
            require("BountySystemManager"):GetInstance():RespawnQuestData(v)
        end
    end

    if self.refreshTimer then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
    if self.bossTimer then
        self.bossTimer:Stop()
        self.bossTimer = nil
    end
    if self.DelayTb then
        for _, v in pairs(self.DelayTb) do
            _G.coroutine.stopwaiting(v)
        end
        self.DelayTb = nil
    end

    require("BountySystemManager"):GetInstance():UnBindUpdateTime()
end

