---按钮点击事件在这里派发
function BountyLobbyView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_CloseView" then
        self:CloseView()
    elseif name == "@_aorbtn_DispathAll" then
        self:DispathAll()
    elseif name == "@_aorbtn_Refresh" then
        local isHaveRefreshTask = false
        for i = 1, #self.bountyData.missions do
            if self.bountyData.missions[i].time == 0 then
                isHaveRefreshTask = true
                break
            end
        end
        if not isHaveRefreshTask then
            _G.PopWindowManager:GetInstance():ShowAllTips(350106)
            return
        end
        local rolid = _G.PlayerModel:GetInstance().role_uid
        local savetime = _G.PlayerPrefsManager.GetInt("BountyLobbyRefresh" .. rolid)
        local nowtime = _G.TimeUtil.GetServerUnixTime()
        local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
        local isChoose = savetime == todayTime
        if isChoose then
            if
                _G.StorageManager:GetInstance():CheckItem(
                    _G.ResPropID.Diamond,
                    _G.ConfigManager.discrete_cfg[101501][1][1]
                )
            then
                require("BountySystemManager"):GetInstance():RefreshEvilTask(
                    _G.handler(self, self.RefreshAllEvilTask)
                )
            else
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                    _G.ResPropID.Diamond
                )
            end
        else
            _G.PopWindowManager:GetInstance():ShowAllTips(
                350301,
                string.format(
                    _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[350301].content),
                    _G.ConfigManager.discrete_cfg[101501][1][1]
                ),
                function(isChoose)
                    if
                        _G.StorageManager:GetInstance():CheckItem(
                            _G.ResPropID.Diamond,
                            _G.ConfigManager.discrete_cfg[101501][1][1]
                        )
                    then
                        require("BountySystemManager"):GetInstance():RefreshEvilTask(
                            _G.handler(self, self.RefreshAllEvilTask)
                        )
                    else
                        _G.UIManager:GetInstance():OpenWindow(
                            _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                            _G.ResPropID.Diamond
                        )
                    end
                    if isChoose then
                        _G.PlayerPrefsManager.SetInt("BountyLobbyRefresh" .. rolid, todayTime)
                    end
                end
            )
        end
    elseif name == "@_aorbtn_onLevel" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BountyUpgradeView.Name, self.bountyData)
    elseif name == "@_aorbtn_GetAllReward" then
        self:ReceiveAllAward()
    elseif name == "@_aorbtn_closeBoss" then
        self.go_table.obj_BossAttack:SetActiveE(0)
    elseif name == "@_aorbtn_PlayDescribe" or name == "@_aorbtn_PlayDescribe2" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 5)
    elseif name == "@_aorbtn_banner" then
        _G.PopWindowManager:GetInstance():ShowAllTips(350108)
    elseif name == "@_aorbtn_Changllenge" then
        if _G.StorageManager:GetInstance():GetItemCountBySid(52) >= self.cfg.points_boss then
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.BountyBossView.Name,
                self.bountyData.level,
                self.bountyData.boss,
                _G.handler(self, self.AcceptBossTask)
            )
        else
            --   _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, 52)
            _G.PopWindowManager:GetInstance():ShowAllTips(350112)
        end
    elseif name == "@_aorbtn_GetBoss" then
        require("BountySystemManager"):GetInstance():FinshBossTask(_G.handler(self, self.FinishBossTask))
    elseif name == "@_aorbtn_Privilege" then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LimitedTimePrivilegeView.Name, 405006)
    elseif go == self.go_table.aorbtn_box then
        self:OnClickNode()
    elseif go == self.go_table.aorbtn_TipsView then
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, false)
    end
end

function BountyLobbyView:OnClickNode()
    _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_TipsView, true)

    if not self.itemTable then
        self.itemTable = {}
    end
    for key, value in pairs(self.itemTable) do
        value.Despawn(value)
        self.itemTable[key] = nil
    end
    local power = require "BountySystemManager":GetInstance():GetBossPower()
    local powerTb = self.cfg.power
    local NowItems = self.cfg.reward
    local count = #NowItems
    local count2 = 0
    for i = 1, count do
        if powerTb[i][2] <= power then
            count2 = count2 + 1
            self:CareatItem(NowItems[i], self.go_table.obj_Parent, self.itemTable)
        end
    end
    local tf = self.go_table.obj_ItemTips:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    if not _G.IsNil(tf) then
        tf:SetSizeWithCurrentAnchors(_G.CS.UnityEngine.RectTransform.Axis.Horizontal, count2 * 68)
    end
end

function BountyLobbyView:CareatItem(tb, Parent, itemTable)
    if _G.IsNil(Parent) or Parent:GetctiveInHierarchy() == 0 then
        return
    end
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        tb,
        Parent,
        function(item)
            item.gameObject:SetLocalScaleXYZ(0.7)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            --endregion------------------------------------物品 特效 防止因异步加载 延迟导致显示错误--------

            table.insert(itemTable, item)
        end,
        function(go, isOn)
            require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, tb[1])
        end
    )
end

