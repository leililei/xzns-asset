---@param missions dispatch.i_evil_spirit_mission
function BountyLobbyView:ChangeNew(missions)
    local isNew = true
    for _, v in pairs(missions) do
        isNew = true
        for _, v2 in pairs(self.bountyData.missions) do
            if v2.sid == v.sid then
                isNew = false
                break
            end
            if isNew then
                self.NewDatas[v.sid] = true
            end
        end
    end
end

