---一键派遣
function BountyLobbyView:DispathAll()
    if _G.table.isEmptyOrNil(self.bountyData.missions) then
        _G.PopWindowManager:GetInstance():ShowAllTips(350102)
        return
    end
    local haveTask = false
    for _, v in pairs(self.EvilTaskDatas) do
        if not v.mission.card or #v.mission.card == 0 then
            haveTask = true
            break
        end
    end
    if not haveTask then
        _G.PopWindowManager:GetInstance():ShowAllTips(350110)
        return
    end

    local cards = require("BountySystemManager"):GetInstance():GetDispathAll()
    if _G.table.isEmptyOrNil(cards) then
        _G.PopWindowManager:GetInstance():ShowAllTips(350101)
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyDispatchView.Name,
            cards,
            function(data)
                local list = {}
                for k, v in pairs(data) do
                    local tb = {}
                    tb.sid = v.mission.sid
                    tb.card_uid = {}
                    for i = 1, #v.mission.card do
                        tb.card_uid[#tb.card_uid + 1] = v.mission.card[i].uid
                    end
                    _G.table.insert(list, tb)
                end
                require("BountySystemManager"):GetInstance():AcceptEvilTask(
                    list,
                    function(msg)
                        if msg.ack ~= 1 then
                            _G.PopWindowManager:GetInstance():ShowAllTips(350101)
                            return
                        end
                        self.unDisposeTask = {}
                        if msg.success_sid then
                            local isAdd = false
                            for i = 1, #self.EvilTaskDatas do
                                for j = 1, #msg.success_sid do
                                    isAdd = false
                                    if msg.success_sid[j] == self.EvilTaskDatas[i].mission.sid then
                                        self.EvilTaskDatas[i]:StartTask(
                                            msg.start_time,
                                            data[msg.success_sid[j]].mission.card,
                                            true
                                        )
                                        self.NewDatas[msg.success_sid[j]] = true
                                        isAdd = true
                                        break
                                    end
                                end
                                if not isAdd and self.EvilTaskDatas[i].taskState == BountyEnum.BountyQuestStateEnum.DNS then
                                    self.unDisposeTask[self.EvilTaskDatas[i].mission.sid] = true
                                end
                            end
                            self:SortEvilTask2()
                            self.unDisposeTask = {}
                        end
                    end
                )
            end
        )
    end
end

---一键领取
function BountyLobbyView:ReceiveAllAward()
    local TaskSids = {}
    local IndexTb = {}
    local count = #self.EvilTaskDatas
    for i = 1, count do
        local v = self.EvilTaskDatas[i]
        if v.taskState == BountyEnum.BountyQuestStateEnum.Award and v.mission then
            TaskSids[v.mission.sid] = v.mission.sid
            v.taskState = BountyEnum.BountyQuestStateEnum.Awarding
            _G.table.insert(IndexTb, { index = i, data = v })
        end
    end
    if _G.table.count(TaskSids) > 0 then
        require("BountySystemManager"):GetInstance():FinshEvilTask(
            _G.table.toArray(TaskSids),
            _G.handlerbind(self, self.ReceiveAllAwardCall, IndexTb)
        )
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(350103)
    end
end

---一键领取回调
---@param msg dispatch.s2c_dispatch_finish
function BountyLobbyView:ReceiveAllAwardCall(msg, IndexTb)
    if msg.ack ~= 1 then
        _G.PopWindowManager:GetInstance():ShowAllTips(350103)
    end
    if msg.missions then
        _G.table.insertto(self.bountyData.missions, msg.missions)
        for _, v in pairs(msg.missions) do
            self.NewDatas[v.sid] = true
        end
        require("BountySystemManager"):GetInstance():AddQuest(msg.missions)
    end
    local isNew = not _G.table.isEmptyOrNil(msg.missions)
    if msg.success_sid then
        local count = #IndexTb
        local count2 = #msg.success_sid
        local tb = {}
        for _, v in pairs(msg.success_sid) do
            tb[v] = true
        end
        local index = 0
        for i = count, 1, -1 do
            ---@type BountyQuestData
            local v = IndexTb[i].data
            if tb[v.mission.sid] then
                if v.questBase and v.questBase.index == i then
                    local item = v.questBase
                    item:PlayOut(
                        function()
                            index = index + 1
                            self:RemoveEvilTask(v.mission.sid)
                            --self.QuestPanel.scrollloopvectical_QuestList:RecycleItem(IndexTb[i].index - 1)
                            if index >= count2 then
                                if isNew then
                                    self:SortEvilTask2(true)
                                    self:UpdateList()
                                    self.NewDatas = {}
                                else
                                    self:MoveAllQuest()
                                end
                                require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager
                                .redpoint_cfg.BountyLobby.id)
                            end
                            self.QuestPanel.scrollloopvectical_QuestList:UpdateAllItem()
                        end
                    )
                else
                    self:RemoveEvilTask(v.mission.sid)
                    --self.QuestPanel.scrollloopvectical_QuestList:RecycleItem(IndexTb[i].index - 1)
                    index = index + 1
                end
            end
        end
        if not msg.award then
            self:ShowBoss()
        end

        if msg.award then
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonAwardView.Name,
                msg,
                function()
                    self:ShowBoss()
                end,
                true,
                nil,
                true
            )
        end
    end
    local isWaiting = require("BountySystemManager"):GetInstance().BountyData.boss.boss_start_time > 0
    local bool = _G.StorageManager:GetInstance():GetItemCountBySid(52) < self.cfg.points_boss or isWaiting
    self.go_table.obj_tip:SetActiveE(bool and 0 or 1)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 202)
end

function BountyLobbyView:MoveAllQuest(call)
    local count = #self.EvilTaskDatas
    if count == 0 then
        self:ShowBtn()
        self:ShowNoTask()
    else
        for i = 1, count do
            if
                self.EvilTaskDatas[i].questBase and
                self.EvilTaskDatas[i].questBase.questData.id == self.EvilTaskDatas[i].id
            then
                self.EvilTaskDatas[i].questBase.index = i
                if i == count then
                    self:ShowBtn()
                    if call then
                        call()
                    end
                end
            end
        end
    end
end

