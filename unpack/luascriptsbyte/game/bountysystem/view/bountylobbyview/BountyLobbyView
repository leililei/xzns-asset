function BountyLobbyView:ChangeIndex(index, isMove, callback)
    local count = 0
    local canMove = false
    for _, v in pairs(self.EvilTasks) do
        if v.index and v.index > index then
            v.index = v.index - 1
            if isMove and v.gameObject:GetActiveSelf() == 1 then
                canMove = true
                local _, y = v.transform:GetLocalPosition()
                local endY = y + 147
                count = count + 1
                v.transform:DOLocalMoveY(endY, 0.2):SetEase(_G.CS.DG.Tweening.Ease.Linear):OnComplete(
                    function()
                        count = count - 1
                        if count == 0 then
                            if callback then
                                callback()
                                callback = nil
                            end
                        end
                    end
                )
            end
        end
    end
    if not canMove then
        if callback then
            callback()
            callback = nil
        end
    end
end

---完成恶灵任务回掉
---@param msg dispatch.s2c_dispatch_finish
---@param data BountyQuestData
---@param item BountyQuestBase
function BountyLobbyView:OnFinishEvilTaskSuc(msg, data, item, callback)
    if msg.ack ~= 1 then
        return
    end

    if msg.missions then
        _G.table.insertto(self.bountyData.missions, msg.missions)
        for _, v in pairs(msg.missions) do
            self.NewDatas[v.sid] = true
        end
        require("BountySystemManager"):GetInstance():AddQuest(msg.missions)
        self:UpdateList()
    end

    if msg.award then
        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
        local awardData = require("BountySystemManager"):GetInstance():ParaseAward(msg.award)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CommonAwardView.Name,
            msg,
            function()
                self:ShowBoss()
            end,
            true,
            nil,
            true
        )
    end
    local isNew = not _G.table.isEmptyOrNil(msg.missions)
    item:PlayOut(
        function()
            self:RemoveEvilTask(data.mission.sid)
            self:ChangeIndex(
                item.index,
                true,
                function()
                    --self.QuestPanel.scrollloopvectical_QuestList:RecycleItem(item.index - 1, 1)
                    if isNew then
                        self:SortEvilTask2(true)
                    end
                    self:ShowBtn()
                    self:ShowNoTask()
                    if self.isDefult then
                        self.isDefult = false
                        require "BountySystemManager":GetInstance().isDefult = false
                        self:UpdateList()
                    end
                    self.QuestPanel.scrollloopvectical_QuestList:UpdateAllItem()
                end
            )
            require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.BountyLobby.id)
        end
    )

    if not msg.award then
        self:ShowBoss()
    end
    local isWaiting = require("BountySystemManager"):GetInstance().BountyData.boss.boss_start_time > 0
    local bool = _G.StorageManager:GetInstance():GetItemCountBySid(52) < self.cfg.points_boss or isWaiting
    self.go_table.obj_tip:SetActiveE(bool and 0 or 1)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 202)
end

