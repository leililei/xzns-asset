---界面的入口函数
function BountyLobbyView:OnCreate()
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    self.go_table.obj_QuestPanel:SetActiveE(1)
    self.go_table.obj_ChallengePanel:SetActiveE(0)
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.BountyLobby.id)
    self:InitToggle()
    self.canvas = self.gameObject:GetComponentE(typeof(CS.UnityEngine.Canvas))
    if require("BountySystemManager"):GetInstance().BountyData then
        self:Init()
    else
        require("BountySystemManager"):GetInstance():GetBountyData(
            function()
                _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.BountyLobbyView.Name)
                self:Init()
            end
        )
        _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BountyLobbyView.Name)
    end
    if not _G.PlayerPrefsManager.HasKey("OpenBountyLobbyView") then
        _G.PlayerPrefsManager.SetInt("OpenBountyLobbyView", 1)
        require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.MainChallenge.id, 202)
    end

    self.go_table.toggle_disPatch.isOn = false
    self.go_table.toggle_disPatch.isOn = true
    TrackingPointModel:GetInstance():SetWindowStartTime(self.viewName, true)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed)
end

---界面初始化
function BountyLobbyView:Init()
    require("BountySystemManager"):GetInstance():InitAllQuset()
    self.isDefult = require "BountySystemManager":GetInstance().isDefult
    require("BountySystemManager"):GetInstance():BindUpdateTime(
        _G.handler(self, self.UpdateEvilRefreshTime),
        _G.handler(self, self.EvilRefreshTimerOver)
    )
    self.bountyData = require("BountySystemManager"):GetInstance().BountyData
    self.cfg = _G.ConfigManager.bounty_level_cfg[self.bountyData.level]
    self.EvilTaskDatas = require("BountySystemManager"):GetInstance().AllQuest
    self.EvilTasks = {}
    self.EvilMaps = {}
    self.unDisposeTask = {}
    self.refreshTimer = nil
    self.bossTimer = nil
    self.boss = nil
    self.go_table.aortext_Level.text = _G.string.format(_G.LangUtil.GetLangPackValue(90020600039), self.bountyData.level)
    self.NewDatas = {}
    self:InitNew()
    self:AddComponent(
        self.go_table.obj_resourceRoot,
        require("ResourceCompont").New(
            self.go_table.obj_resourceRoot,
            _G.ConfigManager.ui_cfg.BountyLobbyView.resources
        )
    )
    local isWaiting = require("BountySystemManager"):GetInstance().BountyData.boss.boss_start_time > 0
    local bool = _G.StorageManager:GetInstance():GetItemCountBySid(52) < self.cfg.points_boss or isWaiting
    self.go_table.obj_tip:SetActiveE(bool and 0 or 1)

    local cfg = _G.ConfigManager.store_month_cfg[405006]
    local review = cfg and cfg.review or 0
    self.go_table.aorbtn_Privilege:SetActiveE((review == 1 and _G.AppSetting.IsArraigned) and 0 or 1)
end

