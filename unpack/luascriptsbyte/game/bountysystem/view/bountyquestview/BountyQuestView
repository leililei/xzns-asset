local BaseAwardItem = require("BaseAwardItem")
local BountyCardItem = require("BountyCardItem")
local BountyCardItemList = require("BountyCardItemList")
---@class BountyQuestView : UIBaseView	恶灵任务添加出战的界面
---@field public go_table BountyQuestView_GoTable GoTable
---@field data dispatch.i_evil_spirit_mission 恶灵任务数据
---@field cfg bounty_quest_cfg 任务cfg
---@field Cards CardData[] 空闲的卡牌
---@field DownCardItems BountyCardItem[]  底部的卡牌
---@field CardItemLists BoountyQuestCardItem[] 右侧的卡牌
---@field AwardItems BaseAwardItem[] 奖励
---@field LimitCardNum number 符合属性要求的数量
---@field ShowCardData CardData[] 当前展示的卡牌数据
---@field Elements number 当前选中的元素 0-全部
---@field ChooseCardList table 选中的卡牌
---@field UidInCardList BoountyQuestCardItem[]
---@field ElementTb BountyQuestView._obj_Elements_GoTable
local BountyQuestView = _G.BaseClass("BountyQuestView", _G.UIBaseView)
