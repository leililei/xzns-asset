---底部卡牌的预设体路径
local cardPath = "UIH5/Bounty/$_obj_card"
---底部属性的预设体路径
local propPath = "UIH5/Bounty/$_obj_prop"
local color = _G.Color(1, 1, 1, 0.5)

local attribute = {
    [1]=90024900062,
    [2]=90024900035,
    [3]=90024900036,
    [4]=90024900037,
    [5]=90024900038,
    [6]=90024900039,
    [7]=90024900040
}

function BountyQuestView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.clickFunction = {
        ["@_aorbtn_autoDispatch"] = self.DispatchAll,
        ["@_aorbtn_start"] = self.OnStart,
        ["@_aorbtn_CloseView"] = self.CloseView,
        ["@_aorbtn_anyClose"] = self.CloseView,
        ["@_aorbtn_cardLimit"] = self.ShowLimit
    }
end

---界面的入口函数
---@param data dispatch.i_evil_spirit_mission
---@param callback function 派遣后的回调
function BountyQuestView:OnCreate(data, callback, closeCallback)
    self.data = data
    self.AwardItems = {}
    self.DownCardItems = {}
    self.CardItemLists = {}
    self.UidInCardList = {}
    self.PropItems = {}
    self.ElementsProp = {}
    self.DownElement = {}
    self.ChooseCardList = {}
    self.LimitCardNum = 0
    self.awardData = require("BountySystemManager"):GetInstance():ParaseAward(self.data.award)
    self.cfg = _G.ConfigManager.bounty_quest_cfg[data.sid]
    require("BountySystemManager"):GetInstance():UpdateCards()
    self.Cards = require("BountySystemManager"):GetInstance().Cards[0]
    self.callback = callback
    self.closeCallBack = closeCallback
    self:InitView()
    --_G.CommonUIEffect:GetInstance():DoScale(self.go_table.obj_window, true, 0.2)
end

---初始化任务界面
function BountyQuestView:InitView()
    self:InitCardRequirement()
    self.go_table.scrollloopvectical_CardList:InitItemData(0, _G.handler(self, self.RefreshCardItem))
    self:InitElement()
    self.go_table.aortext_content.text = _G.LangUtil.GetLangPackValue(self.cfg.desc)
    --  self.go_table.aortext_Title.text = _G.LangUtil.GetLangPackValue(self.cfg.name)
    self.go_table.aorbtn_start:SetGray(true)
    self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    _G.ColorTools.FormatColorByString("A9A9A9")
    self.go_table.aortext_tmp.color = _G.ColorTools.FormatColorByString("434343")
end
---初始化五行
function BountyQuestView:InitElement()
    self.ElementTb = _G.GetAutoGoTable(self.go_table.obj_Elements)
    self.toggleList = {}
    self:InitToggle()
    self.ElementTb.toggle_0.isOn = false
    self.ElementTb.toggle_0.isOn = true
end
function BountyQuestView:InitToggle()
    for i = 1, 7 do
        self.toggleList[i - 1] =
            _G.GetAutoGoTable(self.ElementTb["toggle_" .. (i - 1)], _G.handlerbind(self, self.OnClickElement, i - 1))
    end
end
---点击元素
function BountyQuestView:OnClickElement(go, isOn, type)
    local tb = self.toggleList[type]
    if go == tb.aorbtn_click then
        local data = require("BountySystemManager"):GetInstance().Cards[type] or {}
        if not data[1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(320114)
        else
            self.ElementTb["toggle_" .. type].isOn = true
        end
    else
        if not isOn then
            return
        end
        self:UpdateElements(type)
    end
end

---初始化要求
function BountyQuestView:InitCardRequirement()
    self.go_table.aorimage_limitIcon.SpriteName =
        require "BountySystemManager":GetInstance():GetLimitSp(self.cfg.condition_attribute[2])
    local order = require "CardInfoManager":GetInstance():GetOrderStarCount(self.cfg.condition_attribute[2])
    local attribute = _G.GetLangPackValue(attribute[order])
    self.go_table.aortext_limitDescribe.text = _G.GetLangPackValue(90022501375,
        self.cfg.condition_attribute[1],attribute)
    self:UpdateLimitCardNum()

    self:InitDownCard()
    self:InitPropRequirement()
end

---初始化属性的要求
function BountyQuestView:InitPropRequirement()
    for i = 1, #self.data.five_elements do
        _G.PoolsManager:GetInstance():Spawn(
            propPath,
            _G.ePoolType.Default,
            self.go_table.obj_PropRoot,
            function(trans)
                self.PropItems[i] = _G.GetAutoGoTable(trans)
                self.PropItems[i].aorimage_shuXing.SpriteName =
                    require "BountySystemManager":GetInstance():GetElementSp(self.data.five_elements[i])
                self.PropItems[i].isAdd = false
                self.PropItems[i].Element = self.data.five_elements[i]
                self.PropItems[i].obj_finish:SetActiveE(0)
                self.PropItems[i].obj_shuXing:SetActiveE(1)
                if not self.ElementsProp[self.data.five_elements[i]] then
                    self.ElementsProp[self.data.five_elements[i]] = 1
                else
                    self.ElementsProp[self.data.five_elements[i]] = self.ElementsProp[self.data.five_elements[i]] + 1
                end
            end
        )
    end
end

---初始化卡牌
function BountyQuestView:InitDownCard()
    local count = self.go_table.obj_CardRoot:GetChildCountE()
    for i = 1, count do
        if i <= self.cfg.condition_num then
            self.DownCardItems[i] =
                BountyCardItem.CreateCardItem(
                self.go_table.obj_CardRoot:GetChildE(i - 1),
                _G.handler(self, self.ClickDownCard)
            )
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_CardRoot:GetChildE(i - 1), i <= self.cfg.condition_num)
    end
end

---点击底部卡牌
---@param item BountyCardItem
function BountyQuestView:ClickDownCard(item)
    if item.CardData then
        local chooseItem = self.UidInCardList[item.CardData.uid]
        if not chooseItem or chooseItem.data.uid ~= item.CardData.uid then
            if item.CardData.star >= self.cfg.condition_attribute[2] then
                self.LimitCardNum = math.max(self.LimitCardNum - 1, 0)
                self:UpdateLimitCardNum()
            end
            self.ChooseCardList[item.CardData.uid] = nil
            ---更新属性
            self:UpdatePropDisplayer(item.CardData.cfg.Elements_new, false)
            self.go_table.aorbtn_start:SetGray(true)
            self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
            _G.ColorTools.FormatColorByString("A9A9A9")
            self.go_table.aortext_tmp.color =
            _G.ColorTools.FormatColorByString("434343")
            item:Init(nil)
            item.chooseItem = nil
        else
            self:RemoveCard(chooseItem)
        end
    end
end

---刷新右侧的卡牌
---@param listView2 SuperScrollView.LoopListView2
function BountyQuestView:RefreshCardItem(index, trans)
    index = index + 1
    local instance = trans:GetInstanceIDE()
    if not self.CardItemLists[instance] then
        self.CardItemLists[instance] =
            require "BoountyQuestCardItem".New(
            trans,
            _G.handler(self, self.OnClickCardItem),
            _G.handler(self, self.CheckIsChoose)
        )
    end
    self.CardItemLists[instance]:Show(self.ShowCardData[index])
    self.UidInCardList[self.ShowCardData[index].uid] = self.CardItemLists[instance]
end

---检测是否为选中的卡牌
function BountyQuestView:CheckIsChoose(uid)
    return self.ChooseCardList[uid] and self.ChooseCardList[uid] or 0
end

---更新满足条件的卡牌数量
function BountyQuestView:UpdateLimitCardNum()
    self.go_table.aortext_cardNum.text =
        math.min(self.LimitCardNum, self.cfg.condition_attribute[1]) .. "/" .. self.cfg.condition_attribute[1]
end

---点击右侧的卡牌
---@param item BaseAwardNewItem 卡牌
function BountyQuestView:OnClickCardItem(item)
    if self:CheckIsChoose(item.data.uid) > 0 then
        self:RemoveCard(item)
    else
        self:AddCard(item)
    end
end

---移除卡牌
---@param item BaseAwardItem 卡牌
---@param downItem BountyCardItem
function BountyQuestView:RemoveCard(item)
    item.cardIndex = self:CheckIsChoose(item.data.uid)
    if item.cardIndex > 0 then
        self.DownCardItems[item.cardIndex]:Init(nil)
        self.DownCardItems[item.cardIndex].chooseItem = nil
    end
    item.cardIndex = 0
    item.go_table.obj_choose:SetActiveE(0)
    self.ChooseCardList[item.data.uid] = nil
    if item.data.star >= self.cfg.condition_attribute[2] then
        self.LimitCardNum = math.max(self.LimitCardNum - 1, 0)
        self:UpdateLimitCardNum()
    end
    ---更新属性
    self:UpdatePropDisplayer(item.data.cfg.Elements_new, false)

    if item.cardIndex > 0 then
        self.DownCardItems[item.cardIndex]:Init(nil)
        self.DownCardItems[item.cardIndex].chooseItem = nil
    end
    self.go_table.aorbtn_start:SetGray(true)
    self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    _G.ColorTools.FormatColorByString("A9A9A9")
    self.go_table.aortext_tmp.color =
    _G.ColorTools.FormatColorByString("434343")
end

---添加卡牌
---@param item BaseAwardItem
function BountyQuestView:AddCard(item)
    local index = 0
    for i = 1, #self.DownCardItems do
        if self.DownCardItems[i].CardData == nil then
            index = i
            break
        end
    end
    if index == 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(350107)
        return
    end

    self.DownCardItems[index]:Init(item.data)
    self.DownCardItems[index].chooseItem = item
    item.cardIndex = index
    self.ChooseCardList[item.data.uid] = index
    item.go_table.obj_choose:SetActiveE(1)
    ---更新卡牌
    if item.data.star >= self.cfg.condition_attribute[2] then
        self.LimitCardNum = self.LimitCardNum + 1
        self:UpdateLimitCardNum()
    end
    ---更新属性
    self:UpdatePropDisplayer(item.data.cfg.Elements_new, true)
    local cards = {}
    for i = 1, #self.DownCardItems do
        if self.DownCardItems[i].CardData == nil then
            return
        end
        cards[#cards + 1] = self.DownCardItems[i].CardData
    end

    if self:CheckCards(cards) then
        self.go_table.aorbtn_start:SetGray(false)
        self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("FFFFFF")
        self.go_table.aortext_tmp.color =
        _G.ColorTools.FormatColorByString("8C2D14")
    end
end

---更新属性显示
---@param Elements number 元素ID
---@param isAdd boolean 是添加元素还是移除元素
function BountyQuestView:UpdatePropDisplayer(Elements, isAdd)
    for i = 1, #Elements do
        local Element = Elements[i]
        if not isAdd then
            self.DownElement[Element] = self.DownElement[Element] - 1
            if self.ElementsProp[Element] and self.DownElement[Element] >= self.ElementsProp[Element] then
                return
            end
        else
            if not self.DownElement[Element] then
                self.DownElement[Element] = 1
            else
                self.DownElement[Element] = self.DownElement[Element] + 1
            end
        end
    end

    for k, v in pairs(self.PropItems) do
        if require "CardInfoManager":GetInstance():CheckMultiMatch(v.Element,Elements) then
            if isAdd and not v.isAdd then
                v.isAdd = true
                v.obj_finish:SetActiveE(isAdd and 1 or 0)
                break
            elseif not isAdd and v.isAdd then
                v.isAdd = false
                v.obj_finish:SetActiveE(isAdd and 1 or 0)
                break
            end
        end
    end
end

---一键派遣
function BountyQuestView:DispatchAll()
    local Cards = self:GetDispathAll()
    if Cards ~= nil then
        Cards.Count = nil
    end
    if self:CheckCards(Cards) then
        self.DownElement = {}
        self.ChooseCardList = {}
        for i = 1, #self.DownCardItems do
            self.DownCardItems[i].CardData = nil
        end
        local index = 0
        for k, v in pairs(Cards) do
            self.DownCardItems[index + 1]:Init(v)
            self.ChooseCardList[v.uid] = index + 1
            index = index + 1
            self:UpdatePropDisplayer(v.cfg.Elements_new, true)
        end
        self:UpdateLimitCardNum()
        self.go_table.scrollloopvectical_CardList:UpdateAllItem()
        self.go_table.aorbtn_start:SetGray(false)
        self.go_table.aorbtn_start:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
        _G.ColorTools.FormatColorByString("FFFFFF")
        self.go_table.aortext_tmp.color = _G.Color.New(145 / 255, 72 / 255, 1 / 255, 1)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(350101)
    end
end

function BountyQuestView:GetDispathAll()
    local allCards = _G.DeepCopy(self.Cards)
    local cards = {}
    local requiredCards = {}
    local BountySystemManager= require "BountySystemManager":GetInstance()
    for key, v in pairs(allCards) do
        if not BountySystemManager:ChekcIsDispath(v.uid)then
            if not cards[v.star] then
                cards[v.star] = {}
            end
            cards[v.star][v.uid] = v
        end
    end

    local prop = _G.DeepCopy(self.data.five_elements)
    for k, v in pairs(cards) do
        if k >= self.cfg.condition_attribute[2] then
            for _2, v2 in pairs(v) do
                if self:CheckIsFiveElement(prop, v2.cfg.Elements_new, true) then
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #requiredCards >= self.cfg.condition_attribute[1] or #prop <= 0 then
                        break
                    end
                end
            end
            if #requiredCards >= self.cfg.condition_attribute[1] or #prop <= 0 then
                break
            end
        end
    end

    if self.cfg.condition_attribute[1] + #self.data.five_elements - self.cfg.condition_num > #requiredCards then
        return nil
    end

    if #requiredCards < self.cfg.condition_attribute[1] then
        for k, v in pairs(cards) do
            if k >= self.cfg.condition_attribute[2] then
                for _2, v2 in pairs(v) do
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #requiredCards >= self.cfg.condition_attribute[1] then
                        break
                    end
                end
            end
            if #requiredCards >= self.cfg.condition_attribute[1] then
                break
            end
        end
    end

    if #requiredCards < self.cfg.condition_attribute[1] then
        return nil
    end

    if #prop > 0 then
        for _, v in pairs(cards) do
            for _2, v2 in pairs(v) do
                if self:CheckIsFiveElement(prop, v2.cfg.Elements_new, true) then
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #prop <= 0 then
                        break
                    end
                end
            end
            if #prop <= 0 then
                break
            end
        end
    end

    if #prop > 0 then
        return nil
    end

    if #requiredCards < self.cfg.condition_num then
        for _, v in pairs(cards) do
            for _2, v2 in pairs(v) do
                _G.table.insert(requiredCards, v2)
                v[v2.uid] = nil
                if #requiredCards >= self.cfg.condition_num then
                    break
                end
            end
            if #requiredCards >= self.cfg.condition_num then
                break
            end
        end
    end

    if #requiredCards < self.cfg.condition_num then
        return nil
    end

    return requiredCards
end

---检测卡牌组合是否符合所需要的卡牌
---@param cards CardData[] 卡牌组合表
function BountyQuestView:CheckCards(cards)
    if cards == nil or _G.table.count(cards) < self.cfg.condition_num then
        return false
    end

    local prop = _G.DeepCopy(self.data.five_elements)
    local limitCardNum = 0
    for k, v in pairs(cards) do
        if v.star >= self.cfg.condition_attribute[2] then
            limitCardNum = limitCardNum + 1
        end
        if #prop > 0 then
            self:CheckIsFiveElement(prop, v.cfg.Elements_new, true)
        end
    end

    if #prop == 0 and limitCardNum >= self.cfg.condition_attribute[1] then
        self.LimitCardNum = limitCardNum
        return true
    else
        return false
    end
end

---检测是否为当前所需要的五行元素
---@param table  table<number>
---@param Elements_new number 元素
---@param isRemove boolean 是否移除元素
---@return boolean
function BountyQuestView:CheckIsFiveElement(table, Elements_new, isRemove)
    for _, v in pairs(table) do
        if require "CardInfoManager":GetInstance():CheckMultiMatch(v, Elements_new) then
            if isRemove then
                _G.table.remove(table, _)
            end
            return true
        end
    end
    return false
end

---开始镇压
function BountyQuestView:OnStart()
    local downCard = {}
    for i = 1, #self.DownCardItems do
        downCard[#downCard + 1] = self.DownCardItems[i].CardData
    end
    if not self:CheckCards(downCard) then
        _G.PopWindowManager:GetInstance():ShowAllTips(350105)
    else
        local tb = {}
        local card = {}
        tb.sid = self.data.sid
        tb.card_uid = {}
        for i = 1, #self.DownCardItems do
            tb.card_uid[#tb.card_uid + 1] = self.DownCardItems[i].CardData.uid

            card[#card + 1] = {
                sid = self.DownCardItems[i].CardData.sid,
                uid = self.DownCardItems[i].CardData.uid,
                star = self.DownCardItems[i].CardData.star
            }
        end

        require("BountySystemManager"):GetInstance():AcceptEvilTask(
            {tb},
            function(msg)
                if msg.ack == 1 then
                    if self.callback then
                        self.callback(msg, card)
                    end
                    self:CloseView()
                elseif msg.ack ~= 23 then
                    _G.PopWindowManager:GetInstance():ShowAllTips(350104)
                end
            end
        )
    end
end

function BountyQuestView:CloseView()
    if self.closeCallBack then
        self.closeCallBack()
    end
    self:Close()
end

function BountyQuestView:ShowLimit()
    self.go_table.obj_limitTips:SetActiveE(self.go_table.obj_limitTips:GetActiveSelf() == 0 and 1 or 0)
end

---切换不同的元素
function BountyQuestView:UpdateElements(Elements)
    if self.Elements == Elements then
        return
    end
    self.Elements = Elements
    self.ShowCardData = require("BountySystemManager"):GetInstance().Cards[self.Elements] or {}
    self.go_table.scrollloopvectical_CardList:UpdateCount(#self.ShowCardData)
end

---按钮点击事件在这里派发
function BountyQuestView:OnClickBtn(go, isOn)
    local name = go:GetName()
    if self.clickFunction[name] then
        self.clickFunction[name](self, go, isOn)
    end
end

return BountyQuestView
