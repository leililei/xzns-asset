---@class BountyBossCardView : UIBaseView	中文描述
---@field public go_table BountyBossCardView_GoTable GoTable
local BountyBossCardView = _G.BaseClass("BountyBossCardView", _G.UIBaseView)
--_G.BountyBossCardView = BountyBossCardView

function BountyBossCardView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function BountyBossCardView:OnCreate(data, checkCard, callback)
    self.RequirdCards = data
    self.CardItemLists = {}
    self.go_table.scrollloopvectical_kapai:InitItemData(0, _G.handler(self, self.RefreshCardItem))
    self.checkCard = checkCard
    self.callback = callback
    self:InitElement()
end

function BountyBossCardView:InitElement()
    self.ElementTb = _G.GetAutoGoTable(self.go_table.obj_Elements)
    self.toggleList = {}
    self:InitToggle()
    -- self.ElementTb.toggle_1.isOn = true
    self.ElementTb.toggle_0.isOn = true
end
function BountyBossCardView:InitToggle()
    for i = 1, 7 do
        self.toggleList[i - 1] =
            _G.GetAutoGoTable(self.ElementTb["toggle_" .. (i - 1)], _G.handlerbind(self, self.OnClickElement, i - 1))
    end
end
---点击元素
function BountyBossCardView:OnClickElement(go, isOn, type)
    local tb = self.toggleList[type]
    if go == tb.aorbtn_click then
        if self.Elements == type then
            return
        end
        local data = self.RequirdCards[type] or {}
        if not data[1] then
            _G.PopWindowManager:GetInstance():ShowAllTips(320114)
        else
            self.ElementTb["toggle_" .. type].isOn = true
        end
    else
        if not isOn then
            return
        end
        if self.Elements == type then
            return
        end
        self.Elements = type

        self.ShowCardData = self.RequirdCards[self.Elements] or {}
        self.go_table.scrollloopvectical_kapai:UpdateCount(#self.ShowCardData)
    end
end

function BountyBossCardView:RefreshCardItem(index, obj)
    index = index + 1
    local instance = obj:GetInstanceIDE()
    local tb = self.CardItemLists[instance]
    if not tb then
        tb = _G.GetAutoGoTable(obj)
        self.CardItemLists[instance] = tb
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.HeadItem_Select,
            tb.obj_node,
            function(item)
                tb.item = item
                tb.item:ShowCardData(self.ShowCardData[index], _G.handlerbind(self, self.OnClickCardItem, tb))
                tb.item:SetSelectGou(self.checkCard(self.ShowCardData[index].uid) > 0)
                -- _G.GameUtil.SetActiveByCondition(
                --     tb.item.go_table.aorimage_gou,
                --     self.checkCard(self.ShowCardData[index].uid) > 0
                -- )
                item.transform:SetLocalPosition(0,0,0)
            end
        )
    end
    tb.index = index
    if tb.item then
        tb.item:ShowCardData(self.ShowCardData[index], _G.handlerbind(self, self.OnClickCardItem, tb))
        tb.item:SetSelectGou(self.checkCard(self.ShowCardData[index].uid) > 0)
        -- _G.GameUtil.SetActiveByCondition(
        --     tb.item.go_table.aorimage_gou,
        --     self.checkCard(self.ShowCardData[index].uid) > 0
        -- )
    end
end

function BountyBossCardView:OnClickCardItem(tb)
    local data = self.ShowCardData[tb.index]
    self.callback(data)
    tb.item:SetSelectGou(self.checkCard(data.uid) > 0)
    -- _G.GameUtil.SetActiveByCondition(tb.item.go_table.aorimage_gou, self.checkCard(data.uid) > 0)
end

---按钮点击事件在这里派发
function BountyBossCardView:OnClickBtn(go, isOn)
    self:Close()
end

return BountyBossCardView
