local BaseGameNet = require("BaseGameNet")

---@class BountyNet : BaseGameNet 描述
---@field GetInstance fun():BountyNet
local BountyNet = _G.BaseClass("BountyNet", BaseGameNet)

---请求
---@param pbData table PB数据
---@param item net_map 网络协议
---@param callback function 完成回调
function BountyNet:GetData(pbData, item, callback)
    if pbData == nil then
        pbData = self:GetEmptyPB()
    end
    local port = BaseGameNet:Access(item, pbData, _G.handler(self, self.GetDataCall))
    self.Call[port] = callback
end
---获取贪字营数据
---@param callback function 完成回调
function BountyNet:GetBountyData(callback)
    local item = _G.ConfigManager.net_map.game_dispatch_info
    self:GetData(nil, item, callback)
end
---刷新恶灵任务
function BountyNet:RefreshEvilTask(callback)
    local item = _G.ConfigManager.net_map.game_dispatch_refresh
    self:GetData(nil, item, callback)
end

---接取恶灵任务
---@param pbData dispatch.s2c_dispatch_accept
function BountyNet:AcceptEvilTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_dispatch_accept
    self:GetData(pbData, item, callback)
end

---完成恶灵任务
---@param pbData dispatch.s2c_dispatch_finish
function BountyNet:FinishEvilTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_dispatch_finish
    self:GetData(pbData, item, callback)
end

---接取boss任务
------@param pbData dispatch.s2c_dispatch_accept_boss
function BountyNet:AcceptBossTask(pbData, callback)
    local item = _G.ConfigManager.net_map.game_dispatch_accept_boss
    self:GetData(pbData, item, callback)
end

---完成boss任务
function BountyNet:FinishBossTask(callback)
    local item = _G.ConfigManager.net_map.game_dispatch_finish_boss
    self:GetData(nil, item, callback)
end

---请求回调
---@param port number 中文描述
---@param data table 返回PB数据
---@param error string 错误信息
function BountyNet:GetDataCall(port, data, error)
    if error then
        if _G.AppSetting.DEBUG then
            _G.LogError("BountyNet :" .. error)
        end
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---析构函数
function BountyNet:Dispose()
end

---@return BountyNet
return BountyNet
