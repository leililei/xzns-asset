---@class BountyCardItemList	右侧卡牌列表
---@field CardItems BaseAwardItem[]
local BountyCardItemList = _G.BaseClass("BountyCardItemList")

local pinjieDic = {
    [1] = "ui_ty_kapai_pinjie1",
    [2] = "ui_ty_kapai_pinjie2",
    [3] = "ui_ty_kapai_pinjie3",
    [4] = "ui_ty_kapai_pinjie4"
}
---类的构造函数
function BountyCardItemList:__init()
end

---类的析构函数
function BountyCardItemList:Dispose()
end

---更新列表中卡牌的数据
---@param data CardData[] 卡牌数据
---@param index number 卡牌起始下标
function BountyCardItemList:UpdateList(data, index)
    for i = 1, self.CardItemCount do
        local tbIndex = i + (index - 1) * self.CardItemCount
        if tbIndex > #data then
            _G.GameUtil.SetActiveByCondition(self.CardItems[i].gameObject, false)
        else
            self.CardItems[i].data = data[tbIndex]
            self.CardItems[i].aortext_name.text = _G.LangUtil.GetLangPackValue(data[tbIndex].cfg.Name)
            self.checkCard(data[tbIndex].uid, self.CardItems[i])
            if self.CardItems[i].cardItem then
                self.CardItems[i].cardItem:ShowCardData(data[tbIndex])
            else
                _G.ItemCardFactory:GetInstance():GetItemCard(
                    _G.ItemCardFactory.itemCardType.CardAllItem,
                    self.CardItems[i].obj_Root,
                    function(item)
                        self.CardItems[i].cardItem = item
                        item:ShowCardData(data[tbIndex])
                    end
                )
            end
            if require "BountySystemManager":GetInstance():ChekcIsDispath(data[tbIndex].uid)then
                self.CardItems[i].aorbtn_Click:SetActiveE(0)
                self.CardItems[i].obj_mask:SetActiveE(1)
            else
                self.CardItems[i].aorbtn_Click:SetActiveE(1)
                self.CardItems[i].obj_mask:SetActiveE(0)
            end
            _G.GameUtil.SetActiveByCondition(self.CardItems[i].gameObject, true)
        end
    end
end

function BountyCardItemList:Awake()
    self.CardItems = {}
    self.CardItemCount = self.transform:GetChildCountE()
    self:InitCardItems()
end

---初始化列表中的卡牌
function BountyCardItemList:InitCardItems()
    for i = 1, self.transform:GetChildCountE() do
        local tb = _G.GetAutoGoTable(self.transform:GetChildE(i - 1))
        _G.AddViewBtnClick(tb.gameObject, _G.handlerbind(self, self.OnClickCard, tb))
        self.CardItems[i] = tb
    end
end

function BountyCardItemList:OnClickCard(go, isOn, tb)
    if self.callback then
        self.callback(tb)
    end
end
---初始化卡牌列表
function BountyCardItemList:CreateList(trans, callback, checkCard)
    local item = BountyCardItemList.New()
    item.gameObject = trans
    item.transform = trans
    item.callback = callback
    item.checkCard = checkCard
    item:Awake()
    return item
end

return BountyCardItemList
