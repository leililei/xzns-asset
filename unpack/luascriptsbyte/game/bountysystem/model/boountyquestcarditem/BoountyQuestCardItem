---@class BoountyQuestCardItem	中文描述
local BoountyQuestCardItem = _G.BaseClass("BoountyQuestCardItem")

---类的构造函数
function BoountyQuestCardItem:__init(obj, callback, checkCard)
    self.gameObject = obj
    self.transform = obj
    self.callback = callback
    self.checkCard = checkCard
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end
---更新显示
---@param data CardData
function BoountyQuestCardItem:Show(data)
    self.data = data
    if not self.item then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.item = item
                item:ShowCardData(self.data, nil, true, true)
            end
        )
    else
        self.item:ShowCardData(self.data, nil, true, true)
    end
    _G.GameUtil.SetActiveByCondition(
        self.go_table.obj_mask,
        require "BountySystemManager":GetInstance():ChekcIsDispath(self.data.uid)
    )
    _G.GameUtil.SetActiveByCondition(self.go_table.obj_choose, self.checkCard(self.data.uid) > 0)
end

function BoountyQuestCardItem:OnClickBtn(go, isOn)
    if require "BountySystemManager":GetInstance():ChekcIsDispath(self.data.uid) then
        return
    end
    if self.callback then
        self.callback(self)
    end
end

---类的析构函数
function BoountyQuestCardItem:Dispose()
end

return BoountyQuestCardItem
