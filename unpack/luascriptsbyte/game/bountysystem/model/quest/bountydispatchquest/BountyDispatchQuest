---@class BountyDispatchQuest	需要派遣任务
local BountyDispatchQuest = _G.BaseClass("BountyDispatchQuest")

---底部属性的预设体路径
local propPath = "UIH5/Bounty/$_obj_prop"

local colorType = {
    "1461A8",
    "612B8B",
    "D2510B",
    "C62121",
    "EDC23F",
    "B381FF"
}
---初始化任务数据
---@param data BountyQuestData[] 恶灵任务数据
function BountyDispatchQuest:InitData(data)
    self.isInited = false
    if data == nil then
        return
    end
    self.questData = data
    self.questData:BindBountyQuestBase(self)
    ---品级
    self:UpdateLv()
    ---名字
    self.go_table.aortext_Name.text =
        _G.string.AddColor(_G.LangUtil.GetLangPackValue(self.questData.cfg.name), colorType[self.questData.cfg.grade])
    self.go_table.aortext_Intelligence.text = self.questData.cfg.points
    -- self:InitProp()
    self.go_table.aorimage_Choose:SetActiveE(1)
    self.go_table.toggle_Choose.isOn = data.isChoose
    -- self:UpdateCardLimit()
    -- self:UpdateCard()
    self.awardData = require("BountySystemManager"):GetInstance():ParaseAward(self.questData.mission.award)
    self.go_table.scrollloophorizontal_Award:UpdateCount(#self.awardData)
    self.go_table.aortext_taskTime.text = self:TimeToString(self.questData.cfg.duration)
    self.isInited = true
    data.taskState = 1
end

---将时间转换
---@return string
function BountyDispatchQuest:TimeToString(time)
    local str = string.split(_G.TimeUtil.TimeToString(time, 1), ":")
    local hour = tonumber(str[1])
    local min = tonumber(str[2])
    local sec = tonumber(str[3])
    if hour > 0 then
        if min > 0 then
            hour = hour + 1
        end
        return _G.GetLangPackValue(90000011448, hour)
    end
    return ""
end

function BountyDispatchQuest:UpdateCardLimit()
    self.go_table.aorimage_limitIcon.SpriteName =
        require "BountySystemManager":GetInstance():GetLimitSp(self.questData.cfg.condition_attribute[2])
    self.go_table.aortext_count.text =
        self.questData.cfg.condition_attribute[1] .. "/" .. self.questData.cfg.condition_attribute[1]
end

function BountyDispatchQuest:UpdateCard()
    local count = #self.CardList
    local count2 = #self.questData.mission.card
    if count < count2 then
        for i = count + 1, count2 do
            _G.ItemCardFactory:GetInstance():GetItemCard(
                _G.ItemCardFactory.itemCardType.CardAllItem,
                self.go_table.trans_cardList,
                function(item)
                    self.CardList[i] = item
                    local data =
                        _G.StorageManager:GetInstance():GetItemDataByID(
                        _G.StorageID.Card,
                        self.questData.mission.card[i].uid
                    )
                    item:ShowCardData(data)
                    item.transform:SetLocalScale(0.47, 0.47, 0.47)
                end
            )
        end
    end
    for i = 1, count do
        local item = self.CardList[i]
        if i <= count2 then
            local data =
                _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, self.questData.mission.card[i].uid)
            item:ShowCardData(data)
            _G.GameUtil.SetActiveByCondition(item.gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(item.gameObject, false)
        end
    end
end

---更新品级
function BountyDispatchQuest:UpdateLv()
    for i = 1, 10 do
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_lv:GetChildE(i - 1), i <= self.questData.cfg.grade)
    end
end

---初始化属性要求
function BountyDispatchQuest:InitProp()
    local count = #self.PropItems
    local count2 = #self.questData.mission.five_elements
    if count < count2 then
        for i = count + 1, count2 do
            _G.PoolsManager:GetInstance():Spawn(
                propPath,
                _G.ePoolType.Default,
                self.go_table.trans_elementList,
                function(trans)
                    self.PropItems[i] = _G.GetAutoGoTable(trans)
                    self.PropItems[i].aorimage_shuXing.SpriteName =
                        require "BountySystemManager":GetInstance():GetElementSp(
                        self.questData.mission.five_elements[i]
                    )
                    self.PropItems[i].isAdd = false
                    self.PropItems[i].Element = self.questData.mission.five_elements[i]
                    self.PropItems[i].obj_finish:SetActiveE(1)
                    self.PropItems[i].obj_shuXing:SetActiveE(1)
                end
            )
        end
    end
    for i = 1, count do
        local tb = self.PropItems[i]
        if i <= count2 then
            self.PropItems[i].aorimage_shuXing.SpriteName =
                require "BountySystemManager":GetInstance():GetElementSp(self.questData.mission.five_elements[i])
            self.PropItems[i].isAdd = false
            self.PropItems[i].Element = self.questData.mission.five_elements[i]
            _G.GameUtil.SetActiveByCondition(tb.gameObject, true)
        else
            _G.GameUtil.SetActiveByCondition(tb.gameObject, false)
        end
    end
end

function BountyDispatchQuest:OnClickBtn(go, isOn)
    if not self.isInited then
        return
    end
    self.questData.isChoose = isOn
    if self.callback then
        self.callback(self.questData, isOn)
    end
end

function BountyDispatchQuest:Awake()
    _G.AddViewBtnClick(self.gameObject, _G.handler(self.gameObject, self.OnClickBtn))
end

---更新奖励
---@param data BountyAward[]
function BountyDispatchQuest:UpdateAward(index, obj)
    local instance = obj:GetInstanceIDE()
    local item = self.AwardItems[instance]
    local data = self.awardData[index + 1]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 88)
        self.AwardItems[instance] = item
    end
    local arr = {}
    table.insert(arr, data.sid)
    table.insert(arr, data.number)
    item:ShowWithID(arr)
end

---创建任务实例
---@param go UnityEngine.GameObject
---@param callback function 派遣后的回调
---@return BountyDispatchQuest
function BountyDispatchQuest.CreateItem(go, callback)
    local item = BountyDispatchQuest.New()
    item.gameObject = go
    item.transform = go
    item.go_table = _G.GetAutoGoTable(go, _G.handler(item, item.OnClickBtn))
    item.callback = callback
    item.PropItems = {}
    item.CardList = {}
    item.AwardItems = {}
    item.go_table.scrollloophorizontal_Award:InitItemData(0, _G.handler(item, item.UpdateAward))
    return item
end

return BountyDispatchQuest
