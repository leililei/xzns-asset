function BountyQuestBase:GetTime(name)
    local ac = self.animator.runtimeAnimatorController
    local clips = ac and ac.animationClips or nil
    if not clips then
        return 0
    end
    for i = 0, clips.Length - 1 do
        if not _G.IsNil(ac.animationClips[i]) and ac.animationClips[i]:GetName() == name then
            return ac.animationClips[i].length
        end
    end
    return 0
end

function BountyQuestBase:DelayDo(time, call)
    if not self.DelayTb then
        self.DelayTb = {}
    end
    self.DelayTb[call] = {
        co = _G.DelayDo(
            time,
            function()
                self.DelayTb[call] = nil
                call()
            end
        ),
        call=call
    }
end

