---开始任务
function BountyQuestBase:OnStart()
    _G.GameUtil.SetActiveByCondition(self.go_table.slider_Timer, true)
    self.go_table.slider_Timer.maxValue = self.questData.cfg.duration
    self.go_table.slider_Timer.value = 0
    self:UpdateBtn()
    self:PlayLight()
    if self.acceptCallback then
        self.acceptCallback(self.questData.id)
    end
end

---创建任务实例
---@param obj UnityEngine.GameObject 物体
---@param finshCallback function  完成任务回调
function BountyQuestBase.CreateBountyQuest(obj, acceptCallback, finshCallback, sortCallBack, view)
    local item = BountyQuestBase.New()
    item.gameObject = obj
    item.transform = obj
    item.go_table = _G.GetAutoGoTable(obj)
    item.finshCallback = finshCallback
    item.acceptCallback = acceptCallback
    item.sortCallBack = sortCallBack
    item.animator = item.go_table.obj_content:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    item.canvasGroup = item.go_table.obj_content:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
    _G.AddViewBtnClick(item.gameObject, _G.handler(item, item.OnClickBtn))
    item.view = view
    item.go_table.scrollloophorizontal_Award:InitItemData(0, _G.handler(item, item.UpdateAward))
    return item
end

function BountyQuestBase:Dispose()
    if self.timer then
        self.timer:Stop()
    end
    self:StopAni()
end

function BountyQuestBase:StopAni()
    if self.DelayTb then
        for _, v in pairs(self.DelayTb) do
            _G.coroutine.stopwaiting(v.co)
            if v.call then
                v.call()
            end
        end
        self.DelayTb = nil
    end
end

---@return BountyQuestBase
return BountyQuestBase
