---初始化任务数据
function BountyQuestBase:InitData(index, isNew, isNotInited, isUnDispath)
    if index == nil or index <= 0 then
        return
    end
    self:StopAni()
    self.index = index
    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
    self.questData = require "BountySystemManager":GetInstance():GetQuestDataWithIndex(index)
    if not self.questData or (self.questData and not self.questData.cfg) then
        return
    end
    self.questData:BindBountyQuestBase(self)
    ---品级
    self:UpdateLv()
    ---名字
    self.go_table.aortext_Name.text =
        _G.string.AddColor(GetLangPackValue(self.questData.cfg.name), colorType[self.questData.cfg.grade])
    self.go_table.aortext_Intelligence.text = self.questData.cfg.points
    self.go_table.slider_Timer.maxValue = self.questData.cfg.duration
    self:InitTime()
    self:UpdateBtn()
    self:InitEffect(isNew)
    self.awardData = require("BountySystemManager"):GetInstance():ParaseAward(self.questData.mission.award)
    self.go_table.scrollloophorizontal_Award:UpdateCount(#self.awardData)
    if not isNotInited then
        if isNew then
            if self.effect then
                _G.GameUtil.SetActiveByCondition(self.effect, true)
            end
            self.animator.enabled = true
            _G.DelayDo(
                0.1,
                function()
                    if _G.IsNil(self.gameObject) then
                        return
                    end
                    _G.GameUtil.SetActiveByCondition(self.gameObject, false)
                    _G.GameUtil.SetActiveByCondition(self.gameObject, true)
                end
            )
        else
            if self.effect then
                _G.GameUtil.SetActiveByCondition(self.effect, false)
            end
            self.animator.enabled = false
            self.go_table.obj_content:SetAnchorPosition(0, 0, 0)
            self.canvasGroup.alpha = 1
            if isUnDispath then
                self:PlayUnDispathEffect()
            end
        end
    end
    if self.questData.cfg.duration - self.questData.RTS <= 1 then
        self:PlayLight()
    end
    if self.gameObject:GetActiveSelf() == 0 then
        _G.GameUtil.SetActiveByCondition(self.gameObject, true)
    end
end
