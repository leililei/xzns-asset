function BountyQuestBase:OnClickBtn(go, isOn)
    local name = go:GetName()
    if name == "@_aorbtn_dispath" then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyQuestView.Name,
            self.questData.mission,
            function(msg, card)
                require("BountySystemManager"):GetInstance():RefreshAllQuest(msg, card)
            end,
            function()
                self:UpdateBtn()
            end
        )
    elseif name == "@_aorbtn_getAward" then
        self:OnFinshTask()
    end
end

---完成任务
function BountyQuestBase:OnFinshTask()
    if self.finshCallback then
        self.finshCallback(self.questData, self)
    end
end

