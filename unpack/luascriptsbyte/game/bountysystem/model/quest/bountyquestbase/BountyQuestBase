function BountyQuestBase:UpdateBtn()
    if self.questData.taskState == BountyEnum.BountyQuestStateEnum.DNS then
        _G.GameUtil.SetActiveByCondition(self.go_table.slider_Timer, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_unTask, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_dispath, true)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_getAward, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_wait, false)
    else
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_dispath, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_wait, false)
        if self.questData.taskState == BountyEnum.BountyQuestStateEnum.Running then
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_getAward, false)
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_wait, true)
        else
            _G.GameUtil.SetActiveByCondition(self.go_table.aorbtn_getAward, true)
        end
        _G.GameUtil.SetActiveByCondition(self.go_table.obj_unTask, false)
        _G.GameUtil.SetActiveByCondition(self.go_table.slider_Timer, true)
    end
    self:UpdateSlider()
end

function BountyQuestBase:UpdateSlider()
    self.go_table.slider_Timer.value = self.questData.cfg.duration - self.questData.RTS
end

function BountyQuestBase:InitTime()
    ---剩余时间
    if self.questData.taskState ~= BountyEnum.BountyQuestStateEnum.DNS then
        if self.questData.taskState == BountyEnum.BountyQuestStateEnum.Running then
            self.go_table.aortext_Slider.text = _G.TimeUtil.TimeToString(self.questData.RTS, 1)
        else
            self.go_table.aortext_Slider.text = GetLangPackValue(90022500355)
        end
    else
        self.go_table.aortext_Slider.text = _G.TimeUtil.TimeToString(self.questData.cfg.duration, 1)
        self.go_table.aortext_taskTime.text = self:TimeToString(self.questData.cfg.duration)
    end
end

---更新奖励
---@param data BountyAward[]
function BountyQuestBase:UpdateAward(index, obj)
    local instance = obj:GetInstanceIDE()
    local item = self.AwardItems[instance]
    local data = self.awardData[index + 1]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 73)
        self.AwardItems[instance] = item
    end
    item:Show(_G.StorageManager:GetInstance():GetItemDataClass(data.sid, data.number, data))
end

---更新倒计时
function BountyQuestBase:UpdateTimer(time)
    self.go_table.aortext_Slider.text = time
    self:UpdateSlider()
end

---将时间转换
---@return string
function BountyQuestBase:TimeToString(time)
    local str = string.split(_G.TimeUtil.TimeToString(time, 1), ":")
    local hour = tonumber(str[1])
    local min = tonumber(str[2])
    local sec = tonumber(str[3])
    if hour > 0 then
        if min > 0 then
            hour = hour + 1
        end
        return hour .. GetLangPackValue(90022500435)
    elseif min > 0 then
        if sec > 0 then
            min = min + 1
        end
        return min .. GetLangPackValue(90022500434)
    else
        return sec .. GetLangPackValue(90022500438)
    end
end

