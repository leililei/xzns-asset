---@class BountyCardItem	贪字营卡牌列表中的卡牌
---@field callFunction function 点击回调
---@field CardData CardData 卡牌数据
local BountyCardItem = _G.BaseClass("BountyCardItem")

function BountyCardItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end
function BountyCardItem:Init(data)
    if data == nil then
        self:DisplayerBG()
        self.CardData = data
        return
    end
    if self.CardData and self.CardData.uid == data.uid then
        return
    end
    self.CardData = data
    self:DisplayerCard()
end

function BountyCardItem:DisplayerBG()
    self.go_table.obj_Add:SetActiveE(1)
    self.go_table.obj_cardInfo:SetActiveE(0)
end

function BountyCardItem:DisplayerCard()
    if not self.cardItem then
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            self.go_table.obj_Root,
            function(item)
                self.cardItem = item
                item:ShowCardData(self.CardData, nil, true, true)
            end
        )
    else
        self.cardItem:ShowCardData(self.CardData, nil, true, true)
    end
    self.go_table.obj_Add:SetActiveE(0)
    self.go_table.obj_cardInfo:SetActiveE(1)
end

function BountyCardItem:OnClickBtn()
    if self.callFunction then
        self:callFunction(self)
    end
end

function BountyCardItem:Clear()
    self.CardData = nil
    self:DisplayerBG()
end

---创建卡牌实例
---@param go UnityEngine.GameObject
---@param callback function<BountyCardItem>
---@param chooseFunction function<number>
---@return BountyCardItem
function BountyCardItem.CreateCardItem(go, callback, chooseFunction)
    local item = BountyCardItem.New()
    item.gameObject = go
    item.transform = go
    item.callFunction = callback
    item:Awake()
    return item
end
return BountyCardItem
