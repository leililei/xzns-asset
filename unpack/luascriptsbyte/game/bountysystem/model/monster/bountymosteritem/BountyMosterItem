local BountyEnum = require "BountyEnum"
---@class BountyMosterItem	Map怪物
---@field data  dispatch.i_evil_spirit_mission
---@field cfg bounty_quest_cfg_Item
---@field taskState BountyEnum.BountyQuestStateEnum 任务状态
---@field questItem BountyQuestBase 任务
local BountyMosterItem = _G.BaseClass("BountyMosterItem")

local CS = _G.CS
local typeof = _G.typeof
local GetLangPackValue = _G.GetLangPackValue
local MosterType = {
    Normale = 101,
    Boss = 102
}
local MosterLevel = {
    "ui_tzy_img_bai",
    "ui_tzy_img_bai",
    "ui_tzy_img_lv",
    "ui_tzy_img_lan",
    "ui_tzy_img_zi",
    "ui_tzy_img_cheng"
}
local MosterBG = {
    "ui_tzy_img_CDE",
    "ui_tzy_img_B",
    "ui_tzy_img_A",
    "ui_tzy_img_S"
}
---初始化数据
---@param data BountyQuestData 任务数据
---@param type BountyEnum.BountyQuestStateEnum 当前处于什么状态
function BountyMosterItem:InitData(data, isShow)
    if data == nil then
        if self.gameObject:GetActiveSelf() == 1 then
            self.gameObject:SetActiveE(0)
        end
        if self.Monster.aorimage_Bg:GetActiveSelf() == 1 then
            self.Monster.aorimage_Bg:SetActiveE(0)
        end
        return
    end
    self.data = data
    self.data:BindMonster(self)
    self.cfg = data.cfg
    self.isShow = isShow
    self:ShowEffect()
end

function BountyMosterItem:ShowEffect()
    if self.Monster then
        _G.GameUtil.SetActiveByCondition(self.Monster.gameObject, true)
        self:UpdateEffect()
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.EF_bounty_monster,
            self.go_table.obj_EffectRoot,
            function(trans)
                self.Monster = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
                self.Monster.aortext_Name:SetParentE(self.Monster.aorimage_Bg)
                self.Monster.aorrawimage_icon:SetLocalScaleXYZ(2, 2, 2)

                self:UpdateEffect()
                self.changeNameTimer =
                    _G.TimerManager:GetInstance():GetTimer(
                    2,
                    self.ChangeNameFunc,
                    self,
                    true,
                    false,
                    true
                )
                self.changeNameTimer:Start()
            end,
            function(trans)
                _G.GameUtil.SetActiveByCondition(self.Monster.gameObject, false)
            end
        )
    end
end

function BountyMosterItem:ChangeNameFunc()
    self.changeName(self.Monster.aorimage_Bg)
    self.changeNameTimer = nil
end

---更新特效显示
function BountyMosterItem:UpdateEffect()
    if self.data == nil then
        return
    end
    self.Monster.aorimage_LvBg.SpriteName = MosterLevel[self.cfg.grade]
    self.transform:SetLocalPosition(self.cfg.coordinates[1], self.cfg.coordinates[2], self.cfg.coordinates[3])
    self.Monster.aorimage_Lv.SpriteName = require("BountySystemManager"):GetInstance():GetLevelSpName(self.cfg.grade)
    self.Monster.aorimage_Lv:SetNativeSize()
    self.Monster.aorrawimage_icon:LoadImage(
        self.cfg.monster,
        function()
            if not self.gameObject:GetActiveSelf() == 1 and not self.isShow then
                self.gameObject:SetActiveE(1)
                self.Monster.aorimage_Bg:SetActiveE(1)
                self.isShow = nil
            end
        end
    )
    self.Monster.aorrawimage_icon:SetAnchorPosition(self.cfg.misson_portrait[1], self.cfg.misson_portrait[2])
    self.Monster.aorimage_Bg.SpriteName = MosterBG[math.max(self.cfg.grade - 2, 1)]

    if self.data.taskState == BountyEnum.BountyQuestStateEnum.Award then
        self.Monster.aortext_Name.text = GetLangPackValue(90022500355)
    elseif self.data.taskState == BountyEnum.BountyQuestStateEnum.Running then
        self.Monster.aortext_Name.text = _G.TimeUtil.TimeToString(self.data.RTS, 1)
    else
        self.Monster.aortext_Name.text = GetLangPackValue(self.cfg.name)
    end
    local x, y, z = self.go_table.obj_pos:GetPosition()
    self.Monster.aorimage_Bg:SetPosition(x, y, z)
end

---开始任务
function BountyMosterItem:StartTask()
    self.Monster.aortext_Name.text = _G.TimeUtil.TimeToString(self.data.RTS, 1)
end

---完成任务
function BountyMosterItem:FinshTask()
    self.Monster.aortext_Name.text = GetLangPackValue(90022500355)
end

---更新任务时间
function BountyMosterItem:UpdateTime(time)
    self.Monster.aortext_Name.text = time
end

function BountyMosterItem:OnClickBtn(go, isOn)
    if self.data.taskState == BountyEnum.BountyQuestStateEnum.DNS then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyQuestView.Name,
            self.data.mission,
            function(time, card)
                self.data:StartTask(time, card)
            end
        )
    elseif self.data.taskState == BountyEnum.BountyQuestStateEnum.Award then
        if self.finishCallback then
            self.finishCallback(
                self.data,
                _G.Vector3.New(self.transform:GetLocalPosition()),
                function()
                    self.questItem:Clear()
                end
            )
        end
    end
end

function BountyMosterItem:Clear()
    if self.changeNameTimer then
        self.changeNameTimer:Stop()
        self.changeNameTimer = nil
    end
    self.data = nil
    self.gameObject:SetActiveE(0)
    self.Monster.aorimage_Bg:SetActiveE(0)
end

function BountyMosterItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建怪物实例
function BountyMosterItem.CreateItem(trans, finishCallback, changeName)
    local item = BountyMosterItem.New()
    item.gameObject = trans
    item.transform = trans
    item.finishCallback = finishCallback
    item.changeName = changeName
    item:Awake()
    return item
end
return BountyMosterItem
