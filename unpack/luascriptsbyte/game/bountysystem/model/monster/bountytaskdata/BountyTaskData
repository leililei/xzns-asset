---@class BountyTaskData	中文描述
---@field mission  dispatch.i_evil_spirit_mission
local BountyTaskData = _G.BaseClass("BountyTaskData")

---类的构造函数
---@param mission dispatch.i_evil_spirit_mission
function BountyTaskData:__init(mission)
    self:ParseData(mission)
end

---@param mission dispatch.i_evil_spirit_mission
function BountyTaskData:ParseData(mission)
    self.mission = mission
    self.cfg = _G.ConfigManager.bounty_quest_cfg[mission.sid]
    self:InitTimer()
end

function BountyTaskData:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.mission.time > 0 then
        local endTime = self.mission.time + self.cfg.duration
        local time = _G.TimeUtil.GetServerUnixTime()
        self.RTS = endTime - time
        if self.RTS > 0 then
            self.timer = _G.TimerManager:GetInstance():GetTimer(self.RTS, self.TimeOver, self, true, false, true)
            self.timer:Start()
        end
    else
        self.RTS = 0
    end
end

function BountyTaskData:TimeOver()
    self.RTS = 0
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BountyLobby.id, self.mission.sid)
    require "RedPointManager":GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.BountyLobby.id, 1)
end

---类的析构函数
function BountyTaskData:Dispose()
    require "RedPointManager":GetInstance():RemoveRedPointParam(
        _G.ConfigManager.redpoint_cfg.BountyLobby.id,
        self.mission.sid
    )
    self.mission = nil
    self.cfg = nil
    self.RTS = nil
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return BountyTaskData
