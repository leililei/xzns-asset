local BountyEnum = require "BountyEnum"
---@class BountyQuestData	中文描述
---@field mission dispatch.i_evil_spirit_mission 恶灵任务数据
---@field cfg bounty_quest_cfg_Item 配置表任务数据
---@field taskState BountyEnum.BountyQuestStateEnum 任务当前状态
---@field timer Timer 任务计时
---@field RTS number 任务的剩余时间
---@field isChoose boolean 是否被选中
---@field questBase BountyQuestBase 任务物体
---@field monster BountyMosterItem 地图上显示的任务
local BountyQuestData = _G.BaseClass("BountyQuestData")
_G.BountyQuestData = BountyQuestData

---类的构造函数
function BountyQuestData:__init()
    self.mission = nil
    self.UpdateTimeCall = {}
    self.FinshCall = {}
    self.isChoose = false
    self.monster = nil
end

---初始化数据
---@param  data dispatch.i_evil_spirit_mission 恶灵任务数据
function BountyQuestData:InitData(data)
    self.id = data.sid
    self.mission = data
    self.cfg = _G.ConfigManager.bounty_quest_cfg[data.sid]
    self:InitTaskEnum()
    if self.monster then
        self.monster:InitData(self)
    end
end

---初始化任务状态
function BountyQuestData:InitTaskEnum()
    if self.timer then
        self.timer:Stop()
    end
    if self.mission.time > 0 then
        self.RTS = self.cfg.duration - math.max(_G.TimeUtil.GetServerUnixTime() - self.mission.time, 0)
        if self.RTS > 0 then
            self.taskState = BountyEnum.BountyQuestStateEnum.Running
            self:InitTimer()
        else
            self.taskState = BountyEnum.BountyQuestStateEnum.Award
        end
    else
        self.RTS = 0
        self.taskState = BountyEnum.BountyQuestStateEnum.DNS
    end
end

---初始化计时器
function BountyQuestData:InitTimer()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end
---#region 任务开始
function BountyQuestData:StartTask(time, cards, isDispatch)
    self.mission.time = time
    self.mission.card = cards
    self.RTS = self.mission.time + self.cfg.duration - _G.TimeUtil.GetServerUnixTime()
    self.taskState = BountyEnum.BountyQuestStateEnum.Running
    if not isDispatch then
        if self.questBase then
            self.questBase:OnStart()
        end
    end
    self:InitTimer()
    require("BountySystemManager"):GetInstance():AddDispath(cards)
    require("BountySystemManager"):GetInstance():ChangeTaskData(self.mission.sid)
end

---绑定任务
---@param questBase BountyQuestBase
function BountyQuestData:BindBountyQuestBase(questBase)
    self.questBase = questBase
    self.sortCall = questBase.sortCallBack
end

---#endregion

---更新时间
function BountyQuestData:UpdateTime(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.timer:Stop()
        self.timer = nil
        self.taskState = BountyEnum.BountyQuestStateEnum.Award
        if self.questBase then
            self.questBase:TimerOver()
        end
        if self.sortCall then
            self.sortCall()
        end
        return
    end
    local timer = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.RTS), 1)
    if self.questBase then
        self.questBase:UpdateTimer(timer)
    end
end

function BountyQuestData:Clear()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.questBase = nil
    self.taskState = BountyEnum.BountyQuestStateEnum.DNS
    self.mission = nil
end

---清楚数据
function BountyQuestData:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.questBase then
        self.questBase:Clear()
    end
    self.questBase = nil
    self.taskState = BountyEnum.BountyQuestStateEnum.DNS
    self.mission = nil
end

return BountyQuestData
