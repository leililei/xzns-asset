local BountyEnum = require "BountyEnum"
---@class BountyBossItem	贪字营地图Boss
---@param data dispatch.s2c_dispatch_info
local BountyBossItem = _G.BaseClass("BountyBossItem")

local CS = _G.CS
local typeof = _G.typeof

---类的构造函数
function BountyBossItem:__init()
end

---类的析构函数
function BountyBossItem:Dispose()
    if self.timer then
        self.timer:Stop()
    end
    self.timer = nil
end

---@param data dispatch.s2c_dispatch_info
function BountyBossItem:init(data)
    self.data = data

    if self.data.boss.boss_status == 0 then
        if self.gameObject:GetActiveSelf() == 1 then
            self.gameObject:SetActiveE(0)
        end
        return
    end

    self:ShowEffect()
end

function BountyBossItem:ShowEffect()
    if self.Monster then
        self:UpdateEffect()
    else
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.EF_bounty_monsterBoss,
            (self.go_table.obj_EffectRoot),
            function(trans)
                self.Monster = _G.GetAutoGoTable(trans, _G.handler(self, self.OnClickBtn))
                self.Monster.aortext_Name:SetParentE((self.Monster.aorimage_Bg))
                self:UpdateEffect()
            end
        )
    end
end

function BountyBossItem:UpdateEffect()
    if self.data == nil then
        return
    end
    if not self.gameObject:GetActiveSelf() == 1 then
        self.gameObject:SetActiveE(1)
    end
    self.cfg = _G.ConfigManager.bounty_level_cfg[self.data.level]
    self.TimerItem = _G.GetAutoGoTable(self.go_table.obj_TimerItem)
    if self.data.boss.boss_start_time == 0 then
        self.go_table.obj_box:SetActiveE(0)
        self.go_table.obj_EffectRoot:SetActiveE(1)
        self.TimerItem.gameObject:SetActiveE(0)
        self.taskState = BountyEnum.BountyQuestStateEnum.DNS
    else
        if self.cfg.duration > _G.TimeUtil.GetServerUnixTime() - self.data.boss.boss_start_time then
            self.go_table.obj_EffectRoot:SetActiveE(0)
            self.go_table.obj_box:SetActiveE(0)
            self.TimerItem.gameObject:SetActiveE(1)
            self:AcceptTask()
        else
            self.taskState = BountyEnum.BountyQuestStateEnum.Award
            self.go_table.obj_EffectRoot:SetActiveE(0)
            self.TimerItem.gameObject:SetActiveE(0)
            self.go_table.obj_box:SetActiveE(1)
        end
    end
    -- self.Monster.aorimage_LvBg.SpriteName = "ui_tzy_img_hong"
    -- self.Monster.aorimage_LvBg:SetNativeSize()
    self.Monster.obj_mask:SetLocalScaleXYZ(1.25)
    -- self.Monster.obj_levelBg:SetActiveE(0)
    self.transform:SetLocalPosition(self.cfg.bosscoordinates[1], self.cfg.bosscoordinates[2], 0)
    ---@type card_cfg
    local cfg = _G.ConfigManager.card_cfg[self.cfg.cardid]
    if cfg then
        self.Monster.aorrawimage_icon:LoadImage(cfg.icon_rhom)
        self.Monster.aortext_Name.text = _G.LangUtil.GetLangPackValue(cfg.Name)
    --self.go_table.aorrawimage_icon:SetLocalScaleXYZ(1.75)
    end
    --self.effect.enabled = false
    -- self.Monster.aorimage_Bg.SpriteName = "ui_tzy_img_S"
end

function BountyBossItem:UpdateTimer()
    self.TimerItem.aortext_Left.text = _G.TimeUtil.TimeToString(Mathf.RoundToInt(self.left), 1)
end

function BountyBossItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

function BountyBossItem:OnClickBtn(go, isOn)
    if self.taskState == BountyEnum.BountyQuestStateEnum.Running then
        return
    end
    if self.taskState == BountyEnum.BountyQuestStateEnum.DNS then
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.BountyBossView.Name,
            self.data.level,
            self.data.boss,
            _G.handler(self, self.AcceptTask)
        )
    else
        self.data.boss.boss_start_time = 0
        self.data.boss.boss_status = 0
        self.data.boss.card_uid = {}
        self.taskState = BountyEnum.BountyQuestStateEnum.DNS
        require("BountySystemManager"):GetInstance():FinshBossTask(self.finishCallback)
    end
end

function BountyBossItem:AcceptTask()
    self.taskState = BountyEnum.BountyQuestStateEnum.Running
    self.go_table.obj_EffectRoot:SetActiveE(0)
    self.TimerItem.gameObject:SetActiveE(1)
    self.left = self.cfg.duration - math.max(_G.TimeUtil.GetServerUnixTime() - self.data.boss.boss_start_time, 0)
    self:UpdateTimer()
    self.timer =
        _G.TimerManager:GetInstance():GetTimer(
        1,
        self.TimerFunc,
        self,
        false,
        false,
        true
    )
    self.timer:Start()
end

function BountyBossItem:TimerFunc(elapsed)
    self.left = self.left - elapsed
    if self.left <= 0 then
        self.timer:Stop()
        self.TimerItem:SetActiveE(0)
        self.taskState = BountyEnum.BountyQuestStateEnum.Award
        self.TimerItem:SetActiveE(0)
        self.go_table.obj_box:SetActiveE(1)
    end
    self:UpdateTimer()
end

---创建怪物实例
function BountyBossItem.CreateItem(trans, finishCallback)
    local item = BountyBossItem.New()
    item.gameObject = trans
    item.transform = trans
    item.finishCallback = finishCallback
    item:Awake()
    return item
end
return BountyBossItem
