---任务排列
---@param data BountyQuestData[]
function BountySystemManager:SortEvilTask(data)
    if data == nil then
        data = self.AllQuest
    end
    self.isDefult = false
    local time = _G.TimeUtil.GetServerUnixTime()
    _G.table.sort(
        data,
        function(data1, data2)
            local a = data1.mission
            local b = data2.mission
            local isDefultA = self:ChekDefultId(a.sid)
            local isDefultB = self:ChekDefultId(b.sid)
            if (isDefultA and isDefultB) or (not isDefultA and not isDefultB) then
                local cfg1 = _G.ConfigManager.bounty_quest_cfg[a.sid]
                local cfg2 = _G.ConfigManager.bounty_quest_cfg[b.sid]
                if a.time > 0 and b.time > 0 then
                    if
                    (cfg1.duration - (time - a.time) <= 0 and cfg2.duration - (time - b.time) <= 0) or
                        (cfg1.duration - (time - a.time) > 0 and cfg2.duration - (time - b.time) > 0)
                    then
                        if cfg1.grade ~= cfg2.grade then
                            return cfg1.grade > cfg2.grade
                        else
                            return a.sid > b.sid
                        end
                    else
                        if cfg1.duration - (time - a.time) <= 0 then
                            return true
                        else
                            return false
                        end
                    end
                elseif a.time == 0 and b.time == 0 then
                    if cfg1.grade ~= cfg2.grade then
                        return cfg1.grade > cfg2.grade
                    else
                        if cfg1.duration ~= cfg2.duration then
                            return cfg1.duration > cfg2.duration
                        else
                            return a.sid > b.sid
                        end
                    end
                else
                    if a.time > 0 and cfg1.duration - (time - a.time) <= 0 then
                        return true
                    elseif b.time > 0 and cfg2.duration - (time - b.time) <= 0 then
                        return false
                    else
                        return a.time == 0
                    end
                end
            else
                if not self.isDefult then
                    self.isDefult = true
                end
                return isDefultA
            end
        end
    )
end
function BountySystemManager:RefreshAllQuest(msg,card)
    for i = 1, #self.AllQuest do
        if self.AllQuest[i].mission.sid==msg.success_sid[1] then
            self.AllQuest[i]:StartTask(msg.start_time, card)
        end
    end
end

---添加卡牌派遣
function BountySystemManager:AddDispath(card)
    for i = 1, #card do
        self.DispathCards[card[i].uid] = true
    end
end

---更新任务数据
function BountySystemManager:UpdateAllQuest()
    if #self.AllQuest < #self.BountyData.missions then
        for i = 1, #self.BountyData.missions - #self.AllQuest do
            self.AllQuest[#self.AllQuest + 1] = self:GetQuestData()
        end
    end
    for i = 1, #self.BountyData.missions do
        self.AllQuest[i]:InitData(self.BountyData.missions[i])
    end
end

---添加新的任务
function BountySystemManager:AddQuest(datas)
    for i = 1, #datas do
        self.AllQuest[#self.AllQuest + 1] = self:GetQuestData()
        self.AllQuest[#self.AllQuest]:InitData(datas[i])
    end
end

---获取任务数据
---@return BountyQuestData
function BountySystemManager:GetQuestData()
    if #self.QuestDataPool > 0 then
        return _G.table.remove(self.QuestDataPool, 1)
    end
    return QuestData.New()
end

---归还任务数据
---@param data BountyQuestData
function BountySystemManager:RespawnQuestData(data)
    data:Dispose()
    self.QuestDataPool[#self.QuestDataPool + 1] = data
end
---获取任务数据
function BountySystemManager:GetQuestDataWithIndex(index)
    if not self.AllQuest then
        return nil
    end
    return self.AllQuest[index]
end

---检测是否挑战(红点)
function BountySystemManager:CheckIsChallenge()
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return true
    end
    if not self.BountyData then
        return false
    end
    return not (self.BountyData.level == 1 and self.BountyData.boss_kill_num == 0 and self.BountyData.boss_progress == 0)
end

---获取卡牌限制图
function BountySystemManager:GetLimitSp(star)
    local order = require "CardInfoManager":GetInstance():GetOrderStarCount(star)
    return StarIndexDic[order]
end

---获取属性图
function BountySystemManager:GetElementSp(element)
    return ElementSps[element]
end

---检测是否可领取
function BountySystemManager:CheckIsCanTask(id)
    if not self.BountyData then
        return false
    end
    if id == 0 then
        return self.BountyData.boss.boss_start_time > 0 and self.BossRTS <= 0
    elseif id == 1 then
        for k, v in pairs(self.taskDatas) do
            if v.mission.time > 0 and v.RTS <= 0 then
                return true
            end
        end
        return self:CheckHaveDispath()
    else
        local taskData = self.taskDatas[id]
        if not taskData then
            return false
        end
        return taskData.mission.time > 0 and taskData.RTS <= 0
    end
end
---检测是否有可派遣任务
function BountySystemManager:CheckHaveDispath()
    if not self.BountyData then
        return false
    end
    if self.isHaveDispath == nil or self.isHaveDispath then
        self.isHaveDispath = false
        local card = self:GetIdleCards()
        for _, v in pairs(self.BountyData.missions) do
            if v.time == 0 then
                local tb = self:GetSimpleDispath(card, v)
                if not _G.table.isEmptyOrNil(tb) then
                    self.isHaveDispath = true
                    break
                end
            end
        end
        return self.isHaveDispath
    end
    return self.isHaveDispath
end
---获取boss战斗力
function BountySystemManager:GetBossPower()
    return self.BountyData.boss.power or 0
end
---检测卡牌是否被派遣
function BountySystemManager:ChekcIsDispath(uid)
    return self.DispathCards[uid]
end

