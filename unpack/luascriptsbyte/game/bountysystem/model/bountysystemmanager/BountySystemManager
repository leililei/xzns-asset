---初始化任务数据
function BountySystemManager:InitAllQuset()
    if self.BountyData.missions == nil then
        self.BountyData.missions = {}
    end
    self.AllQuest = {}
    for i = 1, #self.BountyData.missions do
        self.AllQuest[i] = self:GetQuestData()
        self.AllQuest[i]:InitData(self.BountyData.missions[i])
    end
    self:SortEvilTask()
    self:UpdateCards()
end

function BountySystemManager:UpdateCards()
    self.Cards = {}
    self.Cards[0] = self:GetIdleCards()
    for k, v in pairs(_G.ConfigManager.type_elements_cfg) do
        self.Cards[v.id] = _G.table.chooseToArray(
            self.Cards[0],
            function(k, v2)
                if require "CardInfoManager":GetInstance():CheckMultiMatch(v.id, v2.cfg.Elements_new) then
                    return true
                end
                return false
            end
        )
    end
end

---移除已完成的任务
function BountySystemManager:RemoveQuest(sid, cards)
    local uids = {}
    for i = 1, #self.BountyData.missions do
        if self.BountyData.missions[i].sid == sid then
            self:RemoveCardDispatch(cards, self.BountyData.missions[i].card)
            _G.table.remove(self.BountyData.missions, i)
            break
        end
    end

    for i = 1, #self.AllQuest do
        if self.AllQuest[i].mission.sid == sid then
            self:RespawnQuestData(self.AllQuest[i])
            _G.table.remove(self.AllQuest, i)
            break
        end
    end
    if self.taskDatas[sid] then
        self.taskDatas[sid]:Dispose()
        self.taskDatas[sid] = nil
    end
end

