---获取贪字营数据回调
---@param data dispatch.s2c_dispatch_info 贪字营数据
function BountySystemManager:GetBountyDataSuc(data, callback)
    local isSetCount = false
    if self.BountyData then
        if self.BountyData.missions and data.missions then
            isSetCount = #self.BountyData.missions ~= #data.missions
        else
            isSetCount = true
        end
    end
    self.BountyData = data
    if not self.BountyData.missions then
        self.BountyData.missions = {}
    end
    self:InitTaskData()
    self:InitBossTimer()
    if self.callback then
        self.callback(self.BountyData, isSetCount)
    end
    if callback then
        callback()
    end
    if self.BountyData ~= nil then
        --成就任务登录判断
        _G.Events:GetInstance():Broadcast(
            _G.ePlayAactionEvent.PlayAaction,
            { _G.ActiveTaskEnum.ConditionEnum.Section.TzyLevel },
        -- 贪字营等级达到X级
        --- #等级
            self.BountyData.level
        )
    end
    self.isHaveDispath = nil
    require "RedPointManager":GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.BountyLobby.id)
end
---初始化任务数据
function BountySystemManager:InitTaskData()
    self.DispathCards = {}
    if self.taskDatas then
        for _, v in pairs(self.taskDatas) do
            v:Dispose()
        end
        self.taskDatas = {}
        for _, v in pairs(self.BountyData.missions) do
            self.taskDatas[v.sid] = require "BountyTaskData".New(v)
            if v.card then
                for i = 1, #v.card do
                    self.DispathCards[v.card[i].uid] = true
                end
            end
            require "RedPointManager":GetInstance():AddRedPointParam(
                _G.ConfigManager.redpoint_cfg.BountyLobby.id,
                v.sid
            )
        end
    else
        self.taskDatas = {}
        for _, v in pairs(self.BountyData.missions) do
            self.taskDatas[v.sid] = require "BountyTaskData".New(v)
            if v.card then
                for i = 1, #v.card do
                    self.DispathCards[v.card[i].uid] = true
                end
            end
        end
    end
end

