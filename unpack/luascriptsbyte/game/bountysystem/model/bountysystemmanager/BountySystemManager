---初始化Boss
function BountySystemManager:InitBossTimer()
    if self.bossTimer then
        self.bossTimer:Stop()
        self.bossTimer = nil
    end
    if self.BountyData.boss.boss_start_time <= 0 then
        self.BossRTS = 0
        return
    end
    self.BossRTS = _G.ConfigManager.bounty_level_cfg[self.BountyData.level].duration + self.BountyData.boss.boss_start_time -
        _G.TimeUtil.GetServerUnixTime()
    if self.BossRTS > 0 then
        self.bossTimer = _G.TimerManager:GetInstance():GetTimer(self.BossRTS, self.BossTimerOver, self, true, false, true)
        self.bossTimer:Start()
    else
        self.BossRTS = 0
    end
end

