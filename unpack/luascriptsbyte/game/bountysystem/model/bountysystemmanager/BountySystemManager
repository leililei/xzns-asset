---获取空闲卡牌包括已经派遣的
function BountySystemManager:GetIdleCardsNoLimit()
    local card = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    card = _G.table.toArray(card)
    _G.table.sort(
        card,
        function(a, b)
            if a.power == b.power then
                if a.star == b.star then
                    if a.lv == b.lv then
                        return a.uid > b.uid
                    else
                        return a.lv > b.lv
                    end
                else
                    return a.star > b.star
                end
            else
                return a.power > b.power
            end
        end
    )
    return card
end

---取得空闲的卡牌
---@return CardData[]
function BountySystemManager:GetIdleCards()
    local card = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal)
    card = _G.table.toArray(card)
    _G.table.sort(
        card,
        function(a, b)
            if
            (self:ChekcIsDispath(a.uid) and self:ChekcIsDispath(b.uid)) or
                (not self:ChekcIsDispath(a.uid) and not self:ChekcIsDispath(b.uid))
            then
                if a.star == b.star then
                    if a.lv == b.lv then
                        return a.uid > b.uid
                    else
                        return a.lv > b.lv
                    end
                else
                    return a.star > b.star
                end
            else
                if self:ChekcIsDispath(a.uid) then
                    return false
                else
                    return true
                end
            end
        end
    )

    return card
end

---取得空闲的卡牌,key为uid的
---@return CardData[]
function BountySystemManager:GetIdleCardofKey()
    local card = _G.DeepCopy(_G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Card, _G.CardType.Normal))
    for i, v in pairs(self.AllQuest) do
        if v.mission and v.mission.card then
            for i = 1, #v.mission.card do
                card[v.mission.card[i].uid] = nil
            end
        end
    end
    local compare = function(a, b)
        if a.star == b.star then
            if a.lv == b.lv then
                return a.uid > b.uid
            else
                return a.lv > b.lv
            end
        else
            return a.star > b.star
        end
    end

    local keys = _G.table.keys(card)
    for i = 1, #keys - 1 do
        for j = 1, #keys - i do
            if compare(card[keys[j]], card[keys[j + 1]]) then
                local temp = keys[j]
                keys[j] = keys[j + 1]
                keys[j + 1] = temp
            end
        end
    end
    local tb = {}
    for i = 1, #keys do
        tb[keys[i]] = card[keys[i]]
    end

    return tb
end

---获取一键派遣的卡牌
function BountySystemManager:GetDispathAll()
    local CardDatas = self:GetIdleCardofKey()
    local AllCards = {}
    local data = _G.DeepCopy(self.AllQuest)
    for i = 1, #data do
        if data[i].mission.time == 0 then
            local cards = self:GetSimpleDispath(CardDatas, data[i].mission)
            if cards then
                cards.Count = nil
                if self:CheckCards(cards, data[i].mission) then
                    AllCards[data[i].mission.sid] = data[i]
                    data[i].mission.card = {}
                    for k, v in pairs(cards) do
                        data[i].mission.card[#data[i].mission.card + 1] = { sid = v.sid, uid = v.uid, star = v.star }
                        CardDatas[v.uid] = nil
                    end
                end
            end
        end
    end
    return AllCards
end

---获取适合单个任务卡牌组合
---@param CardData CardData[]
---@param EvilData dispatch.i_evil_spirit_mission
function BountySystemManager:GetSimpleDispath(CardData, EvilData)
    local data = EvilData
    local cfg = _G.ConfigManager.bounty_quest_cfg[data.sid]
    if not cfg then
        return nil
    end

    if _G.table.count(CardData) < cfg.condition_num then
        return nil
    end
    local allCards = CardData
    local cards = {}
    local requiredCards = {}

    for key, v in pairs(allCards) do
        if not self:ChekcIsDispath(v.uid) then
            if not cards[v.star] then
                cards[v.star] = {}
            end
            cards[v.star][v.uid] = v
        end
    end

    local prop = _G.DeepCopy(data.five_elements)

    for k, v in pairs(cards) do
        if k >= cfg.condition_attribute[2] then
            for _2, v2 in pairs(v) do
                if self:CheckIsFiveElement(prop, v2.cfg.Elements_new, true) then
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #requiredCards >= cfg.condition_attribute[1] or #prop <= 0 then
                        break
                    end
                end
            end
            if #requiredCards >= cfg.condition_attribute[1] or #prop <= 0 then
                break
            end
        end
    end

    if cfg.condition_attribute[1] + #data.five_elements - cfg.condition_num > #requiredCards then
        return nil
    end

    if #requiredCards < cfg.condition_attribute[1] then
        for k, v in pairs(cards) do
            if k >= cfg.condition_attribute[2] then
                for _2, v2 in pairs(v) do
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #requiredCards >= cfg.condition_attribute[1] then
                        break
                    end
                end
            end
            if #requiredCards >= cfg.condition_attribute[1] then
                break
            end
        end
    end

    if #requiredCards < cfg.condition_attribute[1] then
        return nil
    end

    if #prop > 0 then
        for _, v in pairs(cards) do
            for _2, v2 in pairs(v) do
                if self:CheckIsFiveElement(prop, v2.cfg.Elements_new, true) then
                    _G.table.insert(requiredCards, v2)
                    v[v2.uid] = nil
                    if #prop <= 0 then
                        break
                    end
                end
            end
            if #prop <= 0 then
                break
            end
        end
    end

    if #prop > 0 then
        return nil
    end

    if #requiredCards < cfg.condition_num then
        for _, v in pairs(cards) do
            for _2, v2 in pairs(v) do
                _G.table.insert(requiredCards, v2)
                v[v2.uid] = nil
                if #requiredCards >= cfg.condition_num then
                    break
                end
            end
            if #requiredCards >= cfg.condition_num then
                break
            end
        end
    end

    if #requiredCards < cfg.condition_num then
        return nil
    end

    return requiredCards
end

---检测卡牌组合是否符合所需要的卡牌
function BountySystemManager:CheckCards(cards, EvilData)
    local cfg = _G.ConfigManager.bounty_quest_cfg[EvilData.sid]
    if cards == nil or _G.table.count(cards) < cfg.condition_num then
        return false
    end

    local prop = _G.DeepCopy(EvilData.five_elements)
    local limitCardNum = 0
    for k, v in pairs(cards) do
        if v.star >= cfg.condition_attribute[2] then
            limitCardNum = limitCardNum + 1
        end
        if #prop > 0 then
            self:CheckIsFiveElement(prop, v.cfg.Elements_new, true)
        end
    end

    if #prop == 0 and limitCardNum >= cfg.condition_attribute[1] then
        return true
    else
        return false
    end
end

---检测是否为当前所需要的五行元素
---@param table  table<number>
---@param Elements_new number 元素
---@param isRemove boolean 是否移除元素
---@return boolean
function BountySystemManager:CheckIsFiveElement(table, Elements_new, isRemove)
    for _, v in pairs(table) do
        if require "CardInfoManager":GetInstance():CheckMultiMatch(v, Elements_new) then
            if isRemove then
                _G.table.remove(table, _)
            end
            return true
        end
    end
    return false
end

