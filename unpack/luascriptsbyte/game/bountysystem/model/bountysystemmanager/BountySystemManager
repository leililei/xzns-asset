---解析单个奖励
---@return BountyAward
function BountySystemManager:ParseSimpleAward(tb, data)
    ---@class BountyAward 奖励数据
    ---@field sid number
    ---@field uid number
    ---@field star number 卡牌初始星级
    ---@field number number

    ---@type BountyAward
    local award = {}
    local itemType = data.type == nil and data or data.type
    if itemType[1] ~= nil then
        local type = _G.StorageManager:GetInstance():CheckSidType(itemType[1])
        if type == _G.StorageType.Card then
            award.sid = itemType[1]
            award.uid = itemType[2]
            award.star = itemType[3]
            award.number = 1
            table.insert(tb, award)
        elseif type == _G.StorageType.Equipment then
            award.sid = itemType[1]
            award.uid = itemType[2]
            award.number = 1
            table.insert(tb, award)
        else
            local addNum = itemType[2] or itemType[3]
            award.sid = itemType[1]
            award.number = addNum
            table.insert(tb, award)
        end
    end
end

