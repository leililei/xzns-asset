local base = require "BaseGameNet"

---@class GloryAssemblyNet : BaseGameNet	通信协议
---@field GetInstance fun():GloryAssemblyNet
local GloryAssemblyNet = _G.BaseClass("GloryAssemblyNet", base)

---添加所有后端主动推的网络消息监听接口(子类重写)
function GloryAssemblyNet:AddMessageListeners()
    self:AddMessageListener(
        _G.ConfigManager.net_map.activity_honor_gathering_change_curr.Cmd,
        self.P2C_ServerStatusUpdate
    )
end

---网络接口回调
function GloryAssemblyNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

--region ===================网络接口===================

---发起捐献请求
---@param pbData activity_honor_gathering.c2s_donate
function GloryAssemblyNet:Donate(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_honor_gathering_donate
    local port = self:Access(item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

--endregion


--region ===================消息推送===================

---推送界面更新(进度丶玩家状态)
---@param msg activity_honor_gathering.p2c_change_curr
function GloryAssemblyNet:P2C_ServerStatusUpdate(msg)
    local activity = require("ActivitySynManager"):GetInstance():GetActivityClass(msg.activity_id)
    if not activity then
        return
    end
    ---@type GloryAssemblyModel
    local model = activity:GetActivityTypeCls()
    model:UpdateActivityData(msg)
end

--endregion

return GloryAssemblyNet
