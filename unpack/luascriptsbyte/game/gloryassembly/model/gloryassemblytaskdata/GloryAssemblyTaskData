local base = require("DrawUpBattlePassTaskInfoData")
local ActivitySynManager = require("ActivitySynManager")

---@class GloryAssemblyTaskData : DrawUpBattlePassTaskInfoData
---@field activity DrawUpBattlePassTaskModel
---@field curActivityClass ActivitySynBase
local GloryAssemblyTaskData = _G.BaseClass("GloryAssemblyTaskData", base)

function GloryAssemblyTaskData:__init(activity)
    self.activity = activity
    self.curActivityClass = self.activity.curActivityClass
end

---进入活动
function GloryAssemblyTaskData:OnEnterActivity()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TarotPassTaskView.Name, self.curActivityClass)
end

---关闭活动
function GloryAssemblyTaskData:OnCloseActivity()
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.TarotPassTaskView.Name)
end

---领取奖励
function GloryAssemblyTaskData:GetAward(ids, callback)
    ---@param msg public.s2c_common_ack
    require "DrawUpBattlePassTaskNet":GetInstance():GetAward(
        { activity_id = self.curActivityClass:GetActivityID(), task_sid = ids, finish_type = 2 },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            --更新任务状态
            for _, v in pairs(ids) do
                self.activity.finishTask[v] = true
            end
            ---更新活动红点
            self.activity:RefreshRedPoint()

            --显示奖励信息
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            require("CommonTipManager").OpenCommonAwardView(msg)

            if callback then
                callback()
            end
        end
    )
end

function GloryAssemblyTaskData:GetJumpModelType()
    return _G.ActivityMainType.GloryAssembly
end

return GloryAssemblyTaskData
