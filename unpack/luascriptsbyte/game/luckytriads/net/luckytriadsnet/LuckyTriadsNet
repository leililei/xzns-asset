local base = require("BaseGameNet")

---@class LuckyTriadsNet : BaseGameNet
local LuckyTriadsNet = _G.BaseClass("LuckyTriadsNet", base)

---获取抽卡数据
---@param callback fun(msg:any):void    回调函数
---@return void
function LuckyTriadsNet:GetInfo(callback)
    local item = _G.ConfigManager.net_map.game_lucky_triads_port_get_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---进行抽卡
---@param index number    下标
---@param callback fun(msg:any):void    回调函数
---@return void
function LuckyTriadsNet:Draw(index, callback)
    local item = _G.ConfigManager.net_map.game_lucky_triads_port_lottery
    local port = base.Access(self, item, {index = index}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领取抽卡奖励
---@param index number    下标
---@param callback fun(msg:any):void    回调函数
---@return void
function LuckyTriadsNet:GetReward(index, callback)
    local item = _G.ConfigManager.net_map.game_lucky_triads_port_award
    local port = base.Access(self, item, {index = index}, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function LuckyTriadsNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return LuckyTriadsNet
