---@class LuckyTriadsDrawResultView : UIBaseView	群英荟萃千抽自选-抽卡展示
local LuckyTriadsDrawResultView = _G.BaseClass("LuckyTriadsDrawResultView", _G.UIBaseView)

function LuckyTriadsDrawResultView:Awake()
    _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 2033)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function LuckyTriadsDrawResultView:OnCreate(cardInfos,closeBack)
    self.data = cardInfos
    self.closeBack = closeBack
    self.card_cfg = _G.ConfigManager.card_cfg
    self:InitView()
end
function LuckyTriadsDrawResultView:AorBtn_Closs()
    self.go_table.aorbtn_Closs:SetActiveE(1)
end
function LuckyTriadsDrawResultView:InitView()
    -- self.Timei = _G.TimerManager:GetInstance():GetTimer(2, self.AorBtn_Closs, self, true, false, true)
    -- self.Timei:Start()
    self.itemCard = {}
    for i = 1, 10 do
        local var = self.go_table["obj_cardItem" .. i]
        self:KaPaiZhanShi(i, var)
    end
    self.go_table.aorrawimage_BG:LoadImage(
    "ImagesH5/hDraw/ui_zmzs_bg_06",
    function()
        if not _G.IsNil(self.go_table) then
            self.go_table.obj_all:SetActiveE(1)
        end
    end)
end

---卡牌展示
function LuckyTriadsDrawResultView:KaPaiZhanShi(index, listView2)
    if index < 0 then
        return
    end
    local x = index

    self.itemCard[x] = {}
    self.itemCard[x] = _G.GetAutoGoTable(listView2, _G.handlerbind(self, self.AddDianJiBtn, x))
    self.itemCard[x].CardIndex = index

    local data = self.data[x]
    self.dataNum = #self.data
    if data ~= nil then
        self:SpawnCard(self.itemCard[x])
    end
end

function LuckyTriadsDrawResultView:SpawnCard(itemGoTable)
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.baseBodyItem,
        itemGoTable.obj_node,
        function(itemLua)
            itemGoTable.Lua = itemLua
            self:SetCardItem(itemGoTable)
        end
    )
end

function LuckyTriadsDrawResultView:SetCardItem(itemGoTable)
    if itemGoTable == nil or self:IsNil() then
        return
    end
    ---@type CardData
    local carddata = self.data[itemGoTable.CardIndex]
    if not carddata then
        return
    end
    ---@type ItemCardBodySelectView
    local lua = itemGoTable.Lua
    itemGoTable.gameObject:SetName(itemGoTable.CardIndex)
    carddata.skinIs = false

    if carddata.skin and carddata.skin ~= 0 then
        carddata.skinIs = true
    end
    if carddata.Grade == 3 then 
        carddata.newEff = carddata.newEff or {}
        carddata.newEff[1] = "ef_kapailiuguang_hongwai" 
    elseif carddata.Grade > 3 then 
        carddata.newEff = carddata.newEff or {}
        carddata.newEff[1] = "ef_kapailiuguang_jinwai" 
    end
    lua:ShowCardData(carddata, nil, true)
end

---处理按钮事件
function LuckyTriadsDrawResultView:OnClickBtn(go, _)
    if go == self.go_table.aorbtn_QueRen then
        if self.closeBack then
            self.closeBack()
        end
        self:Close()
    end
end

