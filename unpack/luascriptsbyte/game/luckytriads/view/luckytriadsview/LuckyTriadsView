---显示轮次信息
---@return void
function LuckyTriadsView:ShowRound()
    local round = require("LuckyTriadsModel"):GetInstance():GetRound()
    self.go_table.aortext_round.text = _G.GetLangPackValue(90000011303, round)
    self:ReleaseAllConditionItems()

    local cfg = _G.ConfigManager.lucky_triads_cfg[round]
    if not cfg then
        return
    end
    for _, condition in ipairs(cfg.conditions) do
        ---@type string
        local desc
        if condition[1] == _G.GlobalConditionManager.ConditionType.afk then
            ---通关放置关卡
            local curSectionId = require("AfkModel"):GetInstance():GetCurSection()
            -- local curCfg = _G.ConfigManager.afk_cfg[curSectionId]
            local targetCfg = _G.ConfigManager.afk_cfg[condition[2]]
            local progress = _G.GlobalConditionManager.CheckCondition(condition[1], condition[2]) and 1 or
                    ("<color=red>" .. 0 .. "</color>")
            desc = _G.GetLangPackValue(90000011305, targetCfg.chapter, targetCfg.section, progress, 1)
        elseif condition[1] == _G.GlobalConditionManager.ConditionType.createRoleDay then
            ---创号达到n天
            local createDays = _G.TimeUtil.GetInterValDayByGame(
                    _G.PlayerModel:GetInstance():GetCreateRoleTime(),
                    _G.TimeUtil.GetServerUnixTime()
            ) + 1
            local progress = createDays >= condition[2] and tostring(condition[2]) or ("<color=red>" .. createDays .. "</color>")
            desc = _G.GetLangPackValue(90000011304, condition[2], progress, condition[2])
        end
        if desc then
            self:GetConditionItem().aortext_content.text = desc
        end
    end
end
