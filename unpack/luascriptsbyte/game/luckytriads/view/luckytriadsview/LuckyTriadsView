---展示抽卡动画和结果
---@param cards {card_sid:number, star:number}[] 抽取序号
---@param animation boolean 是否展示动画
function LuckyTriadsView:ShowDrawDetails(cards, animation)
    ---@type CardData[]
    local lstCard = {}
    for _, card in ipairs(cards) do
        ---@type CardData
        local data = require("CardData").New()
        data:ParseInitMsg({ sid = card.card_sid, star = card.star })
        table.insert(lstCard, data)
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LuckyTriadsDrawResultView.Name, lstCard)
end

---抽卡回调
---@param index number 抽取序号
---@return void
function LuckyTriadsView:OnDrawCallback(index)
    --刷新红点
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.LuckyTriads.id)

    --展示抽卡动画和结果
    local cards = require("LuckyTriadsModel"):GetInstance():GetDrawDetails(index)
    if cards then
        --延迟刷新节点(等待LuckyTriadsDrawResultView打开后)
        self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnDelayRefreshView)

        self:ShowDrawDetails(cards, true)
    else
        self:ShowCards()
        self:ShowRemainCount()
    end
end
---领取卡牌回调
---@return void
function LuckyTriadsView:OnRewardCallback()
    --刷新红点
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.LuckyTriads.id)

    local round = require("LuckyTriadsModel"):GetInstance():GetRound()
    local cfg = _G.ConfigManager.lucky_triads_cfg[round]
    if not cfg then
        --轮次已结束
        self:Close()
        return
    end

    self:ShowCards()
    self:ShowRound()
    self:ShowRemainCount()
end
---UI开启回调
---@param name string
---@return void
function LuckyTriadsView:OnDelayRefreshView(name)
    if name ~= _G.ConfigManager.ui_cfg.LuckyTriadsDrawResultView.Name then
        return
    end
    self:RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnDelayRefreshView)

    self:ShowCards()
    self:ShowRemainCount()
end

---检查是否满足当前条件
---@param showTip booleam 展示tip信息
---@return boolean  是否满足条件
function LuckyTriadsView:CheckCurrentRoundConditions(showTip)
    local round = require("LuckyTriadsModel"):GetInstance():GetRound()
    --检测此轮开放条件
    local cfg = _G.ConfigManager.lucky_triads_cfg[round]
    if not cfg then
        return false
    end
    for _, condition in ipairs(cfg.conditions) do
        if not _G.GlobalConditionManager.CheckCondition(condition[1], condition[2]) then
            if showTip then
                --提示不满足开启领取条件
                if condition[1] == _G.GlobalConditionManager.ConditionType.afk then
                    _G.PopWindowManager:GetInstance():ShowAllTips(630114)
                elseif condition[1] == _G.GlobalConditionManager.ConditionType.createRoleDay then
                    local createDays = _G.TimeUtil.GetInterValDayByGame(
                            _G.PlayerModel:GetInstance():GetCreateRoleTime(),
                            _G.TimeUtil.GetServerUnixTime()
                    ) + 1
                    _G.PopWindowManager:GetInstance():ShowAllTips(
                            630113,
                            nil,
                            nil,
                            nil,
                            nil,
                            nil,
                            condition[2] - createDays
                    )
                end
            end
            return false
        end
    end
    return true
end

--region -----------------对象池相关-----------------------

---回收所有Condition节点
---@return void
function LuckyTriadsView:ReleaseAllConditionItems()
    if not self.activeConditionItems then
        return
    end
    if not self.releaseConditionItems then
        self.releaseConditionItems = {}
    end
    for _, state in pairs(self.activeConditionItems) do
        table.insert(self.releaseConditionItems, state)
        state.gameObject:SetActiveE(0)
    end
    self.activeConditionItems = nil
end
---获取一个Condition节点
---@return LuckyTriadsView._obj_condition_GoTable
function LuckyTriadsView:GetConditionItem()
    ---@type LuckyTriadsView._obj_condition_GoTable
    local item
    if self.releaseConditionItems and #self.releaseConditionItems > 0 then
        item = table.remove(self.releaseConditionItems, 1)
    end
    if not item then
        item = _G.GetAutoGoTable(
                _G.InstantiateObject(self.go_table.obj_condition, self.go_table.obj_condition:GetParent())
        )
    end

    if not self.activeConditionItems then
        self.activeConditionItems = {}
    end
    table.insert(self.activeConditionItems, item)
    item.gameObject:SetActiveE(1)
    item.transform:SetAsLastSiblingE()
    return item
end

--endregion

---处理按钮事件
function LuckyTriadsView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    end
end
---卡牌点击事件
---@param index number
---@param item LuckyTriadsView._obj_card1_GoTable
function LuckyTriadsView:OnCardClickBtn(go, _, index, item)
    local model = require("LuckyTriadsModel"):GetInstance()

    if go == item.aorbtn_draw or go == item.aorbtn_draw1 then
        --检测此轮开放条件
        --if not self:CheckCurrentRoundConditions(true) then
        --    return
        --end
        model:Draw(index, _G.handlerbind(self, self.OnDrawCallback, index))
    elseif go == item.aorbtn_receive then
        --检查是否全部抽取且比较品质
        local curOrder, maxOrder = 1, 1
        for i = 1, #self.cardItems do
            local cardData = model:GetCard(i)
            if not cardData then
                --提示需要先抽取所有卡牌
                _G.PopWindowManager:GetInstance():ShowAllTips(630115)
                return
            end
            local order = _G.ConfigManager.card_cfg[cardData.card_sid].Order --获取最大品质角色
            if i == index then
                curOrder = order
            elseif order > maxOrder then
                maxOrder = order
            end
        end
        --检测此轮开放条件
        if not self:CheckCurrentRoundConditions(true) then
            return
        end

        --大部分镇魂将大人选择了品质更高的魂将，是否确认选择?
        if curOrder < maxOrder then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    630116,
                    nil,
                    function()
                        model:GetReward(index, _G.handler(self, self.OnRewardCallback))
                    end,
                    function()
                    end
            )
            return
        end

        --获取当前品质卡牌数量
        local curOrderNum = 0
        for i = 1, #self.cardItems do
            local cardData = model:GetCard(i)
            local order = _G.ConfigManager.card_cfg[cardData.card_sid].Order --获取最大品质角色
            if curOrder == order then
                curOrderNum = curOrderNum + 1
            end
        end
        --选择后将直接获取已选魂将，是否确认本次选择？
        if curOrderNum > 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                    630117,
                    nil,
                    function()
                        model:GetReward(index, _G.handler(self, self.OnRewardCallback))
                    end,
                    function()
                    end
            )
            return
        end

        model:GetReward(index, _G.handler(self, self.OnRewardCallback))
        --elseif go == item.aorbtn_details then
        --    local cards = model:GetDrawDetails(index)
        --    if not cards then
        --        return
        --    end
        --    self:ShowDrawDetails(cards, false)
    elseif go == item.aorbtn_look then
        local data = model:GetCard(index)
        if not data then
            return
        end
        local msg = {}
        msg.sid = data.card_sid
        msg.cfg = _G.ConfigManager.card_cfg[msg.sid]
        msg.star = data.star
        local cardData = _G.CardData.New()
        cardData:ParseInitMsg(msg)
        --require("CommonTipManager"):GetInstance():OpenTip(gameobj, sid, nil, nil, nil, 1)
        _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CardShowView.Name,
        {CardData = cardData},
        nil,
        true)
    end
end

return LuckyTriadsView
