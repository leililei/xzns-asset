function LuckyTriadsView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.go_table.obj_condition:SetActiveE(0)
end
function LuckyTriadsView:OnDestroy()
    self:RemoveAllListener()
end
function LuckyTriadsView:OnCreate()
    self:InitCardItems()

    self:ShowCards()
    self:ShowRound()
    self:ShowRemainCount()

    --刷新红点
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.LuckyTriads.id)
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
        self.go_table.aorrawimage_roleImage:LoadImage("ImagesH5/hLuckyTriads/ui_qczx_qczx_js")
    end
end

---初始化卡牌节点
---@return void
function LuckyTriadsView:InitCardItems()
    --初始化卡牌Item
    self.cardItems = {
        _G.GetAutoGoTable(self.go_table.obj_card1),
        _G.GetAutoGoTable(self.go_table.obj_card2),
        _G.GetAutoGoTable(self.go_table.obj_card3)
    }
    for index, item in ipairs(self.cardItems) do
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnCardClickBtn, index, item))
    end
end

---刷新卡牌状态
---@return void
function LuckyTriadsView:ShowCards()
    local model = require("LuckyTriadsModel"):GetInstance()
    for i = 1, #self.cardItems do
        self:ShowCardData(self.cardItems[i], model:GetCard(i))
    end
end
