---@class PowerToTheTopNet : BaseGameNet 通信协议
local PowerToTheTopNet = _G.BaseClass("PowerToTheTopNet", require("BaseGameNet"))
local base = require("BaseGameNet")
---@return PowerToTheTopNet PowerToTheTopNet
function PowerToTheTopNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--放置阵容历史最强战力
---@param callback function 回调方法
function PowerToTheTopNet:AccessAfk(callback)
    local item = _G.ConfigManager.net_map.game_rank_top_afk_power
    local port = base.Access(self, item, { page = 1 }, _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end

