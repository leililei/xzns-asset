function PowerToTheTopModel:PowerToTheTopBoll()
    local isAllOver = false
    if self:CheckIsNew() then
        isAllOver = true
        for _, v in pairs(_G.ConfigManager.rank_list2_cfg) do
            local endTime = _G.PlayerModel:GetInstance().open_time + v.end_time * 3600
            if _G.TimeUtil.GetServerUnixTime() < endTime then
                isAllOver = false
            end
        end
    end
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) or isAllOver then
        if self.PowerToTheTop == nil then
            self.PowerToTheTop = true
            local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
            if view then
                _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
            end
            _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.PowerToTheTop)
        end
        return false
    end

    if
        _G.PlayerModel:GetInstance().open_time + _G.ConfigManager.activity_info_cfg[1000002].time_duration >=
            _G.TimeUtil.GetServerUnixTime()
     then
        self.PowerToTheTop = nil
        return true
    end
    if self.PowerToTheTop == nil then
        self.PowerToTheTop = true
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
        if view then
            _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
        end
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.PowerToTheTop)
    end
    return false
end

function PowerToTheTopModel:CheckSelfRank(type, value)
    local sysType = ConvertSysType[type]
    if self.RankData == nil or self.RankData[sysType] == nil or self.RankData[sysType].state ~= 1 then
        return
    end
    local oldRank = self.cacheSelfRankValue[type]
    if oldRank == nil then
        return
    end
    if value < oldRank.value then
        return
    end
    oldRank.value = value
    if self.cackeRankData[type] == nil then
        return
    end
    local newRank
    for i, v in pairs(self.cackeRankData[type]) do
        if value > v.value then
            newRank = i
            break
        end
    end
    if newRank then
        if newRank < oldRank.rank or oldRank.rank == 0 then
            oldRank.rank = newRank
            local lanID = SelfRankLanId[type] or 0
            local content = _G.GetLangPackValue(lanID, newRank)
            require("CommonTipManager").OpenRankUpView(content)
        end
    end
end

return PowerToTheTopModel
