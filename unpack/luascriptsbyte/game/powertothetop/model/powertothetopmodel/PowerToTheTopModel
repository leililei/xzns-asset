--竞技场积分
function PowerToTheTopModel:GetArena()
    local normal = require "ArenaManager":GetInstance():GetArenaClass(require "ArenaManager".arenaType.normal)
    if normal == nil then
        return 0
    end
    self:AddHis_max_value(Top_RankList.arena, normal:GetScore())
    return normal:GetScore()
end

-- 五行竞技场积分
function PowerToTheTopModel:GetAwardCount()
    local normal = require "ArenaManager":GetInstance():GetArenaClass(require "ArenaManager".arenaType.element)
    if normal == nil then
        return 0
    end
    self:AddHis_max_value(Top_RankList.ele_arena, normal:GetScore())
    return normal:GetScore()
end

--高阶竞技场段位
function PowerToTheTopModel:GetAwardElement()
    local normal = require "ArenaManager":GetInstance():GetArenaClass(require "ArenaManager".arenaType.senior)
    local cfg = require "ArenaController":GetInstance():CalculateSeniorLeagueByRank(normal:GetCurRank())
    if cfg == nil then
        return 155
    end
    self:AddHis_max_value(Top_RankList.high_arena, cfg.id)
    return cfg.id
end

--神器积分
function PowerToTheTopModel:GetArtifact(sid)
    if self.RankData and self.RankData[Top_RankList.artifact] and self.RankData[Top_RankList.artifact].state == 1 then
        local cardList = artifact_cfg[sid]

        if cardList == nil then
            return 0
        end

        local num = artifact_cfg[sid].count
        -- for _, value in pairs(cardList) do
        --     num = num + artifact_cfg[value].count
        -- end
        
        self:AddHis_max_value(Top_RankList.artifact, num)
        _G.DelayDo(1, function()
            self:CheckSelfRank(_G.PowerToTheTopType.artifact, self:GetHis_max_value(Top_RankList.artifact))
        end)
        return num
    end
end

