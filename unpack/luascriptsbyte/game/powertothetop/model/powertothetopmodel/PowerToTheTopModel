function PowerToTheTopModel:Dispose()
    _G.Events:GetInstance():RemoveListener(_G.eAFKAactionEnum.AfkSectionPass, self.Top_Rank, self)
    _G.Events:GetInstance():RemoveListener(_G.GlobalEvents.PlayerPowerChange, self.Top_Rank, self)
    _G.Events:GetInstance():RemoveListener(_G.GlobalEvents.RefreshSeniorView, self.Top_Rank, self)
    _G.Events:GetInstance():RemoveListener(_G.ePlayAactionEvent.PlayAaction, self.Top_Rank, self)

    if self.co then
        _G.coroutine.stopwaiting(self.co)
        self.co = nil
    end
end

function PowerToTheTopModel:RedView(id)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
    if view then
        view:InitRedPoint(id)
    else
        self:InitRedPoint(id)
    end
end

function PowerToTheTopModel:InitRedPoint(id)
    local is = 0
    local CheckFunctionIsUnlock = 0
    if self.RankData == nil or self.RankData[Top_RankList.artifact] == nil then
        return is
    end
    if rank_list_cfg[id] == nil or rank_list_cfg[id].reveal then
        return is
    end
    if id == Top_RankList.power then
        if self:ValueNum() == 1 then
            is = 1
        end
    elseif id == Top_RankList.afk then
        if self:AfkPowerList() == 1 then
            is = 1
        end
    elseif id == Top_RankList.dead then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.DeadsoulMain) then
            is = 0
            CheckFunctionIsUnlock = 1
        elseif self:DeadPowerList() == 1 then
            is = 1
        end
    elseif id == Top_RankList.arena then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(_G.FunctionID.PVP) then
            is = 0
            CheckFunctionIsUnlock = 1
        elseif self:GetArenaList() == 1 then
            is = 1
        end
    elseif id == Top_RankList.ele_arena then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(79) then
            is = 0
            CheckFunctionIsUnlock = 1
        elseif self:GetAwardCountList() == 1 then
            is = 1
        end
    elseif id == Top_RankList.high_arena then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(51) then
            is = 0
            CheckFunctionIsUnlock = 1
        elseif self:GetHigh_arenaList() == 1 then
            is = 1
        end
    elseif id == Top_RankList.artifact then
        if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(145) then
            is = 0
            CheckFunctionIsUnlock = 1
        elseif self:GetAwardArtifact() == 1 then
            is = 1
        end
    end
    --if is == 0 and self.RankData[id].state == 2 and CheckFunctionIsUnlock == 0 then
    --    local GetRole_infoUid = self:GetRole_infoUid(id)
    --    if GetRole_infoUid then
    --        if #GetRole_infoUid < rank_list_cfg[id].praise_num and self.RankData[id].role_info and
    --            #self.RankData[id].role_info >= rank_list_cfg[id].praise_num then
    --            is = 1
    --        end
    --    else
    --        if self.RankData[id].role_info and #self.RankData[id].role_info > 0 and
    --            #self.RankData[id].role_info >= rank_list_cfg[id].praise_num then
    --            is = 1
    --        end
    --    end
    --end
    return is
end

---@param force boolean @是否强制更新数据
function PowerToTheTopModel:MaxZhanLi(force)
    local power = _G.PlayerModel:GetInstance():GetCorePower()
    if power == nil or power == 0 then
        power = _G.StorageManager:GetInstance():GetPlayerPower()
    end

    if self.valueNum < power or force then
        self.PanDuan = true
        _G.StorageManager:GetInstance():GetServerCardPower(
            function()
                self.PanDuan = false
            end
        )
        self.valueNum = power
        self:AddHis_max_value(Top_RankList.power, self.valueNum)
        return true
    end
    return false
end

---战斗力红点判断
function PowerToTheTopModel:ValueNum()
    if self.RankData[Top_RankList.power].state == 0 or self.RankData[Top_RankList.power].state == 2 then
        return 0
    end
    self:MaxZhanLi()
    for key, value in pairs(rank_list_cfg[Top_RankList.power].goal) do
        if self.RankData[Top_RankList.power].his_max_value >= rank_top_cfg[value].min_rank then
            if self:ISaward_index(Top_RankList.power, key) == false then
                return 1
            end
        end
    end
    return 0
end

---刷图红点判断
function PowerToTheTopModel:AfkPowerList()
    if self.RankData[Top_RankList.afk].state == 0 or self.RankData[Top_RankList.afk].state == 2 then
        return 0
    end
    for key, value in pairs(rank_list_cfg[Top_RankList.afk].goal) do
        local cfg = self:AccessTopAfkPowerList()
        if cfg == nil then
            return 0
        end
        if cfg.id >= rank_top_cfg[value].min_rank then
            if self:ISaward_index(Top_RankList.afk, key) == false then
                return 1
            end
        end
    end
    return 0
end

---死魂塔红点判断
function PowerToTheTopModel:DeadPowerList()
    if not self.RankData[Top_RankList.dead] then
        return 0
    end
    if self.RankData[Top_RankList.dead].state == 0 or self.RankData[Top_RankList.dead].state == 2 then
        return 0
