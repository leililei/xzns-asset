--获取历史最高记录
function PowerToTheTopModel:GetHis_max_value(index)
    return self.RankData[index] and self.RankData[index].his_max_value or 0
end

--设置历史最高记录
function PowerToTheTopModel:SetHis_max_value(index, value)
    self.RankData[index].his_max_value = value or 0
end

--设置历史最高记录
function PowerToTheTopModel:AddHis_max_value(index, num)
    if self.RankData[index].his_max_value == nil then
        self.RankData[index].his_max_value = 0
    end
    if index == Top_RankList.artifact then
        self.RankData[index].his_max_value = self.RankData[index].his_max_value + num
    elseif index == Top_RankList.high_arena then
        if self.RankData[index].his_max_value == 0 or self.RankData[index].his_max_value > num then
            self.RankData[index].his_max_value = num
        end
    else
        if self.RankData[index].his_max_value < num then
            self.RankData[index].his_max_value = num
        end
    end
end

---奖励判断是否以领取
function PowerToTheTopModel:ISaward_index(index, id)
    if self.RankData[index].award_index == nil then
        self.RankData[index].award_index = {}
    end
    for _, value in pairs(self.RankData[index].award_index) do
        if value == id then
            return true
        end
    end
    return false
end

