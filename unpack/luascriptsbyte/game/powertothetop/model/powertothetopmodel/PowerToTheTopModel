function PowerToTheTopModel:GetPlayerRank(num, call)
    local pbData = {type = num}
    PowerToTheTopNet:GetInstance():GetPlayerRank(pbData, function(msg)
        if msg.ack == 1 then
            self.cacheSelfRankValue[num] = {rank = msg.index or 999999, value = msg.value or 0}
        end
        if call then
            call(msg)
        end
    end)
