---红点刷新
function PowerToTheTopModel:hongDianNew()
    if self.typeCls ~= nil and not self.co then
        self.co =
            _G.DelayFrameDo(
            function()
                if self.typeCls ~= nil then
                    self.typeCls:RefreshRedPoint()
                end
