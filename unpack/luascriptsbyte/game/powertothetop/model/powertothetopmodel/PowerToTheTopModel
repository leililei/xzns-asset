        return
    end
    return self.RankData[index].point_role
end

--获取玩家是否点赞
function PowerToTheTopModel:AddRole_infoUid(index, uid)
    if self.RankData == nil or self.RankData[index].point_role == nil then
        self.RankData[index].point_role = {uid}
    else
        _G.table.insert(self.RankData[index].point_role, uid)
    end
    self:RedView(index)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.RankList.id)
