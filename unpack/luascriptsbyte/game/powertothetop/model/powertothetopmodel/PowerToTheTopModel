--获取放置通关进度
function PowerToTheTopModel:AccessRankInfo(call)
    local time = _G.TimeUtil.TranslateTimeForStamp({ year = 2026, month = 3, day = 18 })--2026年3月18日之前的服读旧配置，之后的服读新配置
    self.isNew = _G.PlayerModel:GetInstance():GetServerOpenTime() >= time
    --self.isNew = false
    if self.isNew then
        rank_list_cfg = _G.ConfigManager.rank_list2_cfg
        self.curFunctionOpenID = 1010
    end
    if self:PowerToTheTopBoll() then
        -- body
        PowerToTheTopNet:GetInstance():GetPlayerRankInfo(
            function(mag)
                self:TopRankData(mag.top_rank)
                if call then
                    call()
                end
            end
        )
    end
    base.ParseData(self)
end

function PowerToTheTopModel:TopRankData(data)
    self.RankData = {}
    if data then
        -- body
        for _, value in pairs(data) do
            self.RankData[value.sys_type] = value
        end
        --强制使用本地战力数据(不等待服务器战力同步)
        --但实际领取奖励时需等待同步完成
        self:MaxZhanLi(true)
        self:Top_Rank()
        self:InitAllRank()
    else
        _G.FunctionManager:GetInstance():CloseFunById(_G.MainFunctionItems.PowerToTheTop)
    end
end

function PowerToTheTopModel:InitAllRank()
    if self.RankData then
        local selfRankType = {}
        for sysType, v in pairs(self.RankData) do
            if v.state == 1 then
                if self.cacheInitRank[sysType] == nil then --首次开启或登录时拉一次
                    self.cacheInitRank[sysType] = true
                    if sysType == Top_RankList.afk then
                        self:AccessTopAfkList()
                        _G.table.insert(selfRankType, _G.PowerToTheTopType.afk)
                    elseif sysType == Top_RankList.arena then
                        self:AccessArena()
                        _G.table.insert(selfRankType, _G.PowerToTheTopType.arena)
                    elseif sysType == Top_RankList.dead then
                        self:AccessTopDeadList()
                        _G.table.insert(selfRankType, _G.PowerToTheTopType.dead)
                    elseif sysType == Top_RankList.artifact then
                        self:AccessTop_artifact()
                        _G.table.insert(selfRankType, _G.PowerToTheTopType.artifact)
                    end
                end
            end
        end
        self:GetNextPlayerRank(selfRankType)
    end
end

function PowerToTheTopModel:GetNextPlayerRank(typeLis)
    local num = _G.table.remove(typeLis, 1)
    if num == nil then
        return
    end
    self:GetPlayerRank(num, function()
        self:GetNextPlayerRank(typeLis)
    end)
end

