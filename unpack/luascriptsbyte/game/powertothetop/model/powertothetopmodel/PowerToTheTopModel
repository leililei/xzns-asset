--获取历史最高记录
function PowerToTheTopModel:GetRole_info(index, num)
    if self.RankData == nil or self.RankData[index].role_info == nil then
        return
    end
    for key, value in pairs(self.RankData[index].role_info) do
        if num == value.index then
            return value
        end
    end
    return
end

--添加历史最高记录
function PowerToTheTopModel:AddRole_info(index, num)
    if self.RankData[index].role_info == nil then
        return
    end
    for key, value in pairs(self.RankData[index].role_info) do
        if value.role_info.uid == num then
            value.role_info.point = value.role_info.point + 1
            self:AddRole_infoUid(index, value.role_info.uid)
            return
        end
    end
end

