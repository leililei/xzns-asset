            Top_Rank_PHB.dead,
            function(list)
                x = list.index
                self:PaiMingXianShi(tb, x, insId)
                updateScore(Top_Rank.dead, list.value)
            end
        )
    elseif self.YeMian == Top_Rank.arena then
        Model:GetPlayerRank(
            Top_Rank_PHB.arena,
            function(list)
                x = list.index
                self:PaiMingXianShi(tb, x, insId)
                updateScore(Top_Rank.arena, list.value)
            end
        )
    elseif self.YeMian == Top_Rank.ele_arena then
        Model:GetPlayerRank(
            Top_Rank_PHB.ele_arena,
            function(list)
                x = list.index
                self:PaiMingXianShi(tb, x, insId)
                updateScore(Top_Rank.ele_arena, list.value)
            end
        )
    elseif self.YeMian == Top_Rank.high_arena then
