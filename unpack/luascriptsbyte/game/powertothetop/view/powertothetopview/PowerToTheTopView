---服务器时间
function PowerToTheTopView:DianFuWuQiGuanBi()
    local currentTime = _G.TimeUtil.GetServerUnixTime()
    local timeStr
    if self.PowerToTheTopItemData.State == ActivityState.Notice then
        -- 状态：未开启
        -- 计时器文本：X天后开启
        local GetEnd_time = _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().open_time, _G.TimeUtil.GetServerUnixTime())
        local t = _G.TimeUtil.TranslateSecond((self.PowerToTheTopItemData.time_open - GetEnd_time) * 86400)
        timeStr = t.day
        self.go_table.aortext_time.text = _G.GetLangPackValue(90022501339, string.format("<color=#98D375>%s</color>", timeStr))

    elseif self.PowerToTheTopItemData.State == ActivityState.Settlement then
        -- 状态：已结算
        -- 计算整个活动剩余时间
        -- local remainingTime = _G.PlayerModel:GetInstance().open_time + _G.ConfigManager.activity_info_cfg[1000002].time_duration - currentTime

        -- timeStr = _G.TimeUtil.TranslateSecondForStrSixVsSix(remainingTime)
        -- self.go_table.aortext_time.text = _G.GetLangPackValue(90028300149, string.format("<color=#a5f37f>%s</color>", timeStr))
        self.go_table.aortext_time.text = _G.GetLangPackValue(90028300149)
        require("PowerToTheTopModel"):GetInstance().PowerToTheTopPanDuan()
    else
        -- 状态：进行中
        -- 计算榜单结束时间
        local remainingTime = self.PowerToTheTopItemData.leaderBoardEndTime - currentTime

        if remainingTime <= 0 then --活动已结束
            self.PowerToTheTopItemData.State = ActivityState.Settlement
            self:UpdateWillFinishTag()
        elseif remainingTime < 60 then --剩余时间小于60秒时(至少显示1分钟)
            remainingTime = 60
        end

        timeStr = _G.TimeUtil.TranslateSecondForStrSixVsSix(remainingTime)
        self.go_table.aortext_time.text = _G.GetLangPackValue(90028300148, string.format("<color=#98D375>%s</color>", timeStr))
    end
end

