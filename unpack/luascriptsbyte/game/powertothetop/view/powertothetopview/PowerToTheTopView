function PowerToTheTopView:ListNew(data)
    if not data then
        return
    end
    self.RankList = data
    local objItem = self.go_table.obj_ItemXianShi
    self.PanDuanXianShi = 0
    self.CanGetAward = false
    self.AwardItems = {}
    for key, value in pairs(data) do
        local LingQu, KeLingQu = false, false
        local item, Max

        local Num = Model:GetHis_max_value(self.YeMian)
        if self.YeMian == Top_Rank.high_arena then
            if Num <= value.min_rank then
                KeLingQu = true
            end
        else
            if Num >= value.min_rank then
                KeLingQu = true
            end
        end

        if Model:ISaward_index(self.YeMian, key) then
            LingQu = true
        end

        if key == _G.table.count(data) then
            Max = true
        else
            Max = false
        end
        --obj = _G.InstantiateObject(objItem, self.go_table.obj_Content)
        item = _G.GetAutoGoTable(objItem, _G.handlerbind(self, self.DianJiXiangYing, key))
        table.insert(self.AwardItems, item)
        self:ItemNewZhanShi(item, LingQu, KeLingQu, key)
    end
    self.go_table.aorbtn_Get:SetGray(not self.CanGetAward)
    self.go_table.aorbtn_Get:GetComponentE(_G.typeof(_G.CS.AorImage)).color =
    require("CardInfoManager").GetColorFromRGB(self.CanGetAward and "FFFFFF" or "A9A9A9")
    local color = self.CanGetAward and "8C2D14" or "434343"
    self.go_table.aortext_get.color = require("CardInfoManager").GetColorFromRGB(color)
end

---生成奖励值
function PowerToTheTopView:ItemNewZhanShi(item, LingQu, KeLingQu, key)
    item.aorbtn_click:SetActiveE(0)
    if not LingQu then
        if KeLingQu then
            self.CanGetAward = true
            if self.PanDuanXianShi < key then
                self.PanDuanXianShi = key
            end
        end
    end
end

