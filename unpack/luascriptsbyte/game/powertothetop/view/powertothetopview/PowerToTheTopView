    if self.TaskRewardInfo[insId] == nil then
        self.TaskRewardInfo[insId] = {}
    end
    X, Y = self:MaxNum()
    local function updateScore(type, value)
        local isSettlement = self.PowerToTheTopItemData.State == ActivityState.Settlement
        if not isSettlement or self.YeMian ~= type or self:IsNil() then
            return
        end
        Model:SetHis_max_value(type, value)
        _, Y = self:MaxNum()
        tb.aortext_Score.text = Y
    end
    local isPower = self.YeMian == 1
    tb.aorimage_Score:SetActiveE(isPower and 1 or 0)
    tb.aortext_Score.transform:SetLocalPosition(178 + (isPower and 32 or 0), 0, 0)
    tb.aortext_Score.text = Y
