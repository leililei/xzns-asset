---判断文字显示
function PowerToTheTopView:MaxNum()
    local wenzi, name
    if not self.YeMian then
        self.YeMian = 1
    end
    local isSettlement = self.PowerToTheTopItemData.State == ActivityState.Settlement
    local value = Model:GetHis_max_value(self.YeMian)
    if self.YeMian == Top_Rank.power then
        wenzi = TipsID.power
        name = _G.UIUtils.NumberToUnitStr_CardFightNum(value)
    elseif self.YeMian == Top_Rank.afk then
        local cfg
        if not isSettlement then
            cfg = Model:AccessTopAfkPowerList()
        else
            cfg = _G.ConfigManager.afk_cfg[value]
        end
        name = cfg and _G.LangUtil.GetLangPackValue(90020100026, cfg.chapter, cfg.section) or
            _G.GetLangPackValue(90027300017)
        wenzi = TipsID.afk
    elseif self.YeMian == Top_Rank.dead then
        wenzi = TipsID.dead
        if value == 0 then
            name = 0
        else
            name = _G.ConfigManager.tower_cfg[value].layer
        end
    elseif self.YeMian == Top_Rank.arena then
        wenzi = TipsID.arena
        local playeruid=_G.PlayerModel:GetInstance():GetPlayerUid()
        for i = 1, #self.list do
            if self.list[i].uid==playeruid then
                name=self.list[i].value
            end
        end
        if not name then
            name = Model.RankData[Top_Rank.arena].his_max_value
        end
    elseif self.YeMian == Top_Rank.ele_arena then
        wenzi = TipsID.ele_arena
        name = NumberToUnitStrFight(value)
    elseif self.YeMian == Top_Rank.high_arena then
        --self.go_table.aortext_gaijitie.text = _G.GetLangPackValue(cfg.name)
        wenzi = TipsID.high_arena
        local cfg = _G.ConfigManager.arena_senior_cfg[value]
        if cfg == nil then
            name = _G.GetLangPackValue(90022100091)
        else
            name = _G.GetLangPackValue(cfg.name)
        end
    elseif self.YeMian == Top_Rank.artifact then
        wenzi = TipsID.artifact
        name = NumberToUnitStrFight(value)
    end
    return wenzi, name
end

