---@class PowerToTheTopItem : Component	中文描述
---@field go_table PowerToTheTopView._obj_ActivityTab_GoTable
local PowerToTheTopItem = _G.BaseClass("PowerToTheTopItem", _G.Component)
function PowerToTheTopItem:__init(obj, data)
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnActivityBtnClick))
    self.View = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.PowerToTheTopView.Name)
    obj:SetName(data.id)
    self:InitData(data)

    self:InitRedPoint(self.id)
    --self.go_table.aortext_Desc.text = _G.LangUtil.GetLangPackValue(data.name)
end

function PowerToTheTopItem:InitData(data)
    --排行榜sid
    self.id = data.id
    --显示排序
    self.display_priority = data.display_priority
    --开启相对天数
    self.time_open = data.time_open
    --结束相对天数
    self.end_time = data.end_time
    self.leaderBoardEndTime = _G.PlayerModel:GetInstance().open_time + data.end_time * 3600
    --可点赞次数
    self.praise_num = data.praise_num
    --点赞奖励
    self.praise_rewards = data.praise_rewards
    --排行榜引用（读取rank_top）
    self.rank = data.rank
    --阶段目标引用读取rank_top）
    self.goal = data.goal
    self.State = 1

    self:UpdateWillFinishTag()
end

--红点刷新
function PowerToTheTopItem:InitRedPoint(id)
    local is = Model:InitRedPoint(id)
    -- 如果当前页签状态为结算，则关闭红点
    if self.State == ActivityState.Settlement then
        is = 0
    end
    self.go_table.obj_redpoint:SetActiveE(is)
end

function PowerToTheTopItem:RefreshItem()
    self.go_table.gameObject:SetActiveE(1)
    self.go_table.aorimage_Suo:SetActiveE(0)
    self.go_table.aorimage_isOn:SetActiveE(0)
    self.go_table.aorimage_isOff:SetActiveE(0)
    local GetEnd_time =
    _G.TimeUtil.GetInterValDayByGame(_G.PlayerModel:GetInstance().open_time, _G.TimeUtil.GetServerUnixTime())
    if self.time_open > GetEnd_time then
        self.State = ActivityState.Notice
        self.go_table.gameObject:SetActiveE(0)
        self.go_table.aorimage_Suo:SetActiveE(1)
        local t = self.time_open - GetEnd_time
        local timeStr = _G.string.format(_G.LangUtil.GetLangPackValue(Time.kai), t)
        self.Timeday = t

        self.go_table.aortext_Suo.text = timeStr
    elseif (_G.TimeUtil.GetServerUnixTime() - _G.PlayerModel:GetInstance().open_time) >= (self.end_time + 1) * 3600 then
        self.State = ActivityState.Settlement
        self.go_table.gameObject:SetActiveE(0)
    else
        self.State = ActivityState.Open
    end
    return self.State
end

---刷新单个item
function PowerToTheTopItem:DoActivityBtn(Index)
    if Index == self.display_priority then
        self.go_table.aorimage_isOn:SetActiveE(1)
        self.View:PowerToTheTop(self)
    else
        self.go_table.aorimage_isOff:SetActiveE(1)
    end
    --更新状态的时候刷新红点
    self:InitRedPoint(self.id)
    self:UpdateWillFinishTag()
end

---更新标签显示状态
---@return void
function PowerToTheTopItem:UpdateWillFinishTag()
    local isOpen = self.State == ActivityState.Open
    if not isOpen then --活动未开启或已关闭
        self.go_table.obj_willFinish:SetActiveE(0)
        return
    end

    local currentTime = _G.TimeUtil.GetServerUnixTime()
    local endTime = _G.PlayerModel:GetInstance():GetServerOpenTime() + (self.end_time * 3600)
    local remainingTime = endTime - currentTime
    if remainingTime <= 0 or remainingTime > 86400 then --活动时间结束或大于24h
        self.go_table.obj_willFinish:SetActiveE(0)
        return
    end

    self.go_table.obj_willFinish:SetActiveE(1)
end

function PowerToTheTopItem:OnActivityBtnClick()
    if self.State == ActivityState.Notice then
        local cfg = _G.ConfigManager.tips_system_cfg[1515]
        cfg = _G.LangUtil.GetLangPackValue(cfg.content, self.Timeday)
        _G.PopWindowManager:GetInstance():ShowAllTips(1515, cfg)
        return
    end
    self.View:InitPowerToTheTopItem(self.display_priority)
end

--红点刷新
function PowerToTheTopView:InitRedPoint(id)
    self.ActivityList[id]:InitRedPoint(id)
    local redpointActive = self.ActivityList[id].go_table.obj_redpoint:GetActiveSelf()
    -- 如果当前页签状态为结算，则关闭红点
    if self.ActivityList[id].State == ActivityState.Settlement then
        redpointActive = false
    end
    self.go_table.obj_awardRedPoint:SetActiveE(redpointActive and 1 or 0)
end

---侧边item生成
function PowerToTheTopView:ActivityData()
    self.ActivityDatacfg = Model:CheckIsNew() and _G.ConfigManager.rank_list2_cfg or _G.ConfigManager.rank_list_cfg
    self.funIDs = {}
    for _, v in pairs(self.ActivityDatacfg) do
        if not v.reveal then
            _G.table.insert(self.funIDs, v.id)
        end
    end
    _G.SortList(
        self.funIDs,
        function(data)
            return -self.ActivityDatacfg[data].display_priority
        end
    )
    for k, v in pairs(self.funIDs) do
        local obj = _G.InstantiateObject(self.go_table.obj_ActivityTab, self.go_table.obj_ContentT)
        obj:SetName(v)
        local activityItem = self:GetComponent(obj, PowerToTheTopItem)
        if activityItem == nil then
            activityItem = self:AddComponent(obj, PowerToTheTopItem.New(obj, self.ActivityDatacfg[v]))
        end
        local tb = _G.GetAutoGoTable(obj)
        tb.aortext_Desc.text = _G.GetLangPackValue(activityItem.View.ActivityDatacfg[v].name)
        if AppSetting.IsXzns then
            tb.aortext_off.text = _G.GetLangPackValue(activityItem.View.ActivityDatacfg[v].name)
        end
        tb.aorimage_offIcon.SpriteName = ToggleIcon[v] .. "_n_icon"
        tb.aorimage_onIcon.SpriteName = ToggleIcon[v] .. "_c_icon"
        self.ActivityList[v] = activityItem
    end
    local page = 0
    for i = 1, #self.funIDs do
        local state = self.ActivityList[self.funIDs[i]]:RefreshItem()
        if state == ActivityState.Open and page == 0 then
            page = i
        end
    end
    self:InitPowerToTheTopItem(page)
end

--侧边item刷新
function PowerToTheTopView:InitPowerToTheTopItem(Index)
    if _G.table.isEmptyOrNil(self.ActivityDatacfg) then
        return
    end

    if self.YeMian and self.ActivityDatacfg[self.YeMian].display_priority == Index then
        return
    end
    local displayIndex = self.funIDs[Index]
    if Model:CheckIsNew() then
        self.go_table.obj_BG:SetActiveE(0)
        self.go_table.obj_BG1:SetActiveE(1)
        self.go_table.obj_New:SetActiveE(1)
        self.go_table.aortext_time:SetAnchorPosition(-159, -490)
        local skinCfg = _G.ConfigManager.skin_cfg[self.ActivityDatacfg[displayIndex].skin_id]
        local card = _G.GetAutoGoTable(self.go_table.obj_CardItem, _G.handlerbind(self, self.OnClickSkin, skinCfg))
        card.aortext_SkinName.text = _G.GetLangPackValue(skinCfg.name)
        card.aortext_CardName.text = _G.GetLangPackValue(_G.ConfigManager.card_cfg[skinCfg.card].Name)
        card.aorrawimage_Card:LoadImage(skinCfg.Photo)
        self.go_table.trans_spine:RemoveAllChildren()
        _G.PoolsManager:GetInstance():Spawn(
            skinCfg.ModelPathHi,
            _G.ePoolType.Temporary,
            self.go_table.trans_spine,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                local pos = self.ActivityDatacfg[displayIndex].sp_set
                trans:SetLocalPosition(
                    pos[1] and pos[1] or 0,
                    pos[2] and pos[2] or 0,
                    pos[3] and pos[3] or 0
                )
                trans:SetLocalScaleXYZ(pos[4] and pos[4] or 1)
                _G.GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
            end
        )
    else
        self.go_table.obj_BG:SetActiveE(1)
        self.go_table.obj_BG1:SetActiveE(0)
        self.go_table.obj_New:SetActiveE(0)
        self.go_table.aortext_time:SetAnchorPosition(0, -512)
    end
    for i = 1, #self.funIDs do
        self.ActivityList[self.funIDs[i]]:DoActivityBtn(Index)
    end
    self.go_table.obj_ActivityTab:SetActiveE(0)
    local redpointActive = self.ActivityList[self.funIDs[Index]].go_table.obj_redpoint:GetActiveSelf()
    -- 如果当前页签状态为结算，则关闭红点
    if self.ActivityList[self.funIDs[Index]].State == ActivityState.Settlement then
        redpointActive = 0
    end
    self.go_table.obj_awardRedPoint:SetActiveE(redpointActive)
    self.go_table.aorbtn_rankAward:SetActiveE(self.ActivityList[self.funIDs[Index]].State == ActivityState.Open and 1 or 0)
end

---更新标签显示状态
function PowerToTheTopView:UpdateWillFinishTag()
    if _G.table.isEmptyOrNil(self.ActivityDatacfg) then
        return
    end
    for i = 1, #self.funIDs do
        self.ActivityList[self.funIDs[i]]:UpdateWillFinishTag()
    end
end

