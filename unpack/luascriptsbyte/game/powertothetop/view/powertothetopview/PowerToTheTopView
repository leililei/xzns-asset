---判断文字显示
function PowerToTheTopView:Rank_value(value)
    local wenzi, name
    if self.YeMian == Top_Rank.power then
        wenzi = TipsID.power
        name = _G.UIUtils.NumberToUnitStr_CardFightNum(value)
    elseif self.YeMian == Top_Rank.afk then
        name =
            _G.LangUtil.GetLangPackValue(
            90023633340,
            _G.ConfigManager.afk_cfg[value].chapter,
            _G.ConfigManager.afk_cfg[value].section
        )
        wenzi = TipsID.afk
    elseif self.YeMian == Top_Rank.dead then
        wenzi = TipsID.dead
        if value == 0 then
            name = 0
        else
            name = _G.ConfigManager.tower_cfg[value].layer
        end
    elseif self.YeMian == Top_Rank.arena then
        wenzi = TipsID.arena
        name = NumberToUnitStrFight(value)
    elseif self.YeMian == Top_Rank.ele_arena then
        wenzi = TipsID.ele_arena
        name = NumberToUnitStrFight(value)
    elseif self.YeMian == Top_Rank.high_arena then
        wenzi = TipsID.high_arena
        local cfg = _G.ConfigManager.arena_senior_cfg[value]
        if cfg == nil then
            name = _G.GetLangPackValue(90022100091)
        else
            name = _G.GetLangPackValue(cfg.name)
        end
    elseif self.YeMian == Top_Rank.artifact then
        wenzi = TipsID.artifact
        name = NumberToUnitStrFight(value)
    end
    return wenzi, name
end

