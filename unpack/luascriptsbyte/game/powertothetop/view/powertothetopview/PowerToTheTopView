---判断item显示
function PowerToTheTopView:ItemXianShu(shu)
    local rank_top_cfg = _G.ConfigManager.rank_top_cfg

    for key, value in pairs(self.PowerToTheTopItemData.rank) do
        if rank_top_cfg[value].min_rank <= shu and rank_top_cfg[value].max_rank >= shu then
            return rank_top_cfg[value].rewards
        end
    end

    return nil
end

