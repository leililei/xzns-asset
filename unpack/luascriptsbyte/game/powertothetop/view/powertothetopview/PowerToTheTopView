---按钮点击事件在这里派发
function PowerToTheTopView:OnClickBtn(go, isOn)
    if go == nil then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_rankAward" then
        self:ListNew(self.RankList)
        self.go_table.obj_RankAward:SetActiveE(1)
        self.go_table.scrollloopvectical_listAward:InitItemData(#self.RankList, _G.handler(self, self.RefreshListAward))
        _G.DelayFrameDo(
                function()
                    self.go_table.scrollloopvectical_listAward:ScrollToIndex(self.PanDuanXianShi - 1)
                end
        )
    elseif name == "@_aorbtn_previewAward" then
        self.go_table.obj_PaiHangBang:SetActiveE(1)

        if self.PhBDi == nil then
            self.go_table.scrollloopvectical_listPHB:InitItemData(0, _G.handler(self, self.RefreshListPHB))
            self.PhBDi = false
        end

        self:ShuJuShuXingPHB()
    elseif name == "@_aorbtn_Get" or name == "@_aorbtn_click" then
        if require("PowerToTheTopModel"):GetInstance().PanDuan then
            return
        end
        if not self.CanGetAward then
            _G.PopWindowManager:GetInstance():ShowAllTips(25)
            return
        end
        -- local award
        local index_list = {}
        for i = 1, self.PanDuanXianShi do
            if not Model:ISaward_index(self.YeMian, i) then
                _G.table.insert(index_list, i)
            end
        end
        if not _G.table.isEmptyOrNil(index_list) then
            local pb = {sys_type = self.YeMian, index_list = index_list}
            Model:GetAward(
                pb,
                function(msg)
                    if msg.ack == 1 then
                        for _, v in pairs(index_list) do
                            Model:AddAward(self.YeMian, v)
                        end
                        _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        self:InitRedPoint(self.YeMian)
                        self.go_table.obj_awardRedPoint:SetActiveE(0)
                    end
                end
            )
        end
        self.go_table.obj_RankAward:SetActiveE(0)
    elseif name == "@_aorbtn_Back" and isOn then
        self:Close()
    elseif (name == "@_aorbtn_PhBClose" or name == "@_aorbtn_PhBBack") and isOn then
        self.go_table.obj_PaiHangBang:SetActiveE(0)
    elseif (name == "@_aorbtn_AwardClose" or name == "@_aorbtn_AwardBack") and isOn then
        self.go_table.obj_RankAward:SetActiveE(0)
    elseif go == self.go_table.aorbtn_way then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, Model:CheckIsNew() and 1007 or 101)
    end
end

