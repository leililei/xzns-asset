---战斗力 数字计算
---@param isNotCell boolean 是否取消四舍五入
function PowerToTheTopView.NumberToUnitStr_CardFightNum(num)
    -- 小数点规则
    -- 保留一位小数 四舍五入
    -- 10.56亿 算10.6亿
    --num = _G.GameUtil.FormatNum(num)
    local str = ""
    local len = string.len(num)
    --个十百千万十百千亿0
    if len > 8 then
        num = num * 0.00000001
        --len = string.len(num)
        str = string.sub(num, 1, len - 6)
        str = str .. _G.LangUtil.GetLangPackValue(90023100002)
    elseif len > 4 then
        num = num * 0.0001
        --len = string.len(num)
        str = string.sub(num, 1, len - 2)
        str = str .. _G.LangUtil.GetLangPackValue(90023100001)
    else
        str = tostring(num)
    end
    return str
end

