function PowerToTheTopView:SetGradient(obj, index)
    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- local gradient = go
    local c1 = _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 = _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 = _G.CS.UnityEngine.GradientColorKey()
    local color2 = _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:GetGradient():SetKeys({color1, color2}, {alpha1, alpha2})
end

