---获取赛季特权信息
function SeasonSGiftModel:Info(Call)
    require("SeasonSGiftNet"):GetInstance():PrivilegeInfo(
        function(msg)
            if msg.info ~= nil then
                self.state = msg.info.state
                self.ticket_num = msg.info.ticket_num
                require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstRitual.id)
            end

            if Call ~= nil then
                Call(msg)
            end

            if self.reconnectEndCall then
                self.reconnectEndCall()
                local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SeasonSGiftView.Name)
                if view ~= nil then
                    view.View:HuoQu()
                end
            end
        end
    )
end
---获取赛季特权信息
function SeasonSGiftModel:Get(Call)
    require("SeasonSGiftNet"):GetInstance():PrivilegeGet(
        function(msg)
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
            if Call ~= nil then
                Call(msg)
            end
        end
    )
end

function SeasonSGiftModel:ReConnect(endcall)
    self.reconnectEndCall = endcall
    self:Info(_G.handler(self, self.ParseData))
end
---#endregion
---@return SeasonSGiftModel
return SeasonSGiftModel
