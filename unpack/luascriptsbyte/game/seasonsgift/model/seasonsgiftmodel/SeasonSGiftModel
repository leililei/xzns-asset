---@class SeasonSGiftModel : SeasonBaseModel
---@field GetInstance fun():SeasonSGiftModel
local SeasonSGiftModel = _G.BaseClass("SeasonSGiftModel", require("SeasonBaseModel"))
function SeasonSGiftModel:GetDataFormServer()
    --self:GetBountyData(_G.handler(self, self.ParseData))
    local view = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.SeasonSGiftView.Name)
    if view ~= nil then
        view.View:HuoQu()
    else
        self:Info(_G.handler(self, self.ParseData))
    end
end
---创建对象时,入口构造函数
function SeasonSGiftModel:__init()
    self.curFunctionOpenID = _G.FunctionID.SeasonSGift
    self.redPointId = _G.ConfigManager.redpoint_cfg.FirstRitual.id
end
function SeasonSGiftModel:OpenView()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonSGiftView.Name)
end
---打开赛季弹窗
function SeasonSGiftModel:PanDuan()
    if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() <= 0 or self.state ~= 0 then
        return
    end

    local kaiguan = _G.PlayerPrefsManager.GetInt("SeasonSGift2")

    if kaiguan ~= nil and  _G.TimeUtil.GetInterValDayByGame(kaiguan, _G.TimeUtil.GetServerUnixTime()) == 0 then
        return true
    end
    local tb = _G.TimeUtil.TranslateSecond(require "SeasonModel":GetInstance():GetSeasonTimeLeft())
    local tian = _G.ConfigManager.discrete_cfg[105408][1][1]
    if tb.day < tian then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonSGiftExpectlView.Name)
    end
end
