---@class SeasonSGiftExpectlView : UIBaseView	中文描述
---@field public go_table SeasonExpectlView_GoTable GoTable
---@field itemList table<number,BaseAwardNewItem>
local SeasonSGiftExpectlView = _G.BaseClass("SeasonSGiftExpectlView", _G.UIBaseView)
--_G.SeasonSGiftExpectlView = SeasonSGiftExpectlView

function SeasonSGiftExpectlView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonSGiftExpectlView:OnCreate()
    self.itemList = {}
    local PeiZiBiaoID = require("SeasonModel"):GetInstance():GetCfg().store_privilege
    _G.PlayerPrefsManager.SetInt("SeasonSGift2", _G.TimeUtil.GetServerUnixTime())
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstRitual.id)

    self.Item = _G.ConfigManager.store_month_cfg[PeiZiBiaoID]
    self.data = {}

    local ItemList = {}
    for key, value in pairs(self.Item.goods) do
        ItemList[value[1]] = value
    end
    local num = 1
    if require("SeasonSGiftModel"):GetInstance().ticket_num > 0 then
        num = require("SeasonSGiftModel"):GetInstance().ticket_num
    end

    for key, value in pairs(self.Item.goods_extra) do
        if ItemList[value[1]] ~= nil then
            ItemList[value[1]] = {value[1], ItemList[value[1]][2] + (value[2] * num)}
        else
            ItemList[value[1]] = {value[1], value[2] * num}
        end
    end
    for key, value in pairs(ItemList) do
        _G.table.insert(self.data, value)
    end

    self:InitTime()
    self.isGet = require "SeasonModel":GetInstance():GetSeasonTimeLeft()
    local count = #self.data
    -- self.go_table.scrollloophorizontal_itemList:UpdateSscrollRectWeight(
    --     count > 4 and 457 or 4 + (count - 1) * 23 + count * 96
    -- )
    self.go_table.scrollloophorizontal_itemList:InitItemData(#self.data, _G.handler(self, self.RefreshItem))
    -- self.go_table.aorbtn_get:SetActiveE(self.isGet and 0 or 1)
end

---初始化时间显示
function SeasonSGiftExpectlView:InitTime()
    local tb = _G.TimeUtil.TranslateSecond(require "SeasonModel":GetInstance():GetSeasonTimeLeft())
    if tb.day > 0 or (tb.hour == 23 and tb.min > 0 or tb.sec > 0) then
        if tb.hour > 0 or tb.min > 0 or tb.sec > 0 then
            tb.day = tb.day + 1
        end
        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90025500037, tb.day)
    else
        if tb.min > 0 or tb.sec > 0 then
            tb.hour = tb.hour + 1
        end

        self.go_table.aortext_time.text = _G.LangUtil.GetLangPackValue(90025500037, tb.hour)
    end
end

---刷新显示
---@param index number 下标
---@param obj UnityEngine.GameObject
function SeasonSGiftExpectlView:RefreshItem(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.itemList[id]
    if not item then
        item = require "BaseAwardNewItem".New(obj, nil, 96)
        self.itemList[id] = item
    end
    item:ShowWithID(self.data[index + 1])
    --item.go_table.obj_mask:SetActiveE(self.isGet and 1 or 0)
end

---按钮点击事件在这里派发
function SeasonSGiftExpectlView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SeasonSGiftView.Name)
        self:Close()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return SeasonSGiftExpectlView
