function SeasonSGiftView:OnDestroy()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function SeasonSGiftView:OnMallCashListener()
    self.go_table.obj_Mask:SetActiveE(0)
    require("SeasonSGiftModel"):GetInstance():Info(_G.handler(self, self.HuoQu))
end

