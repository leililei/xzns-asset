function SeasonSGiftView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.YiShengCheng = {}
    ---当前赛季ID
    self.SaiJiID = require("SeasonModel"):GetInstance():GetCurSeasonId()
    require("SeasonSGiftModel"):GetInstance():Info(_G.handler(self, self.HuoQu))
    _G.PlayerPrefsManager.SetInt("SeasonSGift", require("SeasonModel"):GetInstance():GetTime().startTime)
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.FirstRitual.id)

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

---获取赛季信息
function SeasonSGiftView:HuoQu()
    local PeiZiBiaoID = require("SeasonModel"):GetInstance():GetCfg().store_privilege
    self.Item = _G.ConfigManager.store_month_cfg[PeiZiBiaoID]
    local but, buer, er = 1, 1
    self:XianShi(0)

    if require("SeasonSGiftModel"):GetInstance().state == 0 then
        but = 1
        buer = 3
        er = 2
        _G.GameUtil.SetPriceByChannel(self.Item.price_id, self.go_table.aortext_miaoshu)
        self:ZhanShi(0)
    elseif require("SeasonSGiftModel"):GetInstance().state == 1 then
        if require("SeasonSGiftModel"):GetInstance().ticket_num <= 0 then
            but = 2
            buer = 3
            er = 3
        else
            but = 1
            buer = 6
            er = 2
            self:ZhanShi(0)
        end
        self.go_table.aortext_miaoshu.text = _G.ConfigManager.language_package_cfg[TileTetx[buer]]
    end
    if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() < 86400 then
        if require("SeasonSGiftModel"):GetInstance().ticket_num <= 0 then
            self.go_table.aortext_miaoshu.text = _G.ConfigManager.language_package_cfg[TileTetx[5]]
            but = 1
            er = 4
            self:ZhanShi(1)
        else
            er = 2
        end
    end
    self.go_table.aortext_TileEr.text = _G.ConfigManager.language_package_cfg[TileTetx[er]]

    self.go_table.aorimage_QianWangbtn.SpriteName = ButImage[but]
end

function SeasonSGiftView:ZhanShi(num)
    for i = 1, 2 do
        local var = self.go_table["obj_gou" .. i]

        var:SetActiveE(num)
    end
end

---购买界面增加
function SeasonSGiftView:Mask(nums)
    local ItemList = {}
    for key, value in pairs(self.Item.goods) do
        ItemList[key + nums] = value
        if require("SeasonSGiftModel"):GetInstance().state == 0 then
            --if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() < 86400 then
            ItemList[key + nums + 2] = value
            -- end
        end
    end
    local num = 1

    for key, value in pairs(self.Item.goods_extra) do
        ItemList[key + nums + 2] = { value[1], value[2] * num }
    end
    for key, value in pairs(ItemList) do
        local var = self.go_table["obj_Item" .. key]

        self:tanQuanDian(value, false, var, key)
    end
end

function SeasonSGiftView:XianShi(nums)
    local ItemList = {}
    for key, value in pairs(self.Item.goods) do
        ItemList[key + nums] = value
        if require("SeasonSGiftModel"):GetInstance().state == 0 then
            --if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() < 86400 then
            ItemList[key + nums + 2] = value
        end
    end
    local num = 1
    if require("SeasonSGiftModel"):GetInstance().ticket_num > 0 then
        num = require("SeasonSGiftModel"):GetInstance().ticket_num
    end
    local max = require("SeasonModel"):GetInstance():GetCfg().duration
    for key, value in pairs(self.Item.goods_extra) do
        ItemList[key + nums] = { value[1], ItemList[key + nums][2] + value[2] * max }
        if ItemList[key + nums + 2] ~= nil and ItemList[key + nums + 2][2] ~= nil then
            ItemList[key + nums + 2] = { value[1], ItemList[key + nums + 2][2] + value[2] * num }
        else
            ItemList[key + nums + 2] = { value[1], value[2] * num }
        end
        if require("SeasonModel"):GetInstance():GetSeasonTimeLeft() < 86400 then
            if require("SeasonSGiftModel"):GetInstance().ticket_num <= 0 then
                ItemList[key + nums + 2] = ItemList[key + nums]
            end
        end
    end

    for key, value in pairs(ItemList) do
        local var = self.go_table["obj_Item" .. key]

        self:tanQuanDian(value, false, var, key)
    end
end

