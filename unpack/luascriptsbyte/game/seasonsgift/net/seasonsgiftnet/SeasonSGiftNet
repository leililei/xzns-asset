local BaseGameNet = require("BaseGameNet")

---@class SeasonSGiftNet : BaseGameNet 描述
---@field GetInstance fun():SeasonSGiftNet
local SeasonSGiftNet = _G.BaseClass("SeasonSGiftNet", BaseGameNet)

---请求
---@param pbData table PB数据
---@param item net_map 网络协议
---@param callback function 完成回调
function SeasonSGiftNet:GetData(pbData, item, callback)
    if pbData == nil then
        pbData = self:GetEmptyPB()
    end
    local port = BaseGameNet:Access(item, pbData, _G.handler(self, self.GetDataCall))
    self.Call[port] = callback
end
---获取赛季特权信息
---@param callback function 完成回调
function SeasonSGiftNet:PrivilegeInfo(callback)
    local item = _G.ConfigManager.net_map.game_season_privilege_info
    self:GetData(nil, item, callback)
end
---领取赛季特权奖励
---@param pbData c2s_bounty_group_put
function SeasonSGiftNet:PrivilegeGet(callback)
    local item = _G.ConfigManager.net_map.game_season_privilege_get
    self:GetData(nil, item, callback)
end

---后端主动推送的数据
function SeasonSGiftNet:P2C_Friendinfo(data)
    require("BountyGroupModel"):GetInstance():BoxAward(data)
end
---请求回调
---@param port number 中文描述
---@param data table 返回PB数据
---@param error string 错误信息
function SeasonSGiftNet:GetDataCall(port, data, error)
    if error then
        if _G.AppSetting.DEBUG then
            _G.LogError("SeasonSGiftNet :" .. error)
        end
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---析构函数
function SeasonSGiftNet:Dispose()
end

---@return SeasonSGiftNet
return SeasonSGiftNet
