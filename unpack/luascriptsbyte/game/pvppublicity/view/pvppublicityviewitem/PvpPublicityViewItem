--排名名次背景
local rankBackgroundImages = {
    "tz_qjhs_di_02",
    "tz_qjhs_di_03",
    "tz_qjhs_di_04",
    "ui_jjc_pic_jinjijl"
}

---排名渐变颜色
local Gradient = {
    [1] = { "ffcb28", "ffffff" },
    [2] = { "e930ff", "ffffff" },
    [3] = { "1f7296", "ffffff" },
    [4] = { "5c3b1d", "ffffff" }
}
---排名颜色
local rankColor = {
    white = _G.Color.New(1, 1, 1, 1, 1),
    brown = _G.Color.New(0.33, 0.23, 0.04, 1)

}
---(前3名)名次图标
local rankIconImages = {
    "0ui_icon_diyi",
    "0ui_icon_dier",
    "0ui_icon_disan"
}

local PvpPublicityModel = require("PvpPublicityModel")

---@class PvpPublicityViewItem : UIBaseView Pvp目标推送(子状态)
---@field go_table PvpPublicityView._obj_item_GoTable
---@field gameObject UnityEngine.GameObject
---@field data PvpPublicityData
---@field awardItems any[]                  奖励UI节点
local PvpPublicityViewItem = _G.BaseClass("PvpPublicityViewItem")

---初始化方法
---@private
function PvpPublicityViewItem:__init(obj, d)
    self.go_table = _G.GetAutoGoTable(obj)
    self.gameObject = obj
    self.data = d
end

---设置数据信息
---@public
---@param index number
---@param player RankListData.Player      玩家信息
function PvpPublicityViewItem:Show(index, player)
    self.gameObject:SetActiveE(1)
    --排名状态
    ---@type UnityEngine.Component 彩色渐变框
    local component = self.go_table.aortext_rank:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    if not _G.IsNil(component) then
        component.enabled = index ~= nil and index <= 3
    end
    if index ~= nil then
        if index <= 0 then
            self.go_table.aortext_rank.text = _G.GetLangPackValue(90026500029)
        elseif index <= 3 then
            --self.go_table.aorimage_rankBg.SpriteName = rankBackgroundImages[index]
            self.go_table.aorimage_rank.SpriteName = rankIconImages[index]
            self.go_table.aortext_rank.color = rankColor.white
            self:SetGradient(self.go_table.aortext_rank, index)
        else
            self.go_table.aortext_rank.color = rankColor.brown
        end
        self.go_table.aortext_rank.text = tostring(index)
        self.go_table.aorimage_rank:SetActiveE(index >= 1 and index <= 3 and 1 or 0)
    else
        self.go_table.aorimage_rank:SetActiveE(0)
        self.go_table.aortext_rank.text = _G.GetLangPackValue(90026500029)
    end
    --头像丶名称丶分数
    if player then
        self.go_table.aortext_name.text = player.name or "???"
        self.go_table.aortext_score.text = _G.GetLangPackValue(90000010438, tostring(player.score))
        --设置玩家头像或公会头像
        local isGuild = self.data.id == PvpPublicityModel:GetInstance().ePvpPublicityType.SociatyBattle
        if isGuild then
            ---@type guild_portrait_cfg
            local cfg = _G.ConfigManager.guild_portrait_cfg[player.banner]
            self.go_table.aorrawimage_guildIcon:LoadImage(cfg and cfg.portrait)
        else
            _G.UIUtils.SetPlayerHeadItemNew(
                    self.go_table.obj_head,
                    player,
                    1,
                    true,
                    nil,
                    nil,
                    function()
                        if not self.gameObject or self.gameObject:IsNull() then
                            return
                        end
                        if player.type == 1 then
                            _G.SystemSettingManager:GetInstance():OpenRobotPlayInfo(player.uid, nil, _G.RobotType.Arena)
                            return
                        end
                        if player.uid ~= _G.PlayerModel:GetInstance():GetPlayerUid() then
                            _G.SystemSettingManager:GetInstance():OpenView(player.uid)
                            return
                        end
                        _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                    end
            )
        end
        self.go_table.obj_headParent:SetActiveE(isGuild and 0 or 1)
        self.go_table.obj_guildParent:SetActiveE(isGuild and 1 or 0)
    end
    self.go_table.obj_content:SetActiveE(player and 1 or 0)
    local _ = self.go_table.obj_noBody and self.go_table.obj_noBody:SetActiveE(player and 0 or 1)
    --段位徽章
    local score = player and player.score or 0
    --local badgeIcon = index and index >= 1 and PvpPublicityModel:GetInstance():GetScoreBadgeIcon(self.data.id, score)
    --if badgeIcon then
    --    self.go_table.aorrawimage_badge:LoadImage(badgeIcon)
    --end
    --self.go_table.aorrawimage_badge:SetActiveE(badgeIcon and 1 or 0)

    self:ShowAward(index, score)
end

function PvpPublicityViewItem:SetGradient(obj, index)
    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
    -- local gradient = go
    local c1 = _G.ColorTools.FormatColorByString(Gradient[index][1])
    local c2 = _G.ColorTools.FormatColorByString(Gradient[index][2])
    local color1 = _G.CS.UnityEngine.GradientColorKey()
    local color2 = _G.CS.UnityEngine.GradientColorKey()
    color1.color = c1
    color1.time = 1
    color2.color = c2
    color2.time = 0

    local alpha1 = _G.CS.UnityEngine.GradientAlphaKey()
    local alpha2 = _G.CS.UnityEngine.GradientAlphaKey()

    alpha1.alpha = 255
    alpha1.time = 1
    alpha2.alpha = 255
    alpha2.time = 0

    gradient:GetGradient():SetKeys({ color1, color2 }, { alpha1, alpha2 })
end

---显示奖励信息
---@private
---@param index number
---@param score number
function PvpPublicityViewItem:ShowAward(index, score)
    if not self.go_table.trans_awardRoot then
        return
    end
    --回收所有节点
    if self.awardItems then
        for _, item in ipairs(self.awardItems) do
            if item.gameObject and not item.gameObject:IsNull() then
                item.gameObject:SetLocalScale(1, 1, 1)
                _G.ItemFactory:GetInstance():SetItemCard(item)
            end
        end
        self.awardItems = nil
    end

    --获取奖励列表
    local award = PvpPublicityModel:GetInstance():GetAward(self.data.id, index, score)
    local len = award and #award or 0
    if len <= 0 then
        return
    end

    self.awardItems = {}
    local cacheItems = self.awardItems
    for i = 1, #award do
        local id, num = table.unpack(award[i])
        _G.ItemFactory:GetInstance():GetItemCard(
                _G.ItemFactory.itemType.ItemBaseWithCount,
                self.go_table.trans_awardRoot,
                function(item)
                    if cacheItems ~= self.awardItems or not self.gameObject or self.gameObject:IsNull() then
                        if item and item.gameObject and not item.gameObject:IsNull() then
                            _G.ItemFactory:GetInstance():SetItemCard(item)
                        end
                        return
                    end
                    table.insert(cacheItems, item)
                    item.gameObject:SetLocalScale(0.8, 0.8, 0.8)
                    item:Show(id, nil, num)

                    local data = _G.StorageManager:GetInstance():GetStorageItemData(id)
                    local isShowEffect = data and data.Cfg and (data.Cfg.ef_item == 1 or data.Cfg.ef_item == "1") and true or false
                    item:ShowFrameEffect(id, isShowEffect)
                    item.gameObject:AddComponentE(_G.typeof(_G.CS.ParticleClipRect))
                end
        )
    end
end

return PvpPublicityViewItem
