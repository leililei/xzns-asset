require "BaseGameNet"

---@class DoubleResourcesNet : BaseGameNet	通信协议
local DoubleResourcesNet = _G.BaseClass("DoubleResourcesNet", require("BaseGameNet"))
local base = require("BaseGameNet")

---@return DoubleResourcesNet DoubleResourcesNet
function DoubleResourcesNet:GetInstance()
    return self.super.super.GetInstance(self)
end

--获取双倍信息
---@param callback function 回调方法
function DoubleResourcesNet:AccessToMap(callback)
    local item = _G.ConfigManager.net_map.game_system_activity_info
    local port = base.Access(self, item, self:GetEmptyPB(), _G.handler(self, self.AccessCall))
    self.Call[port] = callback
end
---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function DoubleResourcesNet:AccessCall(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end
return DoubleResourcesNet
