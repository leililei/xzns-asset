local DoubleResourcesNet = require "DoubleResourcesNet"
---@class DoubleResourcesModel
local DoubleResourcesModel = _G.BaseClass("DoubleResourcesModel", _G.GameDataModelBase)
local tipsID = {
    [101] = 102,
    [102] = 203,
    [103] = 204,
    [104] = 104,
    [105] = 205
}
---@return DailyDeliveryModel DailyDeliveryModel
function DoubleResourcesModel:GetInstance()
    return self.super.GetInstance(self)
end

function DoubleResourcesModel:GetDataFormServer()
    --当前双倍类型[id](101:材料副本，102：芦花幻境，103：世界boss，104：悬赏，105：千机黑刹 0为空)
    self.sid = 0

    self:GetInfo()
end
function DoubleResourcesModel:GetInfo()
    DoubleResourcesNet:GetInstance():AccessToMap(_G.handler(self, self.GetInfoCall))
end

function DoubleResourcesModel:FanHui(id)
    local tip = _G.ConfigManager.system_activity_cfg[self.sid]

    if tip ~= nil then
        for key, value in pairs(tip.system) do
            if value == id then
                return true
            end
        end
    end
    return false
end

---检测活动是否结束
function DoubleResourcesModel:GetInfoCall(msg)
    if msg.double.sid == nil then
        self.sid = 0
    else
        self.sid = msg.double.sid[1]
        self.i_item = {}
        for key, value in pairs(msg.double.item) do
            self.i_item[value.sid] = value
        end
    end

    local DoubleResources = _G.PlayerPrefsManager.GetInt("DoubleResourceslist")

    if DoubleResources == nil or DoubleResources == 0 or DoubleResources ~= self.sid then
        _G.PlayerPrefsManager.SetInt("DoubleResourceslist", 0)
    end

    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.FuliView.Name)

    if window then
        window.View:OnCreate()
    end
    window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DoubleResourcesView.Name)

    if window then
        window.View:ShuaXing()
    end
    self:ParseData()
end
---检测活动是否结束
function DoubleResourcesModel:CheckIsOvers()
    local cfg = _G.ConfigManager.function_open_cfg

    if self.sid == nil or self.sid == 0 then
        return true
    elseif self.sid == 101 then
        if
            not _G.GlobalConditionManager.CheckConditionByArray(cfg[6].condition_type) and
                not _G.GlobalConditionManager.CheckConditionByArray(cfg[7].condition_type) and
                not _G.GlobalConditionManager.CheckConditionByArray(cfg[8].condition_type)
         then
            return true
        end
    elseif self.sid == 102 then
        if not _G.GlobalConditionManager.CheckConditionByArray(cfg[54].condition_type) then
            return true
        end
    elseif self.sid == 103 then
        if not _G.GlobalConditionManager.CheckConditionByArray(cfg[4].condition_type) then
            return true
        end
    elseif self.sid == 104 then
        if not _G.GlobalConditionManager.CheckConditionByArray(cfg[12].condition_type) then
            return true
        end
    elseif self.sid == 105 then
        if not _G.GlobalConditionManager.CheckConditionByArray(cfg[41].condition_type) then
            return true
        end
    end
    return false
end

return DoubleResourcesModel
