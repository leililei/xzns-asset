local ActivitySynManager = require "ActivitySynManager"
---@class DoubleResourcesView : UIBaseView	中文描述
local DoubleResourcesView = _G.BaseClass("DoubleResourcesView", _G.UIBaseView)
--当前双倍类型[id](101:材料副本，102：芦花幻境，103：世界boss，104：悬赏，105：千机黑刹)
local tipsID = {
    [101] = "UI_sbkh_font_cysjssl",
    [102] = "UI_sbkh_font_cysjssl",
    [103] = "UI_sbkh_font_cysjssl",
    [104] = "UI_sbkh_font_cysjssl",
    [105] = "UI_sbkh_font_cysjssl"
}
local DoubleResourcesModel = require "DoubleResourcesModel"
function DoubleResourcesView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end
function DoubleResourcesView:OnCreate(activity)
    self.activity = activity
    self.typeCls = activity.typeClass
    self:ShuaXing()
end
function DoubleResourcesView:ShuaXing()
    _G.PlayerPrefsManager.SetInt("DoubleResourceslist", DoubleResourcesModel:GetInstance().sid)
    self.typeCls:RefreshRedPoint()

    if DoubleResourcesModel:GetInstance().sid ~= nil and DoubleResourcesModel:GetInstance().sid ~= 0 then
        if DoubleResourcesModel:GetInstance().i_item[DoubleResourcesModel:GetInstance().sid].image ~= nil then
            self.go_table.aorimage_LeiXing.SpriteName =
                DoubleResourcesModel:GetInstance().i_item[DoubleResourcesModel:GetInstance().sid].image
        end
    else
    end
end
function DoubleResourcesView:CloseView()
    self:Close()
end

function DoubleResourcesView:OnClickBtn(go, isOn, viewName)
    local name = go:GetName()

    if name == self.curView then
        return
    end
    if name == "@_aorbtn_QianWang" then
        local t = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Settlement)
        if _G.TimeUtil.GetServerUnixTime() >= t then
            _G.FunctionManager:GetInstance():ShowFuncitonOpenTips(650104)
        end
        -- if DoubleResourcesModel:GetInstance().sid == 101 then
        --     _G.JumpManager:GetInstance():Jump(124001)
        -- else
        --     _G.JumpManager:GetInstance():Jump(125001)
        -- end
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ActivityView.Name)
    end
end

return DoubleResourcesView
