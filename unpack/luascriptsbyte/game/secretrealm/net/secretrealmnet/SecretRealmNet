local base = require("BaseGameNet")

---@class SecretRealmNet : BaseGameNet    通信协议
local SecretRealmNet = _G.BaseClass("SecretRealmNet", base)
---@return SecretRealmNet SecretRealmNet
function SecretRealmNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
---@param callback function 回调
function SecretRealmNet:GetInfo(callback)
    self:Access(_G.ConfigManager.net_map.game_secret_realm_info, self:GetEmptyPB(), callback)
end

---设置心愿掉落
---@param callback function 回调
function SecretRealmNet:Wish(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_secret_realm_set_wish, pbData, callback)
end

---设置倍率
---@param callback function 回调
function SecretRealmNet:SetMultiple(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_secret_realm_set_multiple, pbData, callback)
end

---重置当前关卡进度
---@param callback function 回调
function SecretRealmNet:Reset(callback)
    self:Access(_G.ConfigManager.net_map.game_secret_realm_reset, self:GetEmptyPB(), callback)
end

---选择buff
---@param callback function 回调
function SecretRealmNet:ChooseBuff(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_secret_realm_choose_buff, pbData, callback)
end

---战斗
---@param callback function 回调
function SecretRealmNet:Battle(pbData, callback)
    return self:AccessWithError(_G.ConfigManager.net_map.game_secret_realm_fight, pbData, callback)
end

---复活
---@param callback function 回调
function SecretRealmNet:Revive(pbData, callback)
    return self:AccessWithError(_G.ConfigManager.net_map.game_secret_realm_revive, pbData, callback)
end

---获取布阵数据
---@param callback function 回调
function SecretRealmNet:GetEmbattle(callback)
    self:Access(_G.ConfigManager.net_map.game_secret_get_array, self:GetEmptyPB(), callback)
end

---设置布阵数据
---@param pbData secret_realm.c2s_update_array 发送数据
---@param callback function 回调
function SecretRealmNet:SetEmbattle(pbData, callback)
    self:Access(_G.ConfigManager.net_map.game_secret_update_array, pbData, callback)
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SecretRealmNet:Access(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.Callback))
    self.Call[port] = callback
    return port
end

---请求
---@param item net_map_Item 协议对象
---@param pbdata table 发送数据
---@param callback function 回调方法
function SecretRealmNet:AccessWithError(item, pbdata, callback)
    local port = base.Access(self, item, pbdata, _G.handler(self, self.CallbackWithError))
    self.Call[port] = callback
    return port
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SecretRealmNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function SecretRealmNet:CallbackWithError(port, data, error)
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return SecretRealmNet
