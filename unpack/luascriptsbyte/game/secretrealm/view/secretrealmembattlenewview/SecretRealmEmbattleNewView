local SecretRealmModel = require("SecretRealmModel")
---@class SecretRealmEmbattleNewView : UIBaseView    中文描述
---@field public go_table ActivityDispatchEmbattleNewView_GoTable GoTable
local SecretRealmEmbattleNewView = _G.BaseClass("SecretRealmEmbattleNewView", _G.UIBaseView)

function SecretRealmEmbattleNewView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretRealmEmbattleNewView:OnCreate(embattletype, itemType, exit, battle, arrays, save, sid, multiple, index)
    self.onExitCall = exit
    self.onBattleCall = battle
    self.onSaveCall = save
    self.embattletype = embattletype

    self.itemType = itemType
    local mgpId = 530010200
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    require("EmbattleController"):GetInstance():OpenEmbattle(
        embattletype,
        _G.EmbattleSaveType.temporary,
        true,
        _G.EmbattleControllerItemType.SecretRealm,
        _G.handler(self, self.OnExitCall),
        _G.handlerbind(self, self.OnBattleCall, sid, multiple, index),
        mgpId,
        arrays,
        _G.handler(self, self.OnSaveCall)
    )

    if sid ~= nil then
        self.curAbyssalMaw, self.curAbyssalMawOne = SecretRealmModel:GetInstance():GetAbyssalMaw(index - 1)
        local num = _G.ConfigManager.secret_realm_cfg[sid].resistance_limit
        if num > 0 then
            self.go_table.obj_des2:SetActiveE(self.curAbyssalMawOne > num and 1 or 0)
            self.go_table.obj_des:SetActiveE(self.curAbyssalMawOne < num and 1 or 0)
            self.go_table.obj_desBg:SetActiveE(1)
            self.go_table.aortext_des.text = _G.GetLangPackValue(90032810032, num)
        end
    end
end

function SecretRealmEmbattleNewView:OnDestroy()
    self.onExitCall = nil
    self.onBattleCall = nil
    self.onSaveCall = nil
end

---监听界面打开
---@param name string 界面名称
function SecretRealmEmbattleNewView:OnEmbattleOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
        self.embattleView = _G.UIManager:GetInstance():GetWindowCtrl(name)
        self.mCanvas = self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        _G.UIManager:GetInstance():ChangeCanvasOrder(name, self.mCanvas.sortingOrder)
        self.embattleView.transform:SetParentE(self.go_table.trans_view)
    end
    SecretRealmModel:GetInstance():OnEmbattleOpened(name)
end

function SecretRealmEmbattleNewView:OnBattleCall(sid, multiple, index)
    self:Close()
    if self.onBattleCall then
        self.onBattleCall(sid, multiple, index)
    end
end

function SecretRealmEmbattleNewView:OnExitCall()
    self:Close()
    if self.onExitCall then
        self.onExitCall()
    end
end

function SecretRealmEmbattleNewView:OnSaveCall(data, call)
    --self:Close()
    if self.onSaveCall then
        self.onSaveCall(data, call)
    end
end

---按钮点击事件在这里派发
function SecretRealmEmbattleNewView:OnClickBtn(go)
end

return SecretRealmEmbattleNewView
