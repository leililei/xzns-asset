function SecretRealmView:ShowTransitionGuidedBtn()
    local activity = ActivitySynManager:GetInstance():GetActivityWithTypeId(10081)
    if activity then
        local isOpen = activity:GetActivityTypeCls():CheckOpen()
        if isOpen == true then
            local index = activity:GetActivityTypeCls():GetOpenIndex()
            self.go_table.aorbtn_transitionGuided:SetActiveE(index == 2 and 1 or 0)
            if tonumber(index) == 2 then
                local tb = _G.GetAutoGoTable(self.go_table.aorbtn_transitionGuided)
                local icon, _ = activity:GetShowBtnInfo()
                tb.aorimage_icon.SpriteName = icon
            end
        end
    end
end

function SecretRealmView:SetData()
    self.dataList = {}
    for k, v in pairs(secret_realm_cfg) do
        if v.type == self.index then
            table.insert(self.dataList, v)
        end
    end
    table.sort(
        self.dataList,
        function(a, b)
            return a.id < b.id
        end
    )
    local maxSid = SecretRealmModel:GetInstance():GetMaxSid(self.index)
    if not maxSid or maxSid == 0 then
        self.curIndex = self.dataList[1].id
    else
        local cfg = secret_realm_cfg[maxSid]
        if cfg and cfg.next_section then
            if cfg.next_section == 0 then
                self.curIndex = cfg.id
            else
                self.curIndex = cfg.next_section
            end
        else
            self.curIndex = self.dataList[1].id
        end
    end
    local lastChallengeState = _G.PlayerPrefsManager.GetInt(tostring(_G.PlayerModel:GetInstance().role_uid) ..
        "LastChallengeState" .. self.index)
    if lastChallengeState ~= nil and lastChallengeState ~= 0 then
        self.chooseIndex = lastChallengeState
    else
        self.chooseIndex = SecretRealmModel:GetInstance():GetCurSid(self.index)
        if self.chooseIndex == 0 then
            self.chooseIndex = self.curIndex
        end
    end
    self.ticketKv = SecretRealmModel:GetInstance():GetTicketKv()
    self.multipleList = SecretRealmModel:GetInstance():GetMultipleList()
    local multiple = SecretRealmModel:GetInstance():GetCurMultiple(self.index)
    for i = 1, #self.multipleList do
        if self.multipleList[i] == multiple then
            self.multipleIndex = i
            break
        end
    end
    self.ticketLoclKv = {}
    for i, v in ipairs(discrete_cfg[116120]) do
        self.ticketLoclKv[v[2]] = v[1]
    end
    self.battleMax = _G.ConfigManager.system_cfg[213].count_limit
end

---心愿
function SecretRealmView:WishView()
    local isOpen = SecretRealmModel:GetInstance():IsWishOpen(self.index) and self.index == 1
    self.go_table.aorbtn_wish:SetActiveE(isOpen and 1 or 0)
    if isOpen then
        local wishType = SecretRealmModel:GetInstance():GetWish(self.index)
        self.go_table.aorimage_nil:SetActiveE(wishType == 0 and 1 or 0)
        self.go_table.aorimage_have:SetActiveE(wishType ~= 0 and 1 or 0)
        if wishType then
            self.go_table.aorimage_professional.SpriteName = _G.ProfessionalIcon[wishType]
        end
    end
end

function SecretRealmView:InitListView(isRefresh)
    self.jumpIdx = secret_realm_cfg[self.chooseIndex].numb - 1
    if self.init == nil then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
            #self.dataList,
            _G.handler(self, self.RefreshItem),
            self.jumpIdx
        )
        self.init = true
    else
        if isRefresh then
            self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
        else
            self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.dataList, self.jumpIdx)
        end
    end
    local cfg = secret_realm_cfg[self.chooseIndex]
    self.go_table.aortext_des.text = GetLangPackValue(NameList[cfg.name], cfg.numb) ..
        ":" .. GetLangPackValue(cfg.drop_forecast)
end

function SecretRealmView:RefreshItem(index, obj)
    index = index + 1
    local tb = GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.OnClickItem, tb))
    tb.index = index
    local data = self.dataList[index]
    tb.data = data
    tb.aortext_floor.text = GetLangPackValue(NameList[data.name], data.numb)
    local isLock = data.id > self.curIndex
    tb.obj_lock:SetActiveE(isLock and 1 or 0)
    tb.aorrawimage_bg:SetGray(isLock)
    tb.aorbtn_tips:SetActiveE(#data.drop_show > 0 and 1 or 0)
    tb.obj_isOn:SetActiveE(self.chooseIndex == data.id and 1 or 0)
    if #data.drop_show > 0 then
        local cfg = decoration_cfg[data.drop_show[2][1]]
        tb.aorimage_grade.SpriteName = _G.RuneRankEnum[cfg.grade]
    end
    tb.obj_des:SetActiveE(0)
    tb.obj_des2:SetActiveE(0)
    if isLock == false then
        local num = data.resistance_limit
        tb.resistance_limit = num
        if num > 0 then
            tb.obj_des2:SetActiveE(self.curAbyssalMawOne > num and 1 or 0)
            tb.obj_des:SetActiveE(self.curAbyssalMawOne < num and 1 or 0)
        end
    end
end

function SecretRealmView:OnClickItem(go, _, tb)
    local name = go:GetName()
    if name == "@_aorbtn_bg" then
        if tb.data.id > self.curIndex then
            return
        end
        self.chooseIndex = tb.data.id
        self:InitListView(true)
    elseif name == "@_aorbtn_tips" then
        self:SetTipsView(true, tb)
    elseif name == "@_aorbtn_des" or name == "@_aorbtn_des2" then
        self:SetDesView(true, tb)
    end
end

