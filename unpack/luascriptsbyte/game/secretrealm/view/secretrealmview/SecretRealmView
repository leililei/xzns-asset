---倍率
function SecretRealmView:SetMultipleView()
    self.battleNum = SecretRealmModel:GetInstance():GetTicket(self.index)
    local num = self.multipleList[self.multipleIndex]
    self.go_table.aortext_times.text = _G.GetLangPackValue(90032800024, num)
    local str = ""
    if num > 1 then
        str = "(-" .. self.ticketKv[num] .. ")"
    end
    self.go_table.aortext_num.text = _G.GetLangPackValue(90021800179, self.battleNum .. str, self.battleMax)

    self.go_table.aorbtn_sub:SetGray(self.multipleIndex == 1)
    self.go_table.aorbtn_add:SetGray(self.multipleIndex == #self.multipleList)
end

---界面的销毁函数
function SecretRealmView:OnDestroy()
    if self.tradingTimer then
        self.tradingTimer:Stop()
        self.tradingTimer = nil
    end
    self:RemoveAllListener()
end

function SecretRealmView:ShowAdTxt()
    require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.TimesofSecretRealm.id)
    if self:IsNil() then
        return
    end

    local model = require("AdvertisementModel"):GetInstance()
    if not model:CheckADShow(_G.AdvertisementType.SecretRealm) then
        self.go_table.aorbtn_ad:SetActiveE(0)
        return
    end

    self.go_table.aorbtn_ad:SetActiveE(1)
    local max = model:GetAdMax(_G.AdvertisementType.SecretRealm)
    if max <= 1 then
        self.go_table.aortext_ad.text = _G.GetLangPackValue(90000011733)
    else
        local watchedNum = model:GetWatchedAdNum(_G.AdvertisementType.SecretRealm)
        local curNum = max - watchedNum
        if max - watchedNum <= 0 then
            curNum = _G.string.format("<color=#AA3932>%d</color>", curNum)
        end
        self.go_table.aortext_ad.text = _G.GetLangPackValue(90000011734, curNum, max)
    end
end

---按钮点击事件在这里派发
function SecretRealmView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()

    elseif go == self.go_table.aorbtn_wish then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmWishView.Name, self.index)
    elseif go == self.go_table.aorbtn_shop then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmExchangeView.Name)
    elseif go == self.go_table.aorbtn_sub then
        if self.multipleIndex == 1 then
            return
        end
        self.multipleIndex = self.multipleIndex - 1
        self:SetMultipleView()
    elseif go == self.go_table.aorbtn_add then
        if self.multipleIndex == #self.multipleList then
            return
        end
        local sid = self.ticketLoclKv[self.multipleList[self.multipleIndex + 1]]
        if sid and self.curIndex <= sid then
            local cfg = _G.ConfigManager.secret_realm_cfg[sid]
            _G.PopWindowManager:GetInstance():ShowAllTips(
                1020001,
                GetLangPackValue(
                    _G.ConfigManager.tips_system_cfg[1020001].content,
                    GetLangPackValue(NameList[cfg.name], cfg.numb)
                )
            )
            return
        end
        self.multipleIndex = self.multipleIndex + 1
        self:SetMultipleView()
    elseif go == self.go_table.aorbtn_changgle then
        if _G.MainManager:GetInstance():IsFighting(true) then
            return
        end
        _G.CS.BattleManager.Inst:Destroy()
        _G.BattleManager:GetInstance():SetRendererActiveState(true) --默认显示表现层

        local model = SecretRealmModel:GetInstance()
        if model:HasValidTeamData() then
            model:Battle(self.chooseIndex, self.multipleList[self.multipleIndex], self.index)
        else
            model:GetTeamData(
                function(teamData, isValidTeam)
                    if teamData and isValidTeam then
                        model:Battle(self.chooseIndex, self.multipleList[self.multipleIndex], self.index)
                    else
                        model:OpenEmbattle(self.chooseIndex, self.multipleList[self.multipleIndex], self.index)
                    end
                end
            )
        end
    elseif go == self.go_table.aorbtn_embattle then
        --布阵
        SecretRealmModel:GetInstance():OpenEmbattle(nil, nil, self.index)
    elseif go == self.go_table.aorbtn_ad then
        ---广告
        require "MonthlyModel":GetInstance():CheckShowADTips(function()
            require("AdvertisementModel"):GetInstance():PlaySecretRealmAd(_G.handler(self, self.ShowAdTxt))
        end)
    elseif go == self.go_table.aorbtn_info then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 162)
    elseif go == self.go_table.aorbtn_rank then
        --先拉取排行榜数据, 然后再打开面板
        local model = require("RecordRankModel"):GetInstance()
        model:GetListInfo(
            10,
            function()
                model:ClearSelfData() --清除自己的缓存数据(之后从服务器重新拉取)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RecordRankSecretRealmListView.Name, 10)
            end
        )
    elseif go == self.go_table.aorbtn_transitionGuided then
        local activity = ActivitySynManager:GetInstance():GetActivityWithTypeId(10081)
        _G.GlobalInterface.JumpActivityByGM(10081, activity:GetJumpType())
    elseif go == self.go_table.aorbtn_limitfund then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneLimitFundView.Name)
    elseif go == self.go_table.aorbtn_trading then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TradingCardsToggleView.Name)
    end
end
function SecretRealmView:SetRuneLimitFundBtnShowAndHind()
    self.go_table.aorbtn_limitfund:SetActiveE(require("RuneLimitFundModel"):GetInstance():IsShow() and 1 or 0)
end

