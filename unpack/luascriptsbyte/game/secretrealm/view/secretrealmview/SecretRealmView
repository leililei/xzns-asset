---创建事件触发条目
---@param eventType UnityEngine.EventSystems.EventTriggerType @事件类型
---@param callback fun(data:UnityEngine.EventSystems.PointerEventData):void @回调函数
local function createTriggerEntry(eventType, callback)
    local entry = _G.CS.UnityEngine.EventSystems.EventTrigger.Entry()
    entry.eventID = eventType
    entry.callback:AddListener(callback)
    return entry
end

---求两点的距离
---@param pos1 UnityEngine.Vector2 @点1
---@param pos2 UnityEngine.Vector2 @点2
local function magnitude(pos1, pos2)
    return math.sqrt((pos1.x - pos2.x) ^ 2 + (pos1.y - pos2.y) ^ 2)
end

---构造函数
---@protected
function SecretRealmView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self:AddListener(_G.eSecretRealm.Wish, self.WishView)
    self:AddListener(_G.eSecretRealm.AddTicket, self.SetMultipleView)
    self:AddListener(_G.eSecretRealm.Refresh, self.SetMultipleView)
    self:AddListener(_G.eAdvertisement.Refresh, self.ShowAdTxt)
    self:AddListener(_G.eSecretRealm.Embattle, self.UpdateStages)
end

---界面的入口函数
function SecretRealmView:OnCreate(index)
    self.cfg = _G.ConfigManager.secret_realm_basic_cfg
    if _G.AppSetting.IsXzns then
        _G.GameUtil.SetUiHeXieMask(self.go_table)
    end
    _G.UIUtils.IsNeedChangeUI(_G.IsNeedChangeUI.SecretRealmView, self.go_table)
    local res = { }
    for i, v in ipairs(self.cfg) do
        _G.table.insert(res, v.recover_item[1])
    end
    self:AddComponent(self.go_table.obj_resource, require("ResourceCompont").New(self.go_table.obj_resource, res))
    local obj = self.go_table.obj_resource:GetChildE(0)
    self.obj_resource = obj:GetChildE(0)
    --关卡节点
    self.stageItems = {}
    self.stagePositions = {}
    for i = 1, 3 do
        local item = _G.GetAutoGoTable(self.go_table["obj_stage" .. i])
        _G.AddViewBtnClick(item.gameObject, _G.handlerbind(self, self.OnClickStageBtn, item))
        --节点初始缩放大小丶位置
        local posX, posY, posZ = item.gameObject:GetLocalPosition()
        local scaleX, scaleY, scaleZ = item.gameObject:GetLocalScale()
        --local scaleX, scaleY, scaleZ = item.gameObject:GetWorldScale()
        table.insert(self.stageItems, item)
        table.insert(self.stagePositions, {
            pos = { posX, posY, posZ },
            scale = { scaleX, scaleY, scaleZ },
        })
    end
    if index ~= nil then
        self.index = index
        if self.index == 0 then
            self.index = 1
        end
    else
        self.index = 1
    end
    self:InitTrading()
    self:InitDragStages()
    self:UpdateStages()
    self:ShowAdTxt()
    self:SetRuneLimitFundBtnShowAndHind()
end

function SecretRealmView:InitView()
    self:SetData()
    self:WishView()
    self:InitListView()
    self:SetMultipleView()
    self:ShowTransitionGuidedBtn()
    self.go_table.obj_ad:SetActiveE(self.index == 1 and 1 or 0)
    --self.go_table.aorbtn_shop:SetActiveE(self.index == 1 and 1 or 0)
    self.go_table.aorbtn_shop:SetActiveE(0)--XZNS-6868 临时屏蔽入口
    self.go_table.aorbtn_rank:SetActiveE(self.index == 1 and 1 or 0)
    SecretRealmModel:GetInstance():SaveOpenIndex(self.index)
    _G.Events:GetInstance():Broadcast(_G.DungeonChallengeBattleViewShow.Open)
    local num = self.obj_resource:GetChildCountE()
    for i = 1, num do
        local index = num - i
        self.obj_resource:GetChildE(index):SetActiveE(i == self.index and 1 or 0)
    end
    local check = function(trans)
        if self:IsNil() then
            _G.DestroyObject(trans)
        end
    end
    _G.UIUtils.RemoveChildren(self.go_table.obj_effect)
    if self.cfg[self.index].bg ~= "" then
        _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[self.cfg[self.index].bg], self.go_table.obj_effect, check)
    end
    self.go_table.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SecretRealm.id, self.index)
end

function SecretRealmView:InitTrading()
    local model = require("TradingCardsModel"):GetInstance()
    if not model:CheckOpen() then
        self.go_table.obj_tradingCards:SetActiveE(0)
    else
        self.go_table.obj_tradingCards:SetActiveE(1)
        self.go_table.aortext_tradingName = model.activity.curActivityClass.cfg.info.name
        _, self.tradingCloseTime = model.activity.curActivityClass:GetActivityDeadLineByCondition(require("ActivitySynManager").State.Close)
        if self.tradingCloseTime <= 0 then
            self.go_table.obj_tradingCards:SetActiveE(0)
            return
        end
        self.go_table.aortext_time.text = _G.TimeUtil.GodSpecialGiftForStr(self.tradingCloseTime)
        self.tradingTimer = _G.TimerManager:GetInstance():GetTimer(1,self.UpdateTradingTime, self, false,false,true)
        self.tradingTimer:Start()
    end
end

function SecretRealmView:UpdateTradingTime(elapsed)
    self.tradingCloseTime = self.tradingCloseTime - elapsed
    if self.tradingCloseTime <= 0 then
        self.tradingTimer:Stop()
        self.tradingTimer = nil
        self.go_table.obj_tradingCards:SetActiveE(0)
        return
    end
    self.go_table.aortext_time.text = _G.TimeUtil.GodSpecialGiftForStr(self.tradingCloseTime)
end

---初始化拖动关卡
function SecretRealmView:InitDragStages()
    local clickPosition, clickTime

    local eventTriggers = self.go_table.obj_drag:GetComponentE(_G.typeof(_G.CS.UnityEngine.EventSystems.EventTrigger))
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerDown,
        function(data)
            if self.stageMove then
                return
            end
            clickPosition = data.position
            clickTime = _G.Time.time
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.Drag,
        function(data)
            if self.stageMove or not clickPosition then
                return
            end
            if math.abs(clickPosition.y - data.position.y) < 50 and magnitude(clickPosition, data.position) >= 100 then
                if clickPosition.x < data.position.x then
                    --向右滑动
                    if self.index > 1 then
                        self:PlayStageMove(1)
                        self.index = self.index - 1
                    end
                else
                    --向左滑动
                    if self.index < #self.cfg then
                        if #self.cfg[self.index + 1].condition == 0 or _G.GlobalConditionManager.CheckConditionByArray({ self.cfg[self.index + 1].condition }) then
                            self:PlayStageMove(-1)
                            self.index = self.index + 1
                        end
                    end
                end
                clickPosition = nil
            end
        end)
    )
    eventTriggers.triggers:Add(createTriggerEntry(
        _G.CS.UnityEngine.EventSystems.EventTriggerType.PointerUp,
        function(data)
            if self.stageMove or not clickPosition then
                return
            end
            if _G.Time.time - clickTime <= 0.2 and magnitude(clickPosition, data.position) <= 10 then
                --点击事件, 计算落点在哪个节点上
                -- if containsScreenPoint(self.stageItems[1].transform, clickPosition) then
                --     self:PlayStageMove(1)
                --     self.index = self.index - 1
                -- elseif containsScreenPoint(self.stageItems[3].transform, clickPosition) then
                --     self:PlayStageMove(-1)
                --     self.index = self.index + 1
                -- end
                --判断点击范围, 左边1/3则向右滑动, 右边1/3则向左滑动
                local w = self.transform:GetRectTransformWidthHeight()
                if clickPosition.x < w * 0.45 then
                    if self.index > 1 then
                        self:PlayStageMove(1)
                        self.index = self.index - 1
                    end
                elseif clickPosition.x > w * 0.55 then
                    if self.index < #self.cfg then
                        if #self.cfg[self.index + 1].condition == 0 or _G.GlobalConditionManager.CheckConditionByArray({ self.cfg[self.index + 1].condition }) then
                            self:PlayStageMove(-1)
                            self.index = self.index + 1
                        end
                    end
                end
            end
            clickPosition = nil
        end)
    )
end

---点击关卡信息
---@private
function SecretRealmView:OnClickStageBtn(_, _, item)
    if self.stageMove then
        return
    end
    if item == self.stageItems[1] then
        self:PlayStageMove(1)
        self.index = self.index - 1
    elseif item == self.stageItems[3] then
        self:PlayStageMove(-1)
        self.index = self.index + 1
    end
end

---播放关卡移动节点
---@field forward number @移动方向, 1:向右, -1:向左
---@private
function SecretRealmView:PlayStageMove(forward)
    self.stageMove = true

    local duration = 0.3
    local maxIndex = #self.stageItems
    for index, item in ipairs(self.stageItems) do
        local nextIndex = index + forward
        if nextIndex >= 1 and nextIndex <= maxIndex then
            local next = self.stagePositions[nextIndex]
            item.transform:DOLocalMove(next.pos[1], next.pos[2], next.pos[3], duration)
                :SetEase(_G.CS.DG.Tweening.Ease.Linear)
                :SetTarget(item.transform)
            item.transform:DOScale(next.scale[1], next.scale[2], next.scale[3], duration)
                :SetEase(_G.CS.DG.Tweening.Ease.Linear)
                :SetTarget(item.transform)
        end
    end

    local item
    local selfInfo, nextInfo
    --最左边的节点的动画
    if forward < 0 then
        item = self.stageItems[1]
        selfInfo = self.stagePositions[1]
        nextInfo = self.stagePositions[#self.stagePositions]
    end
    --最右边的节点的动画
    if forward > 0 then
        item = self.stageItems[#self.stageItems]
        selfInfo = self.stagePositions[#self.stagePositions]
        nextInfo = self.stagePositions[1]
    end
    if item then
        local horDistance = math.abs(self.stagePositions[2].pos[1] - self.stagePositions[1].pos[1])
        local beforeDuration = 0.5
        local afterDuration = 1 - beforeDuration
        local tweener = item.transform:DOLocalMove(
            selfInfo.pos[1] + horDistance * beforeDuration * forward,
            selfInfo.pos[2],
            selfInfo.pos[3],
            duration * beforeDuration,
            function()
                self:UpdateStages()
                --接上另一半的动画
                item.gameObject:SetLocalPosition(
                    nextInfo.pos[1] - horDistance * afterDuration * forward,
                    nextInfo.pos[2],
                    nextInfo.pos[3])
                item.transform:DOLocalMove(
                    nextInfo.pos[1],
                    nextInfo.pos[2],
                    nextInfo.pos[3],
                    duration * afterDuration,
                    _G.handler(self, self.UpdateStagePositions))
                    :SetEase(_G.CS.DG.Tweening.Ease.Linear)
                    :SetTarget(item.transform)
            end)
        tweener:SetEase(_G.CS.DG.Tweening.Ease.Linear)
        tweener:SetTarget(item.transform)
    end

    --交换节点状态
    if forward < 0 then
        self.stageItems = {
            self.stageItems[2],
            self.stageItems[3],
            self.stageItems[1],
        }
    elseif forward > 0 then
        self.stageItems = {
            self.stageItems[3],
            self.stageItems[1],
            self.stageItems[2],
        }
    end
end

---更新当前关卡节点信息
---@private
function SecretRealmView:UpdateStages()
    --更新关卡状态
    local offsetIndex = math.ceil(#self.stageItems / 2)
    for index, item in ipairs(self.stageItems) do
        local _index = self.index + index - offsetIndex
        local d = self.cfg[_index]
        item.gameObject:SetActiveE(0)
        if d and false then
            _G.UIUtils.RemoveChildren(item.obj_effect)
            item.aortext_title.text = _G.GetLangPackValue(d.name)
            if #d.condition == 0 or (#d.condition ~= 0 and _G.GlobalConditionManager.CheckConditionByArray({ d.condition })) then
                if d.id == 1 then
                    item.aorrawimage_role:LoadImage(image[4])
                else
                    item.aorrawimage_role:LoadImage(image[2])
                end
                item.aorrawimage_info:SetActiveE(1)
                item.aorrawimage_info:LoadImage(d.icon)
                item.obj_redpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.SecretRealm.id, _index)
                item.obj_name:SetActiveE(1)
                local check = function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                    end
                end
                if d.door ~= "" then
                    _G.UIUtils.LoadEffectByCfg(_G.ConfigManager.ui_effect_cfg[d.door], item.obj_effect, check)
                end
            else
                if d.id == 1 then
                    item.aorrawimage_role:LoadImage(image[3])
                else
                    item.aorrawimage_role:LoadImage(image[1])
                end
                item.aorrawimage_info:SetActiveE(0)
                item.obj_redpoint:UpdateRedPointItemIDAndParam(0)
                item.obj_name:SetActiveE(0)
            end
        end
    end
    self.curAbyssalMaw, self.curAbyssalMawOne = SecretRealmModel:GetInstance():GetAbyssalMaw(self.index - 1)
    self:InitView()
end

---更新当前关卡节点位置丶缩放大小
---@private
function SecretRealmView:UpdateStagePositions()
    self.stageMove = false
    for index, item in ipairs(self.stageItems) do
        item.transform:DOKill()
        item.gameObject:SetLocalPosition(table.unpack(self.stagePositions[index].pos))
        item.gameObject:SetLocalScale(table.unpack(self.stagePositions[index].scale))
        --item.gameObject:SetWorldScale(table.unpack(self.stagePositions[index].scale))
    end
end

