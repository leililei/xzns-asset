---@class SecretRealmBagView : UIBaseView	中文描述
---@field public go_table SecretRealmBagView_GoTable GoTable
local SecretRealmBagView = _G.BaseClass("SecretRealmBagView", _G.UIBaseView)

---最小格子数
local minCeilNum = 35

function SecretRealmBagView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.go_table.scrollloopvectical_item:InitItemData(0, _G.handler(self, self.RefreshItem))
end

---界面的入口函数
function SecretRealmBagView:OnCreate()
    local runeDatas = require("SecretRealmModel"):GetInstance():GetRuneAwardData()
    self.go_table.obj_null:SetActiveE(0)
    self:RefreshView(runeDatas)
end

function SecretRealmBagView:RefreshView(runeDatas)
    self.runeList = {}
    local count = 0
    if runeDatas then
        local cfg = _G.ConfigManager.decoration_cfg
        for _, v in pairs(runeDatas) do
            _G.table.insert(self.runeList, cfg[v])
        end

        count = #self.runeList
    end
    self.go_table.scrollloopvectical_item:UpdateCount(_G.Mathf.Max(count, minCeilNum))
end

function SecretRealmBagView:RefreshItem(index, obj)
    local cfg = self.runeList[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    tb.aorimage_bg:SetActiveE(cfg and 0 or 1)
    tb.obj_item:ClearChildren()
    if cfg then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            { cfg.id },
            tb.obj_item,
            function(tran)
                if self:IsNil() then
                    return
                end

                tran:ShowSlotLevel(false)
            end,
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RuneTipView.Name, nil, cfg, true)
            end
        )
    end
end

---界面的销毁函数
function SecretRealmBagView:OnDestroy()
end

---按钮点击事件在这里派发
function SecretRealmBagView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return SecretRealmBagView
