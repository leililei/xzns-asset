local PlayerTreeID = _G.PlayerTreeID
local SecretRealmModel = require("SecretRealmModel")

---@class SecretRealmWishView : UIBaseView    中文描述
---@field public go_table SecretRealmWishView_GoTable GoTable
local SecretRealmWishView = _G.BaseClass("SecretRealmWishView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmWishView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---神器职业页签
    self.professionBtn = {
        [PlayerTreeID.none] = self.go_table.aorbtn_all,
        [PlayerTreeID.tank] = self.go_table.aorbtn_tank,
        [PlayerTreeID.warrior] = self.go_table.aorbtn_warrior,
        [PlayerTreeID.master] = self.go_table.aorbtn_master,
        [PlayerTreeID.support] = self.go_table.aorbtn_support,
        [PlayerTreeID.ranger] = self.go_table.aorbtn_ranger
    }
end

---界面的入口函数
function SecretRealmWishView:OnCreate(index)
    self.index = index
    self.wish = SecretRealmModel:GetInstance():GetWish(self.index)
    self.go_table.aorimage_select:SetActiveE(self.wish ~= 0 and 1 or 0)
    self.go_table.aorbtn_reset:SetActiveE(self.wish ~= 0 and 1 or 0)
    self.go_table.aorbtn_sure:SetGray(self.wish == 0)
    if self.wish ~= 0 then
        self:ChangeProfession(self.wish, true)
    end
    SecretRealmModel:GetInstance():ChangeWishTag()
end

---更改当前选择职业
---@param profession number 职业
function SecretRealmWishView:ChangeProfession(profession, force)
    if profession ~= self.wish or force then
        self.go_table.aorimage_select:SetParentE(self.professionBtn[profession])
        self.go_table.aorbtn_sure:SetGray(false)
        self.go_table.aorimage_select:SetActiveE(1)
        self.wish = profession
    end
end

---界面的销毁函数
function SecretRealmWishView:OnDestroy()
end

---按钮点击事件在这里派发
function SecretRealmWishView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeX then
        ---遮罩或者关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_warrior then
        self:ChangeProfession(PlayerTreeID.warrior)
    elseif go == self.go_table.aorbtn_ranger then
        self:ChangeProfession(PlayerTreeID.ranger)
    elseif go == self.go_table.aorbtn_master then
        self:ChangeProfession(PlayerTreeID.master)
    elseif go == self.go_table.aorbtn_tank then
        self:ChangeProfession(PlayerTreeID.tank)
    elseif go == self.go_table.aorbtn_support then
        self:ChangeProfession(PlayerTreeID.support)
    elseif go == self.go_table.aorbtn_sure then
        SecretRealmModel:GetInstance():ChooseWish(self.wish, function()
            self:Close()
        end, self.index)
    elseif go == self.go_table.aorbtn_reset then
        SecretRealmModel:GetInstance():ChooseWish(0, function()
            self:Close()
        end, self.index)
    end
end

return SecretRealmWishView