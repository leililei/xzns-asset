---@class SecretRealmBossRoomTipView : UIBaseView    中文描述
---@field public go_table SecretRealmBossRoomTipView_GoTable GoTable
local SecretRealmBossRoomTipView = _G.BaseClass("SecretRealmBossRoomTipView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmBossRoomTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SecretRealmBossRoomTipView:OnCreate(call)
    self:LoadBackgroundEffect()

    _G.DelayDo(2, function()
        if self:IsNil() then
            return
        end
        if call then
            call()
        end
        self:Close()
    end)
end

---加载背景特效
function SecretRealmBossRoomTipView:LoadBackgroundEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_qiangdilaixi,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
        end
    )
end
---界面的销毁函数
function SecretRealmBossRoomTipView:OnDestroy()
end

---按钮点击事件在这里派发
function SecretRealmBossRoomTipView:OnClickBtn(go)
