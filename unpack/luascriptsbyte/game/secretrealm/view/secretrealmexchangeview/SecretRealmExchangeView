local PlayerTreeID = _G.PlayerTreeID
local base = require("LimitedExchangeView")
---@class SecretRealmExchangeView : UIBaseView    中文描述
---@field public go_table BlackMarketExchangeView_GoTable GoTable
local SecretRealmExchangeView = _G.BaseClass("SecretRealmExchangeView", base)

---构造函数
---@protected
function SecretRealmExchangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    ---神器职业页签
    self.professionBtn = {
        [PlayerTreeID.none] = self.go_table.aorbtn_all,
        [PlayerTreeID.tank] = self.go_table.aorbtn_tank,
        [PlayerTreeID.warrior] = self.go_table.aorbtn_warrior,
        [PlayerTreeID.master] = self.go_table.aorbtn_master,
        [PlayerTreeID.support] = self.go_table.aorbtn_support,
        [PlayerTreeID.ranger] = self.go_table.aorbtn_ranger
    }
end

---界面的入口函数
function SecretRealmExchangeView:OnCreate()
    self:InitView()
end

---更改当前选择职业
---@param profession number 职业
function SecretRealmExchangeView:ChangeProfession(profession, force)
    if profession ~= self.curIndex or force then
        self.go_table.aorimage_select:SetParentE(self.professionBtn[profession])
        --self.go_table.aorbtn_sure:SetGray(false)
        self.go_table.aorimage_select:SetActiveE(1)
        self.curIndex = profession
    end
    self:RefreshView()
end

function SecretRealmExchangeView:InitView()
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
    local res = _G.ConfigManager.ui_cfg.SecretRealmExchangeView.resources
    ---@type ResourceCompont
    self.resComponent = self:AddComponent(self.go_table.obj_res, require("ResourceCompont").New(self.go_table.obj_res, res))
    self.cfg = _G.ConfigManager.exchange_cfg
    local shopCfg = _G.ConfigManager.decoration_shop_cfg
    self.shopList = {}
    for i, v in pairs(shopCfg) do
        self.shopList[v.tab] = v
    end
    self.curIndex = 2
    self:ChangeProfession(self.curIndex, true)
end

function SecretRealmExchangeView:RefreshView()
    self.item = self.shopList[self.curIndex].goods
    local count = #self.item
    if not self.count then
        self.go_table.scrollloopvectical_ItemList:InitItemData(
            count,
            _G.handler(self, self.RefreshItem)
        )
        self.count = count
    else
        if self.count ~= count then
            self.go_table.scrollloopvectical_ItemList:UpdateCount(count)
            self.count = count
        else
            self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
        end
    end
end

function SecretRealmExchangeView:RefreshItem(index, obj)
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1))
    if self.item[x] then
        tb.data = self.cfg[self.item[x]]
        tb.obj_itemRoot:RemoveAllChildren()
        for i, v in ipairs(tb.data.get_item) do
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { v[1], v[2], v[3] },
                tb.obj_itemRoot,
                function(tran)
                    if self:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
            )
            tb.aortext_itemname.text = _G.StorageManager:GetInstance():GetItemName(v[1])
            local color, isColor = _G.GameUtil.GetColorByQualityNewH5(_G.StorageType.Decoration, _G.StorageManager:GetInstance():GetItemQuality(v[1]))
            tb.aortext_itemname.color = color
        end
        tb.obj_Limit:SetActiveE(tb.data.count_limit ~= 0 and 1 or 0)
        if tb.data.count_limit ~= 0 then
            local num = _G.StorageManager:GetInstance():GetExChangeCount(tb.data.id) or 0
            tb.aortext_num.text = _G.GetLangPackValue(90021600055) .. tb.data.count_limit - num
            tb.obj_SellOut:SetActiveE(num >= tb.data.count_limit and 1 or 0)
        else
            tb.obj_SellOut:SetActiveE(0)
        end
        local consume_sid = tb.data.need_item[1][1]
        local consume_num = tb.data.need_item[1][2]
        tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
        tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)
        --tb.aorimage_discount:SetActiveE(0)
    end
end

function SecretRealmExchangeView:ClickItemBtn(go, _, index)
    local name = go:GetName()
    if name == "@_aorbtn_Btn" then
        local data = self.cfg[self.item[index]]
        local needCount = data.need_item[1][2]
        local itemsid = data.need_item[1][1]
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.ShopItemTipsNoMaxBtnView.Name,
            _G.TipType.Prop,
            { price = needCount, limit = data.count_limit ~= 0 or 9999, BuyTime = _G.StorageManager:GetInstance():GetExChangeCount(data.id) or 0, currencyIcon = _G.StorageManager:GetInstance():GetItemIcon(data.need_item[1][1]) },
            _G.StorageManager:GetInstance():GetItemDataClass(data.get_item[1][1], 1),
            function(count, call)
                if not _G.StorageManager:GetInstance():CheckItem(itemsid, needCount * count) then
                    _G.PopWindowManager:GetInstance():ShowAllTips(230303)
                    _G.UIManager:GetInstance():OpenWindow(
                        _G.ConfigManager.ui_cfg.GetItemWayView.Name,
                        itemsid
                    )
                    return
                end
                _G.StorageManager:GetInstance():PropBuy(
                    data.id,
                    count,
                    1,
                    function(msg)
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg)
                        if call then
                            call(true)
                        end
                    end
                )
            end
        )
    end
end

---按钮点击事件在这里派发
function SecretRealmExchangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        ---遮罩或者关闭按钮
        self:Close()
    elseif go == self.go_table.aorbtn_warrior then
        self:ChangeProfession(PlayerTreeID.warrior)
    elseif go == self.go_table.aorbtn_ranger then
        self:ChangeProfession(PlayerTreeID.ranger)
    elseif go == self.go_table.aorbtn_master then
        self:ChangeProfession(PlayerTreeID.master)
    elseif go == self.go_table.aorbtn_tank then
        self:ChangeProfession(PlayerTreeID.tank)
    elseif go == self.go_table.aorbtn_support then
        self:ChangeProfession(PlayerTreeID.support)
    end
end

function SecretRealmExchangeView:Dispose()

end

return SecretRealmExchangeView