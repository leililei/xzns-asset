local MAX_VALUE = 3000


---@class SecretRealmBattleTransforView : UIBaseView    大秘境-战斗转场
---@field go_table SecretRealmBattleTransforView_GoTable GoTable
---@field node UnityEngine.RectTransform
---@field action "zoom_out"|"zoom_in"   @zoom_out:缩小转场, zoom_in:放大转场
---@field callback function
local SecretRealmBattleTransforView = _G.BaseClass("SecretRealmBattleTransforView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmBattleTransforView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.node = self.go_table.obj_node:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
end

---界面的入口函数
function SecretRealmBattleTransforView:OnCreate(action, callback)
    if action then
        self:SetAction(action, callback)
    end
end

function SecretRealmBattleTransforView:SetAction(action, callback)
    self.action = action
    self.callback = callback
    self:InitSizeDelta()
    self:PlayTween()
end

---初始化界面状态
---@private
function SecretRealmBattleTransforView:InitSizeDelta()
    local val = self.action == "zoom_out" and MAX_VALUE or 0
    self.node:DOKill()
    self.node:SetRectTransformSize(val, val)
end

---播放tween动画
---@private
function SecretRealmBattleTransforView:PlayTween()
    local val = self.action == "zoom_out" and 0 or MAX_VALUE
    local duration = 0.5
    if _G.Time.timeScale > 1 then
        duration = duration * _G.Time.timeScale
    end

    self.node:DOKill()
    self.node
        :DOSizeDelta(_G.Vector2(val, val), duration)
        :SetEase(_G.CS.DG.Tweening.Ease.Linear)
        :OnComplete(_G.handler(self, self.OnTweenComplete))
end

---播放tween动画
---@private
function SecretRealmBattleTransforView:OnTweenComplete()
    if not self.callback then
        return
    end
    self.callback()
    self.callback = nil
end

---按钮点击事件在这里派发
function SecretRealmBattleTransforView:OnClickBtn(go)
end

return SecretRealmBattleTransforView
