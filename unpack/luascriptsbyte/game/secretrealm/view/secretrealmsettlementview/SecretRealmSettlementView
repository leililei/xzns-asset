local OrderBg = {
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_lan",
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_zi",
    "ImagesH5/hDungones/ui_qjhs_ywxz_db_cheng"
}

---@class SecretRealmSettlementView : UIBaseView    大秘境-小房间打完选buff
---@field go_table SecretRealmSettlementView_GoTable GoTable
---@field closeCallback fucntion    关闭回调函数
---@field buffs number[]    buff列表
---@field buffItems SecretRealmSettlementView._obj_Item_1_GoTable[]    buff列表
---@field chooseIndex number    选择的buff索引
---@field autoTime number       自动执行倒计时
---@field autoTimer Timer       自动执行计时器
local SecretRealmSettlementView = _G.BaseClass("SecretRealmSettlementView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretRealmSettlementView:OnCreate(callback, buffs, auto)
    self.closeCallback = callback

    self.chooseIndex = 1
    self.buffs = buffs or {}
    self:InitBuffs()
    self:UpdateBuffItems()
    self:InitOpenEffect()


    self.go_table.aortext_tip:SetActiveE(auto and 1 or 0)
    if auto then
        self.autoTime = 3
        self:UpdateAutoTip()
        self.autoTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateAutoTip, self, false, false)
        self.autoTimer:Start()
    end
end

function SecretRealmSettlementView:InitOpenEffect()
    local check = function(trans)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(trans)
        end
    end
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_open, self.go_table.obj_effectOpen, check)
    _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_loop, self.go_table.obj_effectLoop, check)
    self.go_table.obj_effectOpen:SetActiveE(0)
    self.go_table.obj_effectLoop:SetActiveE(0)

    _G.DelayDo(
        0.133,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.obj_effectOpen:SetActiveE(1)
        end
    )

    _G.DelayDo(
        0.266,
        function()
            if self:IsNil() then
                return
            end
            self.go_table.obj_effectLoop:SetActiveE(1)
        end
    )
end

function SecretRealmSettlementView:OnDestroy()
    self:StopAutoTimer()
end

function SecretRealmSettlementView:StopAutoTimer()
    if self.autoTimer then
        self.autoTimer:Stop()
        self.autoTimer = nil
    end
end

---初始化页面buff列表
function SecretRealmSettlementView:InitBuffs()
    self.buffItems = {}
    local ui_effect_cfg = _G.ConfigManager.ui_effect_cfg
    local check = function(trans)
        if _G.IsNil(self.go_table) then
            _G.DestroyObject(trans)
        end
    end
    for i = 1, 3 do
        local go = self.go_table["obj_Item_" .. i]
        go:SetActiveE(self.buffs[i] and 1 or 0)
        if self.buffs[i] then
            ---@type SecretRealmSettlementView._obj_Item_1_GoTable
            local goTable = _G.GetAutoGoTable(go, _G.handlerbind(self, self.ClickBuffItem, i))
            self.buffItems[i] = goTable
            --节点状态展示
            local cfg = _G.ConfigManager.mementos_cfg[self.buffs[i]]
            goTable.aorrawimage_icon:LoadImage(cfg.icon, function(image)
                --image:SetNativeSize()
            end)
            goTable.aorrawimage_bg:LoadImage(OrderBg[cfg.quality] or OrderBg[#OrderBg], function(image)
                --image:SetNativeSize()
            end)
            goTable.aortext_name.text = _G.GetLangPackValue(cfg.name)
            goTable.aortext_desc.text = _G.GetLangPackValue(cfg.desc)
            _G.UIUtils.LoadEffectByCfg(ui_effect_cfg.ef_SecretRealmSettlementView_xuanze, goTable.obj_effectChoose, check)
        end
    end
end

---更新buff选择状态
function SecretRealmSettlementView:UpdateBuffItems()
    if not self.buffItems then
        return
    end
    for i, go in pairs(self.buffItems) do
        go.obj_uieffect:SetActiveE(i == self.chooseIndex and 1 or 0)
    end
end

---更新tip提示
function SecretRealmSettlementView:UpdateAutoTip(elapsedTime)
    if not self.autoTime then
        return
    end
    self.autoTime = self.autoTime - (elapsedTime or 0)
    self.go_table.aortext_tip.text = _G.GetLangPackValue(90000010031,
        math.ceil(self.autoTime < 0 and 0 or self.autoTime)
    )

    if self.autoTime <= 0 then
        self.autoTime = 0
        self:ChooseBuff(self.chooseIndex)
        self:StopAutoTimer()
    end
end

---选择buff
function SecretRealmSettlementView:ChooseBuff(index)
    for i, go in pairs(self.buffItems) do
        if i ~= self.chooseIndex then
            local CanvasGroup = go.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.CanvasGroup))
            CanvasGroup.alpha = 1
            CanvasGroup:DOFade(0, 0.5):SetEase(_G.CS.DG.Tweening.Ease.Linear)
        else
            _G.DelayDo(
                0.01,
                function()
                    if self:IsNil() then
                        return
                    end
                    go.obj_effectChoose:SetActiveE(1)

                    _G.DelayDo(
                        0.5,
                        function()
                            if self:IsNil() then
                                return
                            end
                            require("SecretRealmModel"):GetInstance():ChooseBuff(
                                self.buffs[index],
                                _G.handler(self, self.Close)
                            )
                        end
                    )
                end
            )
        end
    end
end

---点击buff按钮
function SecretRealmSettlementView:ClickBuffItem(go, isOn, index)
    self.chooseIndex = index
    self:UpdateBuffItems()

    --停止自动操作
    self.autoTime = nil
    self:StopAutoTimer()
    self.go_table.aortext_tip:SetActiveE(0)
end

---按钮点击事件在这里派发
function SecretRealmSettlementView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
    elseif go == self.go_table.aorbtn_Sure then
        self:ChooseBuff(self.chooseIndex)
    end
end

function SecretRealmSettlementView:Close()
    _G.UIBaseView.Close(self)
    if self.closeCallback then
        self.closeCallback()
    end
end

return SecretRealmSettlementView
