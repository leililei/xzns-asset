---@class SecretRealmBuffTipView : UIBaseView    大秘境-Boss buff描述
---@field go_table SecretRealmBuffTipView_GoTable GoTable
local SecretRealmBuffTipView = _G.BaseClass("SecretRealmBuffTipView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmBuffTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretRealmBuffTipView:OnCreate(name, desc)
    self.go_table.aortext_name:SetActiveE(name and #name > 0 and 1 or 0)
    self.go_table.aortext_desc:SetActiveE(desc and #desc > 0 and 1 or 0)
    if name then
        self.go_table.aortext_name.text = name
    end
    if desc then
        self.go_table.aortext_desc.text = desc
    end
end

---按钮点击事件在这里派发
function SecretRealmBuffTipView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return SecretRealmBuffTipView
