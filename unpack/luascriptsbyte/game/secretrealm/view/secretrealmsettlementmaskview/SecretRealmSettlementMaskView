local GradeEffect = {
    [3] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_lan,
    [4] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_zi,
    [5] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_cheng,
    [6] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_hong,
    [7] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_cai,
    [8] = _G.ConfigManager.ui_effect_cfg.ef_zhandouguangqiu_cai,
}

---@class SecretRealmSettlementMaskView : UIBaseView    大秘境-结算宝箱动画蒙版
---@field go_table SecretRealmSettlementMaskView_GoTable GoTable
---@field callback fun():void
---@field awardSids number[]    奖励信息
---@field boxFinish boolean    宝箱动画是否完成
---@field effectTimer Timer    宝箱特效计时器
---@field effectObjs UnityEngine.GameObejct[]    奖励节点
local SecretRealmSettlementMaskView = _G.BaseClass("SecretRealmSettlementMaskView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmSettlementMaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

function SecretRealmSettlementMaskView:OnCreate(awardSids, callback)
    self.awardSids = awardSids
    self.callback = callback
    self:PlayBoxEffect()
end

function SecretRealmSettlementMaskView:OnDestroy()
    self.effectObjs = nil
    if self.effectTimer then
        self.effectTimer:Stop()
        self.effectTimer = nil
    end
end

---播放宝箱特效
---@param awardSids number[]
function SecretRealmSettlementMaskView:PlayBoxEffect()
    --播放宝箱动画, 播放完成后再结算
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_baoxiangbaokai,
        self.go_table.obj_box,
        function(tran)
            --镜头抖动动画
            _G.DelayDo(2.8, function()
                local cm = _G.CS.BattleManager.Inst.CameraMovement
                if not _G.IsNil(cm) then
                    cm:Shake(0.5, 0, 1, 0, 10, 0)
                end
            end)
            --创建光球
            _G.DelayDo(3, _G.handler(self, self.PlayNextAwardEffect))
        end,
        function()
            self.boxFinish = true
            if not self.awardSids or #self.awardSids <= 0 then
                self:Close()
            end
        end
    )
end

---显示下一个特效
function SecretRealmSettlementMaskView:PlayNextAwardEffect()
    if self:IsNil() then
        return
    end

    if not self.awardSids or #self.awardSids <= 0 then
        --奖励已全部显示完成
        if self.boxFinish then
            self:Close()
        end
        return
    end

    local sid = table.remove(self.awardSids, 1)
    local grade = _G.StorageManager:GetInstance():GetItemGrade(sid, nil)
    local effectCfg = GradeEffect[grade]
    if not effectCfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("大秘境: 宝箱特效未配置, sid=" .. tostring(sid) .. ", grade=" .. tostring(grade))
        end
        self:PlayNextAwardEffect()
        return
    end

    --创建光球特效
    self.effectObjs = self.effectObjs or {}

    --- 一行6个
    local num = 6
    --- 超过 3行，把最上面一行删掉
    if self.go_table.obj_award:GetChildCountE() >= 18 then
        for i = 1, num do
            _G.DestroyObject(self.effectObjs[i])
        end

        for i = 1, num do
            table.remove(self.effectObjs, 1)
        end
    end

    _G.UIUtils.LoadEffectByCfg(effectCfg, self.go_table.obj_award, function(obj)
        if not self.effectObjs or self:IsNil() then
            _G.DestroyObject(obj)
            return
        end
        table.insert(self.effectObjs, obj)
        if grade >= 5 then
            obj:SetLocalScaleXYZ(1.2)
        end

        --延迟播放下一个物品
        local nextSid = self.awardSids and self.awardSids[1]
        if nextSid then
            local grade = _G.StorageManager:GetInstance():GetItemGrade(nextSid, nil)
            local duration = grade >= 5 and 0.5 or 0.2
            _G.DelayDo(duration, _G.handler(self, self.PlayNextAwardEffect))
        elseif self.boxFinish then
            ---延迟一定时间后, 关闭窗口
            _G.DelayDo(1, _G.handler(self, self.Close))
        end
    end)
end

function SecretRealmSettlementMaskView:Close()
    self.super.Close(self)
    if self.callback then
        self.callback()
        self.callback = nil
    end
end

---按钮点击事件在这里派发
function SecretRealmSettlementMaskView:OnClickBtn(go)

end

return SecretRealmSettlementMaskView
