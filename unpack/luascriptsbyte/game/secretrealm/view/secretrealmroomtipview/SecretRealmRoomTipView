---@class SecretRealmRoomTipView : UIBaseView    中文描述
---@field public go_table SecretRealmRoomTipView_GoTable GoTable
local SecretRealmRoomTipView = _G.BaseClass("SecretRealmRoomTipView", _G.UIBaseView)

---构造函数
---@protected
function SecretRealmRoomTipView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SecretRealmRoomTipView:OnCreate(call)
    self:LoadBackgroundEffect()

    _G.DelayDo(2, function()
        if self:IsNil() then
            return
        end
        if call then
            call()
        end
        self:Close()
    end)
end

---加载背景特效
function SecretRealmRoomTipView:LoadBackgroundEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_jixuqianjin,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
                return
            end
            trans:SetActiveE(1)
        end
    )
end

---界面的销毁函数
function SecretRealmRoomTipView:OnDestroy()
end

---按钮点击事件在这里派发
function SecretRealmRoomTipView:OnClickBtn(go)
end

return SecretRealmRoomTipView