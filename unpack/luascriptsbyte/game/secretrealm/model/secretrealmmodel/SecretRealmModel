---当前是否是有效的队伍数据
---@return boolean
function SecretRealmModel:HasValidTeamData()
    return self.teamData and self.teamDataValid
end

---获取布阵队伍信息
---@param callback fun(teamData:garray.i_garray,isValid:boolean):void
function SecretRealmModel:GetTeamData(callback)
    SecretRealmNet:GetInstance():GetEmbattle(function(msg)
        if msg.ack and msg.ack ~= 1 then
            self.teamData = nil
            self.teamDataValid = false
            _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
            return
        end

        self.teamData = msg.array
        self.teamDataValid = false
        if msg.array and msg.array.sits then
            for _, uid in pairs(msg.array.sits) do
                local cardData = uid > 0 and _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, uid)
                if cardData then
                    self.teamDataValid = true
                    break
                end
            end
        end
        if callback then
            callback(self.teamData, self.teamDataValid)
        end
    end)
end

