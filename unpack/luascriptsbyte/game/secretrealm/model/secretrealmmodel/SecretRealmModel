---
---@protected
function SecretRealmModel:GetAbyssalMaw(index)
    if self.teamData == nil then
        return 0
    else
        if self.teamDataValid == false then
            return 0
        end
        local num = 0
        local max = 0
        for i, v in ipairs(self.teamData.sits) do
            if v ~= 0 then
                local card = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Card, v)
                if card ~= nil then
                    num = num + card:GetAbyssalMaw(index)
                    max = max + 1
                end
            end
        end
        return num, math.floor(num / max)
    end
end

