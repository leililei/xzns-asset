---@return void
function SecretRealmModel:SetFightView(active)
    if not self:IsFighting() then
        return
    end
    _G.BattleManager:GetInstance():SetRendererActive(active)
end

---监听进入战斗界面后, 隐藏战斗界面
---@return void
function SecretRealmModel:OnFightStartInBackground()
    _G.Events:GetInstance():RemoveListener(_G.FightPlayState.FightStart, self.OnFightStartInBackground, self)
    --设置是否显示战斗页面
    local isToggledWild = _G.MainManager:GetInstance():IsToggledWildWindow(true)
    ---@type BattleView
    local battleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.BattleView.Name)
    if battleView then
        if isToggledWild then
            battleView:Show()
        else
            battleView:Hide()
        end
    end
    self:SetFightView(isToggledWild)

    --播放下边栏动画
    if isToggledWild then
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView then
            mainView:PlayAnimation()
        end
    end
end

---退出挑战
---@return void
function SecretRealmModel:ExitChallenge()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.BattleView.Name)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmBuffTipView.Name)
    self:RuneAutoDecompose()

    if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        _G.MainManager:GetInstance():ShowWildWindow()
        ---@type SecretRealmView
        local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
        if view then
            view:Show()
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmView.Name, self.curBattleIndex)
        end
    end
end

---获取当前挑战的关卡sid
---@return number
