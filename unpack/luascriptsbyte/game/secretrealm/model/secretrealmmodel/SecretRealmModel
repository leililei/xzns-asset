end

---@param msg secret_realm.s2c_info
function SecretRealmModel:ParseData(msg)
    self.data = {}
    for i, v in ipairs(msg.secret_realms) do
        self.data[v.id] = v
    end
    self.ticketKv = {}
    self.multipleList = {}
    for k, v in ipairs(discrete_cfg[116119]) do
        self.ticketKv[v[2]] = v[1]
        table.insert(self.multipleList, v[2])
    end
    table.sort(self.multipleList, function(a, b)
        return a < b
    end)
    _G.Events:GetInstance():Broadcast(_G.eSecretRealm.Refresh)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SecretRealm.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SecretRealmWish.id)
    self:GetTeamData()
    self.super.ParseData(self)
end

---设置心愿掉落
---@param type number 类型
function SecretRealmModel:ChooseWish(type, call, index)
    local pbData = { id = index, career = type }
    SecretRealmNet:GetInstance():Wish(
        pbData,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.data[index].wish = type
            _G.Events:GetInstance():Broadcast(_G.eSecretRealm.Wish)
            if call then
                call()
            end
        end
    )
end

