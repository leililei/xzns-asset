---战斗
function SecretRealmModel:Battle(sid, multiple, index)
    _G.PlayerPrefsManager.SetInt(tostring(_G.PlayerModel:GetInstance().role_uid) .. "LastChallengeState" .. index, sid)
    if self:CheckBagSize() then
        return
    end
    if self.ticketKv[multiple] > self.data[index].ticket then
        local ticketId = _G.ConfigManager.secret_realm_basic_cfg[index].recover_item[1]
        if ticketId == nil then
            ticketId = self.ticketId
        end
        local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, ticketId)
        if itemData and itemData.count > 0 then
            self.curBattleIndex = index
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.BagUsePropTipView.Name, itemData)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, ticketId)
        end
        return
    end
    self:SetMultiple(multiple, nil, index)
    self:Challenge(sid, index)
end

---检查背包空间是否充足
function SecretRealmModel:CheckBagSize()
    if not _G.StorageManager:GetInstance():CheckSize(_G.StorageID.Decoration, 1) then
        local num = _G.ConfigManager.storage_cfg[_G.StorageID.Decoration].Capacity
        _G.PopWindowManager:GetInstance():ShowAllTips(1020007, _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1020007].content, num))
        return true
    end
    return false
end

--- 门票补充时需要计算差值
function SecretRealmModel:GetTicketUseNum(index)
    if index == nil then
        index = 1
    end
    local useNum = 1
    if self:GetFunctionOpen() then
        local battleMax = _G.ConfigManager.system_cfg[213].count_limit
        local add = battleMax - self:GetTicket(index)
        if add > 0 then
            local ticketId = _G.ConfigManager.secret_realm_basic_cfg[index].recover_item[1]
            if ticketId == nil then
                ticketId = self.ticketId
            end
            local itemData = _G.StorageManager:GetInstance():GetItemDataByID(_G.StorageID.Prop, ticketId)
            if (itemData ~= nil) then
                useNum = add > itemData.count and itemData.count or add
            end
        end
    end
    return useNum
end

---增加挑战次数
function SecretRealmModel:AddTicket(num, index)
    if index == nil then
        index = 1
    end
    if num < 0 then
        num = -self.ticketKv[self.data[index].multiple]
    end
    self.data[index].ticket = self.data[index].ticket + num
    _G.Events:GetInstance():Broadcast(_G.eSecretRealm.AddTicket)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SecretRealm.id)
    require("RedPointManager"):GetInstance():RefreshNodeByAllParams(_G.ConfigManager.redpoint_cfg.SecretRealmWish.id)
end

