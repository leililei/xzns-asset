---注册接口由C#调用
local function IsBossRoom()
    return require("SecretRealmModel"):GetInstance():IsBossRoom() and 1 or 0
end
local function getLayerName()
    local model = require("SecretRealmModel"):GetInstance()
    return model:GetName(model.challengeSid)
end
local function getLayerTotalTime()
    local cfg = _G.ConfigManager.discrete_cfg[116125]
    if not cfg then
        return 300
    end
    return cfg[1][1]
end
---获取房间状态
---@return string @房间数#当前房间序号#当前房间总波次#已通关房间波次#总波次
local function getRoomStatus()
    local cfg = _G.ConfigManager.discrete_cfg[RoomBoutCfgId]
    local curRoomIndex = require("SecretRealmModel"):GetInstance().challengeIndex
    if not cfg or not curRoomIndex then
        if _G.AppSetting.DEBUG then
            _G.LogError("大秘境: 未在挑战中或者房间配置不存在")
        end
        return nil
    end
    local boutPassed, boutTotal = 0, 0
    for roomIndex, num in ipairs(cfg[1]) do
        if roomIndex < curRoomIndex then
            boutPassed = boutPassed + num
        end
        boutTotal = boutTotal + num
    end
    return #cfg[1] .. "#" .. curRoomIndex .. "#" .. cfg[1][curRoomIndex] .. "#" .. boutPassed .. "#" .. boutTotal
end
local function showEffectDescription(sid, desc)
    local text = _G.GetLangPackValue(desc)
    --寻找分隔符
    local char = '：'
    local index = string.find(text, char)
    if not index then
        char = ':'
        index = string.find(text, char)
    end
    local name, desc = text
    if index then
        name = string.sub(text, 1, index - 1)
        desc = string.sub(text, index + #char)
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.SecretRealmBuffTipView.Name, name, desc)
end

