function SecretRealmModel:OnEmbattleOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.EmbattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnEmbattleOpened, self)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.SecretRealmView.Name)

    ---@type EmbattleNewView
    local embattleView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.EmbattleView.Name)
    if embattleView then
        --对战名称
        local leftName, rightName = _G.PlayerModel:GetInstance():GetName(), _G.GetLangPackValue(90032800019)
        embattleView:SetVsDescription(leftName, rightName)

        --修改战斗按钮为保存
        if not self.embatlleNextBattle or self:HasValidTeamData() then
            embattleView:SetBattleBtnText(_G.GetLangPackValue(90032000016))
        end
    end
end

function SecretRealmModel:ExitEmbattle()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
    --清除布阵资源(布阵相关资源会延后回收)
    _G.DelayFrameDo(function()
        _G.WorldManager:GetInstance():DespawnRoleParent()
        _G.BattleManager:GetInstance():DestroyBattle(false)
    end)
end

function SecretRealmModel:BattleOrExitEmbattle(sid, multiple, index)
    if not sid or not multiple or not self:HasValidTeamData() or self:CheckBagSize() then
        self:ExitEmbattle()
        return
    end
    --立即进入战斗
    _G.WorldManager:GetInstance():DespawnRoleParent()
    _G.BattleManager:GetInstance():DestroyBattle(false)

    self:Battle(sid, multiple, index)
end

---保存布阵阵容数据
---@param data {sits:number[], skills:number[], pets:number[]} 布阵数据
---@param callback function 回调函数
function SecretRealmModel:SaveEmbattle(data, callback)
    local pbData
    if _G.AppSetting.IsXzns then
        pbData = {
            array = {
                id = 290,
                sits = data.sits,
                skill_index = data.skills,
                pet = data.pets,
                beast = data.beasts
            }
        }
    else
        pbData = {
            array = {
                id = 290,
                sits = data.sits,
                skill_index = data.skills,
                pet = data.pets
            }
        }
    end
    SecretRealmNet:GetInstance():SetEmbattle(pbData, function(msg)
        if msg.ack and msg.ack ~= 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
            if callback then
                callback(1)
            end
            return
        end
        --TODO: 布阵成功
        --_G.PopWindowManager:GetInstance():ShowAllTips(0)
        self.teamData = pbData.array
        self.teamDataValid = true
        _G.Events:GetInstance():Broadcast(_G.eSecretRealm.Embattle)
        if callback then
            callback(0)
        end
    end)
end

