    return self.challengeSid
end

---获取当前挑战的关卡心愿奖励池
---@return number
function SecretRealmModel:GetCurrentChallengeAwardWishPool()
    local pool = {}
    if self.data[self.curBattleIndex].wish > 0 then
        local dropSid = _G.ConfigManager.secret_realm_cfg[self.challengeSid].drop[3][self.data[self.curBattleIndex].wish + 1]
        for i, v in ipairs(_G.ConfigManager.drop_cfg[dropSid].content1) do
            pool[v[1]] = true
        end
    end
    return pool
end

---开始挑战
---@param sid number 关卡sid
---@return void
function SecretRealmModel:Challenge(sid, index)
    self.curBattleIndex = index
    local cfg = _G.ConfigManager.discrete_cfg[RoomBoutCfgId]
    self.challengeSid = sid
    self.challengeIndex = 1
    self.challengeRoom = cfg and (#cfg[1] + 1) or 4 --cfg是小怪房间配置, 最后跟一个默认boss房间
    --复活次数配置
    self.freeReviveCount = 1
    self.reviveCount = 0
    --清空奖励状态
    self:ClearAwardData()
    --挑战开始前, 重置一次关卡
    SecretRealmNet:GetInstance():Reset(function(msg)
        if msg.ack ~= 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(msg.ack)
            return
        end

        --选中野外选项卡时, 才播放入场动画
        if _G.MainManager:GetInstance():IsToggledWildWindow(true) then
            self:ChallengeCurrentRoomWithTransfor()
        else
            _G.UIManager:GetInstance():CloseWindow(
                _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
            )
            self:ChallengeCurrentRoom()
        end
    end)
end

---挑战当前房间
---@return void
function SecretRealmModel:ChallengeCurrentRoom()
    local cfg = _G.ConfigManager.secret_realm_cfg[self.challengeSid]
    local mgpId = self.challengeIndex < self.challengeRoom and cfg.scene[1] or cfg.scene[2]

    --存储战斗状态
    self.fighting = true
    --_G.CS.BattleManager.Inst:Destroy()
    --_G.BattleManager:GetInstance():SetRendererActiveState(_G.MainManager:GetInstance():IsToggledWildWindow(true)) --是否显示表现层

    --对战名称
    local leftName, rightName = _G.PlayerModel:GetInstance():GetName(), _G.GetLangPackValue(90032800019)
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnBattleViewOpened, self)
    _G.Events:GetInstance():AddListener(_G.FightPlayState.FightStart, self.OnFightStartInBackground, self)
    _G.BattleManager:GetInstance():EnterFight(_G.BattleControllerType.SecretRealm, mgpId, leftName, rightName)

    --显示主页面下边栏
    if _G.MainManager:GetInstance():IsToggledWildWindow(false) then
        _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.MainView.Name)
        _G.MainManager:GetInstance():RefreshWildWindow()

        --初始化下边栏动画
        ---@type MainView
        local mainView = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.MainView.Name)
        if mainView then
            mainView:InitAnimation()
        end
    end
end

--播放入场
function SecretRealmModel:ChallengeCurrentRoomWithTransfor(delay)
    if _G.BattleManager:GetInstance():CheckInBattle() then
        self:ChallengeCurrentRoom()
        return
    end
    ---@type SecretRealmBattleTransforView
    local transforView = _G.UIManager:GetInstance():GetWindowCtrl(
        _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name
    )
    if transforView then
        transforView:Show()
        transforView:SetAction(
            "zoom_out",
            _G.handler(self, self.ChallengeCurrentRoom)
        )
    else
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.SecretRealmBattleTransforView.Name,
            "zoom_out",
            _G.handler(self, self.ChallengeCurrentRoom)
        )
    end
end

---挑战下一个房间
---@return void
function SecretRealmModel:ChallengeNextRoom()
    self.challengeIndex = self.challengeIndex + 1
    self:ChallengeCurrentRoom()
end

function SecretRealmModel:OnBattleViewOpened(name)
    if name ~= _G.ConfigManager.ui_cfg.BattleView.Name then
        return
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnBattleViewOpened, self)
    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.SecretRealmView.Name)
end

---发起战斗请求
---@param callback fun(msg:secret_realm.s2c_fight):void
---@return number @消息cmd
function SecretRealmModel:GetFightArgs(callback)
    local fight_type = self.challengeIndex < self.challengeRoom and 1 or 2
    local pbData = {
        id = self.curBattleIndex,
        sid = self.challengeSid,
        fight_type = fight_type,
        monster_index = self.challengeIndex
    }
    return SecretRealmNet:GetInstance():Battle(pbData, callback)
end

---发起复活请求
---@param callback fun(msg:public.s2c_common_ack):void
---@return number @消息cmd
function SecretRealmModel:Revive(callback)
    local pbData = { bool = 1 }
    SecretRealmNet:GetInstance():Revive(pbData, callback)
end

---判断是否为boss房间
---@return boolean
function SecretRealmModel:IsBossRoom()
    if not self.challengeIndex or not self.challengeRoom then
        return false
    end
    return self.challengeIndex >= self.challengeRoom
end

---获取剩余复活次数(包含免费丶付费次数)
---@return number
function SecretRealmModel:GetReviveCount()
    return self:GetFreeReviveCount() + (self.reviveCount or 0)
end

---获取剩余免费复活次数
---@return number
function SecretRealmModel:GetFreeReviveCount()
    return self.freeReviveCount or 0
end

---更新免费复活次数
function SecretRealmModel:UpdateFreeReviveCount(num)
    self.freeReviveCount = self:GetFreeReviveCount() + num
    if self.freeReviveCount < 0 then
        self.freeReviveCount = 0
    end
end

