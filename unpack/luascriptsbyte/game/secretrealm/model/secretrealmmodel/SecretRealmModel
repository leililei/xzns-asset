---存储临时奖励信息
---@param msg public.s2c_common_ack|fight.s2c_fight_result
function SecretRealmModel:ReceiveAwardData(msg)
    if not msg or not msg.other_award or not msg.other_award.item then
        return
    end

    local RuneAutoDecompose = _G.PlayerPrefsManager.GetTable(_G.PlayerPrefsKey.RuneAutoDecompose)
    if not RuneAutoDecompose or _G.TableIsEmpty(RuneAutoDecompose) then
        RuneAutoDecompose = {}
    end
    if not self.runeDecomposeList then
        self.runeDecomposeList = {}
    end

    if not self.awardDatas then
        self.awardDatas = {}
    end
    local grade
    for _, v in ipairs(msg.other_award.item) do
        table.insert(self.awardDatas, v)
    end
    if self:IsBossRoom() then
        local type
        for _, v in pairs(msg.award.item) do
            type = _G.StorageManager:GetInstance():CheckSidType(v.type[1])
            if type and type == _G.StorageType.Decoration then
                grade = _G.StorageManager:GetInstance():GetItemGrade(v.type[1])
                if RuneAutoDecompose[grade] then
                    _G.table.insert(self.runeDecomposeList, { sid = v.type[1], uid = v.type[2] })
                end
            end
        end
    end
end

---获取临时奖励数据
---@return award.i_award_item[]
function SecretRealmModel:GetAwardData()
    return self.awardDatas
end

---获取临时奖励数据数量
