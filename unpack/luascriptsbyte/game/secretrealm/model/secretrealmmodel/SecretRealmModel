---获取符文奖励
---@return table
function SecretRealmModel:GetRuneAwardData()
    local runeList = {}
    if not self.awardDatas then
        return runeList
    end

    local storageManager = _G.StorageManager:GetInstance()
    for _, v in pairs(self.awardDatas) do
        if v.type and v.type[1] then
            local _, storageId = storageManager:CheckSidType(v.type[1])
            if storageId == _G.StorageID.Decoration then
                _G.table.insert(runeList, v.type[1])
            end
        end
    end
    return runeList
end

---清空临时奖励数据
---@return void
function SecretRealmModel:ClearAwardData()
    self.awardDatas = nil
end

---符文自动分解
function SecretRealmModel:RuneAutoDecompose(callback)
    if not self.runeDecomposeList or #self.runeDecomposeList == 0 then
        return
    end
    local uids = {}
    local selectList = {}
    local decList = _G.StorageManager:GetInstance():GetDataByID(_G.StorageID.Decoration)
    for _, v in pairs(self.runeDecomposeList) do
        --TODO 判断符文是否存在背包
        if decList[v.uid] then
            _G.table.insert(uids, v.uid)
            selectList[v.uid] = { sid = v.sid }
        end
    end
    if #uids == 0 then
        return
    end
    require("DecorationModel"):GetInstance():Decompose(selectList, uids, function(msg)
        local count = #self.runeDecomposeList
        self.runeDecomposeList = {}
        local expCount = 0
        for k, v in pairs(msg.award.item) do
            if v.type[1] == RuneExpSid then
                expCount = v.type[2]
            end
        end
        _G.PopWindowManager:GetInstance():ShowAllTips(1020013,
            nil, nil, nil, nil, nil,
            count, expCount)
    end,
        true)
end

