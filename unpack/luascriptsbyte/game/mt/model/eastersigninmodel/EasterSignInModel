local base = _G.GameDataModelBase
---@class EasterSignInModel : GameDataModelBase	中文描述
local EasterSignInModel = _G.BaseClass("EasterSignInModel",base)


---类的构造函数
function EasterSignInModel:__init()
end

function EasterSignInModel:ParseSignData(info, curActivityClass)
    self.curActivityClass = curActivityClass
    --已领取的奖励id
    self.signIdList = {}
    if info.sign.g_sids then
        for _, v in pairs(info.sign.g_sids) do
            self.signIdList[v] = v
        end
    end
    --奖励item信息
    self.item = {}
    if info.sign.item then
        for _, v in pairs(info.sign.item) do
            self.item[v.sid] = v
        end
    end
    self.title = info.sign.title
    self.startTime = curActivityClass.cfg.time.start_time
    self.endTime = self.startTime + curActivityClass.cfg.time.run_time
end


function EasterSignInModel:GetSignInDays()
    local days = _G.math.ceil((_G.TimeUtil.GetServerUnixTime() - self.startTime) / 86400)
    return days
end

--- 获得配置的签到总天数
function EasterSignInModel:GetSignItemNum()
    return _G.table.count(self.item)
end

---获得签到信息
function EasterSignInModel:GetSignItem(index)
    if self.item[index].award then
        return self.item[index].award[1].type
    end
    return { self.item[index].other_a[1].c_id, self.item[index].other_a[1].num }
end

--- 获得已经签到的天数列表
function EasterSignInModel:GetSignIdList()
    return self.signIdList
end

---获得活动开始时间戳
function EasterSignInModel:GetStartTime()
    return self.startTime
end

---获得获得结束时间戳
function EasterSignInModel:GetEndTime()
    return self.endTime
end

---获取签到奖励
function EasterSignInModel:GetSignAward(index, callback)
    local data = self.item[index]
    if data then
        self.curActivityClass.typeClass:GetAward(
            data.sid,
            function(msg)
                if msg.ack ~= 1 then
                    return
                end
                if not msg.award then
                    msg.award = {}
                end
                if not msg.award.item then
                    msg.award.item = {}
                end
                if data.award then
                    _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                elseif data.other_a then
                    for _, v in ipairs(data.other_a) do
                        local tb = _G.StorageManager:GetInstance():SimulationAward(v.c_id, v.num)
                        _G.table.insert(msg.award.item, { type = tb })
                        _G.Events:GetInstance():Broadcast(_G.eArena.SetDrawUp, { v.c_id, v.num })
                    end
                end
                _G.UIUtils.ShowCommonAward(msg)
                self.signIdList[data.sid] = data.sid
                self.curActivityClass.typeClass:RefreshRedPoint()
                if callback then
                    callback()
                end
            end)
    end
end

---获取签到奖励
function EasterSignInModel:GetSignAwardT(indexT, callback)
    self.curActivityClass.typeClass:GetAwardT(
        indexT,
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if not msg.award then
                msg.award = {}
            end
            if not msg.award.item then
                msg.award.item = {}
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(msg)
            _G.UIUtils.ShowCommonAward(msg)
            for k, v in pairs(indexT) do 
                self.signIdList[v] = v
            end
            self.curActivityClass.typeClass:RefreshRedPoint()
            if callback then
                callback()
            end
    end)
end

--- 检测是否签到
function EasterSignInModel:CheckSignId(index)
    if self.signIdList[index] then
        return true
    end
    return false
end

---签到红点
function EasterSignInModel:CheckSignRedPoint()
    if self:GetSignInDays() > _G.table.count(self.signIdList) then
        return true
    end
    return false
end

---获取标题
function EasterSignInModel:GetTitle(index)
    return self.title[index] or 0
end

---类的析构函数
function EasterSignInModel:Dispose()
end

return EasterSignInModel
