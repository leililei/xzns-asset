---@class MTSignInMainView : UIBaseView	中文描述
---@field public go_table MTSignInMainView_GoTable GoTable
local MTSignInMainView = _G.BaseClass("MTSignInMainView", _G.UIBaseView)
local ActivitySynManager = require "ActivitySynManager"

function MTSignInMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MTSignInMainView_bg,
        self.go_table.obj_BgEffect,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_MTSignInMainView_titleloop,
        self.go_table.aorrawimage_title.gameObject,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end

---界面的入口函数
function MTSignInMainView:OnCreate(activity)
    self.activityId = activity:GetActivityID()
    self.activity = activity
    self:InitActivityTime()
    self:InitActivityItem()
    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.InitActivityItem, self)
    if self.viewName == "CapybaraSignInMainView" then
        self.go_table.aortext_acttitle.text = self.activity.cfg.info.title
    else
        self.go_table.aortext_acttitle.text = self.activity.cfg.info.title
    end
end

---开始时间~结束时间  (日月)
function MTSignInMainView:InitActivityTime()
    local t
    t, self.time = self.activity:GetActivityDeadLineByCondition(ActivitySynManager.State.Close)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90034501003, _G.TimeUtil.GiftPackGroupTime(self.time))
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
end

function MTSignInMainView:UpdateTime(elapsed)
    if not self.go_table then 
        return 
    end
    self.time = self.time - elapsed
    if self.time <= 0 then
        self:Close()
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90034501003, _G.TimeUtil.GiftPackGroupTime(self.time))
    end
end

---初始化活动Item
function MTSignInMainView:InitActivityItem()
    self.signIdList = require"IceFestivalSignInModel":GetInstance():GetSignIdList()
    self.nowDay = _G.TimeUtil.GetInterValDayByGame(_G.TimeUtil.GetServerUnixTime(),self.activity.cfg.time.start_time) + 1
    local allDay = require"IceFestivalSignInModel":GetInstance():GetSignItemNum()
    self.num = math.ceil(allDay / 7)
    for i = 1, 5 do 
        self:RefreshActivityItem(i, self.go_table["obj_activityItem" .. i])
    end
    self:FreshAllRed()
end

function MTSignInMainView:RefreshActivityItem(index, obj)
    if obj == nil then
        return
    end
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickActivity, index))
    if index > self.num then 
        tb.gameObject:SetActiveE(0)
    else 
        tb.gameObject:SetActiveE(1)
        tb.interValDay = 7 * (index - 1) + 1 - self.nowDay
        tb.tipContent = nil
        --tb.obj_redpoint:SetActiveE(self:CheckRed(index) and 1 or 0)
        tb.obj_lock:SetActiveE(self:CheckUnlock(index) and 0 or 1)
        tb.obj_over:SetActiveE(self:CheckOver(index) and 1 or 0)
        local title = _G.GetLangPackValue(require"IceFestivalSignInModel":GetInstance():GetTitle(index)) 
        tb.aortext_title.text = title
        tb.aortext_title1.text = title
        if tb.interValDay > 0 then 
            tb.aortext_lockTip.text = _G.GetLangPackValue(90028300082, tb.interValDay)
        end
    end
end

function MTSignInMainView:FreshAllRed()
    for i = 1, self.num do 
        local tb = _G.GetAutoGoTable(self.go_table["obj_activityItem" .. i])
        tb.obj_redpoint:SetActiveE(self:CheckRed(i) and 1 or 0)
    end
end
function MTSignInMainView:CheckRed(index)
    index = 7 * (index - 1) + 1
    local day = math.min(index + 6, self.nowDay)
    for i = index, day do 
        if not require"IceFestivalSignInModel":GetInstance():CheckSignId(i) then 
            return true
        end
    end
    return false 
end

function MTSignInMainView:CheckUnlock(index)
    index = 7 * (index - 1) + 1
    return self.nowDay >= index
end

function MTSignInMainView:CheckOver(index)
    index = 7 * (index - 1) + 1
    local num = 0
    for i = index, index + 6 do 
        if require"IceFestivalSignInModel":GetInstance():CheckSignId(i) then 
            num = num + 1
        end
    end
    return num == 7 
end

function MTSignInMainView:OnClickActivity(_, _, index)
    local interValDay = 7 * (index - 1) + 1 - self.nowDay
    if interValDay > 0 then 
        local nextStateTime = (interValDay - 1) * 86400 + _G.TimeUtil.GetSixClockTimer()
        local txt = _G.LangUtil.GetLangPackValue(_G.ConfigManager.tips_system_cfg[1160001].content, _G.TimeUtil.TranslateSecondForStr(nextStateTime))
        _G.PopWindowManager:GetInstance():ShowAllTips(1160001, txt)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTSignInView.Name, self.activity, index, _G.handler(self, self.InitActivityItem), self.viewName == "CapybaraSignInMainView")
    end
end

---界面的销毁函数
function MTSignInMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer=nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function MTSignInMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        if self.viewName == "CapybaraSignInMainView" then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 213)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 193)
        end
    end
end

return MTSignInMainView