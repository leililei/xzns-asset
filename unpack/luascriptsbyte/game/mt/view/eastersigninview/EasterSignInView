---@class EasterSignInView : UIBaseView	中文描述
---@field public go_table EasterSignInView_GoTable GoTable
local EasterSignInView = _G.BaseClass("EasterSignInView", _G.UIBaseView)

function EasterSignInView:Awake()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.SixRefresh, self)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function EasterSignInView:OnCreate()
    --- @type EasterSignInModel
    self.model = require("EasterSignInModel"):GetInstance()
    --- 当前页面
    self.page = 1
    --- 签到总天数
    self.count = self.model:GetSignItemNum()
    --- 签到页面最大值
    self.maxPage = _G.math.ceil(self.count / 7)
    --- 当前活动的天数
    self.signInDays = self.model:GetSignInDays()
    self.startTime = self.model:GetStartTime()
    self.endTime = self.model:GetEndTime()
    --- 页签父对象
    self.itemList = {
        self.go_table.obj_parent1,
        self.go_table.obj_parent2,
        self.go_table.obj_parent3,
        self.go_table.obj_parent4,
        self.go_table.obj_parent5,
        self.go_table.obj_parent6,
        self.go_table.obj_parent7,
    }
    -- 每个节点的奖励图标
    self.awardItemList = {}
    self:InitView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.timer:Start()
    self:UpdateTimer()
    if not _G.AppSetting.IsXzns then
        _G.UIUtils.LoadEffectByCfg(
                _G.ConfigManager.ui_effect_cfg.ef_bg,
                self.go_table.obj_effect,
                function(tran)
                    if _G.IsNil(self.go_table) then
                        tran:DestroyObject()
                        return
                    end
                end
        )
    end

end

---初始化界面
function EasterSignInView:InitView()
    self.resource = self:AddComponent(
        self.go_table.obj_GoldInfo,
        require("ResourceCompont").New(self.go_table.obj_GoldInfo,
            _G.ConfigManager.ui_cfg.EasterSignInView.resources)
    )
    self:AddComponent(self.go_table.obj_playerInfo,
        require("PlayerComponent").New(self.go_table.obj_playerInfo))

    -- 将页面跳转到可领取奖励的最早一天
    local signIdList = self.model:GetSignIdList()
    for i = 1, self.count do
        if not signIdList[i] then
            self.page = _G.math.ceil(i / 7)
            break
        end
    end
    self:RefreshView()
end

function EasterSignInView:SixRefresh()
    --- 签到总天数
    self.count = self.model:GetSignItemNum()
    --- 签到页面最大值
    self.maxPage = _G.math.ceil(self.count / 7)
    --- 当前活动的天数
    self.signInDays = self.model:GetSignInDays()
    self:RefreshView()
end

---刷新界面
function EasterSignInView:RefreshView()
    -- 根据剩余签到天数，修改界面页签数量
    local count = self.count - (self.page - 1) * 7
    for i = 1, #self.itemList do
        if i <= count then
            self.itemList[i]:SetActiveE(1)
        else
            self.itemList[i]:SetActiveE(0)
        end
    end

    if self.page == 1 then
        self.go_table.aorbtn_qiehuan1:SetActiveE(0)
    else
        self.go_table.aorbtn_qiehuan1:SetActiveE(1)
    end

    if self.page == self.maxPage then
        self.go_table.aorbtn_qiehuan2:SetActiveE(0)
    else
        self.go_table.aorbtn_qiehuan2:SetActiveE(1)
    end

    local item
    local index = 0
    -- 加载页签item
    for _, v in pairs(self.itemList) do
        index = index + 1
        if v:GetChildCountE() == 0 then
            item = _G.InstantiateObject(self.go_table.obj_item, v)
            item:SetLocalPosition(0, 0, 0)
        else
            item = v:GetChildE(0)
        end
        if item then
            self:SetItem(index, _G.GetAutoGoTable(item))
        end
    end
end

---设置签到页签
---@param index number 第几个页签
---@param go table go_table
function EasterSignInView:SetItem(index, go)
    local count = index + (self.page - 1) * 7

    -- if index == 2 then
    --     go.obj_sheng:SetRectTransformSize(22, 158)
    -- elseif index == 3 then
    --     go.obj_sheng:SetRectTransformSize(22, 119)
    -- elseif index == 6 then
    --     go.obj_sheng:SetRectTransformSize(22, 110)
    -- else
    --     go.obj_sheng:SetRectTransformSize(22, 92)
    -- end

    --- 是否已经领取
    local isGou = false
    if self.model:CheckSignId(count) then
        isGou = true
    end
    go.aortext_title.text = _G.GetLangPackValue(90000012009, count)
    -- 根据是否能够领取进行设置
    if count <= self.signInDays and not isGou then
        -- 可领取
        go.aorbtn_getAward:SetActiveE(1)
        --go.obj_got:SetActiveE(0)
        go.obj_get:SetActiveE(1)
        go.obj_noGet:SetActiveE(0)
        go.aorbtn_getAward.onClick:RemoveAllListeners()
        go.aorbtn_getAward.onClick:AddListener(_G.handlerbind(self, self.OnClickItemAward, index, go))
    elseif isGou then
        -- 已经领取
        go.obj_get:SetActiveE(0)
        go.aorbtn_getAward:SetActiveE(0)
        --go.obj_got:SetActiveE(1)
        go.obj_noGet:SetActiveE(0)
    else
        -- 不可领取(没到时间)
        go.obj_get:SetActiveE(0)
        go.aorbtn_getAward:SetActiveE(0)
        --go.obj_got:SetActiveE(0)
        go.obj_noGet:SetActiveE(1)
    end

    -- 创建奖励item
    -- 获取奖励数据
    local data = self.model:GetSignItem(count)
    local sid = data[1] == 0 and data[4] or data[1]
    local num = data[1] == 0 and data[5] or data[2]
    if not self.awardItemList[index] then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            {sid, num},
            go.obj_awards,
            function(item)
                if _G.IsNil(go.obj_awards) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                self.awardItemList[index] = item
                item.gameObject:SetLocalScaleXYZ(0.8)
                item:ShowEffect(not isGou and count <= self.signInDays)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                item:SetGou(isGou)
            end,
            function(go, isOn)
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, data[1] > 0 and data[1] or data[4] )
            end
        )
    else
        local item = self.awardItemList[index]
        local sid = data[1] > 0 and data[1] or data[4]
        local info = _G.StorageManager:GetInstance():GetItemDataClass(sid, data[1] > 0 and data[2] or data[5], {})
        item:UpdateData(item.gameObject, info)
        item:UpdateFunction()
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGou(isGou)
        item:ShowEffect(not isGou and count <= self.signInDays)
    end
end

---点击页签获得签到奖励
---@param index number 页签索引
function EasterSignInView:OnClickItemAward(index, go)
    if _G.AppSetting.IsXzns then
        local getList = {}
        for i = 1, self.count do
            local isGou = self.model:CheckSignId(i)
            if i <= self.signInDays and not isGou then
                _G.table.insert(getList, i)
            end
        end
        if #getList ~= 0 then
            self.model:GetSignAwardT(getList, function()
                self:RefreshView()
            end)
        end
    else
        local count = index + (self.page - 1) * 7
        if count < 1 or count > self.count then
            return
        end
        self:GetSignInAward(count, function()
            --go.obj_got:SetActiveE(1)
            go.obj_get:SetActiveE(0)
            self.awardItemList[index]:SetGou(true)
            self.awardItemList[index]:ShowEffect(false)
        end)
    end
end

---获取签到奖励
---@param index number 第几天的奖励
function EasterSignInView:GetSignInAward(index, callback)
    -- 向后端发送签到请求
    -- 执行回调
    self.model:GetSignAward(index, function()
        if callback then
            callback()
        end
    end)
end

function EasterSignInView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    if _G.AppSetting.IsXzns then
        self.go_table.aortext_time.text = _G.TimeUtil.TranslateSecondForStr(time)
    else
        self.go_table.aortext_time.text = _G.GetLangPackValue(90000011689, _G.TimeUtil.TranslateSecondForStr(time))
    end
end

---界面的销毁函数
function EasterSignInView:OnDestroy()
    _G.Events:RemoveListener(_G.eSixUpdate.SixClockUpdate, self.SixRefresh, self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function EasterSignInView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_qiehuan1 then
        -- 左
        if self.page > 1 then
            self.page = self.page - 1
            self:RefreshView()
        end
    elseif go == self.go_table.aorbtn_qiehuan2 then
        -- 右
        if self.page < self.maxPage then
            self.page = self.page + 1
            self:RefreshView()
        end
    end
end

return EasterSignInView
