---@field public go_table DrawUpAwardPreView_GoTable GoTable
local MTLimitedExchangDesView = _G.BaseClass("MTLimitedExchangDesView", _G.UIBaseView)
local imaName1 = {
    "ImagesH5/MTExchange/ui_mtlm_smtt_tstc1",
    "ImagesH5/MTExchange/ui_mtlm_smtt_tstc1",
    "ImagesH5/MTExchange/ui_mtlm_smtt_tstc2"
}

local roleDes1 = {
    90034521031,
    90034521032,
    90034521033
}
local titleName1 = {
    90034521030,
    90034521030,
    90034521034
}

local imaName2 = {
    "ImagesH5/MTExchange/ui_kpbl_smtt_wfsmtc",
    "ImagesH5/MTExchange/ui_kpbl_smtt_wfsmtc",
    "ImagesH5/MTExchange/ui_kpbl_smtt_kpss"
}

local roleDes2 = {
    90034521031,
    90034521032,
    90034621009
}
local titleName2 = {
    90034521030,
    90034521030,
     90034521034
}
function MTLimitedExchangDesView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
---@param ActivityID number 活动id
function MTLimitedExchangDesView:OnCreate(activity)
    --self.videoId = _G.ConfigManager.card_cfg[cardSid].video
    self.activity = activity
    self.subType = self.activity:GetJumpType()
    if self.subType == 100162 then 
        self.imaName = imaName2
        self.roleDes = roleDes2
        self.titleName = titleName2
    else 
        self.imaName = imaName1
        self.roleDes = roleDes1
        self.titleName = titleName1
    end
    self.nowIndex = 1
    self.maxIndex = #self.imaName
    self:FreshSkill()
    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.FirstMTLimitedEx, 1)
end

function MTLimitedExchangDesView:FreshSkill()
    self.go_table.aorrawimage_skill:LoadImage(
        self.imaName[self.nowIndex],
        function()
            if not _G.IsNil(self) then
                self.go_table.aorrawimage_skill:SetNativeSize()
            end
        end
    )
    self.go_table.aortext_skillDes.text = _G.LangUtil.GetLangPackValue(self.roleDes[self.nowIndex]) 
    self.go_table.aortext_skillName.text = _G.LangUtil.GetLangPackValue(self.titleName[self.nowIndex]) 
    _G.CS.UnityEngine.UI.LayoutRebuilder.ForceRebuildLayoutImmediate(self.go_table.aortext_skillDes.rectTransform)
    self:ShowArrow()
    for i = 1, 4 do 
        self.go_table["aorimage_dot" .. i]:SetActiveE(i > self.maxIndex and 0 or 1)
        self.go_table["aorimage_dotShow" .. i]:SetActiveE(i == self.nowIndex and 1 or 0)
    end
    -- if self.nowIndex == self.maxIndex then 
    --     self.canGet = true 
    -- end
end
function MTLimitedExchangDesView:ShowArrow()
    self.go_table.aorbtn_left:SetActiveE(self.nowIndex ~= 1 and 1 or 0)
    self.go_table.aorbtn_right:SetActiveE(self.nowIndex ~= self.maxIndex and 1 or 0)
end

---按钮点击事件在这里派发
function MTLimitedExchangDesView:OnClickBtn(go, isOn)
   if go == self.go_table.aorbtn_close then 
        self:Close()
    elseif go == self.go_table.aorbtn_left then 
        self.nowIndex = self.nowIndex - 1
        self.nowIndex = self.nowIndex > 0 and self.nowIndex or 1
        self:FreshSkill()
    elseif go == self.go_table.aorbtn_right then 
        self.nowIndex = self.nowIndex + 1
        self.nowIndex = self.nowIndex < self.maxIndex and self.nowIndex or self.maxIndex
        self:FreshSkill()
    end
end

function MTLimitedExchangDesView:Dispose()
end

return MTLimitedExchangDesView
