local MTSignInView = _G.BaseClass("MTSignInView", _G.UIBaseView)

function MTSignInView:Awake()
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate,self.SixRefresh,self)
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.bgName = {
        "ImagesH5/MTSign/ui_mtlm_qdtc_img_1",
        "ImagesH5/MTSign/ui_mtlm_qdtc_img_2",
        "ImagesH5/MTSign/ui_mtlm_qdtc_img_3",
        "ImagesH5/MTSign/ui_mtlm_qdtc_img_4",
        "ImagesH5/MTSign/ui_mtlm_qdtc_img_5"
    }
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_zitankuangxingxing,
        self.go_table.obj_BgEffect,
        function(effect)
            if self:IsNil() then
                _G.UIUtils.RemoveEffect(effect)
            end
        end
    )
end

---界面的入口函数
function MTSignInView:OnCreate(activity, index, closeCall, isCapybara)
        --- @type IceFestivalSignInModel
    self.model = require("IceFestivalSignInModel"):GetInstance()
    --- 当前页面
    self.page = index
    --- 签到总天数
    self.count = self.model:GetSignItemNum()
    --- 签到页面最大值
    self.maxPage = _G.math.ceil(self.count / 7)
    --- 当前活动的天数
    self.signInDays = self.model:GetSignInDays()
    self.startTime = self.model:GetStartTime()
    self.endTime = self.model:GetEndTime()
    self.closeCall = closeCall
    self.isCapybara = isCapybara
    --- 页签父对象
    self.itemList = {
        self.go_table.obj_parent1,
        self.go_table.obj_parent2,
        self.go_table.obj_parent3,
        self.go_table.obj_parent4,
        self.go_table.obj_parent5,
        self.go_table.obj_parent6,
        self.go_table.obj_parent7,
    }
    if self.isCapybara then
        self.bgName = {
            "ImagesH5/hCapybara/ui_kpbl_qddk_bg1",
            "ImagesH5/hCapybara/ui_kpbl_qddk_bg2",
            "ImagesH5/MTSign/ui_mtlm_qdtc_img_3",
            "ImagesH5/MTSign/ui_mtlm_qdtc_img_4",
            "ImagesH5/MTSign/ui_mtlm_qdtc_img_5"
        }
    end
    -- 每个节点的奖励图标
    self.awardItemList = {}
    self:InitView()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1,self.UpdateTimer, self, false, false, true)
    self.timer:Start()
end

