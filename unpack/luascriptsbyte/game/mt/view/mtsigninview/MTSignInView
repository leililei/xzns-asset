---设置签到页签
---@param index number 第几个页签
---@param go table go_table
function MTSignInView:SetItem(index, go)
    local count = index + (self.page - 1) * 7
    --- 是否已经领取
    local isGou = false
    if self.model:CheckSignId(count) then
        isGou = true
    end
    go.aortext_title.text = _G.GetLangPackValue(90034501005, count)
    -- 根据是否能够领取进行设置
    if count <= self.signInDays and not isGou then
        -- 可领取
        go.aorbtn_getAward:SetActiveE(1)
        go.obj_got:SetActiveE(0)
        go.obj_get:SetActiveE(1)
        go.aortext_title:SetActiveE(0)
        --go.obj_noGet:SetActiveE(0)
        go.aorbtn_getAward.onClick:RemoveAllListeners()
        go.aorbtn_getAward.onClick:AddListener(_G.handlerbind(self, self.OnClickItemAward, index, go))
        go.gameObject:SetActiveE(1)
        self.go_table["obj_mask" .. index]:SetActiveE(1)
    elseif isGou then
        -- 已经领取
        go.obj_get:SetActiveE(0)
        go.aorbtn_getAward:SetActiveE(0)
        go.obj_got:SetActiveE(1)
        --go.obj_noGet:SetActiveE(0)
        go.gameObject:SetActiveE(0)
        self.go_table["obj_mask" .. index]:SetActiveE(0)
    else
        -- 不可领取(没到时间)
        go.obj_get:SetActiveE(0)
        go.aortext_title:SetActiveE(1)
        go.aorbtn_getAward:SetActiveE(0)
        go.obj_got:SetActiveE(0)
        --go.obj_noGet:SetActiveE(1)
        go.gameObject:SetActiveE(1)
        self.go_table["obj_mask" .. index]:SetActiveE(1)
    end

    -- 创建奖励item
    -- 获取奖励数据
    local data = self.model:GetSignItem(count)
    if not self.awardItemList[index] then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            data,
            go.obj_awards,
            function(item)
                if _G.IsNil(go.obj_awards) then
                    _G.DestroyObject(item.gameObject)
                    return
                end
                self.awardItemList[index] = item
                item.gameObject:SetLocalScaleXYZ(0.8)
                item:ShowEffect(not isGou and count <= self.signInDays)
                if item.ShowNumText then
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end
                item:SetGou(isGou)
            end,
            function(go, isOn)
                local sid = data[1] ~= 0 and data[1] or data[4]
                require("CommonTipManager"):GetInstance():OpenTip(go.gameObject, sid)
            end
        )
    else
        local item = self.awardItemList[index]
        local info 
        if data[1] ~= 0 then 
            info = _G.StorageManager:GetInstance():GetItemDataClass(data[1], data[2], {})
        else 
            info = _G.StorageManager:GetInstance():GetItemDataClass(data[4], data[5], {})
        end
        item:UpdateData(item.gameObject, info)
        item:UpdateFunction()
        if item.ShowNumText then
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
        item:SetGou(isGou)
        item:ShowEffect(not isGou and count <= self.signInDays)
    end
end

---点击页签获得签到奖励
---@param index number 页签索引
function MTSignInView:OnClickItemAward(index, go)
    local count = index + (self.page - 1) * 7
    if count < 1 or count > self.count then
        return
    end
    local fisrt = (self.page - 1) * 7 + 1
    local T = {}
    for i = fisrt, fisrt + 6 do 
        if i <= self.signInDays and not self.model:CheckSignId(i) then 
            table.insert(T, i)
        end
    end

    self:GetSignInAward(T, function()
        self:RefreshView()
    end)
end

---获取签到奖励
---@param index number 第几天的奖励
function MTSignInView:GetSignInAward(indexT, callback)
    -- 向后端发送签到请求
    -- 执行回调
    self.model:GetSignAwardT(indexT, function()
        if callback then
            callback()
        end
    end)
end

function MTSignInView:UpdateTimer()
    local time = self.endTime - _G.TimeUtil.GetServerUnixTime()
    if time <= 0 then
        self.timer:Stop()
        self.timer = nil
        return
    end
    self.go_table.aortext_time.text = _G.GetLangPackValue(90034501003, _G.TimeUtil.TranslateSecondForStr(time))
end

---界面的销毁函数
function MTSignInView:OnDestroy()
    _G.Events:RemoveListener(_G.eSixUpdate.SixClockUpdate,self.SixRefresh,self)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function MTSignInView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        if self.closeCall then 
            self.closeCall()
        end
        self:Close()
    elseif go == self.go_table.aorbtn_qiehuan1 then
        -- 左
        if self.page > 1 then
            self.page = self.page - 1
            self:RefreshView()
        end
    elseif go == self.go_table.aorbtn_qiehuan2 then
        -- 右
        if self.page < self.maxPage then
            self.page = self.page + 1
            self:RefreshView()
        end
    end
end

return MTSignInView