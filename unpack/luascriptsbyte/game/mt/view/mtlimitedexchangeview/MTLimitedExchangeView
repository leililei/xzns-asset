function MTLimitedExchangeView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView, self)
end

---界面的入口函数
function MTLimitedExchangeView:OnCreate(activity)
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.FirstMTLimitedEx, 0) == 0 then 
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTLimitedExchangDesView.Name, activity)
    end
    self.itemList = {}
    self.exchangeNum = {}
    self.activity = activity
    self.activitySynModel = self.activity:GetActivityTypeCls()
    self.nowChooseIndex = 1
    self.showObj = {}
    for i = 1, 4 do
        self.showObj[i] = _G.GetAutoGoTable(self.go_table["obj_show" .. i])
    end

    self.animator = self.go_table.obj_root:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
    self.animator.enabled = false

    self:InitView(activity)
    self:InitTime()
    self:ShowRole()
    self.go_table.aortext_Desc.text = activity.cfg.info.title
    self.languageStr = {}
    for i = 1, 4 do
        self.languageStr[i] = { self.itemDatas[i].description, self.activity.typeClass.bubbleSwitchStr[1] }
    end
    self.languageStr[5] = {}
    for k, v in ipairs(self.activity.typeClass.bubbleStr) do
        table.insert(self.languageStr[5], v)
    end
    bubble_continuous = self.activity.typeClass.bubbleTime1
    self.bubbleIndex = 1
    self.BubbleRect1 = self.go_table.aorimage_bubble1.gameObject:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
    self:ShowBubble(5)
    --self:FreshBtnTxt()
    self:FreshDropBtn()
end

function MTLimitedExchangeView:FreshDropBtn()
    local subType = self.activity:GetJumpType()
    local act = ActivitySynManager:GetInstance():GetChildAcitivity(10052, subType)
    if act then
        self.go_table.aorbtn_drop:SetActiveE(1)
    else
        self.go_table.aorbtn_drop:SetActiveE(0)
    end
end

function MTLimitedExchangeView:FreshBtnTxt(times)
    times = times or 10
    self.go_table.aortext_PropLeftNumDesc.text =
        _G.GetLangPackValue(90034521006, _G.GameUtil.NumberToWordByLanguage(1))
    self.go_table.aortext_PropRightNumDesc.text =
        _G.GetLangPackValue(90034521029, _G.GameUtil.NumberToWordByLanguage(times))
end

function MTLimitedExchangeView:InitView(activity)
    activity:GetActivityTypeCls():RefreshRedPointExchange()
    self:RefreshView(true)
    local res = self.activitySynModel:GetResources()
    self:AddComponent(self.go_table.obj_goldInfo1,
        require("ResourceCompont").New(self.go_table.obj_goldInfo1, { res[1], res[2] }))
    if res[3] then
        self:AddComponent(self.go_table.obj_goldInfo2,
            require("ResourceCompont").New(self.go_table.obj_goldInfo2, { res[3], res[4] }))
    end

    if activity.cfg.info.front.gift_group_show then
        ---@type activity.i_gift_group_show
        local show = activity.cfg.info.front.gift_group_show
        for _, v in pairs(show.images) do
            local imgTb, pos
            pos = _G.string.split(v.xyz, "#")
            if v.index == 1 then
                imgTb = self.go_table.aorrawimage_Bg
            elseif v.index == 2 then
                imgTb = self.go_table.aorrawimage_desk
            end
            imgTb:LoadImage(
                v.path,
                function()
                    if self:IsNil() then
                        return
                    end
                    imgTb:SetNativeSize()
                    imgTb:SetLocalScaleXYZ(v.size / 10000)
                    imgTb:SetLocalPosition(
                        _G.tonumber(pos[1]),
                        _G.tonumber(pos[2]),
                        _G.tonumber(pos[3])
                    )
                end
            )
        end
    end
end

function MTLimitedExchangeView:InitTime()
    self:ZanDouTimer()
    if self.timeShengYus == nil then
        self.timeShengYus = _G.TimerManager:GetInstance():GetTimer(1, self.ZanDouTimer, self, false, false, true)
        self.timeShengYus:Start()
    end
end

---倒计时
function MTLimitedExchangeView:ZanDouTimer()
    local nowTime = _G.TimeUtil.GetServerUnixTime()
    local timeShengYu = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - nowTime
    if timeShengYu <= 0 then
        self.go_table.aortext_time.text = ""
        self:Close()
    else
        self.go_table.aortext_time.text =
            _G.GetLangPackValue(90029300004, _G.TimeUtil.TranslateSecondForStrMiaoHui(timeShengYu, 1))
    end
end

function MTLimitedExchangeView:FreshRedPoint()
    self.tempIndex = 1
    for k, v in pairs(self.itemDatas) do
        local haveBol = true
        for key, value in ipairs(v.consumes) do
            local needItem = value and value.type or {}
            local haveCount
            local needCount
            if self.activity:GetJumpType() and needItem[1] == 0 then
                haveCount = self.activity.typeClass:GetCoinNum(needItem[2], needItem[3], needItem[4])
                needCount = needItem[5]
            else
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
                haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
                needCount = needItem[2]
            end
            if not haveCount or haveCount == 0 then
                haveCount = _G.StorageManager:GetInstance():GetOtherItemCountBySid(needItem[4]) or 0
            end

            if haveCount < needCount then
                haveBol = false
            end
        end
        if haveBol and v.exchangeTimes < v.count_limit and v.isGou > 0 then
            self.shopItemObj[k].obj_redpoint:SetActiveE(1)
            self.tempIndex = k
        else
            self.shopItemObj[k].obj_redpoint:SetActiveE(0)
        end
    end
end

function MTLimitedExchangeView:FreshCoin()
    for k, v in pairs(self.activitySynModel:GetResources()) do
        local tmp = {}
        _G.table.insert(tmp, v)
        _G.table.insert(tmp, 0)
        _G.Events:GetInstance():Broadcast(_G.eItemUpdata.Updata, { { type = tmp } })
    end
end

--显示对话泡泡
function MTLimitedExchangeView:ShowBubble(index)
    self.bubbleIndex = 1
    self.nowBubbleType = index
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self.BubbleRect1:SetActiveE(1)
    self.bubbleTimer = nil
    self.Timer = nil
    self.go_table.aorimage_bubble1:SetActiveE(1)
    --self.curBubbles = _G.DeepCopyCfgTable(bubble_chat1)
    self:PlayBubbleDialog()
    self.bubbleTimer =
        _G.TimerManager:GetInstance():GetTimer(
            bubble_continuous + 1,
            self.PlayBubbleDialog,
            self
        )
    self.bubbleTimer:Start()
end

function MTLimitedExchangeView:PlayBubbleDialog()
    if self.Timer then
        self.Timer:Stop()
        self.Timer = nil
    end
    self.BubbleRect1:SetLocalScaleXYZ(0)
    self.BubbleRect1:DOScale(1, 1, 1, 0.4)
    self.go_table.aortext_bubble1.text = _G.GetLangPackValue(self.languageStr[self.nowBubbleType][self.bubbleIndex])
    if self.bubbleIndex == #self.languageStr[self.nowBubbleType] then
        self.Timer = _G.TimerManager:GetInstance():GetTimer(bubble_continuous, self.GetTimerCallBackFinal, self)
    else
        self.bubbleIndex = self.bubbleIndex + 1
        self.Timer = _G.TimerManager:GetInstance():GetTimer(bubble_continuous, self.GetTimerCallBack, self)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_bubble1.gameObject)

    self.Timer:Start()
end

function MTLimitedExchangeView:GetTimerCallBackFinal()
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
    end
    self.BubbleRect1:DOScale(0, 0, 0, 0.4):OnComplete(
        function()
            _G.DelayDo(1, function()
                if self.go_table == nil then
                    return
                end
                self:ShowBubble(5)
            end)
        end
    )
end

function MTLimitedExchangeView:GetTimerCallBack()
    self.BubbleRect1:DOScale(0, 0, 0, 0.4):OnComplete(_G.handler(self, self.GetTimerCallBack1))
end

