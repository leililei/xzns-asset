function MTLimitedExchangeView:RefreshView(initBol, data)
    local delaytime = 1.2
    local info = _G.ConfigManager.discrete_cfg[135011]
    local itemIndex = 0
    if data then
        for i = 1, #data.award.item do
            local iteminfo = data.award.item[i]
            for j = 1, #info do
                if info[j][1] == iteminfo.type[1] and info[j][2] == iteminfo.type[2] then
                    itemIndex = j
                    break
                end
            end
        end
        local playname = "ani_Draw_1"
        if itemIndex > 0 then
            playname = "ani_Draw_2"
        end

        self.animator.enabled = false
        self.animator.enabled = true
        self.animator:Play(playname, 0, 0)
        self.clickDrawBtnBol = true
        self.animDelay = _G.DelayDo(delaytime, function()
            if data.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(data)
                require "CommonTipManager".OpenCommonAwardView(data)
            end
            self.activitySynModel:RefreshRedPointExchange()

            self.itemDatas = self.activitySynModel:GetCurActivitySelfData()
            --self:Sortfunc(self.itemDatas)
            self.chooseObj = {}
            self.shopItemObj = {}
            for i = 1, 4 do
                self:RefreshItem(i)
            end
            self:FreshRedPoint()
            if initBol then
                self.nowChooseIndex = self.tempIndex
                self.go_table.aorrawimage_chooseIma:LoadImage(self.itemDatas[self.nowChooseIndex].icon,
                    function(img)
                        if img then
                            img:SetNativeSize()
                        end
                    end
                )
            end
            self:ShowItemBtn(self.nowChooseIndex)
            self:FreshCoin()
            self.animator.enabled = false
            self.clickDrawBtnBol = nil
        end)
    else
        self.itemDatas = self.activitySynModel:GetCurActivitySelfData()
        --self:Sortfunc(self.itemDatas)
        self.chooseObj = {}
        self.shopItemObj = {}
        for i = 1, 4 do
            self:RefreshItem(i)
        end
        self:FreshRedPoint()
        if initBol then
            self.nowChooseIndex = self.tempIndex
            self.go_table.aorrawimage_chooseIma:LoadImage(self.itemDatas[self.nowChooseIndex].icon,
                function(img)
                    if img then
                        img:SetNativeSize()
                    end
                end
            )
        end
        self:ShowItemBtn(self.nowChooseIndex)
        self:FreshCoin()
    end
    self:ShowExchangeTips()
end

