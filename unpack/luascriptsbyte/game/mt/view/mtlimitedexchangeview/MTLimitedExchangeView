function MTLimitedExchangeView:OnExchange(_data, index)
    if self.clickDrawBtnBol then 
        return 
    end
    if _data and _data.consumes then
        local exchangeNum = _data.count_limit - _data.exchangeTimes
        if exchangeNum <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipId.limitCount)
            return
        else
            if self.exchangeNum[index] > 0 then 
                exchangeNum = self.exchangeNum[index]
            else 
                _G.PopWindowManager:GetInstance():ShowAllTips(tipId.noItem)
                return
            end
        end
        local nowtime = _G.TimeUtil.GetServerUnixTime()
        local savetime1 = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips1)
        local savetime2 = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips2)
        local todayTime = _G.TimeUtil.GetDayBySix(nowtime)
        local isChoose1 = savetime1 == todayTime
        local isChoose2 = savetime2 == todayTime
        if not isChoose1 and self.nowChooseIndex ~= 4 and self.shopItemObj[4].obj_redpoint:GetActiveSelf() == 1 then
            local sure = function(isChoose)
                if isChoose then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips1, todayTime)
                end
                self:ClickItemBtn(nil, nil, 4)
            end
            local cancle = function(isChoose)
                if isChoose then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips1, todayTime)
                end
                self.activity.typeClass:ExchangeNew(_data, _G.handler(self, self.RefreshView), exchangeNum)
            end
            _G.PopWindowManager:GetInstance():ShowAllTipsExtend(
                1160002,
                nil,
                sure,
                cancle,
                nil,
                nil,
                { notCall = true, cancleToggleBol = true}
            )
        elseif  not isChoose2 and self.nowChooseIndex < 3 and self.shopItemObj[3].obj_redpoint:GetActiveSelf() == 1 then
            local sure = function(isChoose)
                if isChoose then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips2, todayTime)
                end
                self:ClickItemBtn(nil, nil, 3)
            end
            local cancle = function(isChoose)
                if isChoose then
                    _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.MTLimitedExchangeTips2, todayTime)
                end
                self.activity.typeClass:ExchangeNew(_data, _G.handler(self, self.RefreshView), exchangeNum)
            end
            _G.PopWindowManager:GetInstance():ShowAllTipsExtend(
                1160004,
                nil,
                sure,
                cancle,
                nil,
                nil,
                { notCall = true, cancleToggleBol = true}
            )
        else 
            self.activity.typeClass:ExchangeNew(_data, _G.handler(self, self.RefreshView), exchangeNum)
        end
    else
        self.activity.typeClass:ExchangeNew(_data, _G.handler(self, self.RefreshView), 1)
    end
end

function MTLimitedExchangeView:ClickItemBtn(go, _, index)
    if not self.activity:CheckActivityInteractable() then
        return
    end
    self:ShowBubble(index)
    if index == self.nowChooseIndex then
        return
    end
    self.nowChooseIndex = index
    self:ShowItemBtn(index)
    _G.GameUtil.ReBuildRTF(self.go_table.obj_itemRoot)
end

function MTLimitedExchangeView:ShowExchangeTips()
    local nowtime = _G.TimeUtil.GetServerUnixTime()
    local endTime = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time
    if endTime - nowtime < 86400 then 
        self.go_table.obj_tips1:SetActiveE(0)
        self.go_table.obj_tips2:SetActiveE(0)
    elseif self:GetExchangeNum(2) >= 50 and self.shopItemObj[3].obj_redpoint:GetActiveSelf() ~= 1 and self.shopItemObj[4].obj_redpoint:GetActiveSelf() ~= 1 then  
        self.go_table.obj_tips1:SetActiveE(0)
        self.go_table.obj_tips2:SetActiveE(1)
    elseif self:GetExchangeNum(1) >= 50 and self.shopItemObj[3].obj_redpoint:GetActiveSelf() ~= 1 and self.shopItemObj[4].obj_redpoint:GetActiveSelf() ~= 1 then 
        self.go_table.obj_tips1:SetActiveE(1)
        self.go_table.obj_tips2:SetActiveE(0) 
    else 
        self.go_table.obj_tips1:SetActiveE(0)
        self.go_table.obj_tips2:SetActiveE(0)
    end
end

function MTLimitedExchangeView:GetExchangeNum(index)
    self.exchangeNum[index] = self.itemDatas[index].count_limit - self.itemDatas[index].exchangeTimes
    for k, v in pairs(self.itemDatas[index].consumes) do
        local needItem = v.type or {}
        local haveCount
        local needCount
        if needItem[1] == 0 then
            haveCount = _G.StorageManager:GetInstance():GetActivityItemCountByID(needItem[2], needItem[3],
                needItem[4])
            needCount = needItem[5]
        else
            local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
            haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
            needCount = needItem[2]
        end
        if haveCount < needCount then
            self.exchangeNum[index] = 0
        else
            self.exchangeNum[index] = self.exchangeNum[index] and math.min(self.exchangeNum[index], math.floor(haveCount / needCount)) or
                math.floor(haveCount / needCount)
            if self.exchangeNum[index] >= 50 then 
                self.exchangeNum[index] = 50
            elseif self.exchangeNum[index] < 50 and self.exchangeNum[index] >= 10 then 
                self.exchangeNum[index] = 10
            else 
                self.exchangeNum[index] = 1
            end 
        end
    end
    return self.exchangeNum[index]
end

function MTLimitedExchangeView:ShowItemBtn(index)
    local itemNum = 1
    if self.itemDatas[index] and self.itemDatas[index].consumes then
        itemNum = #self.itemDatas[index].consumes
    end
    self:GetExchangeNum(index)
    local num = self.exchangeNum[index] == 0 and 1 or self.exchangeNum[index]
    self.go_table.aortext_PropRightNumDesc.text = _G.GetLangPackValue(90034521029, num)
    for i = 1, 4 do
        self.chooseObj[i]:SetActiveE(i == index and 1 or 0)
        self.showObj[i].gameObject:SetActiveE(i == index and 1 or 0)
        self.go_table["obj_show" .. i]:SetActiveE(i == itemNum and 1 or 0)
        self.shopItemObj[i].gameObject:SetLocalScaleXYZ(i == index and 1 or 0.9)
    end
    local tb = _G.GetAutoGoTable(self.go_table["obj_show" .. itemNum])
    for i = 1, itemNum do
        self:CreateItem(tb["obj_item" .. i], self.itemDatas[index].consumes[i].type, false, 0.7)
    end
    if self:CheckAwardIsDropID(self.itemDatas[index].award[1].type[1]) then
        local T1, T2 = self:GetAwardTByDropID(self.itemDatas[index].award[1].type[1])
        self.dropItemData = T2
        self:CreateItem(self.go_table.obj_mustItem, T1[1], false, 0.8)
        self.go_table.obj_loopList:SetActiveE(1)
        if not self.IsFirst then
            self.go_table.looplist2_item:InitListView(#T2, _G.handler(self, self.RefreshList))
            self.IsFirst = true
        end
        self.go_table.looplist2_item:SetListItemCount(#T2, true)
        self.go_table.looplist2_item:RefreshAllShownItem()
        self.go_table.looplist2_item:MovePanelToItemIndex(0)
    else
        self:CreateItem(self.go_table.obj_mustItem, self.itemDatas[index].award[1])
        self.go_table.obj_loopList:SetActiveE(0)
    end
    self.go_table.aorrawimage_chooseIma:LoadImage(self.itemDatas[index].icon,
        function(img)
            if img then
                img:SetNativeSize()
            end
        end
    )
end

function MTLimitedExchangeView:CreateItem(parentObj, array, notShowNum, size)
    parentObj:RemoveAllChildren()
    if array and #array > 0 then
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            array,
            parentObj,
            function(tran)
                if self:IsNil() then
                    _G.DestroyObject(tran)
                    return
                end
                if not notShowNum then
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                end
                if size then
                    tran.gameObject:SetLocalScaleXYZ(size)
                end
            end
        )
    end
end

---刷新列表
function MTLimitedExchangeView:RefreshList(listView2, index)
    if index < 0 then
        return
    end
    local data = self.dropItemData[index + 1]
    local item = listView2:NewListViewItem("$_obj_ListItem")
    local tb = _G.GetAutoGoTable(item)
    self:CreateItem(tb.gameObject, data, false, 0.8)
    return item
end

function MTLimitedExchangeView:CheckAwardIsDropID(Sid)
    while (Sid > 10) do
        Sid = Sid / 10
    end
    Sid = _G.math.floor(Sid)
    return Sid == 6
end

function MTLimitedExchangeView:GetAwardTByDropID(id)
    local cfg = _G.ConfigManager.drop_cfg[id]
    local T1, T2 = {}, {}
    for k, v in pairs(cfg.fixed_drop) do
        table.insert(T1, v)
    end
    for k, v in pairs(cfg.content1) do
        table.insert(T2, v)
    end
    for k, v in pairs(cfg.content2) do
        table.insert(T2, v)
    end
    return T1, T2
end

---界面的销毁函数
function MTLimitedExchangeView:OnDestroy()
    if self.animDelay then
        _G.coroutine.stopwaiting(self.animDelay)
        self.animDelay = nil
    end
    if self.timeShengYus then
        self.timeShengYus:Stop()
        self.timeShengYus = nil
    end
    if self.Timer ~= nil then
        self.Timer:Stop()
        self.Timer = nil
    end
    if self.bubbleTimer ~= nil then
        self.bubbleTimer:Stop()
        self.bubbleTimer = nil
    end
    self.clickDrawBtnBol = nil
    _G.Events:GetInstance():RemoveListener(_G.eSixUpdate.SixClockUpdate, self.RefreshView, self)
end

function MTLimitedExchangeView:CloseView()
    self:Close()
end

function MTLimitedExchangeView:OnClickGoBtn()
    if not self.activity:CheckActivityInteractable() then
        return
    end
    local subType = self.activity:GetJumpType()
    local act = ActivitySynManager:GetInstance():GetChildAcitivity(10052, subType)
    if act then
        act.typeClass:OnEnterActivity()
    end
end

function MTLimitedExchangeView:ShowRole()
    if not string.IsNullOrEmpty(self.activity.typeClass.roleStr) then
        _G.UIUtils.LoadEffectByPath(self.activity.typeClass.roleStr, self.go_table.obj_role,
            function(trans)
                if self:IsNil() then
                    _G.DestroyObject(trans)
                    return
                end
                local pos = self.activity.typeClass.rolePos or { 0, 0, 0, 1 }
                trans.gameObject:SetLocalScaleXYZ(pos[4])
                trans.gameObject:SetLocalPosition(pos[1], pos[2], pos[3])
            end)
    else
        local cardSid = 111010000
        local cfg = _G.ConfigManager.card_cfg[cardSid]
        _G.PoolsManager:GetInstance():Spawn(
            cfg.ModelPathHi,
            _G.ePoolType.UIItem,
            self.go_table.obj_role,
            function(trans)
                if self:IsNil() then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIItem)
                    return
                end
                trans.gameObject:SetLocalScaleXYZ(cfg.size2)
                trans.gameObject:SetLocalPosition(_G.table.unpack(cfg.pos_portrait))
            end
        )
    end
end

function MTLimitedExchangeView:OpenTips()
    ---打开玩法说明页面
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.MTLimitedExchangDesView.Name, self.activity)
end

---按钮点击事件在这里派发
function MTLimitedExchangeView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_drop then
        self:OnClickGoBtn()
    elseif go == self.go_table.aorbtn_tips then
        self:OpenTips()
    elseif go == self.go_table.aorbtn_DrawOnce then
        self:OnExchange(self.itemDatas[self.nowChooseIndex], self.nowChooseIndex)
    elseif go == self.go_table.aorbtn_DrawTenTimes then
        self:OnExchange(self.itemDatas[self.nowChooseIndex], self.nowChooseIndex)
    end
end

return MTLimitedExchangeView
