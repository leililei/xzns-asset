local DecorationBossModel = require "DecorationBossModel"

---@class DecorationBossAttentionView : UIBaseView	中文描述
---@field public go_table DecorationBossAttentionView_GoTable GoTable
local DecorationBossAttentionView = _G.BaseClass("DecorationBossAttentionView", _G.UIBaseView)

function DecorationBossAttentionView:Awake()
    self.ItemList = {}
    self.ItemTimeList = {}
    self.DifficultyItems = {}
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossAttentionView:OnCreate()
    self.go_table.scrollloopvectical_list:InitItemData(0, _G.handler(self, self.OnRefreshLoopListItem))
    self:InitView()
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime()
    end
end

function DecorationBossAttentionView:InitView()
    self.AttentionList = DecorationBossModel:GetInstance():GetAttention()
    _G.table.sort(self.AttentionList, function(a, b)
        return a > b
    end)
    self.go_table.scrollloopvectical_list:UpdateCount(#self.AttentionList)
    self.go_table.obj_IsNil:SetActiveE(#self.AttentionList > 0 and 0 or 1)
end

function DecorationBossAttentionView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type DecorationBossBoxView._obj_SociatyItem_GoTable
    local ctrl = self.ItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.ItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.AttentionList[eIndex]
    ctrl.data = data
    local cfg = _G.ConfigManager.decoration_boss_cfg[data]
    local bossCfg = _G.ConfigManager.card_cfg[cfg.preview_monster]
    ctrl.aortext_name.text = _G.LangUtil.GetLangPackValue(bossCfg.Name)
    ctrl.aortext_lv.text = _G.LangUtil.GetLangPackValue(90031900006, cfg.boss_lv)
    local path = "Images/zRoles/" .. bossCfg.Icon
    ctrl.aorrawimage_icon:LoadImage(path)
    ---奖励预览
    local dataReward = _G.ConfigManager.decoration_limit_cfg[cfg.difficulty].preview_reward
    -- ctrl.obj_awards:ClearChildren()
    -- for _, sid in pairs(cfgReward.preview_reward) do
    --     ---@param item BaseAwardNewItem
    --     _G.StorageManager:GetInstance():GetItemBaseViewNew(
    --         { sid },
    --         ctrl.obj_awards,
    --         function(v)
    --             if _G.IsNil(ctrl.obj_awards) then
    --                 _G.DestroyObject(v.gameObject)
    --                 return
    --             end
    --             v.gameObject:SetRectTransformSize(80, 80)
    --             v.gameObject:SetLocalScaleXYZ(0.8)
    --             --v:ShowEffect(v.cfg.ef_item == 1 and true or false)
    --         end
    --     )
    -- end
    ctrl.dataReward = dataReward
    if self.DifficultyItems[id] == nil then
        self.DifficultyItems[id] = {}
        ctrl.scrollloophorizontal_Award:InitItemData(
        #dataReward,
        _G.handler(self, function(_,i2, trans)
            local newIndex = i2 + 1
            local instanceID = trans:GetInstanceIDE()
            local sid = ctrl.dataReward[newIndex]
            local itemReward = self.DifficultyItems[id][instanceID]
            if not itemReward then
                itemReward = require "BaseAwardNewItem".New(trans, nil, 88, trans)
                self.DifficultyItems[id][instanceID] = itemReward
            end
            local dataItem = _G.StorageManager:GetInstance():GetItemDataClass(sid, 0)
            itemReward:Show(dataItem)
        end)
    )
    else
        ctrl.scrollloophorizontal_Award:UpdateCount(#dataReward)
    end

    local state, time = DecorationBossModel:GetInstance():GetBossState(data)
    local bossStateEnum = DecorationBossModel:GetInstance().bossStateEnum
    ctrl.obj_rank:SetActiveE(state == bossStateEnum.Fighting and 1 or 0)
    ctrl.obj_time:SetActiveE(state ~= bossStateEnum.Fighting and 1 or 0)
    if state == bossStateEnum.NotArrived then
        ctrl.aortext_timeDes.text = _G.GetLangPackValue(90031900028)
    elseif state == bossStateEnum.Reviving then
        ctrl.aortext_timeDes.text = _G.GetLangPackValue(90031900027)
    elseif state == bossStateEnum.Fighting then
        local bossInfo = DecorationBossModel:GetInstance():GetBossData(data)
        local num = bossInfo and bossInfo.num or 0
        ctrl.aortext_num.text = num
    end
    ---boss状态计时器
    if time > 0 then
        ctrl.time = time
        ctrl.item = item
        ctrl.i = i
        if self.ItemTimeList[data] == nil then
            self.ItemTimeList[data] = ctrl
        end
    else
        self.ItemTimeList[data] = nil
    end
    return item
end

function DecorationBossAttentionView:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    for k, v in pairs(self.ItemTimeList) do
        if v.time - serverTime >= 0 then
            v.aortext_time.text = _G.TimeUtil.TimeToString(v.time - serverTime, 1)
        else
            self:OnRefreshLoopListItem(v.i, v.item)
        end
    end
end

function DecorationBossAttentionView:OnItemClickBtn(go, _, ctrl)
    if go == ctrl.aorbtn_attention then
        DecorationBossModel:GetInstance():AttentionBoss(ctrl.data, 2, function()
            self:InitView()
        end)
    elseif go == ctrl.aorbtn_go then
        local bossCfg = _G.ConfigManager.decoration_boss_cfg[ctrl.data]
        local cfg = _G.ConfigManager.decoration_limit_cfg[bossCfg.difficulty]
        if not _G.GlobalConditionManager.CheckCondition(cfg.limit_condition[1], cfg.limit_condition[2]) then
            _G.PopWindowManager:GetInstance():ShowAllTips(960101)
            return
        end
        local cfgBoss = _G.ConfigManager.decoration_boss_cfg[ctrl.data]
        DecorationBossModel:GetInstance():EnterBossBattleView(cfgBoss)
        self:Close()
    end
end

---界面的销毁函数
function DecorationBossAttentionView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function DecorationBossAttentionView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return DecorationBossAttentionView
