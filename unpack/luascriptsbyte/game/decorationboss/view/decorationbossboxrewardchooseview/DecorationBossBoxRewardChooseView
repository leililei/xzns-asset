local DecorationBossModel = require "DecorationBossModel"
local CommonTipManager = require "CommonTipManager"
---@class DecorationBossBoxRewardChooseView : UIBaseView	中文描述
---@field public go_table DecorationBossBoxRewardChooseView_GoTable GoTable
local DecorationBossBoxRewardChooseView = _G.BaseClass("DecorationBossBoxRewardChooseView", _G.UIBaseView)

function DecorationBossBoxRewardChooseView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.BoxItemList = {}
    self.DifficultyItems = {}
end

---界面的入口函数
function DecorationBossBoxRewardChooseView:OnCreate(data)
    self.chooseIndex = data.index
    self.data = data
    self.boxReward = _G.ConfigManager.decoration_box_cfg[self.data.box_sid].preview
    -- self.go_table.scrollloopvectical_memberList:InitItemData(
    --     #self.boxReward,
    --     _G.handler(self, self.RefreshBoxAward)
    -- )
    for i = 1, #self.boxReward do
        local obj = _G.InstantiateObject(self.go_table.obj_item, self.go_table.obj_itemRoot)
        obj:SetActiveE(1)
        --obj:SetLocalPosition(0,0,0)
        self:RefreshBoxAward(i, obj)
    end
end

---刷新奖励显示
function DecorationBossBoxRewardChooseView:RefreshBoxAward(index, trans)
    local ctrl = self.BoxItemList[index]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(trans)
        _G.AddViewBtnClick(trans, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.BoxItemList[index] = ctrl
    end
    local dataReward = self.boxReward[index]
    ctrl.index = index
    if self.DifficultyItems[index] == nil then
        self.DifficultyItems[index] = {}
    end
    ctrl.scrollloophorizontal_Award:InitItemData(
        #dataReward,
        _G.handler(self, function(_,i, trans)
            local newIndex = i + 1
            local instanceID = trans:GetInstanceIDE()
            local data = dataReward[newIndex]
            local item = self.DifficultyItems[index][instanceID]
            if not item then
                item = require "BaseAwardNewItem".New(trans, _G.handler(self, self.OnClickAward), 88, trans)
                self.DifficultyItems[index][instanceID] = item
            end
            local data = _G.StorageManager:GetInstance():GetItemDataClass(data, 0)
            item:Show(data)
            item:ShowEffect(item.data.cfg.ef_item == 1 and true or false)
            item.pIndex = index
            item.pCtrl = ctrl
        end)
    )
    if self.chooseIndex == index then
        _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, true)
        self.ChooseGoTable = ctrl
    else
        _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, false)
    end
end

---点击奖励回调
function DecorationBossBoxRewardChooseView:OnClickAward(tb)
    if tb.pIndex == self.chooseIndex then
        CommonTipManager:GetInstance():OpenTip(tb.gameObject, tb.data.sid)
    else
        self:OnItemClickBtn(_, _, tb.pCtrl)
    end
end

---点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function DecorationBossBoxRewardChooseView:OnItemClickBtn(_, _, tb)
    self.chooseIndex = tb and tb.index or self.chooseIndex
    if self.ChooseGoTable then
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorimage_choose, false)
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorbtn_click, true)
    end
    self.ChooseGoTable = tb and tb or self.ChooseGoTable
    if self.ChooseGoTable then
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorimage_choose, true)
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorbtn_click, false)
    end
end

---界面的销毁函数
function DecorationBossBoxRewardChooseView:OnDestroy()
end

---按钮点击事件在这里派发
function DecorationBossBoxRewardChooseView:OnClickBtn(go)
    if go == self.go_table.aorbtn_sure then
        if self.chooseIndex ~= self.data.index then
            DecorationBossModel:GetInstance():ChooseBoxAward(self.data.box_sid, self.chooseIndex, function()
                self:Close()
            end)
        else
            self:Close()
        end
    elseif go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return DecorationBossBoxRewardChooseView