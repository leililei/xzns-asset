local DecorationBossModel = require "DecorationBossModel"

---@class DecorationBossRankView : UIBaseView	中文描述
---@field public go_table DecorationBossRankView_GoTable GoTable
local DecorationBossRankView = _G.BaseClass("DecorationBossRankView", _G.UIBaseView)


function DecorationBossRankView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.ItemList = {}
    self.rankList = {}
end

---界面的入口函数
function DecorationBossRankView:OnCreate(bossList)
    self.bossList = bossList
    self.go_table.scrollloopvectical_ItemList:InitItemData(0, _G.handler(self, self.OnRefreshLoopListItem))
    if self.bossList == nil or self.bossList and #self.bossList == 0 then
        return
    end
    self:InitView()
    self:AddListener(_G.eDecorationBoss.BossRevive, self.OnBossRevive)
end

---boss复活清除排行榜
function DecorationBossRankView:OnBossRevive(monsterId)
    for index, v in ipairs(self.bossList) do
        if monsterId and v.id == monsterId then
            self.rankList[index] = {}
            if self.curIndex == index then
                self:ShowRankByBossId()
            end
            break
        end
    end
end

function DecorationBossRankView:InitView()
    self.curIndex = 1
    for i = 1, 4 do
        local item = _G.GetAutoGoTable(self.go_table["toggle_info" .. i])
        local cfg = self.bossList[i]
        local bossCfg = _G.ConfigManager.card_cfg[cfg.preview_monster]
        item.aortext_name.text = _G.LangUtil.GetLangPackValue(bossCfg.Name)
        item.aortext_lv.text = _G.LangUtil.GetLangPackValue(90031900006, cfg.boss_lv)
        local path = "Images/zRoles/" .. bossCfg.Icon
        item.aorrawimage_icon:LoadImage(path)
    end
    self:ShowRankByBossId()
end

function DecorationBossRankView:ShowRankByBossId()
    if self.rankList[self.curIndex] == nil then
        self.rankList[self.curIndex] = {}
        local bossId = self.bossList[self.curIndex].id
        DecorationBossModel:GetInstance():GetRankInfo(bossId, 2, 1, function(msg)
            self.rankList[self.curIndex] = msg or {}
            self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.rankList[self.curIndex])
            self.go_table.obj_IsNil:SetActiveE(#self.rankList[self.curIndex] > 0 and 0 or 1)
            self.go_table.obj_have:SetActiveE(#self.rankList[self.curIndex] > 0 and 1 or 0)
        end)
    else
        self.go_table.scrollloopvectical_ItemList:UpdateCount(#self.rankList[self.curIndex])
        self.go_table.obj_IsNil:SetActiveE(#self.rankList[self.curIndex] > 0 and 0 or 1)
        self.go_table.obj_have:SetActiveE(#self.rankList[self.curIndex] > 0 and 1 or 0)
    end
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function DecorationBossRankView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end

    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type DecorationBossBoxView._obj_SociatyItem_GoTable
    local ctrl = self.ItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.ItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.rankList[self.curIndex][eIndex]
    ctrl.data = data
    ctrl.aorimage_rankBg:SetActiveE(eIndex <= 3 and 1 or 0)
    ctrl.obj_rankBg2:SetActiveE(eIndex <= 3 and 0 or 1)
    if eIndex <= 3 then
        ctrl.aorimage_rankBg.SpriteName = "tz_qjhs_di_0" .. (eIndex + 1)
        ctrl.aorimage_rank.SpriteName = "tz_qjhs_phb_mingci_0" .. eIndex
    else
        ctrl.aortext_rankNum.text = eIndex
    end
    _G.UIUtils.SetPlayerHeadItemNew(ctrl.obj_HeadItemBase, data.role_info, 0.6, true, true, true)
    ctrl.aortext_name.text = data.role_info.name

    ctrl.aortext_Power.text = _G.GameUtil.NumberToUnitStrFight(data.role_info.power)
    ctrl.aortext_num.text = _G.GameUtil.NumberToUnitStrFight(data.dps)
    --卡牌
    if ctrl.card then
        for i = 1, #ctrl.card do
            _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
        end
    end
    if data.array then
        if ctrl.card == nil then
            ctrl.card = {}
        end
        for i = 1, #data.array do
            local dataItem = data.array[i]
            if dataItem then
                if ctrl.card[i] then
                    ctrl.card[i]:Show(dataItem.sid, nil, dataItem.star, dataItem.soul_lv, dataItem.level)
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, true)
                else
                    local ItemCardFactory = _G.ItemCardFactory
                    ItemCardFactory:GetInstance():GetItemCard(
                        ItemCardFactory.itemCardType.CardAllItem,
                        ctrl.obj_teamRoot,
                        function(v)
                            ctrl.card[i] = v
                            ctrl.card[i]:Show(dataItem.sid, nil, dataItem.star, dataItem.soul_lv, dataItem.level)
                        end
                    )
                end
            else
                if ctrl.card[i] then
                    _G.GameUtil.SetActiveByCondition(ctrl.card[i].transform, false)
                end
            end
        end
    end
    return item
end

function DecorationBossRankView:OnItemClickBtn(go, _, ctrl)
    if go == ctrl.aorbtn_play then
        local ChangllengeView =
            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
        if ChangllengeView then
            ChangllengeView.View:Hide()
        end
        local DecorationBossMainView =
            _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
        if DecorationBossMainView then
            DecorationBossMainView.View:Hide()
        end
        -- local DecorationBossRankView =
        --     _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationBossRankView.Name)
        -- if DecorationBossRankView then
        --     DecorationBossRankView.View:Hide()
        -- end
        local bossId = self.bossList[self.curIndex].id
        DecorationBossModel:GetInstance():GetPlayBack(ctrl.data.role_info.uid, bossId, 2)
    end
end

---界面的销毁函数
function DecorationBossRankView:OnDestroy()
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function DecorationBossRankView:OnClickBtn(go)
    if go == self.go_table.toggle_info1 then
        self.curIndex = 1
        self:ShowRankByBossId()
    elseif go == self.go_table.toggle_info2 then
        self.curIndex = 2
        self:ShowRankByBossId()
    elseif go == self.go_table.toggle_info3 then
        self.curIndex = 3
        self:ShowRankByBossId()
    elseif go == self.go_table.toggle_info4 then
        self.curIndex = 4
        self:ShowRankByBossId()
    elseif go == self.go_table.aorbtn_close then
        self:Close()
    end
end

return DecorationBossRankView
