---初始化boss状态
function DecorationBossBattleView:InitBossState()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self:RefreshBossInfo()
    self.state, self.endTime = DecorationBossModel:GetInstance():GetBossState(self.config.id)
    self.go_table.obj_showTime:SetActiveE(
        self.state ~= self.bossStateEnum.Fighting and 1 or 0
    )
    self.go_table.aorbtn_battle:SetGray(self.state ~= self.bossStateEnum.Fighting)
    self.go_table.aorimage_battle:SetGray(self.state ~= self.bossStateEnum.Fighting)
    self.isNotArrived = self.state == self.bossStateEnum.NotArrived
    ---boss死亡后结算倒计时
    local monsterSid = DecorationBossModel:GetInstance():GetMonsterSid() or 0
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if monsterSid > 0 then
        local settleTime = _G.ConfigManager.discrete_cfg[115308][1][1]
        local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
        local lastEndTime = bossData.last_end_time or 0
        if bossData.fight_card or (lastEndTime > 0 and lastEndTime + settleTime - serverTime > 0) then
            self.settleTime = bossData.last_end_time + settleTime
            self.go_table.aorbtn_giveUp:SetActiveE(1)
        else
            self.go_table.aorbtn_giveUp:SetActiveE(0)
        end
    else
        self.go_table.aorbtn_giveUp:SetActiveE(0)
    end
    if self.endTime > 0 then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, true, true)
        self.timer:Start()
        self:UpdateTime()
    end

    if self.cdTimer then
        self.cdTimer:Stop()
        self.cdTimer = nil
    end
    local lastFightTime = DecorationBossModel:GetInstance():GetLastFightTime()
    local cd = _G.ConfigManager.discrete_cfg[115303][1][1]
    if lastFightTime and serverTime < lastFightTime + cd then
        ---挑战冷却中
        self.go_table.aorbtn_battle:SetGray(true)
        self.go_table.aorimage_battle:SetGray(true)
        self.cdTimer = _G.TimerManager:GetInstance():GetTimer(
            1,
            _G.handlerbind(self, self.RefreshCdTimer, lastFightTime, cd),
            self,
            false,
            false
        )
        self.cdTimer:Start()
        self:RefreshCdTimer(nil, nil, lastFightTime, cd)
    else
        self.go_table.aortext_cdTimer.text = ""
    end
end

function DecorationBossBattleView:RefreshCdTimer(_, _, lastFightTime, cd)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local leftTime = lastFightTime + cd - serverTime
    if leftTime > 0 then
        self.go_table.aortext_cdTimer.text = _G.GetLangPackValue(90031900042, leftTime)
    else
        local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
        if bossData.fight_card then
            self.go_table.aorbtn_battle:SetGray(false)
            self.go_table.aorimage_battle:SetGray(false)
        end
        self.go_table.aortext_cdTimer.text = ""
        if self.cdTimer then
            self.cdTimer:Stop()
            self.cdTimer = nil
        end
    end
end

---刷新boss信息
function DecorationBossBattleView:RefreshBossInfo()
    local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
    if bossData.fight_card then
        for _, v in pairs(bossData.fight_card) do
            local sid = _G.GameUtil.GetDivisionNumber(v.uid, 100)
            if _G.ConfigManager.monster_cfg[sid].MonsterType == 5 then
                local hp = v.hp or 0
                self.go_table.aortext_Slider.text = _G.GameUtil.FormatNum(hp / 100) .. "%"
                self.go_table.slider_hp.value = hp / 10000
                break
            end
        end
    else
        self.go_table.aortext_Slider.text = "0%"
        self.go_table.slider_hp.value = 0
        self.go_table.aorbtn_giveUp:SetActiveE(0)
    end
    local cardCfg = _G.ConfigManager.card_cfg[self.config.preview_monster]
    self.go_table.aorimage_head.SpriteName = cardCfg.Icon
end

---清除排行榜和排行榜的模型
function DecorationBossBattleView:ClearRank(isClearRank)
    if isClearRank then
        self.rankInfo = {}
        if self.rankListView then
            self.rankListView:UpdateCount(_G.Mathf.Max(#self.rankInfo, 3))
        end
    end
    self:ClearAllRoleModel()
    self.go_table.obj_effect:ClearChildren()
end

---boss死亡刷新
function DecorationBossBattleView:RefreshBossDeath()
    self:InitBossState()
    if self.rankInfo and #self.rankInfo > 0 then
        self:ClearRank()
    end
    ---boss死亡后再拉取一次排行榜数据
    self:UpdateBossInfo()
end

---boss死亡结算完成
function DecorationBossBattleView:BossAwardChange()
    local checkAward = DecorationBossModel:GetInstance():CheckCanGetAward()
    self.go_table.aorbtn_box:SetActiveE(checkAward and 1 or 0)
end

---挑战时间结束，刷新界面
function DecorationBossBattleView:BattleTimeEnd()
    self.go_table.aorbtn_giveUp:SetActiveE(0)
    self.go_table.aorbtn_battle:SetGray(true)
    self.go_table.aorimage_battle:SetGray(true)
    self:InitBossState()
end

---boss复活后清除排行榜
function DecorationBossBattleView:OnBossRevive(monsterId)
    if monsterId and monsterId == self.config.id then
        self:InitProtectTime()
        self:ClearRank(true)
        self.go_table.aorbtn_box:SetActiveE(0)
    end
end

function DecorationBossBattleView:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime - serverTime >= 0 then
        if self.isNotArrived then
            ---降临倒计时
            self.go_table.aortext_showTime.text = _G.GetLangPackValue(
                90031900008,
                _G.TimeUtil.TimeToString(self.endTime - serverTime, 1)
            )
        else
            if self.settleTime and self.settleTime - serverTime >= 0 then
                ---结算倒计时
                self.go_table.aortext_showTime.text = _G.GetLangPackValue(
                    90031900032,
                    _G.TimeUtil.TimeToString(self.settleTime - serverTime, 1)
                )
                self.go_table.aorbtn_giveUp:SetActiveE(self.settleTime - serverTime == 0 and 0 or 1)
            else
                ---复活倒计时
                self.go_table.aortext_showTime.text = _G.GetLangPackValue(
                    90031900007,
                    _G.TimeUtil.TimeToString(self.endTime - serverTime, 1)
                )
            end
        end
    else
        if self.isNotArrived then
            self:InitBossState()
        else
            if self.state == self.bossStateEnum.Reviving then
                ---boss已复活奖励邮件发放，不手动领取
                self.needRefreshMainView = true
                self:CloseView()
            end
        end
    end
end

---界面和场景的显隐
function DecorationBossBattleView:ChangeWindow(isShow)
    self.sceneRoot:SetActiveE(isShow and 1 or 0)
    if isShow then
        self:Show()
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    else
        self:Hide()
    end
end

---界面的销毁函数
function DecorationBossBattleView:Dispose()
    self:RemoveAllListener()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.cdTimer then
        self.cdTimer:Stop()
        self.cdTimer = nil
    end
    if self.protectTimer then
        self.protectTimer:Stop()
        self.protectTimer = nil
    end
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
    _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
    if self.curSceneTrans then
        if not self.clickBattleButton then
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
            self.clickBattleButton = false
        end
        _G.PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
    end
    if self.bossTrans then
        _G.PoolsManager:GetInstance():Despawn(self.bossTrans, _G.ePoolType.Temporary)
    end
    self.bossTrans = nil
    self:ClearAllRoleModel()
    self.curSceneTrans = nil
    self.sceneRoot:Dispose()
end

function DecorationBossBattleView:ClearAllRoleModel()
    if self.actionTimer then
        self.actionTimer:Stop()
        self.actionTimer = nil
    end
    if not self.curSceneTrans then
        return
    end
    for i = 1, 5 do
        if self.halo[i] then
            _G.PoolsManager:GetInstance():Despawn(self.halo[i], _G.ePoolType.Temporary)
        end
        if self.title[i] then
            _G.PoolsManager:GetInstance():Despawn(self.title[i].gameObject, _G.ePoolType.Temporary)
        end
    end
    for _, v in pairs(self.roleTrans) do
        _G.PoolsManager:GetInstance():Despawn(v, _G.ePoolType.Temporary)
    end
    for _, v in pairs(self.titleCor) do
        _G.coroutine.stopwaiting(v)
    end
    self.roleTrans = {}
    self.halo = {}
    self.title = {}
    self.titleCor = {}
end

function DecorationBossBattleView:CloseView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
    if view then
        local sid = DecorationBossModel:GetInstance():GetMonsterSid()
        if sid and sid == self.config.id then
            view:Close()
        else
            view:Show()
            view:RefreshBoss()
        end
    else
        if self.needRefreshMainView then
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
        end
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
    self:Close()
end

---按钮点击事件在这里派发
function DecorationBossBattleView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_battle then
        local state, _, isBefore = DecorationBossModel:GetInstance():GetBossState(self.config.id)
        if state == self.bossStateEnum.NotArrived then
            if isBefore then
                _G.PopWindowManager:GetInstance():ShowAllTips(960102)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(960103)
            end
            return
        end

        ---战斗
        if DecorationBossModel:GetInstance():GetLeftAwardTimes() == 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(960111)
            return
        end

        local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
        if not bossData.fight_card then
            ---首领已死亡
            _G.PopWindowManager:GetInstance():ShowAllTips(960109)
            return
        end

        local lastFightTime = DecorationBossModel:GetInstance():GetLastFightTime()
        local cd = _G.ConfigManager.discrete_cfg[115303][1][1]
        if lastFightTime and _G.TimeUtil.GetServerUnixTime() < lastFightTime + cd then
            ---挑战冷却中
            _G.PopWindowManager:GetInstance():ShowAllTips(960108)
            return
        end
        self.clickBattleButton = true
        require("DecorationBossController"):GetInstance():OpenEmbattle(self.config, false)
    elseif go == self.go_table.aorbtn_giveUp then
        ---放弃
        _G.PopWindowManager:GetInstance():ShowAllTips(960112, nil, function()
            self.settleTime = nil
            self.go_table.aorbtn_giveUp:SetActiveE(0)
            DecorationBossModel:GetInstance():GiveUpBoss(function()
                self.needRefreshMainView = true
                self:RefreshGiveUpRank()
            end)
        end)
    elseif go == self.go_table.aorbtn_award then
        self:OnClickRankItem(nil, nil, true)
    elseif go == self.go_table.aorbtn_box then
        if not DecorationBossModel:GetInstance():CheckCanGetAward() then
            _G.PopWindowManager:GetInstance():ShowAllTips(960114)
            return
        end
        DecorationBossModel:GetInstance():GetRankAward(function()
            self.needRefreshMainView = true
        end)
    elseif go == self.go_table.aorbtn_follow then
        local type = self.isAttention and 2 or 1
        DecorationBossModel:GetInstance():AttentionBoss(self.config.id, type, function()
            self:InitMechanics()
            if self.isAttention then
                _G.PopWindowManager:GetInstance():ShowAllTips(960104)
            else
                _G.PopWindowManager:GetInstance():ShowAllTips(960105)
            end
        end)
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 139)
    end
end

return DecorationBossBattleView
