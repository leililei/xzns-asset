---加载单个角色
---@param rolepath string 模型路径
---@param posIndex number 模型位置
function DecorationBossBattleView:InitRoleModel(rolepath, posIndex, roleInfo)
    if self.roleTrans[posIndex] then
        _G.PoolsManager:GetInstance():Despawn(self.roleTrans[posIndex], _G.ePoolType.Temporary)
        self.roleTrans[posIndex] = nil
    end
    _G.PoolsManager:GetInstance():Spawn(
        rolepath,
        _G.ePoolType.Temporary,
        nil,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("DecorationBossBattleView角色无法加载path:" .. rolepath)
                end
                return
            end
            if self:IsNil() or not self.curSceneTrans then
                _G.DestroyObject(trans)
                return
            end
            trans:SetParentE(self.sceneRoot)
            local pos = self.modelPosList[posIndex]
            trans:SetLocalPosition(pos[1], pos[2], pos[3])
            trans:SetLocalScaleXYZ(pos[4])
            local orientation = self.config.orientation[posIndex]
            trans:SetEulerAngles(orientation[1], orientation[2], orientation[3])
            local animComponent = _G.RoleAnimatorController.GetOrCreateAnimatorController(trans)
            self.roleComponent[posIndex] = animComponent
            self.roleTrans[posIndex] = trans
            local rolePoint = trans:GetComponentE(_G.typeof(_G.CS.RolePoint))
            if rolePoint == nil then
                rolePoint = trans:AddComponentE(_G.typeof(_G.CS.RolePoint))
            end
            -- self:UpdateTitle(posIndex, rolePoint, roleInfo)
            -- self:UpdateHalo(posIndex, rolePoint, roleInfo)
        end
    )
end

---称号
function DecorationBossBattleView:UpdateTitle(pos, rolePoint, roleInfo)
    local parent = self.roleTrans[pos]
    if not self.title[pos] or _G.IsNil(self.title[pos].gameObject) then
        if not roleInfo.title then
            return
        end
        _G.PoolsManager:GetInstance():Spawn(
            "CommonPrefab/World/Common_TitleWithDesignation",
            _G.ePoolType.Temporary,
            parent,
            function(trans)
                if _G.IsNil(parent) then
                    _G.DestroyObject(trans)
                    return
                end
                local go_table = _G.GetAutoGoTable(trans)
                trans:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
                self.title[pos] = go_table
                self:SetTitlePos(pos, rolePoint)
                go_table.aortext_TextName.text = roleInfo.name

                if roleInfo.title.sid == 0 then
                    if self.title[pos].item then
                        _G.DestroyObject(self.title[pos].item)
                        self.title[pos].item = nil
                    end
                    return
                end
                ---@type player_title_effect_cfg
                local cfg = _G.ConfigManager.player_title_effect_cfg[roleInfo.title.sid]
                if cfg then
                    if cfg.type_title == 1 then
                        go_table.aorrawimage_Title:LoadImage(
                            cfg.icon,
                            function()
                                go_table.aorrawimage_Title:SetNativeSize()
                                go_table.aorrawimage_Title:SetLocalScaleXYZ(
                                    self.titleScale * self.scale
                                )
                            end
                        )
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        self.title[pos].aorrawimage_Title:SetActiveE(1)
                    else
                        self.title[pos].aorrawimage_Title:SetActiveE(0)
                        if self.title[pos].item then
                            _G.DestroyObject(self.title[pos].item)
                            self.title[pos].item = nil
                        end
                        _G.UIUtils.LoadEffectTitleOrFrame(
                            cfg.title,
                            self.title[pos].gameObject,
                            function(titleTrans)
                                if self:IsNil() then
                                    _G.DestroyObject(titleTrans)
                                    return
                                end
                                titleTrans:SetLayerAndChild(30)
                                self.title[pos].item = titleTrans
                                local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                                titleTrans:SetPosition(x, y + 0.4, z)
                                self.title[pos].item:SetLocalScaleXYZ(
                                    self.titleScale * self.scale
                                )
                                titleTrans:SetActiveE(1)
                            end
                        )
                    end
                end
            end
        )
    elseif self.title[pos] then
        if self.title[pos].item then
            _G.DestroyObject(self.title[pos].item)
            self.title[pos].item = nil
        end
        self.title[pos].aortext_TextName.text = roleInfo.name
        if not roleInfo.title or roleInfo.title.sid <= 0 then
            self.title[pos].aorrawimage_Title:SetActiveE(0)
            return
        end
        ---@type player_title_effect_cfg
        local cfg = _G.ConfigManager.player_title_effect_cfg[roleInfo.title.sid]
        if cfg.type_title == 1 then
            self.title[pos].aorrawimage_Title:LoadImage(
                cfg.icon,
                function()
                    self.title[pos].aorrawimage_Title:SetNativeSize()
                    self.title[pos].aorrawimage_Title:SetLocalScaleXYZ(
                        self.titleScale * self.scale
                    )
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(1)
        else
            _G.UIUtils.LoadEffectTitleOrFrame(
                cfg.title,
                self.title[pos].gameObject,
                function(trans)
                    if self:IsNil() then
                        _G.DestroyObject(trans)
                        return
                    end
                    trans:SetLayerAndChild(30)
                    self.title[pos].item = trans
                    local x, y, z = self.title[pos].aorrawimage_Title:GetPosition()
                    trans:SetPosition(x, y + 0.2, z)
                    self.title[pos].item:SetLocalScaleXYZ(
                        self.titleScale * self.scale
                    )
                    trans:SetActiveE(1)
                end
            )
            self.title[pos].aorrawimage_Title:SetActiveE(0)
        end
    end
end

---初始化头顶名称位置
---@param deltaY number Y轴便宜值
function DecorationBossBattleView:SetTitlePos(pos, rolePoint)
    if self.titleCor[pos] then
        _G.coroutine.stopwaiting(self.titleCor[pos])
        self.titleCor[pos] = nil
    end
    self.titleCor[pos] = _G.DelayFrameDo(
        function()
            if self:IsNil() then
                return
            end
            if self.title[pos] and not _G.IsNil(self.title[pos].gameObject) then
                local x, y, z = rolePoint.Point_Head:GetPosition()
                if x then
                    local parent = self.roleTrans[pos]
                    if parent == nil then
                        return
                    end
                    local position = { x = x, y = y + 0.2, z = z }
                    local scale = parent:GetLocalScale()
                    self.title[pos].gameObject:SetLocalScaleXYZ(scale)
                    self.title[pos].transform:SetLocalPositionToZero()
                    self.title[pos].transform:SetPosition(position.x, position.y, position.z)
                    local lookAt = self.title[pos].transform:GetComponentE(_G.typeof(_G.CS.LookAtTarget))
                    if _G.IsNil(lookAt) then
                        lookAt = self.title[pos].transform:AddComponentE(_G.typeof(_G.CS.LookAtTarget))
                    end
                    lookAt:SetData(_G.Camera.main.transform, parent)
                end
            end
        end
    )
end

function DecorationBossBattleView:UpdateHalo(pos, rolePoint, roleInfo)
    if self.halo[pos] then
        _G.PoolsManager:GetInstance():Despawn(self.halo[pos], _G.ePoolType.Temporary)
        self.halo[pos] = nil
    end
    if not roleInfo.halo or roleInfo.halo.sid == 0 then
        return
    end
    local parent = self.roleTrans[pos]
    ---@type player_halo_effect_cfg
    local cfg = _G.ConfigManager.player_halo_effect_cfg[roleInfo.halo.sid]
    _G.PoolsManager:GetInstance():Spawn(
        cfg.halo,
        _G.ePoolType.Temporary,
        parent,
        function(trans)
            if _G.IsNil(parent) then
                _G.DestroyObject(trans)
                return
            end
            self.halo[pos] = trans
            if cfg.type_halo == 2 then
                self.halo[pos]:SetParentE(rolePoint.Point_Chest)
            else
                local scale = self.halo[pos]:GetParent():GetLocalScale()
                local rate = self.scale
                self.halo[pos]:SetLocalScaleXYZ(rate * _G.ConfigManager.discrete_cfg[103901][1][1] / scale)
            end
            self.halo[pos]:GetChildE(0):SetActiveE(1)
            self.halo[pos]:SetEulerAngles(0, 0, 0)
            self.halo[pos]:SetLocalPositionToZero()
        end
    )
end

