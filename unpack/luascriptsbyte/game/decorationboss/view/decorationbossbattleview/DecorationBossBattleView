---界面的入口函数
function DecorationBossBattleView:OnCreate(config)
    self.config = config
    self.bossStateEnum = DecorationBossModel:GetInstance().bossStateEnum
    ---自己的排名
    self.myRank = 0
    ---计算缩放比例
    self.scale = 1
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    if _G.CS.Launcher.Inst.UIScaler.matchWidthOrHeight < 0.5 then --适配宽 分辨率比例小于 16：9
        local screenSize = _G.CS.Launcher.Inst.ScreenSize
        self.scale = _G.AppSetting.CONFIG_SCREEN_HEIGHT / screenSize.y
    end
    self.titleScale = _G.ConfigManager.discrete_cfg[103902][1][1] * 0.0035
    self.roleTrans = {}
    self.roleComponent = {}
    self.halo = {}
    self.title = {}
    self.titleCor = {}
    ---初始化模型位置
    self:InitModelPos()
    ---加载场景
    self:LoadScene()
    self:AddListener(_G.eDecorationBoss.RefreshBossInfo, _G.handler(self, self.RefreshBossInfo))
    self:AddListener(_G.eDecorationBoss.BossDeath, _G.handler(self, self.RefreshBossDeath))
    self:AddListener(_G.eDecorationBoss.BossAwardChange, _G.handler(self, self.BossAwardChange))
    self:AddListener(_G.eDecorationBoss.BattleTimeEnd, _G.handler(self, self.BattleTimeEnd))
    self:AddListener(_G.eDecorationBoss.BossRevive, self.OnBossRevive)
end

function DecorationBossBattleView:LoadEffect()
    if self.isLoadYunEffect then
        return
    end
    self.isLoadYunEffect = true
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationBossBattleView_yun,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

function DecorationBossBattleView:InitModelPos()
    self.modelPosList = {}
    for index, v in ipairs(self.config.model) do
        self.modelPosList[index] = v
    end
end

---加载场景
function DecorationBossBattleView:LoadScene()
    local mConfig = _G.ConfigManager.monster_group_cfg[self.config.monster]
    self.sceneRoot = _G.GameObject("DecorationBossBattleRoot")
    self.sceneRoot:SetPosition(mConfig.FightAreaPos[1], mConfig.FightAreaPos[2], mConfig.FightAreaPos[3])
    if not _G.string.IsNullOrEmpty(mConfig.ScenePath) then
        _G.PoolsManager:GetInstance():Spawn(
            mConfig.ScenePath,
            _G.ePoolType.Static,
            self.sceneRoot,
            function(trans)
                if _G.IsNil(self.sceneRoot) then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                    return
                end
                self.curSceneTrans = trans
                _G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
                trans:ChangeCameraAdaption()
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
                trans:SetLocalPositionToZero()
                local battleCameraPath =
                    _G.string.IsNullOrEmpty(mConfig.EmbattleCamera) and mConfig.BattleCamera or mConfig.EmbattleCamera
                if not _G.string.IsNullOrEmpty(battleCameraPath) then
                    local cameraNum = string.match(battleCameraPath, "%d+")
                    trans:GetComponentE(_G.typeof(_G.CS.WorldSetting)):ChangeCameraParams(battleCameraPath, cameraNum)
                end
                _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
                self:LoadBossModel()
                self:InitRank()
            end
        )
    end
    self:RefreshView()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
    if view then
        view:Hide()
    end
    local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
    if bossData.fight_card then
        require("DecorationBossModel"):GetInstance():GetBossInfo({ self.config.id }, function()
            self:InitBossState()
        end)
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
end

function DecorationBossBattleView:OnEnable()
    self:GetBossInfoTimer()
end

function DecorationBossBattleView:OnDisable()
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
end

---每5秒拉取一次boss信息
function DecorationBossBattleView:GetBossInfoTimer()
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
    self.bossInfoTimer = _G.TimerManager:GetInstance():GetTimer(5, self.UpdateBossInfo, self, false, false, true)
    self.bossInfoTimer:Start()
end

---拉取boss信息和排行榜信息
function DecorationBossBattleView:UpdateBossInfo()
    local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
    if bossData.fight_card then
        require("DecorationBossModel"):GetInstance():GetBossInfo({ self.config.id }, function()
            self:InitBossState()
        end)

        ---排行榜
        self:InitRank()
    end
end

---加载boss
function DecorationBossBattleView:LoadBossModel()
    local cfg = require "CardCommentManager":GetInstance():CardData(self.config.preview_monster, false)
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.sceneRoot,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("DecorationBossBattleView-boss模型无法加载path:" .. cfg.ModelPathHi)
                end
                return
            end
            if self:IsNil() or not self.curSceneTrans then
                _G.DestroyObject(trans)
                return
            end
            local bosspos = self.config.bosspos
            trans:SetLocalPosition(bosspos[1], bosspos[2], bosspos[3])
            local monster = _G.ConfigManager.monster_group_cfg[self.config.monster]
            for _, v in pairs(monster.DefaultDefenserSids[1]) do
                if v > 0 then
                    local mcfg = _G.ConfigManager.monster_cfg[v]
                    if mcfg.MonsterType == 5 then
                        trans:SetLocalScaleXYZ(mcfg.GlobalScale * 0.0001)
                        break
                    end
                end
            end
            if bosspos[5] == 1 then
                trans:SetLocalEulerAngles(0, 0, 0)
            elseif bosspos[5] == -1 then
                trans:SetLocalEulerAngles(0, 180, 0)
            elseif bosspos[4] == 1 then
                trans:SetLocalEulerAngles(0, 90, 0)
            else
                trans:SetLocalEulerAngles(0, 270, 0)
            end
            self.bossTrans = trans
        end
    )
end

