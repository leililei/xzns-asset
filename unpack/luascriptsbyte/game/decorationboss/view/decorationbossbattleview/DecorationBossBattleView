---初始化保护时间
function DecorationBossBattleView:InitProtectTime()
    if self.protectTimer then
        self.protectTimer:Stop()
        self.protectTimer = nil
    end
    local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
    local reviveCd = _G.ConfigManager.discrete_cfg[115302][1][1]
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if bossData and bossData.last_end_time and bossData.last_end_time + reviveCd <= serverTime then
        local protectTime = _G.ConfigManager.discrete_cfg[115305][1][1]
        local leftTime = bossData.last_end_time + reviveCd + protectTime - serverTime
        if leftTime > 0 then
            self.go_table.aortext_protect.text = _G.GetLangPackValue(90031900038, leftTime)
            self.protectTimer = _G.TimerManager:GetInstance():GetTimer(1,
                _G.handlerbind(self, self.UpdateProtectTime, bossData, reviveCd, protectTime), self, false, true, true)
            self.protectTimer:Start()
        else
            self.go_table.aortext_protect.text = ""
        end
    else
        self.go_table.aortext_protect.text = ""
    end
end

function DecorationBossBattleView:UpdateProtectTime(_, _, bossData, reviveCd, protectTime)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local leftTime = bossData.last_end_time + reviveCd + protectTime - serverTime
    if leftTime > 0 then
        self.go_table.aortext_protect.text = _G.GetLangPackValue(90031900038, leftTime)
    else
        self.go_table.aortext_protect.text = ""
        if self.protectTimer then
            self.protectTimer:Stop()
            self.protectTimer = nil
        end
    end
end

---初始化排行榜
function DecorationBossBattleView:InitRank()
    DecorationBossModel:GetInstance():GetRankInfo(self.config.id, 2, 1, function(rankInfo)
        if self:IsNil() then
            ---服务器返回数据后界面已关闭界面
            return
        end
        self:RefreshRank(rankInfo)
    end)
end

---刷新排行榜
function DecorationBossBattleView:RefreshRank(rankInfo)
    self.rankInfo = rankInfo or {}
    if not self.rankListView then
        self.go_table.scrollloopvectical_rank:InitItemData(
            _G.Mathf.Max(#self.rankInfo, 3),
            _G.handler(self, self.RefreshRankItem)
        )
        self.rankListView = self.go_table.scrollloopvectical_rank
    else
        self.rankListView:UpdateCount(_G.Mathf.Max(#self.rankInfo, 3))
    end
    ---前5名
    local bossData = DecorationBossModel:GetInstance():GetBossData(self.config.id)
    if bossData.fight_card then
        for i = 1, 5 do
            if self.rankInfo[i] then
                local data = self.rankInfo[i].role_info
                if not self.lastRankInfo or not self.lastRankInfo[i] or self.lastRankInfo[i].role_info.uid ~= data.uid then
                    local modelPath = require "CardInfoManager".GetBattleModelPath(data.city_style_id, false)
                    self:InitRoleModel(modelPath, i, data)
                end
            else
                if self.roleTrans[i] then
                    _G.PoolsManager:GetInstance():Despawn(self.roleTrans[i], _G.ePoolType.Temporary)
                    self.roleTrans[i] = nil
                end
            end
        end
    end
    self.lastRankInfo = self.rankInfo
    if #self.rankInfo > 0 then
        self:LoadEffect()
        if not self.actionTimer then
            self:PlayModelAction()
        end
    else
        if self.actionTimer then
            self.actionTimer:Stop()
            self.actionTimer = nil
        end
    end

    ---查找自己的排名
    local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
    for i, v in ipairs(self.rankInfo) do
        if v.role_info.uid == uid then
            self.myRank = i
            break
        end
    end
    if self.myRank > 0 then
        self.go_table.aortext_mineRank.text = _G.GetLangPackValue(90029300023, self.myRank)
    else
        self.go_table.aortext_mineRank.text = _G.GetLangPackValue(90029300023, _G.GetLangPackValue(90022900040))
    end
end

---放弃boss后客户端手动删除数据,因为服务器有延迟
function DecorationBossBattleView:RefreshGiveUpRank()
    _G.table.remove(self.rankInfo, self.myRank)
    self.myRank = 0
    self.go_table.aortext_mineRank.text = _G.GetLangPackValue(90029300023, _G.GetLangPackValue(90022900040))
    self.rankListView:UpdateCount(_G.Mathf.Max(#self.rankInfo, 3))
    ---前5名
    self:ClearAllRoleModel()
    for i = 1, 5 do
        if self.rankInfo[i] then
            local data = self.rankInfo[i].role_info
            local modelPath = require "CardInfoManager".GetBattleModelPath(data.city_style_id, false)
            self:InitRoleModel(modelPath, i, data)
        else
            if self.roleTrans[i] then
                _G.PoolsManager:GetInstance():Despawn(self.roleTrans[i], _G.ePoolType.Temporary)
                self.roleTrans[i] = nil
            end
        end
    end
    self:PlayModelAction()
end

function DecorationBossBattleView:RefreshRankItem(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickRankItem, false))
    local rank = index + 1
    local data = self.rankInfo[rank]
    if data then
        tb.aortext_name.text = data.role_info.name
        tb.aortext_value.text = _G.GameUtil.NumberToUnitStrFight(data.dps)
    else
        tb.aortext_name.text = _G.GetLangPackValue(90021800103)
        tb.aortext_value.text = ""
    end
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(rank > 3 and 1 or 0)
    if rank <= 3 then
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[rank]
    else
        tb.aortext_rank.text = rank
    end
end

