local SettlementBaseView = require "SettlementBaseView"
---@class DecorationBossBattleResultView : UIBaseView	中文描述
---@field public go_table DecorationBossBattleResultView_GoTable GoTable
local DecorationBossBattleResultView = _G.BaseClass("DecorationBossBattleResultView", SettlementBaseView)

---界面的入口函数
function DecorationBossBattleResultView:OnCreateChild(data, sid, dps, fightCard)
    self.data = data
    self.sid = sid
    self.damages = dps or 0
    self.fightCard = fightCard
    self:OpenEmbattleView()
    self:InitPanel()
end

function DecorationBossBattleResultView:InitPanel()
    self.go_table.aortext_damage.text = _G.GameUtil.NumberToUnitStrFight(self.damages)
    if _G.table.isEmptyOrNil(self.fightCard) then
        self.go_table.slider_damge.value = 0
    else
        for _, v in pairs(self.fightCard) do
            local sid = _G.GameUtil.GetDivisionNumber(v.uid, 100)
            if _G.ConfigManager.monster_cfg[sid].MonsterType == 5 then
                local hp = v.hp or 0
                self.go_table.slider_damge.value = hp / 10000
                break
            end
        end
    end
end

function DecorationBossBattleResultView:OpenEmbattleView()
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
    local result = {}
    result.iSWin = true
    result.statistics = true
    result.back = true
    result.hidePetBtn = true
    self:OnShowView(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name, self.callback, result)
end

---显示战斗消息
function DecorationBossBattleResultView:ShowStatisticsView()
    local data = _G.BattleManager:GetInstance():GetStatistics()
    if not data or not data.FighterInfo then
        _G.PopWindowManager:GetInstance():ShowAllTips(960115)
        return
    end
    local count = #data.FighterInfo
    local damage = {}
    local win = {}

    for i = 1, count do
        local statisticsData = data.FighterInfo[i]
        local statisticsMax = { DmgOut = 1, DmgIn = 1, HpRecover = 1, CreateGuard = 1 }
        for j = 1, #statisticsData.Attacker do
            if statisticsMax.DmgOut < statisticsData.Attacker[j].DmgOut then
                statisticsMax.DmgOut = statisticsData.Attacker[j].DmgOut
            end

            if statisticsMax.DmgIn < statisticsData.Attacker[j].DmgIn then
                statisticsMax.DmgIn = statisticsData.Attacker[j].DmgIn
            end

            if statisticsMax.HpRecover < statisticsData.Attacker[j].HpRecover then
                statisticsMax.HpRecover = statisticsData.Attacker[j].HpRecover
            end
            if statisticsMax.CreateGuard < statisticsData.Attacker[j].CreateGuard then
                statisticsMax.CreateGuard = statisticsData.Attacker[j].CreateGuard
            end
        end
        for j = 1, #statisticsData.Defender do
            if statisticsMax.DmgOut < statisticsData.Defender[j].DmgOut then
                statisticsMax.DmgOut = statisticsData.Defender[j].DmgOut
            end

            if statisticsMax.DmgIn < statisticsData.Defender[j].DmgIn then
                statisticsMax.DmgIn = statisticsData.Defender[j].DmgIn
            end

            if statisticsMax.HpRecover < statisticsData.Defender[j].HpRecover then
                statisticsMax.HpRecover = statisticsData.Defender[j].HpRecover
            end
            if statisticsMax.CreateGuard < statisticsData.Defender[j].CreateGuard then
                statisticsMax.CreateGuard = statisticsData.Defender[j].CreateGuard
            end
        end
        local CombMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #statisticsData.AtkCombineSkills[1] do
            if CombMax.DmgOut < statisticsData.AtkCombineSkills[1][j].DmgOut then
                CombMax.DmgOut = statisticsData.AtkCombineSkills[1][j].DmgOut
            end

            if CombMax.CreateGuard < statisticsData.AtkCombineSkills[1][j].CreateGuard then
                CombMax.CreateGuard = statisticsData.AtkCombineSkills[1][j].CreateGuard
            end

            if CombMax.HpRecover < statisticsData.AtkCombineSkills[1][j].HpRecover then
                CombMax.HpRecover = statisticsData.AtkCombineSkills[1][j].HpRecover
            end
        end
        for j = 1, #statisticsData.DefCombineSkills[1] do
            if CombMax.DmgOut < statisticsData.DefCombineSkills[1][j].DmgOut then
                CombMax.DmgOut = statisticsData.DefCombineSkills[1][j].DmgOut
            end

            if CombMax.CreateGuard < statisticsData.DefCombineSkills[1][j].CreateGuard then
                CombMax.CreateGuard = statisticsData.DefCombineSkills[1][j].CreateGuard
            end

            if CombMax.HpRecover < statisticsData.DefCombineSkills[1][j].HpRecover then
                CombMax.HpRecover = statisticsData.DefCombineSkills[1][j].HpRecover
            end
        end
        local PetMax = { DmgOut = 1, CreateGuard = 1, HpRecover = 1 }
        for j = 1, #statisticsData.AtkPetSkills[1] do
            if PetMax.DmgOut < statisticsData.AtkPetSkills[1][j].DmgOut then
                PetMax.DmgOut = statisticsData.AtkPetSkills[1][j].DmgOut
            end

            if PetMax.CreateGuard < statisticsData.AtkPetSkills[1][j].CreateGuard then
                PetMax.CreateGuard = statisticsData.AtkPetSkills[1][j].CreateGuard
            end

            if PetMax.HpRecover < statisticsData.AtkPetSkills[1][j].HpRecover then
                PetMax.HpRecover = statisticsData.AtkPetSkills[1][j].HpRecover
            end
        end
        for j = 1, #statisticsData.DefPetSkills[1] do
            if PetMax.DmgOut < statisticsData.DefPetSkills[1][j].DmgOut then
                PetMax.DmgOut = statisticsData.DefPetSkills[1][j].DmgOut
            end

            if PetMax.CreateGuard < statisticsData.DefPetSkills[1][j].CreateGuard then
                PetMax.CreateGuard = statisticsData.DefPetSkills[1][j].CreateGuard
            end

            if PetMax.HpRecover < statisticsData.DefPetSkills[1][j].HpRecover then
                PetMax.HpRecover = statisticsData.DefPetSkills[1][j].HpRecover
            end
        end
        _G.table.insert(
            damage,
            { statisticsData = statisticsData, statisticsMax = statisticsMax, CombMax = CombMax, PetMax = PetMax }
        )
        _G.table.insert(win, 0)
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        damage,
        win,
        function()
            if self.waitTimer ~= nil then
                self.waitTimer = _G.TimerManager:GetInstance():GetTimer(1, self.ShowWaitTime, self)
                self.waitTimer:Start()

                if _G.AppSetting.DEBUG then
                    _G.Log("<color=red>" .. "自动推图倒计时继续" .. "</color>")
                end
            end
        end,
        nil,
        nil,
        1,
        false,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        nil,
        true
    )
end

---打开结算界面
---@param name string 结算界面名称
---@param result table 结算参数
function DecorationBossBattleResultView:OnShowView(name, OnSettlementEndCall, result)
    _G.UIManager:GetInstance():OpenWindow(name, OnSettlementEndCall, result, nil, nil, nil, nil, self.mvpData)
end

---监听界面
---@param name string 界面名称
function DecorationBossBattleResultView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
        _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        local view = _G.UIManager:GetInstance():GetWindowCtrl(name)
        if self.gameObject then
            _G.UIManager:GetInstance():ChangeCanvasOrder(
                name,
                self.gameObject:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder - 1
            )
        end
        view.transform:SetParentE(self.go_table.trans_view)
        view:SetTipsHide(false)
        view:SetFightBtnBool(0)
        self.delayCor = _G.DelayDo(
            1,
            function()
                _G.GameUtil.SetActiveByCondition(self.go_table.obj_info, true)
                self.go_table.obj_shenglibutton:SetActiveE(1)
                self.isCanClose = true
            end
        )
    end
end

---监听界面
---@param name string 界面名称
function DecorationBossBattleResultView:OnUIClosed(name)
    if name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name then
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
        self:Close()
    end
end

function DecorationBossBattleResultView:EscClose()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    if view then
        view:NextChapterClose()
    end
end

---按钮点击事件在这里派发
function DecorationBossBattleResultView:OnClickBtn(go)
    if go == self.go_table.aorbtn_back or go == self.go_table.aorbtn_BG then
        if self.isCanClose then
            local ctrl = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
            if ctrl then
                ctrl:CloseCall(require "SettlementModel".FunctionEnum.None)
            end
            if self.callback then
                self.callback()
            end
            if self.call then
                self.call(require "SettlementModel".FunctionEnum.None)
            end
            self:Close()
        end
    elseif go == self.go_table.aorbtn_static then
        self:ShowStatisticsView()
    end
end

function DecorationBossBattleResultView:OnDestroy()
    if self.delayCor then
        _G.coroutine.stopwaiting(self.delayCor)
    end
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened, self)
end

return DecorationBossBattleResultView
