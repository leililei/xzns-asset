local DecorationBossModel = require("DecorationBossModel")
local DecorationBossItem = require("DecorationBossItem")
---@class DecorationBossMainView : UIBaseView	中文描述
---@field public go_table DecorationBossMainView_GoTable GoTable
local DecorationBossMainView = _G.BaseClass("DecorationBossMainView", _G.UIBaseView)

local optationBg = {
    "Images/nDecorationBoss/ui-zyzm-xinxileibiao",  ---选中
    "Images/nDecorationBoss/ui-zyzm-xinxileibiao1", ---解锁
    "Images/nDecorationBoss/ui-zyzm-xinxileibiao2"  ---未解锁
}

function DecorationBossMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossMainView:OnCreate()
    local resources = _G.ConfigManager.ui_cfg.DecorationBossMainView.resources
    if #resources > 0 then
        self:AddComponent(
            self.go_table.obj_goldInfo,
            require("ResourceCompont").New(self.go_table.obj_goldInfo, resources)
        )
    end
    ---@type DecorationBossMainView._obj_boss_GoTable[]
    self.bossItemList = {}
    ---默认选择的难度索引
    self.curSelectIndex = 1
    self:GetBossConfig()
    self:LoadEffect()
    self.go_table.obj_awardredpoint:UpdateRedPointItemIDAndParam(_G.ConfigManager.redpoint_cfg.DecorationBossAward.id)
    self:AddListener(_G.eDecorationBoss.BossRevive, self.RefreshBossRevive)
    self:AddListener(_G.eDecorationBoss.AttentionBoss, self.RefreshAttentionBoss)
end

---初始化掉落奖励
function DecorationBossMainView:InitDropAward()
    self.preAwardData = self.bossConfigs[self.curSelectIndex].preview_reward
    if not self.dropAwardListView then
        self.go_table.scrollloophorizontal_dropAward:InitItemData(
            #self.preAwardData,
            _G.handler(self, self.RefreshDropItem)
        )
        self.dropAwardListView = self.go_table.scrollloophorizontal_dropAward
    else
        self.dropAwardListView:UpdateCount(#self.preAwardData)
    end
end

function DecorationBossMainView:RefreshDropItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    if not tb.lua then
        _G.ItemFactory:GetInstance():GetItemCard(
            _G.ItemFactory.itemType.baseItem,
            tb.obj_root,
            function(item)
                if _G.IsNil(tb.obj_root) then
                    _G.ItemFactory:GetInstance():SetItemCard(item)
                    return
                end
                tb.lua = item
                item:Show(self.preAwardData[index + 1])
            end
        )
    else
        tb.lua:Show(self.preAwardData[index + 1])
    end
end

---加载背景特效
function DecorationBossMainView:LoadEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationBossMainView_bg,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationBossMainView_huoxing,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

---boss复活
function DecorationBossMainView:RefreshBossRevive(monsterId)
    local cfg = _G.ConfigManager.decoration_boss_cfg[monsterId]
    if self.curSelectIndex == cfg.difficulty then
        self:RefreshBoss()
    end
end

---刷新关注boss
function DecorationBossMainView:RefreshAttentionBoss(sid)
    for _, v in pairs(self.bossItemList) do
        if v.config and v.config.id == sid then
            v:RefreshAttentionStatus()
            return
        end
    end
end

---获取配置信息
function DecorationBossMainView:GetBossConfig()
    ---boss配置
    local bossCfg = _G.ConfigManager.decoration_boss_cfg
    local limitCfg = _G.ConfigManager.decoration_limit_cfg
    self.bossConfigs = {}
    self.bossDifficultyCfgs = {}
    ---已解锁的boss列表
    local unlockBossList = {}
    ---最大解锁难度
    local maxUnlockDifficulty = 1
    for _, v in pairs(bossCfg) do
        local cfg = limitCfg[v.difficulty]
        if cfg then
            local isUnlock = _G.GlobalConditionManager.CheckCondition(cfg.limit_condition[1], cfg.limit_condition[2])
            if not self.bossConfigs[v.difficulty] then
                self.bossConfigs[v.difficulty] = {
                    difficulty = v.difficulty,
                    level = v.boss_lv,
                    isUnlock = isUnlock,
                    condVal = cfg.limit_condition[2],
                    preview_reward = cfg.preview_reward
                }
            end
            if isUnlock or v.difficulty == 1 then
                _G.table.insert(unlockBossList, v.id)
            end
            if isUnlock and maxUnlockDifficulty < v.difficulty then
                maxUnlockDifficulty = v.difficulty
            end

            if not self.bossDifficultyCfgs[v.difficulty] then
                self.bossDifficultyCfgs[v.difficulty] = {}
            end
            _G.table.insert(self.bossDifficultyCfgs[v.difficulty], v)
        end
    end
    if maxUnlockDifficulty > _G.PlayerPrefsManager.GetInt("DecorationBoss_UnlockMaxDifficulty", 0) then
        ---缓存最大难度
        _G.PlayerPrefsManager.SetInt("DecorationBoss_UnlockMaxDifficulty", maxUnlockDifficulty)
        self.curSelectIndex = maxUnlockDifficulty
    else
        local lastSelectDifficulty = _G.PlayerPrefsManager.GetInt("DecorationBoss_LastSelectDifficulty", 0)
        if lastSelectDifficulty > 0 and
            self.bossConfigs[lastSelectDifficulty] and
            self.bossConfigs[lastSelectDifficulty].isUnlock
        then
            self.curSelectIndex = lastSelectDifficulty
        else
            self.curSelectIndex = maxUnlockDifficulty
        end
    end
    _G.PlayerPrefsManager.SetInt("DecorationBoss_LastSelectDifficulty", self.curSelectIndex)
    for _, v in ipairs(self.bossDifficultyCfgs) do
        _G.SortList(
            v,
            function(data)
                return -data.id
            end
        )
    end
    if #unlockBossList > 0 then
        DecorationBossModel:GetInstance():GetBossInfo(unlockBossList, function()
            self:InitView()
        end)
    else
        self:InitView()
    end
end

---初始化界面
function DecorationBossMainView:InitView()
    self:RefrshDifficulty()
    self:RefreshBoss()
    self:InitDropAward()
end

function DecorationBossMainView:OnEnable()
    self:GetBossInfoTimer()
end

function DecorationBossMainView:OnDisable()
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
end

---每5秒拉取一次boss信息
function DecorationBossMainView:GetBossInfoTimer()
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
    self.bossInfoTimer = _G.TimerManager:GetInstance():GetTimer(5, self.UpdateBossInfo, self, false, false, true)
    self.bossInfoTimer:Start()
end

---拉取boss信息
function DecorationBossMainView:UpdateBossInfo()
    local data = self.bossConfigs[self.curSelectIndex]
    if self.bossDifficultyCfgs[data.difficulty] then
        local bossIdList = {}
        for _, v in pairs(self.bossDifficultyCfgs[data.difficulty]) do
            local bossData = DecorationBossModel:GetInstance():GetBossData(v.id)
            if bossData.fight_card then
                _G.table.insert(bossIdList, v.id)
            end
        end
        if #bossIdList > 0 then
            DecorationBossModel:GetInstance():GetBossInfo(bossIdList, function()
                self:RefreshBoss()
            end)
        end
    end
end

---初始化基础信息
function DecorationBossMainView:IntiBaseInfo()
    local time = _G.ConfigManager.discrete_cfg[115301][1]
    self.go_table.aortext_battleTime.text = _G.GetLangPackValue(90031900003, time[1], time[2])
    self.go_table.aortext_awardTimes.text = _G.GetLangPackValue(
        90031900004,
        DecorationBossModel:GetInstance():GetLeftAwardTimes(),
        DecorationBossModel:GetInstance():GetMaxAwardTimes()
    )
    local data = self.bossConfigs[self.curSelectIndex]
    self.go_table.aortext_label.text = _G.GetLangPackValue(90031900002, data.condVal)
end

---初始化难度列表
function DecorationBossMainView:InitDifficulty()
    local data = self.bossConfigs[self.curSelectIndex]
    self.go_table.aortext_dropdown.text = _G.GetLangPackValue(90031900002, data.condVal)
    if not self.optionListView then
        self.go_table.scrollloopvectical_optation:InitItemData(
            #self.bossConfigs,
            _G.handler(self, self.RefreshOptionItem)
        )
        self.optionListView = self.go_table.scrollloopvectical_optation
    else
        self.optionListView:UpdateAllItem()
    end
end

function DecorationBossMainView:RefreshOptionItem(index, obj)
    local newIndex = index + 1
    local data = self.bossConfigs[newIndex]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickOption, newIndex, data.isUnlock))
    tb.aortext_label.text = _G.GetLangPackValue(90031900002, data.condVal)
    tb.obj_lock:SetActiveE(data.isUnlock and 0 or 1)
    if data.isUnlock then
        if self.curSelectIndex == newIndex then
            tb.aorrawimage_bg:LoadImage(optationBg[1])
        else
            tb.aorrawimage_bg:LoadImage(optationBg[2])
        end
    else
        tb.aorrawimage_bg:LoadImage(optationBg[3])
    end
end

---点击下拉列表的item
---@param index number 选中的下标
---@param isUnlock boolean 是否解锁
function DecorationBossMainView:OnClickOption(_, _, index, isUnlock)
    if not isUnlock then
        ---未解锁
        _G.PopWindowManager:GetInstance():ShowAllTips(960101)
        return
    end

    if self.curSelectIndex == index then
        return
    end

    self.curSelectIndex = index
    self:InitDifficulty()
    self:RefreshBoss()
    self:InitDropAward()
    _G.PlayerPrefsManager.SetInt("DecorationBoss_LastSelectDifficulty", self.curSelectIndex)
end

---刷新难度条件
---@param isInit boolean 是否初始化
function DecorationBossMainView:RefrshDifficulty()
    self.go_table.obj_baseInfo:SetActiveE(self.unfold and 0 or 1)
    self.go_table.obj_difficulty:SetActiveE(self.unfold and 1 or 0)
    if self.unfold then
        self:InitDifficulty()
    else
        self:IntiBaseInfo()
    end
end

---刷新boss信息
function DecorationBossMainView:RefreshBoss()
    local data = self.bossConfigs[self.curSelectIndex]
    self.curBossCfg = self.bossDifficultyCfgs[data.difficulty]
    for i = 1, 4 do
        if not self.bossItemList[i] then
            local item = self:AddComponent(
                self.go_table["obj_boss" .. i],
                DecorationBossItem.New(self.go_table["obj_boss" .. i])
            )
            self.bossItemList[i] = item
        end
        local bossInfo = DecorationBossModel:GetInstance():GetBossData(self.curBossCfg[i].id)
        self.bossItemList[i]:RefreshBossItem(self.curBossCfg[i], data.isUnlock, bossInfo)
    end
end

---界面的销毁函数
function DecorationBossMainView:OnDestroy()
    if self.bossInfoTimer then
        self.bossInfoTimer:Stop()
        self.bossInfoTimer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function DecorationBossMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        ---帮助信息
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 137)
    elseif go == self.go_table.aorbtn_bossAward then
        ---首领奖励
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossBoxView.Name)
    elseif go == self.go_table.aorbtn_exerciseRoom then
        ---练功房
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossTrainSelectView.Name)
    elseif go == self.go_table.aorbtn_rank then
        ---排行
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossRankView.Name, self.curBossCfg)
    elseif go == self.go_table.aorbtn_follow then
        ---关注
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossAttentionView.Name)
    elseif go == self.go_table.aorbtn_condition or go == self.go_table.aorbtn_dropdown then
        ---难度条件
        self.unfold = not self.unfold
        self:RefrshDifficulty()
    end
end

return DecorationBossMainView
