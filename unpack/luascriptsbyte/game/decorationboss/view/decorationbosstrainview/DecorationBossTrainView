---@class DecorationBossTrainView : UIBaseView	中文描述
---@field public go_table DecorationBossTrainView_GoTable GoTable
local DecorationBossTrainView = _G.BaseClass("DecorationBossTrainView", _G.UIBaseView)

---@type string[] 前三排名图标
local RANK_ICON_IMAGES = {
    "tz_qjhs_phb_mingci_01",
    "tz_qjhs_phb_mingci_02",
    "tz_qjhs_phb_mingci_03"
}

function DecorationBossTrainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossTrainView:OnCreate(config)
    self.config = config
    self:LoadScene()
end

---加载场景
function DecorationBossTrainView:LoadScene()
    local mConfig = _G.ConfigManager.monster_group_cfg[self.config.monster]
    self.sceneRoot = _G.GameObject("DecorationBossBattleRoot")
    self.sceneRoot:SetPosition(mConfig.FightAreaPos[1], mConfig.FightAreaPos[2], mConfig.FightAreaPos[3])
    if not _G.string.IsNullOrEmpty(mConfig.ScenePath) then
        _G.PoolsManager:GetInstance():Spawn(
            mConfig.ScenePath,
            _G.ePoolType.Static,
            self.sceneRoot,
            function(trans)
                if _G.IsNil(self.sceneRoot) then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                    return
                end
                self.curSceneTrans = trans
                _G.UIManager:GetInstance():SetWorldSceneHideTimes(1)
                trans:ChangeCameraAdaption()
                _G.WorldManager:GetInstance():SetCurrentWorldVisible(false)
                trans:SetLocalPositionToZero()
                local battleCameraPath =
                    _G.string.IsNullOrEmpty(mConfig.EmbattleCamera) and mConfig.BattleCamera or mConfig.EmbattleCamera
                if not _G.string.IsNullOrEmpty(battleCameraPath) then
                    local cameraNum = string.match(battleCameraPath, "%d+")
                    trans:GetComponentE(_G.typeof(_G.CS.WorldSetting)):ChangeCameraParams(battleCameraPath, cameraNum)
                end
                _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
                self:LoadBossModel()
            end
        )
    end
    self:RefreshView()
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
end

---加载boss
function DecorationBossTrainView:LoadBossModel()
    local cfg = require "CardCommentManager":GetInstance():CardData(self.config.preview_monster, false)
    _G.PoolsManager:GetInstance():Spawn(
        cfg.ModelPathHi,
        _G.ePoolType.Temporary,
        self.sceneRoot,
        function(trans)
            if trans == nil then
                if _G.AppSetting.DEBUG then
                    _G.LogError("DecorationBossTrainView-boss模型无法加载path:" .. cfg.ModelPathHi)
                end
                return
            end
            if self:IsNil() or not self.curSceneTrans then
                _G.DestroyObject(trans)
                return
            end
            local bosspos = self.config.bosspos
            trans:SetLocalPosition(bosspos[1], bosspos[2], bosspos[3])
            local monster = _G.ConfigManager.monster_group_cfg[self.config.monster]
            for _, v in pairs(monster.DefaultDefenserSids[1]) do
                if v > 0 then
                    local mcfg = _G.ConfigManager.monster_cfg[v]
                    if mcfg.MonsterType == 5 then
                        trans:SetLocalScaleXYZ(mcfg.GlobalScale * 0.0001)
                        break
                    end
                end
            end
            if bosspos[5] == 1 then
                trans:SetLocalEulerAngles(0, 0, 0)
            elseif bosspos[5] == -1 then
                trans:SetLocalEulerAngles(0, 180, 0)
            elseif bosspos[4] == 1 then
                trans:SetLocalEulerAngles(0, 90, 0)
            else
                trans:SetLocalEulerAngles(0, 270, 0)
            end
            self.bossTrans = trans
        end
    )
end

---刷新界面
function DecorationBossTrainView:RefreshView()
    self:InitRank()
    self:InitRecommandCard()
    self:InitSkill()
    self:InitMechanics()
end

---推荐角色
function DecorationBossTrainView:InitRecommandCard()
    self.recommend = self.config.recommend
    if not self.cardListView then
        self.go_table.scrollloophorizontal_card:InitItemData(#self.recommend, _G.handler(self, self.RefreshCardItem))
        self.cardListView = self.go_table.scrollloophorizontal_card
    end
end

function DecorationBossTrainView:RefreshCardItem(index, obj)
    local sid = self.recommend[index + 1]
    local tb = _G.GetAutoGoTable(obj)
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        { sid },
        tb.obj_root,
        function(luaItem)
            if _G.IsNil(tb.obj_root) then
                luaItem.Spawn(luaItem)
                return
            end
            luaItem:ShowLv(false)
        end,
        function()
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.CommonIllustrationsH5View.Name,
                sid,
                function()
                    _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
                end,
                true,
                nil,
                nil,
                nil,
                nil,
                nil,
                nil,
                1
            )
        end
    )
end

---技能预览
function DecorationBossTrainView:InitSkill()
    self.skill = self.config.preview_skill
    if not self.skillListView then
        self.go_table.scrollloophorizontal_skill:InitItemData(#self.skill, _G.handler(self, self.RefreshSkillItem))
        self.skillListView = self.go_table.scrollloophorizontal_skill
    end
end

function DecorationBossTrainView:RefreshSkillItem(index, obj)
    local skillId = self.skill[index + 1]
    local skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSkill, skillId))
    require("CardInfoManager").LoadRawImage(tb.aorrawimage_skill, skillCfg.icon)
end

function DecorationBossTrainView:OnClickSkill(_, _, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end

---初始化机制
function DecorationBossTrainView:InitMechanics()
    local skillCfg = _G.ConfigManager.card_skills_cfg[self.config.card_skills]
    if skillCfg.describe1 > 0 then
        self.go_table.aortext_mechanics.text = _G.GetLangPackValue(skillCfg.describe1)
    else
        self.go_table.aortext_mechanics.text = _G.GetLangPackValue(90022500400)
    end
    local cardCfg = _G.ConfigManager.card_cfg[self.config.preview_monster]
    self.go_table.aortext_bossLevel.text = _G.GetLangPackValue(cardCfg.Name) ..
        ":" .. _G.GetLangPackValue(9002010022, self.config.boss_lv)

    ---挑战冷却中
    if self.cdTimer then
        self.cdTimer:Stop()
        self.cdTimer = nil
    end
    local lastFightTime = require("DecorationBossModel"):GetInstance():GetLastTestTime()
    local cd = _G.ConfigManager.discrete_cfg[115303][1][1]
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if lastFightTime and serverTime < lastFightTime + cd then
        ---挑战冷却中
        self.go_table.aorbtn_battle:SetGray(true)
        self.go_table.aorimage_battle:SetGray(true)
        self.cdTimer = _G.TimerManager:GetInstance():GetTimer(lastFightTime + cd - serverTime, function()
            self.go_table.aorbtn_battle:SetGray(false)
            self.go_table.aorimage_battle:SetGray(false)
        end, self, true, false, true)
        self.cdTimer:Start()
    end
end

---初始化排行榜
function DecorationBossTrainView:InitRank()
    require("DecorationBossModel"):GetInstance():GetRankInfo(self.config.id, 1, 1, function(rankInfo)
        self.rankInfo = rankInfo or {}
        if not self.rankListView then
            self.go_table.scrollloopvectical_rank:InitItemData(
                _G.Mathf.Max(#self.rankInfo, 3),
                _G.handler(self, self.RefreshRankItem)
            )
            self.rankListView = self.go_table.scrollloopvectical_rank
        else
            self.rankListView:UpdateCount(_G.Mathf.Max(#self.rankInfo, 3))
        end
        ---查找自己的排名
        local myRank = 0
        local uid = _G.PlayerModel:GetInstance():GetPlayerUid()
        for i, v in ipairs(self.rankInfo) do
            if v.role_info.uid == uid then
                myRank = i
                break
            end
        end
        if myRank > 0 then
            self.go_table.aortext_mineRank.text = _G.GetLangPackValue(90029300023, myRank)
        else
            self.go_table.aortext_mineRank.text = _G.GetLangPackValue(90029300023, _G.GetLangPackValue(90022900040))
        end
    end)
end

function DecorationBossTrainView:RefreshRankItem(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickRankItem))
    local rank = index + 1
    local data = self.rankInfo[rank]
    if data then
        tb.aortext_name.text = data.role_info.name
        tb.aortext_value.text = _G.GameUtil.NumberToUnitStrFight(data.dps)
    else
        tb.aortext_name.text = _G.GetLangPackValue(90021800103)
        tb.aortext_value.text = ""
    end
    tb.aorimage_rank:SetActiveE(rank <= 3 and 1 or 0)
    tb.aortext_rank:SetActiveE(rank > 3 and 1 or 0)
    if rank <= 3 then
        tb.aorimage_rank.SpriteName = RANK_ICON_IMAGES[rank]
    else
        tb.aortext_rank.text = rank
    end
end

function DecorationBossTrainView:OnClickRankItem()
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CommonRankView.Name,
        _G.CommonRankType.DecorationBoss,
        { id = self.config.id, type = 1, OnCloseCall = _G.handler(self, self.ChangeWindow) }
    )
    self:ChangeWindow(false)
end

---界面和场景的显隐
function DecorationBossTrainView:ChangeWindow(isShow)
    self.sceneRoot:SetActiveE(isShow and 1 or 0)
    if isShow then
        self:Show()
        _G.GraphicsManager.Instance:UpdateMainCameraPosImmediate()
    else
        self:Hide()
    end
end

---界面的销毁函数
function DecorationBossTrainView:Dispose()
    if self.cdTimer then
        self.cdTimer:Stop()
        self.cdTimer = nil
    end
    _G.UIManager:GetInstance():SetWorldSceneHideTimes(-1)
    if self.curSceneTrans then
        if not self.clickBattleButton then
            _G.WorldManager:GetInstance():SetCurrentWorldVisible(true)
            self.clickBattleButton = false
        end
        _G.PoolsManager:GetInstance():Despawn(self.curSceneTrans, _G.ePoolType.Static)
    end
    self.curSceneTrans = nil
    if self.bossTrans then
        _G.PoolsManager:GetInstance():Despawn(self.bossTrans, _G.ePoolType.Temporary)
    end
    self.bossTrans = nil
    self.sceneRoot:Dispose()
end

function DecorationBossTrainView:CloseView()
    self:Close()
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.ChangllengeView.Name)
end

---按钮点击事件在这里派发
function DecorationBossTrainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:CloseView()
    elseif go == self.go_table.aorbtn_help then
        ---帮助按钮
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 138)
    elseif go == self.go_table.aorbtn_rank then
        ---排行榜
        self:OnClickRankItem()
    elseif go == self.go_table.aorbtn_qingbao then
        ---情报
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossDrillInfoView.Name, self.config.id)
    elseif go == self.go_table.aorbtn_battle then
        ---战斗
        local lastFightTime = require("DecorationBossModel"):GetInstance():GetLastTestTime()
        local cd = _G.ConfigManager.discrete_cfg[115303][1][1]
        if lastFightTime and _G.TimeUtil.GetServerUnixTime() < lastFightTime + cd then
            ---挑战冷却中
            _G.PopWindowManager:GetInstance():ShowAllTips(960108)
            return
        end
        self.clickBattleButton = true
        require("DecorationBossController"):GetInstance():OpenEmbattle(self.config, true)
    end
end

return DecorationBossTrainView
