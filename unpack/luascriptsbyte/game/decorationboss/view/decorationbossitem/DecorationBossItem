local DecorationBossModel = require("DecorationBossModel")
---@class DecorationBossItem : Component	中文描述
local DecorationBossItem = _G.BaseClass("DecorationBossItem", _G.Component)

---创建对象时,入口构造函数
function DecorationBossItem:__init(obj)
    self.gameObject = obj
    self.go_table = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickBtn))
end

function DecorationBossItem:OnClickBtn(go)
    local name = go:GetName()
    if name == "@_aorbtn_follow" then
        ---1:关注 2:取消关注
        local type = self.isAttention and 2 or 1
        DecorationBossModel:GetInstance():AttentionBoss(self.config.id, type)
    elseif name == "@_aorbtn_enter" then
        if not self.isUnlock then
            _G.PopWindowManager:GetInstance():ShowAllTips(960101)
            return
        end

        DecorationBossModel:GetInstance():EnterBossBattleView(self.config)
    end
end

function DecorationBossItem:RefreshAttentionStatus()
    self.isAttention = DecorationBossModel:GetInstance():CheckAttentionBoss(self.config.id)
    self.go_table.aorimage_cancel:SetActiveE(self.isAttention and 0 or 1)
    self.go_table.aorimage_follow:SetActiveE(self.isAttention and 1 or 0)
    if self.isAttention then
        _G.PopWindowManager:GetInstance():ShowAllTips(960104)
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(960105)
    end
end

---刷新boss-Item
function DecorationBossItem:RefreshBossItem(config, isUnlock, bossInfo)
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    self.config = config
    self.isUnlock = isUnlock
    self.bossInfo = bossInfo
    local cardCfg = _G.ConfigManager.card_cfg[config.preview_monster]
    self.go_table.aorrawimage_bossPic:LoadImage(
        cardCfg.Portrait,
        function(image)
            if not self.go_table.aorrawimage_bossPic then
                return
            end
            image:SetNativeSize()
            if config.skew then
                image:SetLocalPosition(config.skew[1], config.skew[2], config.skew[3])
                image:SetLocalScaleXYZ(config.skew[4])
            end
            image:SetActiveE(1)
        end
    )
    ---等级
    self.go_table.aortext_level.text = _G.GetLangPackValue(90031900006, config.boss_lv)
    ---奖励预览
    self.skillData = config.preview_skill or {}
    local amount = #self.skillData
    self.go_table.scrollloophorizontal_skill:UpdateScrollRectWeight(_G.Mathf.Min(amount, 4) * 100)
    if not self.skillListView then
        self.go_table.scrollloophorizontal_skill:InitItemData(amount, _G.handler(self, self.RefreshAwardItem))
        self.skillListView = self.go_table.scrollloophorizontal_skill
    else
        self.skillListView:UpdateCount(amount)
    end
    self.isAttention = DecorationBossModel:GetInstance():CheckAttentionBoss(self.config.id)
    self.go_table.aorimage_cancel:SetActiveE(self.isAttention and 0 or 1)
    self.go_table.aorimage_follow:SetActiveE(self.isAttention and 1 or 0)
    ---获取boss状态
    self.state, self.endTime = DecorationBossModel:GetInstance():GetBossState(config.id)
    self.go_table.obj_rivive:SetActiveE(
        self.state ~= DecorationBossModel:GetInstance().bossStateEnum.Fighting and 1 or 0
    )
    self.go_table.obj_battleNum:SetActiveE(
        self.state == DecorationBossModel:GetInstance().bossStateEnum.Fighting and 1 or 0
    )
    if isUnlock then
        self.go_table.aorrawimage_bossPic:SetGray(
            DecorationBossModel:GetInstance().bossStateEnum.Fighting ~= self.state
        )
    else
        self.go_table.aorrawimage_bossPic:SetGray(true)
    end
    self.isNotArrived = self.state == DecorationBossModel:GetInstance().bossStateEnum.NotArrived
    ---boss状态计时器
    if self.state == DecorationBossModel:GetInstance().bossStateEnum.Fighting then
        local num = self.bossInfo and self.bossInfo.num or 0
        self.go_table.aortext_battleNum.text = _G.GetLangPackValue(90031900005, num)
    else
        self.go_table.aortext_battleNum.text = _G.GetLangPackValue(90031900005, 0)
    end
    if self.endTime > 0 then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
        self:UpdateTime()
    end
end

function DecorationBossItem:RefreshAwardItem(index, obj)
    local skillId = self.skillData[index + 1]
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickSkill, skillId))
    local skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
    require("CardInfoManager").LoadRawImage(tb.aorrawimage_icon, skillCfg.icon)
end

function DecorationBossItem:OnClickSkill(_, _, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end

function DecorationBossItem:UpdateTime()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if self.endTime - serverTime >= 0 then
        if self.isNotArrived then
            self.go_table.aortext_reviveTime.text = _G.GetLangPackValue(
                90031900008,
                _G.TimeUtil.TimeToString(self.endTime - serverTime, 1)
            )
        else
            self.go_table.aortext_reviveTime.text = _G.GetLangPackValue(
                90031900007,
                _G.TimeUtil.TimeToString(self.endTime - serverTime, 1)
            )
        end
    else
        local bossInfo = DecorationBossModel:GetInstance():GetBossData(self.config.id)
        self:RefreshBossItem(self.config, self.isUnlock, bossInfo)
    end
end

---销毁对象时,析构函数
function DecorationBossItem:Dispose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return DecorationBossItem
