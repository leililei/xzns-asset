local CommonTipManager = require "CommonTipManager"
local DecorationBossModel = require "DecorationBossModel"

---@class DecorationBossBoxView : UIBaseView	中文描述
---@field public go_table DecorationBossBoxView_GoTable GoTable
local DecorationBossBoxView = _G.BaseClass("DecorationBossBoxView", _G.UIBaseView)

function DecorationBossBoxView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossBoxView:OnCreate()
    self.DifficultyItems = {}
    self.BoxItemList = {}
    self:AddListener(_G.eDecorationBoss.ChooseBoxAward, self.InitBoxReward)
    self:AddListener(_G.eDecorationBoss.OpenBox, self.SetBoxView)
    self:SetBoxView()
    self:SetBoxEffect()
end

function DecorationBossBoxView:SetBoxEffect()
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationBossBoxView_chendi,
        self.go_table.obj_effect,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
    _G.UIUtils.LoadEffectByCfg(
        _G.ConfigManager.ui_effect_cfg.ef_DecorationBossBoxView_bg,
        self.go_table.obj_bg,
        function(trans)
            if self:IsNil() then
                _G.DestroyObject(trans)
            end
        end
    )
end

----初始化宝箱view
function DecorationBossBoxView:SetBoxView()
    self.boxList = DecorationBossModel:GetInstance():GetBoxList()
    local len = 9
    if self.chooseIndex == nil then
        self.chooseIndex = 1
        for i = 1, len do
            if self.boxList[i] and self.boxList[i].num > 1 then
                self.chooseIndex = i
                break
            end
        end
        self.go_table.scrollloopvectical_ItemList:InitItemData(len, _G.handler(self, self.OnRefreshLoopListItem))
        self:OnItemClickBtn(nil, nil)
    else
        self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
    end
    self:SetBoxOpenTime()
end

function DecorationBossBoxView:SetBoxOpenTime()
    --_G.GameUtil.SetActiveByCondition(self.go_table.obj_NoNum, len <= 0)
    self.go_table.aortext_free.text = _G.LangUtil.GetLangPackValue(90031900024,_G.GameUtil.NumberToWordByLanguage(1))
    local chooseNum = self.boxList[self.chooseIndex] and self.boxList[self.chooseIndex].num
    local num = chooseNum or 10
    self.go_table.aortext_ten.text = _G.LangUtil.GetLangPackValue(90031900024,_G.GameUtil.NumberToWordByLanguage((num and num > 0) and (num > 10 and 10 or num) or 10))
    self.go_table.obj_redpoint:SetActiveE(chooseNum and chooseNum > 0 and 1 or 0)
end

---@param looplist2 SuperScrollView.LoopListView2
---@param i number
function DecorationBossBoxView:OnRefreshLoopListItem(i, item)
    if i < 0 then
        return
    end
    local eIndex = i + 1
    local id = item:GetInstanceIDE()
    ---@type DecorationBossBoxView._obj_SociatyItem_GoTable
    local ctrl = self.BoxItemList[id]
    if not ctrl then
        ctrl = _G.GetAutoGoTable(item)
        _G.AddViewBtnClick(item, _G.handlerbind(self, self.OnItemClickBtn, ctrl))
        self.BoxItemList[id] = ctrl
    end
    ctrl.index = eIndex
    local data = self.boxList[eIndex]
    local num = data and data.num or 0
    ctrl.num = data and data.num or 0
    ctrl.sid = data and data.box_sid or eIndex
    ctrl.aortext_name.text = _G.LangUtil.GetLangPackValue(_G.ConfigManager.item_cfg[_G.ConfigManager.decoration_box_cfg[eIndex].item].Name)
    local itemBox = ctrl.itemBox
    if not itemBox then
        itemBox = require "BaseAwardNewItem".New(ctrl.obj_itemRoot, _G.handler(self, function()
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.decoration_box_cfg[ctrl.sid].item, nil, true)
        end, ctrl.sid), 88, ctrl.obj_itemRoot)
        ctrl.itemBox = itemBox
    end
    ctrl.aorimage_Mask:SetActiveE(ctrl.num == 0 and 1 or 0)
    local dataBox = _G.StorageManager:GetInstance():GetItemDataClass(_G.ConfigManager.decoration_box_cfg[eIndex].item, ctrl.num)
    itemBox:Show(dataBox,function()
        if num == 0 then
            if itemBox.item then
                itemBox.item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        end
    end)

    if self.chooseIndex == eIndex then
        _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, true)
        self.ChooseGoTable = ctrl
    else
        _G.GameUtil.SetActiveByCondition(ctrl.aorimage_choose, false)
    end
    return item
end

---点击选中
---@param _ UnityEngine.Transform 点击对象
---@param _ boolean 选中
---@param index number 选中索引
function DecorationBossBoxView:OnItemClickBtn(_, _, tb)
    -- if tb and tb.num <= 0 then
    --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.decoration_box_cfg[tb.sid].item)
    --     return
    -- end
    self.chooseIndex = tb and tb.index or self.chooseIndex
    if self.ChooseGoTable then
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorimage_choose, false)
    end
    self.ChooseGoTable = tb and tb or self.ChooseGoTable
    if self.ChooseGoTable then
        _G.GameUtil.SetActiveByCondition(self.ChooseGoTable.aorimage_choose, true)
    end
    local boxData = self.boxList[self.chooseIndex]
    if boxData == nil then
        self.boxList[self.chooseIndex] = {}
        boxData = self.boxList[self.chooseIndex]
        boxData.box_sid = self.chooseIndex
        boxData.num = 0
        boxData.index = 1
    end
    self.curBoxInfo = boxData
    self:SetBoxInfo()
    self:SetBoxOpenTime()
end

function DecorationBossBoxView:SetBoxInfo()
    self:InitBoxReward()
    local path = _G.ConfigManager.decoration_box_cfg[self.curBoxInfo.box_sid].icon
    self.go_table.aorrawimage_icon:LoadImage(path)
end

---初始化宝箱奖励
function DecorationBossBoxView:InitBoxReward(index)
    if index then
        self.curBoxInfo.index = index
    end
    self.boxReward = _G.ConfigManager.decoration_box_cfg[self.curBoxInfo.box_sid].preview[self.curBoxInfo.index]
    if self.initBoxReward == nil then
        self.go_table.scrollloophorizontal_Award:InitItemData(
            #self.boxReward,
            _G.handler(self, self.RefreshBoxAward)
        )
        self.initBoxReward = true
    else
        self.go_table.scrollloophorizontal_Award:UpdateCount(#self.boxReward)
    end
end

---刷新奖励显示
function DecorationBossBoxView:RefreshBoxAward(index, trans)
    local newIndex = index + 1
    local instanceID = trans:GetInstanceIDE()
    local data = self.boxReward[newIndex]
    local item = self.DifficultyItems[instanceID]
    if not item then
        item = require "BaseAwardNewItem".New(trans, _G.handler(self, self.OnClickAward), 88, trans)
        self.DifficultyItems[instanceID] = item
    end
    local data = _G.StorageManager:GetInstance():GetItemDataClass(data, 0)
    item:Show(data)
    item:ShowEffect(item.data.cfg.ef_item == 1 and true or false)
    --LogError(item.EffDic)
end

---点击奖励回调
function DecorationBossBoxView:OnClickAward(tb)
    CommonTipManager:GetInstance():OpenTip(tb.gameObject, tb.data.sid)
end

---按钮点击事件在这里派发
function DecorationBossBoxView:OnClickBtn(go)
    if go == self.go_table.aorbtn_drawOne then
        if self.curBoxInfo and self.curBoxInfo.num > 0 then
            DecorationBossModel:GetInstance():GetBoxAward(self.curBoxInfo.box_sid, 1)
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.decoration_box_cfg[self.curBoxInfo.box_sid].item, nil, true)
        end
    elseif go == self.go_table.aorbtn_drawTen then
        if  self.curBoxInfo and self.curBoxInfo.num > 0 then
            DecorationBossModel:GetInstance():GetBoxAward(self.curBoxInfo.box_sid, (self.curBoxInfo.num > 10 and 10 or self.curBoxInfo.num))
        else
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ConfigManager.decoration_box_cfg[self.curBoxInfo.box_sid].item, nil, true)
        end
    elseif go == self.go_table.aorbtn_changeReward or go == self.go_table.aorbtn_changeReward2 then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossBoxRewardChooseView.Name, self.curBoxInfo)
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

---界面的销毁函数
function DecorationBossBoxView:OnDestroy()
end

function DecorationBossBoxView:Dispose()
    self:RemoveAllListener()
end

return DecorationBossBoxView