---@class DecorationBossTrainSelectView : UIBaseView	演武场boss选择界面
---@field public go_table DecorationBossTrainSelectView_GoTable GoTable
local DecorationBossTrainSelectView = _G.BaseClass("DecorationBossTrainSelectView", _G.UIBaseView)

function DecorationBossTrainSelectView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossTrainSelectView:OnCreate()
    self:InitBossData()
    self:RefreshBossInfo()
end

---初始boss数据
function DecorationBossTrainSelectView:InitBossData()
    ---根据难度缓存所有boss的数据
    self.bossConfig = {}
    ---缓存boss难度数据
    self.bossDifficulty = {}
    for _, v in pairs(_G.ConfigManager.decoration_boss_cfg) do
        if not self.bossDifficulty[v.difficulty] then
            self.bossDifficulty[v.difficulty] = {}
        end
        _G.table.insert(self.bossDifficulty[v.difficulty], v)

        if not self.bossConfig[v.difficulty] then
            self.bossConfig[v.difficulty] = v.boss_lv
        end
    end
    for _, v in ipairs(self.bossDifficulty) do
        _G.SortList(
            v,
            function(data)
                return -data.id
            end
        )
    end
end

---刷新boss信息
function DecorationBossTrainSelectView:RefreshBossInfo()
    if not self.bossListView then
        self.go_table.scrollloopvectical_boss:InitItemData(
            #self.bossConfig,
            _G.handler(self, self.RefreshBossItem)
        )
        self.bossListView = self.go_table.scrollloopvectical_boss
    else
        self.bossListView:UpdateAllItem()
    end
end

function DecorationBossTrainSelectView:RefreshBossItem(index, obj)
    local tb = _G.GetAutoGoTable(obj)
    local eIndex = index + 1
    tb.aortext_name.text = _G.GetLangPackValue(90031900029, _G.GameUtil.NumberToChinese(eIndex), self.bossConfig[eIndex])
    local bossList = self.bossDifficulty[eIndex]
    tb.trans_Root:ClearChildren()
    for _, v in pairs(bossList) do
        local itemObj = _G.InstantiateObject(tb.obj_item, tb.trans_Root)
        itemObj:SetActiveE(1)
        local itemTb = _G.GetAutoGoTable(itemObj)
        _G.ItemCardFactory:GetInstance():GetItemCard(
            _G.ItemCardFactory.itemCardType.CardAllItem,
            itemTb.obj_root,
            function(trans)
                if _G.IsNil(itemTb.obj_root) then
                    _G.ItemCardFactory:GetInstance():SetItemCard(trans)
                    return
                end
                trans:Show(v.preview_monster, function()
                    self:OnClickCardItem(v)
                end, 24, nil, v.boss_lv)
            end
        )
        local cfg = _G.ConfigManager.card_cfg[v.preview_monster]
        itemTb.aortext_bossName.text = _G.GetLangPackValue(cfg.Name)
    end
end

function DecorationBossTrainSelectView:OnClickCardItem(v)
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossTrainView.Name, v)
    self:Close()
end

---界面的销毁函数
function DecorationBossTrainSelectView:OnDestroy()
end

---按钮点击事件在这里派发
function DecorationBossTrainSelectView:OnClickBtn(go)
    if go == self.go_table.aorbtn_closeView then
        self:Close()
    end
end

return DecorationBossTrainSelectView
