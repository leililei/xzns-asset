---@class DecorationBossDrillInfoView : UIBaseView	中文描述
---@field public go_table DecorationBossDrillInfoView_GoTable GoTable
local DecorationBossDrillInfoView = _G.BaseClass("DecorationBossDrillInfoView", _G.UIBaseView)

function DecorationBossDrillInfoView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossDrillInfoView:OnCreate(bossId)
    self:InitView(bossId)
end

---初始化界面
function DecorationBossDrillInfoView:InitView(bossId)
    local skillId = _G.ConfigManager.decoration_boss_cfg[bossId].card_skills
    local skillCfg = _G.ConfigManager.card_skills_cfg[skillId]
    if skillCfg.describe1 > 0 then
        self.go_table.aortext_des.text = _G.GetLangPackValue(skillCfg.describe1)
    else
        self.go_table.aortext_des.text = _G.GetLangPackValue(90022500400)
    end

    local previewSkill = _G.ConfigManager.decoration_boss_cfg[bossId].preview_skill
    for _, v in ipairs(previewSkill) do
        local skillCfg = _G.ConfigManager.card_skills_cfg[v]
        local obj = _G.InstantiateObject(self.go_table.aorimage_Skill, self.go_table.obj_skillRoot)
        obj:SetActiveE(1)
        local go_table = _G.GetAutoGoTable(obj)

        require("CardInfoManager").LoadRawImage(go_table.aorrawimage_SkillIcon, skillCfg.icon)
        _G.SetEventTrigger(
                go_table.aorimage_Skill,
                "onClick",
                _G.handlerbind(self, self.RoleShow_SkillTips, v)
            )
    end
end

function DecorationBossDrillInfoView:RoleShow_SkillTips(_, _, skillId)
    require("CommonTipManager"):GetInstance():OpenSkillTip(skillId)
end


---界面的销毁函数
function DecorationBossDrillInfoView:OnDestroy()
end

---按钮点击事件在这里派发
function DecorationBossDrillInfoView:OnClickBtn(go)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

return DecorationBossDrillInfoView