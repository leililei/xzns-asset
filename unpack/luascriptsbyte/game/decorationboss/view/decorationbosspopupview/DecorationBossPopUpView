---@class DecorationBossPopUpView : UIBaseView	中文描述
---@field public go_table DecorationBossPopUpView_GoTable GoTable
local DecorationBossPopUpView = _G.BaseClass("DecorationBossPopUpView", _G.UIBaseView)

function DecorationBossPopUpView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function DecorationBossPopUpView:OnCreate(list)
    self.bossRemindQuene = list or {}
    self:CheckQuene()
    self:AddListener(_G.eUIManagerStatus.OnUIOpened, self.OnUIOpened)
end

function DecorationBossPopUpView:OnUIOpened(name)
    if name == _G.ConfigManager.ui_cfg.EmbattleView.Name or
        name == _G.ConfigManager.ui_cfg.BattleView.Name or
        name == _G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name
    then
        self:Close()
    end
end

function DecorationBossPopUpView:AddBossQueue(params)
    if self:IsNil() then
       return
    end
    for _, v in ipairs(params) do
        _G.table.insert(self.bossRemindQuene, v)
    end
end

function DecorationBossPopUpView:CheckQuene()
    if not self.bossPopUpTimer then
        local delay = _G.ConfigManager.discrete_cfg[115309][1][1]
        self.bossPopUpTimer = _G.TimerManager:GetInstance():GetTimer(delay, self.UpdatePopUpTimer, self, false, false,
            true)
        self.bossPopUpTimer:Start()
        self:UpdatePopUpTimer()
    end
end

function DecorationBossPopUpView:UpdatePopUpTimer()
    if _G.table.isEmptyOrNil(self.bossRemindQuene) then
        self:Close()
        return
    end

    local params = self.bossRemindQuene[1]
    self.go_table.aortext_name.text = _G.GetLangPackValue(params.name)
    self.go_table.aortext_level.text = _G.GetLangPackValue(90031900033, params.level)
    self.go_table.aortext_time.text = _G.GetLangPackValue(90031900034, params.popUpTime)
    if self.go_table.obj_head:GetChildCountE() > 0 then
        self.go_table.obj_head:ClearChildren()
    end
    _G.ItemCardFactory:GetInstance():GetItemCard(
        _G.ItemCardFactory.itemCardType.CardAllItem,
        self.go_table.obj_head,
        function(trans)
            if _G.IsNil(self.go_table.obj_head) then
                _G.ItemCardFactory:GetInstance():SetItemCard(trans)
                return
            end
            trans:Show(params.preview_monster, nil, 24, nil, params.level)
        end
    )
    _G.table.remove(self.bossRemindQuene, 1)
end

---界面的销毁函数
function DecorationBossPopUpView:OnDestroy()
    if self.bossPopUpTimer then
        self.bossPopUpTimer:Stop()
        self.bossPopUpTimer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function DecorationBossPopUpView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        if self.bossPopUpTimer then
            self.bossPopUpTimer:Stop()
            self.bossPopUpTimer = nil
        end
        self:CheckQuene()
    end
end

return DecorationBossPopUpView
