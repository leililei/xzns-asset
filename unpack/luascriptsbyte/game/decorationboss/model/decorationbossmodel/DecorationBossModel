---进入界面后刷新红点
function DecorationBossModel:EnterRefreshRedPoint()
    _G.PlayerPrefsManager.SetInt("decoration_boss_first_open_func", 1)
    local lastRefreshTime = _G.PlayerPrefsManager.GetInt("decoration_boss_refresh_time", 0)
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    if lastRefreshTime == 0 or serverTime >= lastRefreshTime + 86400 then
        local refreshTime = _G.TimeUtil.GetDayBegin(_G.TimeUtil.GetServerUnixTime()) + 43200
        _G.PlayerPrefsManager.SetInt("decoration_boss_refresh_time", refreshTime)
        self:RefreshRedPoint()
    end
end

---每天12点刷新红点
function DecorationBossModel:SetRedPointTimer()
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local refreshTime = _G.TimeUtil.GetDayBySix(serverTime) + _G.TimeUtil.GAME_DAY_TIME
    local delay
    if refreshTime > serverTime then
        delay = refreshTime - serverTime
    else
        delay = refreshTime + 86400 - serverTime
    end
    if self.redPointTimer then
        self.redPointTimer:Stop()
        self.redPointTimer = nil
    end
    self.redPointTimer = _G.TimerManager:GetInstance():GetTimer(delay + 1, self.RefreshRedPointTime, self, true, false,
        true)
    self.redPointTimer:Start()
end

function DecorationBossModel:RefreshRedPointTime()
    self:RefreshRedPoint()
    self:SetRedPointTimer()
end

--endregion

---销毁对象时,析构函数
function DecorationBossModel:Dispose()
    self.bossInfo = nil
    _G.Events:GetInstance():RemoveListener(
        _G.ConfigManager.net_map.ultimate_conclusion_boss_state.Cmd,
        self.UpdateBossState,
        self
    )
    if self.bossReviveTimer then
        self.bossReviveTimer:Stop()
        self.bossReviveTimer = nil
    end
    if self.refreshTimer then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
    if self.redPointTimer then
        self.redPointTimer:Stop()
        self.redPointTimer = nil
    end
end

return DecorationBossModel
