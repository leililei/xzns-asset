---@param sid number boss的sid
---@param type number 1:练功房 2:正式战斗
function DecorationBossModel:GetRankInfo(sid, type, page, callback)
    local pbData = { monster_sid = sid, type = type, page = page }
    DecorationBossNet:GetInstance():GetRankInfo(
