---获取当前boss的状态
function DecorationBossModel:GetBossState(bossId)
    local time = _G.ConfigManager.discrete_cfg[115301][1]
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local beginTime = _G.TimeUtil.GetDayBegin(serverTime)
    if serverTime < beginTime + time[1] * 3600 then
        return self.bossStateEnum.NotArrived, beginTime + time[1] * 3600, true
    end

    if serverTime >= beginTime + time[2] * 3600 then
        return self.bossStateEnum.NotArrived, beginTime + 86400 + time[1] * 3600, false
    end

    ---判断boss是否死亡
    if self.bossInfo[bossId] and self.bossInfo[bossId].last_end_time > 0 then
        local deadTime = self.bossInfo[bossId].last_end_time
        if serverTime < deadTime + self.reviveCd then
            return self.bossStateEnum.Reviving, deadTime + self.reviveCd
        end
    end
    return self.bossStateEnum.Fighting, 0
end

---进入boss战斗界面
function DecorationBossModel:EnterBossBattleView(config)
    local state, endTime = self:GetBossState(config.id)
    if state == self.bossStateEnum.Reviving then
        local serverTime = _G.TimeUtil.GetServerUnixTime()
        _G.PopWindowManager:GetInstance():ShowAllTips(
            960107,
            nil,
            nil,
            nil,
            nil,
            nil,
            _G.TimeUtil.TimeToString(endTime - serverTime, 1)
        )
        return
    end

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DecorationBossBattleView.Name, config)
end

