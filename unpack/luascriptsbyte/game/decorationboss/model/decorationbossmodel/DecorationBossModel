end

---放弃boss
function DecorationBossModel:GiveUpBoss(callback)
    DecorationBossNet:GetInstance():GiveUpBoss(
        function(msg)
            if msg.ack == 1 then
                local bossInfo = self.bossInfo[self.monsterSid] or {}
                if bossInfo.num and bossInfo.num > 0 then
                    bossInfo.num = bossInfo.num - 1
                end
                self.monsterSid = nil
                if callback then
                    callback()
                end
            end
        end
    )
end

---领取排行奖励
---@param list table 奖励列表
function DecorationBossModel:GetRankAward(callback)
    DecorationBossNet:GetInstance():GetRankAward(
        function(msg)
            if msg.ack == 1 then
                self.monsterSid = 0
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                ---更新宝箱数据
                for _, v in pairs(self.awardRecord) do
                    if self.awardTimes == v.index then
                        v.is_get = 1
                        for k2, v2 in pairs(v.box_award) do
                            if self.awardBox[v2.k] == nil then
                                self.awardBox[v2.k] = {}
                                self.awardBox[v2.k].box_sid = v2.k
                                self.awardBox[v2.k].num = 0
                                self.awardBox[v2.k].index = 1
                            end
                            self.awardBox[v2.k].num = self.awardBox[v2.k].num + v2.v
                            if msg.award and msg.award.item then
                                local config = _G.ConfigManager.decoration_box_cfg[v2.k]
                                if config and config.item then
                                    _G.table.insert(msg.award.item, { type = { config.item, v2.v } })
                                end
                            end
                        end
                        self:RefreshAwardRedPoint()
                        break
                    end
                end
                self:RefreshRedPoint()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, function()
                    if callback then
                        callback()
                    end
                end)
            end
        end
    )
end

---选择宝箱掉落组
---@param sid number boss的sid
function DecorationBossModel:ChooseBoxAward(sid, index, callback)
    DecorationBossNet:GetInstance():ChooseBoxAward(
        { box_sid = sid, index = index },
        function(msg)
            if msg.ack == 1 then
                if self.awardBox[sid] == nil then
                    self.awardBox[sid] = {}
                    self.awardBox[sid].box_sid = sid
                    self.awardBox[sid].num = 0
                    self.awardBox[sid].index = 1
                end
                self.awardBox[sid].index = index
                _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.ChooseBoxAward, index)
                if callback then
                    callback()
                end
            end
        end
    )
end

---开启宝箱
---@param sid number boss的sid
function DecorationBossModel:GetBoxAward(sid, num, callback)
    DecorationBossNet:GetInstance():GetBoxAward(
        { box_sid = sid, draw_times = num },
        function(msg)
            if msg.ack == 1 then
                self.awardBox[sid].num = self.awardBox[sid].num - num
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
                _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.OpenBox)
                self:RefreshAwardRedPoint()
                if callback then
                    callback()
                end
            end
        end
    )
end

---获取战斗回放
---@param sid number boss_sid
