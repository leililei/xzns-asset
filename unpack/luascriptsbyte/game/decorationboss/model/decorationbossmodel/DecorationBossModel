function DecorationBossModel:GetPlayBack(uid, sid, type, isCommonRank)
    DecorationBossNet:GetInstance():PlayBack(
        { role_uid = uid, monster_sid = sid, fight_type = type },
        function(msg)
            if msg.ack == 1 then
                self.fight_arg = msg.data
                self:UpdateData(_G.BattleManager:GetInstance():GetStatisticsRecord(msg.data), isCommonRank)
            end
        end
