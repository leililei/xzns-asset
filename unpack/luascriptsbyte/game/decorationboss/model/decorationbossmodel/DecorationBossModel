---获取boss信息
---@param sidList table sid列表
function DecorationBossModel:GetBossInfo(sidList, callback)
    DecorationBossNet:GetInstance():GetBossInfo(
        sidList,
        function(msg)
            if msg.ack == 1 then
                if not _G.table.isEmptyOrNil(msg.boss_info) then
                    for _, v in pairs(msg.boss_info) do
                        self.bossInfo[v.monster_sid] = v
                    end
                end
                if callback then
                    callback(msg.boss_info)
                end
                _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.RefreshBossInfo)
            end
        end
    )
end

