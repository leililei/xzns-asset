local DecorationBossNet = require("DecorationBossNet")
---@class DecorationBossModel : GameDataModelBase	中文描述
local DecorationBossModel = _G.BaseClass("DecorationBossModel", _G.GameDataModelBase)

---@return DecorationBossModel DecorationBossModel
function DecorationBossModel:GetInstance()
    return self.super.GetInstance(self)
end

---创建对象时,入口构造函数
function DecorationBossModel:__init()
    self.curFunctionOpenID = 259
    ---Boss状态
    self.bossStateEnum = {
        NotArrived = 1, ---未降临
        Reviving = 2,   ---复活中
        Fighting = 3    ---战斗中
    }
    ---boss信息
    self.bossInfo = {}
    ---boss死亡列表
    self.deathBossList = {}
    self.initBossInfo = true
    self.reviveCd = _G.ConfigManager.discrete_cfg[115302][1][1]
    _G.Events:GetInstance():AddListener(
        _G.ConfigManager.net_map.ultimate_conclusion_boss_state.Cmd,
        self.UpdateBossState,
        self
    )
end

function DecorationBossModel:ReConnect(endcall)
    self:GetDataFormServer()
    self.super.ReConnect(self, endcall)
end

---获取服务器数据
function DecorationBossModel:GetDataFormServer()
    DecorationBossNet:GetInstance():GetBaseInfo(_G.handler(self, self.ParseData))
end

---监听数据更新
function DecorationBossModel:UpdateBossState(msg)
    if msg.state == 1 then
        ---boss死亡
        if self.bossInfo[msg.monster_sid] then
            self.bossInfo[msg.monster_sid].fight_card = nil
            self.bossInfo[msg.monster_sid].hp = 0
            self.bossInfo[msg.monster_sid].last_end_time = msg.time
        end
        self:RefreshBossRevive(msg)
        _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.BossDeath, msg.monster_sid)
    elseif msg.state == 2 then
        ---boss复活
        if self.deathBossList[msg.monster_sid] then
            self.deathBossList[msg.monster_sid] = nil
        end
        if self.monsterSid and self.monsterSid == msg.monster_sid and self.awardTimes then
            for _, v in pairs(self.awardRecord) do
                if self.awardTimes == v.index then
                    v.is_get = 1
                    break
                end
            end
            self.monsterSid = 0
        end
        self:GetBossInfo({ msg.monster_sid }, function()
            _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.BossRevive, msg.monster_sid)
        end)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.DecorationBoss.id)
    elseif msg.state == 3 then
        ---boss结算完成
        if self.monsterSid and self.monsterSid == msg.monster_sid then
            DecorationBossNet:GetInstance():GetBaseInfo(_G.handler(self, self.ParseData))
        end
        _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.SettleCompleted, msg.monster_sid)
    end
end

---功能刷新计时器22点刷新
function DecorationBossModel:SetRefreshTimer()
    if self.refreshTimer then
        self.refreshTimer:Stop()
        self.refreshTimer = nil
    end
    local time = _G.ConfigManager.discrete_cfg[115301][1]
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    local beginTime = _G.TimeUtil.GetDayBegin(serverTime)

    local delay
    if serverTime < beginTime + time[2] * 3600 then
        delay = beginTime + time[2] * 3600
    else
        delay = beginTime + 86400 + time[2] * 3600
    end
    if delay - serverTime > 0 then
        self.refreshTimer = _G.TimerManager:GetInstance():GetTimer(delay - serverTime, self.OnBattleTimeEnd, self, true,
            false, true)
        self.refreshTimer:Start()
    end
end

function DecorationBossModel:OnBattleTimeEnd()
    _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.BattleTimeEnd)
    self:SetRefreshTimer()
end

---boss复活提示倒计时
function DecorationBossModel:RefreshBossRevive(msg)
    if self:GetLeftAwardTimes() <= 0 then
        ---没有奖励次数
        if self.bossReviveTimer then
            self.bossReviveTimer:Stop()
            self.bossReviveTimer = nil
        end
        return
    end
    local config = _G.ConfigManager.decoration_boss_cfg[msg.monster_sid]
    self.deathBossList[msg.monster_sid] = {
        reviviTime = msg.time + self.reviveCd,
        level = config.boss_lv,
        name = _G.ConfigManager.card_cfg[config.preview_monster].Name,
        sid = msg.monster_sid,
        preview_monster = config.preview_monster,
        popUpTime = 0
    }
    if not self.bossReviveTimer then
        self.bossReviveTimer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateBossReviveTime, self, false, false,
            true)
        self.bossReviveTimer:Start()
    end
end

function DecorationBossModel:UpdateBossReviveTime()
    if _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name) or
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.BattleView.Name) or
        _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.ShowAwardWithButtonView.Name)
    then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.DecorationBossPopUpView.Name
        )
        if view then
            view:Close()
        end
        return
    end
    local queneList = {}
    ---关注列表
    local attentionList = {}
    for _, v in pairs(self.attention) do
        attentionList[v] = true
    end
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    for _, v in pairs(self.deathBossList) do
        if attentionList[v.sid] then
            local leftTime = _G.Mathf.Ceil((v.reviviTime - serverTime) / 60)
            if leftTime == 5 or leftTime == 1 then
                v.popUpTime = leftTime
                _G.table.insert(queneList, v)
            end
        end
    end
    if not _G.table.isEmptyOrNil(queneList) then
        _G.SortList(queneList, function(data)
            return data.level
        end)

        local view = _G.UIManager:GetInstance():GetWindowCtrl(
            _G.ConfigManager.ui_cfg.DecorationBossPopUpView.Name
        )
        if view then
            view:AddBossQueue(queneList)
        else
            _G.UIManager:GetInstance():OpenWindow(
                _G.ConfigManager.ui_cfg.DecorationBossPopUpView.Name,
                queneList
            )
        end
    end
end

---解析个人信息
---@param data ultimate_conclusion.s2c_role_info
---@field monsterSid number 选定挑战boss
---@field awardTimes number 已领取奖励次数
---@field awardRecord table 当日奖励记录
---@field awardBox table 拥有奖励宝箱
---@field lastFightTime number 上次战斗时间
---@field lastTestTime number 上一次测试战斗的时间
---@field lastGiveUp number 上次放弃boss时间
---@field attention table 关注boss[monster_sid]
function DecorationBossModel:ParseData(data)
    self.monsterSid = data.monster_sid
    self.awardTimes = data.award_times or 0
    self.awardRecord = data.award_list or {}
    self.awardBox = {}
    if data.award_box then
        for k, v in ipairs(data.award_box) do
            self.awardBox[v.box_sid] = v
        end
    end
    self.lastFightTime = data.last_fight_time
    self.lastTestTime = data.last_test_time
    self.lastGiveUp = data.last_give_up
    self.attention = data.attention or {}
    ---获取所有boss的信息
    local bossList = {}
    for _, v in pairs(_G.ConfigManager.decoration_boss_cfg) do
        _G.table.insert(bossList, v.id)
    end
    self:GetBossInfo(bossList, function(bossInfo)
        if self.initBossInfo then
            self.initBossInfo = false
            local serverTime = _G.TimeUtil.GetServerUnixTime()
            for _, v in pairs(bossInfo) do
                if v.last_end_time and v.last_end_time > 0 and serverTime < v.last_end_time + self.reviveCd then
                    self:RefreshBossRevive({ monster_sid = v.monster_sid, time = v.last_end_time })
                end
            end
        end
    end)
    self:RefreshRedPoint()
    self:RefreshAwardRedPoint()
    _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.BossAwardChange)
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
    if view then
        view:RefrshDifficulty()
    end
    if not self.refreshTimer then
        self:SetRefreshTimer()
    end
    if not self.redPointTimer then
        self:SetRedPointTimer()
    end
    self.super.ParseData(self)
end

