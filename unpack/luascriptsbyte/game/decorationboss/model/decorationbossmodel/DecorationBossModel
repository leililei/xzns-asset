--region 红点相关
function DecorationBossModel:CheckRedPoint()
    if _G.PlayerPrefsManager.GetInt("decoration_boss_first_open_func", 0) == 0 then
        return 1
    end

    if self:CheckCanGetAward() then
        return 1
    end

    local lastRefreshTime = _G.PlayerPrefsManager.GetInt("decoration_boss_refresh_time", 0)
    if lastRefreshTime == 0 then
        return 1
    end
    local serverTime = _G.TimeUtil.GetServerUnixTime()
    return serverTime >= lastRefreshTime + 86400 and 1 or 0
end

---奖励红点
function DecorationBossModel:CheckAwardRedPoint()
    if not self.awardBox then
        return 0
    end
    for _, v in pairs(self.awardBox) do
        if v.num > 0 then
            return 1
        end
    end

    return 0
end

