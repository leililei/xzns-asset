function DecorationBossModel:UpdateData(data, isCommonRank)
    if not data then
        _G.PopWindowManager:GetInstance():ShowAllTips(540302)
        return
    end
    self.maxCountRank = _G.table.count(data.FighterInfo)
    self.PveData = {}
    local damage, win = _G.GameUtil.ShowStatisticsView(data)
    self.PveData = damage
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.BattleStatisticsPVEView.Name,
        self.PveData,
        win,
        function()
            if not isCommonRank then
                local ChangllengeView = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.ChangllengeView
                    .Name)
                if ChangllengeView then
                    ChangllengeView.View:Show()
                end
                local DecorationBossMainView =
                    _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationBossMainView.Name)
                if DecorationBossMainView then
                    DecorationBossMainView.View:Show()
                end
                local DecorationBossRankView =
                    _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.DecorationBossRankView.Name)
                if DecorationBossRankView then
                    DecorationBossRankView.View:Show()
                end
            end
        end,
        nil,
        self.otherPlayer,
        1,
        true,
        self.fight_arg
    )
end

---关注/取消关注
---@param sid number boss的sid
---@param type number 1:关注 2:取消关注
function DecorationBossModel:AttentionBoss(sid, type, callback)
    DecorationBossNet:GetInstance():AttentionBoss(
        { monster_sid = sid, type = type },
        function(msg)
            if msg.ack ~= 1 then
                return
            end

            local index = _G.table.indexof(self.attention, sid)
            if type == 1 then
                if index and _G.AppSetting.DEBUG then
                    _G.LogError("该monster_sid已经在关注列表中,sid: " .. sid)
                    return
                end
                _G.table.insert(self.attention, sid)
            elseif type == 2 then
                if not index and _G.AppSetting.DEBUG then
                    _G.LogError("该monster_sid不在关注列表中,sid: " .. sid)
                    return
                end
                for k, v in ipairs(self.attention) do
                    if v == sid then
                        _G.table.remove(self.attention, k)
                        break
                    end
                end
                -- self.attention[index] = nil
            end
            _G.Events:GetInstance():Broadcast(_G.eDecorationBoss.AttentionBoss, sid)
            if callback then
                callback()
            end
        end
    )
end

---@param msg p2c_box_award 宝箱奖励推送
function DecorationBossModel:P2CBoxAward(msg)
    if msg.ack ~= 1 then
        return
    end
    for k, v in pairs(msg.box_award) do
        if self.awardBox[v.k] == nil then
            self.awardBox[v.k] = {}
            self.awardBox[v.k].box_sid = v.k
            self.awardBox[v.k].num = 0
            self.awardBox[v.k].index = 1
        end
        self.awardBox[v.k].num = self.awardBox[v.k].num + v.v
    end
    self:RefreshAwardRedPoint()
end

