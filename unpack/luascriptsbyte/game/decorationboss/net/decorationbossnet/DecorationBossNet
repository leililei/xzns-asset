---请求回调
---@param port number 流水号
---@param pbData table 返回PB数据
---@param error string 错误信息
function DecorationBossNet:Callback(port, data, error)
    if error then
        return
    end

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

---@type DecorationBossNet
return DecorationBossNet
