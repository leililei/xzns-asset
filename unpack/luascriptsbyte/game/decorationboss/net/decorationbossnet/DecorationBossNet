local base = require("BaseGameNet")
---@class DecorationBossNet : BaseGameNet	通信协议
local DecorationBossNet = _G.BaseClass("DecorationBossNet", base)

---@return DecorationBossNet DecorationBossNet
function DecorationBossNet:GetInstance()
    return self.super.super.GetInstance(self)
end

---监听推送
function DecorationBossNet:AddMessageListeners()
    self:AddMessageListener(_G.ConfigManager.net_map.ultimate_conclusion_box_award.Cmd, self.P2CBoxAward)
end

---加入军团给所有已入会的人的推送
---@param msg guild.p2c_enter_guild_old
function DecorationBossNet:P2CBoxAward(msg)
    local md = require("DecorationBossModel")
    md:GetInstance():P2CBoxAward(msg)
end

---获取个人信息
---@param callback function 完成回调
function DecorationBossNet:GetBaseInfo(callback)
    local item = _G.ConfigManager.net_map.game_ultimate_conclusion_role_info
    local port = base.Access(self, item, self.GetEmptyPB(), _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

---获取boss信息
---@param sidList table boss的sid列表
---@param callback function 完成回调
function DecorationBossNet:GetBossInfo(sidList, callback)
    local item = _G.ConfigManager.net_map.game_ultimate_conclusion_boss_info
    local port = base.Access(self, item, {monster_sids = sidList}, _G.handlerbind(self, self.Callback))
    self.Call[port] = callback
end

