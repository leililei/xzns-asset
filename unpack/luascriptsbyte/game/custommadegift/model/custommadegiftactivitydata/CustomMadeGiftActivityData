---@class CustomMadeGiftActivityData  定制礼包 数据类
local CustomMadeGiftActivityData = _G.BaseClass("CustomMadeGiftActivityData")
---类的构造函数
function CustomMadeGiftActivityData:__init()
    self.cur_AwardsPoos_select = {}
end

---类的析构函数
function CustomMadeGiftActivityData:Dispose()
end
---@field sid number 礼包id
---@field string title 礼包名称
---@field total_num number 礼包的总次数
---@field residue_num number 剩余礼包的次数
---@field fixedAward table 固定奖励
---@field AwardPools table 奖励的总池子 {1=最高档次，2=中档次，3=低档次}
---@field cur_AwardPools table 当前的池子
---@field cur_AwardsPoos_select table 当前选中的物品 {1 = 最高档次，2 = 中等档次 3 = 最低档次}
---@field isNext boolean 是否显示下一个 false 显示下一个 true 确定
---@field select_cur number 当前默认的数量
---@field select_num number 选择奖励的数量
---@field totale_select number 可选择的总共的个数
---@field price number 价格
function CustomMadeGiftActivityData:InitData(data)
    self.AwardPools = {}
    self.sid = data.sid or 0
    self.price = data.price
    self.fixedAward = data.base_award[1].type or {}
    self.total_num = data.total_num or 1
    self.title = data.title or ""
    self:SetAllAWardPools(data.AwardPools)
    self:SetTotalSelectNum(#data.AwardPools) --设置可选择的个数
    self:ClearrData()
end
---获得槽位中，没有物品的下标
function CustomMadeGiftActivityData:GetIndCur_Awa_poos_select()
    local ind = 1
    for i = 1, #self.cur_AwardsPoos_select do
        if self.cur_AwardsPoos_select[i] == 0 then
            ind = i
            break
        end
    end
    return ind
end
---设置池子
---@param AwardPools i_choose_award_pool 奖池结构
---{[1]= {award = {[1] = {type = {[1]=1,[2]= 1}}}}}
function CustomMadeGiftActivityData:SetAllAWardPools(data)
    local num = #data
    for i = 1, num do
        if self.AwardPools[i] == nil then
            self.AwardPools[i] = {}
        end
        local items = data[i].award
        for j = 1, #items do
            local te = {
                ind = j,
                info = items[j].type,
                isOnclick = false --是否选中
            }
            _G.table.insert(self.AwardPools[i], te)
        end
    end
end
---当前选择的 档次
---@param num number 1= 高档次，2=中档次 3  = 低档次
function CustomMadeGiftActivityData:SetSelect_cur(num)
    self.select_cur = num
end
function CustomMadeGiftActivityData:GetSelect_cur(num)
    return self.select_cur
end
---设置剩余次数
function CustomMadeGiftActivityData:SetResidue_num(num)
    self.residue_num = num
end
function CustomMadeGiftActivityData:GetResidu_num()
    if self.residue_num <= 0 then
        self.residue_num = 0
    end
    return self.residue_num
end
---设置下一个 是否显示
function CustomMadeGiftActivityData:SetIsNext(flag)
    self.isNext = flag
end
function CustomMadeGiftActivityData:GetISNext()
    return self.isNext
end
function CustomMadeGiftActivityData:ClearrData()
    self:ClearSelcetNum()
    self.isNext = false
    for i = 1, self.totale_select do
        if self.cur_AwardsPoos_select[i] == nil then
            self.cur_AwardsPoos_select[i] = 0
        end
        self.cur_AwardsPoos_select[i] = 0
    end
end

---清理下选择的个数
function CustomMadeGiftActivityData:ClearSelcetNum()
    self.select_num = 0
end
---设置选择物品的个数
function CustomMadeGiftActivityData:SetSelectNum(num)
    self.select_num = self.select_num + num
    if self.select_num >= self.totale_select then
        self:SetIsNext(true)
    end
end
function CustomMadeGiftActivityData:GetSelctNum()
    return self.select_num
end
---设置 可以选择的总个数
function CustomMadeGiftActivityData:SetTotalSelectNum(num)
    self.totale_select = num
end
---@param index number 选择的位置 （档次 1 = 最高档次，2 = 中等档次 3 = 最低档次 ）
function CustomMadeGiftActivityData:SetGetCurAwardPools_selec(index, data)
    if self.cur_AwardsPoos_select[index] == nil then
        self.cur_AwardsPoos_select[index] = 0
    end
    self.cur_AwardsPoos_select[index] = data
end
---获得选中物品相关信息
---@param pools_ind number 池子id
---@param index number  所在池子的下标
function CustomMadeGiftActivityData:GetSelectItemInfo(pools_ind, index)
    local temp = {}
    local lists = self.AwardPools[pools_ind]
    for i = 1, #lists do
        if lists[i].ind == index then
            temp = lists[i]
            break
        end
    end
    return temp
end
---获得当前选中的物品
function CustomMadeGiftActivityData:GetCurAwardPools_selec()
    return self.cur_AwardsPoos_select
end
---设置当前展示的 池子
---@param index number
function CustomMadeGiftActivityData:SetCur_AwardPools(index)
    if self.AwardPools[index] then
        if _G.AppSetting.DEBUG then
            _G.Log("总的池子没有要展示的数据" .. index)
        end
    end
    self.cur_AwardPools = self.AwardPools[index] or {}
end
function CustomMadeGiftActivityData:GetCur_AwardPools()
    return self.cur_AwardPools
end
return CustomMadeGiftActivityData
