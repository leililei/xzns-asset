---初始化服务获得数
---@param alread_lists table 已领取的奖励
---@field sid number 礼包id
---@field count number 购买次数
---@field choose_index number 选中的奖励在所在的池子的位置
function CustomMadeGiftModel:InitFunction()
    self.AllGift = {}
    self.alread_lists = {}
    self:InitGitData(self.info)
    --刷新界面中
    local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CustomMadeGiftActivity.Name)
    if window then
        window.View:UpdateView()
    end
end

---重连获得数据(断线)
function CustomMadeGiftModel:ReConnect(endcall)
    self.AllGift = {}
    self.alread_lists = {}
    if endcall then
        endcall()
    end
end

---初始化所有数据
function CustomMadeGiftModel:InitGitData(info)
    if info.gifts == nil then
        if _G.AppSetting.DEBUG then
            _G.Log("没有数据")
        end
        --return
    end
    self.AllGift = {}
    if info.choose == nil then
    else
        self.alread_lists = info.choose or {}
    end
    self.spineName = "prf_diaolingyun"
    self.ActivieTime = self.curActivityClass:GetChangeStateTime()
    for i = 1, #info.gifts do
        local da = info.gifts[i]
        local data = itemData.New()
        local tempdata = {}
        tempdata.sid = da.sid
        tempdata.price = da.price
        tempdata.base_award = da.base_award
        tempdata.total_num = da.count
        tempdata.AwardPools = da.choose_pool
        -- 老自选活动没有标题字段
        if da.gift_name then
            tempdata.title = da.gift_name
        else
            tempdata.title = ""
        end
        data:InitData(tempdata)
        self:InitOneGiftInfo(tempdata.sid, data)
        _G.table.insert(self.AllGift, data)
    end
    if self.curActivityClass.cfg.info.type == 10011 then
        self.isNew = false
    else
        self.isNew = true
    end
end

---初始化下 单挑数据
function CustomMadeGiftModel:InitOneGiftInfo(sid, giftinfo)
    ---设置下剩余次数\设置选中物品的下标
    local flag, temp = self:CheckAlreadAwards(sid)
    local num = giftinfo.total_num
    if flag then
        num = num - temp.count
        if temp.choose_index then
            for i = 1, #temp.choose_index do
                giftinfo:SetGetCurAwardPools_selec(i, temp.choose_index[i])
                giftinfo:SetSelectNum(1)
            end
        else
            giftinfo:ClearrData()
        end
    else
        giftinfo:ClearrData()
    end
    local ind = giftinfo:GetIndCur_Awa_poos_select()
    giftinfo:SetResidue_num(num)
    ---设置下默认的池子
    giftinfo:SetCur_AwardPools(ind)
end

---检测数据 已购买，已领取的数据
function CustomMadeGiftModel:CheckAlreadAwards(sid)
    if self.alread_lists == nil or _G.table.isEmptyOrNil(self.alread_lists) then
        return false
    end
    local temp = {}
    for i = 1, #self.alread_lists do
        if self.alread_lists[i].sid == sid then
            temp = self.alread_lists[i]
            break
        end
    end
    if _G.table.isEmptyOrNil(temp) then
        return false
    end
    return true, temp
end

---获得单挑礼包数据信息
function CustomMadeGiftModel:GetOneGift(sid)
    if _G.table.isEmptyOrNil(self.AllGift) then
        if _G.AppSetting.DEBUG then
            _G.Log("没有礼包数据")
        end
    end
    local temp = {}
    for i = 1, #self.AllGift do
        if self.AllGift[i].sid == sid then
            temp = self.AllGift[i]
            break
        end
    end
    return temp
end

