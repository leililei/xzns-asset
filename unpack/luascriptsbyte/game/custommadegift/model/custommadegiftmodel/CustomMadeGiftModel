end

---@param index number 红点类型序列号
---@param param number 红点参数
---@return number 红点数量
function CustomMadeGiftModel:CheckRedPointNumChild(index, param)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---是否 有免费领取
function CustomMadeGiftModel:CheckFirstLogin()
    local giftinfo = {}
    local flag = false
    for i = 1, #self.AllGift do
        if self.AllGift[i].price == 0 then
            giftinfo = self.AllGift[i]
            break
        end
    end
    if _G.table.isEmptyOrNil(giftinfo) then
    else
        if giftinfo:GetResidu_num() > 0 then
            flag = true
        end
    end
    return flag and 1 or 0
end

--region---------------- 对外接口 -------------------------
function CustomMadeGiftModel:FreeGift(sid, giftinfo, call)
    self:GetActivityAward(
        { sid },
        function(data)
            if data.ack ~= 1 then
                return
            end
            giftinfo:ClearrData()
            local flag, temp = self:CheckAlreadAwards(sid)
            if flag then
                temp.choose_index = {}
                temp.count = temp.count + 1
            else
                _G.table.insert(self.alread_lists, { sid = sid, count = 0 })
            end
            _G.StorageManager:GetInstance():ReceiveAwardData(data)
            require("CommonTipManager"):GetInstance():OpenDropTip(data)
            self:InitOneGiftInfo(sid, giftinfo)
            self:UpdateRedpoint()
            if call then
                call()
            end
        end
    )
end

