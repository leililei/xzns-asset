---保存选择奖励的数据
function CustomMadeGiftModel:SaveGiftInfo(sid, chooseindex)
    local msg = {
        activity_id = self.curActivityClass:GetActivityID(),
        choose = {
            {
                sid = sid,
                choose = chooseindex
            }
        }
    }
    local call = function(data)
        if data.ack ~= 1 then
            return
        end
        local flag, temp = self:CheckAlreadAwards(sid)
        if flag then
            temp.choose_index = chooseindex
        else
            _G.table.insert(self.alread_lists, { sid = sid, count = 0, choose_index = chooseindex })
        end

        --刷新界面中
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CustomMadeGiftActivity.Name)
        if window then
            window.View:UpdateView()
        end
    end
    if self.isNew then
        require "CustomMadeGiftNet":GetInstance():AccessSaveNew(msg, call)
    else
        require "CustomMadeGiftNet":GetInstance():AccessSave(msg, call)
    end
end

---保存选择奖励的数据
function CustomMadeGiftModel:SaveGiftInfoOther(sid, chooseindex)
    local msg = {
        activity_id = self.curActivityClass:GetActivityID(),
        choose = {
            {
                sid = sid,
                choose = chooseindex
            }
        }
    }
    local call = function(data)
        if data.ack ~= 1 then
            return
        end
        local flag, temp = self:CheckAlreadAwards(sid)
        if flag then
            temp.choose_index = chooseindex
        else
            _G.table.insert(self.alread_lists, { sid = sid, count = 0, choose_index = chooseindex })
        end

        local onegift = self:GetOneGift(sid)
        for i = 1, #chooseindex do
            onegift:SetGetCurAwardPools_selec(i, chooseindex[i])
        end

        onegift:SetSelectNum(#chooseindex)

        --刷新界面中
        local window = _G.UIManager:GetInstance():GetWindow(_G.ConfigManager.ui_cfg.CustomMadeGiftActivity.Name)
        if window then
            window.View:UpdateView()
        end
    end
    if self.isNew then
        require "CustomMadeGiftNet":GetInstance():AccessSaveNew(msg, call)
    else
        require "CustomMadeGiftNet":GetInstance():AccessSave(msg, call)
    end
end

