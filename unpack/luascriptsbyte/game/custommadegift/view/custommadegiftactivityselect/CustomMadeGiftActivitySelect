---@class CustomMadeGiftActivitySelect : UIBaseView	定制礼包 选择商品界面
---@field public go_table CustomMadeGiftActivitySelect_GoTable GoTable
local CustomMadeGiftActivitySelect = _G.BaseClass("CustomMadeGiftActivitySelect", _G.UIBaseView)
local CS = _G.CS
local typeof = _G.typeof

function CustomMadeGiftActivitySelect:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    self.objs_awrads = {
        [1] = self.go_table.obj_root_1,
        [2] = self.go_table.obj_root_2,
        [3] = self.go_table.obj_root_3
    }
end

---界面的入口函数
---@field cur_index number 三个槽位当前点击的位置
function CustomMadeGiftActivitySelect:OnCreate(index, sid, activity)
    self.specialIndex = {}
    self.activity = activity
    self.giftinfo = activity.typeClass:GetOneGift(sid)
    ---槽位
    if index == 0 then
        self.cur_index = 1
    else
        self.cur_index = index
    end
    self.oldindex = self.cur_index

    --池中选中 物品的 下标（服务器下发下来的）
    self.award_lists = self.giftinfo:GetCurAwardPools_selec()
    self.selcet_item = self.award_lists[self.cur_index]

    ---奖励池子中选中的物品
    self.select_pool_index_cur = self.award_lists[self.cur_index]
    self.select_pool_index_old = self.award_lists[self.cur_index]
    self.poos_obj = {}
    self.pools_ind = {}

    self:UpdateView()
    self.isReplace = false
end

function CustomMadeGiftActivitySelect:CloseTips()
    local num = 0
    local lists = self.giftinfo:GetCurAwardPools_selec()
    for i = 1, #lists do
        if lists[i] > 0 then
            num = num + 1
        end
    end
    if self.isReplace then
        if num >= self.giftinfo.totale_select then
            _G.PopWindowManager:GetInstance():ShowAllTips(
                100305,
                nil,
                function()
                    self:SureBtnOnClick()
                    self:Close()
                end,
                function()
                    self.giftinfo:ClearrData()
                    self:Close()
                end
            )
        else
            self.giftinfo:ClearrData()
            self:Close()
        end
    else
        self:Close()
    end
end

---按钮点击事件在这里派发
function CustomMadeGiftActivitySelect:OnClickBtn(go)
    if go == self.go_table.aorbtn_close or go == self.go_table.aorbtn_closeview then
        self:CloseTips()
    elseif go == self.go_table.aorbtn_next then
        self.cur_index = self.cur_index + 1
        if self.cur_index > self.giftinfo.totale_select then
            self.cur_index = 1
        end
        if _G.table.ContainsValue(self.specialIndex, self.cur_index) then
            self:OnClickBtn(go)
            return
        end
        self:NextOnClick()
    elseif go == self.go_table.aorbtn_sure then
        -- body
        self:SureBtnOnClick()
        self:Close()
    elseif go == self.go_table.aorbtn_check then
        if self.boxData then
            require "CommonTipManager":GetInstance():OpenTip(self.go_table.aorbtn_check, self.boxData.Cfg.ID)
        end
    end
end

---点击确定
function CustomMadeGiftActivitySelect:SureBtnOnClick()
    _G.PlayerPrefsManager.SetTable("dzlbcache" .. self.activity.cfg.info.type .. "by" .. self.giftinfo.sid,
        self.giftinfo.cur_AwardsPoos_select)
    self.activity.typeClass:SaveGiftInfo(self.giftinfo.sid, self.giftinfo.cur_AwardsPoos_select)
end

---点击下一个
function CustomMadeGiftActivitySelect:NextOnClick()
    if self.oldindex == self.cur_index then
        return
    end
    local tb = _G.GetAutoGoTable(self.objs_awrads[self.oldindex])
    tb.obj_select:SetActiveE(0)

    self:SetUnAwardObjOne(self.cur_index, self.giftinfo.totale_select)
    self.oldindex = self.cur_index

    self:ChangePoopsData()
end

---切换池子数据，切换其他
function CustomMadeGiftActivitySelect:ChangePoopsData()
    self.giftinfo:SetCur_AwardPools(self.cur_index)
    self.award_lists = self.giftinfo:GetCurAwardPools_selec()
    self.selcet_item = self.award_lists[self.cur_index]
    self:SetDes()

    --清空以前储存的数据
    self.select_pool_index_cur = self.giftinfo.cur_AwardsPoos_select[self.cur_index]
    self.select_pool_index_old = self.giftinfo.cur_AwardsPoos_select[self.cur_index]
    self.poos_obj = {}
    self.pools_ind = {}
    self:SetScrollView()
end

function CustomMadeGiftActivitySelect:OnclickBtnAddHave(go, go1, ison, index)
    if index == nil then --装备
        self:OnClickBtnAdd(nil, nil, go1)
    else
        self:OnClickBtnAdd(nil, nil, index)
    end
end

---点击槽位切换
function CustomMadeGiftActivitySelect:OnClickBtnAdd(go, isOn, index)
    self.cur_index = index
    if self.oldindex == self.cur_index then
        return
    end
    local tb = _G.GetAutoGoTable(self.objs_awrads[self.oldindex])
    tb.obj_select:SetActiveE(0)
    self.oldindex = self.cur_index
    self:SetUnAwardObjOne(self.cur_index, self.giftinfo.totale_select)
    self:ChangePoopsData()
end

function CustomMadeGiftActivitySelect:UpdateView()
    self:SetBtn()
    self:SetDes()
    self:SetFixedAward()
    self:SetUnAwardObj()
    self:SetScrollView()
end

---设置奖励池子的物品
function CustomMadeGiftActivitySelect:SetScrollView()
    self.gift_lists = self.giftinfo:GetCur_AwardPools()
    if self.scrollView == nil then
        self.go_table.scrollloopvectical_items:InitItemData(#self.gift_lists, _G.handler(self, self.RefreshItem))
        self.scrollView = self.go_table.scrollloopvectical_items
    else
        --self.scrollView:UpdateAllItem()
        self.scrollView:UpdateCount(#self.gift_lists)
    end
end

---滑动列表更新 (奖励池子)
function CustomMadeGiftActivitySelect:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local gift_info = self.gift_lists[index + 1]
    if gift_info == nil then
        obj:SetActiveE(0)
        return
    else
        obj:SetActiveE(1)
    end
    obj:SetName(index)
    --- local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index + 1, gift_info.index))
    local tb = _G.GetAutoGoTable(obj)

    if tb.obj_root:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root:GetChildE(), _G.ePoolType.UIItem)
    end
    local award = gift_info.info
    _G.StorageManager:GetInstance():GetItemBaseViewNew(
        award,
        tb.obj_root,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end,
        _G.handlerbind(self, self.OnClickItem, index + 1)
    )
    tb.obj_select:SetActiveE(gift_info.isOnclick and 1 or 0)

    ---设置下物品的数据
    if self.poos_obj[index + 1] == nil then
        self.poos_obj[index + 1] = {}
        self.pools_ind[index + 1] = {}
    end
    self.poos_obj[index + 1] = tb
    self.pools_ind[index + 1] = gift_info.ind

    -- if gift_info.isOnclick then
    --     self.select_pool_index_cur = index + 1
    -- end
    if gift_info.ind == self.selcet_item then
        tb.obj_select:SetActiveE(1)
    else
        tb.obj_select:SetActiveE(0)
    end
    return obj
end

function CustomMadeGiftActivitySelect:ShowSelect()
    self.selcet_item = self.award_lists[self.cur_index]
    local num = 0
    if self.selcet_item > 0 then
        for i = 1, self.gift_lists do
            if self.selcet_item == self.gift_lists[i] then
                num = i
            end
        end
    end
    return num
end

---@param index number 界面中显示的下标
---@param award_index_pools number 所在池子的下标
function CustomMadeGiftActivitySelect:OnClickItem(go, go1, isOn, index)
    if index == nil then
        self.select_pool_index_cur = go1
    else
        self.select_pool_index_cur = index
    end
    if self.select_pool_index_old == self.select_pool_index_cur then
        return
    end

    self.isReplace = true
    if self.poos_obj[self.select_pool_index_old] then
        self.poos_obj[self.select_pool_index_old].obj_select:SetActiveE(0)
    end
    if self.poos_obj[self.select_pool_index_cur] then
        self.poos_obj[self.select_pool_index_cur].obj_select:SetActiveE(1)
    end
    self.select_pool_index_old = self.select_pool_index_cur
    ---设置数据
    if self.giftinfo.cur_AwardsPoos_select[self.cur_index] == 0 then
        self.giftinfo:SetSelectNum(1)
    end
    self.giftinfo:SetGetCurAwardPools_selec(self.cur_index, self.pools_ind[self.select_pool_index_cur])
    self.award_lists = self.giftinfo:GetCurAwardPools_selec()
    self.selcet_item = self.award_lists[self.cur_index]
    self:SetDes()
    self:SetUnAwardObjOne(self.cur_index, self.giftinfo.totale_select)
    self:SetBtn()
end

---设置非固定的奖励
function CustomMadeGiftActivitySelect:SetUnAwardObj()
    for i = 1, #self.objs_awrads do
        self:SetUnAwardObjOne(i, self.giftinfo.totale_select)
    end
end

---设置单个的奖励状态
function CustomMadeGiftActivitySelect:SetUnAwardObjOne(index, show_total_num)
    local select_poos = self.giftinfo:GetCurAwardPools_selec()
    local tb = _G.GetAutoGoTable(self.objs_awrads[index], _G.handlerbind(self, self.OnClickBtnAdd, index))
    if tb.obj_root:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root:GetChildE(), _G.ePoolType.UIItem)
    end
    --检测总个数
    if index > show_total_num then
        tb.gameObject:SetActiveE(0)
    else
        tb.gameObject:SetActiveE(1)
        ---若自选栏位只配置了一个种类的奖励，则该栏位无法进行选择操作,UI上隐藏切换和添加按钮，只显示配置的奖励 jira:33090
        if #self.giftinfo.AwardPools[index] == 1 then
            tb.aorbtn_add:SetActiveE(0)
            tb.aorbtn_Replace:SetActiveE(0)
            local award = self.giftinfo:GetSelectItemInfo(index, 1).info
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                award,
                tb.obj_root,
                function(item)
                    item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                end)
            if self.giftinfo.cur_AwardsPoos_select[index] == 0 then
                self.giftinfo.cur_AwardsPoos_select[index] = 1
                self.giftinfo:SetSelectNum(1)
            end
            if not _G.table.ContainsValue(self.specialIndex, index) then
                _G.table.insert(self.specialIndex, index)
            end
        else
            if select_poos[index] == 0 then
                tb.aorbtn_add:SetActiveE(1)
                tb.aorbtn_Replace:SetActiveE(0)
            else
                tb.aorbtn_add:SetActiveE(0)
                tb.aorbtn_Replace:SetActiveE(1)
                local award = self.giftinfo:GetSelectItemInfo(index, select_poos[index]).info
                if #self.giftinfo.AwardPools[index] == 1 then
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        tb.obj_root,
                        function(item)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                    )
                else
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        tb.obj_root,
                        function(item)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end,
                        _G.handlerbind(self, self.OnclickBtnAddHave, index)
                    )
                end
            end
        end
    end
end

---设置固定奖励
function CustomMadeGiftActivitySelect:SetFixedAward()
    --固定奖励
    if self.go_table.obj_root_award_1:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root_award_1:GetChildE(), _G.ePoolType.UIItem)
    end
    local award = self.giftinfo.fixedAward
    _G.StorageManager:GetInstance():GetItemBaseView(
        award[1],
        award[2],
        self.go_table.obj_root_award_1,
        function(item)
            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
        end
    )
end

---设置描述
function CustomMadeGiftActivitySelect:SetDes()
    local strDesc, strname, starnum = "", "", ""
    local data = nil
    if self.selcet_item > 0 then
        local awrad = self.giftinfo:GetSelectItemInfo(self.cur_index, self.selcet_item).info
        data = _G.StorageManager:GetInstance():GetStorageItemData(awrad[1])
        strDesc = _G.LangUtil.GetLangPackValue(data.Cfg.Describe or data.Cfg.describe or data.Cfg.biographies1[2])
        local count = _G.StorageManager:GetInstance():GetItemCountBySid(awrad[1])
        starnum = _G.LangUtil.GetLangPackValue(90000010363, count)
        strname = data.name
    else
        strname = _G.LangUtil.GetLangPackValue(90000010362)
        starnum = _G.LangUtil.GetLangPackValue(90000010363, 0)
    end
    self.boxData = nil
    if data then
        if data.Cfg.Type1 == 4 or data.Cfg.Type1 == 8 or data.Cfg.Type1 == 9 then
            self.boxData = data
            self.go_table.aorbtn_check:SetActiveE(1)
        else
            self.go_table.aorbtn_check:SetActiveE(0)
        end
    else
        self.go_table.aorbtn_check:SetActiveE(0)
    end
    self.go_table.aortext_itemSpace:SetActiveE((self.selcet_item > 0) and 0 or 1)
    self.go_table.obj_itemDesc:SetActiveE((self.selcet_item > 0) and 1 or 0)
    self.go_table.aortext_title:SetActiveE((self.selcet_item > 0) and 0 or 1)
    self.go_table.aortext_num.text = starnum
    self.go_table.aortext_itemDesc.text = strDesc
    self.go_table.aortext_itemName.text = strname
end

---设置前往或者是下一个
function CustomMadeGiftActivitySelect:SetBtn()
    local flag = self.giftinfo:GetISNext()
    self.go_table.aorbtn_next:SetActiveE((not flag) and 1 or 0)
    self.go_table.aorbtn_sure:SetActiveE(flag and 1 or 0)
end

return CustomMadeGiftActivitySelect
