---@class CustomMadeGiftActivity : UIBaseView    定制礼包 视图类
---@field public go_table CustomMadeGiftActivity_GoTable GoTable
local CustomMadeGiftActivity = _G.BaseClass("CustomMadeGiftActivity", _G.UIBaseView)
local GetLangPackValue = _G.LangUtil.GetLangPackValue
local StoreCfg = _G.ConfigManager.store_gear_cfg
function CustomMadeGiftActivity:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    local res = _G.ConfigManager.ui_cfg.CustomMadeGiftActivity.resources
    self:AddComponent(self.go_table.obj_goldInfo, require("ResourceCompont").New(self.go_table.obj_goldInfo, res))
end

---界面的入口函数
function CustomMadeGiftActivity:OnCreate(activity)
    self.activity = activity
    self.typeClass = self.activity.typeClass
    self:InitDataView()
    self:UpdateTime()
    if self.timer == nil then
        self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
        self.timer:Start()
    end

    _G.Events:GetInstance():AddListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)

    _G.DelayDo(1, function()
        if self:IsNil() then
            return
        end
        for i = 1, #self.gift_lists do
            local giftinfo = self.gift_lists[i]
            local cur_AwardsPoos_select = _G.PlayerPrefsManager.GetTable("dzlbcache" ..
                self.activity.cfg.info.type .. "by" .. giftinfo.sid)
            if cur_AwardsPoos_select then
                self.activity.typeClass:SaveGiftInfoOther(giftinfo.sid, cur_AwardsPoos_select)
            end
        end
    end)
end

function CustomMadeGiftActivity:CloseView()
    if self.timer ~= nil then
        self.timer:Stop()
        self.timer = nil
    end
    self:Close()
end

function CustomMadeGiftActivity:OnDestroy()
    self:CloseView()
    _G.Events:GetInstance():RemoveListener(_G.ConfigManager.net_map.store_cash.Cmd, self.OnMallCashListener, self)
end

function CustomMadeGiftActivity:UpdateTime()
    local time = self.activity:GetChangeStateTime()
    if (time - 1) <= 0 then
        if self.timer ~= nil then
            self.timer:Stop()
            self.timer = nil
        end
    end
    time = _G.TimeUtil.TranslateSecondForStr(time)
    self.go_table.aortext_time.text = GetLangPackValue(90000010360, time)
end

---更新界面
function CustomMadeGiftActivity:UpdateView()
    self:InitDataView()
end

---按钮点击事件在这里派发
function CustomMadeGiftActivity:OnClickBtn(go)
    if go == self.go_table.aorbtn_help then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 82)
    elseif go == self.go_table.aorbtn_closeView or go == self.go_table.aorbtn_close then
        self:Close()
    end
end

--初始化数据
function CustomMadeGiftActivity:InitDataView()
    self.gift_lists = self.typeClass.AllGift
    _G.SortList(
        self.gift_lists,
        function(gift)
            local num = 10
            if gift:GetResidu_num() <= 0 then
                num = 9
            end
            return num, -gift.price
        end
    )
    if self.gift_obj == nil then
        self.go_table.scrollloopvectical_items:InitItemData(#self.gift_lists, _G.handler(self, self.RefreshItem))
        self.gift_obj = self.go_table.scrollloopvectical_items
    else
        self.gift_obj:UpdateAllItem()
    end
end

---滑动列表更新
function CustomMadeGiftActivity:RefreshItem(index, obj)
    if index < 0 then
        return
    end
    local giftinfo = self.gift_lists[index + 1]
    obj:SetName(index)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index, giftinfo))
    --[[    tb.aorimage_up:SetActiveE((index > 0 == true) and 1 or 0)
    if (index + 1) >= #self.gift_lists then
        tb.aorimage_down:SetActiveE(0)
    else
        tb.aorimage_down:SetActiveE(1)
    end]]
    if self.typeClass.isNew then
        local title = tonumber(giftinfo.title)
        if nil == title then
            title = giftinfo.title
        else
            title = _G.GetLangPackValue(title)
        end
        tb.aortext_title.text = title
    else
        tb.aortext_title.text = _G.ConfigManager.discrete_cfg[126701][1][index + 1]
            and _G.GetLangPackValue(_G.ConfigManager.discrete_cfg[126701][1][index + 1])
            or ""
    end
    --设置 前往按钮，确定按钮
    tb.aorbtn_go:SetGray(false)
    if giftinfo:GetSelctNum() >= giftinfo.totale_select then
        if giftinfo:GetResidu_num() <= 0 then
            tb.aorbtn_go:SetActiveE(1)
            tb.aorbtn_go:SetGray(true)
        else
            tb.aorbtn_go:SetActiveE(0)
            tb.aorbtn_star:SetActiveE(1)
        end
    else
        tb.aorbtn_go:SetActiveE(1)
        tb.aorbtn_star:SetActiveE(0)
    end
    if giftinfo:GetResidu_num() <= 0 then
        tb.aorimage_over:SetActiveE(1)
        tb.aorbtn_go:SetActiveE(0)
    else
        tb.aorimage_over:SetActiveE(0)
        tb.aorbtn_go:SetActiveE(1)
    end
    _G.GameUtil.AddDouYinIcon(tb.aorbtn_go, true, nil, nil, nil, giftinfo.price)
    local finalPrice = require "MallManager":GetInstance():GetFinalPrice(giftinfo.price)
    finalPrice = _G.tonumber(_G.GameUtil.RatioControl(finalPrice))
    if giftinfo:GetResidu_num() <= 0 then
        tb.aortext_num.text = GetLangPackValue(90000010366)
    elseif giftinfo:GetResidu_num() > 0 and finalPrice == 0 then
        tb.aortext_num.text = GetLangPackValue(90000010369)
    else
        tb.aortext_num.text = GetLangPackValue(90000010359, giftinfo:GetResidu_num())
    end
    _G.GameUtil.SetPriceByChannel(giftinfo.price, tb.aortext_nor, nil, 90023900001)

    --固定奖励
    if tb.obj_root_award_1:GetChildCountE() > 0 then
        _G.PoolsManager:GetInstance():Despawn(tb.obj_root_award_1:GetChildE(), _G.ePoolType.UIItem)
    end
    local award = giftinfo.fixedAward
    if not _G.table.isEmptyOrNil(award) then
        _G.StorageManager:GetInstance():GetItemBaseView(
            award[1],
            award[2],
            tb.obj_root_award_1,
            function(item)
                item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
            end
        )
    end

    --非固定奖励
    local un_award_obj = {
        [1] = tb.obj_root_1,
        [2] = tb.obj_root_2,
        [3] = tb.obj_root_3
    }
    self:SetUnAwardObj(un_award_obj, giftinfo)
end

---设置非固定的奖励
function CustomMadeGiftActivity:SetUnAwardObj(objs, giftinfo)
    local select_poos = giftinfo:GetCurAwardPools_selec()
    local show_total_num = giftinfo.totale_select
    for i = 1, #objs do
        local tb = _G.GetAutoGoTable(objs[i], _G.handlerbind(self, self.OnClickBtnAdd, i, giftinfo))
        if tb.obj_root:GetChildCountE() > 0 then
            _G.PoolsManager:GetInstance():Despawn(tb.obj_root:GetChildE(), _G.ePoolType.UIItem)
        end
        --检测总个数
        if i > show_total_num then
            tb.gameObject:SetActiveE(0)
        else
            tb.gameObject:SetActiveE(1)
            ---判断是不是有选中的物品
            if select_poos[i] == 0 then
                tb.aorbtn_Replace:SetActiveE(0)
                tb.aorbtn_add:SetActiveE(1)
                ---若自选栏位只配置了一个种类的奖励，则该栏位无法进行选择操作,UI上隐藏切换和添加按钮，只显示配置的奖励 jira:33090
                if #giftinfo.AwardPools[i] == 1 then
                    tb.aorbtn_add:SetActiveE(0)
                    local award = giftinfo:GetSelectItemInfo(i, 1).info
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        tb.obj_root,
                        function(item)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end)
                end
            else
                tb.aorbtn_add:SetActiveE(0)
                tb.aorbtn_Replace:SetActiveE(1)
                if #giftinfo.AwardPools[i] == 1 then
                    tb.aorbtn_Replace:SetActiveE(0)
                end
                local award = giftinfo:GetSelectItemInfo(i, select_poos[i]).info
                if #giftinfo.AwardPools[i] == 1 then
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        tb.obj_root,
                        function(item)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end
                    )
                else
                    _G.StorageManager:GetInstance():GetItemBaseViewNew(
                        award,
                        tb.obj_root,
                        function(item)
                            item:ShowNumText(true, require("ItemViewBase").NumTextAnchor.RightDown)
                        end,
                        _G.handlerbind(self, self.OnClickBtnAddHave, i, giftinfo)
                    )
                end
            end
        end
    end
end

function CustomMadeGiftActivity:OnClickBtnAddHave(go, go1, isOn, index, gift_info)
    if index == nil then
        --装备
        self:OnClickBtnAdd(nil, nil, go1, isOn)
    else
        self:OnClickBtnAdd(nil, nil, index, gift_info)
    end
end

---@param isOn number  物品为装备时，代表的时 下标
function CustomMadeGiftActivity:OnClickBtnAdd(go, isOn, index, gift_info)
    local time = self.activity:GetChangeStateTime()
    if (time - 1) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(3601)
        return
    end
    if gift_info:GetResidu_num() <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(310117)
        return
    end
    -- --点击前往 选择 商品界面
    self.typeClass:InitOneGiftInfo(gift_info.sid, gift_info)
    gift_info:SetCur_AwardPools(index)
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.CustomMadeGiftActivitySelect.Name,
        index,
        gift_info.sid,
        self.activity
    )
end

function CustomMadeGiftActivity:OnClickItem(go, isOn, index, gift_info)
    local time = self.activity:GetChangeStateTime()
    if (time - 1) <= 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(3601)
        return
    end
    if go:GetName() == "@_aorbtn_go" then
        if gift_info:GetResidu_num() <= 0 then
            _G.PopWindowManager:GetInstance():ShowAllTips(310117)
            return
        end
        local ind = gift_info:GetIndCur_Awa_poos_select()
        self.typeClass:InitOneGiftInfo(gift_info.sid, gift_info)
        gift_info:SetCur_AwardPools(ind)
        _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.CustomMadeGiftActivitySelect.Name,
            ind,
            gift_info.sid,
            self.activity
        )
    elseif go:GetName() == "@_aorbtn_star" then
        --购买
        local finalPrice = require "MallManager":GetInstance():GetFinalPrice(gift_info.price)
        if finalPrice == 0 then
            self.typeClass:FreeGift(
                gift_info.sid,
                gift_info,
                function()
                    self:UpdateView()
                end
            )
        else
            self.typeClass:BuyGit(
                gift_info.sid,
                gift_info,
                function()
                    self:UpdateView()
                end
            )
        end
    end
end

function CustomMadeGiftActivity:OnMallCashListener(data)
    local giftinfo
    for _, value in pairs(self.gift_lists) do
        if value.sid == data.sid then
            giftinfo = value
            break
        end
    end
    if giftinfo then
        local temp = {}
        for i = 1, #giftinfo.cur_AwardsPoos_select do
            temp[i] = giftinfo.cur_AwardsPoos_select[i]
        end
        giftinfo:ClearrData()
        self.typeClass:InitOneGiftInfo(data.sid, giftinfo)

        self.typeClass:SaveGiftInfoOther(data.sid, temp)
    end
end

return CustomMadeGiftActivity
