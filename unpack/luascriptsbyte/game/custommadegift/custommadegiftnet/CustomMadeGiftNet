local base = require("BaseGameNet")

---@class CustomMadeGiftNet : BaseGameNet	通信协议
local CustomMadeGiftNet = _G.BaseClass("CustomMadeGiftNet", base)
---@return CustomMadeGiftNet CustomMadeGiftNet
function CustomMadeGiftNet:GetInstance()
    return base.GetInstance(self)
end

---请求保存数据
---@param pbData table PB数据
---@param callback function 完成回调
function CustomMadeGiftNet:AccessSave(pbData, callback)
    local item = _G.ConfigManager.net_map.game_activity_module_set_choose_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---新定制活动（10060）的设置自选奖励接口
function CustomMadeGiftNet:AccessSaveNew(pbData,callback)
    local item = _G.ConfigManager.net_map.game_activity_cash_choose_new_port_set_choose_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.CallInfo))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function CustomMadeGiftNet:CallInfo(port, data, error)
    if error then
        return
    end

    --TODO 写通用数据解析，没有需要做的记得删除TODO

    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return CustomMadeGiftNet
