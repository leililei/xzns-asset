local RedPointManager = require("RedPointManager")

---@class SeasonTaskView : UIBaseView    中文描述
---@field public go_table SeasonTaskView_GoTable GoTable
---@field SeasonToggle SeasonTaskView._toggle_main_GoTable
---@field DailyToggle SeasonTaskView._toggle_daily_GoTable
---@field taskList SeasonTaskItem[]
---@field curDatas SeasonTaskData[]
local SeasonTaskView = _G.BaseClass("SeasonTaskView", _G.UIBaseView)
--_G.SeasonTaskView = SeasonTaskView
local SeasonTaskItem = require "SeasonTaskItem"
local SeasonTaskModel = require "SeasonTaskModel"
function SeasonTaskView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function SeasonTaskView:OnCreate()
    SeasonTaskItem = require "SeasonTaskItem"
    SeasonTaskModel = require "SeasonTaskModel"
    self.taskList = {}

    self:InitDatas()
    self:SortData()

    self.go_table.scrollloopvectical_week:InitItemData(self.week, _G.handler(self,self.RefreshWeek))
    self.go_table.scrollloopvectical_task:InitItemData(#self.datas[self.index] + #self.datas[0], _G.handler(self,self.RefreshTask))

    -- self.go_table.obj_redDaily:UpdateRedPointItemIDAndParam(
    --     _G.ConfigManager.redpoint_cfg.FirstMission.id,
    --     _G.SeasonTaskType.Daily
    -- )
    -- self.go_table.obj_redMain:UpdateRedPointItemIDAndParam(
    --     _G.ConfigManager.redpoint_cfg.FirstMission.id,
    --     _G.SeasonTaskType.Season
    -- )
    self:AddListener(_G.eSeasonTask.RefreshModel, self.RefreshPanel, self)
    local time = require "SeasonModel":GetInstance():GetEndTime()
    self.RTS = time - _G.TimeUtil.GetServerUnixTime()
    self:UpdateTime(self.RTS)
end
---初始化任务数据
function SeasonTaskView:InitDatas()
    local datas = SeasonTaskModel:GetInstance():GetTaskDatas()
    local JumpManager = _G.JumpManager:GetInstance()
    -- 当前为第几周
    self.week = _G.table.count(datas) - 1
    self.index = self.week
    -- 任务数据，每日任务索引为0
    self.datas = {}
    for k, v in pairs(datas) do
        ---@param data SeasonTaskData
        self.datas[k] =
            _G.table.chooseToArray(
            v,
            function(_, data)
                -----@type item_way_cfg
                if data.Cfg.link > 0 then
                    return JumpManager:CheckLinkIsOpen(data.cfg.link)
                end
                return true
            end
        )
    end
end

function SeasonTaskView:RefreshWeek(index, obj)
    if index < 0 then
        return
    end
    local go = _G.GetAutoGoTable(obj,_G.handlerbind(self, self.WeekClick,index + 1))
    go.aortext_week.text = index + 1
end

function SeasonTaskView:WeekClick(week)
    self.index = week
    local count
    if self.index == self.week then
        count = #self.datas[self.index] + #self.datas[0]
    else
        count = #self.datas[self.index]
    end
    self.go_table.scrollloopvectical_task:UpdateCount(count)
end

function SeasonTaskView:RefreshTask(index, obj)
    if index < 0 then
        return
    end
    local go = _G.GetAutoGoTable(obj, _G.handlerbind(self,self.TaskClick,index + 1))
    local data
    if self.week == self.index then
        if index + 1 <= #self.datas[0] then
            data = self.datas[0][index + 1]
        else
            data = self.datas[self.index][index + 1 - #self.datas[0]]
        end
    else
        data = self.datas[self.index][index + 1]
    end
    go.aortext_name.text = _G.GetLangPackValue(data.Cfg.desc)
    go.obj_root:RemoveAllChildren()
    for _, v in pairs(data.Cfg.reward) do
        _G.StorageManager:GetInstance():GetItemBaseViewNew(
            v,
            go.obj_root,
            function(obj)
                if self:IsNil() then
                    _G.DestroyObject(obj)
                    return
                end
                obj:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
            end
        )
    end
    if data.i_task.state == _G.TaskEnum.ETaskState.Completed then
        go.aorbtn_get:SetActiveE(0)
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Submited then
        go.aorbtn_get:SetActiveE(1)
        go.aorbtn_get:SetGray(false)
    elseif data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
        go.aorbtn_get:SetActiveE(1)
        go.aorbtn_get:SetGray(true)
    end
end

function SeasonTaskView:TaskClick(_,_,index)
    self:OnAutoGet()
end

function SeasonTaskView:UpdateTime(isNotChange,elapsed)
    if not isNotChange then
        self.RTS = self.RTS - elapsed
    end
    local time = _G.TimeUtil.TranslateSecond(_G.Mathf.RoundToInt(self.RTS))
    if time.day > 0 then
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90025500065, _G.LangUtil.GetLangPackValue(90025500011, time.day, ""))
    elseif time.hour > 0 then
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90025500065, _G.LangUtil.GetLangPackValue(90025500029, time.hour))
    else
        self.go_table.aortext_time.text =
            _G.LangUtil.GetLangPackValue(90025500065, _G.LangUtil.GetLangPackValue(90025500029, 1))
    end
end

---刷新界面
function SeasonTaskView:RefreshPanel()
    self:InitDatas()
    self.go_table.scrollloopvectical_task:InitItemData(#self.datas[self.index] + #self.datas[0], _G.handler(self,self.RefreshTask))
end

function SeasonTaskView:GetAwardCall(isAuto)
    self:SortData()
    self.go_table.scrollloopvectical_task:UpdateAllItem()
end

function SeasonTaskView:OnAutoGet()
    if not require "SeasonTaskModel":GetInstance():CheckHaveGet(self.type) then
        return
    end
    local tb = {}
    local datas = {}
    for _, v in pairs(self.datas) do
        for _, v2 in pairs(v) do
            if v2.i_task.state == _G.TaskEnum.ETaskState.Submited then
                _G.table.insert(tb, v2.Cfg.id)
                _G.table.insert(datas, v2)
            end
        end
    end
    require "SeasonTaskModel":GetInstance():GetAward(
        tb,
        function(msg)
            require "CommonTipManager".OpenCommonAwardView(msg)
            self:GetAwardCall(true)
        end
    )
end
-- -166 344
function SeasonTaskView:SortData(type)
    if not type then
        for _, datas in pairs(self.datas) do
            _G.SortList(
                datas,
                function(data)
                    local index
                    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                        index = 1
                    elseif data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                        index = 0
                    else
                        index = -1
                    end
                    return index, -data.i_task.sid
                end
            )
        end
    else
        local datas = self.datas[type]
        _G.SortList(
            datas,
            function(data)
                    local index
                    if data.i_task.state == _G.TaskEnum.ETaskState.Submited then
                        index = 1
                    elseif data.i_task.state == _G.TaskEnum.ETaskState.Claimed then
                        index = 0
                    else
                        index = -1
                    end
                return index, -data.i_task.sid
            end
        )
    end
end

function SeasonTaskView:OnStartClose()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

---按钮点击事件在这里派发
function SeasonTaskView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_autoGet then
        self:OnAutoGet()
    elseif go == self.go_table.aorbtn_CloseView then
        self:Close()
    elseif go == self.go_table.aorbtn_PlayDescribe then
        ---打开玩法说明页面
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 94)
    end
end

return SeasonTaskView
