---@class SeasonTaskItem : Component	中文描述
---@field go_table SeasonTaskView._obj_Task_GoTable
---@field data SeasonTaskData 任务数据
---@field awardList BaseAwardNewItem[]
local SeasonTaskItem = _G.BaseClass("SeasonTaskItem", _G.Component)
local BaseAwardItem = require "BaseAwardNewItem"
function SeasonTaskItem:Awake()
    self.go_table = _G.GetAutoGoTable(self.gameObject, _G.handler(self, self.OnClickBtn))
end

---创建对象时,入口构造函数
function SeasonTaskItem:OnCreate(call)
    self.call = call
    self.go_table.scrollloophorizontal_awardList:InitItemData(0, _G.handler(self, self.RefreshAward))
    self.awardList = {}
end
---@param data SeasonTaskData
function SeasonTaskItem:Show(data)
    self.data = data
    self.go_table.aortext_name.text =
        _G.string.format(
        "%s(%d/%d)",
        _G.LangUtil.GetLangPackValue(self.data.cfg.desc),
        self.data.value,
        self.data.cfg.count
    )
    self:ChangeBtn()
    self.go_table.scrollloophorizontal_awardList:UpdateCount(#self.data.cfg.reward)
end
---更改按钮显示
function SeasonTaskItem:ChangeBtn()
    self.go_table.aorbtn_get:SetActiveE(self.data.state == _G.TaskEnum.ETaskState.Completed and 1 or 0)
    self.go_table.obj_received:SetActiveE(self.data.state == _G.TaskEnum.ETaskState.Submited and 1 or 0)
    self.go_table.aorbtn_jump:SetActiveE(self.data.state == _G.TaskEnum.ETaskState.Executing and 1 or 0)
end

function SeasonTaskItem:RefreshAward(index, obj)
    local id = obj:GetInstanceIDE()
    local item = self.awardList[id]
    if _G.IsNil(item) then
        item = BaseAwardItem.New(obj, nil, 86)
    end
    item:ShowWithID(self.data.cfg.reward[index + 1])
end

---销毁对象时,析构函数
function SeasonTaskItem:OnDestroy()
end
---领取
function SeasonTaskItem:OnGet()
    require "SeasonTaskModel":GetInstance():GetAward(
        {self.data.sid},
        function(msg)
            require "CommonTipManager".OpenCommonAwardView(msg)
            self.data:UpdateTaskState()
            self:ChangeBtn()
            if self.call then
                self.call()
            end
        end
    )
end
---跳转
function SeasonTaskItem:OnJump()
    _G.JumpManager:GetInstance():Jump(self.data.cfg.link)
end

function SeasonTaskItem:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_get then
        self:OnGet()
    elseif go == self.go_table.aorbtn_jump then
        self:OnJump()
    end
end

return SeasonTaskItem
