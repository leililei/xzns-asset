---切换点击特效启用状态
function NitpickModel:ChangeClickEff(isOn)
    if not self.clickEff then
        self.clickEff = _G.UIManager:GetInstance():GetUILayerTrans(_G.UILayers.TopLayer.Name):FindE("ef_dianji")
    end
    if self.clickEff then
        self.clickRect = self.clickEff:GetComponentE(_G.typeof(_G.CS.UnityEngine.RectTransform))
        local effect = self.clickEff:FindE("effect")
        if effect then
            effect:SetActiveE(isOn and 1 or 0)
        end
    end
end

---检查关卡类型
function NitpickModel:CheckLevelType(index)
    if not index then
        index = self.curLevel
    end
    return self.levelCfg[index].type_section == 1
end

---检查红点
function NitpickModel:CheckRedpoint(param)
    if not _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(self.curFunctionOpenID) then
        return 0
    end
    if not param or param == 0 then
        if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "NewFunction") == 0 then
            return 1
        end
        if self:CheckIsGuide() and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "Jump") == 0 then
            return 1
        end
        for k, _ in pairs(self.clearDic) do
            if self.levelCfg[k] and self:CheckCanGetAward(k) then
                return 1
            end
        end
        for _, v in pairs(self.levelCfg) do
            if v and v.id then
                if not self.clearDic[v.id] and self:CheckIsUnlock(v.id) then
                    return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. v.id) == 0 and 1 or 0
                end
            end
        end
        
        return 0
    else
        if self.levelCfg[param] and self:CheckCanGetAward(param) then
            return 1
        end
        if not self.clearDic[param] and self:CheckIsUnlock(param) then
            return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. param) == 0 and 1 or 0
        end
        return 0
    end
end

function NitpickModel:CheckView(name)
    if self.isFirst then
        return name == _G.ConfigManager.ui_cfg.NitpickView.Name
    end
    return name == _G.ConfigManager.ui_cfg.NitpickMainView.Name
end

function NitpickModel:RefreshNode(param)
    require("RedPointManager"):GetInstance():RefreshNode(self.redpointId, param)
end

function NitpickModel.CheckOpen()
    return require("NitpickModel"):GetInstance():CheckIsGuide()
end

