---创建对象时,入口构造函数
function NitpickModel:__init()
    self.curFunctionOpenID = _G.ConfigManager.discrete_cfg[201610] and _G.ConfigManager.discrete_cfg[201610][1][1] or 1009
    if self:CheckIsGuide() then
        self.curFunctionOpenID = 1009
    end
    self:InitLevel()
    self:InitADCfg()
    self.gameTimeCfg = _G.ConfigManager.discrete_cfg[201601] and _G.ConfigManager.discrete_cfg[201601][1] or { 300, 600 }
    self.audioCfg = _G.ConfigManager.discrete_cfg[201602] and _G.ConfigManager.discrete_cfg[201602][1][1] or 1016
    self.delayTimeCfg = _G.ConfigManager.discrete_cfg[201603] and _G.ConfigManager.discrete_cfg[201603][1][1] or 1
    self.sealCfg = _G.ConfigManager.discrete_cfg[201604] and _G.ConfigManager.discrete_cfg[201604][1] or { 30, 1, 2 }
    self.textDelayTimeCfg = _G.ConfigManager.discrete_cfg[201605] and _G.ConfigManager.discrete_cfg[201605][1] or { 0.5, 3, 0.5 }
    self.wrongDelayTimeCfg = _G.ConfigManager.discrete_cfg[201606] and _G.ConfigManager.discrete_cfg[201606][1] or { 2, 0.5 }
    self.correctDelayTimeCfg = _G.ConfigManager.discrete_cfg[201607] and _G.ConfigManager.discrete_cfg[201607][1][1] or 0.5
    self.freeGuideLevel = _G.ConfigManager.discrete_cfg[201611] and _G.ConfigManager.discrete_cfg[201611][1] or { 1 }
    self.freeGuideTime = _G.ConfigManager.discrete_cfg[201612] and _G.ConfigManager.discrete_cfg[201612][1][1] or 3
    self.redpointId = _G.ConfigManager.redpoint_cfg.Nitpick and _G.ConfigManager.redpoint_cfg.Nitpick.id or 0
    self.guideCount = _G.ConfigManager.discrete_cfg[201608] and _G.ConfigManager.discrete_cfg[201608][1][1] or 4
end

---初始化关卡
function NitpickModel:InitLevel()
    self.curLevel = 1
    self.levelCfg = _G.ConfigManager.nitpick_cfg
    self.clearDic = {}
    self.nextLevelDic = {}
    self.beforeLevelDic = {}
    for _, v in pairs(self.levelCfg) do
        if v.level_next and v.level_next ~= 0 then
            self.nextLevelDic[v.id] = v.level_next
        end
        if v.level_before and v.level_before ~= 0 then
            self.beforeLevelDic[v.id] = v.level_before
        end
    end
end

function NitpickModel:InitADCfg()
    local cfg = _G.ConfigManager.advertisement_cfg
    local addAd = 5001
    local guideAd = 5002
    self.addTime = cfg[addAd] and cfg[addAd].reward[1][1] or 30
    self.guideTime = cfg[guideAd] and cfg[guideAd].reward[1][1] or 30
end

---从服务器拉取数据
function NitpickModel:GetDataFormServer()
    NitpickNet:GetInstance():GetInfo(
        function (msg)
            self:ParseData(msg)
        end
    )
end

---解析数据
function NitpickModel:ParseData(msg)
    self.curPassLevel = msg.pass_sid or 0
    self.awardList = msg.award_sid or {}
    if self.curPassLevel ~= 0 then
        self.clearDic[self.curPassLevel] = true
        local curSid = self.curPassLevel
        while (self.beforeLevelDic[curSid] and self.beforeLevelDic[curSid] ~= 0) do
            curSid = self.beforeLevelDic[curSid]
            self.clearDic[curSid] = true
        end
    end
    self.awardDic = {}
    for _, v in pairs(self.awardList) do
        self.awardDic[v] = true 
    end
    self.super.ParseData(self)
end

---领奖
function NitpickModel:GetAwards(sid, callback)
    local sids = {}
    if not sid then
        for k, _ in pairs(self.clearDic) do
            if not self.awardDic[k] then
                _G.table.insert(sids, k)
            end
        end
    else
        _G.table.insert(sids, sid)
    end
    NitpickNet:GetInstance():GetAward(
        { sids = sids },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            if msg.award then
                _G.StorageManager:GetInstance():ReceiveAwardData(msg)
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.CommonAwardView.Name, msg, nil, true)
            end
            for _, v in pairs(sids) do
                self.awardDic[v] = true
                self:RefreshNode(v)
            end
            if callback then
                callback()
            end
        end
    )
end

