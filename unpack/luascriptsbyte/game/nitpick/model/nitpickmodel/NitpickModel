---检测对应关卡是否已通关
function NitpickModel:CheckIsClear(sid)
    if not sid then
        sid = self.curLevel
    end
    return self.clearDic[sid]
end

---检测对应关卡是否已领取奖励
function NitpickModel:CheckIsGetAward(sid)
    if not sid then
        sid = self.curLevel
    end
    return self.awardDic[sid]
end

---检测对应关卡是否有可领取的奖励
function NitpickModel:CheckCanGetAward(sid)
    if not sid then
        sid = self.curLevel
    end
    return self:CheckIsClear(sid) and not self:CheckIsGetAward(sid)
end

---检测对应关卡是否满足开启条件
function NitpickModel:CheckIsUnlock(sid, showTips)
    local condition = 
        (_G.GameUtil.GetFunctionData(_G.FunctionBlock.game_type) == 1 and self.levelCfg[sid].bock_condition) and
        self.levelCfg[sid].bock_condition or self.levelCfg[sid].condition_type
    local isUnlock, lockType = _G.GlobalConditionManager.CheckConditionByArray(condition, true)
    local tipSid, str
    if not isUnlock then
        for k, v in ipairs(lockType) do
            local temp
            if v then
                temp, tipSid = _G.FunctionManager:GetInstance():GetStrWithType(v[1], v[2], nil, sid)
            else
                if not _G.table.isEmptyOrNil(condition) then
                    temp, tipSid = _G.FunctionManager:GetInstance():GetStrWithType(condition[k][1], condition[k][2])
                end
            end
            if k == 1 then
                str = temp
            else
                str = str .. _G.GetLangPackValue(9002010024) .. temp
            end
        end
        if showTips then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipSid, str)
        end
        return false, str
    end
    local beforeLevel = self.beforeLevelDic[sid]
    if beforeLevel and beforeLevel ~= 0 and not self.clearDic[beforeLevel] then
        str = _G.GetLangPackValue(90050300022)--通关前一关解锁
        if showTips then
            _G.PopWindowManager:GetInstance():ShowAllTips(1, str)
        end
        return false, str
    end
    return true
end

---是否开启新手引导阶段跳转
function NitpickModel:CheckIsGuide()
    return _G.GameUtil.GetFunctionData(_G.FunctionBlock.game_type) == 1
end

---是否完成引导阶段关卡数
function NitpickModel:CheckIsFinishGuide()
    if not self:CheckIsGuide() then
        return true--不开引导跳转直接视为完成
    end
    local notNewPlayer = _G.GlobalConditionManager.CheckConditionByArray(_G.ConfigManager.discrete_cfg[201609])
    if notNewPlayer then
        return true
    end
    if self:GetClearCount() >= self.guideCount and 
        _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "FinishGuide") == 0 
    then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.Nitpick .. "FinishGuide", 1)
    end
    return self:GetClearCount() >= self.guideCount
end

---检测是否已播放过开场动画
function NitpickModel:CheckIsShowEnter()
    if self:CheckIsFinishGuide() then
        return true
    end
    return _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "ShowEnter", 0) == 1
end

---检测是否有免费引导提示
function NitpickModel:CheckHasFreeGuide()
    if self:CheckIsGuide() then
        for _, v in pairs(self.freeGuideLevel) do
            if self.curLevel == v then
                return true, self.freeGuideTime
            end
        end
    end
    return false
end

---检测是否能跳过关卡
function NitpickModel:CheckCanSkip()
    if self:CheckIsGuide() then
        for _, v in pairs(self.freeGuideLevel) do
            if self.curLevel == v then
                return true
            end
        end
    end
    return false
end

---通关
function NitpickModel:ClearLevel(sid, callback)
    if self.clearDic[sid] then
        return
    end
    NitpickNet:GetInstance():ClearLevel(
        { sid = sid },
        function(msg)
            if msg.ack ~= 1 then
                return
            end
            self.clearDic[sid] = true
            self:RefreshNode()
            if callback then
                callback()
            end
        end
    )
end

---关卡结算
function NitpickModel:LevelFinish(isWin, cfg, callback)
    if cfg then--特殊结算界面直接跳，不延迟
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NitpickSettlementView.Name, isWin, cfg, callback)
    else
        _G.DelayDo(
            self.delayTimeCfg,
            function()
                _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NitpickSettlementView.Name, isWin, cfg, callback)
            end
        )
    end
end

---进入选关界面
function NitpickModel:EnterMainView(isJump, isGuide, callback)
    if isGuide then
        if self:CheckIsGuide() then--如果是渠道登录跳转的，把红点从入口处移除
            require("RedPointManager"):GetInstance():RemoveRedPointChild(_G.ConfigManager.redpoint_cfg.ReedCatkins.id, self.redpointId)
        end
        if not self.CheckIsGuide() or self:CheckIsFinishGuide() then--如果不是渠道跳转或者已经完成走正常流程
            if callback then
                callback()
            end
            return
        end
    end
    if not isGuide and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "Jump", 0) == 0 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.Nitpick .. "Jump", 1)
        self:RefreshNode()
    end
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NitpickMainView.Name, isJump, isGuide, callback)
    local isFirst = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "IsFirst", 1)
    if isFirst == 1 then
        self.isFirst = true
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.Nitpick .. "IsFirst", 0)
        self:EnterLevel()
    end
end

---进入关卡
function NitpickModel:EnterLevel(index, isNext)
    if index then
        self.curLevel = index
    end
    if isNext then
        self:CloseLevel(self.curLevel)
        self.curLevel = self:GetNextLevel()
    end
    self:OpenLevel(self.curLevel)
end

---关闭关卡界面
function NitpickModel:CloseLevel(index)
    if self:CheckLevelType(index) then
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.NitpickView.Name)
    else
        _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.NitpickSpecialView.Name)
    end
    _G.UIManager:GetInstance():ShowWindow(_G.ConfigManager.ui_cfg.NitpickMainView.Name)
end

---打开关卡界面
function NitpickModel:OpenLevel(index)
    if not self:CheckIsUnlock(index, true) then
        return
    end
    if self:CheckLevelType(index) then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NitpickView.Name, index or self.curLevel)
    else
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.NitpickSpecialView.Name, index or self.curLevel)
    end
    _G.UIManager:GetInstance():HideWindow(_G.ConfigManager.ui_cfg.NitpickMainView.Name)
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. index) == 0 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.Nitpick .. index, 1)
        self:RefreshNode(index)
    end
end

