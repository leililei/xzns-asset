end

---递归获取最终交互
function NitpickModel:GetFinalClue(sid, list)
    if not list then
        list = {}
    end
    if not sid then
        return list
    end
    local cfg = _G.ConfigManager.nitpick_Interaction_cfg[sid]
    if not (cfg.is_spine and cfg.is_spine ~= 0) then--没有下一条，是最终交互
        _G.table.insert(list, sid)
        return list
    end
    if cfg.again_id and #cfg.again_id > 0 then
        for _, v in pairs(cfg.again_id) do
            list = self:GetFinalClue(v, list)
        end
    end
    return list 
end

