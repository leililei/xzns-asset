---@class NitpickMainView : UIBaseView    诡夜魅影主界面
---@field go_table NitpickMainView_GoTable
local NitpickMainView = _G.BaseClass("NitpickMainView", _G.UIBaseView)

local LevelCount = 6--每页显示的关卡数
local MoveRadio = 0.35--滑动时下一页占比达到多少翻页
local MoveTime = 0.5--滑动未到底时动画总时长
local musicId = _G.ConfigManager.discrete_cfg[201602] and _G.ConfigManager.discrete_cfg[201602][1][1] or 1016

function NitpickMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIClosed, _G.handler(self, self.OnUIClosed), self)
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, musicId)
end

---界面入口
function NitpickMainView:OnCreate(isJump, isGuide, callback)
    self.isJump = isJump
    self.isGuide = isGuide
    self.callback = callback
    if self.isGuide and _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "IsFirst", 1) == 1 then
        self:Hide()
    end
    self:InitData()
    self:InitView()
    if _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "NewFunction", 0) == 0 then
        _G.PlayerPrefsManager.SetInt(_G.PlayerPrefsKey.Nitpick .. "NewFunction", 1)
        _G.Events:GetInstance():Broadcast(_G.DungeonChallengeBattleViewShow.Open)
        require("RedPointManager"):GetInstance():RefreshNode(_G.ConfigManager.redpoint_cfg.Nitpick.id)
    end
end

---初始化数据
function NitpickMainView:InitData()
    self.model = require("NitpickModel"):GetInstance()
    self.levelList = {}
    for _, v in pairs(self.model:GetLevelCfg()) do
        if v.level_show and v.level_show ~= 0 then
            _G.table.insert(self.levelList, v)
        end
    end
    local sortList = _G.ConfigManager.discrete_cfg[201403] and _G.ConfigManager.discrete_cfg[201403][1] or {}--关卡显示顺序
    local notSort = _G.table.isEmptyOrNil(sortList)
    _G.SortList(
        self.levelList,
        function(data)
            local showIndex = notSort and 0 or sortList[data.id]
            return -showIndex, -data.id
        end
    )
    self.pageNum = _G.math.max((_G.table.count(self.levelList) + LevelCount - 1) // LevelCount, 1)
    self.pageList = {}
    self.pageItem = {}
    self.curPage = 1
end


---初始化界面
function NitpickMainView:InitView()
    self.aspectRadio = _G.CS.UnityEngine.Screen.width / 720--以720为基准计算宽度缩放比例
    self.model:ChangeClickEff(false)
    self.curLevelList = 1
    self.nextLevelList = 2
    self.curLevelPage = 1
    self.nextLevelPage = 2
    self.showLevelList = 1
    self.go_table["scrollloopvectical_LevelList" .. self.curLevelList]:InitItemData(
        LevelCount, 
        _G.handler(self, self.RefreshCurList)
    )
    self.go_table["scrollloopvectical_LevelList" .. self.nextLevelList]:InitItemData(
        LevelCount,
        _G.handler(self, self.RefreshNextList)
    )
    self:RefreshPage(0)
    _G.SetEventTrigger(self.go_table.aorbtn_Drag, "onDragBegin", _G.handlerbind(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_Drag, "onDrag", _G.handlerbind(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_Drag, "onDragEnd", _G.handlerbind(self, self.OnDragEnd))
    self:UpdateCloseBtn()
end

---刷新当前页关卡列表
function NitpickMainView:RefreshCurList(index, obj)
    index = (LevelCount * (self.curLevelPage - 1)) + index + 1
    self:RefreshSingleList(index, obj)
end

---刷新下一页关卡列表
function NitpickMainView:RefreshNextList(index, obj)
    index = (LevelCount * (self.nextLevelPage - 1)) + index + 1
    self:RefreshSingleList(index, obj)
end

---刷新单页关卡列表
function NitpickMainView:RefreshSingleList(index, obj)
    local tb = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickItem, index))
    local cfg = self.levelList[index]
    if not cfg then
        tb.gameObject:SetActiveE(0)
        return
    end
    tb.gameObject:SetActiveE(1)
    tb.gameObject:SetName(index)
    local isUnlock, lockStr = self.model:CheckIsUnlock(index)
    tb.obj_Lock:SetActiveE(isUnlock and 0 or 1)
    tb.aortext_LockText.text = lockStr
    tb.aortext_Name.text = cfg.name ~= 0 and _G.GetLangPackValue(cfg.name) or cfg.id
    local isSpecial = cfg.type_section == 2
    tb.aorrawimage_Bg:LoadImage(
        cfg.icon,
        function(image)
            image:SetNativeSize()
        end
    )
    tb.aorrawimage_Frame:SetActiveE(isSpecial and 0 or 1)
    tb.aorrawimage_SpecialFrame:SetActiveE(isSpecial and 1 or 0)
    tb.obj_Clear:SetActiveE(self.model:CheckIsClear(index) and 1 or 0)
    tb.aorbtn_Award:SetActiveE(self.model:CheckCanGetAward(index) and 1 or 0)
    local award = cfg.reward
    tb.aorbtn_Award:SetRectTransformSize(#award > 1 and 200 or 101, #award > 1 and 140 or 85)
    for i = 1, tb.obj_AwardRoot:GetChildCountE() do
        tb.obj_AwardRoot:GetChildE(i - 1):DestroyObject()
    end
    for _, v in pairs(award) do
        _G.StorageManager:GetInstance():GetItemBaseView(
            v[1],
            v[2],
            tb.obj_AwardRoot,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                trans.gameObject:SetLocalScaleXYZ(0.5)
                trans.go_table.obj_ItemNum:SetActiveE(1)
                trans.go_table.aorbtn_Click:SetActiveE(0)
                if trans.go_table.itemLua then
                    trans.go_table.itemLua.go_table.aorbtn_Click:SetActiveE(0)
                end
                
            end
        )
    end
    tb.obj_redpoint:SetActiveE(self.model:CheckRedpoint(cfg.id))
    _G.SetEventTrigger(tb.aorbtn_Click, "onDragBegin", _G.handlerbind(self, self.OnDragBegin))
    _G.SetEventTrigger(tb.aorbtn_Click, "onDrag", _G.handlerbind(self, self.OnDrag))
    _G.SetEventTrigger(tb.aorbtn_Click, "onDragEnd", _G.handlerbind(self, self.OnDragEnd))
end

---刷新页码
function NitpickMainView:RefreshPage(index, notUpdate)
    if index then
        self.curPage = self.curPage + index
    end
    if self.showLevelList == 1 then
        self.curLevelPage = self.curPage
    else
        self.nextLevelPage = self.curPage
    end
    self:UpdatePage(index)
    self.go_table.aorbtn_Left:SetActiveE(self.curPage == 1 and 0 or 1)
    self.go_table.aorbtn_Right:SetActiveE(self.curPage == self.pageNum and 0 or 1)
    if _G.table.isEmptyOrNil(self.pageItem) then
        for i = 1, self.pageNum do
            local obj = _G.InstantiateObject(self.go_table.obj_Page, self.go_table.obj_PageList)
            obj:SetActiveE(1)
            self.pageItem[i] = _G.GetAutoGoTable(obj, _G.handlerbind(self, self.OnClickPage, i))
            self.pageItem[i].aortext_Number.text = i
            self.pageItem[i].aortext_Select.text = i
            self.pageItem[i].aortext_Select:SetActiveE(0)
        end
    end
    if index ~= 0 then
        self.pageItem[self.curPage - index].aortext_Select:SetActiveE(0)
    end
    self.pageItem[self.curPage].aortext_Select:SetActiveE(1)
    if notUpdate then
        return
    end
    self:UpdateView()
end
 
---更新返回按钮状态
function NitpickMainView:UpdateCloseBtn()
    if not self.isGuide then
        return
    end
    local tempState = _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "FinishGuide")
    self.go_table.aorbtn_Close:SetActiveE(self.model:CheckIsFinishGuide() and 1 or 0)
    if tempState ~= _G.PlayerPrefsManager.GetInt(_G.PlayerPrefsKey.Nitpick .. "FinishGuide") then--首次完成引导要求关数时显示特效
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_shouzhitishi_1,
            self.go_table.obj_CloseEff,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                local delayTime = 3
                _G.DelayDo(
                    delayTime, 
                    function()
                        if self.go_table then
                            self:OnClose()
                        end
                    end
                )
            end
        )
    end
end

---更新界面
function NitpickMainView:UpdateView()
    if not self.go_table then
        return
    end
    self.go_table.scrollloopvectical_LevelList1:UpdateCount(LevelCount)
    self.go_table.scrollloopvectical_LevelList2:UpdateCount(LevelCount)
    self:UpdateCloseBtn()
end

---更新翻页数据
function NitpickMainView:UpdatePage(move)
    local nextList = self.go_table["scrollloopvectical_LevelList" .. self.nextLevelList]
    if move > 0 then
        if self.showLevelList == 1 then
            if self.nextLevelPage ~= self.curPage - 1 then
                self.nextLevelPage = self.curPage - 1
                nextList:UpdateCount(LevelCount)
            end
        else
            if self.curLevelPage ~= self.curPage - 1 then
                self.curLevelPage = self.curPage - 1
                nextList:UpdateCount(LevelCount)
            end
        end
    else
        if self.showLevelList == 1 then
            if self.nextLevelPage ~= self.curPage + 1 then
                self.nextLevelPage = self.curPage + 1
                nextList:UpdateCount(LevelCount)
            end
        else
            if self.curLevelPage ~= self.curPage + 1 then
                self.curLevelPage = self.curPage + 1
                nextList:UpdateCount(LevelCount)
            end
        end
    end
end

---关闭关卡界面返回选关界面监听回调
function NitpickMainView:OnUIClosed(_, name)
    if name == _G.ConfigManager.ui_cfg.NitpickView.Name 
    or name == _G.ConfigManager.ui_cfg.NitpickSpecialView.Name then
        _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, musicId)
        self:UpdateView()
    end
end

function NitpickMainView:OnDragBegin(go, data)
    self.DragData = data.position
end

function NitpickMainView:OnDrag(go, data)
    local x = data.position.x - self.DragData.x
    x = x / self.aspectRadio
    x = _G.math.min(x, 720)
    x = _G.math.max(x, -720)
    self.DragMove = x
    local curList = self.go_table["scrollloopvectical_LevelList" .. self.curLevelList]
    local nextList = self.go_table["scrollloopvectical_LevelList" .. self.nextLevelList]
    local isFirst = self.curPage == 1
    local isLast = self.curPage == self.pageNum
    if isFirst then
        x = _G.math.min(x, 300)
    end
    if isLast then
        x = _G.math.max(x, -300)
    end
    curList:SetLocalPosition(x, 0)
    if (isFirst and x > 0) or (isLast and x < 0) or x == 0 then
        return
    end
    nextList:SetLocalPosition(x + (x < 0 and 720 or -720), 0)
    self:UpdatePage(x)
end

function NitpickMainView:OnDragEnd(go, data)
    local isFirst = self.curPage == 1
    local isLast = self.curPage == self.pageNum
    local distance = 720 - _G.math.abs(self.DragMove)
    local time = MoveTime * (distance / 720)
    time = _G.math.max(MoveTime / 2, time)
    local curList = self.go_table["scrollloopvectical_LevelList" .. self.curLevelList]
    local nextList = self.go_table["scrollloopvectical_LevelList" .. self.nextLevelList]
    if (isFirst and self.DragMove > 0) or (isLast and self.DragMove < 0) then
        curList:DOLocalMoveX(0, time)
        self.DragData = nil
        self.DragMove = nil
        return
    end
    if _G.math.abs(self.DragMove) < (720 * MoveRadio) then
        curList:DOLocalMoveX(0, time)
        nextList:DOLocalMoveX(self.DragMove > 0 and -720 or 720, time)
        self.DragData = nil
        self.DragMove = nil
        return
    end
    self.curLevelList = self.curLevelList == 1 and 2 or 1
    self.nextLevelList = self.nextLevelList == 1 and 2 or 1
    self.showLevelList = self.showLevelList == 1 and 2 or 1
    self:RefreshPage(self.DragMove > 0 and -1 or 1, true)
    curList:DOLocalMoveX(self.DragMove > 0 and 720 or -720, time)
    nextList:DOLocalMoveX(0, time)
    self.DragData = nil
    self.DragMove = nil
end

---点击关卡
function NitpickMainView:OnClickItem(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_Click" then
        if self.levelList[index] then
            self.model:EnterLevel(self.levelList[index].id)
        end
    elseif name == "@_aorbtn_Award" then
        self.model:GetAwards(
            nil,
            function(msg)
                self:UpdateView()
            end
        )
    end
end

---点击页码
function NitpickMainView:OnClickPage(go, isOn, page)
    if self.DragMove then--拖动翻页的时候不能点翻页按钮
        return
    end
    local dis = page - self.curPage
    if dis ~= 0 then
        self:RefreshPage(dis)
    end
end

---点击按钮
function NitpickMainView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        self:OnClose()
        if self.isJump then--其他界面打开，返回不显示功能列表界面
            return
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.DungeonChallengeHallView.Name)
    elseif go == self.go_table.aorbtn_Left then
        if self.DragMove then--拖动翻页的时候不能点翻页按钮
            return
        end
        self:RefreshPage(-1)
    elseif go == self.go_table.aorbtn_Right then
        if self.DragMove then--拖动翻页的时候不能点翻页按钮
            return
        end
        self:RefreshPage(1)
    end
end

function NitpickMainView:OnClose()
    if self.isGuide then
        if self.callback then
            self.callback()
        end
        self:Close()
    else
        self:Close()
    end
end

---类的析构函数
function NitpickMainView:OnDestroy()
    self.go_table = nil
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, _G.ConfigManager.ui_cfg.MainView.audio)
    self.model:ChangeClickEff(true)
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIClosed, _G.handler(self, self.OnUIClosed), self)
end

return NitpickMainView
