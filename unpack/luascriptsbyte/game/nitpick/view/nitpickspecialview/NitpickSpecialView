---@class NitpickSpecialView : UIBaseView    诡夜魅影特殊关卡
---@field go_table NitpickSpecialView_GoTable
local NitpickSpecialView = _G.BaseClass("NitpickSpecialView", _G.UIBaseView)

local MaskAlpha = 0.9

function NitpickSpecialView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, _G.handler(self, self.OnUIOpened), self)
end

---界面入口
function NitpickSpecialView:OnCreate(index)
    self:InitData(index)
    self:InitView()
    self:InitNumber()
    self:InitTimer()
    _G.AudioManager.PlayAudio(_G.AudioType.PlayMusic, self.cfg.audio_id)
    self:DoShuShuTrack()
end

---初始化数据
function NitpickSpecialView:InitData(index)
    self.model = require("NitpickModel"):GetInstance()
    self.cfg = _G.ConfigManager.nitpick_cfg[index] or {}
    self.numberList = self.cfg.interaction
    self.answerCfg = self.cfg.number
    self.answerItemCfg = self.model:GetAnswerItemCfg()
    self.hasFreeGuide, self.freeGuideTime = self.model:CheckHasFreeGuide()
    self.answer = {}
    self.guideDic = {}
    self.finishGuide = {}
    self.autoGuide = {}
    self.freeGuideNum = _G.ConfigManager.discrete_cfg[201613] and _G.ConfigManager.discrete_cfg[201613][1][1] or 3
    self.freeGuideCount = 0
    for i = 1, #self.numberList do
        self.answer[i] = 0
    end
    self.itemData = self.cfg.interaction or {}
    self.addTime = self.model:GetAddTime()
    self.guideTime = self.model:GetGuideTime()
    ---埋点数据
    self.showGuideDic = {}
    self.recordTime = 0
    self.solutionDic = {
        [1] = { 0, 0 },--最终交互
        [2] = { 1, 0 },--过渡交互(特殊关卡没有过渡交互)
    }
    self.adDic = {
        [1] = { 0, 0 },--谜底提示
        [2] = { 1, 0 },--延长时间
        [3] = { 2, 0 },--复活
    }
end

---初始化界面
function NitpickSpecialView:InitView()
    self.answerList = {}
    _G.SetEventTrigger(self.go_table.aorbtn_Glass, "onDragBegin", _G.handler(self, self.OnDragBegin))
    _G.SetEventTrigger(self.go_table.aorbtn_Glass, "onDrag", _G.handler(self, self.OnDrag))
    _G.SetEventTrigger(self.go_table.aorbtn_Glass, "onDragEnd", _G.handler(self, self.OnDragEnd))
    self.go_table.aortext_Name.text = _G.GetLangPackValue(self.cfg.name)
    self.go_table.aorrawimage_FrontImage:LoadImage(
            self.cfg.level_bg[1],
            function(image)
                image:SetNativeSize()
            end
    )
    self.go_table.aorrawimage_BackImage:LoadImage(
            self.cfg.level_bg[1],
            function(image)
                image:SetNativeSize()
            end
    )
    _G.PoolsManager:GetInstance():Spawn(
        self.cfg.level_bg[2],
        _G.ePoolType.Temporary,
        self.go_table.aorrawimage_FrontImage,
        function(trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
            trans:SetLocalPosition(self.cfg.spine_param[1], self.cfg.spine_param[2], self.cfg.spine_param[3])
            trans:SetLocalScaleXYZ(self.cfg.spine_scale)
            local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.AnimationState:SetAnimation(0, "idle2", true)
        end
    )
    _G.PoolsManager:GetInstance():Spawn(
        self.cfg.level_bg[2],
        _G.ePoolType.Temporary,
        self.go_table.obj_BackRoot,
        function(trans)
            if not self.go_table then
                _G.DestroyImmediate(trans)
                return
            end
            trans:SetLocalPosition(self.cfg.spine_param[1], self.cfg.spine_param[2], self.cfg.spine_param[3])
            trans:SetLocalScaleXYZ(self.cfg.spine_scale)
            local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
            sg.AnimationState:SetAnimation(0, "idle", true)
        end
    )
    self.go_table.aorrawimage_Mask.Alpha = MaskAlpha
    self.aspectRadio = _G.CS.UnityEngine.Screen.width / 720--以720为基准计算宽度缩放比例
    self.go_table.aortext_AddTime.text = "+" .. _G.GetLangPackValue(90000011450, self.addTime)
end

function NitpickSpecialView:InitNumber()
    local answerRect = self.go_table.obj_BottomPanel:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    local isExtend = #self.numberList > 6--最多显示6个，超过需要改成滑动
    self.go_table.obj_AnswerContent:SetPivotPosition(isExtend and 0 or 0.5, 0.5)
    self.go_table.obj_AnswerContent:SetAnchorPosition(0, 0)
    self.go_table.obj_AnswerContent:SetRectTransformAnchor(isExtend and 0 or 0.5, 0.5, isExtend and 0 or 0.5, 0.5)
    answerRect.horizontal = isExtend
    self.answerDic = {}
    for i = 1, #self.numberList do
        local obj = _G.InstantiateObject(self.go_table.obj_Item, self.go_table.obj_AnswerContent)
        local tb = _G.GetAutoGoTable(obj, _G.handler(self, self.OnClickItem))
        self.answerList[i] = tb
        local cfg = _G.ConfigManager.nitpick_Interaction_cfg[self.numberList[i]]
        tb.aorrawimage_Icon:LoadImage(
            cfg.icon,
            function(image)
                image:SetNativeSize()
            end
        )
        tb.aortext_Answer.text = 0
        if #self.numberList == 4 then
            tb.aorrawimage_Empty:LoadImage(self.answerItemCfg[i].text)
            tb.aortext_Answer:SetActiveE(0)
        else
            tb.aorrawimage_Empty:SetActiveE(0)
            tb.aortext_Answer:SetActiveE(1)
        end
        local answerItem = _G.InstantiateObject(self.go_table.obj_AnswerItem, self.go_table.aorrawimage_BackImage)
        local answerTb = _G.GetAutoGoTable(answerItem)
        self.answerDic[self.numberList[i]] = answerTb
        self.answerDic[self.numberList[i]].x = cfg.param[1]
        self.answerDic[self.numberList[i]].y = cfg.param[2]
        answerTb.gameObject:SetLocalPosition(cfg.param[1], cfg.param[2], cfg.param[3])
        answerTb.aorrawimage_Icon:LoadImage(
            cfg.icon,
            function(image)
                image:SetNativeSize()
            end
        )
        answerTb.aortext_Number.text = self.answerCfg[i]
    end
end

function NitpickSpecialView:InitTimer(time)
    self.remainTime = time or self.model:GetGameTime()
    self.gameTimer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.gameTimer:Start()
    self:UpdateTimeText()
    if self.hasFreeGuide then
        self.freeGuideTimer = _G.TimerManager:GetInstance():GetTimer(self.freeGuideTime, 
        function()
            self:UpdateFreeGuide()
        end, self, false, false, true)
        self.freeGuideTimer:Start()
    end
end

function NitpickSpecialView:UpdateTimer()
    if not self.go_table then
        self:StopTimer()
        return
    end
    if self.remainTime <= 1 then
        self:StopTimer()
        self:Fail()
    end
    self.remainTime = self.remainTime - 1
    self.recordTime = self.recordTime + 1
    self:UpdateTimeText()
end

function NitpickSpecialView:UpdateTimeText()
    local minute = self.remainTime // 60
    minute = _G.math.max(0, minute)
    local second = self.remainTime - (minute * 60)
    local time = minute == 0 and string.format("%02d", second) or
            string.format("%02d:%02d", minute, second)
    self.go_table.aortext_Time.text = _G.GetLangPackValue(90050300023, time)
end

function NitpickSpecialView:UpdateValue()
    local isEmpty = true
    for _, v in pairs(self.answer) do
        if v ~= 0 then
            isEmpty = false
        end
    end
    if not isEmpty then
        for k, v in pairs(self.answer) do
            self.answerList[k].aorrawimage_Empty:SetActiveE(0)
            self.answerList[k].aortext_Answer:SetActiveE(1)
            self.answerList[k].aortext_Answer.text = v
        end
    end
end

function NitpickSpecialView:UpdateGuide(isEnd, index)
    if not self.go_table then
        return
    end
    if isEnd then--发现指定引导，隐藏引导框
        self.answerDic[index].obj_Help:RemoveAllChildren()
        self.finishGuide[index] = true
        if self.lastFreeGuide and index == self.lastFreeGuide and self.freeGuideTimer then
            if self.autoGuide[index] then
                local addTime = _G.ConfigManager.discrete_cfg[201614] and _G.ConfigManager.discrete_cfg[201614][1][1] or 5
                self.freeGuideTimer.delay = self.freeGuideTimer.delay + addTime
                self.freeGuideTimer:Reset()
            end
        end
    else
        if self.lastGuide then--全部显示过，不显示引导
            if self.freeGuideTimer then
                self.freeGuideTimer:Stop()
                self.freeGuideTimer = nil
            end
            return
        end
        local guideId
        _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 16056)
        for _, id in pairs(self.numberList) do
            if not guideId and not self.guideDic[id] and self.answerDic[id] then
                local x, y = self.answerDic[id].gameObject:GetLocalPosition()
                self.guideDic[id] = { x = x, y = y, isFind = false }
                if _G.table.count(self.guideDic) ==  _G.table.count(self.numberList)then--只剩最后一个交互，后续都显示这条
                    self.lastGuide = id
                end
                guideId = id
            end
        end
        self.lastFreeGuide = self.isAutoGuide and guideId or self.lastFreeGuide
        self.autoGuide[guideId] = self.isAutoGuide
        self.isAutoGuide = false
        local tb = self.answerDic[guideId]
        self.showGuideDic[guideId] = true
        tb.obj_Help:SetActiveE(1)
        local cfg = _G.ConfigManager.nitpick_Interaction_cfg[guideId]
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg["ef_shouzhitishi_" .. cfg.type_section],
            tb.obj_Help,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
            end
        )
    end
end

function NitpickSpecialView:UpdateFreeGuide()
    if self.lastFreeGuide and not self.finishGuide[self.lastFreeGuide] then
        return
    end
    self.isAutoGuide = true
    self:UpdateGuide()
end

function NitpickSpecialView:UpdateGuideTimer()
    self:StopTimer(true)
    self:UpdateGuide(true)
end

function NitpickSpecialView:StopTimer(isGuideTimer)
    if not isGuideTimer then
        if self.gameTimer then
            self.gameTimer:Stop()
            self.gameTimer = nil
        end
        if self.freeGuideTimer then
            self.freeGuideTimer:Stop()
            self.freeGuideTimer = nil
        end
    end
    if self.guideTimer then
        self.guideTimer:Stop()
        self.guideTimer = nil
    end
end

function NitpickSpecialView:Fail()
    self:StopTimer()
    local view = _G.UIManager:GetInstance():GetWindowCtrl(_G.ConfigManager.ui_cfg.NitpickAnswerView.Name)
    if view then
        view:Close()
    end
    self:DoShuShuTrack(true)
    self.model:LevelFinish(
        false,
        nil,
        function()
            self:InitTimer(self.addTime)
            self.adDic[3][2] = self.adDic[3][2] + 1
        end
    )
end

function NitpickSpecialView:DoShuShuTrack(isLose)
    if _G.CS.Launcher.Inst.IsSDK then
        local winType = self.model.clearDic[self.cfg.id] and 2 or 1
        local json = _G.Table2Json(
            {
                nitpick_sid = self.cfg.id,
                role_uid = _G.tostring(_G.PlayerModel:GetInstance().role_uid),
                server_id = tostring(_G.ServerManager:GetInstance().CurServer.ServerID),
                record_time = self.recordTime * 1000,
                battle_result = tonumber(isLose and 0 or winType),
                solution_count = self.solutionDic,
                ad_type = self.adDic,
            }
        )
        if _G.AppSetting.DEBUG then
            _G.Log(json, "找茬结算打点")
        end
        _G.SDKManager:GetInstance():DoShushuData_track("nitpick_list", json)
    end
end

function NitpickSpecialView:OnUIOpened(_, name)
    if name == _G.ConfigManager.ui_cfg.NitpickSettlementView.Name then
        self:StopTimer()
        _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, _G.handler(self, self.OnUIOpened), self)
    end
end

function NitpickSpecialView:OnDragBegin(go, data)
    if not self.startPosition then
        self.startPosition = data.position
        local x, y = self.go_table.obj_Content:GetLocalPosition()
        self.startOffset = {
            x = self.startPosition.x - _G.CS.UnityEngine.Screen.width / 2 - x,
            y = self.startPosition.y - _G.CS.UnityEngine.Screen.height / 2 - y
        }
    end
end

function NitpickSpecialView:OnDrag(go, data)
    if self.freeGuideTimer then
        self.freeGuideTimer:Reset()
    end
    local x = data.position.x - self.startPosition.x
    local y = data.position.y - self.startPosition.y
    x = x / self.aspectRadio
    y = y / self.aspectRadio
    local contentX, contentY = self.go_table.obj_Content:GetRectTransformSize()
    local scale = self.go_table.obj_GlassMask:GetLocalScale()
    local radius = 48 * scale--镜片半径
    local maxX = (contentX / 2) - radius
    local maxY = (contentY / 2) - radius
    x = _G.math.max(x, -maxX)
    x = _G.math.min(x, maxX)
    y = _G.math.max(y, -maxY)
    y = _G.math.min(y, maxY)
    for k, v in pairs(self.answerDic) do
        if not v.isFind then
            if _G.math.abs(v.x - x) + self.startOffset.x <= radius / 0.9 and 
                _G.math.abs(v.y - y) + self.startOffset.y <= radius / 0.9
            then
                v.isFind = true
                if not self.showGuideDic[k] then--没有提示的前提下交互成功
                    self.solutionDic[1][2] = self.solutionDic[1][2] + 1
                end
                if self.guideDic[k] then
                    self.guideDic[k].isFind = true
                    self:UpdateGuide(true, k)
                else
                    self.guideDic[k] = { isFind = true }
                end
            end
        end
    end
    self.go_table.obj_Glass:SetLocalPosition(x, y)
    self.go_table.aorrawimage_BackImage:SetLocalPosition(-x, -y)
end

function NitpickSpecialView:OnDragEnd(go, data)
end

---点击输入框
function NitpickSpecialView:OnClickItem(go, isOn)
    if self.freeGuideTimer then
        self.freeGuideTimer:Pause()
    end
    _G.UIManager:GetInstance():OpenWindow(
        _G.ConfigManager.ui_cfg.NitpickAnswerView.Name,
        self.cfg,
        self.answer,
        function(answer)
            self.answer = answer
            self:UpdateValue()
            if self.freeGuideTimer then
                self.freeGuideTimer:Resume()
            end
        end,
        function()--解密成功打点回调
            self:DoShuShuTrack()
        end
    )
end

---点击按钮
function NitpickSpecialView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close then
        _G.PopWindowManager:GetInstance():ShowAllTipsExtend(
            1080502,
            nil,
            nil,
            function()
                self:DoShuShuTrack(true)
                self.model:CloseLevel(self.cfg.id)
            end,
            nil,
            nil,
            { notCall = true }
        )
    elseif go == self.go_table.aorbtn_AddTime then
        self.model:VideoAD(
            5001,
            function(isSuccess)
                if isSuccess then
                    self.remainTime = self.remainTime + self.addTime
                    self.remainTime = _G.math.min(self.model:GetGameMaxTime(), self.remainTime)
                    self.gameTimer:Reset()
                    self:UpdateTimeText()
                    self.adDic[2][2] = self.adDic[2][2] + 1
                end
                if self.freeGuideTimer then
                    self.freeGuideTimer:Reset()
                end
            end
        )
    elseif go == self.go_table.aorbtn_Help then
        if self.lastGuide then
            return
        end
        if self.hasFreeGuide then
            if self.freeGuideCount < self.freeGuideNum then
                self:UpdateGuide()
                self.freeGuideCount = self.freeGuideCount + 1
                self.adDic[1][2] = self.adDic[1][2] + 1
                return
            end
        end
        self.model:VideoAD(
            5002,
            function(isSuccess)
                if isSuccess then
                    self:UpdateGuide()
                    self.adDic[1][2] = self.adDic[1][2] + 1
                end
                if self.freeGuideTimer then
                    self.freeGuideTimer:Reset()
                end
            end
        )
    end
end

---类的析构函数
function NitpickSpecialView:OnDestroy()
    self.go_table = nil
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, _G.handler(self, self.OnUIOpened), self)
end

return NitpickSpecialView
