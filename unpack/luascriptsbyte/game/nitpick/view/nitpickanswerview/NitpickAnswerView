---@class NitpickAnswerView : UIBaseView    诡夜魅影输入答案界面
---@field go_table NitpickAnswerView_GoTable
local NitpickAnswerView = _G.BaseClass("NitpickAnswerView", _G.UIBaseView)

function NitpickAnswerView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function NitpickAnswerView:OnCreate(cfg, answer, callback, track)
    self.cfg = cfg
    self.callback = callback
    self.track = track
    self:InitData(answer)
    self:InitView()
end

---初始化数据
function NitpickAnswerView:InitData(answer)
    self.answerCfg = self.cfg.number
    self.numberList = self.cfg.interaction
    self.answerItemCfg = require("NitpickModel"):GetInstance():GetAnswerItemCfg()
    self.answer = answer
end

---初始化界面
function NitpickAnswerView:InitView()
    self.answerList = {}
    local answerRect = self.go_table.obj_AnswerRect:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    answerRect.horizontal = #self.numberList > 4--最多显示4个，超过需要改成滑动
    for i = 1, #self.numberList do
        local cfg = _G.ConfigManager.nitpick_Interaction_cfg[self.numberList[i]]
        local answer = _G.InstantiateObject(self.go_table.obj_AnswerItem, self.go_table.obj_AnswerContent)
        local answerTb = _G.GetAutoGoTable(answer, _G.handlerbind(self, self.OnClickItem, i))
        self.answerList[i] = answerTb
        answerTb.aorrawimage_Icon:LoadImage(
            cfg.icon,
            function(image)
                image:SetNativeSize()
            end
        )
        answerTb.aortext_Num.text = self.answer[i]
    end
end

---完成关卡
function NitpickAnswerView:Complete()
    local model = require("NitpickModel"):GetInstance()
    if self.track then
        self.track()
    end
    model:ClearLevel(self.cfg.id)
    model:LevelFinish(--弹特殊通关界面，结束之后再弹普通通关界面
        true, 
        self.cfg
    )
    self:Close()
end

---更新答案数值
function NitpickAnswerView:UpdateValue(index, value)
    self.answer[index] = self.answer[index] + value
    if self.answer[index] > 9 then
        self.answer[index] = 1
    end
    if self.answer[index] < 1 then
        self.answer[index] = 9
    end
    self.answerList[index].aortext_Num.text = self.answer[index]
end

function NitpickAnswerView:OnClickItem(go, isOn, index)
    local name = go:GetName()
    if name == "@_aorbtn_Up" then
        self:UpdateValue(index, 1)
    elseif name == "@_aorbtn_Down" then
        self:UpdateValue(index, -1)
    end
end

---点击按钮
function NitpickAnswerView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_Close or go == self.go_table.aorbtn_CloseView then
        if self.callback then
            self.callback(self.answer)
        end
        self:Close()
    elseif go == self.go_table.aorbtn_Sure then
        local isCorrect = true
        for k, v in pairs(self.answerCfg) do
            if self.answer[k] ~= v then
                isCorrect = false
            end
        end
        if isCorrect then
            _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 16054)
            self:Complete()
        else
            _G.AudioManager.PlayAudio(_G.AudioType.PlaySound, 16055)
            _G.PopWindowManager:GetInstance():ShowAllTips(1080501)
        end
    end
end

---类的析构函数
function NitpickAnswerView:OnDestroy()
    self.go_table = nil
end

return NitpickAnswerView
