---@class NitpickPopView : UIBaseView    诡夜魅影线索弹窗
---@field go_table NitpickPopView_GoTable
local NitpickPopView = _G.BaseClass("NitpickPopView", _G.UIBaseView)

function NitpickPopView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面入口
function NitpickPopView:OnCreate(key)
    self.cfg = key
    self:InitView()
end

---初始化界面
function NitpickPopView:InitView()
    if self.cfg ~= 0 then
        self.go_table.aortext_Text.text = _G.GetLangPackValue(self.cfg)
    end
    _G.GameUtil.ReBuildRTF(self.go_table.aortext_Text)
    local _, y = self.go_table.aortext_Text:GetRectTransformSize()
    local rect = self.go_table.obj_ScrollRect:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ScrollRect))
    rect.vertical = y > 400
end

---点击按钮
function NitpickPopView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView then
        self:Close()
    end
end

---类的析构函数
function NitpickPopView:OnDestroy()
    self.go_table = nil
end

return NitpickPopView
