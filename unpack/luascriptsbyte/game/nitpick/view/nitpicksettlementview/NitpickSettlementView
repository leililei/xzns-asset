---@class NitpickSettlementView : UIBaseView    诡夜魅影结算弹窗
---@field go_table NitpickSettlementView_GoTable
local NitpickSettlementView = _G.BaseClass("NitpickSettlementView", _G.UIBaseView)

function NitpickSettlementView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
    _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, _G.handler(self, self.OnUIOpened), self)
    _G.SetEventTrigger(self.go_table.aorbtn_Seal, "onLongPress", _G.handlerbind(self, self.OnLongPress))
    _G.SetEventTrigger(self.go_table.aorbtn_Seal, "onUp", _G.handlerbind(self, self.OnUp))
end

---界面入口
function NitpickSettlementView:OnCreate(isWin, cfg, callback)
    self.isWin = isWin
    self.cfg = cfg
    self.callback = callback
    self:InitData()
    self:InitView(isWin and self.cfg)
end

---初始化数据
function NitpickSettlementView:InitData()
    self.model = require("NitpickModel"):GetInstance()
    self.adModel = require("AdvertisementModel"):GetInstance()
    self.sealCfg = self.model:GetSealCfg()
    self.pressCount = 0
    self.clickCount = 0
    self.isComplete = false
end

---初始化界面
function NitpickSettlementView:InitView(isSpecial)
    if isSpecial then--特殊关卡胜利结算
        self.go_table.obj_Special:SetActiveE(1)
        self.go_table.aorrawimage_Bg:SetActiveE(1)
        self.go_table.obj_Win:SetActiveE(0)
        self.go_table.obj_Fail:SetActiveE(0)
        self.go_table.obj_Btn:SetActiveE(0)
        self.go_table.aorrawimage_Bg:LoadImage(
            self.cfg.level_bg[1],
            function(image)
                image:SetNativeSize()
            end
        )
        self.go_table.slider_Progress.value = 0
        _G.PoolsManager:GetInstance():Spawn(
            self.cfg.level_bg[2],
            _G.ePoolType.Temporary,
            self.go_table.obj_SpineRoot,
            function(trans)
                if not self.go_table then
                    _G.DestroyImmediate(trans)
                    return
                end
                self.sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
                if self.cfg.spine_tcscale then
                    trans:SetLocalScaleXYZ(self.cfg.spine_tcscale)
                else
                    trans:SetLocalScaleXYZ(self.cfg.spine_scale)
                end
                if self.cfg.spine_tc and #self.cfg.spine_tc > 0 then
                    trans:SetLocalPosition(self.cfg.spine_tc[1], self.cfg.spine_tc[2], self.cfg.spine_tc[3])
                else
                    trans:SetLocalPosition(self.cfg.spine_param[1], self.cfg.spine_param[2], self.cfg.spine_param[3])
                end
                _G.GameUtil.SetCardUiSpineAnimation(trans, "idle", true)
            end
        )
    else
        self.go_table.obj_Win:SetActiveE(self.isWin and 1 or 0)
        self.go_table.obj_Fail:SetActiveE(self.isWin and 0 or 1)
        self.go_table.aorbtn_AddTime:SetActiveE(self.isWin and 0 or 1)
        self.go_table.aorbtn_Go:SetActiveE(self.adModel:CheckFreeAD() and 0 or 1)
        self.go_table.obj_Btn:SetActiveE(1)
        self.go_table.aorrawimage_Bg:SetActiveE(0)
        self.go_table.obj_Special:SetActiveE(0)
        if self.isWin then
            local nextLevel = self.model:GetNextLevel()
            local isUnlock, str = self.model:CheckIsUnlock(nextLevel)
            if isUnlock then
                self.go_table.aorbtn_Next:SetActiveE(1)
                self.go_table.aorbtn_LockNext:SetActiveE(0)
            else
                self.go_table.aorbtn_Next:SetActiveE(0)
                self.go_table.aorbtn_LockNext:SetActiveE(1)
                self.go_table.aorbtn_LockNext:SetGray(true)
                self.go_table.aortext_Condition.text = str
            end
        else
            self.go_table.aorbtn_Next:SetActiveE(0)
            self.go_table.aorbtn_LockNext:SetActiveE(0)
        end
        if self.model:CheckCanSkip() and not self.isWin then
            self.go_table.aorbtn_Back:SetActiveE(0)
            self.go_table.aorbtn_Skip:SetActiveE(1)
        else
            self.go_table.aorbtn_Back:SetActiveE(1)
            self.go_table.aorbtn_Skip:SetActiveE(0)
        end
    end
end

function NitpickSettlementView:UpdateProgress()
    local value = (self.pressCount + (self.clickCount * self.sealCfg[2])) / self.sealCfg[1]
    value = _G.math.min(value, 1)
    self.go_table.slider_Progress.value = value
    if value == 1 then
        self:Complete()
    end
end

function NitpickSettlementView:UpdateSpine()
    local curTime = _G.TimeUtil.GetServerUnixTime()
    local canPlay = self.playTime and curTime - self.playTime >= self.sealCfg[3]
    if not self.playTime then
        canPlay = true
    end
    if _G.AppSetting.HeXieLevel > 0 then
        canPlay = false
    end
    if canPlay and self.sg and not self.isPlay then
        self.playTime = _G.TimeUtil.GetServerUnixTime()
        self.isPlay = true
        self.sg.AnimationState:SetAnimation(0, "show", false)
        self.sg.AnimationState:Complete("+", function()
            self.isPlay = nil
            self.sg.AnimationState:ClearTracks()
            self.sg.AnimationState:SetAnimation(0, "idle", true)
        end)
    end
end

---下一关打开时再关闭结算界面
function NitpickSettlementView:OnUIOpened(_, name)
    if name == _G.ConfigManager.ui_cfg.NitpickView.Name
            or name == _G.ConfigManager.ui_cfg.NitpickSpecialView.Name then
        self:Close()
    end
end

---长按按钮
function NitpickSettlementView:OnLongPress()
    self.pressCount = self.pressCount + 0.1
    self:UpdateProgress()
    if self.go_table.slider_Progress.value >= 1 then
        return
    end
    self.isPressing = true
    self:UpdateSpine()
end

---单击按钮
function NitpickSettlementView:OnUp()
    if self.isPressing then
        self.isPressing = false
        return
    end
    self.clickCount = self.clickCount + 1
    self:UpdateProgress()
    self:UpdateSpine()
end

function NitpickSettlementView:Complete()
    if self.isComplete then
        return
    end
    self.isComplete = true
    self:InitView()
end

---点击按钮
function NitpickSettlementView:OnClickBtn(go, isOn)
    if go == self.go_table.aorbtn_CloseView or go == self.go_table.aorbtn_Back or go == self.go_table.aorbtn_Close then
        self.model:CloseLevel()
        self:Close()
    elseif go == self.go_table.aorbtn_Go then
        _G.JumpManager:GetInstance():Jump(148001)--商城月卡界面
    elseif go == self.go_table.aorbtn_AddTime then--加时
        self.model:VideoAD(
            5001,
            function(isSuccess)
                if isSuccess then
                    if self.callback then
                        self.callback()
                        self:Close()
                    end
                end
            end
        )
    elseif go == self.go_table.aorbtn_Next or go == self.go_table.aorbtn_LockNext then
        self.model:EnterLevel(nil, true)
        self:Close()
    elseif go == self.go_table.aorbtn_Skip then
        if self.model:CheckCanSkip() then
            self.model:ClearLevel(
                self.model.curLevel,
                function()
                    self.model:CloseLevel()
                    self:Close()
                end
            )
        end
    end
end

---类的析构函数
function NitpickSettlementView:OnDestroy()
    self.go_table = nil
    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, _G.handler(self, self.OnUIOpened), self)
end

return NitpickSettlementView
