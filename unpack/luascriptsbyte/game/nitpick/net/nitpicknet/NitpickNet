local base = require("BaseGameNet")

---@class NitpickNet : BaseGameNet	通信协议
local NitpickNet = _G.BaseClass("NitpickNet", base)
---@return NitpickNet NitpickNet
function NitpickNet:GetInstance()
    return base.GetInstance(self)
end

---获取信息
function NitpickNet:GetInfo(callback)
    local pbData = self:GetEmptyPB()
    local item = _G.ConfigManager.net_map.game_mini_game_nitpick_info
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---通关
function NitpickNet:ClearLevel(pbData, callback)
    local item = _G.ConfigManager.net_map.game_mini_game_nitpick_pass
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---领奖
function NitpickNet:GetAward(pbData, callback)
    local item = _G.ConfigManager.net_map.game_mini_game_nitpick_award
    local port = base.Access(self, item, pbData, _G.handler(self, self.Callback))
    self.Call[port] = callback
end

---请求回调
---@param port number 流水号
---@param data table 返回PB数据
---@param error string 错误信息
function NitpickNet:Callback(port, data, error)
    if error then
        return
    end
    if self.Call[port] then
        self.Call[port](data)
        self.Call[port] = nil
    end
end

return NitpickNet
