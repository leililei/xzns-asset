---@class JointActivitySuperModel : Singleton	中文描述
local JointActivitySuperModel = _G.BaseClass("JointActivitySuperModel", _G.GameDataModelBase)

---@return JointActivitySuperModel JointActivitySuperModel
function JointActivitySuperModel:GetInstance()
    return self.super.GetInstance(self)
end

function JointActivitySuperModel:__init()
    self.CoinList = {}
end

function JointActivitySuperModel:CheckCoin(sid)
    if _G.table.isEmptyOrNil(self.CoinList) then
        return false
    else
        for k, v in pairs(self.CoinList) do
            if v[sid] then
                return true
            end
        end
        return false
    end
end

function JointActivitySuperModel:AddCoin(data)
    for _, v in pairs(self.CoinList) do
        if v[data[1]] then
            v[data[1]] = v[data[1]] + data[2]
        end
    end
end

---增加代币
---@param data table<table<number>>
function JointActivitySuperModel:SetCoin(activityID, data, initBol)
    if not self.CoinList[activityID] then
        self.CoinList[activityID] = {}
    end
    if self.CoinList[activityID][data.key] then
        if initBol then
            self.CoinList[activityID][data.key] = data.value
        else
            self.CoinList[activityID][data.key] = self.CoinList[activityID][data.key] + data.value
        end
    else
        self.CoinList[activityID][data.key] = data.value
    end
end

---使用代币
function JointActivitySuperModel:UseCoin(activityID, data)
    if self.CoinList[activityID] then
        self.CoinList[activityID][data.type[1]] = self.CoinList[activityID][data.type[1]] - data.type[2]
    end
end

---获取代币数量
function JointActivitySuperModel:GetCoin(sid)
    if _G.table.count(self.CoinList) > 0 then
        for k, v in pairs(self.CoinList) do
            if v[sid] then
                return v[sid]
            end
        end
    end
    return 0
end

---主活动的类型
function JointActivitySuperModel:GetMainActivityType()
    return 10067
end

---设置当前打开的活动壳子类型
function JointActivitySuperModel:SetJointActivityType(_type)
    self.curJointActivityType = _type
end

function JointActivitySuperModel:GetJointActivityType()
    return self.curJointActivityType
end

---销毁对象时,析构函数
function JointActivitySuperModel:Dispose()
    if self.activityList then
        for _, v in pairs(self.activityList) do
            v:Dispose()
        end
        self.activityList = nil
    end
end

return JointActivitySuperModel
