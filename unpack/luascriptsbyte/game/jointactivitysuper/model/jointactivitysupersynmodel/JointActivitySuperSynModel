local base = require "ActivitySynTypeBase"
local ActivitySynManager = require "ActivitySynManager"
local JointActivitySuperModel = require("JointActivitySuperModel")

---@class JointActivitySuperSynModel:ActivitySynTypeBase    联动活动
local JointActivitySuperSynModel = _G.BaseClass("JointActivitySuperSynModel", base)

local JASuperType = _G.JointActivitySuperType
local CycleDuring = 86400 * 7

---类的构造函数
function JointActivitySuperSynModel:__init()
    self.viewName = {
        [JASuperType.MT] = _G.ConfigManager.ui_cfg.MTMainView.Name,
        [JASuperType.Capybara] = _G.ConfigManager.ui_cfg.CapybaraMainView.Name,
        [JASuperType.SpringFestival] = _G.ConfigManager.ui_cfg.SpringFestivalMainView.Name
    }
    _G.Events:GetInstance():AddListener(self.curActivityClass.regiestStateChangedStr, self.StateChanged, self)
end

function JointActivitySuperSynModel:StateChanged(state)
    if state == ActivitySynManager.State.Close then
        local view = _G.UIManager:GetInstance():GetWindowCtrl(self.viewName[self.type])
        if view then
            view:OnCloseActivity(self.curActivityClass:GetActivityID())
        end
    end
end

---获取GM数据
function JointActivitySuperSynModel:OnHandleGMData(info)
    self:ParseData(info)
end

---解析数据
function JointActivitySuperSynModel:ParseData(info)
    local msg = info.new_shell or {}
    self.activityID = self.curActivityClass.activityID
    self.type = msg.activity_type or 1
    ---@type activity_new_shell.i_cycle_info[]
    self.cycleInfo = {}
    msg.cycle_info = msg.cycle_info or {}
    for _, v in pairs(msg.cycle_info) do
        self.cycleInfo[v.id] = v
    end
    self.startTime = self.curActivityClass.cfg.time.start_time
    local now = _G.TimeUtil.GetServerUnixTime()
    self.curCycle = _G.Mathf.Floor((now - self.startTime) / CycleDuring) + 1
    if msg.coin_list then
        for i = 1, #msg.coin_list do
            JointActivitySuperModel:GetInstance():SetCoin(self.activityID, msg.coin_list[i], true)
        end
    end
    base.ParseData(self)
end

---获取基础配置
function JointActivitySuperSynModel:GetBaseInfo()
    return self.cycleInfo[1] or {}
end

---获取期数配置
---@param cycle number 期数
function JointActivitySuperSynModel:GetCycleInfo(cycle)
    cycle = cycle or self.curCycle
    return self.cycleInfo[cycle + 1] or {}
end

function JointActivitySuperSynModel:GetAllCycleInfo()
    return self.cycleInfo or {}
end

---获取指定周期开始时间
---@param cycle number 期数
---@return number
function JointActivitySuperSynModel:GetCycleStartTime(cycle)
    if not self.startTime then
        return 0
    end
    local offset = (cycle - 1) * CycleDuring
    return self.startTime + offset
end

---获取全局子类型
function JointActivitySuperSynModel:GetBaseSubType()
    local info = self:GetBaseInfo()
    return info.sub_type
end

---获取指定期数子类型
function JointActivitySuperSynModel:GetCycleSubType(cycle)
    local info = self:GetCycleInfo(cycle)
    return info.sub_type
end

---获取所有子壳子subtype
function JointActivitySuperSynModel:GetAllChildSubType()
    local subTypeLis = {}
    local info = self:GetAllCycleInfo()
    for _, v in pairs(info) do
        if v.id > 1 then
            _G.table.insert(subTypeLis, v.sub_type)
        end
    end
    return subTypeLis
end

---增加门票
function JointActivitySuperSynModel:SetCoin(data)
    JointActivitySuperModel:GetInstance():SetCoin(self.activityID, data)
end

function JointActivitySuperSynModel:CheckActivityOpened()
    local state = self.curActivityClass:GetCurActivityState()
    if state == require("ActivitySynManager").State.Notice then
        return false
    end
    return state == require("ActivitySynManager").State.Open
end

---进入活动主体
function JointActivitySuperSynModel:OnEnterActivity()
    JointActivitySuperModel:GetInstance():SetJointActivityType(self.type)
    _G.UIManager:GetInstance():OpenWindow(
        self.viewName[self.type],
        self.curActivityClass,
        self.curActivityClass:GetJumpType()
    )
    if self.onEnterDoneCall then
        self.onEnterDoneCall()
        self.onEnterDoneCall = nil
    end
end

function JointActivitySuperSynModel:GetType()
    return self.type
end

function JointActivitySuperSynModel:OnGetMainViewName()
    return self.viewName[self.type]
end

---子活动列表（子壳子）
function JointActivitySuperSynModel:GetOtherActivityRedPointIds()
    if self.type == JASuperType.MT then
        return {10043}
    end
    return {10043}
end

---直系子活动列表
function JointActivitySuperSynModel:GetDirectActivityRedPointIds()
    if self.type == JASuperType.MT then
        return {10076, 10064, 10048, 10010}
    end
    return {10076, 10064, 10048, 10010}
end

---初始化红点树结构 1默认代表根节点 不允许用作其他表示序列
function JointActivitySuperSynModel:InitRedPointTree()
    self.checkRedPointFunc = {self.CheckRedPoint}
    self.redpointTree = {false}
end

function JointActivitySuperSynModel:CheckRedPoint()
    return 0
end

---检测红点
---@param index number 红点类型序列号
---@return number 红点数量
function JointActivitySuperSynModel:CheckRedPointNumChild(index)
    if self.checkRedPointFunc[index] then
        return self.checkRedPointFunc[index](self)
    end
    return 0
end

---刷新奖励红点
function JointActivitySuperSynModel:RefreshRedPoint()
    require("RedPointManager"):GetInstance():RefreshNode(self:GetRedpointIDByIndex(1))
end

---类的析构函数
function JointActivitySuperSynModel:Dispose()
    if self.curActivityClass then
        _G.Events:GetInstance():RemoveListener(self.curActivityClass.regiestStateChangedStr, self.StateChanged, self)
    end
end

return JointActivitySuperSynModel
