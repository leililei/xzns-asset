local base = require("LimitedExchangeView")

---@class MTExchangeView : LimitedExchangeView    中文描述
---@field public go_table MTExchangeView_GoTable GoTable
local MTExchangeView = _G.BaseClass("MTExchangeView", base)

local tipId = {
    noItem = 650103,
    limitCount = 650102
}

function MTExchangeView:InitView(activity)
    base.InitView(self, activity)
    self.coinSid = self.activitySynModel:GetItemSidAndNum(self.itemDatas[1].consumes[1])
    self.go_table.aorrawimage_icon:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(self.coinSid))

    --LogError(activity.activityID)
    if activity.cfg.info.front.gift_group_show then
        self.go_table.aorrawimage_role:SetActiveE(0)
        ---@type activity.i_gift_group_show
        local show = activity.cfg.info.front.gift_group_show
        for _, v in pairs(show.images) do
            local imgTb, pos
            if v.index == 1 then
                imgTb = self.go_table.aorrawimage_bg
            elseif v.index == 2 then
                imgTb = self.go_table.aorrawimage_title
            end
            pos = _G.string.split(v.xyz, "#")
            imgTb:LoadImage(
                v.path,
                function()
                    if self:IsNil() then
                        return
                    end
                    imgTb:SetNativeSize()
                    imgTb:SetLocalScaleXYZ(v.size / 10000)
                    imgTb:SetAnchorPosition(
                        _G.tonumber(pos[1]),
                        _G.tonumber(pos[2]),
                        _G.tonumber(pos[3])
                    )
                end
            )
        end
    end

    self.CloseRedPoint = _G.PlayerPrefsManager.GetInt("LimitTimeExchangeCloseRedPoint" .. self.activity:GetActivityID(), 0)
    self.go_table.aorimage_gou:SetActiveE(1 - self.CloseRedPoint)
    self.RTS = self.activity.cfg.time.start_time + self.activity.cfg.time.run_time - _G.GetNowUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTimer, self, false, false, true)
    self.timer:Start()
    self:RefreshCoin()
    self:UpdateTimer(0)
    self:AddComponent(self.go_table.obj_playerInfo, require("PlayerComponent").New(self.go_table.obj_playerInfo))
end

function MTExchangeView:RefreshView()
    base.RefreshView(self)
    self:RefreshCoin()
end

function MTExchangeView:RefreshCoin()
    self.go_table.aortext_num.text = _G.StorageManager:GetInstance():GetOtherItemCountBySid(self.coinSid) or 0
end

function MTExchangeView:RefreshItem(index, obj)
    local instanceId = obj:GetInstanceIDE()
    local x = index + 1
    obj:SetName(x)
    local tb = _G.GetAutoGoTable(obj)
    _G.AddViewBtnClick(obj, _G.handlerbind(self, self.ClickItemBtn, index + 1, tb))
    if self.itemDatas[x] then
        tb.data = self.itemDatas[x]
        -- tb["_onclick"] = _G.handlerbind(self, self.ClickItemBtn, tb)
        -- self:CreateItem(tb, instanceId)
        tb.obj_itemRoot:RemoveAllChildren()
        local tempsid = 0
        for k, v in pairs(tb.data.award) do
            local sid, num = self.activitySynModel:GetItemSidAndNum(v)
            if k == 1 then
                tempsid = sid
            end
            _G.StorageManager:GetInstance():GetItemBaseViewNew(
                { sid, num },
                tb.obj_itemRoot,
                function(tran)
                    if self:IsNil() then
                        _G.DestroyObject(tran)
                        return
                    end
                    tran:ShowNumText(true, require "ItemViewBase".NumTextAnchor.RightDown)
                    tran:ShowEffectOrder(true)
                end
            )
        end
        tb.aortext_itemname.text = tb.data.name and _G.GetLangPackValue(tb.data.name) or ""
        tb.obj_SellOut:SetActiveE(tb.data.state ~= 1 and 1 or 0)
        tb.obj_get:SetActiveE(tb.data.state == 1 and 1 or 0)
        if tb.data.state == 1 then
            tb.aortext_num.text = _G.GetLangPackValue(90033900019, tb.data.exchangeTimes, tb.data.count_limit)
            local consume_sid, consume_num = self.activitySynModel:GetItemSidAndNum(tb.data.consumes[1])
            tb.aorrawimage_Material:LoadImage(_G.StorageManager:GetInstance():GetItemIcon(consume_sid))
            tb.aortext_MaterialNum.text = _G.GameUtil.NumberToShopPrice(consume_num)
        end
        if tb.aorimage_gou then
            _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, tb.data.isGou > 0)
        end
        tb.aorbtn_gou:SetActiveE(tb.data.showGou and 1 or 0)

        --LogError(tempsid)
        local sid = tempsid
        local icfg = _G.ConfigManager.heroic_icons_cfg[sid]
        if icfg then
            local data = require "HeroicIconModel":GetInstance():GetHeroicIconBySid(sid)
            if data and tb.obj_has then
                tb.aorbtn_gou:SetActiveE(0)
                tb.obj_SellOut:SetActiveE(0)
                tb.obj_get:SetActiveE(0)
                tb.obj_has:SetActiveE(1)
            end
        end
    end
end

function MTExchangeView:UpdateTimer(elapsed)
    self.RTS = self.RTS - elapsed
    if self.RTS <= 0 then
        self.timer:Stop()
        self.timer = nil
        self:Close()
        return
    end
    self.go_table.aortext_Timer.text = _G.TimeUtil.GiftPackGroupTime(self.RTS)
end

function MTExchangeView:OpenTips()
    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 81)
end

function MTExchangeView:ChangeToggle()
    self.go_table.aorimage_gou:SetActiveE(self.CloseRedPoint)
    self.CloseRedPoint = 1 - self.CloseRedPoint
    _G.PlayerPrefsManager.SetInt("LimitTimeExchangeCloseRedPoint" .. self.activity:GetActivityID(), self.CloseRedPoint)
    self.activitySynModel:RefreshRedPointExchange()
end

function MTExchangeView:OnClickBtn(go)
    base.OnClickBtn(self, go)
    if go == self.go_table.aorbtn_toggle then
        self:RefreshToggleData()
    end
end

function MTExchangeView:ClickItemBtn(go, _, index, tb)
    if not self.activity:CheckActivityInteractable() then
        return
    end
    local name = go:GetName()
    if name == "@_aorbtn_Btn" then
        local data = self.itemDatas[index]
        if data.state ~= 1 then
            _G.PopWindowManager:GetInstance():ShowAllTips(tipId.limitCount)
            return
        else
            local needItem = data.consumes[1] and data.consumes[1].type or {}
            local haveCount
            local needCount
            if self.activity:GetJumpType() and needItem[1] == 0 then
                haveCount = self.activitySynModel:GetCoinNum(needItem[2], needItem[3])
                needCount = needItem[5]
            else
                local _, storageId = _G.StorageManager:GetInstance():CheckSidType(needItem[1])
                haveCount = _G.StorageManager:GetInstance():GetItemCountByID(storageId, needItem[1])
                needCount = needItem[2]
            end
            if not haveCount or haveCount == 0 then
                haveCount = _G.StorageManager:GetInstance():GetOtherItemCountBySid(needItem[4]) or 0
            end
            -- if haveCount < needCount then
            --     _G.PopWindowManager:GetInstance():ShowAllTips(tipId.noItem)
            --     return
            -- end
        end
        if not self.clickbtn then
            if data.award and #data.award <= 1 then
                _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.LimitedExchangeBuyView.Name,
                    data,
                    function()
                        self:RefreshView()
                        self.clickbtn = false
                    end,
                    self.activitySynModel
                )
            else
                self:OnExchange(data)
            end
        end
    elseif name == "@_aorbtn_gou" then
        local data = self.itemDatas[index]
        data.isGou = data.isGou > 0 and 0 or 1
        _G.PlayerPrefsManager.SetInt(
            "LimitTimeExchangeModelGou" .. self.activity:GetActivityID() .. data.item_sid,
            tb.data.isGou
        )
        _G.GameUtil.SetActiveByCondition(tb.aorimage_gou, data.isGou > 0)
        self:RefreshToggleData(data)
    end
end

---
---@protected
function MTExchangeView:RefreshToggleData(data)
    if data ~= nil then
        if data.isGou == 0 and self.CloseRedPoint == 0 then
            self:ChangeToggle()
        elseif data.isGou == 1 and self.CloseRedPoint == 1 then
            local isAllGou = true
            for i, v in ipairs(self.itemDatas) do
                if v.isGou == 0 then
                    isAllGou = false
                    break
                end
            end
            if isAllGou == true then
                self:ChangeToggle()
            else
                self.activitySynModel:RefreshRedPointExchange()
            end
        else
            self.activitySynModel:RefreshRedPointExchange()
        end
    else
        for i, v in ipairs(self.itemDatas) do
            if v.isGou ~= self.CloseRedPoint then
                v.isGou = self.CloseRedPoint
                _G.PlayerPrefsManager.SetInt(
                    "LimitTimeExchangeModelGou" .. self.activity:GetActivityID() .. v.item_sid,
                    v.isGou
                )
            end
        end
        self:ChangeToggle()
        self.go_table.scrollloopvectical_ItemList:UpdateAllItem()
    end
end

function MTExchangeView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
end

return MTExchangeView
