function CapybaraMainView:InitToggle()
    self.toggles = {}
    local key
    for i = 1, 3 do
        key = self.mainTypeIdDic[i]
        self.toggles[key] = _G.GetAutoGoTable(self.go_table["toggle_" .. key], _G.handlerbind(self, self.OnClickToggle, key))
        local activity = ActivitySynManager:GetInstance():GetChildAcitivity(key, self.activity:GetJumpType(self.activityId))
        if activity then
            self.toggles[key].obj_redpoint:UpdateRedPointItemIDAndParam(
                activity:GetActivityTypeCls():GetRedpointIDByIndex(1)
            )
        end
    end
    self.toggles[10067] = _G.GetAutoGoTable(self.go_table.toggle_10067, _G.handlerbind(self, self.OnClickToggle, 10067, true))
end

function CapybaraMainView:OnClickToggle(go, isOn, key, isMain)
    local tb = self.toggles[key]
    tb.aorimage_isOn:SetActiveE(isOn and 1 or 0)
    tb.aorimage_isOff:SetActiveE(isOn and 0 or 1)
    if isOn then
        if isMain then
            return
        else
            local flag = self:OnClickActivity(nil, nil, key)
            if not flag then
                self.go_table.toggle_10067.isOn = true
            end
        end
    end
end

function CapybaraMainView:UpdateTime(elapsed)
    self.countDown = self.countDown - elapsed
    if self.countDown < 0 then
        self.countDown = 0
    end
    self.go_table.aortext_countDown.text = _G.GetLangPackValue(
        90028500004,
        _G.string.AddColor(_G.TimeUtil.TranslateSecondForStr(_G.Mathf.RoundToInt(self.countDown)), "96CE51")
    )
end

---开始时间~结束时间  (日月)
function CapybaraMainView:InitActivityTime()
    local starTime = self.activity.cfg.time.start_time
    local start = _G.TimeUtil.GetDateTime(starTime)
    local endt = _G.TimeUtil.GetDateTime(starTime + self.activity.cfg.time.run_time)
    self.go_table.aortext_time.text = _G.GetLangPackValue(
        90025800003,
        _G.string.AddColor(start.month .. "." .. start.day .. "~" .. endt.month .. "." .. endt.day, "96CE51")
    )
end

---初始化丶更新当前显示周期
function CapybaraMainView:UpdateCycleIndex()
    local cycleInfo = self.typeClass:GetCycleInfo()
    local cycleIndex = cycleInfo.id - 1

    if self.curIndex and cycleIndex - self.curIndex > 1 then
        --如果零点刷新时展示的不是上一期的界面, 则不要进行刷新
        cycleIndex = self.curIndex
    end
    self:SetCycleIndex(cycleIndex)
end

---更新显示周期
---@param cycleIndex number 周期索引
function CapybaraMainView:SetCycleIndex(cycleIndex)
    local lastCycleIndex = self.curIndex --记录上一个选中的周期

    local cycleInfo = self.typeClass:GetCycleInfo(cycleIndex)
    if cycleInfo then
        self.curIndex = cycleIndex
    else
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到第%s周期配置", cycleIndex))
        end
        cycleInfo = self.typeClass:GetCycleInfo()
        self.curIndex = cycleInfo.id - 1
    end

    if cycleInfo and cycleInfo.sub_type then
        self.childActivity = ActivitySynManager:GetInstance():GetChildAcitivity(10043, cycleInfo.sub_type)
        if not self.childActivity then
            self:CheckActivityData()
        end
    else
        self:CheckActivityData()
    end

    --策划一个子活动壳子都没同步
    if not self.childActivity then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到第%s周期的活动实例(id=10043)", self.curIndex))
        end
        return
    end

    if not self.page[self.curIndex] then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到第%s周期的主节点", self.curIndex))
        end
        return
    end

    require("JointActivityModel"):GetInstance():SetJointActivityType(self.childActivity.typeClass.type)
    if lastCycleIndex == self.curIndex then
        return
    end

    --初始化当前周期主节点
    local cycleNode = self.page[self.curIndex]
    for _, item in pairs(self.page) do
        item.gameObject:SetActiveE(item == cycleNode and 1 or 0)
    end
    cycleNode:Init()
    cycleNode:InitActivities(self.activity, self.childActivity, self.typeIdDic[self.curIndex])

    ---下一个节点解锁状态
    self:UpdateCycleNextTime()
    if self.nextUnlockTimer then
        self.nextUnlockTimer:Stop()
        self.nextUnlockTimer = nil
    end
    local nextStartTime = self.typeClass:GetCycleStartTime(self.curIndex + 1)
    if nextStartTime > 0 and nextStartTime > _G.TimeUtil.GetServerUnixTime() then
        self.nextUnlockTimer = _G.TimerManager:GetInstance():GetTimer(60, self.UpdateCycleNextTime, self, false, false, true)
        self.nextUnlockTimer:Start()
    end
end

---更新下一个周期解锁时间
function CapybaraMainView:UpdateCycleNextTime()
    if not self.curIndex or not self.page[self.curIndex] then
        return
    end

    local cycleNode = self.page[self.curIndex]

    ---获取下一个节点解锁状态
    local nextStartTime = self.typeClass:GetCycleStartTime(self.curIndex + 1)
    if nextStartTime <= 0 then
        cycleNode:SetLockTip(_G.GetLangPackValue(90028500005))
        if self.nextUnlockTimer then
            self.nextUnlockTimer:Stop()
            self.nextUnlockTimer = nil
        end
        return
    end

    local remainTime = nextStartTime - _G.TimeUtil.GetServerUnixTime()
    if remainTime > 0 then
        local t = _G.TimeUtil.TranslateSecond(remainTime)
        local tStr
        if t.day > 0 then
            tStr = _G.GetLangPackValue(90022100001, t.day, t.hour)
        else
            tStr = _G.GetLangPackValue(90022100002, t.hour, t.min)
        end
        cycleNode:SetLockTip(_G.GetLangPackValue(90034501011, tStr))
    else
        cycleNode:SetLockTip(nil)
        if self.nextUnlockTimer then
            self.nextUnlockTimer:Stop()
            self.nextUnlockTimer = nil
        end
    end
end

---防止策划同步的subtype与当期时间不符
function CapybaraMainView:CheckActivityData()
    local allInfo = self.typeClass:GetAllCycleInfo()
    local activity
    for _, v in pairs(allInfo) do
        if v.id > 1 then
            activity = ActivitySynManager:GetInstance():GetChildAcitivity(10043, v.sub_type)
            if activity then
                self.curIndex = v.id - 1
                self.childActivity = activity
                break
            end
        end
    end
end

function CapybaraMainView:OnClickActivity(_, _, type)
    LogError(type)
    require("JointActivitySuperModel"):GetInstance():SetJointActivityType(self.typeClass.type)
    _G.GlobalInterface.JumpActivityByGM(type, self.activity:GetJumpType(self.activityId))
    return true
end

function CapybaraMainView:OnCloseActivity(activityId)
    if self.activityId == activityId then
        self:Close()
    end
end

---监听周期切换事件
---@param cycleNode CapybaraMainView_CycleComponent 点击的周期节点
---@param type number @1,下一个周期 -1,上一个周期
function CapybaraMainView:OnClickCycle(cycleNode, type)
    local seekCycleIndex = cycleNode:GetCycleIndex() + type
    local seekCycleInfo = self.typeClass:GetCycleInfo(seekCycleIndex)
    if
    not seekCycleInfo or not seekCycleInfo.sub_type or
        not ActivitySynManager:GetInstance():GetChildAcitivity(10043, seekCycleInfo.sub_type)
    then
        if _G.AppSetting.DEBUG then
            _G.LogError(string.format("找不到第%s周期的活动实例(id=10043)", seekCycleIndex))
        end
        return
    end

    self:SetCycleIndex(seekCycleIndex)
end

function CapybaraMainView:OnUIClosed(name)
    if self.childWinName[name] then
        self.go_table.toggle_10067.isOn = true
    end
end

---界面的销毁函数
function CapybaraMainView:OnDestroy()
    if self.timer then
        self.timer:Stop()
        self.timer = nil
    end
    if self.nextUnlockTimer then
        self.nextUnlockTimer:Stop()
        self.nextUnlockTimer = nil
    end
    self:RemoveAllListener()
end

---按钮点击事件在这里派发
function CapybaraMainView:OnClickBtn(go)
    if go == self.go_table.aorbtn_close then
        self:Close()
    elseif go == self.go_table.aorbtn_help then
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GamePlayDescribeView.Name, 155)
    elseif go == self.go_table.aorbtn_sign then
        self:OnClickActivity(nil, nil, self.mainTypeIdDic[4])
    end
end

return CapybaraMainView
