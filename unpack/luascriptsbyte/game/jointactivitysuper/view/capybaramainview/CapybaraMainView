local ActivitySynManager = require "ActivitySynManager"
local CapybaraMainView_CycleComponent = require("CapybaraMainView_CycleComponent")

---@class CapybaraMainView : UIBaseView    中文描述
---@field public go_table CapybaraMainView_GoTable GoTable
---@field page CapybaraMainView_CycleComponent[]
---@field curIndex number                                           @当前选中的周期索引
---@field nextUnlockTimer Timer                                     @下一个周期解锁时间定时器
local CapybaraMainView = _G.BaseClass("CapybaraMainView", _G.UIBaseView)

local CycleBackgrounds = {
    "",
    "",
    "",
    "",
    ""
}

function CapybaraMainView:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))
end

---界面的入口函数
function CapybaraMainView:OnCreate(activity)
    self.activityId = activity:GetActivityID()
    self.activity = activity
    self.typeClass = activity.typeClass

    --初始化周期节点, 对应typeIdDic周期数
    local swicthCallback = _G.handler(self, self.OnClickCycle)
    self.page = {}
    for cycleIndex = 1, 5 do
        local cycleNode = self.go_table["obj_cycle" .. cycleIndex]
        if not cycleNode then
            break
        end
        cycleNode:SetActiveE(1)
        table.insert(
            self.page,
            self:AddComponent(
                cycleNode,
                CapybaraMainView_CycleComponent.New(
                    self.go_table.trans_role,
                    swicthCallback,
                    cycleIndex,
                    CycleBackgrounds[cycleIndex],
                    self.typeClass
                )
            )
        )
    end
    self.childWinName = {
        [_G.ConfigManager.ui_cfg.MTExchangeView.Name] = true,
        [_G.ConfigManager.ui_cfg.MTGloryAssemblyView.Name] = true,
        [_G.ConfigManager.ui_cfg.GuideBookTaskView.Name] = true
    }

    self:InitTypeDict()
    self:InitToggle()
    local signActivity = ActivitySynManager:GetInstance():GetChildAcitivity(
        self.mainTypeIdDic[4],
        self.activity:GetJumpType(self.activityId)
    )
    if signActivity then
        self.go_table.obj_redpointSigh:UpdateRedPointItemIDAndParam(
            signActivity:GetActivityTypeCls():GetRedpointIDByIndex(1)
        )
    end
    self.go_table.toggle_10067.isOn = false
    self.go_table.toggle_10067.isOn = true
    -- self:InitActivityTime()
    self:UpdateCycleIndex()

    local time = self.activity.cfg.time
    self.countDown = time.start_time + time.run_time - _G.TimeUtil.GetServerUnixTime()
    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false, false, true)
    self.timer:Start()
    self:UpdateTime(0)

    self:AddListener(_G.eSixUpdate.SixClockUpdate, self.UpdateCycleIndex, self)
    self:AddListener(_G.eUIManagerStatus.OnUIClosed, self.OnUIClosed, self)
    -- self.resource = self:AddComponent(
    --     self.go_table.obj_GoldInfo,
    --     require("ResourceCompont").New(self.go_table.obj_GoldInfo,
    --         _G.ConfigManager.ui_cfg.CapybaraMainView.resources)
    -- )
end

