---初始化节点(多次调用只执行一次)
function MTMainView_CycleComponent:Init()
    if self.isInit then
        return
    end
    self.isInit = true

    if self.go_table.obj_next then
        self.nextItem = _G.GetAutoGoTable(self.go_table.obj_next)
        
        _G.AddViewBtnClick(self.nextItem.gameObject, _G.handlerbind(self, self.OnClickSwitchCycle, self.nextItem))
        self.nextItem.aortext_name.text = self:GetOtherCycleName(1)
    end
    if self.go_table.obj_last then
        self.lastItem = _G.GetAutoGoTable(self.go_table.obj_last)
        _G.AddViewBtnClick(self.lastItem.gameObject, _G.handlerbind(self, self.OnClickSwitchCycle, self.lastItem))
        self.lastItem.aortext_name.text = self:GetOtherCycleName(-1)
    end
    self:LoadBackground()
    self:InitActivityItems()
    self:InitRole()
    self:InitNextRole()
    self:SetLockTip(nil)
end

---@param type number @1,下一个周期 -1,上一个周期
function MTMainView_CycleComponent:GetOtherCycleName(type)
    local seekCycleIndex = self.cycleIndex + type
    if self.mainActTypeClass then 
        local seekCycleInfo = self.mainActTypeClass:GetCycleInfo(seekCycleIndex)
        if seekCycleInfo and seekCycleInfo.sub_type then 
            local actInfo = ActivitySynManager:GetInstance():GetChildAcitivity(10043, seekCycleInfo.sub_type)
            if not actInfo then
                if _G.AppSetting.DEBUG then
                    _G.LogError(string.format("找不到第%s周期的活动实例(id=10043)", seekCycleIndex))
                end
            else 
                return actInfo.cfg.info.name
            end
        end
    end
    return type == 1 and "next" or "last"
end

---设置活动实例
---@param activity ActivitySynGMActivity 活动实例
---@param childTypes number[] 子活动类型列表
function MTMainView_CycleComponent:InitActivities(parent, activity, childTypes)
    self.parent = parent
    self.activity = activity
    self.childTypes = childTypes
    self:SetRoleSeatIndex(self.roleSeatIndex or 1) --角色位置还原为1

    ---初始化节点表现
    for i, item in ipairs(self.activityItems) do
        item.type = childTypes[i]
        item.gameObject:SetActiveE(childTypes[i] and 1 or 0)

        if childTypes[i] then
            self:UpdateActivityItem(item, childTypes[i])
        end
    end

    if _G.AppSetting.DEBUG then
        for i = #self.activityItems + 1, #childTypes do
            _G.LogError(string.format("找不到第%s周期的子活动%s入口节点", self.cycleIndex, childTypes[i]))
        end
    end
end

---设置人物坐标位置
---@param index number 活动项索引
function MTMainView_CycleComponent:SetRoleSeatIndex(index)
    self.roleSeatIndex = index
    self.roleMove = false
    self:UpdateRoleAnimation(PlayerAnimations.Idle, true, 1)

    if self.roleRoot then
        self.roleRoot.transform:DOKill()
        local bPos = self:GetActivitySeatPosition(index)
        if bPos then
            self.roleRoot.transform:SetPosition(bPos[1], bPos[2], bPos[3])
        end
    end
end

---使角色移动到活动节点位置
---@param index number 活动项索引
---@param callback function 移动完成回调
---@param forceUpdate boolean 是否强制更新位置
function MTMainView_CycleComponent:PlayRoleSeatIndex(index, callback)
    local beforeIndex = self.roleSeatIndex or 1
    self.roleSeatIndex = index
    if not self.roleRoot or beforeIndex == index then
        if callback then
            callback()
        end
        return
    end

    --初始化起始位置
    self.roleRoot.transform:DOKill()
    local positions = self:FindActivityMovePaths(beforeIndex, index)
    --如果角色正在移动中
    if self.roleMove and positions then
        local x, y            = self.roleRoot.transform:GetPosition()
        local index, distance = -1, 99999999
        for i, pos in ipairs(positions) do
            local d = math.sqrt((pos[1] - x) ^ 2 + (pos[2] - y) ^ 2)
            if d < distance then
                index, distance = i, d
            end
        end
        if index >= 1 then
            for i = #positions, 1, -1 do
                if i < index then
                    table.remove(positions, i)
                end
            end
        end
    end
    --创建角色移动动画
    if positions and #positions >= 2 then
        local sx, sy, sz = self.roleRoot.obj_model:GetLocalScale()
        local speed = PlayerMoveSpeed * self.gameObject:GetWorldScale() --取scaleX

        self.roleMove = true
        self:UpdateRoleAnimation(PlayerAnimations.Move, true, PlayerMoveAnimationScale)

        local sequence = _G.CS.DG.Tweening.DOTween.Sequence()
        for i = 2, #positions do
            local cur, last = positions[i], positions[i - 1]
            local distance = math.sqrt((cur[1] - last[1]) ^ 2 + (cur[2] - last[2]) ^ 2)
            --获取Vector3实例对象
            local vector3 = cur.__vector3
            if not vector3 then
                vector3 = _G.Vector3.New(cur[1], cur[2], cur[3])
                cur.__vector3 = vector3
            end
            --创建Tween动画
            local moveTween = self.roleRoot.transform:DOMove(vector3, distance / speed)
            moveTween:SetEase(_G.CS.DG.Tweening.Ease.Linear)
            if cur[1] ~= last[1] then
                local flip = cur[1] >= last[1] and 1 or -1
                sequence:AppendCallback(function()
                    self.roleRoot.obj_model:SetLocalScale(math.abs(sx) * flip, sy, sz)
                end)
            end
            sequence:Append(moveTween)
        end
        sequence:AppendCallback(function()
            self.roleMove = false
            self:UpdateRoleAnimation(PlayerAnimations.Idle, true, 1)
        end)
        if callback then
            sequence:AppendInterval(0.2)
            sequence:OnComplete(callback)
        end
        sequence:SetTarget(self.roleRoot.transform)
    else
        --重置角色位置
        self.roleMove = false
        local pos = self:GetActivitySeatPosition(index)
        if pos then
            self.roleRoot.transform:SetPosition(pos[1], pos[2], pos[3])
        end

        if callback then
            callback()
        end
    end
end

---锁定下一关节点
---@param tip? string 提示文本(传空表示已解锁)
function MTMainView_CycleComponent:SetLockTip(tip)
    self.lockTip = tip

    if self.nextItem then
        self.nextItem.obj_lock:SetActiveE(tip and 1 or 0)
        if tip then
            self.nextItem.aortext_lockTip.text = tip
        end
    end
    if self.lockRoleGraphic then
        self.lockRoleGraphic.color = tip and RoleLockColor or RoleUnlockColor
    end
    if self.lockimageflag then
        _G.GameUtil.SetActiveByCondition(self.lockimageflag, not self.lockTip)
    end
end

---加载周期背景图
---@param callback function 加载完成回调
function MTMainView_CycleComponent:LoadBackground(callback)
    if not self.bg or #self.bg == 0 then
        if callback then
            callback()
        end
        return
    end
    local path = self.bg
    self.bg = nil --防止多次调用

    if self.go_table.aorrawimage_bg and #path > 0 then
        self.go_table.root.aorrawimage_bg.color = _G.Color.New(0, 0, 0, 1)
        self.go_table.root.aorrawimage_bg:LoadImage(path, function()
            if _G.IsNil(self.gameObject) then
                return
            end
            self.go_table.root.aorrawimage_bg.color = _G.Color.New(0, 0, 0, 1)
            self.go_table.root.aorrawimage_bg:SetNativeSize()

            if callback then
                callback()
            end
        end)
    else
        if callback then
            callback()
        end
    end
end

---初始化活动根节点
---@private
---@param count? number 活动项数量(默认: 10)
function MTMainView_CycleComponent:InitActivityItems(count)
    count = math.max(1, count or 10)

    self.activityItems = {}
    for i = 1, count do
        local obj = self.go_table["obj_activity" .. i]
        if not obj then
            break
        end
        local activityItem = _G.GetAutoGoTable(obj)
        _G.AddViewBtnClick(activityItem.gameObject, _G.handlerbind(self, self.OnClickActivity, activityItem))
        table.insert(self.activityItems, activityItem)
    end
end

---初始化角色
---@private
function MTMainView_CycleComponent:InitRole()
    --加载当期角色
    ---@type MTMainView._obj_role_GoTable
    local roleTb = _G.GetAutoGoTable(_G.InstantiateObject(self.rolePrefab, self.gameObject))
    roleTb.gameObject:SetActiveE(1)
    --roleTb.aorimage_flag.SpriteName = PlayerFlags[self.cycleIndex] or PlayerFlags[#PlayerFlags]
    roleTb.aorimage_flag.SpriteName = nil
    roleTb.aorimage_flag.Alpha = 0
    _G.UIUtils.LoadEffectByCfg(
        self.PlayerEffectFlags[self.cycleIndex],
        roleTb.aorimage_flag,
        function(trans)
            if self.go_table == nil then
                _G.DestroyObject(trans)
            end
        end
    )
    if roleTb.yw == nil then
        roleTb.yw = 1
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_cycle1_yw,
            roleTb.obj_moveeffect,
            function(trans)
                if self.go_table == nil then
                    _G.DestroyObject(trans)
                end
            end
        )
    end
    --初始化位置
    self.roleRoot = roleTb
    local initPos = self.roleSeatIndex and self:GetActivitySeatPosition(self.roleSeatIndex)
    if initPos then
        self.roleRoot.transform:SetPosition(initPos[1], initPos[2], initPos[3])
    end
    _G.PoolsManager:GetInstance():Spawn(
        self.PlayerModels[self.cycleIndex] or self.PlayerModels[#self.PlayerModels],
        _G.ePoolType.Static,
        roleTb.obj_model,
        function(trans)
            if _G.IsNil(self.gameObject) then
                _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Static)
                return
            end
            trans:SetLocalPositionToZero()
            trans:SetLocalScaleXYZ(1)
            self.roleGraphic = trans:GetComponentInChildrenE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))

            self:UpdateRoleAnimation(PlayerAnimations.Idle, true, 1)
        end
    )
end

