---更新活动节点状态
---@private
---@param activityItem _obj_cycle1._obj_activity1_GoTable|{type:number,interValDay:number,tipContent:number}
---@param type number 活动类型
function MTMainView_CycleComponent:UpdateActivityItem(activityItem, type)
    activityItem.interValDay = 0
    activityItem.tipContent = nil

    ---@type ActivitySynGMActivity
    local activity = ActivitySynManager:GetInstance():GetChildAcitivity(
        type,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if activity then
        activityItem.obj_redpoint:UpdateRedPointItemIDAndParam(activity:GetActivityTypeCls():GetRedpointIDByIndex(1))
        activityItem.obj_lock:SetActiveE(0)
        activityItem.aortext_name.text = self:GetActivityName(activity)
        return
    end
    activity = ActivitySynManager:GetInstance():GetNotOpenAcitivity(
        type,
        self.activity:GetJumpType(),
        self.activity:GetMainType()
    )
    if activity then
        activityItem.obj_lock:SetActiveE(1)
        activityItem.obj_eff:SetActiveE(0)
        activityItem.aortext_name.text = self:GetActivityName(activity)
        local isPass, content = self:CheckActivityConditionPatams(activity.info)
        if not isPass then
            activityItem.tipContent = content
            activityItem.aortext_lockTip.text = content
        else
            activityItem.interValDay = _G.TimeUtil.GetInterValDayByGame(
                _G.TimeUtil.GetServerUnixTime(),
                activity.time.start_time
            )
            activityItem.aortext_lockTip.text = _G.GetLangPackValue(90028300082, activityItem.interValDay)
        end
    else
        activityItem.obj_lock:SetActiveE(0)
        activityItem.obj_eff:SetActiveE(1)
    end
end

---检测GM活动限制条件
---@private
---@param params table 限制条件{{type=t,value=param, list = list},{type=t,value=param}}
---@return boolean @是否满足显示条件
function MTMainView_CycleComponent:CheckActivityConditionPatams(params)
    params = params.front
    if not params then
        return true
    end
    params = params.con
    if not params then
        return true
    end
    for i = 1, #params do
        local isPass, _, content =
            _G.GlobalConditionManager.CheckConditionArrays({ { params[i].type, params[i].value, params[i].list } })
        if not isPass then
            return false, content
        end
    end
    return true
end

---获取活动名称
---@param activity ActivitySynGMActivity
function MTMainView_CycleComponent:GetActivityName(activity)
    local name = activity.cfg and activity.cfg.info.name or activity.info.name
    local languageId = tonumber(name)
    if languageId then
        name = _G.GetLangPackValue(languageId)
    end
    return name
end

---获取活动路径信息(第一个节点为活动本身站位, 之后的节点为通往下一个活动的路径)
---@param activityIndex number 活动索引
---@return number[][]
function MTMainView_CycleComponent:GetActivityPositions(activityIndex)
    if not self.roleSeatPositions then
        self.roleSeatPositions = {}
    end

    local positions = self.roleSeatPositions[activityIndex]
    if positions == false then
        --节点初始化失败
        return nil
    end
    if not positions then
        positions = {}
        local activityItem = self.activityItems[activityIndex]
        if activityItem and activityItem.obj_seat then
            local x, y, z = activityItem.obj_seat:GetPosition()
            table.insert(positions, { x, y, z })
            --子节点路径
            local count = activityItem.obj_seat:GetChildCountE()
            for i = 1, count do
                local x, y, z = activityItem.obj_seat:GetChildE(i - 1):GetPosition()
                table.insert(positions, { x, y, z })
            end
        end

        if #positions > 0 then
            self.roleSeatPositions[activityIndex] = positions
        else
            self.roleSeatPositions[activityIndex] = false
            positions = nil
        end
    end
    return positions
end

---获取活动站位信息
---@param activityIndex number 活动索引
---@return number[]
function MTMainView_CycleComponent:GetActivitySeatPosition(activityIndex)
    local positions = self:GetActivityPositions(activityIndex)
    if positions then
        return positions[1]
    end
    return nil
end

---查找移动路径
---@param beginIndex number 开始索引
---@param endIndex number 结束索引
---@return number[][]
function MTMainView_CycleComponent:FindActivityMovePaths(beginIndex, endIndex)
    if beginIndex == endIndex then
        return nil
    end

    ---@type number[][]
    local results = {}
    if endIndex > beginIndex then
        --从前面的活动开始, 往后面的活动走
        for index = beginIndex, endIndex - 1 do
            local positions = self:GetActivityPositions(index)
            if positions then
                for posIndex = 1, #positions do
                    table.insert(results, positions[posIndex])
                end
            end
        end
        --最后一个节点, 只加入节点本身位置
        local endPositons = self:GetActivityPositions(endIndex)
        if endPositons then
            table.insert(results, endPositons[1])
        end
    else
        --从后面的活动开始, 往前面的活动走

        --第一个节点, 只加入节点本身位置
        local beginPositions = self:GetActivityPositions(beginIndex)
        if beginPositions then
            table.insert(results, beginPositions[1])
        end

        for index = beginIndex - 1, endIndex, -1 do
            local positions = self:GetActivityPositions(index)
            if positions then
                for posIndex = #positions, 1, -1 do
                    table.insert(results, positions[posIndex])
                end
            end
        end
    end

    return results
end

---监听点击事件
---@param activityItem _obj_cycle1._obj_activity1_GoTable|{type:number,interValDay:number,tipContent:number}
function MTMainView_CycleComponent:OnClickActivity(_, _, activityItem)
    if activityItem.tipContent then
        _G.PopWindowManager:GetInstance():ShowAllTips(1515, activityItem.tipContent)
        return false
    end
    if activityItem.interValDay > 0 then
        _G.PopWindowManager:GetInstance():ShowAllTips(
            1515,
            nil,
            nil,
            nil,
            nil,
            nil,
            activityItem.interValDay
        )
        return false
    end

    if not self.activity then
        if _G.AppSetting.DEBUG then
            _G.LogError("未找到子活动壳子")
        end
        return
    end
    --播放角色移动动画
    local index = _G.table.indexof(self.childTypes, activityItem.type)
    if index then
        self.roleRoot.obj_moveeffect:SetActiveE(1)
        self:PlayRoleSeatIndex(index, function()
            if _G.IsNil(self.gameObject) then
                return
            end
            if self.roleMove then
                return
            end
            self.roleRoot.obj_moveeffect:SetActiveE(0)
            require("JointActivityModel"):GetInstance():SetJointActivityType(self.activity:GetActivityTypeCls().type)
            _G.GlobalInterface.JumpActivityByGM(
                activityItem.type,
                self.activity:GetJumpType(),
                nil,
                self.activity:GetMainType()
            )
        end)
    else
        require("JointActivityModel"):GetInstance():SetJointActivityType(self.activity:GetActivityTypeCls().type)
        _G.GlobalInterface.JumpActivityByGM(activityItem.type, self.activity:GetJumpType())
    end
end

---点击切换周期按钮
function MTMainView_CycleComponent:OnClickSwitchCycle(_, _, item)
    if item == self.nextItem then
        -- if self.lockTip then
        --     _G.PopWindowManager:GetInstance():ShowAllTips(1515, self.lockTip)
        --     return
        -- end
        if self.callback then
            self.callback(self, 1)
        end
    elseif item == self.lastItem then
        if self.callback then
            self.callback(self, -1)
        end
    end
end

return MTMainView_CycleComponent
