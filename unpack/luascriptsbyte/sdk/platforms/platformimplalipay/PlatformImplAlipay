local base = require("PlatformBase")

---@class PlatformImplAlipay: PlatformBase	支付宝平台接口实现
local PlatformImplAlipay = _G.BaseClass("PlatformImplAlipay", base)

local SDKDef = require("SDKDef")
---游戏行为action_code, 由支付宝分配, 联系运营可获取
local GameActionCodes = {
    [SDKDef.GameAction.EveryAfkPass] = "yzzl_game_level_every_1",
    [SDKDef.GameAction.DailyTask60] = "yzzl_game_huoyue_every_60",
    [SDKDef.GameAction.EveryDraw40] = "yzzl_game_shangdian_every_10",
}

function PlatformImplAlipay:ReportLoadingCompleted()
    self.sdkManager:SendExtend("reportLoadingCompleted")
end

---上报玩家登录账号
---@return void
function PlatformImplAlipay:ReportAuthorized()
    self.sdkManager:SendExtend("reportAuthorized")
end

---上报玩家创建角色
---@param initial boolean 是否初次创角
---@return void
function PlatformImplAlipay:ReportCreateRole(initial)
    if type(initial) ~= "boolean" then
        initial = not not initial
    end
    self.sdkManager:SendExtend("reportCreateRole", nil, {
        initial = initial
    })
end

---上报玩家进入游戏/游戏画面加载完成
function PlatformImplAlipay:ReportGamePlay()
    self.sdkManager:SendExtend("reportGamePlay")
end

---游戏行为上报
function PlatformImplAlipay:GameAction(action, ...)
    local actionCode = GameActionCodes[action]
    if not actionCode then
        return
    end
    self.sdkManager:SendExtend("incrementGameAction", nil, {
        action_code = actionCode
    })
end

---支付宝游戏中心/抖音侧边栏行为上报
function PlatformImplAlipay:FollowUpReport(action)
    if type(action) ~= "number" then
        return
    end
    self.sdkManager:SendExtend("followUpReport", nil, {
        type = action
    })
end

---桌面访问行为上报
function PlatformImplAlipay:SetHeadReport(action)
    if type(action) ~= "number" then
        return
    end
    self.sdkManager:SendExtend("setHeadReport", nil, {
        type = action
    })
end

return PlatformImplAlipay
