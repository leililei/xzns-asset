---@class SDKUtils 	打点系统
---@field private channelId number 渠道&平台id
local SDKUtils = _G.BaseClass("SDKUtils")

---获取渠道&平台id
---@return number
function SDKUtils:GetSDKChannelId()
    if not self.channelId or self.channelId <= 0 then
        local platform = _G.ServerManager:GetInstance().AppInfo.Platform
        self.channelId = _G.tonumber(platform)
    end
    return self.channelId
end

return SDKUtils
