---@class SDKAppInfo 应用信息
---@field public device_id string 设备唯一识别id
---@field public device_name string 设备名称
---@field public device_type string 设备类型
---@field public device_model string 设备型号
---@field public package_name string 包名
---@field public app_name string 应用名称
---@field public app_version string 应用版本
---@field public app_hot_update_version string 当前已下载的热更新版本（若未下载热更新资源，则为空）
---@field public channel_id string 平台/渠道id
---@field public carrier_type string 运营商 中国移动、中国电信、中国联通、宽带（PC平台）、unknown – 仅国内生效
---@field public network_type string 网络类型 wifi、2g、3g、4g、5g、LAN（PC平台）、unknown
---@field public app_versionCode string 此值在默认渠道以及PC上固定返回 “0” ，Android平台上为VersionCode值，iOS平台上 Build 值
---@field public is_root string 此值在Android平台返回 “1” 代表已root， “0” 代表未root，其他平台固定返回 “0”。此值仅供参考，请勿用于限制玩家登录等操作。
---@field public is_jailbreak     string 此值在iOS平台返回 “1” 代表已越狱， “0” 代表未越狱，其他平台固定返回 “0”。此值仅供参考，请勿用于限制玩家登录等操作。
local SDKAppInfo = _G.BaseClass("SDKAppInfo")

function SDKAppInfo:__init(json)
    if json and type(json) == "table" then
        local json_data = json
        if _G.AppSetting.DEBUG then
            _G.Log(json_data, "<color=red>" .. "InitAppInfo" .. "</color>")
        end
        self.DeviceID = json_data["device_id"]
        self.DeviceName = json_data["device_name"]
        self.DeviceType = json_data["device_type"]
        self.DeviceModel = json_data["device_model"]
        self.AppName = json_data["app_name"]
        self.AppID = json_data["package_name"]
        self.AppVersion = json_data["app_version"]
        self.Platform = json_data["channel_id"]
        self.HotVersion = json_data["app_hot_update_version"]
        self.CarrierType = json_data["carrier_type"]
        self.NetWordType = json_data["network_type"]
        self.AppVersionCode = json_data["app_versionCode"]
        self.IsRoot = json_data["is_root"]
        self.IsJailbreak = json_data["is_jailbreak"]
    end
    ---小游戏没有模拟器
    self.IsEmulator = 0
end

---接收C#的AppInfo结构对象
---@param data FastSDKEx.AppInfo
function SDKAppInfo:ParseFromCS(data)
    if data then
        self.DeviceID = data["deviceId"]
        self.DeviceName = data["deviceName"]
        self.DeviceType = data["deviceType"]
        self.DeviceModel = data["deviceModel"]
        self.AppName = data["appName"]
        self.AppID = data["packageName"]
        self.AppVersion = data["appVersion"]
        self.Platform = data["channelId"]
        self.HotVersion = data["appHotUpdateVersion"]
        self.CarrierType = data["carrierType"]
        self.NetWordType = data["networkType"]
        self.AppVersionCode = data["appVersionCode"]
        self.IsRoot = data["isRoot"]
        self.IsJailbreak = data["isJailbreak"]
    else
        _G.LogError("FastSDKEx.AppInfo is null")
    end
end

---析构函数
function SDKAppInfo:Dispose()
    self.AppName = nil
    self.AppID = nil
    self.AppVersion = nil
    self.DeviceID = nil
    self.Platform = nil
    self.DeviceName = nil
    self.DeviceType = nil
    self.DeviceModel = nil
    self.HotVersion = nil
    self.CarrierType = nil
    self.NetWordType = nil
    self.AppVersionCode = nil
    self.IsRoot = nil
    self.IsJailbreak = nil
end

---@return SDKAppInfo 应用信息
return SDKAppInfo
