---用户登录,登录渠道
---@param callback fun (b:boolean,info:LoginChannelInfo|string)
function SDKManager:SendLoginEx(callback)
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.SendLogin)
    _G.SDKManager:GetInstance():MiniGameTrack(SDKDef.DotMsg.ShuShu.login_sdk)
    self.mChannelId = nil
    self.mUserId = nil
    self.mChannelUserId = nil
    self.mFangChenMiFlag = 0
    if _G.AppSetting.DEBUG then
        _G.Log("正在拉取渠道SDK!")
    end
    SDKProxy:LoginChannel(
            self:CheckRusChannel(),
            function(ret, info)
                if ret then
                    self:LoginChannelSuc(info)
                else
                    self:LoginChannelFail(info)
                end
                if callback then
                    callback(ret, info)
                end
            end
    )
end

---登录渠道失败的监听(如俄罗斯渠道会只发登录渠道失败的消息)
function SDKManager:SetLoginChannelCall()
    if not self:CheckRusChannel() then
        return
    end

    SDKProxy:PushLoginChannelListener(function(ret, code, info)
        if _G.AppSetting.DEBUG then
            _G.LogError("Ru OnLoginChannelCallBack", code)
        end
        if ret then
            self:LoginChannelSuc(info)
        else
            if not self.channelFailTimes then
                self.channelFailTimes = 1
            else
                self.channelFailTimes = self.channelFailTimes + 1
            end
            if self.channelFailTimes > 3 then
                ---如果连续失败三次，再次调起切换账号的接口
                local accountSwitch = _G.GameUtil.GetFunctionData(_G.FunctionBlock.account_switch)
                self:SendChangeAccount(accountSwitch)
            else
                self:LoginChannelFail(code)
            end
        end
    end)
end

---渠道登录成功
function SDKManager:LoginChannelSuc(info)
    self.mIsChannelLoginOk = true
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.SDKLoginSuccess)
    self.loginChannelInfo = info
    ---fast_uid挂接中心的用户唯一id
    self.mUserId = info.fast_uid
    self.mChannelUserId = info.channel_uid
    self.mFangChenMiFlag = info.fangchenmi_flag
    if _G.AppSetting.DEBUG then
        _G.Log(info.extension, "登录类型login")
    end
    self.mLoginType = ""
    if _G.SDKManager:GetInstance():CheckRusChannel() then
        if not _G.string.IsNullOrEmpty(info.extension) then
            local tempext = _G.json.decode(info.extension)
            if _G.AppSetting.DEBUG then
                _G.Log(tempext, "登录类型login扩展信息")
                _G.Log(tempext.loginType, "登录类型loginType")
            end
            self.mLoginType = tempext.loginType or ""
            if _G.AppSetting.DEBUG then
                _G.Log(self.mLoginType, "登录类型最终loginType")
            end
        end
    end
    self.channelFailTimes = 0
    self:OnGetMessage(SDKDef.GetMsg.login_success)
end

---渠道登录失败
function SDKManager:LoginChannelFail(code)
    self.mIsChannelLoginOk = false
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.SDKLoginFailed)
    if _G.AppSetting.DEBUG then
        _G.LogError("OnLoginChannelFail", code)
    end
    self:OnGetMessage(SDKDef.GetMsg.login_failed)
    --这里判断是否是海外用的是语言判断，那么这种方式需要避免玩家切换语言
    if _G.GameUtil.GetIsUseChinese() then
        if not _G.AppSetting.IsHuaWei then
            --华为快游戏, 登录失败后不再自动重试
            self:ShowSDKFailDialog(code, _G.handler(self, self.SendLoginEx))
        end
    end
end

