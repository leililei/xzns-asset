---俄罗斯渠道打点
function SDKManager:TrackEvent(eventName)
    if self:CheckRusChannel() then
        local playerModel = _G.PlayerModel:GetInstance()
        local isCreateRole = playerModel:CheckCreateRole()
        local curServer = _G.ServerManager:GetInstance().CurServer

        local roleId = isCreateRole and tostring(playerModel:GetPlayerUid()) or ""
        local roleName = isCreateRole and tostring(playerModel.role_name) or ""
        local roleLevel = isCreateRole and tostring(playerModel.role_lv) or ""
        local serverId = curServer and tostring(curServer.Sid) or ""
        local serverName = curServer and tostring(curServer.ServerName) or ""

        SDKProxy:SendExtend("trackEvent", nil, {
            eventName = eventName,
            roleId = roleId,
            roleName = roleName,
            roleLevel = roleLevel,
            serverId = serverId,
            serverName = serverName
        })
    end
end

---抖音，微信，支付宝数数打点（只有星耀）
function SDKManager:MiniGameTrack(eventName)
    if self:CheckRusChannel() then
        self:TrackEvent(eventName)
        return
    end

    if _G.AppSetting.IsWeiXin or _G.AppSetting.IsDouYin or _G.AppSetting.IsAlipay then
        if _G.table.indexof(require("PlatformDef").xyChannelList, _G.tonumber(self:GetChannelId())) then
            SDKProxy:SendExtend("trackEvent", nil, { trackName = eventName })
        end
    end
end

