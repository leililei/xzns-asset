---@private 获取一个随机广告位id
---@return string
function SDKManager:GetRandomAdId()
    if not self.adIds or #self.adIds == 0 then
        return ""
    end
    local size = #self.adIds
    local index = size > 1 and (math.floor(math.random() * size) + 1) or 1
    return self.adIds[index] or self.adIds[size]
end

