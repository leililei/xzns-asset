---接收消息
function SDKManager:OnGetMessage(head, body)
    if self.ParseMsgFuns[head] then
        --("sdk回调调用对应枚举回调函数")
        self.ParseMsgFuns[head](body)
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("暂无此类解析方式:" .. head .. ">>>" .. json.encode(body))
        end
    end
end

