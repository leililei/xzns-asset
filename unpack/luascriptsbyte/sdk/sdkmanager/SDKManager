---AddListener 添加事件
---@param event string 事件key值
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function SDKManager:AddListener(event, func, obj)
    _G.Guard.NotNull(obj, "参数错误： self 为必传项")
    assert(func, "func为空")
    assert(type(func) == "function", "func不为 function类型")
    --(self.message, "sdk监听事件")
    if self.message then
        --(event, "sdk监听了一个事件")
        --(func, "sdk监听了一个事件")
        --(obj, "sdk监听了一个事件")
        self.message:AddListener(event, func, obj)
    end
end

---Broadcast 派发事件
---@param event string 事件key值
---@param ... Object[] 参数数组
function SDKManager:Broadcast(event, ...)
    --(self.message, "sdk派发事件")
    if self.message then
        --(event, "sdk派发了一个事件")
        self.message:Broadcast(event, ...)
    end
end

---RemoveListener 移除事件
---@param event string 事件key值
---@param func function 响应函数
---@param obj table 包含响应函数的Lua对象，参数2必须为为参数3的成员方法
function SDKManager:RemoveListener(event, func, obj)
    _G.Guard.NotNull(obj, "参数错误： self 为必传项")
    if self.message then
        self.message:RemoveListener(event, func, obj)
    end
end

--endregion

