function SDKManager:VideoAD(callback, name, sid)
    require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.AdRequest, sid, false)
    if _G.AppSetting.IsWebGl then
        local model = _G.PlayerModel:GetInstance()
        local serverId = _G.tostring(_G.ServerManager:GetInstance().CurServer.Sid)
        local serverName = _G.ServerManager:GetInstance().CurServer.ServerName
        local data = {
            Name = name,
            RoleId = _G.tostring(model:GetPlayerUid()),
            RoleName = model:GetName(),
            ServerId = serverId,
            ServerName = serverName,
            RoleLevel = model:GetLevel(),
            VipLevel = _G.tostring(model:GetVipLevel()) or "1"
        }
        local adUnitId = self:GetRandomAdId()
        if adUnitId and adUnitId ~= "" then
            -- 微信原生广告接入 https://doc.youkia.net/docs/fast_sdk/fast_sdk-1er5lvruc0q08
            data.adUnitId = adUnitId
            data.multiton = "false"
        end
        require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.ShowAd, sid, false)
        self:SendExtend("createRewardedVideoAd", callback, data)
    else
        ---SDK的反馈说广告位目前的渠道都不需要传，传空字符串就行
        ---@type string 如果配了广告位id, 则随机传一个
        --海外繁体adId传固定值reward
        local channelId = _G.tonumber(self:GetChannelId())
        local adId = self:GetRandomAdId()
        if PlatformDef.OverseasFT[channelId] then
            adId = "reward"
        end
        SDKProxy:PreloadRewardedAD(adId, function(preInfo)
            ---预加载完成返回广告内容
            require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.GetAdContent, sid, false)
            if preInfo.code == _G.CS.FastSpace.ToolSDK.AD_LOAD_SUC then
                SDKProxy:ShowRewardedAD(preInfo.adId or "", function(showAdInfo)
                    if showAdInfo.code == _G.CS.FastSpace.ToolSDK.AD_EARNED then
                        ---广告正常播放完成
                        if callback then
                            callback(true, { state = "reward" })
                        end
                    elseif showAdInfo.code == _G.CS.FastSpace.ToolSDK.AD_SHOWN then
                        ---广告开始展示
                        require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.ShowAd, sid, true)
                    elseif showAdInfo.code == _G.CS.FastSpace.ToolSDK.AD_CLICKED then
                        ---广告被点击
                        require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.ClickAd, sid, true)
                    elseif showAdInfo.code == _G.CS.FastSpace.ToolSDK.AD_DISMISSED then
                        ---可能被用户提前关闭，也可能是播放完成关闭
                        require("AdvertisementModel"):GetInstance():ReportAD(SDKDef.AdStep.CloseAd, sid, true)
                    else
                        if _G.AppSetting.DEBUG then
                            _G.LogError(showAdInfo.code, "ShowRewardedAD广告加载状态：")
                        end
                    end
                end)
            else
                if _G.AppSetting.DEBUG then
