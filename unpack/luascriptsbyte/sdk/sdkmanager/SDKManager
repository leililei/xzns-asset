---购买充值商品
---@param goodsID string 商品ID
function SDKManager:SendBuy(goodsData, extra)
    local isrecharge = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.recharge)
    if isrecharge then
        _G.PopWindowManager:GetInstance():ShowAllTips(470103)
        return
    end
    if self.checkTime < 8 then
        _G.PopWindowManager:GetInstance():ShowAllTips(470106)
        return
    end
    ---参数：https://doc.youkia.net/docs/fast_sdk/fast_sdk-1diptoar1btl0
    local payInfo = {}
    payInfo.Id = goodsData.sdk_id or goodsData.id
    ---该笔订单会给玩家增加多少游戏内货币数量-Sdk文档上说通常也用不到，设置为1即可
    payInfo.CoinNum = goodsData.amount
    payInfo.CpExtra = _G.json.encode({ active_item_sid = extra or "0" })
    payInfo.CpOrderId = ""

    local model = _G.PlayerModel:GetInstance()
    local roleInfo = {
        RoleName = model:GetName(),
        RoleLevel = model:GetLevel(),
        RoleId = model:GetPlayerUid(),
        ServerId = _G.ServerManager:GetInstance().CurServer.Sid,
        ServerName = _G.ServerManager:GetInstance().CurServer.ServerName,
        VipLevel = model:GetVipLevel() or "1",
        Power = model:GetPower() or "0",
        MoneyNum = _G.StorageManager:GetInstance():GetItemCountBySid(_G.ResPropID.Diamond),
        CreateRoleTime = model:GetCreateRoleTime(),
        Extra = ""
    }

    SDKProxy:Pay(
            roleInfo,
            payInfo,
            function(ret, info)
                if ret then
                    if self.timer ~= nil then
                        self.timer:Stop()
                        self.timer = nil
                    end
                    self.checkTime = 0
                    self.timer = _G.TimerManager:GetInstance():GetTimer(1, self.UpdateTime, self, false)
                    self.timer:Start()
                    self:OnGetMessage(SDKDef.GetMsg.pay_success, info)
                else
                    self:OnGetMessage(SDKDef.GetMsg.pay_failed)
                end
            end
    )
end

function SDKManager:UpdateTime(elapsed)
    self.checkTime = self.checkTime + elapsed
    if self.checkTime > 8 then
        self.timer:Stop()
        self.timer = nil
    end
end

function SDKManager:SendPayAmount()
    self:SendSDKMsg(SDKDef.SendMsg.payAmount)
end

