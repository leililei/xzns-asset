---@class SDKManager SDK管理器
---@field GetInstance fun():SDKManager
---@field public loginChannelInfo LoginChannelInfo 登录渠道得到的数据
---@field platformImpl PlatformBase         --平台接口实现
---@field adIds string[]                    --广告位id列表
local SDKManager = _G.BaseClass("SDKManager")
_G.SDKManager = SDKManager
---@field SendMsg cs SDKManager
---创建对象时,入口构造函数
function SDKManager:__init()
    self.message = Messenger.New()
    self:InitParser()
    self.mIsChannelLoginOk = false
    SDKProxy:Init(
            function()
                self.ifSdkInterfaceInitComplete = true
                self:SetLogoutCallBack()
                self:SetShareAppMessageCallBack()
                self:SetLoginChannelCall()
                self:SetShareAppMessage()
            end
    )

    if _G.AppSetting.IsAlipay then
        self.platformImpl = require("PlatformImplAlipay").New(self)
    end

    --初始化广告位id
    local wxAdUnitId = _G.CS.Launcher.Inst.wxAdUnitId
    if wxAdUnitId and type(wxAdUnitId) == "string" then
        self.adIds = _G.string.split(wxAdUnitId, "|")
    end

    ---解析挂接上配置的额外参数
    self.extraData = {}
    if _G.CS.WechatGameCore.WechatGameApp.Instance.GetSDKExtraData then
        local eData = _G.CS.WechatGameCore.WechatGameApp.Instance:GetSDKExtraData()
        if not _G.string.IsNullOrEmpty(eData) then
            self.extraData = _G.json.decode(eData)
        end
    end

    ---初始化时的扩展参数
    self.initExtraData = {}
    local initExtraData = _G.CS.FastSDKEx.SDKManager.initExtraData
    if not _G.string.IsNullOrEmpty(initExtraData) then
        self.initExtraData = _G.json.decode(initExtraData)
    end

    self.checkTime = 10
end

---获取额外参数值
function SDKManager:GetExtraDataField(key, defValue)
    return self.extraData[key] or defValue
end

---打点或者扩展方法的基础参数
function SDKManager:GetBaseParams()
    local model = _G.PlayerModel:GetInstance()
    local curServer = _G.ServerManager:GetInstance().CurServer
    local dict = {
        roleId = "",
        roleName = "",
        roleLevel = "",
        roleVipLevel = "1",
        serverId = curServer and curServer.Sid or "",
        serverName = curServer and curServer.ServerName or "",
    }
    if model:CheckCreateRole() then
        dict.roleId = model:GetPlayerUid() or ""
        dict.roleName = model:GetName() or ""
        dict.roleLevel = model:GetLevel() or ""
        dict.roleVipLevel = model:GetVipLevel() or "1"
    end
    return dict
end

---设置被动分享信息
function SDKManager:SetShareAppMessage()
    local channelId = _G.tonumber(self:GetChannelId())
    if _G.AppSetting.IsXzns then
        if _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.shareSwitch, channelId) then
            local shareImage = _G.GameUtil.GetFunctionData(_G.FunctionBlock.shareImage, channelId)
            local params
            if #shareImage == 1 then
                params = {
                    imageUrl = shareImage[1][1],
                    imageUrlId = shareImage[1][2]
                }
            else
                params = {
                    imageUrl = {},
                    imageUrlId = {}
                }
                for i = 1, #shareImage do
                    local imageData = shareImage[i]
                    _G.table.insert(params.imageUrl, imageData[1])
                    _G.table.insert(params.imageUrlId, imageData[2])
                end
            end
            SDKProxy:SendExtend("setShareAppMessage", nil, params)
        end
    else
        if _G.AppSetting.IsWeiXin and not _G.AppSetting.IsHuaWei and not _G.AppSetting.IsFastRpkGame then
            if channelId == 13153 then
                local params = {
                    tille = _G.GetLangPackValue(90032900026),
                    imageUrl = "https://mmocgame.qpic.cn/wechatgame/uibpkgO2H3rYhUogyXyYkFhcVItLiboLqRNyjDRkUfZsyGG09CuN8nNqicWt8lzIeLE/0",
                    imageUrlId = "/xOCXIUgQEyFfzKpLoqE2w=="
                }
                SDKProxy:SendExtend("setShareAppMessage", nil, params)
            end
        end
    end
end

function SDKManager:GetInstance()
    if rawget(self, "Instance") == nil then
        local ins = self.New()
        rawset(self, "Instance", ins)
    end
    assert(self.Instance ~= nil)
    return self.Instance
end

---重设sdkmanager
function SDKManager:Reset()
    self:Dispose()
    SDKProxy:Clear()
    self:__init()
end

