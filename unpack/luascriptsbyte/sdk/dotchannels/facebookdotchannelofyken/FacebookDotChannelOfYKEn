local base = require("BaseDotChannel")

---@class FacebookDotChannelOfYKEnAndroid: BaseDotChannel    打点系统_facebook_易酷海外(安卓)
local FacebookDotChannelOfYKEn = _G.BaseClass("FacebookDotChannelOfYKEnAndroid", base)

---单笔充值
---@param value number
function FacebookDotChannelOfYKEn:SDKDot_Purchase(value)
    if value > 6500 then
        self.sdkManager:SendFacebookEvent("R3")
    elseif value > 3500 then
        self.sdkManager:SendFacebookEvent("R2")
    elseif value > 1000 then
        self.sdkManager:SendFacebookEvent("R1")
    end
end

---引导打点
function FacebookDotChannelOfYKEn:SDKDot_Tutorial()
    self.sdkManager:SendFacebookEvent("Tutorial")
end

---首充
---@param cash number
function FacebookDotChannelOfYKEn:SDKDot_FirstPurchase(cash)
    self.sdkManager:SendFacebookEvent("First Purchase")
end

return FacebookDotChannelOfYKEn
