local base = require("BaseDotChannel")

---@class DotChannelOfMQ: BaseDotChannel    打点系统_萌趣
local DotChannelOfMQ = _G.BaseClass("DotChannelOfMQ", base)

local SDKDef = require("SDKDef")

---广告
---@param adId number 广告id
function DotChannelOfMQ:SDKDot_Ad(adId)
    local params = {
        [SDKDef.AdDot.dataType] = tonumber("2"),
        [SDKDef.AdDot.entrance] = tostring(adId),
        [SDKDef.AdDot.rewardDesc] = ""
    }
    self.sdkManager:SendExtend("rewardAdReport", nil, params)
end

return DotChannelOfMQ
