local base = require("BaseDotChannel")

---@class DotChannelOfMQH5Android: BaseDotChannel    打点系统_萌趣
local DotChannelOfMQH5Android = _G.BaseClass("DotChannelOfMQH5Android", base)

local SDKDef = require("SDKDef")

---新手引导完成打点
function DotChannelOfMQH5Android:SDKDot_Tutorial()
    local params = {
        [SDKDef.MQDot.eventId] = "11",
        [SDKDef.MQDot.eventName] = "tutorial_completion"
    }
    self.sdkManager:SendExtend("customEvents", nil, params)
end

---点击广告打点
function DotChannelOfMQH5Android:SDKDot_ClickAd()
    local params = {
        [SDKDef.MQDot.eventId] = "13",
        [SDKDef.MQDot.eventName] = "ad_click"
    }
    self.sdkManager:SendExtend("customEvents", nil, params)
end

return DotChannelOfMQH5Android
