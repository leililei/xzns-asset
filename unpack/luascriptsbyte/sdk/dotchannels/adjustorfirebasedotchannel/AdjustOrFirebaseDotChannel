---角色升级
function AdjustOrFirebaseDotChannel:SDKDot_Level(level)
    if dot_level[level] then
        self.sdkManager:AdjustOrFirebase(
            dot_level[level][SDKDef.AdjustFirebaseType.Adjust],
            nil,
            SDKDef.AdjustFirebaseType.Adjust
        )
        self.sdkManager:AdjustOrFirebase(
            dot_level[level][SDKDef.AdjustFirebaseType.Firebase],
            nil,
            SDKDef.AdjustFirebaseType.Firebase
        )
    end
end

---累计充值
function AdjustOrFirebaseDotChannel:SDKDot_Recharege(startCash, endCash)
    local tb = {}
    for k, v in pairs(dot_recharege) do
        local value = k * 100
        if value > startCash and value <= endCash then
            _G.table.insert(tb, v)
        end
    end
    local value = endCash / 100
    for _, v in pairs(tb) do
        self.sdkManager:AdjustOrFirebase(
            v[SDKDef.AdjustFirebaseType.Adjust],
            value,
            SDKDef.AdjustFirebaseType.Adjust
        )
        self.sdkManager:AdjustOrFirebase(
            v[SDKDef.AdjustFirebaseType.Firebase],
            value,
            SDKDef.AdjustFirebaseType.Firebase
        )
    end
end

