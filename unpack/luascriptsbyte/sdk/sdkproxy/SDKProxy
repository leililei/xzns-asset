local json = _G.json
--region internal

---Init 初始化
---@param callback fun ()
function SDKProxy:Init(callback)
    self.test = 1
    --被动接收消息
    self:PushListener(FastSDKCode.Net_Type_Change, self.OnNetTypeChange, {})
    --扩展消息接收
    self:PushListener(
        FastSDKCode.Extend_Fuc_Suc,
        function(str)
            self:OnExtendFunResult(true, str)
        end,
        {}
    )
    self:PushListener(
        FastSDKCode.Extend_Fuc_Fail,
        function(str)
            self:OnExtendFunResult(false, str)
        end,
        {}
    )
    --设置监听
    self:SetLuaCallBack(callback)
end

---SetLuaCallBack
---@param callback fun ()
function SDKProxy:SetLuaCallBack(callback)
    --c#端初始化sdk完成。c#端模拟发送
    self:SetListener(
        GameSDKCode.onSdkInterfaceInitComplete,
        function(_)
            callback()
        end
    )
    SdkInterface:SetLuaCallBack(self, self.OnSdkCallBack)
end

---清理
function SDKProxy:Clear()
    SdkInterface:SetLuaCallBack(nil, nil)
    self:RemoveLogoutMsg()
end

---OnSdkCallBack SDK发送过来的消息
---@param code number
---@param str string
function SDKProxy:OnSdkCallBack(code, str)
    local callback = self:PopListener(code)
    if not callback then
        if _G.AppSetting.DEBUG then
            _G.LogWarning("Lua SDKProxy:OnSDKCallBack no handler, code: " .. code)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.Log("Lua SDKProxy:OnSDKCallBack", code)
        end
        callback(str)
    end
end

---OnExtendFunResult 扩展消息的返回
---@param b boolean
---@param str string
function SDKProxy:OnExtendFunResult(b, str)
    local obj = json.decode(str)
    if obj then
        local methodName = obj["func_name"] or obj["methodName"]
        local result = obj["result"] or obj["data"]
        local callback = self:PopListener(methodName)
        if callback then
            callback(b, result)
        end
    end
end

---SetListener 添加请求返回监听
---@param code number|string
---@param callback fun (str:string)|fun (b:boolean,str:string)
function SDKProxy:SetListener(code, callback)
    self[code] = { callback, { code } }
end

---PushListener 添加请求返回监听
---@param code number|string
---@param callback fun (str:string)|fun (b:boolean,str:string)
---@param removes number[]|string[]
function SDKProxy:PushListener(code, callback, removes)
    self[code] = { callback, removes }
end

---PopListener 取出请求返回监听
---@param code number|string
---@return fun (str:string)|fun (b:boolean,str:string)
function SDKProxy:PopListener(code)
    local args = self[code]
    if args == nil then
        return nil
    end
    ---@type fun (str:string)|fun (b:boolean,str:string)
    local callback = args[1]
    ---@type number[]|string[]
    local removes = args[2]
    for _, v in ipairs(removes) do
        self[v] = nil
    end
    return callback
end

