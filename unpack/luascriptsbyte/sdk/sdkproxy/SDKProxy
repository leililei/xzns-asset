---扩展方法
---@param methodName string 扩展方法名
---@param callback fun (b:boolean, info:string|table) 调用完成回调
---@param data table 参数
function SDKProxy:SendExtend(methodName, callback, data)
    self:SetListener(
        methodName,
        function(b, str)
            if callback == nil then
                return
            end
            if b then
                local obj = json.decode(str)
                callback(true, obj)
            else
                callback(false, str)
            end
        end
    )
    if data == nil then
        SdkInterface:CallSdkInterface("ExtendFunc", methodName, "{}")
    else
        SdkInterface:CallSdkInterface("ExtendFunc", methodName, json.encode(data))
    end
end

