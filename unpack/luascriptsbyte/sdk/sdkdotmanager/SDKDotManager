---@class SDKDotManager : Singleton	打点系统
---@field GetInstance fun():SDKDotManager
---@field channel BaseDotChannel     打点接口
local SDKDotManager = _G.BaseClass("SDKDotManager", _G.Singleton)

local SDKDef = require("SDKDef")
local SDKUtils = require("SDKUtils")

---渠道配置
---@type table<number,string>
local channelsConf = {
    [SDKDef.SDKChannels.YK_EN] = "FacebookDotChannelOfYKEn",
    [SDKDef.SDKChannels.MQ] = "DotChannelOfMQ",
    [SDKDef.SDKChannels.MQ_2] = "DotChannelOfMQ",
    [SDKDef.SDKChannels.MQ_H5_Android] = "DotChannelOfMQH5Android"
}

---创建对象时,入口构造函数
function SDKDotManager:__init()
    local clsname = channelsConf[SDKUtils:GetSDKChannelId()]
    if clsname then
        self.channel = require(clsname).New(_G.SDKManager:GetInstance())
    end
end

function SDKDotManager:Dispose()
    if self.channel then
        self.channel:Dispose()
    end
    self.channel = nil
end

---@param param type 事件类型
function SDKDotManager:OnEvent(type, ...)
    if not self.channel then
        return
    end
    self.channel:OnEvent(type, ...)
end

---角色升级
function SDKDotManager:SDKDot_Level(level)
    if not self.channel then
        return
    end
    self.channel:SDKDot_Level(level)
end

