---@class SDKServerShowInfo 描述
---@field Sid number ID
---@field ServerName string 服务器名字
---@field IsHot boolean 是否热门服务器
---@field IsNew boolean 是否新服务器
---@field IsOpen boolean 是否开放
---@field NotOpenTips string 显示的维护内容
---@field AccountName string 登录帐号
---@field IP string 地址
---@field Port number 端口
---@field IsLogin boolean 是否已注册
---@field UserName string       @所在服务器的角色名字
---@field UserLevel number      @所在服务器的角色等级
---@field UserStyle number      @所在服务器的角色头像
---@field UserFrame number      @所在服务器的角色头像框
---@field ServerID number 登录服务的id
local SDKServerShowInfo = _G.BaseClass("SDKServerShowInfo")

function SDKServerShowInfo:__init()
    self:Clear()
end

function SDKServerShowInfo:Clear()
    self.Sid = nil
    self.ServerName = nil
    self.IsHot = nil
    self.IsNew = nil
    self.IsOpen = nil
    self.NotOpenTips = nil
    self.Region = nil
    self.AccountName = nil
    self.IP = nil
    self.Port = nil
    self.IsLogin = false
    self.UserName = nil
    self.UserLevel = nil
    self.UserStyle = nil
    self.UserFrame = nil
    self.ServerID = nil
end

---初始化SDK服务器配置
function SDKServerShowInfo:InitSDKInfo(data)
    self.Sid = data.server_id
    self.ServerName = data.server_name
    self.IsHot = data.is_hot == 1
    self.IsNew = data.is_new == 1
    self.IsOpen = data.is_open == 1
    self.NotOpenTips = data.maintenance_notice
    self.Region = _G.tonumber(data[9])
    self.ServerID = data.server_id
    self.ServerGroup = data.server_group and _G.tonumber(data.server_group)
    self.OpenServerTime = data.open_server_time or 0
end

---初始化登录挂接中心返回的服务器登录信息
function SDKServerShowInfo:InitLoginServerInfo(json)
    -- local json_data = _G.Json2Table(json)

    if _G.AppSetting.DEBUG then
        _G.Log(json, "<color=red>" .. "InitLoginServerInfo" .. "</color>")
    end

    local temp
    local urlList = _G.string.split(json.game_login_url, '|')
    if _G.table.count(urlList) <= 1 then
        temp = json.game_login_url
    else
        if _G.AppSetting.IsWebGl then
            temp = urlList[2]
        else
            temp = urlList[1]
            local tList = _G.string.split(temp, "?")
            ---多个服务器ip时在只有第二个才有参数就需要做参数拼接
            if _G.string.IsNullOrEmpty(tList[2]) then
                local t1List = _G.string.split(urlList[2], "?")
                temp = temp .. "?" .. t1List[2]
            end
        end
    end
    if _G.AppSetting.DEBUG then
        _G.Log(temp, "<color=red>" .. "loginurl" .. "</color>")
    end
    self.AccountName = temp

    if _G.AppSetting.DEBUG then
        _G.Log(temp, "<color=red>" .. "game_base_url" .. "</color>")
    end
    -- local t1 = _G.string.replace(temp, "http://", "")
    local t1 = _G.string.split(temp, "//")[2]
    local list = _G.string.split(t1, "?")
    local address = _G.string.split(list[1], ":")
    self.IP = address[1]
    self.Port = _G.tonumber(address[2])
end

---初始化本地服务器配置
---@param cfg ServerListConfig_Item config
function SDKServerShowInfo:InitLocalCfgInfo(cfg)
    self.Sid = cfg.id
    self.ServerName = cfg.ServerName
    self.IsHot = cfg.IsHot
    self.IsNew = cfg.IsNew
    self.IsOpen = cfg.IsOpen
    self.Region = cfg.Region
    self.ServerID = cfg.ServerID
    self.NotOpenTips = ""
    --_G.GetLangPackValue("weihu2")
    self.IP = cfg.IP
    self.Port = cfg.Port
end

function SDKServerShowInfo:InitUserInfo(data)
    -- local json_data = _G.Json2Table(data)

    if _G.AppSetting.DEBUG then
        _G.Log(data, "<color=red>" .. "InitUserInfo" .. "</color>")
    end

    self.IsLogin = true
    self.UserName = data[1].role_name or ""
    self.UserLevel = _G.tonumber(data[1].role_level or 0)
    self.UserRoleId = data[1].role_id or 0
    local extra = _G.string.split(data[1].extra, "&")
    self.UserStyle = 101
    self.UserFrame = 0
    for _, v in pairs(extra) do
        local list = _G.string.split(v, "=")
        if list[1] == "style" then
            self.UserStyle = list[2] and _G.tonumber(list[2]) or 101
        elseif list[1] == "frame" then
            self.UserFrame = list[2] and _G.tonumber(list[2]) or 0
        end
    end
end

---析构函数
function SDKServerShowInfo:Dispose()
    self:Clear()
end

---@return SDKServerShowInfo ServerInfo
return SDKServerShowInfo
