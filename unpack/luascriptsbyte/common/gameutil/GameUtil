---查找以当前点为中心的一个半径的周围点（只用于navmesh找点）
---@param navNodes UnityEngine.AI.NavMeshPath 寻路对象
---@param cPos UnityEngine.Vector3 中心点
---@param radian number 弧度系数（将圆转为多少等比弧度来扫描）
---@param radius number 最大半径
---@param maxRadius number 最小半径，不传就是1
function GameUtil.GetAroundPoint(navNodes, cPos, radian, radius, miniRadius)
    if nil == miniRadius then
        miniRadius = 1
    end
    local currentWorld = _G.WorldManager:GetInstance():GetCurWorld()
    local index = 1
    local Nodes = {}
    for l = 1, radian do
        local tr = _G.math.random(miniRadius, radius)
        local ePos = _G.Vector3(cPos.x, cPos.y, cPos.z + tr)
        local x, z = _G.CS.UnityObjectExtends.GetRotatePoint(ePos.x, ePos.z, cPos.x, cPos.z, l)
        local y = currentWorld.WorldSetting:GetY(x, z)
        local isNode = _G.CS.UnityObjectExtends.CalculatePathByPos(cPos.x, cPos.y, cPos.z, x, y, z, navNodes)
        if isNode then
            _G.table.insert(Nodes, _G.Vector3(x, y, z))
        end
    end
    ---有点就走
    if #Nodes > 0 then
        index = _G.math.random(1, #Nodes)
        return Nodes[index]
    end
    return nil
end

