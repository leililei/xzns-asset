---更新和谐等级
function GameUtil.UpdateHexieLevel()
    if not AppSetting.IsArraigned then
        local dstLevel = _G.GameUtil.GetFunctionData(_G.FunctionBlock.heXieLevel)
        local heXieLevel = _G.AppSetting.HeXieLevel
        local tempLevel = -1
        if dstLevel ~= nil then
            if (heXieLevel > 0 and dstLevel > 0) or heXieLevel <= 0 then
                tempLevel = dstLevel
            end
        end

        ---1.判断本地文件开关是否打开，如果打开直接取消和谐
        ---2.本地文件开关关闭下，判断配置配的打开条件是否满足
        ---3. 1,2两步其一满足时取消和谐
        ---4.当1,2都不满足时，判断FunctionBlock表里配置的是否设置和谐等级
        local isUnlock = false
        if _G.CS.Main.Inst.GetHeXieFileSwitch then
            isUnlock = _G.CS.Main.Inst:GetHeXieFileSwitch()
        end
        if not isUnlock then
            local cfg = _G.ConfigManager.discrete_cfg[201402]
            if cfg then
                isUnlock = _G.FunctionManager:GetInstance():CheckFunctionIsUnlock(cfg[1][1])
            end
        end

        if isUnlock then
            if _G.CS.Launcher.Inst.HeXieLevel then
                _G.CS.Launcher.Inst.HeXieLevel = 0
            end
            _G.AppSetting.HeXieLevel = 0
            if type(_G.CS.ResPathReplace.IsReplace) == "boolean" then
                _G.CS.ResPathReplace.IsReplace = false
            end
        else
            if tempLevel >= 0 then
                if _G.CS.Launcher.Inst.HeXieLevel then
                    _G.CS.Launcher.Inst.HeXieLevel = tempLevel
                end
                _G.AppSetting.HeXieLevel = tempLevel
                if type(_G.CS.ResPathReplace.IsReplace) == "boolean" then
                    _G.CS.ResPathReplace.IsReplace = (_G.AppSetting.HeXieLevel > 0)
                end
            end
        end
    end

end
