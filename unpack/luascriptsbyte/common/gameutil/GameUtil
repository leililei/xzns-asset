function GameUtil.GetColorByVersion(color)
    local curVersion
    if _G.AppSetting.IsXzns then
        curVersion = "Xzns_Quality"
    end
    if not curVersion then
        return color
    end
    local quality = "White"
    if color == ColorTools.Qulity_Green or color == ColorTools.New_Qulity_Green then
        quality = "Green"
    elseif color == ColorTools.Qulity_Blue or color == ColorTools.New_Qulity_Blue then
        quality = "Blue"
    elseif color == ColorTools.Qulity_Purple or color == ColorTools.New_Qulity_Purple then
        quality = "Purple"
    elseif color == ColorTools.Qulity_Orange or color == ColorTools.New_Qulity_Orange then
        quality = "Orange"
    elseif color == ColorTools.Qulity_red or color == ColorTools.New_Qulity_red then
        quality = "red"
    elseif color == ColorTools.Quality_Golden or color == ColorTools.New_Qulity_Golden then
        quality = "Golden"
    elseif color == ColorTools.New_Qulity_Color then
