---将数字根据换算规则转为字符串
---@param num number 数字
---@return string 显示文字
function GameUtil.NumberWY(num)
    num = tonumber(num)

    local rule = _G.GameUtil.GetNumberUnitRule()
    for i = 1, #rule do
        local nowRule = rule[i]
        if num >= nowRule[1] then
            num = _G.GameUtil.NumberToUnitFloat(num, nowRule[2], nowRule[4])
            local str = _G.GetLangPackValue(nowRule[3], num)
            return _G.tostring(str)
        end
    end
    return _G.tostring(num)
end

---将数字根据换算规则转为位图格式的字符串
---@param num number 数字
---@return string 显示文字
function GameUtil.NumberToImage(num)
    num = tonumber(num)

    local rule = _G.GameUtil.GetNumberUnitRule()
    for i = 1, #rule do
        local nowRule = rule[i]
        if num >= nowRule[1] then
            num = _G.GameUtil.NumberToUnitFloat(num, nowRule[2], nowRule[4])
            local str = num
            if UnitSymbol[nowRule[2]] then
                str = str .. UnitSymbol[nowRule[2]]
            end
            return _G.tostring(str)
        end
    end
    return _G.tostring(num)
end

---根据单位换算转浮点数
function GameUtil.NumberToUnitFloat(num, unit, point)
    if unit <= 0 then
        return num
    end
    local dividend = unit
    local float = 1
    for _ = 1, point do
        dividend = dividend / 10
        float = float * 10
        if dividend <= 0 or float >= unit then
            return num
        end
    end
    local newNum = _G.Mathf.Floor(num / dividend) / float
    local str
    if point >= 3 then
        str = string.format("%.3f", newNum)
    elseif point == 2 then
        str = string.format("%.2f", newNum)
    elseif point == 1 then
        str = string.format("%.1f", newNum)
    else
        str = math.modf(newNum)
        return str
    end
    str = string.match(str, "^(.-)%.?0*$")
    return str
end

