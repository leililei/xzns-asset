---获取最终价格(代金券/平台/海内外)
---@param priceId number 档位id
---@param isVoucher boolean 是否代金券模式(可选)
function GameUtil.GetChannelPrice(priceId, isVoucher, isRechargeCfg)
    isVoucher = isVoucher or _G.GameUtil.CheckVoucherModel()
    local price = priceId
    if isVoucher then
        if priceId > 0 then
            local gearCfg
            if isRechargeCfg then
                gearCfg = _G.ConfigManager.store_recharge_cfg[priceId]
            else
                gearCfg = _G.ConfigManager.store_gear_cfg[priceId]
            end
            if gearCfg then
                for _, v in pairs(gearCfg.voucher) do
                    if v[1] == 203090001 then
                        price = v[2]
                        break
                    end
                end
            end
        end
    else
        local finalPrice = require("MallManager"):GetInstance():GetFinalPrice(priceId, isRechargeCfg)
        if _G.GameUtil.IsNotPlatformSpecial() then
            price = _G.tonumber(_G.GameUtil.RatioControl(finalPrice))
        else
            price = _G.GameUtil.PlatformPrice(finalPrice)
        end
    end
    return price, isVoucher
end

---设置最终展示价格文本(代金券/平台/海内外)
---@param priceId number 档位id
---@param obj table 文本go_table节点（可选, 有值则直接给组件赋值）
---@param langId1 number 语言id（可选）
---@param freeLangId number 免费语言id（可选）
---@return string, boolean 金额文本，是否使用代金券
function GameUtil.SetPriceByChannel(priceId, obj, langId, freeLangId, isRechargeCfg)
    local content
    local price, isVoucher = _G.GameUtil.GetChannelPrice(priceId, false, isRechargeCfg)
    if price <= 0 then
        freeLangId = freeLangId or 90028500012
        content = _G.GetLangPackValue(freeLangId)
    else
        if isVoucher then
            --代金券
            content = price
        else
            if _G.GameUtil.IsNotPlatformSpecial() then
                --常规
                if langId then
                    local str = _G.ConfigManager.language_package_cfg[langId]
                    if str:find("%%s") or str:find("%%d") then
                        content = _G.GetLangPackValue(langId, price)
                    else
                        content = _G.GetLangPackValue(langId) .. price
                    end
                else
                    content = _G.GetLangPackValue(90000010819, price)
                end
            else
                --抖音淘宝
                content = price
            end
        end
    end
    if obj then
        obj.text = content
    end
    return content, price, isVoucher
end

