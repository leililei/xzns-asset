---当前值作分比转化
---@param curVaue number 当前值
---@param ratio number 多少分比
---@param flen number 小数保留长度
function GameUtil.RatioControl(curVaue, ratio, flen)
    if nil == ratio then
        ratio = 100
    end
    if nil == flen then
        flen = 2
    end

    local qy = curVaue % ratio

    local flenP = _G.Mathf.Pow(10, flen)
    local num
    if qy > 0 then
        num = _G.Mathf.FloorToInt(curVaue / ratio * flenP) / flenP
    else
        num = _G.Mathf.FloorToInt(curVaue / ratio)
    end

    return tostring(num)
end

