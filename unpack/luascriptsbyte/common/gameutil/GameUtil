function GameUtil.SetCardUiSpineAnimation(trans, animationName, isHeXie, sid)
    local sg = trans:GetChildE(0):GetComponentE(_G.typeof(_G.CS.Spine.Unity.SkeletonGraphic))
    local isOverLap, isSpineMask, isHaveSkin, forceHeXie = false, false, false, false
    if sid then
        isOverLap, isSpineMask, isHaveSkin, forceHeXie = _G.GameUtil.CheckSkinOverlap(sid)
    end
    if (isHeXie and (_G.AppSetting.HeXieLevel > 0 or isOverLap)) then
        if animationName == "idle" then
            if isSpineMask then--使用带彩条的动作
                if GameUtil.UISpineHasAnimation(sg, "idle99") then
                    if isHaveSkin then
                        animationName = forceHeXie and "idle2" or "idle"
                    else
                        animationName = "idle99"
                    end
                else
                    animationName = "idle2"
                end
            else--通过配置加彩条
                if not isHaveSkin and sid then
                    _G.GameUtil.SetCardSpineSkinMask(trans, sid)
                end
                if GameUtil.UISpineHasAnimation(sg, "idle2") then
                    animationName = "idle2"
                end
            end
        end
        if animationName == "stand_1" then
            if GameUtil.UISpineHasAnimation(sg, "stand_2") then
                animationName = "stand_2"
            end
        end
    end
    sg.AnimationState:SetAnimation(0, animationName, true)
end

function GameUtil.SetCardSpineSkinMask(trans, sid)
    if not sid then
        return
    end
    local cfg = _G.ConfigManager.skin_mask_cfg[sid]
    if not trans then
        return
    end
    if not cfg then
        if _G.AppSetting.DEBUG then
            _G.LogError("skin_mask_cfg中没有sid为" .. sid .. "的配置")
        end
        return
    end
    local path = "UIH5_xzns/Common/@_obj_SkinMask"
    local num = #cfg.mask_param
    for i = 1, num do
        _G.PoolsManager:GetInstance():Spawn(
            path,
            _G.ePoolType.Temporary,
            trans,
            function(mask)
                if not trans then
                    _G.DestroyImmediate(mask)
                    return
                end
                mask:SetAsLastSiblingE()
                local pos = cfg.mask_param[i]
                local scale = cfg.mask_scale[i]
                local rotate = cfg.mask_rotation[i]
                mask:SetLocalPosition(pos[1], pos[2], pos[3])
                if #scale == 1 then
                    mask:SetLocalScaleXYZ(scale[1])
                else
                    mask:SetLocalScale(scale[1], scale[2], scale[3])
                end
                local rotation
                if #rotate == 1 then
                    rotation = _G.Quaternion.Euler(0, 0, rotate[1])
                else
                    rotation = _G.Quaternion.Euler(rotate[1], rotate[2], rotate[3])
                end
                mask:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
            end
        )
    end
end

