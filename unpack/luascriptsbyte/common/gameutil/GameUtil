function GameUtil.CheckSkinOverlap(sid)
    local cfg = _G.ConfigManager.skin_cfg[sid]
    local isOverLap, isSpineMask, isHaveSkin, forceHeXie = false, false, false, false
    if cfg then
        isHaveSkin = require "CardCommentManager":GetInstance():CradSid(cfg.card, cfg.id)
        isSpineMask = cfg.skin_overlap and cfg.skin_overlap == 1 or false
        --是需要遮挡的皮肤
        isOverLap = not isHaveSkin--未解锁皮肤时遮挡
        forceHeXie = cfg.skin_hexie == 1
    end
    return isOverLap, isSpineMask, isHaveSkin, forceHeXie
end

