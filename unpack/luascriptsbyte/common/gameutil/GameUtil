---版本号比较,是否高于某版本号
---@param ver string n.n.n, 前三位是版本号，只传前三位即可
function GameUtil.CompareVersion(ver)
    ---n.n.n.XXXXXXXXXXXXXX
    local curVer = _G.CS.Main.Inst:GetVersion()
    local verLis = _G.string.split(ver, ".")
    local curVerLis = _G.string.split(curVer, ".")
    for i = 1, 3 do
        if _G.tonumber(curVerLis[i]) > _G.tonumber(verLis[i]) then
            return true
        elseif _G.tonumber(curVerLis[i]) < _G.tonumber(verLis[i]) then
            return false
        end
    end
    return false
end

---设置子物体数量,复制第一个子物体,注意DestroyObject不是实时的，如果在删除的子物体下异步生成item会出现奇怪的问题
---@param parent UnityEngine.GameObject 父物体
---@param count number 子物体数量
---@param callBack fun(T:UnityEngine.Transform,index:number) 回调函数
function GameUtil.SetChildCount(parent, count, callBack)
    local childObj = parent:GetChildE(0)
    local curChildCount = parent:GetChildCountE()
    local left = Mathf.Abs(count - curChildCount)
    if curChildCount < count then
        for i = 1, left do
            local obj = InstantiateObject(childObj.gameObject, parent)
            obj:SetActiveE(1)
        end
    elseif curChildCount > count then
        for i = curChildCount, count + 1, -1 do
            DestroyObject(parent:GetChildE(i - 1))
        end
    end

    if callBack then
        for i = 1, count do
            callBack(parent:GetChildE(i - 1), i)
        end
    end
end

