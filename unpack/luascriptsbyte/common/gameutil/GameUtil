---获取字符串中某字符的数量(判断语言表填充值专用的，别的不要用)
function GameUtil.GetStringCharNum(str)
    local pattern = "%s"
    local patternd = "%d"

    local patternlen = string.len(pattern)
    local n_spaces = 0

    local strtemp = ""
    local add = false
    local arr = string.getStringCharArr(str)
    for i = 1, #arr do
        local char = arr[i]
        if char == "%" then
            add = true
        end
        if add then
            strtemp = strtemp .. char
        end
        if strtemp == pattern or strtemp == patternd then
            n_spaces = n_spaces + 1
            strtemp = ""
            add = false
        end
        if string.len(strtemp) >= patternlen then
            strtemp = ""
            add = false
        end
    end

    return n_spaces
end

