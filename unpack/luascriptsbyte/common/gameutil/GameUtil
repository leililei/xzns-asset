            for i = 1, #list do
                local id = list[i]
                ---@type item_cfg
                local itemCfg = _G.ConfigManager.item_cfg[id]
                local count = 0
                for _, v in pairs(itemCfg.UseParameter) do
                    if tonumber(v[1]) == itemID then
                        count = tonumber(v[2])
                        isHave = true
                        break
                    end
                end
                if not isHave then
                    return 0, -1
                end
                local otherCount = storage:GetItemCountBySid(id)
                if otherCount > 0 and count > 0 then
                    allCount = allCount + count * otherCount
                    if cur < 0 then
                        cur = id
                        curCount = _G.math.min(_G.math.ceil((needCount - itemCount) / count), otherCount)
                    end
                    if allCount >= needCount - itemCount then
                        return cur, curCount
                    end
                end
            end
            return 0, -1
        end
        if itemCount < needCount then
            for i = 1, #params do
                local itemId, count = check(params[i])
                if not isHave then
                    return
                end
                if itemId > 0 then
                    ---@type params_FastChooseUseItemView
                    local data = {}
                    data.sid = itemId
                    data.getSid = itemID
                    data.Call = call
                    data.count = count
                    ---@type item_cfg
                    local itemCfg = _G.ConfigManager.item_cfg[itemId]
                    if not itemCfg then
                        return
                    end
                    if itemCfg.UsePattern == _G.ItemUsePattern.Content then
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FastUseChooseItemView.Name, data)
                    else
                        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.FastUseItemView.Name, data)
                    end
                    return true
                end
            end
        end
        return false
    end
    local idCount = #ids
    for i = 1, idCount do
        if checkSingle(ids[i]) then
            return true
        end
    end
    storage:CheckItemNew(itemID, needCount)
    return false
end

