        0,
        true,
        false,
        0
    )
end

---新的玩家头像设置方法（）
---@param obj UnityEngine.GameObject 头像item有gotbale   UIH5/Common/ItemView/HeadItemBase
---@param Data role.i_role 用户信息i_role
---@param scale number 头像缩放(默认为1)
---@param showFrame boolean 是否显示头像框(默认为关)
---@param showTitle boolean 是否显示称号(默认为关)
---@param showLv boolean 是否显示等级(默认为关)
---@param onClick function 头像点击回调(默认为通用)
function UIUtils.SetPlayerHeadItemNew(obj, Data, scale, showFrame, showTitle, showLv, onClick)
    local lv = 1
    local style = 0
    local frame = 0
    local sid = 0
    local uid = 0
    local title = 0
    if Data then
        lv = Data.lv or Data.level
        style = Data.style or Data.portrait
        if Data.frame then
            frame = _G.IsNumber(Data.frame) and Data.frame or Data.frame[1]
        end
        sid = Data.sid or 0
        uid = Data.uid and _G.tonumber(Data.uid) or _G.tonumber(Data.Uid)
        title = Data.title and Data.title.sid or 0
    end
    local titleScale = _G.ConfigManager.discrete_cfg[100111] and _G.ConfigManager.discrete_cfg[100111][1][1] or 1
    ---@type _obj_HeadItemBase_GoTable
    local itemGoTable = _G.GetAutoGoTable(
        obj,
        function()
            if onClick then
                onClick(uid)
            else
                if
                    _G.BattleManager:GetInstance():CheckInBattle() or
                    _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.EmbattleView.Name) or
                    _G.UIManager:GetInstance():IsExitWindow(_G.ConfigManager.ui_cfg.SixVsSixEmbattleView.Name)
                then
                    _G.PopWindowManager:GetInstance():ShowAllTips(415)
                    return
                end
                if uid and uid > 0 then
                    if uid == _G.PlayerModel:GetInstance():GetPlayerUid() then
                        _G.PopWindowManager:GetInstance():ShowAllTips(620109)
                    else
                        _G.SystemSettingManager:GetInstance():OpenView(uid)
                    end
                end
            end
        end
    )
    if scale then
        itemGoTable.gameObject:SetLocalScaleXYZ(scale)
    end
    --等级
    itemGoTable.obj_lvNode:SetRectTransformSize(35, 35)
    if itemGoTable.FontImage_lv == nil then
        itemGoTable.FontImage_lv = { itemGoTable.aorimage_level1 }
    end

    if lv and lv > 0 then
        UIUtils.SetImageFont(itemGoTable.FontImage_lv, tostring(lv), _G.AorImageFont.Cardlevel)
    end
    if lv and showLv then
        itemGoTable.obj_lvNode:SetActiveE(1)
        if itemGoTable.aorimage_levelBg then
            itemGoTable.aorimage_levelBg:SetActiveE(1)
        end
    else
        itemGoTable.obj_lvNode:SetActiveE(0)
        if itemGoTable.aorimage_levelBg then
            itemGoTable.aorimage_levelBg:SetActiveE(0)
        end
    end

    --头像
    if not itemGoTable.aorImagePortrait then
        itemGoTable.aorImagePortrait = itemGoTable.aorimage_portrait:GetComponentE(_G.typeof(_G.CS.AorImage))
    end
    if style and style > 0 then
        local player_portrait = _G.ConfigManager.player_portrait_cfg[style]
        if player_portrait then
            local index = itemGoTable.aorrawimage_frame:GetSiblingIndexE()
            local index1 = itemGoTable.aorimage_portrait:GetSiblingIndexE()
            if player_portrait.type_portrait == 2 then
                --特效
                if index1 < index then
                    itemGoTable.aorimage_portrait:SetSiblingIndexE(index)
                end
                itemGoTable.aorImagePortrait.enabled = false
                if itemGoTable.portrait ~= player_portrait.effect_portrait then
                    itemGoTable.aorimage_portrait:ClearChildren()
                    itemGoTable.portrait = player_portrait.effect_portrait
                    UIUtils.LoadEffectTitleOrFrame(
                        player_portrait.effect_portrait,
                        itemGoTable.aorimage_portrait,
                        function(trans)
                            if itemGoTable.portrait ~= player_portrait.effect_portrait then
                                itemGoTable.portrait = nil
                                trans:DestroyObject()
                                return
                            end
                            local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                            parClip.NeedCheck = true
                            parClip.CheckCount = 10
                            parClip.CheckOne = 3
                        end
                    )
                end
            else
                if index1 > index then
                    itemGoTable.aorimage_portrait:SetSiblingIndexE(index - 1)
                end
                itemGoTable.portrait = nil
                itemGoTable.aorimage_portrait:ClearChildren()
                itemGoTable.aorImagePortrait.enabled = true
                itemGoTable.aorimage_portrait.SpriteName = player_portrait.portrait1
            end
        end
    else
        itemGoTable.aorImagePortrait.enabled = true
        itemGoTable.aorimage_portrait:ClearChildren()
        if sid > 0 then
            local player_portrait = require "CardCommentManager":GetInstance():CardData(sid)
            if player_portrait then
                itemGoTable.aorimage_portrait.SpriteName = player_portrait.Icon
            end
        end
    end
    --头像框
    if frame > 0 and showFrame then
        local player_frame = _G.ConfigManager.player_frame_cfg[frame]
        if player_frame and player_frame.type_title == 1 then
            itemGoTable.aorrawimage_frame:LoadImage(player_frame.frame)
            itemGoTable.aorrawimage_frame:SetActiveE(1)
            itemGoTable.obj_frameEffect:ClearChildren()
            itemGoTable.frame = nil
        elseif player_frame and player_frame.type_title == 2 then
            if itemGoTable.frame ~= player_frame.frame then
                itemGoTable.obj_frameEffect:ClearChildren()
                itemGoTable.frame = player_frame.frame
                UIUtils.LoadEffectTitleOrFrame(
                    player_frame.frame,
                    itemGoTable.obj_frameEffect,
                    function(trans)
                        if itemGoTable.frame ~= player_frame.frame then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                    end
                )
            end
            itemGoTable.aorrawimage_frame:SetActiveE(0)
        end
    else
        itemGoTable.obj_frameEffect:ClearChildren()
        itemGoTable.frame = nil
    end
    ---称号
    if title > 0 and showTitle then
        local player_title = _G.ConfigManager.player_title_effect_cfg[title]
        if player_title.type_title == 1 then
            itemGoTable.aorrawimage_title:LoadImage(player_title.title)
            itemGoTable.aorrawimage_title:SetActiveE(1)
            itemGoTable.aorrawimage_title:SetLocalScaleXYZ(0.29 * titleScale)
            itemGoTable.obj_titleEffect:ClearChildren()
            itemGoTable.title = nil
        elseif player_title.type_title == 2 then
            if itemGoTable.title ~= player_title.title then
                itemGoTable.obj_titleEffect:ClearChildren()
                itemGoTable.title = player_title.title
                UIUtils.LoadEffectTitleOrFrame(
                    player_title.title,
                    itemGoTable.obj_titleEffect,
                    function(trans)
                        if itemGoTable.title ~= player_title.title then
                            trans:DestroyObject()
                            return
                        end
                        local parClip = trans:AddComponentE(typeof(CS.ParticleClipRect))
                        parClip.NeedCheck = true
                        parClip.CheckCount = 10
                        parClip.CheckOne = 3
                        trans:SetLocalScaleXYZ(titleScale)
                    end
                )
            end
            itemGoTable.aorrawimage_title:SetActiveE(0)
        end
    else
        itemGoTable.aorrawimage_title:SetActiveE(0)
        itemGoTable.obj_titleEffect:ClearChildren()
        itemGoTable.title = nil
    end
end

---设置超出屏幕的rect坐标，使rect都在屏幕内
function UIUtils.SetOffScreenRectPosition(rect)
    -- 获取描点
    local Pivotx, Pivoty = rect:GetPivotPosition()
    rect:SetPivotPosition(0.5, 0.5)

    local width, height = rect:GetRectTransformSizeDelta()
    local x, y, z = rect:GetLocalPosition()
    -- 获得UIRoot大小
    local ScreenWidth, ScreenHeight = _G.UIManager:GetInstance().UIRootRect:GetRectTransformSizeDelta()
    ScreenWidth = ScreenWidth / 2
    ScreenHeight = ScreenHeight / 2

    if x + width / 2 > ScreenWidth then
        -- 右超出
        x = ScreenWidth - width / 2
    elseif x - width / 2 < -ScreenWidth then
        -- 左超出
        x = width / 2 - ScreenWidth
    end

    if y + height / 2 > ScreenHeight then
        -- 上超出
        y = ScreenHeight - height / 2
    elseif y - height / 2 < -ScreenHeight then
        -- 下超出
        y = height / 2 - ScreenHeight
    end

    rect:SetLocalPosition(x, y, z)
    -- 还原锚点
    rect:SetPivotPosition(Pivotx, Pivoty)
end

--Window加载完成后的回调调用，对涉及到的节点进行修改
function UIUtils.IsNeedChangeUI(target, tb)
    --第一次调用的时候初始化
    if _G.table.isEmptyOrNil(NeedChangeUI) then
        for k, _ in pairs(_G.ConfigManager.ui_params_cfg) do
            local str = string.split(k, "_")
            if not NeedChangeUI[str[1]] then
                NeedChangeUI[str[1]] = {}
            end
            if str[2] and str[3] then
                local name = str[2] .. "_" .. str[3]
                _G.table.insert(NeedChangeUI[str[1]], name)
            end
        end
        --根据修改优先级排个序，防止因为后修改父节点的锚点导致子节点偏移
        for k, _ in pairs(NeedChangeUI) do
            local name = k .. "_"
            _G.table.sort(
                NeedChangeUI[k],
                function(a, b)
                    local aOrder = _G.ConfigManager.ui_params_cfg[name .. a].order
                    local bOrder = _G.ConfigManager.ui_params_cfg[name .. b].order
                    return aOrder < bOrder
                end
            )
        end
    end
    local name = target.Name and target.name or target
    local goTable = target.View and target.View.go_table or tb
    if NeedChangeUI[name] then
        for _, v in ipairs(NeedChangeUI[name]) do
            if goTable[v] then
                _G.UIUtils.ChangeUI(
                    _G.ConfigManager.ui_params_cfg[name .. "_" .. v].params,
                    goTable[v],
                    goTable
                )
            elseif _G.AppSetting.DEBUG then
                _G.LogError(name .. "界面下的go_table中没有" .. v .. "节点")
            end
        end
    end
end

