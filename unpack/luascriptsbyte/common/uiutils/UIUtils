---加载光武特效
---@param cardId number 卡牌id 传nil时，对应光武皮肤id
---@param artifacteSkinId number 光武皮肤id ，传nil读取当前卡牌装备的光武皮肤id
---@param nowArtStage number 当前光武形态，传nil读取自身对专属神器历史最高星级对应的形态
---@param isUI boolean 是否为UI true为ui,false为战斗
function UIUtils.LoadArtifacteffect(trans, cardId,artifacteSkinId,nowArtStage)
    local iswearskin=false
    local skinid=nil
    ---@type artifact_skin_cfg
    local artifactskincfg=nil
    ---@type artifact_cfg
    local artifactcfg=nil
    if cardId~=nil then
        iswearskin,skinid=require "CardCommentManager":GetInstance():CardWearSkin(cardId)
        local cardCfg=_G.ConfigManager.card_cfg[cardId]
        artifactcfg=_G.ConfigManager.artifact_cfg[cardCfg.artifactid]
        ---卡牌是否拥有光武判断
        if not artifactcfg or table.isEmptyOrNil( artifactcfg.skin) then
            --_G.LogError(string.format("card %s not skin",cardId))
            return
        end
    else
        if  artifacteSkinId and artifacteSkinId>0 then
            artifactskincfg=_G.ConfigManager.artifact_skin_cfg[artifacteSkinId]
            artifactcfg=_G.ConfigManager.artifact_cfg[artifactskincfg.card]
        else
            --_G.LogError(string.format("cardid and artifacteSkinId mask choose one introduction "))
            return
        end
    end
    local ArtifactIllustrationModel=require("ArtifactIllustrationModel"):GetInstance()
    ---获取卡牌当前光武皮肤配置
    if artifacteSkinId==nil then
        if iswearskin then
            for i = 1, #artifactcfg.skin do
                artifactskincfg=_G.ConfigManager.artifact_skin_cfg[artifactcfg.skin[i]]
                if i==1 then
                    artifacteSkinId=artifactcfg.skin[1]
                else
                    if artifactskincfg and artifactskincfg.skin_id == skinid and
                            ArtifactIllustrationModel:ChectIsHasArtifactSkin(artifactcfg.id,artifactskincfg.id) then
                        artifacteSkinId=artifactcfg.skin[i]
                        break
                    end
                end
            end
        else
            artifacteSkinId=artifactcfg.skin[1]
        end
    end
    if artifactskincfg==nil then
        artifactskincfg=_G.ConfigManager.artifact_skin_cfg[artifacteSkinId]
    end
    ---卡牌专属神器是否激活判断
    if nowArtStage==nil then
        nowArtStage=ArtifactIllustrationModel:GetNowArtifactStage(artifactcfg.id)
        nowArtStage=nowArtStage-1
    end
    if nowArtStage==0  then
        --_G.LogError(string.format("artifact %s is initial,not effect",artifactcfg.id))
        ---防止形态预览时切换回初始形态特效未移除
        if artifactskincfg.ui_form_effect and #artifactskincfg.ui_form_effect>0 then
            for i = 1, #artifactskincfg.ui_form_effect[#artifactskincfg.ui_form_effect] do
                if i%2==1 then
                    local pointPath = trans:FindE(artifactskincfg.ui_form_effect[1][i])
                    if pointPath==nil  then
                        --_G.LogError(string.format("dont fint '%s'  point in artifact_skin_cfg:%s",artifactskincfg.ui_form_effect[nowArtStage][i],artifacteSkinId))
                    end
                    local tempCount = pointPath and pointPath:GetChildCountE() or 0
                    if tempCount > 0 then
                        for i = 1, tempCount + 1 do
                            _G.DestroyObject(pointPath:GetChildE(0))
                        end
                    end
                end
            end
        end
        return
    end
    if artifactskincfg.ui_form_effect and #artifactskincfg.ui_form_effect>0 then
        for i = 1, #artifactskincfg.ui_form_effect[nowArtStage] do
            if i%2==1 then
                local pointPath = trans:FindE(artifactskincfg.ui_form_effect[nowArtStage][i])
                if pointPath==nil  then
                    --_G.LogError(string.format("dont fint '%s'  point in artifact_skin_cfg:%s",artifactskincfg.ui_form_effect[nowArtStage][i],artifacteSkinId))
                end
                local tempCount = pointPath and pointPath:GetChildCountE() or 0
                if tempCount > 0 then
                    for i = 1, tempCount + 1 do
                        _G.DestroyObject(pointPath:GetChildE(0))
                    end
                end
                _G.UIUtils.LoadEffectByCfg(
                        _G.ConfigManager.ui_effect_cfg[artifactskincfg.ui_form_effect[nowArtStage][i+1]],
                        pointPath)
            end
        end
    else
        --_G.LogError(string.format("artifact_skin_cfg id:%s the ui_form_effect is nil",artifacteSkinId))
    end
end

---加载光武特效
---@param cardId number 卡牌id
---@param artifacteSkinId number 光武皮肤id ，传nil读取当前卡牌装备的光武皮肤id
---@param nowArtStage number 当前光武形态，传nil读取自身对专属神器历史最高星级对应的形态
---@param useDefault? boolean 如果不传皮肤id和形态, 使用默认
function UIUtils.LoadBattleSpineArtifact(trans, cardId, artifacteSkinId, nowArtStage, useDefault)
    local cardCfg = _G.ConfigManager.card_cfg[cardId]
    local artifactCfg = cardCfg and _G.ConfigManager.artifact_cfg[cardCfg.artifactid]
    ---卡牌是否拥有光武判断
    if not artifactCfg or _G.table.isEmptyOrNil(artifactCfg.skin) then
        -- if _G.AppSetting.DEBUG then
        --     _G.LogError(string.format("artifact %s not skin", artifactCfg.id))
        -- end
        return
    end

    ---卡牌专属神器是否激活判断
    local artifactIllustrationModel = require("ArtifactIllustrationModel"):GetInstance()
    if not nowArtStage then
        if useDefault then
            return
        else
            nowArtStage = artifactIllustrationModel:GetNowArtifactStage(artifactCfg.id)
            if nowArtStage == 0 then
                -- if _G.AppSetting.DEBUG then
                --     _G.LogError(string.format("artifact %s is not unlock", artifactCfg.id))
                -- end
                return
            end
            if nowArtStage == 1 then
                -- if _G.AppSetting.DEBUG then
                --     _G.LogError(string.format("artifact %s is initial,not effect", artifactCfg.id))
                -- end
                return
            end
            ---初始形态没有特效，不会有配置，故形态-1
            nowArtStage = nowArtStage - 1
        end
    elseif nowArtStage==0 then
        return
    end
    ---获取卡牌当前光武皮肤配置
    if not artifacteSkinId then
        artifacteSkinId = artifactCfg.skin[1]
        if not useDefault then
            local isWearSkin, wearSkinId = require("CardCommentManager"):GetInstance():CardWearSkin(cardId)
            if isWearSkin then
                for i = 2, #artifactCfg.skin do
                    local artifactSkinCfg = _G.ConfigManager.artifact_skin_cfg[artifactCfg.skin[i]]
                    if artifactSkinCfg and artifactSkinCfg.skin_id == wearSkinId and
                        artifactIllustrationModel:ChectIsHasArtifactSkin(artifactCfg.id, artifactSkinCfg.id) then
                        artifacteSkinId = artifactCfg.skin[i]
                        break
                    end
                end
            end
        end
    end
    _G.CS.BattleManager.Utils.UpdateArtifact(
        trans,
        artifacteSkinId,
        nowArtStage,
        nil --color
    )
end

