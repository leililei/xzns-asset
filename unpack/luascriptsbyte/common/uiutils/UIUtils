---初始化VideoManager
---@param callback fun(ok:boolean):void
---@return void
local function ready(callback)
    if _G.CS.VideoManager.Instance:IsReady() then
        if callback then
            callback(true)
        end
        return
    end

    if _G.AppSetting.DEBUG then
        _G.Log("VideoManager开始初始化")
    end
    _G.CS.VideoManager.Instance:LoadPrefab(function()
        if not _G.CS.VideoManager.Instance:IsReady() then
            if _G.AppSetting.DEBUG then
                _G.LogError("VideoManager初始化失败")
            end
            if callback then
                callback(false)
            end
            return
        end
        if _G.AppSetting.DEBUG then
            _G.Log("VideoManager初始化成功, 开始播放视频")
        end
        if callback then
            callback(true)
        end
    end)
end

