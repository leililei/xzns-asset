---获取3D位置映射到2D UI的位置
---@param rect UnityEngine.RectTransform @UI显示框
---@param worldpos UnityEngine.Vector3 @世界坐标位置
---@return UnityEngine.Vector3 @UI相对位置
function UIUtils.Get3DTo2DPos(rect, worldpos)
    if rect ~= nil then
        local uipos = ZeroV2
        local x, y = _G.GraphicsManager.Instance.MainCamera:WorldToScreenPointE(worldpos.x, worldpos.y, worldpos.z)
        local screenposvector2 = ZeroV2
        screenposvector2.x = x
        screenposvector2.y = y
        local ret, uipos = CS.UnityEngine.RectTransformUtility.ScreenPointToLocalPointInRectangle(
            rect,
            screenposvector2,
            _G.UIManager:GetInstance().UICamera
        )
        return uipos
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("请传入正确的RectTransform!")
        end
        return ZeroV3
    end
end

