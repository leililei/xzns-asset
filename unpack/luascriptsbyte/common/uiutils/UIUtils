--- 将传入路径转换成多语言资源路径
--- @param assetPath string 资源加载路径
--- @return string 多语言资源路径|传入路径自己
function UIUtils.ToLangVideoPath(assetPath)
    local ok, msg = pcall(function()
        if _G.CS.XLocalizationExtend ~= nil then
            if _G.CS.XLocalizationExtend.LocalizationHepler ~= nil and _G.CS.XLocalizationExtend.LocalizationHepler.GetUsedLang then
                local lang = _G.CS.XLocalizationExtend.LocalizationHepler.GetUsedLang()
                --转换成多语言资源
                if lang ~= "zh-CN" then
                    if _G.CS.ResourceLoad.ResourceManager.Instance.GetAssetRawPath then
                        -- 转成全小写且无后缀的字符串
                        local path = assetPath:lower():match("(.+)%.[^%.]+$")
                        -- 多语言中的路径
                        local langAssetRawPath = _G.CS.ResourceLoad.ResourceManager.Instance.GetAssetRawPath(path)
                        -- 拼接成多语言资源路径
                        if path ~= langAssetRawPath then
                            return "Langs/" .. lang .. '/' .. assetPath
                        end
                    end
                end
            end
        end
        return assetPath
    end)
    if not ok then
        if _G.AppSetting.DEBUG then
            _G.LogError(msg, "ToLangVideoPath Error:")
        end
        return assetPath
    end
    return msg
end

