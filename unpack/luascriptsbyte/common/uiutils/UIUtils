---@param images table AorImage对象数组
---@param ValueStr string ValueStr  nil不显示
---@param aorImageFont AorImageFont AorImageFont.Cardlevel
function UIUtils.SetImageFont(images, ValueStr, aorImageFont)
    if images == nil then
        if _G.AppSetting.DEBUG then
            _G.LogError(" UIUtils.SetImageFont images 参数无效")
        end
        return
    end
    local index = 1
    local imageP = images[1]:GetParent()
    local ChildCount = imageP:GetChildCountE()

    if ValueStr ~= nil then
        if aorImageFont == nil then
            if _G.AppSetting.DEBUG then
                _G.LogError(" UIUtils.SetImageFont aorImageFont 参数无效")
            end
            return
        end
        local names = aorImageFont.SpriteNames
        local Count = string.len(ValueStr)
        for i = 1, Count do
            local nowstr = string.sub(ValueStr, i, i)
            if names[nowstr] ~= nil then
                if images[index] == nil then
                    local obj = nil
                    if index <= ChildCount then
                        obj = imageP:GetChildE(index - 1)
                    end
                    if obj == nil then
                        obj = _G.InstantiateObject(images[1], imageP)
                    end
                    images[index] = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
                end
                if images[index] ~= nil and images[index] ~= false then
                    images[index].SpriteName = names[nowstr]
                    images[index]:SetNativeSize()
                    images[index]:SetActiveE(1)
                end
                index = index + 1
            end
        end
    end
    local Count = 0
    if ValueStr then
        Count = string.len(ValueStr)
    end
    --local Count = string.len(ValueStr)
    if ChildCount > Count then
        for i = Count + 1, ChildCount do
            if images[i] ~= nil and images[i] ~= false then
                images[i]:SetActiveE(0)
            end
        end
    end
end

