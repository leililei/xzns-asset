---通过配置表加载特效资源
---@param cfg ui_effect_cfg_Item 配置表
---@param parent UnityEngine.Transform 父节点
---@param loadedCall fun(obj:UnityEngine.Transform) 加载物体后的回调
---@param finishCall fun(obj:UnityEngine.Transform) 特效完成后的回调
function UIUtils.LoadEffectByCfg(cfg, parent, loadedCall, finishCall)
    if cfg then
        UIUtils.LoadEffectByPath(
            cfg.Path,
            parent,
            loadedCall,
            finishCall,
            cfg.LifeTime,
            cfg.Pos,
            cfg.Scale,
            cfg.DispoeType,
            cfg.AddUIParticleOrderChange,
            cfg.AddUIParticleScale,
            cfg.AddCanvas
        )
    elseif _G.AppSetting.DEBUG then
        _G.LogError("加载特效配置表失败")
    end
end

---加载指定路径的特效资源
---@param path string 路径
---@param parent UnityEngine.Transform 父节点
---@param loadedCall fun(obj:UnityEngine.Transform) 加载物体后的回调
---@param finishCall function 特效完成后的回调
---@param lifeTime number 生命周期
---@param pos numberp[]位置修正
---@param scale number 大小修正
---@param dispoeType number 回收方法（0销毁，1回收)
function UIUtils.LoadEffectByPath(
    path,
    parent,
    loadedCall,
    finishCall,
    lifeTime,
    pos,
    scale,
    dispoeType,
    addUIParticleOrderChange,
    addUIParticleScale,
    addCanvas)
    if ShieldEff[path] then
        --ZHJH-1884 屏蔽特效
        return
    end
    lifeTime = lifeTime or 0
    pos = pos or { 0, 0, 0 }
    scale = scale or 1
    dispoeType = dispoeType or 0
    addCanvas = addCanvas or 0
    _G.PoolsManager:GetInstance():Spawn(
        path,
        _G.ePoolType.UIEffect,
        parent,
        function(tran)
            if _G.IsNil(tran) then
                if _G.AppSetting.DEBUG then
                    _G.LogError("该特效已经为nil，请检查，path：" .. path)
                end
                return
            end

            if _G.IsNil(parent) then
                tran:DestroyObject()
                return
            end
            if addUIParticleOrderChange then
                tran:RequireComponentE(_G.typeof(_G.CS.UIParticleOrderChange))
            end
            if addUIParticleScale then
                tran:RequireComponentE(_G.typeof(_G.CS.UIParticleScale))
            end
            if addCanvas > 0 then
                tran:RequireComponentE(_G.typeof(_G.CS.UnityEngine.Canvas)).sortingOrder = addCanvas
            end

            tran:SetLocalPosition(pos[1], pos[2], pos[3])
            if pos[4] ~= nil then
                tran:SetLocalEulerAngles(pos[4] or 0, pos[5] or 0, pos[6] or 0)
            end

            local scx, scy, scz
            if IsTable(scale) then
                scx = scale[1] or 1
                if scale[2] ~= nil then
                    scy = scale[2] or 1
                    scz = scale[3] or 1
                end
            else
                scx = scale or 1
            end
            if scy == nil then
                scy = scx
                scz = scx
            end
            tran:SetLocalScale(scx, scy, scz)

            if lifeTime > 0 then
                local DelayDoGo = nil
                if not _G.IsNil(parent) then
                    DelayDoGo = parent
                elseif not _G.IsNil(tran) then
                    DelayDoGo = tran
                end
                if not _G.IsNil(DelayDoGo) then
                    _G.DelayDo(
                        lifeTime,
                        function()
                            if not IsNil(tran) then
                                UIUtils.RemoveEffect(tran, dispoeType, finishCall)
                            else
                                --在外部就已经删除掉了,因此这里不在需要删除
                                --_G.LogError("该特效已经为nil，请检查，path：" .. path)
                            end
                        end
                    )
                end
            end

            if loadedCall then
                loadedCall(tran, {})
            end
        end
    )
end

---移除特效资源
---@param trans Transform 回收对象
---@param dispoeType number 回收方法（0销毁，1回收)
function UIUtils.RemoveEffect(trans, dispoeType, finishCall)
    dispoeType = dispoeType or 0
    if trans then
        if dispoeType == 0 then
            _G.DestroyObject(trans)
        elseif dispoeType == 1 then
            _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIEffect)
        end
    else
        if _G.AppSetting.DEBUG then
            _G.LogError("", "<color=red>" .. "回收特效为空" .. "</color>")
        end
    end
    if finishCall then
        finishCall()
    end
end

