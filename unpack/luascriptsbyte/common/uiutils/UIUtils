---通过配置表播放视频资源
---@param cfg video_cfg 配置表
---@param endAction function 结束委托
---@param startAction function 开播委托
---@param dynamicVideoCfg DynamicVideoCfg 动态视频参数
function UIUtils.PlayVideo(cfg, endAction, startAction, dynamicVideoCfg)
    if not cfg then
        if startAction then
            startAction(true)
        end
        if endAction then
            endAction(true)
        end
        _G.Events:GetInstance():Broadcast(_G.VideoPlayState.PlayEnd)
        return
    end
    ready(function(ok)
        if not ok then
            if startAction then
                startAction(true)
            end
            if endAction then
                endAction(true)
            end
            return
        end

        local assetPath = UIUtils.ToLangVideoPath(cfg.VideoPath)
        if _G.AppSetting.DEBUG then
            _G.Log("VideoManager播放视频: " .. assetPath)
        end

        --播放测试视频
        _G.CS.VideoManager.Instance:PlayRemote(
            assetPath,
            startAction,
            endAction,
            false, --showSkip
            false, --isLoop
            true,  --fullScreen
            true   --autoDestroy
        )
    end);
end

