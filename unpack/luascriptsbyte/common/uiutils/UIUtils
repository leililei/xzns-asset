---设置物品品质特效
---@param cfg 配置表 nil隐藏特效
---@param isHide bool true隐藏特效
function UIUtils.SetItemGrade(go_table, cfg, isHide, parent, size)
    if cfg == nil or cfg.ef_item == 0 or cfg.ef_item == "0" then
        isHide = true
    end

    go_table.IsHideGrade = isHide
    local Grade = 0

    local ShowEff = function()
        if go_table.Grade_red ~= nil and go_table.Grade_red ~= false then
            go_table.Grade_red:SetActiveE(isHide ~= true and Grade == 5 and go_table.IsHideGrade ~= true and 1 or 0)
        end
        if go_table.Grade_orange ~= nil and go_table.Grade_orange ~= false then
            go_table.Grade_orange:SetActiveE(isHide ~= true and Grade == 4 and go_table.IsHideGrade ~= true and 1 or 0)
        end
        if go_table.Grade_purple ~= nil and go_table.Grade_purple ~= false then
            go_table.Grade_purple:SetActiveE(isHide ~= true and Grade == 3 and go_table.IsHideGrade ~= true and 1 or 0)
        end
    end
    if isHide then
        ShowEff()
        return
    end
    parent = parent or go_table.gameObject
    size = size or 1
    Grade = cfg.Quality
    if Grade == nil then
        Grade = cfg.grade
    end
    if Grade == nil then
        return
    end
    if go_table.Grade_red == nil and Grade == 5 then
        --- 占位 防止重复生成
        go_table.Grade_red = false
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_daoju_red,
            parent,
            function(tran)
                --- 防止 异步后
                if _G.IsNil(go_table.gameObject) then
                    tran:DestroyObject()
                    return
                end

                if tran ~= nil then
                    tran:SetLocalScaleXYZ(size)
                    tran:SetActiveE(0)
                    go_table.Grade_red = tran
                    ShowEff()
                end
            end
        )
    elseif go_table.Grade_orange == nil and Grade == 4 then
        --- 占位 防止重复生成
        go_table.Grade_orange = false
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_daoju_orange,
            parent,
            function(tran)
                if _G.IsNil(go_table.gameObject) then
                    tran:DestroyObject()
                    return
                end

                if tran ~= nil then
                    tran:SetLocalScaleXYZ(size)
                    tran:SetActiveE(0)
                    go_table.Grade_orange = tran
                    ShowEff()
                end
            end
        )
    elseif go_table.Grade_purple == nil and Grade == 3 then
        --- 占位 防止重复生成
        go_table.Grade_purple = false
        _G.UIUtils.LoadEffectByCfg(
            _G.ConfigManager.ui_effect_cfg.ef_daoju_purple,
            parent,
            function(tran)
                if _G.IsNil(go_table.gameObject) then
                    tran:DestroyObject()
                    return
                end

                if tran ~= nil then
                    tran:SetLocalScaleXYZ(size)
                    tran:SetActiveE(0)
                    go_table.Grade_purple = tran
                    ShowEff()
                end
            end
        )
    else
        ShowEff()
    end
end

---设置物品品质特效
---@param go_table table
---@param cfg {Quality:number, grade:number,ef_item:string|number} 物品配置表
---@param isHide bool true隐藏特效
function UIUtils.SetItemGradeNew(go_table, cfg, isHide, parent, size)
    if cfg == nil or cfg.ef_item == 0 or cfg.ef_item == "0" then
        isHide = true
    end
    go_table.isHideGrade = isHide

    --检查缓存的特效
    local grade = cfg and (cfg.Quality or cfg.grade)
    if not grade then
        return
    end
    if go_table.grade ~= grade then
        --已加载特效不是所需特效
        if go_table.gradeEffect and go_table.gradeEffect ~= 0 then
            _G.PoolsManager:GetInstance():Despawn(go_table.gradeEffect, _G.ePoolType.UIEffect)
        end
        go_table.grade = grade
        go_table.gradeEffect = nil
    end

    if go_table.gradeEffect == 0 then
        --特效正在加载中
        return
    end

    --隐藏已加载的特效
    if isHide then
        if go_table.gradeEffect then
            go_table.gradeEffect:SetActiveE(0)
        end
        return
    end

    --显示特效
    if go_table.gradeEffect then
        go_table.gradeEffect:SetActiveE(1)
    else
        go_table.gradeEffect = 0
        --加载对应品质的特效
        if ItemGradeEffects[grade] == nil then
            return
        end
        local cfg = _G.ConfigManager.ui_effect_cfg[ItemGradeEffects[grade]]
        if not cfg then
            return
        end
        parent = parent or go_table.gameObject
        _G.UIUtils.LoadEffectByCfg(cfg, parent, function(trans)
            if _G.IsNil(parent) or go_table.grade ~= grade then
                if trans then
                    _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.UIEffect)
                end
                return
            end
            trans:SetActiveE(go_table.isHideGrade and 0 or 1)
            trans:SetLocalScaleXYZ(size or 1)
            trans:RequireComponentE(_G.typeof(_G.CS.ParticleClipRect))
            go_table.gradeEffect = trans
        end
        )
    end
end

