        end
    end
end

--对obj进行指定的ui修改操作
---@param obj UnityEngine.GameObject
function UIUtils.ChangeUIMethod(cfg, obj, tb)
    if not cfg or not cfg[1] or not obj then
        return
    end
    local type = tonumber(cfg[1])

    if type == 0 then
        --设置父节点
        local parent = obj:GetParent()
        for i = 2, #cfg do
            local name = cfg[i]
            if i + 1 <= #cfg then
                tb = _G.GetAutoGoTable(tb[name])
            else
                parent = tb[name]
            end
        end
        obj:SetParentE(parent)
    elseif type == 1 then
        --显隐
        local visible = tonumber(cfg[2])
        obj:SetActiveE(visible)
    elseif type == 2 then
        --位移
        local position = { tonumber(cfg[2]), tonumber(cfg[3]), tonumber(cfg[4]) }
        obj:SetLocalPosition(position[1], position[2], position[3])
        if cfg[5] then
            local rotation
            if not cfg[6] then
                rotation = _G.Quaternion.Euler(0, 0, tonumber(cfg[5]))
            elseif cfg[6] and cfg[7] then
                rotation = _G.Quaternion.Euler(tonumber(cfg[5]), tonumber(cfg[6]), tonumber(cfg[7]))
            end
            obj:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
        end
    elseif type == 3 then
        --加载Image
        local image = obj:GetComponentE(_G.typeof(_G.CS.AorRawImage))
        if not image then
            image = obj:AddComponentE(_G.typeof(_G.CS.AorRawImage))
        end
        if image then
            image:LoadImage(
                cfg[2],
                function(img)
                    img:SetNativeSize()
                end
            )
        end
    elseif type == 4 then
        --修改文本颜色、描边、渐变
        local text = obj:GetComponentE(_G.typeof(_G.CS.AorText))
        if not text then
            text = obj:GetComponentE(_G.typeof(_G.CS.ExtendText))
        end
        if text then
            if not cfg[2] then
                return
            end
            local len = string.len(cfg[2])
            if len < 6 then
                local outline = obj:GetComponentE((_G.typeof(_G.CS.TextOutline)))
                if not outline then
                    outline = obj:AddComponentE((_G.typeof(_G.CS.TextOutline)))
                end
                if outline then
                    outline.OutlineWidth = tonumber(cfg[2])
                    if cfg[3] then
                        outline.OutlineColor = _G.ColorTools.FormatColorByString(cfg[3])
                    end
                end
            else
                if cfg[3] then
                    local gradient = obj:GetComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
                    if not gradient then
                        gradient = obj:AddComponentE(_G.typeof(_G.CS.FrameWork.AorUI.effects.Gradient))
                    end
                    if gradient then
                        if cfg[3] == cfg[2] and cfg[3] == "FFFFFF" then
                            gradient.enabled = false
                            return
                        end
                        gradient.enabled = true
                        local effectColor = gradient.effectColor
                        effectColor.a = 0
                        gradient.effectColor = effectColor
                        text.color = _G.ColorTools.FormatColorByString("FFFFFF")
                        local colors = {}
                        local alphas = {}
                        for i = 1, 2 do
                            local color = _G.CS.UnityEngine.GradientColorKey()
                            color.color = _G.ColorTools.FormatColorByString(cfg[i + 1])
                            color.time = i == 1 and 0 or 1
                            _G.table.insert(colors, color)
                            local alpha = _G.CS.UnityEngine.GradientAlphaKey()
                            alpha.alpha = (cfg[i + 3] and tonumber(cfg[i + 3]) or 255) / 255
                            alpha.time = i == 1 and 0 or 1
                            _G.table.insert(alphas, alpha)
                        end
                        gradient:GetGradient():SetKeys(colors, alphas)
                    end
                else
                    text.color = _G.ColorTools.FormatColorByString(cfg[2])
                end
            end
        end
    elseif type == 5 then
        --屏蔽特效
        local effCfg = _G.ConfigManager.ui_effect_cfg[cfg[2]]
        if effCfg then
            ShieldEff[effCfg.Path] = true
        else
            ShieldEff[cfg[2]] = true
        end
    elseif type == 6 then
        --修改子节点在父节点的排序
        obj:SetSiblingIndexE(tonumber(cfg[2]))
    elseif type == 7 then
        --修改锚点
        obj:SetPivotPosition(tonumber(cfg[2]), tonumber(cfg[3]))
    elseif type == 8 then
        --修改大小
        obj:SetRectTransformSize(tonumber(cfg[2]), tonumber(cfg[3]))
    elseif type == 9 then
        --修改布局器参数
        local isGird = false
        ---@type UnityEngine.UI.HorizontalLayoutGroup
        local layout = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup)) or
            obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.VerticalLayoutGroup))
        if not layout then
            layout = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
            isGird = true
            if not layout then
                return
            end
        end
        if cfg[2] then
            layout.padding.left = tonumber(cfg[2])
        end
        if cfg[3] then
            layout.padding.right = tonumber(cfg[3])
        end
        if cfg[4] then
            layout.padding.top = tonumber(cfg[4])
        end
        if cfg[5] then
            layout.padding.bottom = tonumber(cfg[5])
        end
        if cfg[6] then
            local pos = string.split(cfg[6], ",")
            if pos[2] then
                if isGird then
                    layout.spacing = _G.Vector2.New(tonumber(pos[1]), tonumber(pos[2]))
                else
                    layout.spacing = tonumber(pos[1])
                end
            else
                if isGird then
                    layout.spacing = _G.Vector2.New(tonumber(pos[1]), tonumber(pos[1]))
                else
                    layout.spacing = tonumber(cfg[6])
                end
            end
        end
        if cfg[7] then
            layout.childAlignment = AnchorEnum[tonumber(cfg[7])]
        end
        if cfg[8] then
            if isGird then
                local pos = string.split(cfg[8], ",")
                if pos[2] then
                    layout.cellSize = _G.Vector2.New(tonumber(pos[1]), tonumber(pos[2]))
                else
                    layout.cellSize = _G.Vector2.New(tonumber(pos[1]), tonumber(pos[1]))
                end
            else
                local params = string.split(cfg[8], ",")
                for i = 1, #params do
                    params[i] = tonumber(params[i]) == 1 and true or false
                end
                if params[1] then
                    layout.reverseArrangement = params[1]
                end
                if params[2] then
                    layout.childControlWidth = params[2]
                end
                if params[3] then
                    layout.childControlHeight = params[3]
                end
                if params[4] then
                    layout.childScaleWidth = params[4]
                end
                if params[5] then
                    layout.childScaleHeight = params[5]
                end
                if params[6] then
                    layout.childForceExpandWidth = params[6]
                end
                if params[7] then
                    layout.childForceExpandHeight = params[7]
                end
            end
        end
        if cfg[9] and isGird then
            local con = string.split(cfg[9], ",")
            if tonumber(con[1]) == 0 then
                layout.constraint = tonumber(con[1])
            else
                layout.constraint = tonumber(con[1])
                layout.constraintCount = con[2] and tonumber(con[2]) or 1
            end
        end
    elseif type == 10 then
        --修改图集
        local image = obj:GetComponentE(_G.typeof(_G.CS.AorImage))
        if not image then
            image = obj:AddComponentE(_G.typeof(_G.CS.AorImage))
        end
        if image then
            if cfg[2] and cfg[3] then
                local path = "AtlasH5/hCommon/hCommonAtlas"
                if cfg[2] ~= "hCommon" then
                    path = string.replace(path, "hCommon", cfg[2])
                end
                image:LoadAtlasSprite(
                    path,
                    cfg[3],
                    1,
                    function(img)
                        img.SpriteName = cfg[3]
                        img:SetNativeSize()
                    end
                )
            end
        end
    elseif type == 11 then
        --修改文本
        local str = _G.GetLangPackValue(cfg[2])
        if str == cfg[2] or str == "nil" then
            str = cfg[2]
        end
        local text = obj:GetComponentE(_G.typeof(_G.CS.AorText))
        if not text then
            text = obj:GetComponentE(_G.typeof(_G.CS.ExtendText))
        end
        if text then
            if str ~= "nil" and str ~= "" then
                text.text = str
            end
            if cfg[3] then
                text.fontSize = tonumber(cfg[3])
            end
            if cfg[4] then
                text.alignment = AnchorEnum[tonumber(cfg[4])]
            end
            if cfg[5] then
                text.resizeTextForBestFit = tonumber(cfg[5]) == 1
                text.resizeTextMaxSize = text.fontSize
                local min = 14
                if cfg[6] then
                    min = math.max(min, tonumber(cfg[6]))
                else
                    min = math.max(min, text.fontSize - 4)
                end
                text.resizeTextMinSize = min
            end
        end
    elseif type == 12 then
        --修改缩放
        if cfg[2] then
            if cfg[3] then
                if cfg[4] then
                    obj:SetLocalScale(tonumber(cfg[2]), tonumber(cfg[3]), tonumber(cfg[4]))
                else
                    obj:SetLocalScale(tonumber(cfg[2]), tonumber(cfg[3]), 1)
                end
            else
                obj:SetLocalScaleXYZ(tonumber(cfg[2]))
            end
        end
    elseif type == 13 then
        --添加布局器
        local layout = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup)) or
            obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.VerticalLayoutGroup)) or
            obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
        local lType = tonumber(cfg[2])
        if layout then
            layout:DestroyCompent()
        end
        --防止没有删除掉旧布局器就添加新的，延迟一帧处理
        _G.DelayFrameDo(function()
            if lType == 1 then
                layout = obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.UI.HorizontalLayoutGroup))
            elseif lType == 2 then
                layout = obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.UI.VerticalLayoutGroup))
            elseif lType == 3 then
                layout = obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.UI.GridLayoutGroup))
            end
        end)
    elseif type == 14 then
        --修改适配器
        ---@type UnityEngine.UI.ContentSizeFitter
        local csf = obj:GetComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter))
        if not csf then
            csf = obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.UI.ContentSizeFitter))
        end
        if cfg[2] then
            csf.horizontalFit = tonumber(cfg[2])
        end
        if cfg[3] then
            csf.verticalFit = tonumber(cfg[3])
        end
    elseif type == 15 then
        --生成Spine（对应界面的原spine生成前需要加一个检测）
        if cfg[2] then
            _G.PoolsManager:GetInstance():Spawn(
                cfg[2],
                _G.ePoolType.Temporary,
                obj,
                function(trans)
                    if trans == nil then
                        return
                    end
                    if _G.IsNil(obj) then
                        _G.PoolsManager:GetInstance():Despawn(trans, _G.ePoolType.Temporary)
                        return
                    end
                    trans:SetLocalPositionToZero()
                    if cfg[3] and cfg[4] and cfg[5] then
                        trans:SetLocalPosition(tonumber(cfg[3]), tonumber(cfg[4]), tonumber(cfg[5]))
                    end
                    if cfg[6] then
                        trans:SetLocalScaleXYZ(tonumber(cfg[6]))
                    else
                        trans:SetLocalScaleXYZ(1)
                    end
                    if cfg[7] then
                        GameUtil.SetCardUiSpineAnimation(trans, cfg[7], true)
                    end
                end
            )
        end
    elseif type == 16 then
        --生成effect
        if cfg[2] then
            local effectCfg = _G.ConfigManager.ui_effect_cfg[cfg[2]]
            if not effectCfg then
                return
            end
            _G.UIUtils.LoadEffectByCfg(
                effectCfg,
                obj,
                function(trans)
                    if trans == nil then
                        return
                    end
                    if _G.IsNil(obj) then
                        _G.DestroyObject(trans)
                    end
                end
            )
        end
    elseif type == 17 then
        --坐标偏移
        local position = { tonumber(cfg[2]), tonumber(cfg[3]), tonumber(cfg[4]) }
        local x, y, z = obj:GetLocalPosition()
        obj:SetLocalPosition(x + position[1], y + position[2], z + position[3])
    elseif type == 18 then
        --滑动列表布局器修改
        if obj:GetComponentE(_G.typeof(_G.CS.ScrollLoopVertical)) or
            obj:GetComponentE(_G.typeof(_G.CS.ScrollLoopHorizontal))
        then
            local left = tonumber(cfg[2]) or 0
            local top = tonumber(cfg[3]) or 0
            local sizeX = tonumber(cfg[4]) or 0
            local sizeY = tonumber(cfg[5]) or 0
            local spacingX = tonumber(cfg[6]) or 0
            local spacingY = tonumber(cfg[7]) or 0
            obj:InitBaseData(left, top, sizeX, sizeY, spacingX, spacingY)
        end
    elseif type == 19 then
        --锚点坐标修改
        local x = tonumber(cfg[2]) or 0
        local y = tonumber(cfg[3]) or 0
        obj:SetAnchorPosition(x, y)
        if cfg[4] then
            local rotation
            if not cfg[5] then
                rotation = _G.Quaternion.Euler(0, 0, tonumber(cfg[4]))
            elseif cfg[5] and cfg[6] then
                rotation = _G.Quaternion.Euler(tonumber(cfg[4]), tonumber(cfg[5]), tonumber(cfg[6]))
            end
            obj:SetLocalRotation(rotation.x, rotation.y, rotation.z, rotation.w)
        end
    elseif type == 20 then
        --修改对齐方式
        local minX = tonumber(cfg[2]) or 0.5
        local minY = tonumber(cfg[3]) or 0.5
        local maxX = tonumber(cfg[4]) or 0.5
        local maxY = tonumber(cfg[5]) or 0.5
        obj:SetRectTransformAnchor(minX, minY, maxX, maxY)
    elseif type == 21 then
        --添加canvas组件
        local canvas = obj:AddComponentE(_G.typeof(_G.CS.UnityEngine.Canvas))
        obj:AddComponentE(_G.typeof(_G.CS.AorGraphicRaycaster))
        local order = tonumber(cfg[2])
        if cfg[3] then
            local viewCfg = _G.ConfigManager.ui_cfg[cfg[3]]
            if viewCfg and _G.UIManager:GetInstance():GetWindow(viewCfg.Name) then
                order = order + _G.UIManager:GetInstance():GetWindow(viewCfg.Name).LayerSorting
            end
        end
        canvas.overrideSorting = true
        canvas.sortingOrder = order
    elseif type == 22 then
        --生成spine点击对象
        _G.PoolsManager:GetInstance():Spawn(
            "UIH5_xzns/Common/@_obj_SpineClick",
            _G.ePoolType.UIItem,
            obj:GetParent(),
            function(tran)
                if not tb then
                    _G.PoolsManager:GetInstance():Despawn(tran, _G.ePoolType.UIItem)
                    return
                end
                local index = obj:GetSiblingIndexE()
                tran:SetSiblingIndexE(index + 1)
                tb.obj_SpineClick = tran
                tran:SetRectTransformSize(_G.tonumber(cfg[4]), _G.tonumber(cfg[5]))
                ---@type SpineClick
                local SpineClick = require("SpineClick").New(tran, obj, _G.tonumber(cfg[2]), _G.tonumber(cfg[3]), cfg[6])
                tb.SpineClick_Lua = SpineClick
            end
        )
    end
end

--获取对应界面的指定节点是否有修改，需要在IsNeedChangeUI后调用
function UIUtils.IsHaveChange(name, obj)
    if not NeedChangeUI[name] then
        return false
    end
    for _, v in pairs(NeedChangeUI[name]) do
        if v == obj then
            return #_G.ConfigManager.ui_params_cfg[name .. "_" .. v].params > 0
        end
    end
    return false
end

--获取对应界面是否展示2D战斗Spine
---@param name UseBattleSpine
function UIUtils.IsUseBattleSpine(name)
    local cfgId = 200001
    local cfg = _G.ConfigManager.discrete_cfg[cfgId] and _G.ConfigManager.discrete_cfg[cfgId][1] or {}
    if _G.table.isEmptyOrNil(cfg) then
        return false
    end
    for _, v in pairs(cfg) do
        if name == tonumber(v) then
            return true
        end
    end
    return false
end

--获取卡牌对应的2D战斗Spine路径，若没有配则使用UI用Spine
---@param cfg card_cfg|skin_cfg|card_show_cfg
---@param name UseBattleSpine
function UIUtils.GetBattleSpine(cfg, name)
    local path = cfg.ModelPathHi
    local battlePath = cfg.spine
    local isSkin = cfg.card and cfg.card ~= cfg.id
    local cardCfg = cfg
    if isSkin then
        cardCfg = _G.ConfigManager.card_cfg[cfg.card]
        battlePath = cardCfg.spine
    end
    if not battlePath then
        return path
    end
    if AppSetting.IsXzns and cfg.card then
        battlePath = cfg.spine[1]
    else
        if battlePath[1] then
            local _, skinId = require("CardCommentManager"):GetInstance():CardWearSkin(cardCfg.id)
            local skinCfg = _G.ConfigManager.skin_cfg[skinId]
            local skinPath = skinCfg and skinCfg.spine[1] or nil
            battlePath = skinPath and skinPath or battlePath[1]
        end
    end
    if battlePath and #battlePath > 0 then
        if name then
            return _G.UIUtils.IsUseBattleSpine(name) and battlePath or path
        end
        path = battlePath
    end
    return path
end

function UIUtils.SetUIModel(obj,image,obj2,image2,iconName,isShow)
    if isShow == false then
        obj:SetActiveE(0)
        if obj2 then
            obj2:SetActiveE(0)
        end
        return
    end
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    local image = uiModel and image or image2
    local obj = obj
    if obj2 then
        obj2:SetActiveE(uiModel and  1 or 0)
        obj:SetActiveE(uiModel and  0 or 1)
    end
    if iconName then
        image.SpriteName = iconName
    end
end

function UIUtils.SetUIModelText(text1,text2,Name)
    local uiModel = _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.ui_model_1)
    text1.text = Name
    if text2 then
        text2:SetActiveE(uiModel and  1 or 0)
        text1:SetActiveE(uiModel and  0 or 1)
        text2.text = Name
    end
end
