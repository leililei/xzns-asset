---@class View_PropUp : UIBaseView
local View_PropUp = _G.BaseClass("View_PropUp", _G.UIBaseView)

---类的构造函数
------@param obj UnityEngine.GameObject
function View_PropUp:Awake()
    _G.AddViewBtnClick(self.go_table.gameObject, _G.handler(self, self.OnClickBtn))

    self.PosDic = {}
    local cardinfo = _G.GetAutoGoTable(self.go_table.obj_CardInfo)
    self.PosDic = {
        CardInfo = {
            one = _G.GetAutoGoTable(cardinfo.obj_one),
            two = _G.GetAutoGoTable(cardinfo.obj_two)
        }
    }

    ---装备tips属性及图片
    self.EquipProp = {
        [_G.AttrType.max_hp.key] = {
            up = "ui_jssx_ts_sm",
            down = "ui_jssx_jd_sm"
        },
        [_G.AttrType.atk.key] = {
            up = "ui_jssx_ts_gj",
            down = "ui_jssx_jd_gj"
        },
        [_G.AttrType.def.key] = {
            up = "ui_jssx_ts_fy",
            down = "ui_jssx_jd_fy"
        },
        [_G.AttrType.bre.key] = {
            up = "ui_jssx_ts_pj",
            down = "ui_jssx_jd_pj"
        }
    }
end

function View_PropUp:UpdatePos(Params_View_PropUp)
    Params_View_PropUp = Params_View_PropUp or {}
    self.AfterPosx = Params_View_PropUp.Posx
end

---@field Posx number 属性节点x坐标  角色背包245 角色属性-290
---@class Params_View_PropUp

---@param call function 若有属性变动 则调用
function View_PropUp:OnCreate(CardData, LastCardEquipProp, call, Params_View_PropUp)
    self.call = call
    Params_View_PropUp = Params_View_PropUp or {}
    self.Posx = Params_View_PropUp.Posx
    if self.AfterPosx then
        self.Posx = self.AfterPosx
    end

    if self.Posx ~= nil then
        local objOne = self.PosDic.CardInfo.one.gameObject
        local objTwo = self.PosDic.CardInfo.two.gameObject
        local x1, y1 = objOne:GetAnchorPosition()
        local x2, y2 = objOne:GetAnchorPosition()
        objOne:SetAnchorPosition(self.Posx, y1)
        objTwo:SetAnchorPosition(self.Posx, y2)
    end

    self:ShowEquipProp(CardData, LastCardEquipProp, Params_View_PropUp)
end

---显示装备tips属性
---@param Params_View_PropUp Params_View_PropUp 每次都传 界面打开后重复调用要刷新
function View_PropUp:ShowEquipProp(CardData, LastCardEquipProp, Params_View_PropUp)
    if self.go_table == nil then
        return
    end
    ---显示顺序
    -- local ShowSort = {
    --     [_G.AttrType.bre.key] = 9,
    --     [_G.AttrType.def.key] = 8,
    --     [_G.AttrType.atk.key] = 7,
    --     [_G.AttrType.max_hp.key] = 6
    -- }

    local curProp = Params_View_PropUp.prop
    if not curProp then
        local cardProp 
        if CardData.GetCardSumAttr then
           cardProp =  CardData:GetCardSumAttr()
        else
            -- 兼容神器图鉴界面，激活属性弹窗
            cardProp = CardData
        end
        curProp = {
            [_G.AttrType.max_hp.key] = 0,
            [_G.AttrType.atk.key] = 0,
            [_G.AttrType.def.key] = 0,
            [_G.AttrType.bre.key] = 0
        }
        for key, value in pairs(curProp) do
            curProp[key] = cardProp[key]
        end
    end

    local diffs = {}

    for key, value in pairs(curProp) do
        if curProp[key] - LastCardEquipProp[key] ~= 0 then
            diffs[key] = curProp[key] - LastCardEquipProp[key]
        end
    end
    LastCardEquipProp = _G.DeepCopy(curProp)

    local list = {}
    for key, value in pairs(diffs) do
        table.insert(list, key)
    end

    table.sort(
        list,
        function(b, a)
            ---固定显示
            -- if ShowSort[b] < ShowSort[a] then
            -- ---值大到小
            if _G.math.abs(diffs[b]) > _G.math.abs(diffs[a]) then
                return true
            end
            return false
        end
    )

    local count = 0
    for i = 1, #list do
        if diffs[list[i]] ~= 0 then
            count = count + 1
            self:LoadEffect(diffs, list, i, count)
        end
    end
    if count ~= 0 then
        if self.call then
            self.call()
        end
    end
    self:SetCloseTime()
end

function View_PropUp:LoadEffect(diffs, list, i, count)
    local isUp = diffs[list[i]] >= 0
    local delay = isUp and 0.1 * (#list - i - 1) or 0.1 * (i - 1)
    _G.DelayDo(delay,function()
        local cfg = isUp and _G.ConfigManager.ui_effect_cfg.EquipProp1 or _G.ConfigManager.ui_effect_cfg.EquipProp2
        _G.UIUtils.LoadEffectByCfg(
            cfg,
            -- self.go_table.obj_node,
            self.PosDic.CardInfo.one[string.format("obj_EquipProp%d", count)],
            function(tran)
                local tb = _G.GetAutoGoTable(tran)
                if isUp then
                    tb.aorimage_Txt.SpriteName = self.EquipProp[list[i]].up
                    tb.aortext_Num.text = math.floor(diffs[list[i]])
                else
                    tb.aorimage_Txt1.SpriteName = self.EquipProp[list[i]].down
                    tb.aortext_Num.text = math.floor(_G.Mathf.Abs(diffs[list[i]]))
                end
                tb.aortext_symbol.text = isUp and "+" or "-"

                tb.Anim = tran:GetComponentE(_G.typeof(_G.CS.UnityEngine.Animator))
                tran:SetParentE(self.PosDic.CardInfo.two[string.format("obj_EquipProp%d", count)])
                tb.Anim.enabled = true
                -- _G.DelayDo(
                --     0.2,
                --     function()
                --         tran:SetParentE(self.PosDic.CardInfo.two[string.format("obj_EquipProp%d", count)])
                --         tb.Anim.enabled = true
                --     end
                -- )
            end,
            function()
            end
        )
    end)

end

function View_PropUp:OnClickBtn(go)
    local name = go:GetName()

    if name == "@_aorbtn_closeSx" then
        self:CloseView(false)
    end
end
function View_PropUp:SetCloseTime()
    self:Stop_CloseTimer()
    self.Timer_Close = _G.TimerManager:GetInstance():GetTimer(1, self.CloseView, self, true)
    self.Timer_Close:Start()
end

function View_PropUp:Stop_CloseTimer()
    if self.Timer_Close ~= nil then
        self.Timer_Close:Stop()
        self.Timer_Close = nil
    end
end

function View_PropUp:CloseView()
    self:Close()
end

---类的析构函数
function View_PropUp:OnDestroy()
    self.AfterPosx = nil
    self:Stop_CloseTimer()
end
return View_PropUp
