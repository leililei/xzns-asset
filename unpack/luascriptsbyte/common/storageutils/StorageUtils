---
--- 游戏外部通用接口
---@class StorageUtils    抽卡界面辅助工具类
local StorageUtils = {}
_G.StorageUtils = StorageUtils


---检测卡牌背包并扩充
---@param callback function --界面处理回调
function StorageUtils.CardBagAdd(callBack, obj)
    local cfg = _G.ConfigManager.storage_cfg[_G.StorageID.Card]
    local limit = cfg.extension_limit
    local Number = _G.StorageManager:GetInstance():GetStorageCapacityTimes(_G.StorageID.Card)
    if Number ~= nil and Number < limit then
    else
        _G.PopWindowManager:GetInstance():ShowAllTips(380107)
        return
    end

    local cfg = _G.ConfigManager.storage_cfg[_G.StorageID.Card]
    local content = {}
    content = _G.LangUtil.GetLangPackValue(
        _G.ConfigManager.tips_system_cfg[1002].content,
        string.format(
            "%d%s",
            cfg.extension_consumption,
            _G.LangUtil.GetLangPackValue(_G.ConfigManager.currency_type_cfg[12].name)
        ),
        cfg.extension
    )
    _G.PopWindowManager:GetInstance():ShowAllTips(1002, content, function()
        if
            _G.StorageManager:GetInstance():GetItemCountByID(_G.StorageID.ResProp, _G.ResPropID.Diamond) <
            _G.ConfigManager.storage_cfg[_G.StorageID.Card].extension_consumption
        then
            _G.Events:GetInstance():AddListener(_G.eUIManagerStatus.OnUIOpened, function()
                if obj == _G.ConfigManager.ui_cfg.GetItemWayView.Name then
                    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.ConsumeItemsView.Name)
                    _G.Events:GetInstance():RemoveListener(_G.eUIManagerStatus.OnUIOpened, obj.Close, obj)
                end
            end, obj)
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.GetItemWayView.Name, _G.ResPropID.Diamond)

            return
        end
        ---@type storage.c2s_storage_unlock
        local data = {}
        data.type = _G.StorageType.Card
        require("StorageNet"):GetInstance():CardBag(data, function()
            _G.PopWindowManager:GetInstance():ShowAllTips(320111)
            if callBack then
                callBack()
            end
        end)
    end, callBack, nil, nil, 2)
end

return StorageUtils
