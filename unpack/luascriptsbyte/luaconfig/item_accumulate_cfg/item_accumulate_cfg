
local title = { id = 1 , duration = 2 , ratio_recharge = 3 , price_max_id = 4 , mail_id = 5 , expiration_time = 6}
local findT = {
	__index=function(t,key)
		if not key or not title[key] then
			return nil
		end
		return t[title[key]]
	end
}
local item_accumulate_cfg = {
	[1001] = {1001,30,1000,100000,0,0},
	[1002] = {1002,30,1500,300000,0,0},
	[2001] = {2001,7,9000,0,335,2},
	[2002] = {2002,14,8000,0,335,2},
	[2003] = {2003,14,9000,0,335,2}
}
for _, value in pairs(item_accumulate_cfg) do
    setmetatable(value,findT)
end
return _G.ConstClass("item_accumulate_cfg",item_accumulate_cfg)