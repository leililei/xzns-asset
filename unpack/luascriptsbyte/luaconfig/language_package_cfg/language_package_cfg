	[90022500309] = "<color=#018e43>奥术巨像</color>可以获得<color=#018e43>曙光圣所</color>所需要的额外材料，记得每天去看看！",
	[90022500310] = "<color=#018e43>原石秘境</color>已开启",
	[90022500311] = "请选择<color=#018e43>原石秘境</color>",
	[90022500312] = "<color=#018e43>原石秘境</color>每日可产出装备强化材料",
	[90022500313] = "<color=#018e43>五灵宝珠</color>开启，<color=#018e43>五灵宝珠</color>蕴藏着属性之力，对应着五行相生相克。",
	[90022500314] = "<color=#018e43>五灵宝珠</color>选择强者也被强者驾驭，只有当角色达到<color=#018e43>橙色品质</color>时才能驾驭<color=#018e43>五灵宝珠</color>。",
	[90022500315] = "当能够驾驭<color=#018e43>五灵宝珠</color>的角色越多，<color=#018e43>五灵宝珠</color>发挥出的威力增强属性也越大。",
	[90022500316] = "<color=#018e43>芦花幻境</color>已开放，风花雪月四圣天分别镇守着自己的藏宝之地。",
	[90022500317] = "击败四圣，夺取<color=#018e43>藏品</color>，不同的<color=#018e43>藏品</color>，可为各位冒险者带来各类的加成。还可以获得女神手办<color=#018e43>首饰</color>来增强女神。",
	[90022500318] = "想要高效率的挖掘宝贝少不了一些技巧，让我来教教你",
	[90022500319] = "这次就让我作为<color=#018e43>助战角色</color>临时加入队伍吧！",
	[90022500320] = "我擅长<color=#018e43>治疗</color>，可以为队伍提供持续的<color=#018e43>恢复效果</color>。",
	[90022500321] = "治疗援助就交给我吧！",
	[90022500322] = "这次就让我的守护灵<color=#018e43>李轩辕</color>作为<color=#018e43>助战角色</color>登场吧！",
	[90022500323] = "<color=#018e43>李轩辕</color>擅长<color=#018e43>突袭后排</color>，是强力的迅捷型守护灵。",
	[90022500324] = "<color=#018e43>李轩辕</color>，给他们点颜色看看！",
	[90022500325] = "我和李轩辕的羁绊已经足够强烈。现在可以使用我们的<color=#018e43>圣兽</color>了！",
	[90022500326] = "合理搭配<color=#018e43>圣兽</color>，可以给予敌人重大打击。",
	[90022500327] = "部分<color=#018e43>圣兽</color>不需要主动施放，在满足条件后即可发动！",
	[90022500328] = "冒险者拥有一套自己的<color=#018e43>等级评级</color>。",
	[90022500329] = "冒险者根据实力划分出了不同的等级，等级越高，每日可领取的<color=#018e43>奖励</color>越好。",
	[90022500330] = "完成对应的考核任务，即可提升<color=#018e43>地狱道等级</color>！",
	[90022500331] = "<color=#018e43>共鸣神石</color>可以快速补齐新角色的等级，还请善加利用。",
	[90022500332] = "挂机收益提升",
	[90022500333] = "倒计时",
	[90022500334] = "哇！你新获得了许多<color=#018e43>召唤卷轴</color>！",
	[90022500335] = "有了<color=#018e43>召唤卷轴</color>就能招募到更多<color=#018e43>寄灵人</color>和<color=#018e43>守护灵</color>作为同伴了！",
	[90022500336] = "请点击十连抽",
	[90022500337] = "<color=#018e43>高阶竞技场</color>已开启",
	[90022500338] = "<color=#018e43>高阶竞技场</color>根据段位可持续累计<color=#018e43>斗金币</color>，且战斗需要<color=#018e43>三队</color>阵容进行",
	[90022500339] = "<color=#018e43>泰坦寓所</color>已开放！直面雪王的寒霜！",
	[90022500340] = "击败雪王，可获得<color=#018e43>契约书页</color>升级<color=#018e43>圣兽</color>。",
	[90022500341] = "<color=#018e43>冥界入侵</color>已开放！在无尽的入侵中幸存下来，直面恐惧，突破重围。",
