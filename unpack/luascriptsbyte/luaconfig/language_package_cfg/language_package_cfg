	[10100003159] = "曹焱兵将找到的日记残片递给孩子，告诉他发生了什么。",
	[10100003160] = "原来是这样……妈妈她已经……呜呜呜……居然发生了这样的事……",
	[10100003161] = "我想，你哥哥没写完的那句话，是想和你在人间重聚。",
	[10100003162] = "你可要保重好你自己，别让怨念侵蚀了心灵，只有获得转世资格，才有机会和哥哥重聚呀。",
	[10100003163] = "小孩听完这话，从地上站起来，擦干了眼泪。",
	[10100003164] = "嗯，你说得对，总有一天，我会和哥哥再次见面的，不能在这里死掉。",
	[10100003165] = "你哥哥在明镜台转生，和我们一起去送他一程吧。",
	[10100003166] = "嗯！",
	[10100003167] = "樵夫",
	[10100003168] = "等等，这里还有些物资可以拿。",
	[10100003169] = "狡猾的恶灵",
	[10100003170] = "害怕的幽灵",
	[10100003171] = "还不清楚，他们似乎还没有要现身的迹象。我先解决完眼前这些恶灵，再去把它找出来。",
	[10100003172] = "啊啊啊啊……",
	[10100003173] = "在上面！有人从上面掉下来了！",
	[10100003174] = "曹焱兵反应迅速，起步跳跃接住了从楼顶坠落的幽灵。",
	[10100003175] = "哼哼，身手不错，有资格做我的对手。\n就让我亲手结果你的性命吧！",
	[10100003176] = "高等恶灵",
	[10100003177] = "众恶灵",
	[10100003178] = "可能因为我是曹操的后人的缘故，现在他成了我的守护灵，是我的得力助手。",
	[10100003179] = "主公过奖！",
	[10100003180] = "需要……吸食……法力……",
	[10100003181] = "两人谈话间，四周的恶灵已经聚过来，一个接着一个朝曹焱兵的摩托车进攻。",
	[10100003182] = "我乃罗刹街冒险者曹焱兵！想活命的统统给我闪开！",
	[10100003183] = "饿死了，就没有什么可以吃的东西吗？",
	[10100003184] = "你已经问过100遍了。",
	[10100003185] = "我们带的干粮前天就吃完了。",
	[10100003186] = "不行了，我饿得走不动路了。",
	[10100003187] = "夏铃原地坐下休息。",
	[10100003188] = "我们再去附近找找有没有能吃的果子吧。",
	[10100003189] = "我找到了！这里有个包裹！",
	[10100003190] = "嗯？里面只有一只旧鞋子……",
	[10100003191] = "就知道没有天上掉馅饼的好事。\n馅饼？不行不行，这种时候怎么能想到这种美味！",
	[10100003192] = "唉，明明山上这么多树，一颗结果子的都没有。",
	[10100003193] = "喂，你们是哪里来的？翻我包裹做什么？",
	[10100003194] = "咦，有人？",
	[10100003195] = "糟糕，我好像踩到机械人的巡逻范围了……\n总之赶紧回到来的地方，重新开始吧。",
	[10100003196] = "哦，你们在找吃的啊？",
	[10100003197] = "附近的流云谷有不少野味，会打猎的话就能打到一些。",
	[10100003198] = "有肉可以吃？走，我们去看看。",
	[10100003199] = "附近的流云谷有不少野味，会打猎的话就能打到一些。",
	[10100003200] = "这里应该就是流云谷了。",
	[10100003201] = "安静，有东西来了。",
	[10100003202] = "吼吼吼——",
	[10100003203] = "哇，好大一只，大家小心！",
	[10100003204] = "大家齐力杀死了猛兽。",
	[10100003205] = "太顺利了吧，那，我们现在要怎么吃呀？烤肉？",
	[10100003206] = "吃不了了。",
	[10100003207] = "什么？",
	[10100003208] = "你看。",
	[10100003209] = "夏铃凑过去一看，从野兽腹部源源不断地流出绿色汁水，并且发出强烈的腐臭气味。",
	[10100003210] = "好、好恶心！",
	[10100003211] = "现在怎么办，要继续在附近狩猎吗？",
	[10100003212] = "就在一筹莫展之时，大家听见从远处传来一阵唱歌和欢笑声。",
	[10100003213] = "你们听见了吗？好像有很多人在那边。",
	[10100003214] = "说不定这附近有个村子，我们去看看。",
	[10100003215] = "三人来到一处平坦开阔之处的村庄。",
	[10100003216] = "村民们正在这里载歌载舞。",
	[10100003217] = "走了这么远的路，终于看到村子了。\n这里好热闹啊。",
	[10100003218] = "有陌生人来了！\n喂，你们是旅行者吗？",
	[10100003219] = "没错，我们从罗刹街来的。不知道可不可以在这里……",
	[10100003220] = "啊，罗刹街，那真是走了好远的路！",
	[10100003221] = "一路上一定饿了吧，我们正在举行祭祀活动，马上就要开始晚餐了，你们也一起吃吧，别客气！",
	[10100003222] = "那真是太谢谢你了！我们饿了两天了。",
	[10100003223] = "这里的人还真热情啊。",
	[10100003224] = "三人在村民的邀请下，饱餐了一顿。",
	[10100003225] = "我吃饱了。多谢招待！",
	[10100003226] = "不知道你们在举行什么活动啊？好热闹。",
	[10100003227] = "哦，那是祈祷猛兽退散的活动。",
	[10100003228] = "村子附近有三只猛兽出没，几乎每隔两天，都会趁夜进入村子，第二天就会有一个村民消失。",
	[10100003229] = "大家都很害怕，所以想举办一场祭祀，祈祷今后猛兽少出现。",
	[10100003230] = "难道就是我们遇到的……嗯？焱兵，你去哪？",
	[10100003231] = "你们说的猛兽应该就在附近吧？",
	[10100003232] = "啊，嗯。",
	[10100003233] = "我可不能白吃别人的东西，走吧，夏铃，小亮，我们进山打野兽去。",
	[10100003234] = "别客气，把这里当自己家一样吧。",
	[10100003235] = "希望神明帮助我们赶走猛兽。",
	[10100003236] = "昨天姐姐被猛兽抓走了……希望今天之后不要再发生这样的事了。",
	[10100003237] = "哥哥，感觉到了吗？附近有野兽的气息。",
	[10100003238] = "吼吼吼——",
	[10100003239] = "看来是这里了。",
	[10100003240] = "现在解决了两只，加上今天白天的，一共三只。",
	[10100003241] = "我想这里的猛兽已经都被我们解决掉了。",
	[10100003242] = "我们在附近休息一晚，明天白天去村子里告诉村民们好消息吧。",
	[10100003243] = "村民们知道猛兽已经被干掉，一定很高兴吧！",
	[10100003244] = "呜呜呜呜……",
	[10100003245] = "三人进入村庄，村子里气氛却十分低沉，不少人正低声哭泣。",
	[10100003246] = "这是怎么回事？",
	[10100003247] = "唉，真惨啊……",
	[10100003248] = "咦，是我们来村子前遇到过的人。",
	[10100003249] = "咦，你们不是昨天找东西吃的人吗？",
	[10100003250] = "曹焱兵将杀野兽的事告诉了货郎。",
	[10100003251] = "原来是这样，你可真是个热心肠。",
	[10100003252] = "不过，真不幸啊，昨晚你们进山后又来了一只猛兽，今儿早上大家就发现一个孩子不见了，唉，那孩子才9岁呐。",
	[10100003253] = "村民们告诉我有三只野兽，难道还有？",
	[10100003254] = "那可不是。昨晚我半夜从邻村送货回来，亲眼看见的。",
	[10100003255] = "可恶，我们该留一个人在村子里的。",
	[10100003256] = "你看清往哪里跑了吗？我现在去把它找出来。",
	[10100003257] = "真的？你可真是个侠义心肠的人。",
	[10100003258] = "那怪物往流云山顶跑去了，我来给你带路吧。",
	[10100003259] = "就在这里了。",
	[10100003260] = "猛兽就在这附近吗？好，小亮，夏铃，我们去附近找找。",
	[10100003261] = "不，我是说……",
	[10100003262] = "就在这里处决你们吧。",
	[10100003263] = "什么？",
	[10100003264] = "什么情况？那些家伙是？",
	[10100003265] = "我假扮成村民，每天晚上就带一个人进山，给附近的恶灵帮。",
	[10100003266] = "这样可以换一些银子，还能顺便分我一口。",
	[10100003267] = "没想到半路上杀出了你们，本想引你们去野兽聚集的地方，死在兽爪之下，没想到你们有点能耐。",
	[10100003268] = "就让我来亲自处决你们吧。",
	[10100003269] = "搞了半天原来是村子里混进了内奸。",
	[10100003270] = "身边人不可靠，真是随时都有粉身碎骨之险。",
	[10100003271] = "好在被我们发现了，村民们以后就不用担心了。",
	[10100003272] = "就是可怜了那些被抓走的人。",
	[10100003273] = "哇哇哇……救命！",
	[10100003274] = "有小孩的哭声？",
	[10100003275] = "三人循声走到一处洞穴，看见村里的小孩被绑在洞穴旁。",
	[10100003276] = "别、别吃我！",
	[10100003277] = "难道是昨晚被抓走的小鬼？",
	[10100003278] = "放心，我们是来救你的。",
	[10100003279] = "走吧，跟我们一起回村！",
	[10100003280] = "山兽",
	[10100003281] = "愉快的村民",
	[10100003282] = "稳重的村民",
	[10100003283] = "村民",
	[10100003284] = "那是什么？",
	[10100003285] = "应该是有人给我们发了灵言信，我看看。",
	[10100003286] = "小亮，上面写的什么？",
	[10100003287] = "是一封求助信，从罗刹街外一处非常偏远的地方寄来的。",
	[10100003288] = "要过去的话得穿过恶灵遍布的地区，而且，说不定是个陷阱。",
	[10100003289] = "哥哥，我们要去吗？",
	[10100003290] = "只要是罗刹街的事，就归我管。",
	[10100003291] = "管它是不是陷阱，先去看了再说。我不信在这里有人能与我火将军作对。",
	[10100003292] = "这家伙的作风还是一如既往啊。",
	[10100003293] = "事不宜迟，既然已经决定了，我们就快点去看看吧。",
	[10100003294] = "吼吼吼……",
	[10100003295] = "灵云巷的恶灵涌上来，把三人团团包围。",
	[10100003296] = "就凭你们？一群杂碎。",
	[10100003297] = "咳咳，数量也太多了。",
	[10100003298] = "这里也有！",
	[10100003299] = "这边的敌人怎么这么多。",
	[10100003300] = "是呀，虽然不是什么难对付的角色，但处理起来也要花点时间。",
	[10100003301] = "这些低等恶灵反应很迟钝，只要绕开他们的视线穿过去就好了。",
	[10100003302] = "好！一口气冲过去吧！",
	[10100003303] = "这是？",
	[10100003304] = "聚灵石像，灵域的人建造的。把手放上去吧，它会赠与冒险者一些增益效果。",
	[10100003305] = "等等，我们现在在什么位置了？",
	[10100003306] = "我们迷路了？",
	[10100003307] = "看样子是的……这段路错综复杂，我们怕是已经迷失方向了。",
	[10100003308] = "啊……对了，刚才战斗时，罗盘也被打碎了。",
	[10100003309] = "别担心，好消息是附近似乎很平静，我们再往前探一探，应该已经不远了。",
	[10100003310] = "别担心，我们再往前探一探，应该已经不远了。",
	[10100003311] = "应该就是这附近了。",
	[10100003312] = "那里好像有人？",
	[10100003313] = "是个幽灵，我们去问问她什么情况吧。",
	[10100003314] = "老婆婆，请问附近出事了吗？这封灵言信是谁寄来的，你可听说过？",
	[10100003315] = "咳咳……啊？听不清你说什么，来、来。",
	[10100003316] = "老婆婆向夏铃招手。",
	[10100003317] = "夏铃走上前去，在老婆婆耳边大声重复了一遍。",
	[10100003318] = "哦！这附近吗？确实出事了，有一只可怕的恶灵到处吃人。",
	[10100003319] = "什么？！那恶灵现在在哪里？你知道吗？",
	[10100003320] = "当然啦，就在你面前呀。",
	[10100003321] = "老婆婆的手在一瞬间变成利爪，朝着夏铃袭来。",
	[10100003322] = "当心！她已经恶灵化了！",
	[10100003323] = "差点中计了……那婆婆怕是恶灵幻化而成，目的是用无害的外表欺骗过路人吧。",
	[10100003324] = "可这张灵言信的主人到底是？",
	[10100003325] = "你们是……冒险者？",
	[10100003326] = "一个细细的声音从隐蔽处传来。",
	[10100003327] = "有个幽灵在那边。",
	[10100003328] = "从阴影中走出一个幽灵少女。",
	[10100003329] = "那封信是我发的，本来不报什么希望了，没想到你们竟然真的来了。",
	[10100003330] = "附近还有其他的恶灵吗？",
	[10100003331] = "只有那一只变成婆婆的样子四处吃人的幽灵，别的没有了。",
	[10100003332] = "利用人的同情心作害，真是太可恶了。",
	[10100003333] = "正是因为恶灵是最懂群英的，才做得出这样的事情，毕竟，它们也曾是群英。",
	[10100003334] = "不过好在寄信人平安无事，算是解决了一个祸端。我们回去吧？",
	[10100003335] = "幽灵少女",
	[10100003336] = "曹玄亮专注地查阅地图，并没有察觉，在他背后阴暗的巷道里，一只佯装倒地的恶灵正悄悄靠近。",
	[10100003337] = "吼吼吼……",
	[10100003338] = "当心！",
	[10100003339] = "眼看恶灵的利齿快碰到曹玄亮，夏铃焦急不已。",
	[10100003340] = "她向恶灵方向跑去，伸出手想推开恶灵。",
	[10100003341] = "但还未触碰到对方，一股力量便从夏铃手掌中冲出，恶灵随之倒地。",
	[10100003342] = "这是？",
	[10100003343] = "在短暂的十分之一秒的一瞬间，曹焱兵反应了过来。",
	[10100003344] = "退后！",
	[10100003345] = "你们现在这边休息一下等会跟上来，我先去看看有没有危险。",
	[10100003346] = "等会跟你讲讲关于法力的事情。",
	[10100003347] = "也许冥界受到各种力量的影响，加上情况紧急，焕发了出你内心的力量，也许连你自己都无法察觉。",
	[10100003348] = "简而言之，你的法力已经被唤醒了，只是你还不知道该如何使用它。",
	[10100003349] = "等等，你们听——附近还有恶灵咆哮的声音。我们换个安全的地方说话吧。",
	[10100003350] = "你可以照先前借给你的那本书上介绍的呼吸法，试着控制你的法力。",
	[10100003351] = "书上？那本漫画书？真的不是在耍我吗？",
	[10100003352] = "算了，就先试试。\n怎么说的来着，我想想……“闭上眼睛，将气聚拢丹田”……",
	[10100003353] = "夏铃闭上眼睛，周身的灵气随着呼吸显现，在她周围徐徐燃烧。",
	[10100003354] = "厉害，竟然这么快就掌握了！\n趁法力燃烧旺盛，将它们全都聚拢到颅顶。",
	[10100003355] = "比我想象中还要顺利嘛。",
	[10100003356] = "这衣服！我的衣服怎么变了！",
	[10100003357] = "这是灵衣，可以保护寄灵人的躯体免受伤害，当然只是一定程度上。总而言之，有了灵衣，你就正式成为寄灵人了。",
	[10100003358] = "既然已经可以使用法力，就趁热打铁，准备召唤你的守护灵。",
	[10100003359] = "这家伙只是低等恶灵，法力却如此强盛！莫不是吃了灵草？",
	[10100003360] = "如果是那样，灵辅助恐怕已经被他杀害了……",
	[10100003361] = "可恶，不能饶恕！",
	[10100003362] = "让我也加入战斗吧，这样残暴的事情……绝对不能再发生了！",
	[10100003363] = "这就是……使用法力的感觉……",
	[10100003364] = "还不错，记住这种感觉，等会需要你靠这种感觉汇聚法力。",
	[10100003365] = "到底该去哪找曹炎兵啊……",
	[10100003366] = "记得应该是这条路。",
	[10100003367] = "为什么会有机械人追我啊！",
	[10100003368] = "小心绕开巡逻范围，应该没问题。",
	[10100003369] = "一口气冲过去！",
	[10100003370] = "走吧，我能做到的。",
	[10100003371] = "谨慎前进",
	[10100003372] = "出发！",
	[10100003373] = "让你们办的事情怎么样？",
	[10100003374] = "一切谨遵大人的吩咐，四处袭击罗刹街，制造混乱。",
	[10100003375] = "做得好，一定要让曹焱兵应接不暇，我才有机会接近灵槐树，夺得树中神珠！",
	[10100003376] = "另一方面。",
	[10100003377] = "最近罗刹街的求助信越来越多，许多幽灵来信，说自己的街区遇到奇怪生物的袭击。这到底是怎么回事？",
	[10100003378] = "根据我的调查，最近王国组织开始暗中行动，或许这些暴乱，与他们的布局不无关系。",
	[10100003379] = "他们的目的是什么？",
	[10100003380] = "呵呵，冥界一切纷争，无非就是想要得到这天下，邪恶的塔塔鲁斯王国也不例外。",
	[10100003381] = "想要夺下罗刹街，得经过我的同意。",
	[10100003382] = "我们加紧巡查，不管是塔塔鲁斯，还是什么牛鬼蛇神，统统都别想再罗刹街作乱。",
	[10100003383] = "是！",
	[10100003384] = "吼吼……吼……",
	[10100003385] = "你、你别过来！",
	[10100003386] = "郊外密林，两个孩子被恶灵拦住，眼看就要被恶灵抓住。",
	[10100003387] = "喂，大个子，欺负小孩可不行啊！",
	[10100003388] = "！",
	[10100003389] = "身着灵衣的曹焱兵、夏铃二人从天而降，挡在孩子们前面。",
	[10100003390] = "胆敢阻拦……不可饶恕……",
	[10100003391] = "轰轰轰——！",
	[10100003392] = "只见曹焱兵发出阎王炮，放出火焰将恶灵延烧殆尽。",
	[10100003393] = "呵，自从离开罗刹街寻找神珠以来，好久没战斗过了，真让人舒坦。",
	[10100003394] = "好、好厉害！难道你们也是冒险者？",
	[10100003395] = "我是罗刹街冒险者，你们没事吧？",
	[10100003396] = "谢谢大哥哥，我们没事。",
	[10100003397] = "看样子附近常有恶灵出没，你们住在哪里？我们送你回去吧。",
	[10100003398] = "那太谢谢你们了！我住在明镜村，一个有点隐蔽的村子。我带你们过去吧，大家见到你们一定会很高兴的。",
	[10100003399] = "曹焱兵一行人跟着白水儿走进密林深处，穿过一只石碑来到明镜村。",
	[10100003400] = "哇，这棵树好美，这就是明镜村吗？简直就像一个世外桃源呢。",
	[10100003401] = "这棵菩提树一直保佑着我们村子——啊，门大人来了。",
	[10100003402] = "水儿！你们去哪了？大家都在担心你们。",
	[10100003403] = "刚刚我和狗儿出去玩，遇上了恶灵，好在遇到这几位哥哥姐姐，我们才得救。",
	[10100003404] = "消耗自己的法力，去救两个素味平生的幽灵？哈哈哈，小子，我欣赏你！你是？",
	[10100003405] = "我不能眼睁睁看着他们被杀。\n我是罗刹街冒险者——曹焱兵。",
	[10100003406] = "罗刹街？曹焱兵？",
	[10100003407] = "…………",
	[10100003408] = "没什么事的话，请你快离开这里吧。",
	[10100003409] = "什么情况？",
	[10100003410] = "我已接到灵域通知，罗刹街冒险者曹焱兵破坏神树逃亡在外，若是遇见，即刻逮捕。",
	[10100003411] = "你救了水儿他们，这一次我就当没看见你，下次再见我可就要亲手捉拿你了。",
	[10100003412] = "怎么会这样……哥哥姐姐都是好人啊。",
	[10100003413] = "逃犯吗……我明白了。\n我们走。",
	[10100003414] = "离开了明镜村，曹焱兵一行人继续向东。行至一处，夏铃发现有些异常。",
	[10100003415] = "感觉远处有什么声音？",
	[10100003416] = "有人来了！大家保持戒备！",
	[10100003417] = "哈哈哈哈，看看这是谁。",
	[10100003418] = "羽林街司令南御夫率领一队精锐士兵，从此地路过。",
	[10100003419] = "这不是逃犯曹焱兵吗？给我把他拿下！",
	[10100003420] = "全是灵域的部下，怎么办？",
	[10100003421] = "突破出去！谁都别想拦住我。",
	[10100003422] = "呼，终于逃出来了。这个叫南御夫的，到底是什么人？能调动这么多部队。",
	[10100003423] = "我听说羽林街的司令是北落师门，后来北落师门主动卸任，隐居在村子里当冒险者，这个南御夫应该是他亲自选拔出来的继任者。",
	[10100003424] = "不论怎么说，总算是逃出来了。",
	[10100003425] = "想逃出我的掌心，没那么容易！",
	[10100003426] = "是南御夫！他追上来了！怎么办？",
	[10100003427] = "南御夫从天而降，后面站着他的三个得力部下。",
	[10100003428] = "一时间气氛凝聚至冰点，曹焱兵握紧十殿阎罗，凝神屏气，准备迎接对方的攻击。",
	[10100003429] = "慢着！",
	[10100003430] = "一束金光闪烁，一个人落在南御夫和曹焱兵之间。来人正是羽林街前任司令——北落师门。",
	[10100003431] = "北落……门司令？你来做什么？",
	[10100003432] = "在我的地盘上可不准随便乱来啊。",
	[10100003433] = "这是西区逃犯曹焱兵，我要将他捉拿归案。",
	[10100003434] = "曹焱兵的事，我会用我一贯的方式解决。",
	[10100003435] = "曹当家的，我们来打一场，你赢了便放你走，输了我就将你交给羽林街。",
	[10100003436] = "我不趁人之危，你今日损失大量法力，咱们明日7点在这里见面。",
	[10100003437] = "一局定胜负！",
	[10100003438] = "曹焱兵离开了和北落师门决斗之地。",
	[10100003439] = "那小子真是个不错的人才，如果他不是逃犯，也许还能成为朋友。",
	[10100003440] = "可惜了。",
	[10100003441] = "门大人……救救我们……",
	[10100003442] = "明镜村一名叫阿贵的村民满身重伤，跌跌撞撞地跑过来。",
	[10100003443] = "阿贵！你怎么从村子里跑出来了？这伤又是怎么回事？",
	[10100003444] = "一群手持兵器的人冲进来，见人就杀！好多相亲都……明镜村现在已经成了一片火海了……",
	[10100003445] = "苍天啊……别开玩笑了……",
	[10100003446] = "几里外，火光映红了明镜村，羽林街司令南御夫身着紫袍看着这一切。",
	[10100003447] = "呵呵，玩笑，就是要开大一点才有趣。",
	[10100003448] = "曹焱兵离开明镜村的路上。",
	[10100003449] = "你们看，前面是不是有个人倒在地上？",
	[10100003450] = "是水儿！",
	[10100003451] = "她全身都是伤，到底发生什么事了？李轩辕，快帮她治疗。",
	[10100003452] = "不用管我……救救爸爸……救救门大人……",
	[10100003453] = "爸爸？",
	[10100003454] = "南御夫为了夺取……菩提神珠，趁爸爸不在，带人火烧明镜村……",
	[10100003455] = "爸爸为了救我，自愿戴上锁灵石，如今使不出力量，如果不快点，他就要被……",
	[10100003456] = "我知道了。北落师门的事，交给我吧。",
	[10100003457] = "如果水儿撑不到他回来的时候，请告诉他，我一点也不恨他……",
	[10100003458] = "小家伙，重要的话，还是亲口说比较好。",
	[10100003459] = "水儿，你一定要坚持到我们带他回来的时候啊。",
	[10100003460] = "这就是，羽林街了？",
	[10100003461] = "北落师门一定被关在这条街最深处的大殿内。",
	[10100003462] = "守卫羽林街的灵甲军涌出来，挡在曹焱兵面前。",
	[10100003463] = "即便我不是什么正派人士，也要和你们划清界限。",
	[10100003464] = "只是，前面的杂草太多，多到我找不到大路。我……该怎么做？",
	[10100003465] = "主公，论道褚不会，褚只会杀人！",
	[10100003466] = "只要主公一句话，我等踏平罗刹街！",
	[10100003467] = "很好。许褚典韦听命！",
	[10100003468] = "末将在！",
	[10100003469] = "让我见识下，曹家的虎贲双雄，如何以一当千！",
	[10100003470] = "为主公开路！",
	[10100003471] = "哥哥，这条街人迹罕至，平时极少有人到访，不如就从这里开始吧。",
	[10100003472] = "罗刹街有不少远古暗道，还有一些封印的妖灵，你自己当心。",
	[10100003473] = "知道了！",
	[10100003474] = "管它什么路，先走到底再说！不论是谁都休想阻挡！",
	[10100003475] = "焱兵你看，地上有一些脚印。",
	[10100003476] = "这是……犬类的脚印？",
	[10100003477] = "看来有个大家伙在等着我们。走，去看看。",
	[10100003478] = "小子，来得挺早啊。",
	[10100003479] = "早点结束，早点赶路。",
	[10100003480] = "好嚣张的口气，只怕是走不了了吧。",
	[10100003481] = "来！石灵明！\n手持镔铁盘龙棍，与我一起会会火将军。",
	[10100003482] = "是！",
	[10100003483] = "从你那棍子涌出的地狱之火源源不绝，连我这石龙都无法穿破。",
	[10100003484] = "更令我吃惊的是，你的体内还有一股力量，并没有使出来。",
	[10100003485] = "你们走吧，我输了。\n我会履行承诺，灵甲军的事就由我来搞定。",
	[10100003486] = "后会有期。",
	[10100003487] = "我想以后不会再见面了，好自为之吧！",
	[10100003488] = "主人，你受伤了？脸色这么难看？",
	[10100003489] = "我想起昨天刚救下水儿的时候，明镜村漂亮极了。",
	[10100003490] = "一夜之间一切都被烧毁了，真让人难过啊。",
	[10100003491] = "曾经我也亲眼目睹亲如妹妹的人在自己面前被恶灵吞噬掉。",
	[10100003492] = "从那天起我立下重誓，只要碰上残害幼小之徒，定要将其碎尸万段！",
	[10100003493] = "阿贵",
	[10100003494] = "许褚&典韦",
	[10100003495] = "夏玲姐姐我可不会放水哦。",
	[10100003496] = "让我来助你一臂之力吧！",
	[10100003497] = "属于我的力量，正在觉醒！",
	[10100003498] = "轮到我上场了吗？我不会让你失望的！",
	[10100003499] = "曹焱兵从十殿阎罗的中复生。",
	[10100003500] = "项昆仑，你没有彻底杀死我，是你犯下最大的错误。",
	[10100003501] = "曹当家的！当心！项昆仑已经离开，但他的守护灵虞子期正守在路口。他在等着你！",
	[10100003502] = "怎么，你怕了？",
	[10100003503] = "小子，这种时候了还这么嘴硬。",
	[10100003504] = "南御夫呢？还没找他算账呢。",
	[10100003505] = "他知道你复活，慌张逃跑了，恐怕是去寻找玄黄丹去了。",
	[10100003506] = "我们得在他拿到玄黄丹之前找到他，若是让他吞下玄黄丹，变成嗜日巨兽，恐怕局面就难以控制了。",
	[10100003507] = "主公命我清理祸乱羽林街之人，曹焱兵，你可知罪？",
	[10100003508] = "这是非颠倒的地狱，谁才有罪，由我来决定！",
	[10100003509] = "道路被封锁住了！看来解不开机关无法通过了。",
	[10100003510] = "别慌，这叫“四方戒备”，我知道它的的解法。",
	[10100003511] = "正中间的机关藏着解锁整个机关的提示，只要拿到提示，解开机关就很容易了。",
	[10100003512] = "提示就藏在正中间的机关里？我去看看！",
	[10100003513] = "机关一动不动。\n（请先查看机关顺序，按提示顺序解锁）",
	[10100003514] = "焱兵，终于找到你们了！",
	[10100003515] = "夏铃？！你们怎么来了。",
	[10100003516] = "白水儿呢？",
	[10100003517] = "我和李轩辕把她安置在安全的地方，不用担心。",
	[10100003518] = "你们都在拼命战斗，这种时候我怎么能躲在后面什么也不做呢。",
	[10100003519] = "多一个人多一份力量，一起前进吧！",
	[10100003520] = "一起前进吧！",
	[10100003521] = "这段路好复杂。",
	[10100003522] = "这段路叫“鬼打墙”，实际上是一种幻觉。",
	[10100003523] = "如果不慎触碰到路上的敌人，便会返回到最初的地点。",
	[10100003524] = "不少人进去后在里面来回穿梭，找不到出去的路。曹当家，你可要当心，千万别碰到羽林兵。",
	[10100003525] = "我们是出来了吗？",
	[10100003526] = "路面和刚才好像十分相似，却又好像不一样了。",
	[10100003527] = "我们已经走出来了。",
	[10100003528] = "很好，我感觉南御夫就在不远处了，继续前进。",
	[10100003529] = "这是……当心！有孙尚香埋伏！",
	[10100003530] = "注意躲开他们的攻击范围！",
	[10100003531] = "找到了！南御夫在那里！",
	[10100003532] = "没想到曹焱兵还能活过来，你可真难缠啊。",
	[10100003533] = "不过已经太迟了。我已吞下了玄黄丹，噬日巨兽即将复活！",
	[10100003534] = "南御夫用符咒在召唤着什么，然后就通过传送门逃走了，他不会就这样跑了吧。",
	[10100003535] = "不，噬日巨兽已经苏醒，我不得不去面对它。",
	[10100003536] = "此事是我和他的私人恩怨。很感谢你们帮我到这里，接下来，就让我一个人应对吧。",
	[10100003537] = "这种时候还逞能。告诉你，我可不止为你，就算是为了自己，也要杀了这家伙！",
	[10100003538] = "这种忘恩负义，口慈心狠的人，为了私欲屠杀整个村子的人，人人得而诛之！",
	[10100003539] = "虞子期",
	[10100003540] = "南御夫",
	[10100003541] = "战斗·机制其三",
	[10100003542] = "主动被动技能配合使用，可发挥最大效能！",
	[10100003543] = "圣兽和自动切换功能已开启！\n一起大战一场吧！",
	[10100003544] = "呵呵，曹焱兵，好久不见。",
	[10100003545] = "鬼符三通！你来做什么？",
	[10100003546] = "接到灵域的探案任务，这个过一会再提。倒是你，这么久不见，要不要与我切磋一番，看看你有没有长进？",
	[10100003547] = "倒是你，这么久不见，要不要与我切磋一番，看看你有没有长进？",
	[10100003548] = "来吧！我可从来不会退缩。",
	[10100003549] = "迷雾森林",
	[10100003550] = "迷雾小径",
	[10100003551] = "雪神山顶",
	[10100003552] = "柳絮小径",
	[10100003553] = "寒冰溪水",
	[10100003554] = "森林深处",
	[10100003555] = "盲目之森",
	[10100003556] = "化龙巷",
	[10100003557] = "山脚下",
	[10100003558] = "隐世村庄",
	[10100003559] = "村庄小径",
	[10100003560] = "塌方之路",
	[10100003561] = "密林深处",
	[10100003562] = "流云山谷",
	[10100003563] = "山谷村庄",
	[10100003564] = "流云山谷",
	[10100003565] = "山谷村庄",
	[10100003566] = "流云山顶",
	[10100003567] = "迷雾路口",
	[10100003568] = "十字街",
	[10100003569] = "十字中街",
	[10100003570] = "十字后街",
	[10100003571] = "交界之地",
	[10100003572] = "化龙巷前",
	[10100003573] = "曹焱兵折返回原来的地方。",
	[10100003574] = "那家伙究竟是……",
	[10100003575] = "可惜那幽灵已经离开了，这封信先留着吧。希望以后能再遇到他。",
	[10100003576] = "短短几分钟，夏铃已经学会了控制看似毫无规则的力量。",
	[10100003577] = "自不量力的家伙。",
	[10100003578] = "获得【旅行者的草鱼】",
	[10100003579] = "完成旅途%d-%d",
	[10100003580] = "神秘山谷",
	[10100003581] = "崎岖山道",
	[10100003582] = "青松山腰",
	[10100003583] = "青松山腰",
	[10100003584] = "茅草屋旁",
	[10100003585] = "荆棘山谷",
	[10100003586] = "喂，那边的冒险者，需要算一卦吗？只要50块哦。",
	[10100003587] = "这台词怎么这么熟悉？",
	[10100003588] = "不必了！我的命，我自己决定就好。",
	[10100003589] = "可我见你印堂发红，身上隐藏着旁人难以企及的天赋。难道不想知道你的未来什么样吗？",
	[10100003590] = "你这家伙……看人还蛮准的。\n那就，帮我算一卦吧，给，50块。",
	[10100003591] = "你这家伙，真是的。",
	[10100003592] = "预言师",
	[10100003593] = "让我看看……年轻人，你卦象不错，似有天助。\n但未来几天内会经历三个劫，“烧伤”、“遗失”和“分离”。",
	[10100003594] = "真的假的，这么严重？那要怎么办？",
	[10100003595] = "当然，有方法避免的。不过，这是另外的价格。\n只需要1000元，我就将消灾之法全部告诉你们。",
	[10100003596] = "你这家伙抢劫吗……\n我们还是走吧！",
	[10100003597] = "可恶，一想到刚刚白白浪费了50块，就一肚子气。我得送好几趟外卖才能赚回来。",
	[10100003598] = "哈哈哈，谁叫你经受不住人家的奉承。",
	[10100003599] = "吼吼吼！！！",
	[10100003600] = "什么声音……附近有恶灵？",
	[10100003601] = "走，去看看！",
	[10100003602] = "找到了！看！有幽灵被劫持了！",
	[10100003603] = "吼——！！！",
	[10100003604] = "焱兵，你的手？！",
	[10100003605] = "可恶，虽然我是火属性寄灵人，可刚才的恶灵释放的火似乎经过特殊法力练就，此火不仅不发热，反而寒入骨髓。",
	[10100003606] = "幸好及时扑灭，没有烧伤太严重。",
	[10100003607] = "“烧伤”……",
	[10100003608] = "啊，这不是预言中第一个劫吗。",
	[10100003609] = "也许只是凑巧，不过如果是真的，那么接下来的“遗失”和“分离”也会发生。",
	[10100003610] = "难道我们会分道扬镳？还是……两人之间有一个会挂掉？不不不，我在想什么？不能想这样晦气的事情！",
	[10100003611] = "如果预言是真的，的确有发生的可能。不论如何，小心为上。",
	[10100003612] = "喂，你确定往这边走吗？怎么没路了？",
	[10100003613] = "奇怪，地图上写的是往这边走啊。",
	[10100003614] = "等等，我们这是迷路了？",
	[10100003615] = "不远处传来一阵惨叫声。",
	[10100003616] = "啊啊啊……别杀我！",
	[10100003617] = "有恶灵？喂，大家伙！别想害人！",
	[10100003618] = "谢谢你们的救命之恩！",
	[10100003619] = "顺手的事。倒是你怎么离开幽灵聚居的村子，到这么偏远的地方来了？",
	[10100003620] = "我的孩子得了重病，村子里的人说会传染，就把我们赶了出来，我们父子二人只好在这荒无人烟的地方盖个草房子住下了。",
	[10100003621] = "真可怜……你孩子得的什么病？带我去看看吧，我会一点治疗术，或许能帮到你。",
	[10100003622] = "真、真的吗？！你是大夫？？？那真是太感谢了！前面的茅草屋就是我家，我这就带你去。",
	[10100003623] = "就是不远处山脚下的草房子吗？很近嘛。\n焱兵，我去他家看看就回来。",
	[10100003624] = "那我在这研究下地图吧，可恶，这地图好多记号都看不清了。",
	[10100003625] = "我知道了，地图上写着，所以我们刚才才走错了路，应该走这边才对。",
	[10100003626] = "奇怪，夏铃那家伙怎么去了这么久，早知道就不分开，和她一起去了。",
	[10100003627] = "分开……“分离”？预言中提到的一个劫。",
	[10100003628] = "怎么感觉有种不好的预感……我得赶紧去看看。",
	[10100003629] = "曹焱兵赶往茅草屋，却见里面空无一人。",
	[10100003630] = "糟了，是陷阱！",
	[10100003631] = "不过，地面似留下了一些法力记号……这是夏铃留下的！我得快点跟着记号去找他们！",
	[10100003632] = "跟着法力走到这里来了。\n这鬼地方还真是让人生气——咦，夏铃，你没事吧！",
	[10100003633] = "我被锁灵石锁住了，这叫没事吗？",
	[10100003634] = "吼吼吼！！！可恶，既然你也来了，那就一起受死吧！",
	[10100003635] = "啊，追过来了！没办法，我还是先溜吧。",
	[10100003636] = "伪装成弱者将路人骗去喂食恶灵吗？决不能饶恕！",
	[10100003637] = "打败恶灵后，曹焱兵帮助夏铃解开锁灵石。",
	[10100003638] = "那夜巡小卒在你战斗的时候逃跑了。",
	[10100003639] = "我知道，不过那恶灵有点难对付，我也无暇顾及他了。",
	[10100003640] = "我的钱袋也被那家伙偷走了，真可恶！",
	[10100003641] = "钱袋被偷，算“遗失”吧？",
	[10100003642] = "你说那则预言吗？",
	[10100003643] = "没错，预言已经发生了两个，不过最后一个和预言中不同了。",
	[10100003644] = "看来，命运在不知不觉之间发生改变了呢！",
	[10100003645] = "夜巡小卒",
	[10100003646] = "焱兵！救救我！",
	[10100003647] = "牧村村口",
	[10100003648] = "松柏之森",
	[10100003649] = "森林深处",
	[10100003650] = "无人密道",
	[10100003651] = "密道尽头",
	[10100003652] = "松柏之森",
	[10100003653] = "就是这孩子吗？",
	[10100003654] = "没错，麻烦你跑这么远来送他。这孩子父母兄弟都变成恶灵了，好在还有个在白河村的舅舅，这就想托人带他去舅舅家。",
	[10100003655] = "可是，最近恶灵出没频繁，幸好冒险者大人愿意帮忙护送他过去。阿良，快说谢谢大人。",
	[10100003656] = "……",
	[10100003657] = "阿良自顾自地跑开了。",
	[10100003658] = "这孩子真没礼貌……\n不过，想来是近日接连失去亲人的缘故，大人不要见怪。",
	[10100003659] = "小孩子嘛。焱兵，现在我们就带孩子出发吧，趁天色还早。",
	[10100003660] = "嗯，我们先下山吧。",
	[10100003661] = "孩子的舅舅住在白河村，麻烦你护送他过去。",
	[10100003662] = "……",
	[10100003663] = "吼吼吼！！！",
	[10100003664] = "小心！恶灵来了！",
	[10100003665] = "有惊无险，只是个低等恶灵。",
	[10100003666] = "那孩子去哪里了？",
	[10100003667] = "咦，怎么不见了？难道是刚刚看见恶灵吓跑了？",
	[10100003668] = "去附近找找吧，应该没有跑远。",
	[10100003669] = "你看，这边有一些脚印，应该有人刚刚从这里过去。",
	[10100003670] = "是个暗道吗？我先打开机关进去看看。",
	[10100003671] = "（低吼）。",
	[10100003672] = "有恶灵？\n不对，这家伙被人拴起来了，似乎只能在这里活动。什么人会把恶灵养起来呢。",
	[10100003673] = "是很蹊跷。\n再往前面探探。",
	[10100003674] = "恶灵发出低吼。",
	[10100003675] = "越来越荒凉了，这里不像是有人来的样子。",
	[10100003676] = "吼吼吼！！！",
	[10100003677] = "有敌人！",
	[10100003678] = "恶灵被击败后，从草丛后面传来一阵响亮的开锁声。",
	[10100003679] = "什么声音！",
	[10100003680] = "回头一看，只见阿良正拖着被拴起来的恶灵，正朝外面跑去。",
	[10100003681] = "是那孩子！他要带恶灵去哪里？我们快跟上去！",
	[10100003682] = "杀了他们！",
	[10100003683] = "吼吼吼——！",
	[10100003684] = "当心！",
	[10100003685] = "小子，竟敢指使恶灵攻击我。可惜，你找错人了！",
	[10100003686] = "曹焱兵举起十殿阎罗，准备给恶灵最后一击。",
	[10100003687] = "住手！",
	[10100003688] = "阿良突然扑过来，挡在恶灵身前。",
	[10100003689] = "不要伤害他，他是……我的姐姐……",
	[10100003690] = "这是怎么回事？",
	[10100003691] = "阿良向曹焱兵和夏铃讲出了事情的原委。",
	[10100003692] = "原来你家人都变成恶灵被驱逐出村子了？",
	[10100003693] = "是的，当时我哥哥和姐姐还保留着清醒的意识，村子里的人竟然就将他们二人赶了出去。",
	[10100003694] = "所以你把他们留在暗道里，随时出来照顾他们？",
	[10100003695] = "愚蠢。刚变成恶灵时，幽灵的确会保留一部分正常意识。但随着怨念的恶化，它们现在已经是只知道吃人的恶灵了。",
	[10100003696] = "对于没有法力的普通幽灵来说，离恶灵这么近是很危险的！",
	[10100003697] = "但是……",
	[10100003698] = "失去亲人的痛苦我能理解，但别忘了，世界上还有担心你的人。以后别再做这样的事了。",
	[10100003699] = "和你姐姐道别吧。\n至于你指使恶灵一事，我这次就当没看见，好好去你舅舅家反省吧。",
	[10100003700] = "曹焱兵举起十殿阎罗。",
	[10100003701] = "呜呜呜……对不起，哥哥、姐姐……我还是不能保护大家。",
	[10100003702] = "我会在舅舅家附近为你们立碑，若有朝一日你们的魂魄能回来，就来石碑处找我，我们约好了！",
	[10100003703] = "对不起，哥哥、姐姐……",
	[10100003704] = "村长",
	[10100003705] = "阿良",
	[10100003706] = "今天从村子里搜刮到不少东西，回去老大一定很高兴。",
	[10100003707] = "恐怕你们今天是回不去了。",
	[10100003708] = "什么人！？",
	[10100003709] = "吾乃罗刹街冒险者，曹焱兵是也！",
	[10100003710] = "恶灵被尽数消灭。",
	[10100003711] = "焱兵你看，前面有好多东西散落在地上。",
	[10100003712] = "那应该是这些恶灵从其他地方抢来的物资，恐怕走得匆忙没来得及带走。",
	[10100003713] = "走，我们去看看有些什么。",
	[10100003714] = "冒险者大人，请帮帮我！",
	[10100003715] = "什么？谁在说话？",
	[10100003716] = "找出声音来源。",
	[10100003717] = "喂，当心，你踩到我啦！",
	[10100003718] = "咦！这是……幽灵的碎片？居然会讲话。",
	[10100003719] = "我是住在明槐街的幽灵。",
	[10100003720] = "今天我正在路上走路，一群恶灵冲过来，一把就把我丢进袋子里。",
	[10100003721] = "我趁他们不注意，悄悄把魂魄分成两半，这才得以从布袋里逃出一部分。",
	[10100003722] = "剩下的一半应该还在他们手里，要两半合二为一，我才能再次成形，大人能帮我找回来吗？",
	[10100003723] = "你知道他们往哪去了？",
	[10100003724] = "知道知道！我来为你指路！",
	[10100003725] = "这就是这些家伙的赃物吧？居然抢了这么多东西。",
	[10100003726] = "恶灵们的营地就在前面了。",
	[10100003727] = "前面是什么人？",
	[10100003728] = "罗刹街曹焱兵都不认得？今天就让你们认识认识。",
	[10100003729] = "里面就是他们驻扎的地方了吧？",
	[10100003730] = "我能感应到我的另一半魂魄，一定就在里面。",
	[10100003731] = "走，我们闯进去。",
	[10100003732] = "咦，怎么有人闯进来了？门口的守卫呢？",
	[10100003733] = "已经被我解决掉了。",
	[10100003734] = "唔……！什么！来人，把他们统统抓起来！",
	[10100003735] = "这里堆放了不少物资，但却看见你说的装魂魄的袋子。",
	[10100003736] = "唔，我也感应不到我的另一半魂魄。\n不过，总觉得很近了。",
	[10100003737] = "幽灵对自己的魂魄感应很灵敏，她的感觉应该不会有错。",
	[10100003738] = "我们去前面搜寻一番吧。",
	[10100003739] = "那是……我的魂魄！可恶，竟然就这样随随便便扔在地上。",
	[10100003740] = "我去看看。",
	[10100003741] = "曹焱兵拾起碎片。",
	[10100003742] = "的确是另一块碎片，给。",
	[10100003743] = "曹焱兵将遗落的魂魄拾起，还给幽灵。",
	[10100003744] = "虽然已是幽灵，但魂魄若是不完整，只能算是孤魂野鬼了。",
	[10100003745] = "幽灵两部分魂魄合二为一，终于现出本体。",
	[10100003746] = "太好了，这下我又能自由行动了！",
	[10100003747] = "没记错的话你家在明槐街是吧？附近恶灵出没频繁，我们先送你回去吧。",
	[10100003748] = "啊！是谁杀死了我的部下？",
	[10100003749] = "听见了吗？有人声从入口传过来了。",
	[10100003750] = "是恶灵残党？走，出去看看。",
	[10100003751] = "希望能顺利从这里出去。",
	[10100003752] = "啊啊啊啊！我的地盘就这样被你毁了，我要让你付出代价！",
	[10100003753] = "当心，这家伙散发出好强的法力，恐怕没那么容易对付。",
	[10100003754] = "啊啊啊——好痛苦！",
	[10100003755] = "恶灵高呼一声，在曹焱兵的烈火中化为灰烬。",
	[10100003756] = "一旦被怨念缠身，就会变成这样吗？真可怕。",
	[10100003757] = "只要呆在安全的地方，恶灵化的概率也会大大减小。",
	[10100003758] = "走吧，我们带你回村子，别在这怨念之地停留了。",
	[10100003759] = "秋阳道",
	[10100003760] = "秋阳道北",
	[10100003761] = "营地大门",
	[10100003762] = "营地内部",
	[10100003763] = "营地尽头",
	[10100003764] = "营地大门",
	[10100003765] = "乱葬岗",
	[10100003766] = "悬龙街",
	[10100003767] = "乱葬岗",
	[10100003768] = "荆棘小径",
	[10100003769] = "荆棘道",
	[10100003770] = "夕照岗",
	[10100003771] = "李轩辕，你的伤还好吗？",
	[10100003772] = "主人放心，我的伤势只需要再静养几天便可以恢复了。",
	[10100003773] = "曹焱兵让我们一起去悬龙街找孙斩天借治疗百病的上古神器，他倒是跑得快，一溜烟就不见了。",
	[10100003774] = "咦，他在那里——曹焱兵！你这家伙，终于追上你了。",
	[10100003775] = "这里怎么回事……好像经过了一场乱战。",
	[10100003776] = "刚才我觉得这里有点不对，所以提前来看看，没想到就看到这副情景。",
	[10100003777] = "并且，我找到这东西。你看。",
	[10100003778] = "曹焱兵将一页残章递给夏铃。",
	[10100003779] = "上面印了灵域的印章，是灵域的密件！",
	[10100003780] = "不错，这应该是御灵使发出来的。",
	[10100003781] = "密件被撕毁，信息不完整，不过，看这只言词组，仿佛在说冒险者死后不可以进入灵域。",
	[10100003782] = "我记得你和我说过，冒险者为冥界驱除恶灵，死后就有资格进入灵域。为什么突然禁止了？",
	[10100003783] = "不知道，看得我也是摸不着头脑。",
	[10100003784] = "我打算去夕照岗找鬼符三通，他也许知道些什么。",
	[10100003785] = "那，我和李轩辕先去找孙斩天那里借灵器了。到时候就在这附近集合吧。",
	[10100003786] = "好。",
	[10100003787] = "另一方面，群英殿的吕仙宫感知到了密件被毁。",
	[10100003788] = "咒印被人破坏了。",
	[10100003789] = "怎么了？",
	[10100003790] = "刚才御灵使来带走的密件，是由我加封的咒印。一旦密件被御灵使以外的人打开，我就能知道。",
	[10100003791] = "我感觉到咒印被人破坏，一定是有人看到了他不该看到的东西。",
	[10100003792] = "若是灵域追查下来，我们恐怕脱不了干系……真麻烦。",
	[10100003793] = "李孤城，今日貂灵芸和项昆仑不在殿内，你派些人去御灵使的路线查探发生了什么。",
	[10100003794] = "是。",
	[10100003795] = "我打算去夕照岗找鬼符三通，他也许知道些什么。到时候在这附近集合吧。",
	[10100003796] = "夏铃来到悬龙街，正想进门，却听见门内有喧哗，于是站在一旁细听。",
	[10100003797] = "所以，你们要我做什么？我对你们群英殿的事情可不感兴趣。",
	[10100003798] = "事关灵域，我们查到贼子曾途径您的辖区，还请悬龙街冒险者跟我们走一趟。",
	[10100003799] = "不止是你，最近不少冒险者都会接受询问，放心，只是问几句话。",
	[10100003800] = "真是的，最近来来去去被你们询问过三回了，没完没了。",
	[10100003801] = "孙斩天跟随群英殿的人离开了。",
	[10100003802] = "这是怎么回事？孙斩天被带走了？",
	[10100003803] = "你们怎么来了？",
	[10100003804] = "朱童，斩天怎么被带走了？",
	[10100003805] = "灵域最近不知怎么的，经常传唤冒险者，搞得人心惶惶的。",
	[10100003806] = "今天稀奇，来的是群英殿的人，似乎弄丢了什么灵域机密的东西，正到处找呢。",
	[10100003807] = "你们要多加小心，这个给你。",
	[10100003808] = "朱童递给夏铃一个小瓶子。",
	[10100003809] = "我也要走了。这是我最近炼成的迷药，世道越来越乱，带在身上防身吧。",
	[10100003810] = "朱童离开了悬龙街。",
	[10100003811] = "看来，曹焱兵捡到了不得了的东西。",
	[10100003812] = "要是他被群英殿的人发现身上有密件的残页就麻烦了，说不定会被当成袭击御灵使的人……",
	[10100003813] = "没错，我们得快点回去告诉曹焱兵这件事，那东西还是早早销毁掉的好。",
	[10100003814] = "唔，这里到处都是尸体，看来御灵使的密件就是在这里失窃的。",
	[10100003815] = "也许是御灵使部下和恶灵战斗时，被人趁乱偷走的。",
	[10100003816] = "李轩辕，你看！有人在查看那些尸体。",
	[10100003817] = "虽然没有穿制服，但听他们的对话，或许就是群英殿派来的。",
	[10100003818] = "什么人！",
	[10100003819] = "糟糕，我们被发现了！",
	[10100003820] = "唔，别以为就这样结束了！",
	[10100003821] = "探子口中念念有词，周围瞬间出现大量分身。",
	[10100003822] = "这么多分身……李轩辕，我们有胜算吗？",
	[10100003823] = "主人，我的伤势恐怕难以抵挡这些群英殿精锐，还是快离开这里吧。",
	[10100003824] = "休想逃跑！",
	[10100003825] = "一时间群英殿的精锐将夏铃二人团团包围。",
	[10100003826] = "糟了！",
	[10100003827] = "休想在此作乱！",
	[10100003828] = "这时一个身影从天而降，挡在夏铃和李轩辕之前。他召出守护灵迅速击退了群英殿的包围。",
	[10100003829] = "可恶，是个高手。\n我的任务是查探情报，不是拼命，先撤了……",
	[10100003830] = "群英殿探子撤退。",
	[10100003831] = "姑娘，你们没事吧？",
	[10100003832] = "没事，多谢你出手相助！请问你是？",
	[10100003833] = "不客气！我是附近的烽火街的冒险者云石，虽然这里不是我的管辖之地，但我见不惯倚强凌弱的恶霸。",
	[10100003834] = "灵域派冒险者管理自己的街道，管其他地方不仅有性命危险，还容易会多生是非，阁下愿意出手相助，侠义心肠可见一斑。",
	[10100003835] = "嗨，这算什么。灵域为了冥域众灵才任命冒险者驱逐恶灵，不论是不是自己的地盘，我们也应守护众灵才是。",
	[10100003836] = "云叔叔！云叔叔！",
	[10100003837] = "一群小幽灵突然从草丛中跑出来，将云石抱住。",
	[10100003838] = "哎，别急，我这就送你们回去。",
	[10100003839] = "我还要护送这些小家伙回村，先告辞啦！你们二位自己多保重。",
	[10100003840] = "云石带着孩子们离开了。",
	[10100003841] = "他看上去对灵域非常崇敬，应该是个胸怀理想，心地纯良的人。",
	[10100003842] = "嗯，我妈妈也说过，小孩子喜欢的人一定不是坏人，可惜，灵域或许并没有他想得那么好。",
	[10100003843] = "密件牵涉的事很危险，我们还是别在其他人面前提起比较好。",
	[10100003844] = "我知道，所以才什么也没说。",
	[10100003845] = "总之得先离开这里吧，要是再被人看见就危险了。",
	[10100003846] = "嗯，曹焱兵既然还没来，也许还在夕照岗，我们去那儿找他吧。",
	[10100003847] = "看来鬼符三通为了隐藏踪迹，施法用植物将路隐藏住了。",
	[10100003848] = "所以我讨厌去夕照岗，这里的路跟迷宫似的。",
	[10100003849] = "总之，先从这些草丛里找找出口吧。",
	[10100003850] = "等等，主人，别再前进了！",
	[10100003851] = "山崖上一个人躺在血泊里。一旁站着的，正是群英殿的吕仙宫。",
	[10100003852] = "云石，你知道太多了。",
	[10100003853] = "你……",
	[10100003854] = "知道也就罢了，这是灵域的事情，我本来懒得管。不过，你想要妨害群英殿，就不怪我不客气的。",
	[10100003855] = "灵域根本在利用冒险者……我们……不可能进入灵域了……",
	[10100003856] = "或许是真的，不过我不在乎。",
	[10100003857] = "吕仙宫弯下腰，将云石手中的一页纸片拾起。",
	[10100003858] = "看，那是另一片残页！",
	[10100003859] = "或许那人从残页上知道了什么，所以才遭到群英殿的追杀。",
	[10100003860] = "吕仙宫离开了。",
	[10100003861] = "我们快去看看！",
	[10100003862] = "呵呵……是我被骗了……那群老家伙根本不是为了众灵，是为了他们自己……",
	[10100003863] = "云石闭上眼睛。",
	[10100003864] = "喂！你振作一点！",
	[10100003865] = "他受伤太严重，就是清风化煞也无力回天。他已经咽气了……",
	[10100003866] = "怎么会……他，化为灰烬了……",
	[10100003867] = "嗯？竟然还有人？",
	[10100003868] = "吕仙宫要我来收拾残局，没想到抓住两个漏网之鱼。",
	[10100003869] = "主人当心！那家伙很厉害。",
	[10100003870] = "就这点本事？想打倒我没那么容易。",
	[10100003871] = "可恶，凭我现在受伤的状态，恐怕战胜不了这家伙。",
	[10100003872] = "对了！俞婆婆的迷药！",
	[10100003873] = "夏铃取出俞婆婆给她的药，向对方抛洒去，李孤城一众人顿时身体麻痹，无法动弹。",
	[10100003874] = "快跑！",
	[10100003875] = "二人趁机逃离了现场。",
	[10100003876] = "云石",
	[10100003877] = "门内声音",
	[10100003878] = "群英殿探子甲",
