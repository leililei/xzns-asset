	[90030103864] = "【诅咒礼物】",
	[90030200101] = "<color=#FF5656>【负面·减益】</color>命中率大幅下降。",
	[90030200102] = "打断目标正在进行的攻击或移动行为。",
	[90030200103] = "<color=#FF5656>【负面·控制】</color>无法行动。",
	[90030200104] = "<color=#FF5656>【负面·控制】</color>无法行动。",
	[90030200105] = "<color=#32D9FF>【增益】</color>无法被敌我双方单位选中。",
	[90030200106] = "<color=#FF5656>【负面·控制】</color>无法施放主动技能和绝技。",
	[90030200107] = "<color=#FF5656>【负面·控制】</color>无法进行普通攻击。",
	[90030200108] = "【伤害类型】必定命中且不会发生暴击，无视防御、伤害减免、伤害分担、均摊和传递等效果。",
	[90030200109] = "<color=#FF5656>【负面·控制】</color>无法移动或通过技能发动位移。",
	[90030200110] = "<color=#FF5656>【负面·控制】</color>无法行动，向远离施法者的方向逃离。",
	[90030200111] = "<color=#FF5656>【负面·控制】</color>无法行动，无法被驱散，被击飞到空中。",
	[90030200112] = "无视目标当前状态，直接击败目标。",
	[90030200113] = "按照造成伤害的比例恢复生命值。",
	[90030200114] = "<color=#FF5656>【负面·控制】</color>进行攻击时，以原目标的相反阵营进行目标选择，魅惑状态下无法施放绝技。",
	[90030200115] = "<color=#FF5656>【负面·控制】</color>进行攻击时，强制以嘲讽发起者为目标，嘲讽状态下无法施放绝技。",
	[90030200116] = "<color=#FF5656>【负面·控制】</color>无法行动。",
	[90030200117] = "<color=#FF5656>【负面·控制】</color>无法施放绝技。",
	[90030200118] = "<color=#32D9FF>【增益】</color>持续期间，生命值最多下降到1点，不会战败。",
	[90030200119] = "进行<color=#5bdf99>1</color>次攻击行为（普攻或技能），造成无论单段或多段伤害，计为<color=#5bdf99>1</color>次攻击。",
	[90030200120] = "执行<color=#5bdf99>1</color>次包含攻击或施法动作的普攻、技能、绝技时，算作<color=#5bdf99>1</color>次行动。",
	[90030200201] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>25%</color>攻击力的伤害，持续<color=#5bdf99>5</color>秒。",
	[90030200202] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>1%</color>目标最大生命值的伤害，持续<color=#5bdf99>5</color>秒。",
	[90030200203] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>25%</color>攻击力的火属性伤害，持续<color=#5bdf99>5</color>秒。",
	[90030200204] = "<color=#FF5656>【负面·减益】</color>防御力降低<color=#5bdf99>30%</color>，持续<color=#5bdf99>5</color>秒。",
	[90030200205] = "<color=#FF5656>【负面·减益】</color>受治疗率降低<color=#5bdf99>50%</color>，持续<color=#5bdf99>5</color>秒。",
	[90030200206] = "<color=#FF5656>【负面·减益】</color>法力获取效率降低<color=#5bdf99>40%</color>，持续<color=#5bdf99>5</color>秒。",
	[90030200401] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>30%</color>攻击力的物理伤害。",
	[90030200801] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>30%</color>攻击力的伤害，持续<color=#5bdf99>3</color>秒。",
	[90030201601] = "<color=#FF5656>【负面·持续伤害】</color>每秒造成<color=#5bdf99>60%</color>攻击力的魔法伤害。",
	[90030201801] = "目标的队友受到伤害时，目标受到该伤害量<color=#5bdf99>10%</color>的伤害。",
	[90030201901] = "<color=#32D9FF>【增益】</color>攻击力提高<color=#5bdf99>50%</color>，持续<color=#5bdf99>10</color>秒。",
