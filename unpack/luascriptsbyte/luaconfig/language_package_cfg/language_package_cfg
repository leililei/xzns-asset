	[41040100102] = "灵脉·筑基",
	[41040100103] = "百日筑基，方为灵脉伊始。身不动曰炼精，心不动曰炼炁，意不动曰炼神。",
	[41040100202] = "灵脉·石门",
	[41040100203] = "脐中下二寸，穴如同任脉水湿之关卡，故名。",
	[41040100302] = "灵脉·曲骨",
	[41040100303] = "别名回骨。属任脉。任脉、足厥阴之会。曲骨具温补。",
	[41040100402] = "灵脉·腰俞",
	[41040100403] = "别名背鲜、髓空、腰户、腰柱、髓俞。属督脉。适对骶管裂孔。",
	[41040100502] = "灵脉·风府",
	[41040100503] = "别名本穴、鬼穴。属督脉。有枕动、静脉分支及棘间静脉丛。",
	[41040100602] = "灵脉·灵台",
	[41040100603] = "穴在神道和心俞两穴下。伏卧，于第六胸椎棘突下取之。",
	[41040100702] = "灵脉·命门",
	[41040100703] = "穴属督脉，位于腰部，腰为肾之府，且督脉起于胞中，贯脊属肾。",
	[41040100802] = "灵脉会阴",
	[41040100803] = "穴在两阴之间，为任、督、冲三脉的起点，三脉皆属阴。",
	[41040100902] = "灵脉·阳关",
	[41040100903] = "有腰背筋膜，棘上韧带及棘间韧带，约以髂脊相平之名。",
	[41040101002] = "灵脉·巨阙",
	[41040101003] = "配灵道、曲泽、间使，有理气宽中，养血安神之用。",
	[41040101102] = "灵脉·腹中",
	[41040101103] = "膻中为任脉气会穴，又称上气海，具有宽胸理气，宁心安神之功。",
	[41040101202] = "灵脉·天突",
	[41040101203] = "天指上言，突指结喉起。在结喉下宛宛中，针此能通利肺，使之爽利通畅。",
	[41040101302] = "灵脉·气海",
	[41040101303] = "为先天元气聚会，兼任与冲脉同起胞宫，足少阴之脉相并，称诸阴之海。",
	[41040101402] = "灵脉·长强",
	[41040101403] = "循环无端为长，强有健运不息之意。穴在脊柱骨的尾端，是督阳初始之处。",
	[41040101502] = "灵脉·百会",
	[41040101503] = "在帽状腱膜中。有左右颞浅动、静脉吻合网。开窍醒脑、回阳固脱。",
	[41040101602] = "灵脉·神道",
	[41040101603] = "神指心神，通路为道。脊之五椎下，适当心俞之正中，为心气之通道。",
	[41040101702] = "灵脉·紫宫",
	[41040101703] = "考任脉至此，正内合于心，心为血之主宰，穴当其处，因为紫宫。",
	[41040101802] = "灵脉·璇玑",
	[41040101803] = "旋转灵活滑利。吞咽之时，喉骨环圆转动，穴当其处。",
	[41040101902] = "灵脉·神庭",
	[41040101903] = "清头散风，镇静安神。风眩善呕，烦满，寒热头痛，喘喝，目不能视。",
	[41040102002] = "乾坤化气",
	[41040102003] = "境界真无两，聊为物外观。乾坤浮一气，今古浸双丸。",
