	[32000020006] = "南御夫意欲抓捕曹焱兵，门司令说服对方放了焱兵，条件是和焱兵进行一次决战。",
	[32000020007] = "趁着无人看守，南御夫派人进攻明镜村，将村庄变成一片火海。",
	[32000020008] = "曹焱兵闯进羽林街，一路横冲直撞，发誓要救出北落师门。",
	[32000020009] = "南御夫三员大将之一的太微实力不凡，要前往大殿，必须将他打倒。",
	[32000020010] = "北落师门质问南御夫为何做出这样残酷的事，南御夫的回答令他心寒。",
	[32000020011] = "曹焱兵救出北落师门，这时，一个身形魁梧的大将忽然出现，拦住他们的去路。",
	[32000020012] = "南御夫自知不是北落的对手，偷偷服下玄黄丹，解开了封印在他身体中的噬日之怪兽。",
	[32000020013] = "众人返回明镜村，白水儿只剩最后一口气，在水月交映的光辉中，北落师门和她做了最后的告别。",
