	[90027310101] = "冥界同人界一样有着许多城市和街道，「罗剎街」也是其中之一，曹家世代冒险者在此镇守着四灵树之一的「灵槐树」。",
	[90027310201] = "月夜下的罗剎街。据说冥界中每次月夜都会有大量的恶灵作乱，但受曹家冒险者的庇护，此处成了冥界少有的比较安稳的区域，也许今晚曹家兄弟也在某处消灭着恶灵，但一个迷路的少女却误打误撞的进入了此地......",
	[90027310202] = "通过活动获取。",
	[90027310203] = "恶鬼横行的罗剎街，也是传说的开始",
	[90027310301] = "明镜村中的灵树，虽不及四大灵树，但却能抑制妖灵的怨念，并限制恶灵行动，一直以来庇护着不少友善的妖灵们，此地的冒险者北落师门的守护似乎也跟此树有着联系。",
	[90027310302] = "通过活动获取。",
	[90027310303] = "遗忘前世，此世重行",
	[90027310401] = "受菩提树庇护的村落，在此地居住的妖灵们世代都感谢着菩提树庇佑，此地现任的冒险者「北落师门」也是一个实力强劲，明辨是非的人，因此相比冥界其他地方此地算是少有的妖灵安身之所。",
	[90027310402] = "通过活动获取。",
	[90027310403] = "阡陌交通，鸡犬相闻",
	[90027310501] = "空神之森是灵域中一个古老的地域，也是冒险者的禁地。传闻芦花古楼就在空神之森中，其中藏有极其厉害的武器和法宝，是历代御灵史都小心保护的地方。",
	[90027310502] = "通过活动获取。",
	[90027310503] = "风花雪月，亦在其中",
	[90027310601] = "爆竹声中一岁除，春风送暖入屠苏。千门万户瞳瞳日，总把新桃换旧符。",
