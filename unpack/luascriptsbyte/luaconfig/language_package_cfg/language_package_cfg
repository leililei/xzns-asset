	[90029000009] = "试玩角色无法更换首饰",
	[90029010101] = "傲慢之域",
	[90029010102] = "提亚马特是一个远程迅捷角色，拥有出色的攻击距离同时还可以击退靠近的敌人，尝试将他放在后排，提供一个较好的输出环境。",
	[90029010201] = "龙焰焚天",
	[90029010202] = "提亚马特的魂链技能将在开局时点燃敌方全体，并且大幅提升「炎翎」的触发率。",
	[90029010301] = "魔炎灼烧",
	[90029010302] = "提亚马特的灵脉技能可以使敌方的「点燃」效果持续时间变为永久，配合曹焱兵的被动可以打出巨量伤害。",
	[90029020101] = "枢天爆",
	[90029020102] = "雷炮定位为神属性迅捷角色，能破除敌人的隐身，为攻击力最高的队友提供可观的暴击率和暴击伤害增益。",
	[90029020201] = "除恶务尽",
	[90029020202] = "雷炮的绝技-枢天爆可在蓄力后造成高额的暴击伤害，在开启魂链后，可获得快速发射枢天爆的能力，能更加安全稳定的打出最高伤害。",
	[90029020301] = "天心枯荣",
	[90029020302] = "雷炮点亮灵脉后，依靠自身和队友的攻击快速触发雷光弹，能稳定的为我方全体提供增益效果，并提供追击敌人和治疗友军的能力。",
	[90029030101] = "谢幕演出",
	[90029030102] = "基克是一个雷属性奥术角色，能主动为队友吸引负面效果和承受伤害，并通过绝技将负面效果转移给敌方最具威胁的单位，同时在自身血量较低时，对该单位造成高额伤害。",
	[90029030201] = "骑士重临",
	[90029030202] = "基克开放魂链后，能有效保护我方主力输出，并为自身提供快速成长的属性。",
	[90029030301] = "决胜一击",
	[90029030302] = "基克的灵脉技能将为他带来质变，能稳定的在低血量时施放绝技，对敌方造成巨额伤害，若敌方目标处于生命较低的状态，可带领我方绝地翻盘。",
	[90029040101] = "雷火锻神",
	[90029040102] = "独眼巨人是一名雷属性圣盾角色，能通过锻造神器为队友提供支持，且善于为自身附近的队友提供高额减伤效果。",
	[90029040201] = "全面防护",
	[90029040202] = "独眼巨人激活魂链后，能大幅提高自身的生存能力，且为近战和远程的队友提供更全面的保护效果。",
	[90029040301] = "灵性升华",
	[90029040302] = "独眼巨人点亮灵脉后，会进一步强化神器的辅助效果，针对不同的职业，提供更为契合的功能。",
	[90029050101] = "当阳断喝",
	[90029050102] = "张飞作为一名水属性圣盾角色，可通过绝技嘲讽大范围内的敌人，为友军提供安全的输出环境，独有的反击机制，在保证生存的情况下，可造成高额的范围伤害。",
	[90029050201] = "截江逆流",
	[90029050202] = "张飞开启魂链后，能获得嘲讽敌方后排的能力，可有效的抑制敌方后排的输出效率，且提高我军对受嘲讽单位的伤害。",
	[90029050301] = "先声夺人",
	[90029050302] = "张飞点亮灵脉后，将获得一次开场免费施放绝技的机会，且能进一步稳定张飞的反击能力。",
	[90029060101] = "雷尊降世",
	[90029060102] = "普化天尊定位为狙杀后排的神属性奥术，能通过开局爆发和绝技对脆弱目标造成大量伤害，同时能在后半程作战中转化为战意形态提高自身持续作战能力。",
	[90029060201] = "战心澎湃",
	[90029060202] = "普化天尊解锁魂链后，可快速进入战意形态，保留自己的爆发优势的同时，更早的获取持续作战能力。",
	[90029060301] = "宰御生杀",
	[90029060302] = "普化天尊的灵脉能为他提供连续追杀的能力，并强化天心雷电被消耗后的战力。",
	[90029070101] = "风啸星沉",
	[90029070102] = "诸葛亮是一名风属性奥术角色，通过获取增益状态强化自身技能，同时可锁定敌方攻击最高的角色，与其获得同样的增益效果。",
	[90029070201] = "奇正相生",
	[90029070202] = "诸葛亮开启魂链后，八阵图锁定的敌人越活跃，诸葛亮的作战能力也将越强，同时还可在开战一段时间限制该目标，使其无法获得增益。",
	[90029070301] = "潜龙再起",
	[90029070302] = "诸葛亮的灵脉能较大程度的提高诸葛亮的生存能力，且赋予诸葛亮多次复生的可能。",
	[90029080101] = "古漠迷宫",
	[90029080102] = "当梅兹受到攻击时，会发动技能传送到己方角色身边，并对周围角色造成伤害并眩晕，并在出现处留下砂团，配合己方的突进型角色，可以打出很好的效果。",
	[90029080201] = "异界潜行",
	[90029080202] = "当梅兹受到攻击时，会发动技能传送到己方角色身边，并在脚下留下砂团，限制敌方目标移动，根据技能特性将梅兹摆放在前排，可以用来应对敌方正面突进型的前排角色。",
	[90029080301] = "沙暴送葬",
	[90029080302] = "在梅兹砂团中的敌方角色，命中率会降低30%，搭配上本身具有高闪避属性的角色，足以给与敌人致命一击。",
	[90029090101] = "侵魂蚀骨",
	[90029090102] = "阿努比斯是一名神属性战士角色，能持续掠夺周围敌人的防御能力来强化自身，并使用持续性的腐化伤害来痛击敌军。",
	[90029090201] = "不竭之灵",
	[90029090202] = "阿努比斯的魂链效果可以为其提供源源不断灵魂为己所用，能对战局的胜败起到决定性的作用。",
	[90029090301] = "举世疮痍",
	[90029090302] = "激活灵脉后，阿努比斯能有效的应对驱散型角色，使敌人陷入两难之境。",
