	[91300002105] = "我只想说懂得都懂，不懂的我也不多说了，自己好好想想吧，你也别来问我怎么回事，这里面利益牵扯太大了，说了对你我都没有好处，你就当不知道就行了",
	[91300002201] = "旅途",
	[91300002202] = "基础规则",
	[91300002203] = "快速领取",
	[91300002204] = "1、玩法开启后每分钟按当前关卡效率累计一次结算。\n2、奖励需手动领取，最多可累计12小时（地狱道可增加最大挂机时长）。\n3、每五关可获得阶段奖励。",
	[91300002205] = "1、可直接获取2小时挂机收益。\n2、每日可免费一次，消耗钻石可继续领取。\n3、每次领取消耗钻石的数量随着领取次数增加而增加。",
	[91300002301] = "共鸣神石",
	[91300002302] = "基础规则",
	[91300002303] = "标题二",
	[91300002304] = "共鸣水晶一共有五个水晶，分别对应五种寄灵人/守护灵的五行；提升水晶等级，对应五行的寄灵人/守护灵的等级也会得到提升。强化每20级为一个阶段，需要所有五行水晶均达到当前阶段等级上限时，才能继续升级。",
	[91300002305] = "我只想说懂得都懂，不懂的我也不多说了，自己好好想想吧，你也别来问我怎么回事，这里面利益牵扯太大了，说了对你我都没有好处，你就当不知道就行了",
	[91300002401] = "泰坦寓所",
	[91300002402] = "基础规则",
	[91300002403] = "标题二",
	[91300002404] = "泰坦寓所分为挑战和讨伐两种模式。挑战模式分为5个难度，每通关一个新难度可增加讨伐模式的上阵人数或讨伐模式挑战次数。挑战模式每个难度只可通关一次，无法重复通关挑战。",
	[91300002405] = "我只想说懂得都懂，不懂的我也不多说了，自己好好想想吧，你也别来问我怎么回事，这里面利益牵扯太大了，说了对你我都没有好处，你就当不知道就行了",
	[91300002501] = "曙光圣所",
	[91300002502] = "基础规则",
	[91300002503] = "标题二",
	[91300002504] = "每个女神在获得或第一次升至新的星级时，会获得战意用来提升灵魂咆哮的等级，灵魂咆哮升级时可提升该对应女神属性。战争精粹达到10级，将会解锁各职业专属光池。",
	[91300002505] = "我只想说懂得都懂，不懂的我也不多说了，自己好好想想吧，你也别来问我怎么回事，这里面利益牵扯太大了，说了对你我都没有好处，你就当不知道就行了",
	[91300002601] = "刻魂",
	[91300002602] = "基础规则",
	[91300002603] = "强化规则",
	[91300002604] = "每个角色最多可装备4个刻魂，每个刻魂都有固定位置，只能装在对应的位置。每种刻魂都有2条主要属性和若干条随机属性，品质越高，随机属性条目越多。装备同一套刻魂达到4件时，可触发套装的技能效果。",
	[91300002605] = "1、可通过魂梦石来强化刻魂，也可通过刻魂来强化，通过刻魂强化时，将原刻魂经验100%转移至当前刻魂中。\n2、刻魂最多可强化20级，每次强化都可以提升主要属性的数值。\n3、刻魂强化至指定等级时，可激活一条对应的随机属性。",
	[91300002701] = "五灵宝珠",
	[91300002702] = "基础规则",
	[91300002703] = "标题二",
	[91300002704] = "一共会开放6个宝珠分别为：雷、风、水、火、土、神，上阵角色可以使自身符合该条件的角色战力得到提升。",
	[91300002705] = "上阵角色可以使自身符合该条件的角色战力得到提升",
	[91300002801] = "大千藏品",
	[91300002802] = "藏品通过完成指定的任务进行激活，激活后可享有对应特权效果",
	[91300002901] = "冥界入侵",
	[91300002902] = "战斗期间，敌人会从传送门中源源不断的涌入，在战斗中击败指定数量的敌人后，可解锁下一难度，每日0点根据难度与击败敌人的数量进行排名，排名奖励玩家手动领取。",
	[91300003001] = "聚灵法阵",
	[91300003002] = "阵法升级可解锁女神上阵槽位，将女神上阵至对应的阵法可获得阵法内属性和阵法技。",
	[91300003101] = "黑暗本源",
	[91300003102] = "黑暗本源每两天轮换一次，仅可上阵共鸣神石栏位上的女神。每期首领都有独特的应对机制，需要各位冒险者调整阵容应对。成功挑战将会记录最高伤害，最高伤害将计入排名，并根据最终排名发放排名奖励。",
	[91300003801] = "巅峰演武",
	[91300003802] = "在巅峰演武中，由双方玩家轮流选择角色，各自选择6名角色后，再互相禁用对方1名角色，禁用完成后调整自己的站位和圣兽完成阵容设置。参与排位赛更可获得荣誉徽章，兑换赛季皮肤和丰厚奖励！",
	[91300003901] = "女神置换",
	[91300003902] = "1、女神置换可使用多余的女神置换为需要的其他同品质女神，仅女神达到满星后溢出女神可作为置换材料。\n\n神话女神：1名任意神话女神+2名核心女神\n核心女神：1名任意核心女神+2名橙色1星S+女神\n注：橙色1星女神=2名女神\n\n2、置换过的女神进行重生不会返还置换消耗材料女神。\n\n3、女神置换每日有限制次数，次数耗尽后当日无法继续置换。\n\n4、仅已拥有过的女神可进行置换，无法置换未获取过的女神。",
