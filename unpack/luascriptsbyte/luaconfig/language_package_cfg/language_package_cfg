	[30001100001] = "<color=#c7d0ff><size=23>剧情：</size></color>四面楚歌",
	[30001100002] = "\t<color=#6e7488>回到人界的夏铃遭到机械人的追捕，在鬼符三通的指点下，她再次逃向罗刹街。</color>",
