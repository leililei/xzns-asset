	[30001000001] = "章节一",
	[30001000002] = "罗刹之街，百鬼横行，幽冥深处传来的群英气息，让冒险者曹焱兵感受到了危险的信号。",
	[30001000003] = "故事",
	[30001000101] = "罗刹幽径1",
	[30001000102] = "\t<color=#6e7488>冥火纵横、百鬼横行的幽冥之地罗刹街与人界阴阳相隔，冒险者曹焱兵却意外发现一丝群英的气息。她是怎么穿越结界的？</color>",
