	[91307420712] = "<color=#f59f3a>魔星塔</color>排名已提升至第<color=#f59f3a>%s</color>名",
	[91307420801] = "任何阻挡我的敌人，都将被我的长枪洞穿，化为尘埃！",
	[91307420802] = "星光坠在锁链上叮当作响…唔，你也值得被银河偏爱呢",
	[91307420803] = "喧嚣暂歇，吾于这静谧中，审视着世间万象",
	[91307420804] = "哈哈，和我山兔一起，开启超棒的旅途之旅咯！",
	[91307420805] = "我的箭术可不是花架子，每一箭都带着胜利的决心！",
	[91307420806] = "这世间繁华，皆逃不过本宫的眼眸",
	[91307420807] = "嘘—再吵就把你们变成石头标本哦",
	[91307420808] = "我的歌声可不是谁都能消受得起的，就勉强让你多听一会儿吧！",
	[91307420809] = "以水瓶女神之名，为这片世界带来安宁与希望",
	[91307420810] = "擅自踏入我的领地，准备好承受蝎尾的剧毒了吗？",
	[91307420811] = "闲适时光，且让这好运如潺潺溪流，伴诸位悠然前行",
	[91307420812] = "并非怯懦，而是在这表象之下，洞察那隐藏的真相与力量",
	[91307420813] = "琴音虽未奏响，我的关切却从未停歇哟",
	[91307420814] = "嗯…这份宁静，是为了积蓄下一次爆发的力量",
	[91307420815] = "任何敢于冒犯之人，都将品尝到后悔的滋味！",
	[91307420816] = "林间的智慧，从不在匆忙中枯萎",
	[91307420817] = "这片领域，皆是我威严笼罩之地！",
	[91307420818] = "公正的天平将裁决一切，邪恶休想在我面前遁形",
	[91307420819] = "渺小的蝼蚁…也敢挑战女神的威严？",
	[91307420820] = "任何敢于冒犯之人，都将品尝到后悔的滋味！",
	[91307420821] = "在这静谧的时光里，让海浪的低语伴你作战，我会一直守护于此",
	[91307420822] = "本姑娘的魅力也丝毫不减，谁敢小瞧我姑获鸟！",
	[91307420823] = "你们的生死，不过是我随意挥洒的笔墨",
	[91307420824] = "故事悄然沉淀，如同陈酿的美酒",
	[91307420825] = "吾之锋芒，随时可绽，斩尽来犯之敌！",
	[91307420826] = "东海的风会为我送行，江东的儿郎随我冲锋！",
	[91307420827] = "等主公一声令下，便再舞一曲倾城之姿",
	[91307420828] = "踏碎星辰的铁蹄已至！",
	[91307420829] = "别被这安静骗了—下一秒，我就能冲破所有桎梏",
	[91307420830] = "在这静谧中感受我的守护之力，莫要惊扰这沉睡的秩序",
	[91307420831] = "这世界的一切都在我的掌控阴影之下",
	[91307420832] = "本猫妖就静静地看着周围，守护这一方小天地咯",
	[91307420833] = "愿以吾之洞察，审视这寂静时光中的隐秘秩序",
	[91307420834] = "双子的力量，将持续闪耀在这片游戏天地",
	[91307420835] = "金牛座的力量，早已刻进每寸铠甲！",
	[91307420836] = "契约之印，早刻在你灵魂里了哦",
	[91307420837] = "敢挡我路？先接下这百鬼夜行的刀！",
	[91307420838] = "让本姬的美貌给敌人来点儿“精神攻击”吧~",
	[91307420839] = "方天画戟在手，天下我有！",
	[91307420840] = "这乱世烽烟，由我来涤荡！",
	[91307420841] = "闭目时，才是真正的狩猎开始……",
	[91307420842] = "世界的变化与我何干，唯有鲜血永恒",
	[91307420843] = "在本灭世龙女面前，颤抖吧！",
	[91307420844] = "连梦境都触碰不到的真实",
	[91307420845] = "待吾再度出击，定叫敌人闻风丧胆！",
	[91307420846] = "瓶中的奥秘，化作无尽力量，伴我守护永恒",
	[91307420847] = "无论你躲到哪里，都无法逃脱我的追踪",
	[91307420848] = "此刻虽在静候，然福泽满盈，定能为友人们带来顺遂",
	[91307420849] = "待时机一到，吾将踏平一切阻碍！",
	[91307420850] = "愿这悠悠江水，见证我为大家的祈福",
	[91307420851] = "如此静好，不如就在这芬芳中，感受修为的增长吧",
	[91307420852] = "聒噪的入侵者，准备好回归尘土了吗？",
	[91307420853] = "当我苏醒，尼罗河的怒火将席卷一切阻挡吾的敌人！",
	[91307420854] = "白羊的锋芒，可不是用来欣赏的~",
	[91307420855] = "天秤的力量，会让黑暗无所遁形，光明永驻大地",
	[91307420856] = "星辰坠落之地，即为审判开始之时",
	[91307420857] = "此刻安歇，是为下一次的勇猛出击",
	[91307420858] = "海风轻拂，贝壳低语",
	[91307420859] = "看好啦，我的可爱和强大也是藏不住哒！",
	[91307420860] = "在我的审判之下，没有怜悯，也没有救赎",
	[91307420861] = "思绪便如飘飞的花瓣，落在那些古老而迷人的故事角落",
	[91307420862] = "待归之时，便是敌寇溃败之日！",
	[91307420863] = "下一战，定要斩尽敌首！",
	[91307420864] = "主公且慢，让妾身歇歇脚~待恢复元气",
	[91307420865] = "看我穿云裂石枪！这招式可比当年逍遥津斩将更快三分",
	[91307420866] = "月光洒在獠牙上时，连影子都在渴望厮杀呢",
	[91307420867] = "带着我的祝福，莫要辜负这命运的馈赠",
	[91307420868] = "我乃世界之蛇耶梦加得，挂机的时光是我积蓄毁灭力量的间隙",
	[91307420869] = "要是出现异常，本喵立马行动",
	[91307420870] = "吾亦时刻准备着，为守护信念而战",
	[91307420871] = "我们的守护也从未有过片刻停歇",
	[91307420872] = "狂风吹过，不过是冲锋的前奏",
	[91307420873] = "现在逃，可来不及咯",
	[91307420874] = "想逃？我的刀…比你的命还快",
	[91307420875] = "等醒来就能和小伙伴们一起开启超厉害的旅途咯，嘿嘿",
	[91307420876] = "这战场之上，吾便是那主宰生死的无双战神！",
	[91307420877] = "看我这银枪，挑落星河如雨！",
	[91307420878] = "情报是致命的毒药",
	[91307420879] = "待吾睁开双眼，一切都将重归寂静",
	[91307420880] = "终将是我的游乐场，谁也无法阻挡",
	[91307420881] = "古神的注视没有终点，永远涌动着不可名状的黑暗",
	[91307420882] = "当我重新踏上征途，便是胜利之刻降临之时！",
	[91307420883] = "哼，区区杂鱼…让你看看什么叫“秒变烤全羊”！",
	[91307420884] = "此乃圣盾之誓，以我的力量守护这世间的公平秩序",
	[91307420885] = "你们的挣扎…只会成为献给我的祭品",
	[91307420886] = "吾之威严亦如烈焰灼灼，尔等宵小休要妄动",
	[91307420887] = "海浪的低语伴你作战，我会一直守护于此",
	[91307420888] = "说不定下一秒就赏你个意外惊喜！",
	[91307420889] = "无需多言，既已踏入这领域，便接受这既定的结局",
	[91307420890] = "我的故事却仍在暗处涌动，你可敢来一探究竟？",
	[91307420891] = "再与诸君痛饮三百杯，共赴那厮杀战场！",
	[91307420892] = "江东之地，皆为吾之疆场",
	[91307420893] = "定以这无双舞步，为咱们的阵营添上一抹亮色",
	[91307420894] = "...哈！有趣！再来百回合又何妨！",
	[91307420895] = "狂风掠过荒原，而我在等待下一次狩猎……",
	[91307420896] = "以汝等之勇，踏破未知，方不负吾之注视",
	[91307420897] = "沉睡在黑暗深渊的我",
	[91307420898] = "喵~有本喵在，这片区域的安全就包在我身上啦",
	[91307420899] = "吾内心坚定，随时迎接即将到来的挑战",
	[91307420900] = "愿以双子之名，为这游戏世界增添一抹安宁",
	[91307420901] = "这一战，我会用角撕碎所有怯懦！",
	[91307420902] = "再盯着我看…可就要被尾巴卷走啦～",
	[91307420903] = "惨叫是这战场最美的乐章",
	[91307420904] = "明月为契，繁星作引",
	[91307420905] = "吾乃吕布，天下无双！",
	[91307420906] = "龙胆啸天，锋芒破晓",
	[91307420907] = "错过死亡降临的瞬间，可是你的损失",
	[91307420908] = "待归来之时，尔等皆要俯首称臣",
	[91307420909] = "龙的力量，将席卷一切，凡人，都给我退下！",
	[91307420910] = "古神的倒计时…从你登录那刻开始。",
	[91307420911] = "我心情不好的时候脸色发青",
	[91307420912] = "妄图靠近者，必将承受蛇蝎之怒",
	[91307420913] = "下一秒，又将有怎样的神秘降临？",
	[91307420914] = "蓄势待发的温柔陷阱，等着粗心的猎物自投罗网",
	[91307420915] = "连时间都会陷入我的茧房",
	[91307420916] = "需要我重新编织祂们的誓约锁链吗？",
	[91307420917] = "金线穿梭，编织着希望与安宁",
	[91307420918] = "以灾厄之名，赐予你们无尽的恐惧",
	[91307420919] = "黑暗降临，希望破灭，这就是你们忤逆我的下场",
	[91307420920] = "黑暗笼罩之下，无人能够逃脱",
	[91307420921] = "本王稍作休憩，尔等宵小勿要妄动",
	[91307420922] = "待归来，便是尔等的末日",
	[91307420923] = "待吾眸光再启，恐惧将如影随形",
	[91307420924] = "妄图来犯者，必受深渊怒火炙烤",
	[91307420925] = "冥界深处藏着无尽奥秘",
	[91307420926] = "带着未知的力量与旨意，顺从者生，违逆者亡",
	[91307420927] = "之后的事，自有分寸",
	[91307420928] = "等我重新入局，战火将再度燃起",
	[91307420929] = "下一场战斗，我定要碾压对手",
	[91307420930] = "时间在我指尖流淌",
	[91307420931] = "岁月的长河由我主宰，你们休想逆乱",
	[91307420932] = "妄图挑战我的人，都将被时间吞噬",
	[91307420933] = "静可观星，动可定局，何须言语，自有乾坤。",
	[91307420934] = "且看这一局，谁能落子无悔。",
	[91307420935] = "袖揽流云，心藏万象，这天下风云，皆在我一念之间。",
	[91307420936] = "螳臂当车，不过是自取其辱罢了。",
	[91307420937] = "青龙偃月，斩尽天下奸佞。",
	[91307420938] = "匹夫，可敢再战！",
	[91307420939] = "匡扶汉室，乃某毕生之志，虽千万人吾往矣。",
	[91307420940] = "天道昭昭，岂容尔等猖獗！",
	[91307420941] = "暂歇片刻，待某重整旗鼓，再定乾坤。",
	[91307420942] = "哼！不堪一击的鼠辈！",
	[91307420943] = "还有谁！还有谁不服！",
	[91307420944] = "哈哈，杀得痛快！等我再喝几口酒，再战三百回合！",
	[91307420945] = "战场没有平局，只有你和墓碑的区别。",
	[91307420946] = "你的鲜血，刚好够润湿我的剑刃。",
	[91307420947] = "勇气可嘉，可惜我是专碾碎勇气的车轮。",
	[91307420948] = "不必哀求，饥饿是我赐予你的王冠。",
	[91307420949] = "你的胃里住着狼，而我是饿狼的母亲。",
	[91307420950] = "面包与美酒？那是我喂给老鼠的残渣。",
	[91307420951] = "腐烂的味道，比玫瑰更令我心醉～",
	[91307420952] = "你咳嗽的样子，像极了绝望的小丑。",
	[91307420953] = "别求饶，我的仁慈只施舍给尸体。",
	[91307420954] = "哭泣可以，别弄脏我脚下的白沙。",
