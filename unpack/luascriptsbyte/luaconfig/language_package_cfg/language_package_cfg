	[30002030701] = "羽林殿外",
	[30002040001] = "两个怪物",
	[30002040002] = "\t<color=#6e7488>曹焱兵一行人赴约，与北落师门一战。女神惜女神，二人全力以赴，以示对对手的尊重。</color>",
	[30002040003] = "2-4 两个怪物",
	[30002050001] = "绝地反击",
	[30002050002] = "\t<color=#6e7488>曹焱兵愤然奔走，在羽林街横冲直撞，这引起了南御夫的注意。南御夫派出天市、紫薇等人，守在重要关隘拦截曹焱兵。</color>",
	[30002050003] = "2-5 绝地反击",
	[30002060001] = "扬清激浊",
	[30002060002] = "\t<color=#6e7488>太微取出北落师门的镇魂链，准备给他一点惩罚。危机关头，曹焱兵赶到，用尽浑身力气与太微大战，这时，一个陌生的面孔出现在曹焱兵面前。</color>",
	[30002060003] = "2-6 扬清激浊",
	[30002070001] = "半路拦截",
	[30002070002] = "\t<color=#6e7488>南御夫寡不敌众，遂召出部下抵抗北落师门，自己则溜进宫殿深处，妄图吃下玄黄丹，变身为怪兽“噬日”，再与曹焱兵等人抗衡。</color>",
	[30002070003] = "2-7 半路拦截",
	[30002080001] = "力挽狂澜",
	[30002080002] = "\t<color=#6e7488>羽林军人数众多，等曹焱兵一行人逐步突破层层防线，南御夫已吞下玄黄丹。阳光下，噬日缓缓现形，身躯如陡峭的高山，遮住了太阳。一场恶战在所难免。</color>",
	[30002080003] = "2-8 力挽狂澜",
	[30002090001] = "梦碎明镜",
	[30002090002] = "\t<color=#6e7488>曹玄亮返回村子去取落下的东西，映入眼睛的却是一片火海。原来趁曹焱兵和北落师门决斗的功夫，南御夫命令手下来村子取菩提神珠，并以水儿为人质，押走了北落师门。</color>",
	[30002090003] = "剧情：梦碎明镜",
	[30002100001] = "背信之人",
	[30002100002] = "\t<color=#6e7488>北落师门当面质问南御夫为何做此伤天害理之事，南御夫则斥责北落师门优柔寡断，做不了大事。二人曾经的共事之情在此刻烟消云散，北落师门下定决心与其一战。</color>",
	[30002100003] = "剧情：背信之人",
	[30002110001] = "别离之殇",
	[30002110002] = "\t<color=#6e7488>回到村子，身体瘦弱的水儿早已奄奄一息。北落师门作为她生前的父亲，悲痛地与她做最后的告别。</color>",
	[30002110003] = "剧情：别离之殇",
	[30002120001] = "预言师",
	[30002120002] = "\t<color=#6e7488>根据预言师的预测，曹焱兵将在三天内遇到三个劫难，而随着旅程的深入，预言正一个个兑现……</color>",
	[30002130001] = "幽深密道",
	[30002130002] = "\t<color=#6e7488>曹焱兵受人所托护送孤儿，谁知半路上，孩子忽然凭空消失，旅程也变得怪异起来。</color>",
	[30002140001] = "魂灵碎片",
	[30002140002] = "\t<color=#6e7488>幽灵并非血肉之躯，他们的存在更为抽象，即便形体被分散，意识也得以留存于天地间。这天，曹焱兵就在路上遇见了一块幽灵碎片，应它的要求，曹焱兵开始帮她寻找另一块碎片，以复原自由活动的躯体。</color>",
	[30002150001] = "致命残卷",
	[30002150002] = "\t<color=#6e7488>曹焱兵捡到一张印有灵域标志的残卷，背后隐藏着众御史不可告人的秘密，这份秘密带来了血光之灾。</color>",
	[30003000000] = "章节三",
	[30003000001] = "章节三",
	[30003000002] = "不要怕坎坷路长远，勇敢地踏入禁忌之森吧！可是，要找的东西根本无迹可寻？！",
	[30003000101] = "回家的路1",
	[30003000201] = "回家的路2",
	[30003000301] = "回家的路3",
	[30003000401] = "回家的路4",
	[30003000501] = "回家的路5",
	[30003010001] = "除灵风波",
	[30003010002] = "\t<color=#6e7488>为了寻找传说中的芦花古楼，曹焱兵进入空神之森，却发现了一群好斗的蜥蜴怪。</color>",
	[30003010003] = "第七关",
	[30003010004] = "四面楚歌",
	[30003010101] = "罗刹山脚",
	[30003010201] = "万灵巷",
	[30003010301] = "无影路口",
	[30003010401] = "无影内街",
	[30003010501] = "无影内街",
	[30003010601] = "水镜堂",
	[30003020001] = "梦山神器",
	[30003020002] = "\t<color=#6e7488>密林中迷雾渐浓，大家中了夺魄神花的幻术，入了迷境，夏铃一不下心踩进一张巨大的蛛网。</color>",
	[30003020003] = "第八关",
	[30003020004] = "扭转颓势",
	[30003020101] = "无影街",
	[30003020201] = "罗刹山脚",
	[30003020301] = "化龙巷",
	[30003020401] = "集市",
	[30003020501] = "神龙巷",
	[30003020601] = "青云路",
	[30003030001] = "深巷顽童",
	[30003030002] = "\t<color=#6e7488>北落师门深入迷雾，一只有着坚固外壳的大甲虫早已埋伏在此，等待北落师门走入自己的领地。</color>",
	[30003030003] = "第九关",
	[30003030004] = "守护灵槐",
	[30003030101] = "神龙巷",
	[30003030201] = "神龙巷",
	[30003030301] = "神龙巷",
	[30003030401] = "谜语巷",
	[30003030501] = "神龙巷",
	[30003030601] = "西风巷",
	[30003040001] = "憎怨别离",
	[30003040002] = "\t<color=#6e7488>曹焱兵和曹玄亮遭遇了森林主人——食火蜥吉拉的伏击。吉拉是王国的部下，早已摩拳擦掌，准备捉拿曹焱兵。</color>",
	[30003040003] = "第十关",
	[30003040004] = "榆槐桃桑",
	[30003050001] = "神奇米糕",
	[30003050002] = "\t<color=#6e7488>阎风咤带领大家在从林中穿梭，曹焱兵与阎风咤意见发生分歧，争执中，两人掉入陷阱之中。</color>",
	[30003050003] = "第十一关",
	[30003060001] = "灵魂转生",
	[30003060002] = "\t<color=#6e7488>路的尽头被一块被封印的巨石堵住了去路，必须一人举起，让另一个人出去，去外面打开开关。</color>",
	[30003060003] = "第十二关",
	[30003060101] = "十字街",
	[30003060201] = "化龙巷西",
	[30003060301] = "西风巷",
	[30003060401] = "西风巷外",
	[30003060501] = "百魂桥",
	[30003060601] = "百魂桥西",
	[30003060602] = "焱兵已经到了，去问问吧。",
	[30003060603] = "焱兵找我会是什么事呢？",
	[30003060604] = "我竟然在无意间学会使用法力了。",
	[30003060605] = "我还是快问问焱兵是怎么回事了。",
	[30003060606] = "焱兵，快告诉我召唤守护灵的方法吧。",
	[30003060607] = "是时候召唤我的守护灵了。",
	[30003060608] = "我才不会退宿！",
	[30003060609] = "没想到我的守护灵竟是这样的家伙。",
	[30003060610] = "我会守护罗刹街。",
	[30003060611] = "这家伙什么来头？",
	[30003060612] = "大家当心！躲开那些石头！",
	[30003060613] = "这家伙真狡猾。",
	[30003060614] = "地狱三头犬？",
	[30003060615] = "谁都别想拦住我。",
	[30003060616] = "不知道那家伙有什么阴谋。",
	[30003060617] = "得赶紧追上他。",
	[30003060618] = "居然是圈套？",
	[30003060619] = "这里到底发生了什么……",
	[30003060620] = "这么多蛛网……",
	[30003060621] = "那蜘蛛一定抓走了不少人。",
	[30003060622] = "竟然伤害了这么多人。",
	[30003060623] = "决不能饶恕。",
	[30003060624] = "一定要保护好灵魂核心。",
	[30003060625] = "这是幽灵转生所化成的核心体。",
	[30003060626] = "南御夫躲去哪里了？",
	[30003060627] = "得快点把他找出来。",
	[30003060628] = "可恶，有埋伏！",
	[30003060629] = "大家注意躲避弓箭！",
	[30003060630] = "宝箱？真是走运。",
	[30003060631] = "看看这里有没有我们需要的东西吧。",
	[30003070001] = "山中猛兽",
	[30003070002] = "\t<color=#6e7488>阎风咤根据经验判断出芦花古楼将要现身的位置，一行人决定在芦花古楼出现前赶往那里。</color>",
	[30003070003] = "第十三关",
	[30003080001] = "郊区来信",
	[30003080002] = "\t<color=#6e7488>传闻水镜堂的除灵师精通咒术，曹焱兵便带着被黑色诅咒缠绕的十殿阎罗前去拜访。</color>",
	[30003080003] = "第十四关",
	[30003080004] = "\t<color=#6e7488>镇魂街的魂灵们最大的心愿，便是能逃离恶灵遍布之地，转生进入轮回。曹焱兵在路途中捡到一个进入转生状态的灵魂核心，于是决定带他寻找转生点。</color>",
	[30003080005] = "\t<color=#6e7488>曹焱兵像往常一样清理罗刹街的恶灵，一路上却总觉得有人跟着自己……</color>",
	[30003080006] = "\t<color=#6e7488>一只恶灵四处作乱，为害百姓，曹焱兵将其击败后，却想起曾在哪里见过他。</color>",
	[30003080007] = "\t<color=#6e7488>收到一封来自陌生小巷的求助信，曹焱兵想也没想便前去查探，不料却踏进了恶灵的陷阱……</color>",
	[30003080008] = "\t<color=#6e7488>传闻梦山神器化为渡鸦逃出灵域，似飞往罗刹街方向。冒险者曹焱兵因此受到灵域下达的指令，勒令他搜寻罗刹街，带回梦山神器。</color>",
	[30003090001] = "疾风刀刃",
	[30003090002] = "\t<color=#6e7488>森林原住民的后裔阎风咤加入小队，曹焱兵却无法说服自己百分百相信这个陌生人。</color>",
	[30003090003] = "第十五关",
	[30003100001] = "神秘遗迹",
	[30003100002] = "\t<color=#6e7488>经过逃出陷阱这一遭，曹焱兵和阎风咤尽释前嫌，消除了隔阂。</color>",
	[30003100003] = "剧情：神秘遗迹",
	[30003110001] = "登堂入室",
	[30003110002] = "\t<color=#6e7488>芦花古楼终于现身，尽管不知道古楼内等着他们的是否是更为凶险的道路，众人依旧义无反顾地奔向芦花古楼。</color>",
	[30003110003] = "剧情：登堂入室",
	[30003110004] = "\t<color=#6e7488>夏铃在战斗中不幸中了恶灵的眩晕术，所幸术力不深。若要复原，需要吃幽灵制作的食物，曹焱兵决定前往集市寻找一番。</color>",
