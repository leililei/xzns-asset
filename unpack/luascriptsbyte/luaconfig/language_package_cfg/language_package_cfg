	[90000010123] = "阵容核心：铁卒 \n阵容介绍：急速输出流派，以铁卒为核心，通过韩信的急速增益，让敌方目标迅速被各种负面标记，并高频触发铁卒『竹马追风』斩断附带的神圣伤害效果，快速损失血量。",
	[90000010124] = "阵容核心：郭嘉 控制组件：刘羽禅、黄忠\n\n阵容介绍：控制流派，以郭嘉为核心，让对面在控制状态中受到高额的百分比伤害。",
