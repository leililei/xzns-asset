	[90028611601] = "镇魂佛珠",
	[90028611602] = "佛珠本身闪烁着金色宁静的光芒，但串珠之线的手感却让人不寒而栗。\n<color=#76daf8>——该藏品可使所有战斗物理抗性增加</color>",
