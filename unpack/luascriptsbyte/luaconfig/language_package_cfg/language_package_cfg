	[90028612001] = "黄金甲虫",
	[90028612002] = "据说是从龙桃树上摘下的甲虫，吸取了神树的精华，闪烁着让人目眩的金色光芒\n<color=#76daf8>——该藏品可使所有战斗防御力增加</color>",
	[90028612003] = "通关<color=#5bdf99>芦花幻境</color>中的<color=#5bdf99>花王5层</color>可激活该藏品",
	[90028612101] = "御天秘钥",
	[90028612102] = "光彩夺目的钥匙，似乎可以开启不属于人界的秘宝。",
	[90028612201] = "炽热璀璨",
	[90028612202] = "手持这个红色的宝石，便能感受到无尽的热情。在黑暗寒冷的灵域，实在是太难得了！\n<color=#76daf8>——该藏品可使所有战斗伤害增加</color>",
	[90028612203] = "通关<color=#5bdf99>芦花幻境</color>中的<color=#5bdf99>雪王10层</color>可激活该藏品",
	[90028612301] = "王侯将令",
	[90028612302] = "古时，号令王公贵族的令牌。见令牌如见帝王，必须无条件服从。",
	[90028612303] = "",
	[90028612401] = "天下将令",
	[90028612402] = "有德者可号令天下，将令一出天下英豪竞相追随，皆为追随号令者德位也。",
	[90028612403] = "",
	[90028612501] = "希望号角",
	[90028612502] = "吹响号角，必定有援军从远方而来。是希望和胜利的象征。\n<color=#76daf8>——该藏品可使所有战斗暴击伤害增加</color>",
