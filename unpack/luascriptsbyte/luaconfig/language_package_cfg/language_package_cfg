	[11632000016] = "",
	[11632010101] = "亡者领域",
	[11632010102] = "被动的，青龙无法释放普攻，转为每秒对当前敌人释放<color=#5bdf99>1</color>道闪电，对目标造成<color=#5bdf99>100%</color>攻击力的魔法伤害，并获得<color=#5bdf99>100</color>点法力值。\n青龙免疫负面效果，当法力值达到满值时，持续消耗法力值开启腐化领域，<腐化@103842>范围内的敌人。",
	[11632010201] = "绝技",
	[11632010202] = "当友方攻击受腐化的敌人时，获得<color=#5bdf99>1</color>层<不洁狂热@103843>。",
	[11632010301] = "绝技",
	[11632010302] = "当敌人已经受到<color=#5bdf99>4</color>层“腐化”时，之后每次受到“腐化”将受到自身<color=#5bdf99>10%</color>最大生命值的伤害。",
	[11632010402] = "当敌人已经受到<color=#5bdf99>4</color>层“腐化”时，之后每次受到“腐化”将受到自身<color=#5bdf99>12%</color>最大生命值的伤害。",
	[11632030101] = "天灾骑士",
	[11632030102] = "最先造成其自身<color=#5bdf99>100%</color>最大生命值伤害的英雄，会被选为<天灾骑士@103844>，当“天灾骑士”战败时，青龙会吸收“天灾骑士”<color=#5bdf99>30%</color>的基础属性，并将己方当前攻击力最高的英雄封为下一任“天灾骑士”。",
	[11632030201] = "主动技",
	[11632030202] = "“天灾骑士”每<color=#5bdf99>2</color>秒获得<color=#5bdf99>1</color>层“天灾之力”效果，持续<color=#5bdf99>3</color>秒，至多可累积<color=#5bdf99>3</color>层。每层天灾之力可抵御<color=#5bdf99>1</color>次控制效果。每消耗<color=#5bdf99>1</color>层“天灾之力”则减少自身<color=#5bdf99>1.5</color>秒主动技能冷却，同时使下<color=#5bdf99>3</color>次造成伤害提升<color=#5bdf99>30%</color>，该效果可叠加。",
	[11632030301] = "主动技",
	[11632030302] = "每<color=#5bdf99>5</color>秒在“天灾骑士”周围开启<color=#5bdf99>1</color>次腐化领域。",
	[11632030402] = "“天灾骑士”释放绝技时，恢复青龙<color=#5bdf99>10%</color>锁血下限。",
	[11632040101] = "诅咒礼物",
	[11632040102] = "靠近点，再靠近点，当敌方首次出现造成其自身<color=#5bdf99>100%</color>最大生命值伤害的英雄时，青龙将<蛊惑@103849>他并且为其提供自身<color=#5bdf99>30%</color>的基础属性，效果持续6秒。如敌人免疫蛊惑或者驱散蛊惑，则收回赠与的属性，同时为其附着<color=#5bdf99>1</color>层<腐化之拥@103845>。",
	[11632040201] = "被动技",
	[11632040202] = "战斗中攻击力提高<color=#5bdf99>13%</color>，防御力提高<color=#5bdf99>20%</color>。",
	[11632040301] = "被动技",
	[11632040302] = "战斗中攻击力提高<color=#5bdf99>16%</color>，防御力提高<color=#5bdf99>25%</color>。",
	[11632040402] = "战斗中攻击力提高<color=#5bdf99>20%</color>，防御力提高<color=#5bdf99>30%</color>。",
	[11632050101] = "魔灌坚冰",
	[11632050102] = "战斗开始时，青龙锁定当前生命百分比，受到伤害时生命值不会跌落百分比以下，自身每累积受到<color=#5bdf99>80%</color>最大生命值的伤害，产生<color=#5bdf99>1</color>道裂痕，产生裂痕时锁血百分比开始以每秒<color=#5bdf99>5%</color>的速度下降，裂痕数量最多叠加至<color=#5bdf99>5</color>层，裂痕越多则锁血掉落的速度越快，最低降至<color=#5bdf99>0</color>。",
	[11632050201] = "被动技",
	[11632050202] = "青龙受到的伤害降低<color=#5bdf99>25%</color>。",
	[11632050301] = "被动技",
	[11632050302] = "青龙首次生命开始流逝时，如此时存在<天灾骑士@103844>则使其立即获得<color=#5bdf99>5</color>层<不洁狂热@103843>。",
	[11632050402] = "青龙受到的伤害降低<color=#5bdf99>35%</color>。",
	[11632060101] = "觉醒1阶",
	[11632060102] = "战斗开始时，将为其余队友添加<color=#D42F0D>5</color>枚符文石，符文石碎裂之前将锁定当前生命值。当受到普攻伤害时，损毁<color=#D42F0D>1</color>枚符文石用以抵抗该次伤害。符文石至多可持续<color=#D42F0D>8</color>秒。",
	[11632060201] = "觉醒2阶",
	[11632060202] = "<天灾骑士@103844>为不洁之躯，每累积获得<color=#D42F0D>1</color>个负面效果，提升自身<color=#D42F0D>2%</color>基础属性，至多可获得<color=#D42F0D>100%</color>基础属性的提升。“天灾骑士”每秒驱散自身<color=#D42F0D>1</color>个随机负面效果，其负面效果低于<color=#D42F0D>3</color>个时，每秒恢复其<color=#D42F0D>5%</color>最大生命值的生命，并恢复青龙<color=#D42F0D>80</color>点法力值。",
	[11632060301] = "觉醒3阶",
	[11632060302] = "<天灾骑士@103844>每造成自身<color=#D42F0D>200%</color>生命值或击杀敌方英雄时，会为青龙修补<color=#D42F0D>1</color>道裂痕，如青龙此时未产生裂痕，则生成<color=#D42F0D>1</color>道屏障，在青龙产生裂痕时，消耗屏障来抵消裂痕，屏障至多可叠加<color=#D42F0D>3</color>层。",
	[11632060401] = "觉醒4阶",
	[11632060402] = "符文石碎裂时，沉默其周围敌人<color=#D42F0D>2</color>秒，并扣除敌人<color=#D42F0D>150</color>点法力值。",
	[11632060501] = "觉醒5阶",
	[11632060502] = "当青龙死亡时，如此时场上存在<天灾骑士@103844>，则青龙的灵魂将附着于“天灾骑士”的身上进行融合仪式。融合期间“天灾骑士”无法行动，免疫控制和吞入，其获得<死灵灌注@103846>效果，<color=#D42F0D>4</color>秒后如果“死灵灌注”的护盾依旧存在，则仪式成功，此后每<color=#D42F0D>4</color>秒在敌方随机<color=#D42F0D>3</color>人脚下召唤<凋零领域@103847>。",
	[11632070101] = "初始",
	[11632070102] = "存在<天灾骑士@103844>时，青龙的普攻效果替换为每秒对生命值最低的敌人劈出一道闪电，对目标及其周围的敌人造成其<color=#5bdf99>5%</color>最大生命值的伤害，自身恢复<color=#5bdf99>120</color>点法力值。",
	[11632070201] = "特化1",
	[11632070202] = "防御提高<color=#5bdf99>30%</color>。",
	[11632070301] = "专属1",
	[11632070302] = "敌人被<腐化@103842>时，如若当前生命值低于<color=#5bdf99>30%</color>，则<冻结@103848>目标。",
	[11632070401] = "特化2",
	[11632070402] = "攻击力提高<color=#5bdf99>25%</color>。",
	[11632070501] = "专属2",
	[11632070502] = "其余友方单位处在腐化领域内时，每秒恢复<color=#5bdf99>8%</color>其最大生命值的生命，同时驱散目标的<color=#5bdf99>1</color>个负面效果。",
	[11632070601] = "特化3",
	[11632070602] = "攻击力提高<color=#5bdf99>25%</color>。",
	[11632070701] = "专属3",
	[11632070702] = "<天灾骑士@103844>普攻命中受<腐化@103842>的敌人时，为其添加<color=#5bdf99>1</color>层<死亡诅咒@103622>。",
	[14302000001] = "公正泰坦",
	[14302000002] = "裁决泰坦",
	[14302000003] = "审判泰坦",
	[15002000001] = "岩石怪",
	[15002100101] = "暗影斩击",
	[15002100102] = "石父潜入暗影，<color=#5bdf99>1</color>秒后闪现至敌方生命最低的目标身后，造成<color=#5bdf99>500%</color>攻击力的物理伤害。若成功斩杀，则重置此技能冷却；若斩杀失败，则沉默目标，且降低<color=#5bdf99>50%</color>的受治疗强度，持续<color=#5bdf99>5</color>秒",
	[15002300101] = "怨毒挥击",
	[15002300102] = "连续挥舞双臂进行<color=#5bdf99>3</color>段斩击，对目标造成<color=#5bdf99>200%</color>攻击力的物理伤害，第三段挥击发射出一道能量，对路径上的敌人造成<color=#5bdf99>300%</color>攻击的物理伤害，并且有<color=#5bdf99>70%</color>概率给目标添加<剧毒@103651>。",
	[15002400101] = "即将狂暴，快杀小兵",
	[15002400102] = "当石父生命首次低于<color=#5bdf99>50%</color>的时候，进入【隐匿】状态持续引导<color=#5bdf99>20</color>s，该状态下无法被选中和受到伤害，此时召唤<color=#5bdf99>4</color>个『石子』为他作战。\n引导结束后，石父进入“狂暴”状态；若『石子』在引导结束前被全部击杀，则打断引导。",
	[15003000001] = "奥术巨像",
	[15003100101] = "巨像冲击",
	[15003100102] = "奥术巨像抬手向前蓄力，随后发射出一道贯穿战场的激光，总计造成<color=#5bdf99>500%</color>攻击力的法术伤害并击退敌方单位.",
	[15003300101] = "奥术护盾",
	[15003300102] = "奥术巨像为自己凝聚一个奥术护盾，护盾可吸收自身<color=#5bdf99>400%</color>攻击力的伤害，持续<color=#5bdf99>6</color>s，护盾持续期间物理抗性提高<color=#5bdf99>99%</color>，持续时间结束后如果护盾并未被破坏，奥术巨像获得<魔力膨胀@103653>状态.",
	[15003400101] = "法术星炬",
	[15003400102] = "奥术巨像每受到血量上限<color=#5bdf99>30%</color>的伤害，都会释放一道冲击波，对敌人造成击退和减速效果，并使敌方全体造成的伤害降低<color=#5bdf99>20%</color>，持续<color=#5bdf99>6</color>s，并立即重置奥术护盾的冷却，每<color=#5bdf99>20</color>s只会触发一次此技能。",
	[15004000001] = "次元恶魔",
	[15004100101] = "毁灭重击",
	[15004100102] = "次元恶魔召唤能量猛击敌人，对前方圆形区域造成<color=#5bdf99>400%</color>攻击力的伤害，击飞所有目标的同时引爆目标身上的<灼烧@103650>，地面留下持续<color=#5bdf99>10</color>秒的【余烬池】（持续重伤，且每秒造成<color=#5bdf99>50%</color>攻击力的持续伤害）；次元恶魔每释放<color=#5bdf99>1</color>次【毁灭重击】，自身获得<color=#5bdf99>1</color>层<次元异火@103649>",
	[15004300101] = "邪炎喷涌",
	[15004300102] = "次元恶魔对前方扇形区域内目标造成<color=#5bdf99>200%</color>攻击力的伤害和击退效果并附加<color=#5bdf99>1</color>层<灼烧@103650>（自身每有<color=#5bdf99>1</color>层<次元异火@103649>，额外添加<color=#5bdf99>1</color>层【灼烧】）。",
	[15004400101] = "毁灭之潮",
	[15004400102] = "战斗开始后每隔<color=#5bdf99>3</color>秒，次元恶魔会召唤<color=#5bdf99>1</color>颗天外异火砸向随机目标爆炸，对范围内敌人造成<color=#5bdf99>150%</color>攻击力伤害，同时对目标添加<灼烧@103650>。当敌方全场【灼烧】层数达到<color=#5bdf99>15</color>层时，重置【毁灭重锤】的冷却时间并净化自身所有减益。",
	[15005000001] = "木桩假人",
	[15006000001] = "奥术巨像_蓝",
	[15006100101] = "寂灭之地",
	[15006100102] = "奥术巨像双拳砸地，对范围内敌人造成<color=#5bdf99>200%</color>攻击力的物理伤害，并地面留下持续<color=#5bdf99>5</color>s的<寂灭地@103648>。",
	[15006300101] = "毁灭追击",
	[15006300102] = "奥术巨像每失去<color=#5bdf99>20%</color>最大生命值，都会落下巨拳虚影，对随机<color=#5bdf99>2</color>个敌方单位造成<color=#5bdf99>200%</color>攻击力的物理伤害。",
	[15006400101] = "巨像遗章",
	[15006400102] = "当<寂灭地@103648>消失时，奥术巨像都会吸收全场流散的能量，场上每有<color=#5bdf99>1</color>个敌方单位血量百分比低于<color=#5bdf99>80%</color>/<color=#5bdf99>50%</color>/<color=#5bdf99>30%</color>（包括死亡单位），奥术巨像会减少寂灭之地<color=#5bdf99>1.5</color>/<color=#5bdf99>1.7</color>/<color=#5bdf99>2</color>s的冷却时间，同时恢复<color=#5bdf99>8%</color>已损生命值。",
	[15007000001] = "奥术巨像_绿",
	[15007100101] = "固封救援",
	[15007100102] = "奥术巨像进行吟唱，为队友附着<生命之盾@103646>，持续<color=#5bdf99>8</color>s，吟唱期间如果被打断，则进入<color=#5bdf99>10</color>s<魔法紊乱@103647>状态。",
	[15007300101] = "生命怒吼",
	[15007300102] = "战斗开始后，每出现<color=#5bdf99>1</color>名队友死亡，剩余队友都会提升<color=#5bdf99>20%</color>当前攻击力和防御力，如果<color=#5bdf99>10</color>内无队友死亡，则立即回复其他所有友方单位<color=#5bdf99>20%</color>最大生命值",
	[15007400101] = "紧急传召",
	[15007400102] = "奥术巨像有伙伴助阵，进入战斗时会获得<color=#5bdf99>70%</color>伤害减免和<color=#5bdf99>30%</color>伤害加成，每失去一个队友，则减少<color=#5bdf99>20%</color>伤害减免和<color=#5bdf99>10%</color>伤害加成",
	[15008000001] = "奥术巨像_红",
	[15008100101] = "热烈冲锋",
	[15008100102] = "奥术巨像免疫控制并开始冲锋，击飞路径上的敌人并造成<color=#5bdf99>400%</color>攻击力的物理伤害，冲锋到最远端后闪身回到原地",
	[15008300101] = "熔岩冲刷",
	[15008300102] = "奥术巨像每<color=#5bdf99>6</color>s都会释放一次熔岩冲刷，清除自身所有减益效果，每清除<color=#5bdf99>1</color>条减益效果，奥术巨像都会获得<color=#5bdf99>1</color>层不可驱散的<熔岩印记@103645>",
	[15008400101] = "巨石之力",
	[15008400102] = "战斗开始后，每<color=#5bdf99>8</color>s，奥术巨像的下一次普攻会额外附带<熔岩印记@103645>层数*<color=#5bdf99>5%</color>敌方最大生命值的<神圣伤害@100108>，并且附带<color=#5bdf99>4</color>s的禁疗效果",
	[15009000001] = "奥术巨像_金",
	[15009100101] = "奥术飞雨",
	[15009100102] = "奥术巨像举起双拳发射数颗奥术飞弹，对敌方最密集区域总计造成<color=#5bdf99>200%</color>攻击力的物理伤害，范围内每有<color=#5bdf99>1</color>名敌方单位（包含召唤物），则本次伤害增加<color=#5bdf99>20%</color>。",
	[15009300101] = "虚空之力",
	[15009300102] = "奥术巨像每<color=#5bdf99>4</color>s都会凝聚<color=#5bdf99>1</color>缕虚空之力萦绕周围，每缕虚空之力都会增加奥术巨像<color=#5bdf99>10%</color>攻击速度，受到<color=#5bdf99>30</color>次攻击后消散，奥术巨像释放奥术飞雨时，虚空之力越多，发射的子弹越多。",
	[15009400101] = "狩猎崩坏",
	[15009400102] = "战斗开始后，每<color=#5bdf99>8</color>s奥术巨像都会朝战场投掷<color=#5bdf99>1</color>只蕴含虚空之力的奥术飞箭，对敌方全体造成<color=#5bdf99>120%</color>攻击力的物理伤害，对召唤物额外造成<color=#5bdf99>2</color>倍伤害。如果造成击杀，奥术巨像攻速永久增加<color=#5bdf99>30%</color>，最高可叠加<color=#5bdf99>3</color>层。",
	[15010000001] = "裁决泰坦",
	[15010100101] = "黑洞坍缩",
	[15010100102] = "裁决泰坦在身前召唤黑洞，牵引敌方全体并持续造成魔法伤害，每次伤害有概率添加“腐蚀”，数秒后黑洞爆炸并击退所有敌人。\n【腐蚀】：降低防御力，最多可叠加<color=#5bdf99>5</color>层。",
	[15010300101] = "虚空共鸣",
	[15010300102] = "裁决泰坦释放能量，对敌方全体造成魔法伤害，并降低目标的法力获取效率，持续<color=#5bdf99>5</color>秒；并永久提升『古岩碎片』的攻击速度和攻击力，可持续叠加。",
	[15010400101] = "腐化再生",
	[15010400102] = "当目标拥有<color=#5bdf99>5</color>层“腐蚀”时，消耗所有层数以战力最高的敌人为模板孵化『古岩碎片』。『古岩碎片』免疫物理伤害，每攻击<color=#5bdf99>5</color>次会复制分裂，古岩碎片死亡时，裁决泰坦受到<color=#5bdf99>1</color>次幼龙生命值等额的伤害。",
	[15011000001] = "公正泰坦",
	[15011100101] = "审判",
	[15011100102] = "公正泰坦倾泻能量攻击敌方全体造成魔法伤害并“恐惧”目标<color=#5bdf99>2</color>秒。能量爆炸后在敌方阵营生成<color=#5bdf99>1</color>个【腐化裂隙】。\n【腐化裂隙】：每<color=#5bdf99>2</color>秒对敌方全体造成1次魔法伤害，最多存在<color=#5bdf99>3</color>个。",
	[15011300101] = "能量坍缩",
	[15011300102] = "公正泰坦对距离最远的<color=#5bdf99>2</color>个敌方女神持续造成魔法伤害和“眩晕”，并夺取目标法力。若场上存在<color=#5bdf99>2</color>个及以上的【腐化裂隙】，【能量坍缩】的目标改为敌方全体。",
	[15011400101] = "腐化低语",
	[15011400102] = "公正泰坦吸收了腐蚀的能量，魔法抗性提高<color=#5bdf99>80%</color>，当场上同时存在<color=#5bdf99>3</color>个【腐化裂隙】时，敌方全体伤害减免降低<color=#5bdf99>50%</color>，公正泰坦获得<color=#5bdf99>300</color>次伤害免疫。伤害免疫被击破时，【腐化裂隙】关闭，同时公正泰坦陷入“虚弱”状态<color=#5bdf99>8</color>秒。\n【虚弱】：受到的伤害提升50%，无法行动。",
	[15012000001] = "审判泰坦",
	[15012100101] = "时序冲击",
	[15012100102] = "审判泰坦将敌方全体牵引至身前并驱散所有增益效果，随后以吐息击退所有敌人并造成魔法伤害，清空敌方全体怒气。审判泰坦每施放<color=#5bdf99>1</color>次【时序冲击】，获得<color=#5bdf99>1</color>层“相位”。\n【相位】：急速提高<color=#5bdf99>10%</color>，最多可叠加<color=#5bdf99>5</color>层。",
	[15012300101] = "永恒宝珠",
	[15012300102] = "审判泰坦在敌方最密集区域召唤一颗时沙宝珠，宝珠落地时对范围敌人造成魔法伤害，并留下<color=#5bdf99>5</color>秒的【时之紊乱】，范围内的敌人造成伤害降低<color=#5bdf99>50%</color>，持续时间结束后爆炸对周围敌人造成魔法伤害和<color=#5bdf99>1</color>层“时滞”。\n【时滞】：急速降低<color=#5bdf99>10%</color>，持续<color=#5bdf99>10</color>秒，最多可叠加<color=#5bdf99>3</color>层。",
	[15012400101] = "永恒回廊",
	[15012400102] = "审判泰坦扭曲附近的时空：每有<color=#5bdf99>1</color>名敌人法力低于<color=#5bdf99>50%</color>，降低敌方全体<color=#5bdf99>10%</color>的法力获取效率；每有<color=#5bdf99>1</color>名敌人法力高于<color=#5bdf99>50%</color>，提高敌方全体<color=#5bdf99>10%</color>的急速。\n战斗每进行<color=#5bdf99>10</color>秒，审判泰坦传送所有近战敌人到出生点并“禁锢”<color=#5bdf99>2</color>秒。",
	[15014000001] = "海皇化身",
	[15014010101] = "千魂之暗",
	[15014010102] = "海皇化身施法准备一次毁灭性的范围攻击，在<color=#5bdf99>8</color>秒的蓄力准备后对全部敌人造成基于目标最大生命值的<混乱伤害@103605>，此技能施法无法被打断。\n技能期间，<color=#5bdf99>2</color>颗“暗影宝珠”会保护施法的进行，每颗“暗影宝珠”可抵挡<color=#5bdf99>1</color>次无法行动效果，且使海皇化身伤害减免提高<color=#5bdf99>45%</color>，“暗影宝珠”均被击破时，中断施法。",
	[15014010201] = "淹没之击",
	[15014010202] = "对1号位敌人发动攻击造成<混乱伤害@103605>，并在目标身上留下“灵魂鞭笞”效果，“灵魂鞭笞”会使目标后续受到的普攻伤害提高<color=#5bdf99>100%</color>，叠加<color=#5bdf99>3</color>层后，更换攻击2号位敌人，并以此规则循环攻击1、2号位敌人。\n若攻击的敌人非圣盾职业，不会执行更换目标行为，更换攻击目标时将移除“灵魂鞭笞”效果。",
	[15014010301] = "暗影之雨",
	[15014010302] = "对敌方全体发射暗影之雨，造成大量伤害。\n当战斗进行到<color=#5bdf99>30</color>秒后，【千魂之暗】施放后会立即施放【暗影之雨】。\n当战斗进行到<color=#5bdf99>60</color>秒后，【千魂之暗】召唤的暗影宝珠增加到<color=#5bdf99>4</color>颗。",
	[15014010401] = "狂暴",
	[15014010402] = "战斗进行到<color=#5bdf99>30</color>秒后，【千魂之暗】施放后会立即施放【暗影之雨】。\n战斗进行到<color=#5bdf99>60</color>秒后，【千魂之暗】召唤的暗影宝珠增加到<color=#5bdf99>4</color>颗。",
	[15016000001] = "耶梦加得",
	[15016100101] = "子嗣奔袭",
	[15016100102] = "耶梦加得呼唤数只<子嗣@103661>向着战场移动，场上印记数量越多，则子嗣越少，耶梦加得作为灭世的引领者，同时会开启<灭世的挑战@103662>。",
	[15016300101] = "灭世信标",
	[15016300102] = "耶梦加得张开双翅进行蓄力，并在战场中央落下一个持续<color=#5bdf99>10</color>s的<灭世信标@103663>，蓄力结束后释放<color=#5bdf99>3</color>次火焰烈波，总计对敌方全体单位造成<color=#5bdf99>990%</color>攻击力的法术伤害并造成击退效果。",
	[15016400101] = "毁灭赞歌",
	[15016400102] = "耶梦加得免疫普攻伤害，敌方每造成<color=#5bdf99>10</color>次普攻伤害，耶梦加得就会随机给<color=#5bdf99>1</color>名敌方单位<color=#5bdf99>1</color>个耶梦加得印记，战斗开始后，每隔<color=#5bdf99>10</color>s对随机<color=#5bdf99>2</color>名目标释放一团火焰风暴，每<color=#5bdf99>2</color>s对范围内单位造成<color=#5bdf99>80%</color>攻击力的法术伤害（对召唤物伤害减半），并减少其<color=#5bdf99>20%</color>攻击速度，持续<color=#5bdf99>6</color>s。",
	[15017000001] = "芬里尔",
	[15017100101] = "裂变闪电",
	[15017100102] = "芬里尔短暂蓄力之后持续引导，在敌方阵营上方召唤雷云，持续<color=#5bdf99>5</color>s，雷云会发出裂变闪电攻击目标，总共对敌方攻击最高的<color=#5bdf99>3</color>名角色造成<color=#5bdf99>500%</color>攻击的魔法伤害。\n【雷暴形态】：伤害目标改为敌方全体，消耗全部【雷霆气息】，每消耗<color=#5bdf99>1</color>层则伤害增加<color=#5bdf99>10%</color>，并恢复<color=#5bdf99>3%</color>最大生命值，每次攻击有<color=#5bdf99>50%</color>概率添加<麻痹@103664>。",
	[15017300101] = "雷霆咆哮",
	[15017300102] = "芬里尔咆哮，从自身迸发雷霆能量，驱散自身所有减益，同时提升自身<color=#5bdf99>50%</color>的攻速和<color=#5bdf99>30%</color>的暴击率，持续<color=#5bdf99>8</color>秒，成功释放技能后给自身添加<color=#5bdf99>3</color>层【雷霆气息】。",
	[15017400101] = "灭世狂狼",
	[15017400102] = "芬里尔每造成<color=#5bdf99>5</color>次伤害，就会给芬里尔叠加<color=#5bdf99>1</color>层【雷霆气息】，最多叠加<color=#5bdf99>10</color>层，芬里尔每受到<color=#5bdf99>1</color>次强控效果，就会扣除<color=#5bdf99>1</color>层【雷霆气息】。\n当【雷霆气息】层数为<color=#5bdf99>0</color>时，芬里尔受到的伤害提升<color=#5bdf99>50%</color>。\n当【雷霆气息】有<color=#5bdf99>4</color>层时，开启<雷霆形态@103665>。\n当【雷霆气息】有<color=#5bdf99>7</color>层时，开启<雷暴形态@103666>。",
	[15018000001] = "克拉肯",
	[15018100101] = "怒海波涛",
	[15018100102] = "克拉肯向前冲撞，击飞沿途所有目标，造成<color=#5bdf99>400%</color>攻击的物理伤害，并减少目标<color=#5bdf99>40%</color>的攻击速度，持续<color=#5bdf99>6</color>s，技能结束后恢复<color=#5bdf99>30</color>层<上古神铠@103671>。",
	[15018300101] = "坚不可摧",
	[15018300102] = "克拉肯发出沉闷的吼叫，随后击退周围所有目标，驱散自身减益效果，每成功驱散<color=#5bdf99>1</color>个则获得<color=#5bdf99>5</color>层<上古神铠@103671>，并减少敌方全体<color=#5bdf99>8%</color>攻击力和<color=#5bdf99>5%</color>暴击率，最高<color=#5bdf99>5</color>层，持续<color=#5bdf99>6</color>秒。",
	[15018400101] = "深海能量",
	[15018400102] = "战斗开始时，克拉肯提升<color=#5bdf99>60%</color>抗暴和<color=#5bdf99>99</color>层<上古神铠@103671>，克拉肯欢迎前来的挑战者，周期性<祝福@103672>敌方攻击最高的角色。",
	[15019000001] = "青龙",
	[15019100101] = "青龙",
	[15019100102] = "玄牛向前冲撞，击飞沿途所有目标，造成<color=#5bdf99>400%</color>攻击的物理伤害，并减少目标<color=#5bdf99>40%</color>的攻击速度，持续<color=#5bdf99>6</color>s，技能结束后恢复<color=#5bdf99>30</color>层<上古神铠@103671>。",
	[15019300101] = "坚不可摧",
	[15019300102] = "玄牛原地发出沉闷的吼叫，原地金光后，至尊天神的虚影显现，击退周围所有目标，驱散自身减益效果，每成功驱散<color=#5bdf99>1</color>个则获得<color=#5bdf99>5</color>层<上古神铠@103671>，并减少敌方全体<color=#5bdf99>8%</color>攻击力和<color=#5bdf99>5%</color>暴击率，最高<color=#5bdf99>5</color>层，持续<color=#5bdf99>6</color>秒。",
	[15019400101] = "深海能量",
	[15019400102] = "战斗开始时，玄牛提升<color=#5bdf99>40%</color>抗暴和<color=#5bdf99>99</color>层<上古神铠@103671>，玄牛欢迎前来挑战的弱者，周期性<祝福@103672>敌方攻击最高的角色。",
	[15020000001] = "饥荒骑士",
	[15020100101] = "疯狂吞噬",
	[15020100102] = "饥荒骑士以恐惧为食，选中<失智值@103688>最高的角色吞噬，并根据吞噬目标的“失智值”获得护盾，失智值越高护盾越高，数秒后吞噬结束，该角色获得<color=#5bdf99>5</color>点“失智值”并进入15秒的<混乱状态@103687>，吞噬期间打破护盾可以打断该技能，防止角色被吞噬。",
	[15020300101] = "催发疯狂",
	[15020300102] = "饥荒骑士向前铺散彩色云雾，诱发内心的疯狂，对敌方全体单位造成总计<color=#5bdf99>300%</color>攻击力的物理伤害并增加全体敌方女神<color=#5bdf99>3</color>点<失智值@103688>。",
	[15020400101] = "扭曲心灵",
	[15020400102] = "饥荒骑士不可直视，敌方全体角色每释放<color=#5bdf99>2</color>次技能都会获得<color=#5bdf99>1</color>点<失智值@103688>，获得<color=#5bdf99>1</color>次驱散效果可以清除<color=#5bdf99>2</color>点“失智值”。\n场上角色总计拥有<color=#5bdf99>10</color>点“失智值”时：饥荒骑士的所有伤害都会附带随机<color=#5bdf99>1</color>条<深层恐惧@103689>；\n场上角色总计拥有<color=#5bdf99>20</color>点“失智值”时：饥荒骑士每次造成伤害都会提高自身<color=#5bdf99>5%</color>的攻击力和攻击速度，持续<color=#5bdf99>3</color>秒，最高可叠加<color=#5bdf99>20</color>层；\n场上角色总计拥有<color=#5bdf99>35</color>点“失智值”时：自身获得<color=#5bdf99>100%</color>的伤害减免和伤害增量。",
	[15021000001] = "时间之神",
	[15021000002] = "哪怕你无惧深渊的腐化侵蚀，也千万不要大意！以【净化】为武器，共讨深渊魔女！",
	[15021100101] = "火焰狂潮",
	[15021100102] = "炎魔之王召唤火焰巨浪焚尽万物，对敌方全体造成总计<color=#5bdf99>300%</color>攻击力的魔法伤害，引爆目标身上所有的“点燃”效果并等量转化为<火种@103693>，如果有敌方角色因此死亡，炎魔之王进入<燃火状态@103694>。",
	[15021300101] = "疯焰怒击",
	[15021300102] = "炎魔之王轰击敌方全体，造成总计<color=#5bdf99>240%</color>攻击力的魔法伤害并<点燃@103695>目标<color=#5bdf99>8</color>秒，将距离最远的角色击飞至身前，随后扩散火焰，刷新敌方全体身上“点燃”效果的持续时间。",
	[15021400101] = "炎魔之体",
	[15021400102] = "炎魔之王由无数的火元素组成，有燃烧万物的能力，战斗开始后，提高<color=#5bdf99>60%</color>物理伤害减免，免疫“点燃”对自身的效果，每次<行动@100120>结束后，给周围单位添加<color=#5bdf99>2</color>个持续<color=#5bdf99>8</color>秒的<点燃@103695>效果，如果周围不存在敌方角色，则扩散为敌方全体，同时拥有<color=#5bdf99>5</color>个“点燃”效果的角色进入<自焚状态@103696>。",
	[15022000001] = "耶梦加得",
	[15022000002] = "耶梦加得那压抑千万年的怒火，将倾泻在一切入侵者身上！提高自己的【暴击抗性】以承受耶梦加得的狂怒！",
	[15022100101] = "致命攻击",
	[15022100102] = "耶梦加得对目标投射毒液发球，对目标造成伤害并使目标<中毒@103608><color=#5bdf99>5</color>秒。",
	[15022300101] = "剧毒领域",
	[15022300102] = "对场上所有处于<中毒@103608>的敌人脚下召唤毒液池，对其上的敌人每秒造成<color=#5bdf99>50%</color>攻击力的物理伤害。",
	[15022400101] = "毒液喷射",
	[15022400102] = "耶梦加得优先对未<中毒@103608>的随机女神发射，造成<color=#5bdf99>60%</color>攻击力的物理伤害，并使目标“中毒”。",
	[15402000001] = "哈迪斯",
	[15402000002] = "BOSS",
	[15402000003] = "",
	[15402000004] = "BOSS",
	[15402000015] = "黑尔坎普融合2阶段",
	[15402000016] = "",
	[15402100101] = "灭世之雷",
	[15402100102] = "召唤灭世之雷，对全场敌人造成<color=#5bdf99>3</color>段伤害。",
	[15402200101] = "混乱咆哮",
	[15402200102] = "发出咆哮攻击敌人，对敌方全体造成大量物理伤害，并持续“眩晕”。",
	[15402300101] = "湮灭",
	[15402300102] = "发射手中宝剑猛击战场，对全场敌人造成毁灭级别的伤害。",
	[17001010101] = "锻甲烈焰",
	[17001010102] = "战斗开始时，我方力量型女神攻击和防御力永久提高<color=#5bdf99>10%</color>，且每秒获得<color=#5bdf99>150%</color>队伍平均防御力的治疗，持续<color=#5bdf99>15</color>秒。",
	[17001010202] = "治疗效果结束后，进入“力量解放”状态，造成伤害时，额外造成<color=#5bdf99>20%</color>攻击力+<color=#5bdf99>20%</color>防御力的<附加伤害@103654>。",
	[17001010302] = "战斗开始时，我方力量型女神攻击和防御力永久提高<color=#5bdf99>12%</color>。",
	[17001010402] = "“力量解放”单位受到攻击时，若自身防御力高于目标，有<color=#5bdf99>20%</color>几率免疫本次伤害。",
	[17001010502] = "战斗开始时，我方力量型女神攻击和防御力永久提高<color=#5bdf99>15%</color>。",
