	[10100003881] = "小幽灵们",
	[10100003882] = "获得线索",
	[10100003883] = "既然都拿出全部实力了，我们可要好好招待一番了。你们说是吧？典韦许褚。",
	[10100003884] = "还好及时赶到，曹焱兵你可别让我失望啊。",
	[10100003885] = "*滋—嘣——*鬼符三通击败了最后一个来袭的机器人",
	[10100003886] = "这么多年了，我的计划也该继续了。",
	[10100003887] = "曹焱兵你可别让我失望啊。",
	[10100003888] = "*典韦和许褚的身影快速凝实*",
	[10100003889] = "定当击溃敌寇。",
	[10100003890] = "不过跳梁小丑。",
	[10100003891] = "走，去看看这个家伙有多少本事！",
	[10100004001] = "死亡！终将吞没你们所有人！",
