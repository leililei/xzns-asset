	[90028611801] = "屠神之剑",
	[90028611802] = "这把剑闪烁着诡异的妖光，似乎是某位人武灵诛杀神武灵时使用的武器。\n<color=#76daf8>——该藏品可使所有战斗攻击力增加</color>",
