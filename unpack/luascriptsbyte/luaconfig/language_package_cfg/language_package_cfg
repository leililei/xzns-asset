	[90000011171] = "孙策专属战印，解锁后可大幅提升孙策在本赛季中的作战表现。",
	[90000011172] = "策以亡父遗之传国玉玺为质，向术借兵数千，跨江奠江东霸王之基业。",
	[90000011173] = "但使慈侦视轻重。时独与一骑卒遇策。策从骑十三，皆韩当、宋谦、黄盖辈也。慈便前斗，正与策对。",
	[90000011174] = "购买次数将在每周一0时重置",
	[90000011175] = "战斗中，每隔12秒为敌方全体添加“虎视”。",
	[90000011176] = "施放<“呼尔来降”@121200404>时，额外“招降”战斗力最高的<color=#5bdf99>2</color>名敌人。",
	[90000011177] = "累抽次数不足",
	[90000011178] = "“天市”和“紫薇”拥有造成<color=#c95f00>【高额群体伤害】</color>的能力，且附带<color=#c95f00>【持续性伤害】</color>，使用<color=#14874a>【高伤害群攻输出】</color>角色快速击败对手或能够<color=#14874a>【驱散负面效果】</color>的辅助角色进行应对。",
	[90000011179] = "吉拉的实验造物：“圣盾”和“剃刀”在战斗中默契配合，“圣盾”在<color=#c95f00>【未处于控制状态】时</color>，会帮“剃刀”<color=#c95f00>承受大部分伤害</color>，若“圣盾”提前战败，“剃刀”将陷入危险的<color=#c95f00>【狂暴状态】</color>。\n推荐使用<color=#14874a>【高频控制】</color>型角色针对“圣盾”施加控制，并使用<color=#14874a>【强力单体输出】</color>角色快速击败“剃刀”。",
	[90000011180] = "“剃刀”在战斗中<color=#c95f00>全程免疫控制效果</color>，若“圣盾”提前战败，“剃刀”将变得极度危险。<color=#14874a>控制“圣盾”、集火“剃刀”</color>角色是最明智的选择。",
	[90000011181] = "圣盾石像在战斗中会频繁的运用<color=#c95f00>【护盾】和【伤害减免】</color>保证自己的生存。\n推荐使用能<color=#14874a>【针对护盾】</color>或造成<color=#14874a>【神圣伤害】</color>的角色。",
	[90000011182] = "圣盾石像在战斗开始时会<color=#c95f00>携带护盾入场</color>，<color=#14874a>快速击破护盾</color>后，石像将陷入<color=#14874a>虚弱状态</color>。",
	[90000011183] = "战士石像在战斗中会<color=#c95f00>不断地削弱敌人并增强自己</color>，战斗拖延到一定时间后，石像将进入<color=#c95f00>【狂暴】</color>状态。\n推荐使用能<color=#14874a>快速造成伤害的角色</color>压制石像。",
	[90000011184] = "战士石像在战斗中会<color=#c95f00>通过攻击持续削弱敌人的防御力</color>，进入<color=#c95f00>【狂暴】</color>状态后，将<color=#c95f00>全面提高自身属性</color>，在石像狂暴前<color=#14874a>尽快结束战斗</color>。",
	[90000011185] = "奥术石像在拥有<color=#c95f00>多种削弱敌人</color>的手段。\n推荐拥有<color=#14874a>【驱散负面状态】</color>的能力的角色辅助战斗。",
	[90000011186] = "奥术石像能<color=#c95f00>对敌人造成定身，击退，眩晕等控制</color>，并造成小范围伤害，使用<color=#14874a>远程输出应对控制状态的干扰</color>，并及时<color=#14874a>驱散我方的负面效果</color>。",
	[90000011187] = "辅助石像能<color=#c95f00>召唤其余职业的随机石像协助战斗</color>，还可为召唤物添加各种强化状态。\n推荐拥有<color=#14874a>【嘲讽】</color>或<color=#14874a>【魅惑】</color>能力的角色限制召唤物的行动，保护我方输出角色。",
	[90000011188] = "辅助石像能在战斗中对<color=#c95f00>召唤出的职业石像施加随机强化</color>，合理保护我方输出，<color=#14874a>避免受到强化召唤物</color>的打击。",
	[90000011189] = "迅捷石像拥有强力的大范围攻击手段，擅长以敏捷的身法<color=#c95f00>闪避攻击</color>，但本身防御较为薄弱。\n推荐拥有<color=#14874a>【命中率加成】</color>的角色对抗石像。",
	[90000011190] = "迅捷石像在战斗中<color=#c95f00>闪避攻击后，可获得叠加提高的攻击力</color>，需要在<color=#14874a>保证命中率</color>的情况下战斗，以免石像越战越强。",
	[90000011191] = "裁决泰坦擅长呼唤<color=#c95f00>【免疫物理伤害】</color>的古岩碎片协同战斗，古岩碎片可通过攻击<color=#c95f00>【自我复制】</color>。\n推荐使用<color=#14874a>【群体魔法伤害】</color>角色应对。",
	[90000011192] = "",
	[90000011193] = "公正泰坦拥有<color=#c95f00>【高额魔法抗性】</color>，擅长制造虚空裂隙来对敌人造成<color=#c95f00>【持续的全屏伤害】</color>。\n推荐使用<color=#14874a>【高伤害段数】</color>的物理女神和<color=#14874a>【群体治疗】</color>的女神应对。",
	[90000011194] = "",
	[90000011195] = "审判泰坦是操控法力和时间的高手，当敌方处于<color=#c95f00>【低法力值】</color>和<color=#c95f00>【高法力值】</color>状态下时会获得不同的效果。\n推荐使用<color=#14874a>【普攻输出队伍】</color>或<color=#14874a>【快速回蓝队伍】</color>来适应不同的阶段。",
	[90000011196] = "",
	[90000011197] = "我方施放<color=#c95f00>【绝技】</color>逸散的法力将助风王急速成长，在战斗中，<color=#14874a>【尽量克制】</color>地使用绝技或<color=#14874a>【不使用绝技】</color>，是应对风王最好的方式。",
	[90000011198] = "风王的“风暴之种”技能会在敌方施放<color=#c95f00>【绝技】</color>后获得强化，增加“风暴之种”的目标数量且大幅提高“风暴之种”的爆炸伤害。",
	[90000011199] = "雪王的身旁时刻环绕着密集的冰霜风暴，使用<color=#14874a>【高攻击频率】</color>的角色击破护体风暴后，方能造成可观的伤害。",
	[90000011200] = "雪王处于<color=#c95f00>【风暴护体】</color>状态时，拥有极高的<color=#c95f00>【伤害减免】</color>，且发动攻击时召唤的冰霜彗星数量<color=#c95f00>【大幅提高】</color>，需要<color=#14874a>尽快击破护体风暴</color>。",
	[90000011201] = "<color=#c95f00>【直面】</color>月王双眼的敌人，会快速陷入<color=#c95f00>【石化】</color>状态，月王可轻易对石化状态下的敌人造成毁灭性的打击。\n推荐使用能<color=#14874a>【驱散负面效果】</color>的角色或引动月王<color=#14874a>【转身背对】</color>我方的角色。",
	[90000011202] = "月王会周期性的对前方所有目标添加<color=#c95f00>【凝视】</color>，<color=#c95f00>【凝视】</color>层数升高便会陷入<color=#c95f00>【石化】</color>，<color=#14874a>及时驱散我方的石化状态</color>，避免受到沉重打击。",
	[90000011203] = "王国组织的入侵打破了天壁对灵域的保护，恶灵会源源不断的被裂缝<color=#c95f00>【召唤】入侵灵域</color>。\n推荐使用<color=#14874a>【远程群攻】</color>类角色抵御恶灵的入侵，擅长<color=#14874a>【恢复法力】</color>的辅助可提高进攻效率。",
	[90000011204] = "天壁防护会<color=#c95f00>【阻挡】入侵灵域</color>我方角色踏足到天壁之外，使用<color=#14874a>【远程群攻】</color>角色应对被召唤而来的恶灵。",
	[90000011205] = "羽林街三灵将各怀本领，其中应乘风化名的“太微”尤为强大，<color=#c95f00>【战斗开始】时幻化分身助战</color>，将造成极大的威胁。\n推荐使用<color=#14874a>战斗开始时能快速控制太微的角色</color>对战。",
	[90000011206] = "购买对应档位可额外获得<color=#ffee9d>VIP经验</color>",
