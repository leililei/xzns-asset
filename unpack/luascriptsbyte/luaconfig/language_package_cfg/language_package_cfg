	[10100000122] = "【测试】按钮解锁机关",
	[10100000123] = "这里究竟是什么地方？",
	[10100000124] = "姐姐，你闯进鬼门关了。",
	[10100000125] = "不过别担心，现在我们已经到了灵槐树附近。有我们在，恶灵是不敢靠近的。",
	[10100000126] = "原来，这种鬼地方也有阳光啊……",
	[10100000127] = "夏铃被巨大的灵槐树吸引，注视着神树。",
	[10100000128] = "在夏铃观察神树时，曹焱兵已将摩托车激活，发出隆隆声。",
	[10100000129] = "夏铃靠近灵槐神树，慌乱的心情顷刻间安宁了下来。",
	[10100000130] = "这是怎么回事，为什么我一靠近这棵树，内心就这样宁静呢？",
	[10100000131] = "因为它不是普通的树，而是由古神种下，拥有着不可思议力量的神树。\n它的神力通联镇魂街四方，为罗刹街罩起庇护之结界。有了它，恶灵的力量才得以抑制。",
	[10100000132] = "真了不起，它看起来多沧桑啊。",
	[10100000133] = "是啊，这棵树不知道守护了镇魂街多少年，我们家族也世世代代守护着它，你看树上挂的牌子，都刻着我们家族的人的名字。",
	[10100000134] = "笨女人，别傻愣着，上车吧。",
	[10100000135] = "上车吧。",
	[10100000136] = "这是？",
	[10100000137] = "咦？去哪里？",
	[10100000138] = "我也正奇怪，冥界和人界之间由结界分割。\n可这结界由灵域的力量凝结而成，对普通人来说，结界就像空气，是并不存在的东西，若没有法力，别说穿过它，光是感知它都绝不可能。",
	[10100000139] = "送你回去啊！难道你想一直呆在这个“鬼地方”？",
	[10100000140] = "一定是因为那个原因吧，结界对智商低于平均值的人免疫。",
	[10100000141] = "结界有这种设定吗？\n我觉得“为了隔离无情无义的人所以才有了结界”这种设定更说得通。",
	[10100000142] = "你这家伙脑子不太好使，嘴倒挺利的。",
	[10100000143] = "这是死路吗？",
	[10100000144] = "不，这是灵槐神树布下的结界，只有罗刹街的主人可以进入。",
	[10100000145] = "眼前被封锁的结界，需要以将军令验明身份才能通过，现在就要出示将军令进入安全区吗？",
	[10100000146] = "那么，请亮出你的名字吧。",
	[10100000147] = "曹焱兵发动摩托车，载着夏铃和小亮穿梭于罗刹街的街道。",
	[10100000148] = "下车吧。",
	[10100000149] = "已经到了吗？",
	[10100000150] = "不，前面的路太窄了，骑车不太方便。我们得走一段。",
	[10100000151] = "这里看起来好阴森。",
	[10100000152] = "说起来，既然你能穿越结界，就一定是寄灵人，我来教你使用法力吧。\n现在，集中精力，试着召唤出内心真正的力量。",
	[10100000153] = "为什么？",
	[10100000154] = "普通群英要从冥界回到人界，只有两种方法。",
	[10100000158] = "好，那你按我说的做，集中精力，试着召唤出内心真正的力量。",
	[10100000159] = "（试着……召唤……力量……）",
	[10100000160] = "……",
	[10100000161] = "夏铃身体四周聚起灵气",
	[10100000162] = "这条路阴森森的，让人心里发毛。我们快点离开这里吧。",
	[10100000163] = "咦，焱兵，为什么我按你说的方法，却召唤不出守护灵？是哪里出错了呢？",
	[10100000164] = "你之前在心灵空间看到的锁链，恐怕是封印守护灵的锁心链，只有法力增强到一定程度，才能解开锁心链。不过以你的资质……起码要五年吧。",
	[10100000165] = "五年？！我的青春……",
	[10100000166] = "如果让夏铃姐吃一根槐灵枝，一样可以让法力提高呀！",
	[10100000167] = "吃槐灵枝？小亮，那可是禁……",
	[10100000168] = "灵槐枝？就是这个吗？",
	[10100000169] = "夏铃将槐灵枝放进嘴里。",
	[10100000170] = "禁止事项！\n笨女人，快吐出来！",
	[10100000171] = "哇！？我已经吞下去了！怎么办……",
	[10100000172] = "夏铃闭上了眼睛。",
	[10100000173] = "心灵空间？那个人是？",
	[10100000174] = "啊……我等了上千年，终于等来这一天……",
	[10100000175] = "你、你就是我的守护灵吗？",
	[10100000176] = "嗯，在下李轩辕，愿永世追随主公。",
	[10100000177] = "这就是你的守护灵吗？",
	[10100000178] = "没错！他叫李轩辕，厉害吧！",
	[10100000179] = "你这样的笨蛋竟然有这样不凡的守护灵……算了，既然你有了守护灵，就来帮我清理镇魂街的恶灵吧，就当你吃了灵槐的补偿，没意见吧？",
	[10100000180] = "这衣服！我的衣服怎么变了！",
	[10100000181] = "这是灵衣，可以保护寄灵人的躯体免受伤害，当然只是一定程度上。总而言之，有了灵衣，你就正式成为寄灵人了。",
	[10100000182] = "要我和那些东西战斗？可是，我从来都没学过格斗什么的。",
	[10100000183] = "上了贼船别想下去了，快走吧，难道你想被消除记忆吗？",
	[10100000184] = "怎么会这样……",
	[10100000185] = "放心啦，有我和哥哥在，那些恶灵根本都碰不到我们一根毫毛。",
	[10100000186] = "可别小看寝宫设计师，和甲方斗智斗勇是基本素养。（虽然我还没毕业）",
	[10100000187] = "（唉，这两个人有完没完……）",
	[10100000188] = "嗷吼吼吼吼！！",
	[10100000189] = "啧，这条街路障可真多。",
	[10100000190] = "曹焱兵，我兄弟就是被你谋害的。今天让我碰上，一定要叫你偿命！",
	[10100000191] = "真啰嗦，你们不是早就归西了吗。",
	[10100000192] = "不知道谁来我们地盘捣乱了，啊，得快点处理完回家，肚子好饿。",
	[10100000193] = "这是！？\n地狱三头犬，怎么会来这里？",
	[10100000194] = "三头犬也好哮天犬也好，谁都别想在我的罗刹街捣乱。",
	[10100000195] = "出口被封印，无法通行。",
	[10100000196] = "冒险者大人，我粗心大意，不小心进了这咒语的笼子。拜托你帮个忙，放我出去吧！",
	[10100000197] = "太感谢你了，大人，你的大恩大德我永远也不会忘记。",
	[10100000198] = "呃啊？这就消失了？还想问问他关于邪气的事呢……\n算了，似乎就快到了，我们继续前进吧，哥哥。",
	[10100000199] = "哥哥，你感觉到了吗？有活人的气息混进来了。",
	[10100000200] = "敢闯鬼门关？走，去会会他。",
	[10100000201] = "嘶嘶嘶——吼！",
	[10100000202] = "不是吧，这时候被恶灵缠上……我们赶时间，别挡路啊。",
	[10100000203] = "哥哥，那幽灵身上好像有什么东西掉下来了……是灵言信？",
	[10100000204] = "一张灵言信正闪闪发亮。",
	[10100000205] = "这张灵言信上有群英的气息，会是什么人？",
	[10100000206] = "见到就知道了，走，他应该就是附近。",
	[10100000207] = "有细碎的呼救声从远方传来。",
	[10100000208] = "看来今天罗刹街热闹了。走，我们去看看。",
	[10100000209] = "那是什么人？",
	[10100000210] = "我也只见过他一次。听说他的法力深不可测，可宁愿四处云游也不愿做冒险者，神神秘秘的。",
	[10100000211] = "咦，卡片背后附着一封灵言信。",
	[10100000212] = "糟了，是死路……要是让那些怪物追上就完了！",
	[10100000213] = "哪里有活人的味道……",
	[10100000214] = "呵呵，找到了！",
	[10100000215] = "哇啊啊啊！这是什么！",
	[10100000216] = "活人可是增长法力的绝佳养料，决不能让你跑掉。",
	[10100000217] = "你、你不要过来啊！",
	[10100000218] = "哼哼，你是逃不掉的。",
	[10100000219] = "哇啊啊啊……救命！你不要过来啊！",
	[10100000220] = "有女声？声音好耳熟。怎么有点像我在人间打工时，撞翻我外卖的笨蛋呢。",
	[10100000221] = "什么？是普通群英？\n看来她有危险了，我们快帮她一把吧。",
	[10100000222] = "不急，那女人跑得快得很。把手放在<color=#48bce7>聚灵石像</color>上，先<color=#48bce7>治疗</color>一下吧。",
	[10100000223] = "这个机会我已经等了太久，为了重建江山，必须增强力量。",
	[10100000224] = "啊……这是……",
	[10100000225] = "哼，原来在这里。",
	[10100000226] = "哇啊啊啊！",
	[10100000227] = "你、你快走开！我的肉很难吃的！",
	[10100000228] = "放、放开……我……",
	[10100000229] = "放弃挣扎吧，群英。成为我的食物，是你的荣幸。",
	[10100000230] = "喂，你的对手在这边！",
	[10100000231] = "笨女人，都怪你，因为你的出现，恶灵都被引到我罗刹街来了。",
	[10100000232] = "诶？什么？你是……那个送外卖的！",
	[10100000233] = "我罗刹街冒险者曹焱兵，绝不允许任何恶灵在此地为非作歹！",
	[10100000234] = "哦？你就是罗刹街的冒险者？现在我心情不错，你老实交出罗刹街，我就放你一马。",
	[10100000235] = "小子，现在我心情不错，你老实交出罗刹街，我就放你一马，不然……刀枪伺候！",
	[10100000236] = "什么！恶灵居然想当冒险者？太猖狂了！",
	[10100000237] = "什么？",
	[10100000238] = "区区冒险者，竟敢阻挡本将军的计划！",
	[10100000239] = "不可饶恕！",
	[10100000240] = "但你好像搞错了，大个子。我曹焱兵绝不会让任何恶灵为非作歹！",
	[10100000241] = "看你的实力，是罗刹街的冒险者吧？现在我心情不错，你老实交出罗刹街，我就放你一马。",
	[10100000242] = "真伤脑筋啊，区区恶灵也想爬到我头上。",
	[10100000243] = "你有两下子，可区区烈焰又能奈我何？\n现身吧，蛇灵！",
	[10100000244] = "天真的家伙。许褚，震碎它！",
	[10100000245] = "我可不能这样就输掉。亘古蛇灵，成为我的力量吧！",
	[10100000246] = "小心！他与蛇灵融为一体了！",
	[10100000247] = "亘古蛇灵与我在漫长岁月中合为一体，你以一敌二，真是不自量力。",
	[10100000248] = "冒险者都是由灵域选拔的寄灵人，我的守护灵已经对你很不耐烦了——许褚!",
	[10100000249] = "好久没出来过了，许褚，出来活动活动吧。",
	[10100000250] = "守护主公，一心同体，收到命令，即刻执行。",
	[10100000251] = "守护灵？难道你、你就是……罗刹街的冒险者——曹焱兵！",
	[10100000252] = "好厉害……\n曹焱兵，你不是送外卖的吗……你到底是什么人？",
	[10100000253] = "现在不是问这种问题的时候，好好看看周围的情况啊。",
	[10100000254] = "尸蟒将军的手下迟疑地围站在四周，低声吼叫着。",
	[10100000255] = "吼吼吼吼——",
	[10100000256] = "哇啊啊啊啊，又、又来了，我们怎么办？",
	[10100000257] = "还没逃跑吗？呵呵，你们这群恶灵，有谁想和你们将军一个下场，就来试试！",
	[10100000258] = "哇，好高大的树啊……",
	[10100000259] = "这颗树叫灵槐树，是守护罗刹街的神树。树后面就是我和哥哥的家。\n因为我每天都有认真照顾，它才会长得这样好哦。",
	[10100000260] = "神树……对了，这里到底是什么地方啊？",
	[10100000261] = "连这里是什么地方都不知道，来这里干嘛啊？果然是个笨女人。",
	[10100000262] = "你这个人，别一口一个笨女人的，我也是受害者好不好！",
	[10100000263] = "你们认识吗？感觉很熟的样子嘛。",
	[10100000264] = "谁要跟这笨女人熟啊。我在人间打工的时候，这女人走路闯红灯，撞翻了我的外卖，害我被好几个客户投诉了……对了，这事还没找你算账呢。",
	[10100000265] = "跟你解释过了嘛，那时候是有人在后面推了我一下我才摔倒街上的。",
	[10100000266] = "笨蛋就是借口多。",
	[10100000267] = "这里是收容幽灵的街道，叫“罗刹街”，也就是人们常说的“冥界”啦。\n刚刚你碰上的，是邪化后的幽灵，也就是恶灵。",
	[10100000268] = "那你们也是？",
	[10100000269] = "不不不，我们是货真价实的群英。我们兄弟二人之所以住在这里，是家族的使命。",
	[10100000270] = "家族的使命？",
	[10100000271] = "我们家族拥有代代相传的寄灵人体质，所以世世代代都被任命为冒险者，镇守着这里的恶灵，要是有恶灵作怪，就除掉他们。我哥哥曹焱兵，就是现任罗刹街的冒险者。",
	[10100000272] = "小亮，不用跟这个笨女人说这些多余的话，她反正也听不懂啦。",
	[10100000273] = "原来如此，刚刚真是多谢你了，小亮。",
	[10100000274] = "救你的人是我，怎么不跟我道谢。",
	[10100000275] = "不知为什么，被你这种自以为是的人救了完全高兴不起来。",
	[10100000276] = "小亮，我看这种笨蛋还是丢回恶灵那边比较好。",
	[10100000277] = "好啦好啦……别吵了。话说回来，群英长时间呆在冥界不太好，姐姐，还是让我们送你回去吧。",
	[10100000278] = "真的吗？那真是太感谢了！我一秒钟也不想跟自大男还有恐怖的恶灵呆在一起。",
	[10100000279] = "哼，你可别再走错路了，去往大门的路上还有好多恶灵，我可不想在我的罗刹街让群英受伤。",
	[10100000280] = "我们先查看下地上的东西吧。",
	[10100000281] = "真的没问题吗，我说，不然还是……欸，你们不要走那么快，等等我啊！",
	[10100000282] = "注意看敌人方向，别闭上眼睛！",
	[10100000283] = "哇，我做到了，真的做到了！",
	[10100000284] = "我能感觉到你法力变强了，不过，还不足以召唤出守护灵。",
	[10100000285] = "还要打吗……不过，这样看来，应该可以的吧。嘿嘿，我还挺厉害的嘛！",
	[10100000286] = "喂，你们看，这条路已经被封住了。\n那里有个机关，且去试试吧。",
	[10100000287] = "我们先查看下地上的东西吧。",
	[10100000288] = "你看上去笨头笨脑的，使起法力来倒是有一套。",
	[10100000289] = "哼，想看我笑话可没那么容易！",
	[10100000290] = "总而言之，这算是好事。现在你法力充盈，差不多可以召唤守护灵了，可以召唤一次试试看。",
	[10100000291] = "哦哦哦，终于要出现了吗，我的守护灵到底是个什么样的人，好期待啊！",
	[10100000292] = "致各位寄灵人",
	[10100000293] = "哥哥，姐姐既然是寄灵人，就不用消除记忆了吧。",
	[10100000294] = "的确，前提是她能学会使用法力。\n走吧，看看她有没有这样的好运吧。",
	[10100000295] = "咦，你不是这地方的幽灵吧？找我有事？",
	[10100000296] = "想必这位就是罗刹街的冒险者曹当家。\n果然一表人才。我乃四处游荡的说书人是也，从南方游历至此，不知道大人是否能让我在此地歇歇脚？若有时间，我将把一路的见闻说与大人听，或许对你有帮助。",
	[10100000297] = "只要不是来捣乱的，罗刹街从不对外封闭。想呆就呆着吧。",
	[10100000298] = "嘻嘻，多谢。",
	[10100000299] = "说起来你们刚刚说我是寄灵人什么的是什么意思？",
	[10100000300] = "你听见了啊？\n跟我来吧，先到安全的地方，再慢慢解释。",
	[10100000301] = "曹焱兵，一直没好好感谢你，谢谢你救了我哦。",
	[10100000302] = "要感谢的话，先把上次撞坏我摩托车的费用付了吧。",
	[10100000303] = "呃，今天天气真不错！",
	[10100000304] = "这条路气氛好阴森，就这样走进去真的没问题吗？",
	[10100000305] = "你也太冲动了，曹焱兵，万一你打不过那人怎么办？",
	[10100000306] = "怎么能向他服软，打了再说。",
	[10100000307] = "怎么了？你要送我回去吗？",
	[10100000308] = "嗯，你可别发愣跟丢了。",
	[10100000309] = "小的们，给我撕碎这个不知天高地厚的群英！",
	[10100000310] = "哥哥，时间不早了，我们继续前进吧。",
	[10100000311] = "这段路恶灵真多。\n虽然罗刹街是镇魂街中恶灵出没最为频繁的街道，但最近是不是越发凶险了？",
	[10100000312] = "王国势力？最近罗刹街恶灵行动很怪，跟他们有关系么？",
	[10100000313] = "联合所有寄灵人吗……",
	[10100000314] = "忽然，一个人影从暗影重重的屋顶跳下来，挡住了他们的去路。",
	[10100000315] = "曹焱兵，出什么事了，这么急匆匆的？",
	[10100000316] = "鬼符三通？你来做什么。",
	[10100000317] = "给你的邮件显示已读未回，让我有些伤心呢，所以我想亲自来问问你，要不要加入我，一起对抗王国组织？",
	[10100000318] = "我曹焱兵一向单打独斗，对结盟之类的事情没兴趣。再说，我们很熟吗？",
	[10100000319] = "没兴趣？就算王国的人来攻打你也无所谓？",
	[10100000320] = "谁敢来罗刹街捣乱，就是跟我曹当家作对，干掉就完事了，何必加入什么组织。",
	[10100000321] = "呵呵，原来你呆在罗刹街这样的小地方就满足了。\n我还以为曹家后人有什么了不起的，没想到竟是这种没种的软蛋。失望啊，呵呵。",
	[10100000322] = "你说什么？",
	[10100000323] = "我说错了吗？总是满足于现状，再快的刀也会变钝。\n若是不服气，现在就跟我过过招，让你见识下千征百战的我，和躲在街道里的你之间的差距。",
	[10100000324] = "曹焱兵，那人看起来只是想激你啦，别中计！",
	[10100000325] = "行啊，正好手痒了，想找人练练手。",
	[10100000326] = "好极了，那就随我来，我们去宽敞的地方较量。",
	[10100000327] = "喂，说好的送我回去呢……",
	[10100000328] = "救命呀！",
	[10100000329] = "有动静！声音在右边，我们走，小亮！",
	[10100000330] = "给你的邮件显示已读未回，让我有些伤心呢，所以想亲自来问问你：要不要加入我，一起对抗王国组织？",
	[10100000331] = "没兴趣。",
	[10100000332] = "就算王国的人来攻打你也无所谓？",
	[10100000333] = "我们曹家世世代代守护罗刹街，谁敢来捣乱，老子就干掉他不就完了。",
	[10100000334] = "呵呵，呆在罗刹街这样的小地方就满足了吗？\n恐怕你不知道，王国的个中高手数不胜数，你说你能胜过他们，不过是吹牛罢了。若你真如你所说，就来和我比试比试，让我看看你的实力。",
	[10100000335] = "跟你说过了，我没兴趣。请你回去吧。",
	[10100000336] = "我还以为曹家后人有什么了不起的，没想到竟是这种没种的软蛋。失望啊，呵呵。",
	[10100000337] = "你说什么？",
	[10100000338] = "你那眼神，是要和我比试吗？",
	[10100000339] = "那人是想激你啦，别中计！",
	[10100000340] = "正好手痒了，想找人练练手。",
	[10100000341] = "好极了，那就随我来，我们去宽敞的地方较量。",
	[10100000342] = "喂，说好的送我回去呢……",
	[10100000343] = "鬼符三通朝前面边走了，他脚程好快，我们快跟上。",
	[10100000344] = "哇，那是什么……没、没有脚的人？",
	[10100000345] = "能不能别这么一惊一乍，那是幽灵，很常见的东西。",
	[10100000346] = "谁会随随便便见到幽灵啊！",
	[10100000347] = "三盏灯？是机关吗？大家当心一点。",
	[10100000348] = "呀，居然撞见群英了，真是不吉利！呸呸呸！",
	[10100000349] = "有东西落下来了——石头？嘶，好烫！",
	[10100000350] = "啊，这形状……莫非是古书上所记载的共鸣神石。",
	[10100000351] = "我也听说过，传说神石分五属，分别是风，雷，水，火，土，恰与寄灵人属性相合。若得到与自己属性相同的神石，悉心供养，增益神石之力，自己和同伴的法力也能与神石共鸣，获得增长。小亮，把它放进你包里吧。细心培养，今后它将对修炼大有裨益。",
	[10100000352] = "小亮，把它放进你包里吧。",
	[10100000353] = "嘶，好烫！得到这宝贝，不枉我们来这一趟。",
	[10100000354] = "鬼符三通的信我总觉得不太对劲。\n那个说书幽魂走南闯北，或许知道点什么，我去找他打听打听。",
	[10100000355] = "总觉得有种不好的预感。",
	[10100000356] = "你有听说过鬼符三通这个人么？",
	[10100000357] = "鬼符三通吗？那家伙是个有风骨的寄灵人，做了不少好事。\n只可惜……",
	[10100000358] = "可惜什么？",
	[10100000359] = "听说他前段时间去世了——不过我也不太清楚，只是听说而已。\n话说回来，夏铃姑娘似乎很着急的样子，大人不去看看情况吗？",
	[10100000360] = "你们俩兄弟又在嘀嘀咕咕什么呢……真是的，快走啦！",
	[10100000361] = "不过，话又说回来，这里不是罗刹街的大门吗？我能直接从这里回人界吗？",
	[10100000362] = "这道门发生了异常，暂时不能通过，我们绕个远路，东边应该还有一个出口。",
	[10100000363] = "真是的，想不到曹焱兵是这么冲动的家伙。",
	[10100000364] = "鬼符三通……他明面上来信要抵抗王国势力，但我总觉得来者不善。\n虽说哥哥冲动了些，也好趁此机会打听打听他的底细，事不宜迟，我们快跟上吧。",
	[10100000365] = "还以为他有什么大动作，也许真的想拉哥哥入伙吧。",
	[10100000366] = "如果真这么简单就好了。",
	[10100000367] = "只用了如此之短的时间便击败了对方，真不愧是哥哥。",
	[10100000368] = "哈哈，竟然能跟上我的脚步，不错。\n让我看看你的实力吧。",
	[10100000369] = "我没看错人，你资质果然不错，曹焱兵。",
	[10100000370] = "（这人很强，他战斗时到底有几分认真……看不透，他的法力似乎深不可测……）",
	[10100000371] = "我很欣赏你，要是你还想加入我们，随时可以改变主意。",
	[10100000372] = "那么，先走一步了。呵呵。",
	[10100000373] = "鬼符三通出了名的神出鬼没，今天见了，果然真是个怪人。",
	[10100000374] = "一行人继续赶路，又行过两段狭窄的巷子，罗刹街的大门出现在眼前。",
	[10100000375] = "这里就是罗刹街的出口，你顺着这条路，就可以回到群英世界了。",
	[10100000376] = "真的？太感谢你们了！",
	[10100000377] = "别再走错路了！下次可不一定这么走运了。",
	[10100000378] = "兄弟二人目送夏铃走出了冥界。",
	[10100000379] = "哥哥，最近罗刹街有些异常啊。",
	[10100000380] = "的确，今日鬼符三通来这里，笨女人又莫名其妙走入了冥界，只怕灵域发生动荡的传言不是空穴来风。",
	[10100000381] = "到底发生了什么呢？这天下……",
	[10100000382] = "我也不知道，不过，没有人能在老子的地盘撒野。我们今后要更加警惕才行。",
	[10100000383] = "嗯。",
	[10100000384] = "附近传来开锁的声音，可以从封锁的道路通行了！",
	[10100000385] = "鬼符三通让我来罗刹街找曹焱兵，现在虽然已经到了，但到底该走哪条路来着……这里简直像迷宫一样，不会又遇上恶灵吧？",
	[10100000386] = "遭到王国刺客追杀的夏铃，历经了一番惊险的逃亡，终于抵达罗刹街。",
	[10100000387] = "好多恶灵的尸体……难道刚刚发生了一场乱战？\n唔，我看我还是赶紧离开比较好。",
	[10100000388] = "附近传来一阵低鸣。",
	[10100000389] = "吼吼吼吼……",
	[10100000390] = "难道已经断气了？",
	[10100000391] = "唔……试试吧。",
	[10100000392] = "失去意识的恶灵，一动不动地躺在地上。",
	[10100000393] = "什、什么！恶灵还活着？完蛋了，没地方可以躲，我已经被它看到了……",
	[10100000394] = "不过……只有一只恶灵，而且它看上去受了重伤，硬着头皮迎击也不是没有胜算……哇！它冲过来了！",
	[10100000395] = "哈哈，真是的！原来都是纸老虎啊。\n不过我看还是快离开这里比较好……",
	[10100000396] = "这里也有……难道他们都是曹焱兵击败的恶灵？曹焱兵一定就在不远处，我得快点找到他。",
	[10100000397] = "吼吼吼吼……",
	[10100000398] = "糟了，这家伙还活着呢！我先溜了……",
	[10100000399] = "那家伙刚苏醒还很迟钝，我得赶紧离开！",
	[10100000400] = "目标夏铃出现。追捕行动，开始。",
	[10100000401] = "哇啊啊……怎么追到这来了！这下被包围了，谁来救救我啊！",
	[10100000402] = "主人，快使用法力，释放我的力量，我会助你一臂之力！",
	[10100000403] = "对了！我还有李轩辕！\n记得曹焱兵教过我怎么使用法力来着……集中注意……",
	[10100000404] = "主人，请小心，让我来驱散这些邪祟。",
	[10100000405] = "好耶，我们赢了！",
	[10100000406] = "主人，此地不宜久留，我们快离开这里吧。",
	[10100000407] = "走吧！",
	[10100000408] = "哇，有宝箱！可是……这些机械人一直走来走去。\n等等，它们看上去并没有来追击我，这是怎么回事？",
	[10100000409] = "仔细观察，这些家伙，像在扫描什么。\n难道说它只能探测到一定范围内的东西？",
	[10100000410] = "如果是这样，我只要小心行动，躲开它的巡视范围就可以了。嗯，就这样绕开它们，拿到宝箱吧！",
	[10100000411] = "两个机械人从天而降。",
	[10100000412] = "糟糕！是陷阱！",
	[10100000413] = "主人别慌，他们的移动轨迹和方才的机械人如出一辙。我们只要照先前的方法躲过敌人眼目，便可安全通过。",
	[10100000414] = "呼，刚刚真是好险！咦，又来？！",
	[10100000415] = "有三个机械人，真的没问题吗……",
	[10100000416] = "唔，不管了，一口气冲过去吧。",
	[10100000417] = "那是什么？",
	[10100000418] = "或许是遇难的商队遗落在此地的东西，打开看看吧，说不定能找到能用的东西。",
	[10100000419] = "啊，眼珠到底跑哪里去了……",
	[10100000420] = "好心人，我不小心弄丢了我的眼睛，可以请你帮我找回来吗？应该就在不远处。",
	[10100000421] = "哦，谢谢！看不见真的很不方便呀。\n好心人，你需要我这个蹩脚的奥术为你做什么吗？",
	[10100000422] = "全员的伤势得到治愈！",
	[10100000423] = "全员的攻击力得到加强！",
	[10100000424] = "哔哔——发现目标夏铃，目标李轩辕，准备执行逮捕计划。",
	[10100000425] = "逃脱了机械人的巡逻阵，来到一片空地。高空忽然传来一串刺耳的电流声。",
	[10100000426] = "滋滋……\n感应到能量源，靠近目标……50米、20米、5米……",
	[10100000427] = "此人法力与先前遇到的敌人不是一个量级，当心。",
	[10100000428] = "发现能量源。",
	[10100000429] = "N93分解激光，准备激活……",
	[10100000430] = "哇……糟糕！我们逃不掉了！",
	[10100000431] = "人脸信息检测中……",
	[10100000432] = "哔哔——信息与逮捕目标吻合，已向总部发出警报。\n三秒后激活<color=#48bce7>巨型王国刺客</color>进行逮捕。3、2、1……",
	[10100000433] = "一个燃烧着烈火的黑影从高空闪出，挡在夏铃面前，以手中的沉甸甸的金属武器挥开了机械人的射线。",
	[10100000434] = "喂，大个子，你的对手是这条街的冒险者——曹焱兵！",
	[10100000435] = "焱兵！",
	[10100000436] = "哔哔——发现冒险者曹焱兵，清除计划，开始执行。",
	[10100000437] = "呵，好啊，正愁没对手，无聊得很呢！",
	[10100000438] = "你怎么到这来了？",
	[10100000439] = "哥哥，我们先去安全的地方，再慢慢说吧。",
	[10100000440] = "夏铃姐姐，你回人界后发生了什么，能详细说说吗……",
	[10100000441] = "事情是这样的……",
	[10100000442] = "赶上了。",
	[10100000443] = "一动不动的恶灵。",
	[10100000444] = "附近有动静……小心，有埋伏！",
	[10100000445] = "不过是个木偶罢了。\n周身环绕着法力，看来有人在远程操控着他。哼，雕虫小技。",
	[10100000446] = "小亮，你的法力感应训练进行得不错嘛。\n你说得不错，捣乱的家伙的法力正从不远处源源不断地传输过来。速速打败它们，找出法力控制的源头吧。",
	[10100000447] = "三天后",
	[10100000448] = "不知道那个笨女人怎么样了，一点音讯也没有。\n罢了，别让这种事再次发生就好。我们今天的巡逻搜查仔细些吧，小亮。",
	[10100000449] = "嗯。",
	[10100000450] = "奶奶，你好像很着急的样子，丢了什么东西吗？附近有恶灵出没，还是不要离人群太远比较好哦。",
	[10100000451] = "奶奶，失语之灵已经没事了，放心吧。\n他现在应该已经回村子了吧？",
	[10100000452] = "冒险者大人，今天出来巡查时间很早啊。",
	[10100000453] = "最近罗刹街不太平，我们得搜查仔细些。\n倒是你怎么愁眉不展的？",
	[10100000454] = "唉，诚如你所说，罗刹街不太平，村子里事情也越来越多，村民们轮番来找我。\n可我分身乏术，处理不过来，要是有个帮手就好了……",
	[10100000455] = "这有何难，我们既然巡查至此，就交给我们吧。",
	[10100000456] = "事情已经都处理了，还有别的什么事吗？",
	[10100000457] = "太感谢了，你真是帮了大忙，别的琐碎之事，就不劳曹大人操心了。",
	[10100000458] = "对了，最近你有发现附近还有什么怪事吗？\n多小都行，特别是和外来人相关的。",
	[10100000459] = "唔，我回忆回忆……\n啊，想起来了，有好几个小孩子跑来说看见过蓝色的机器人。当时我没放在心上，不知与大人要找的是否有关。",
	[10100000460] = "机器人？有意思……\n多谢，村长，很有用的消息。",
	[10100000461] = "那看我们谁先打倒它吧。",
	[10100000462] = "那是谁？",
	[10100000463] = "哇！不要打我啊啊啊啊——咦，是你们？太好了，终于找到你们了！",
	[10100000464] = "夏铃？你怎么又回来了？",
	[10100000465] = "事情是这样的……",
	[10100000466] = "三天前，夏铃回到了人界，开始了正常生活。",
	[10100000467] = "你是说有奇怪的机械人在追捕你？鬼符三通说王国组织正计划驱逐所有寄灵人，该不会就是那个组织的人？",
	[10100000468] = "在别的地方怎么闹都不关我的事，但胆敢来我罗刹街捣乱，绝不能放过。\n走，我们去把王国组织的人揪出来。",
	[10100000469] = "咦，有呼救声？",
	[10100000470] = "222号就是这里吧？说要来接我，怎么一个人也没有？怎么这么多蜘蛛网？",
	[10100000471] = "只知道吵闹的小鬼，你已经没有时间迷茫了。<color=#ae6137>破坏</color>掉这些蜘蛛茧，赶紧前进吧！",
	[10100000472] = "这里蛛网密布，看上去有一只会使用蛛网的灵体侵占了这条街，还是调查一下为好。",
	[10100000473] = "原来如此，看来寄信人也凶多吉少了。\n放心，我会<color=#3db0be>破坏</color>掉这些蜘蛛茧，把入侵的恶灵揪出来。",
	[10100000474] = "谁寄来的灵言信？",
	[10100000475] = "冒险者大人",
	[10100000476] = "是化龙巷旁的幽灵寄来的。",
	[10100000477] = "走，去那边看看。\n鬼符三通，王国组织的调查就拜托你了。",
	[10100000478] = "曹焱兵将刚才发生的事情一五一十告诉了鬼符三通。",
	[10100000479] = "我知道王国组织中有个善用机械的寄灵人，或许遇到的是他的部下。",
	[10100000480] = "至于他们为什么来罗刹街，恐怕还有待调查。",
	[10100000481] = "等等，你们在自说自话些什么呢！",
	[10100000482] = "竟然落在区区群英手中……动手吧。",
	[10100000483] = "我们根本不认识你说的骗子，你不会错把我们认成别人了吧。",
	[10100000484] = "唔，有这可能……那个骗子是和我同乡的流浪汉，平时做些小偷小摸的勾当，后来谋害了个工匠，抢走他的钱，从乡里逃跑了。今日偶然遇见了他，他怕我抓他，走的时候嚷嚷着要雇人杀我，霸占我的蜘蛛。真是滑稽至极。",
	[10100000485] = "我们刚刚碰上一个自称工匠的家伙，不会就是那个骗子吧。",
	[10100000486] = "他脸上有道疤吗？",
	[10100000487] = "从眼睛到下巴，很明显。",
	[10100000488] = "那就是他了。",
	[10100000489] = "看来是想借我们的手出口气。",
	[10100000490] = "可惜没时间修理他，希望他运气好点，别再碰见我们。",
	[10100000491] = "……",
	[10100000492] = "仍有未完成之事，此路暂时无法通过。",
	[10100000493] = "还没准备好，再观察一下吧。",
	[10100000494] = "可恶，鬼符三通和寄信人都不在，没人带路的化龙巷简直就像迷宫一样……",
	[10100000495] = "这么多蜘蛛卵，要是孵化出小蜘蛛可就难办了。看我把这些玩意统统<color=#48bce7>破坏</color>掉！",
	[10100000496] = "吾的名字不重要，吾辈的使命是镇守此处的机关，冒险者大人有什么事吗？",
	[10100000497] = "多谢大人，我终于恢复了自由之身。\n我会把逆子的遗体带回去安葬，希望他来世能走上正道。这里的机关请自由使用吧。",
	[10100000498] = "远方传来火焰燃烧的声音。",
	[10100000499] = "黏糊糊的蜘蛛网。",
	[10100000500] = "看这体积可真不得了。",
	[10100000501] = "我再想想。",
	[10100000502] = "黏糊糊的，真让人不舒服。",
	[10100000503] = "简简单单。",
	[10100000504] = "蜘蛛！这就是灾祸的源头吗？\n来吧，找你们好久了！",
	[10100000505] = "蜘蛛网挡住了去路，找找有没有什么能<color=#48bce7>烧掉</color>它的东西。",
	[10100000506] = "哼，看你怎么作祟。\n咦，那边有什么声音？",
	[10100000507] = "什么人躲在这里！快给我出来！",
	[10100000508] = "救命啊！快来人……救救……我……",
	[10100000509] = "附近传来微弱的呼救声。",
	[10100000510] = "奇怪了，明明刚刚从这里传来了呼救声，怎么到这一看什么人也没有……\n可是，我分明感觉到了幽灵的气息，那人一定就在这附近。",
	[10100000511] = "仔细观察，这里的蜘蛛茧似乎在蠕动。",
	[10100000512] = "蠕动的蜘蛛茧？对了，听说蜘蛛会把猎物裹在蜘蛛网里，我干嘛不查查这些蜘蛛茧？",
	[10100000513] = "你没事吧？",
	[10100000514] = "哈呼，哈呼……终于可以呼吸了。\n啊，是你救了我！谢谢，我没事！被蜘蛛抓来关在这里，只受了点皮外伤。不过那些怪物可真吓死我了！",
	[10100000515] = "不行，我还不能走。我接到从这里发来的求助信，专程来调查蜘蛛一事。你知道其他居民都去哪了吗？",
	[10100000516] = "原来你是冒险者！那封灵言信是我用三年修为发出去的，这里的居民么……你看那边的地洞。",
	[10100000517] = "他们都被抓进那个地洞了，不知道现在是凶是吉。你可要小心呀，千万别被毒液融化掉。",
	[10100000518] = "你可要小心呀，千万别被毒液融化掉。",
	[10100000519] = "那些小蜘蛛都是大蜘蛛孵化出来了，大蜘蛛在洞穴最深处。不过真奇怪，明明这条街没有洞穴呀……",
	[10100000520] = "大家都被抓进哪个洞穴了，好可怕。",
	[10100000521] = "有问题就来找我吧。",
	[10100000522] = "哦！太好了，传送门打开了！",
	[10100000523] = "蛛网封锁了洞口，无法进入。",
	[10100000524] = "钻入洞穴，进入漆黑潮湿的地底。",
	[10100000525] = "哇，这洞底竟然这样宽广！",
	[10100000526] = "仔细一看，这两个家伙似乎已经入眠了。\n我还是不要惊动他们，找出出口快点溜走吧。",
	[10100000527] = "获得火把。",
	[10100000528] = "哼哼，这下可以把蜘蛛网烧掉了。",
	[10100000529] = "全部烧光吧！",
	[10100000530] = "进来了！看来这里就是关押居民的地方。",
	[10100000531] = "冒险者大人，快来救救我们！",
	[10100000532] = "别紧张，蜘蛛网越挣扎捆得越紧，你们呆在原地，我来烧掉这张网。",
	[10100000533] = "经过一番努力，曹玄亮救出了居民。",
	[10100000534] = "这些蜘蛛是从哪里来的？",
	[10100000535] = "我们也不知道啊，那山一样巨大的妖兽四处吐丝，孵化小蜘蛛，大家都吓破了胆，来不及调查它的来历，就被抓到这里来了。",
	[10100000536] = "巨大的妖兽？",
	[10100000537] = "嘶——嘶嘶——！！",
	[10100000538] = "啊！它又来了！快跑！",
	[10100000539] = "嘶嘶嘶——！！",
	[10100000540] = "这不是被封印的山蜘蛛吗？谁把它放出来的？\n……看来有麻烦了。",
	[10100000541] = "完成不了指令的废物，没有存在的必要。",
	[10100000542] = "太好了，这蜘蛛现在格外虚弱，只需要带回原处封印起来就没问题了。",
	[10100000543] = "一个陌生的声音突然响起。",
	[10100000544] = "看来就是这个人将山蜘蛛放出来的——你是什么人？毁坏罗刹街有什么目的？",
	[10100000545] = "目的么，你很快就会知道了，呵呵呵……",
	[10100000546] = "消失了？！",
	[10100000547] = "别追了，主公。那家伙散发出强烈的压迫感，刚才的战斗我们流失不少法力，现在不是他的对手，还是先回去和曹焱兵汇合吧。",
	[10100000548] = "关于罗刹街的异动，今天有发现什么线索吗？",
	[10100000549] = "*摇头*完全没有……要是有居民来提供一些线索就好了。",
	[10100000550] = "滴滴滴……",
	[10100000551] = "谁寄来的灵言信？",
	[10100000552] = "是化龙巷旁的幽灵寄来的，你看。",
	[10100000553] = "看来那边出事了，我过去看看。",
	[10100000554] = "最近罗刹街动荡不安，怕有人觊觎灵槐引我们离开。不如我先去探探情况，我手脚轻快，去去就回。",
	[10100000555] = "也好，寄信人会在巷口接应你，应该没问题。若是遇上危险，就发射信号通知我。",
	[10100000556] = "尊敬的冒险者大人",
	[10100000557] = "哦？有宝箱？那我就不客气啦！",
	[10100000558] = "……",
	[10100000559] = "我是罗刹街冒险者曹焱兵，在此地巡逻，查看是否有可疑之人。\n你是什么人？",
	[10100000560] = "吾的名字不重要，吾辈的使命是镇守此处的机关，冒险者大人有什么事吗？",
	[10100000561] = "听说要从主路通过，必须点燃冥焰火盆，而要点燃冥焰火盆，必须解开机关才行。\n可以拜托你通融一下，让我们过去吗？",
	[10100000562] = "吾辈的使命是守护机关，吾辈不能让你通过。",
	[10100000563] = "什么条件？",
	[10100000564] = "另一个机关也有个守护人，只有战胜他，缠绕我的咒语才会消失。\n若你愿意帮我，我就让你进去。",
	[10100000565] = "我看还是打败你比较方便。",
	[10100000566] = "不……那是我的父亲唐少平，我不想再听从他的命令，于是从宿龙帮逃出，加入幽焰帮。",
	[10100000567] = "开启那个机关就可以了吧？看上去并不复杂。",
	[10100000568] = "这是罗刹街被封印的凶兽，山蜘蛛。若没有外人解开它的符咒，它是不可能跑出来的。\n到底是谁干的……",
	[10100000569] = "谁知道呢。",
	[10100000570] = "事不宜迟，我们快走吧，哥哥。",
	[10100000571] = "可恶，刚刚的机械人都是些什么怪胎，一想到他们在罗刹街某个角落做不为人知的破坏性行为就非常不爽。",
	[10100000572] = "控制它的人或许也在罗刹街，也许就是那个叫黑尔坎普的家伙。\n我们去附近的镇上问问吧，或许能发现什么眉目。",
	[10100000573] = "呜呜……救命！快来救救本大爷！",
	[10100000574] = "又是误入机关的人吗。\n别着急，我来救你。",
	[10100000575] = "咦，冒险者大人，又见面了！\n人家说一回生，二回熟。我们也算熟人了。\n你也走这条路吗？急急忙忙地往哪去呢？",
	[10100000576] = "吓我一跳，原来是你。\n我在找一个来捣乱的家伙，你刚刚有看见什么可疑的人吗？",
	[10100000577] = "方才小的看见一个外国面孔过去了，他还领着一只长着三只头的狗。那狗的大嘴，像山洞一样大，可把我吓得够呛。",
	[10100000578] = "外国面孔，那应该是那家伙没错了。不过三头犬？难道是传说中的地狱三头犬塞伯洛斯？",
	[10100000579] = "谁知道呢。小的不敢招惹他们，躲在树丛里见他们离开了才继续赶路。",
	[10100000580] = "也许那就是我们要找的人，走，追过去看看。\n你叫什么名字？能给我们带一段路吗！",
	[10100000581] = "幽灵的名字有什么稀罕记的，带路倒是小事一桩，跟我来吧大人，我亲眼见他朝这边走了。",
	[10100000582] = "咦，得救了？是、是你们救了我吗？",
	[10100000583] = "凑近一看原来是一只狗啊。\n我们是罗刹街的冒险者，你没事吧？",
	[10100000584] = "是犬神！不是狗！\n算了，看在你们救了我的份上这次就不计较了。我们犬神一族知恩图报，请让我把刚刚发现的藏宝点告诉你们作为回报吧，快跟我来！",
	[10100000585] = "没想到这么快又见面了。\n我在人界调查时发现行刺夏铃的机械人，不过怎么也找不到控制源。",
	[10100000586] = "不过我追着线索来到这里，却发现了妖灵的踪迹，那恐怕是独属于地狱的猛兽，你可得小心啊。",
	[10100000587] = "没办法，只能战斗了。",
	[10100000588] = "你来啦？这里每根火柱下面都埋着一个宝箱。去点燃它吧，愚蠢的群英！嘿嘿嘿嘿……",
	[10100000589] = "呵呵呵，是财宝！快点燃第三盏灯吧！",
	[10100000590] = "哦！我的推测果然没错，就是这里，大丰收！",
	[10100000591] = "吼吼吼！",
	[10100000592] = "这、这是？陷阱！",
	[10100000593] = "噗噗！傻瓜！老爷我老早就知道这里机关里藏着陷阱，才带你们来当试验品的！现在宝藏是我的了！",
	[10100000594] = "犬神趁大家都发愣时卷走了大部分财宝，一溜烟地跑了。",
	[10100000595] = "可恶！这只臭狗……再碰上绝不饶了它！",
	[10100000596] = "没时间管那小毛头了，我们快去镇上吧。",
	[10100000597] = "到了。\n想不到这里居然有英武结界。小亮，把手放上石像打开结界吧，小镇就在结界后面。",
	[10100000598] = "这里除了一块石碑，什么也没有呀。",
	[10100000599] = "那是防止恶灵入内的英武结界，解开它就能进入小镇了。",
	[10100000600] = "石像已经挪开了，我们走吧。",
	[10100000601] = "这些钱给我吗？真是太感谢你了……孩子们冬天不用担心挨饿了。",
	[10100000602] = "小意思，本大爷四处搜寻宝藏，可不是为了我一个人！\n你快回家吧。",
	[10100000603] = "就在这里打听打听吧。",
	[10100000604] = "哇哇哇！是那个冒险者！哼，最讨厌这些灵域的走狗了。该怎么捉弄一下他们呢……我记得北边有两个帮派在打架来着……有了！",
	[10100000605] = "右卫门变身成穷苦人的模样。",
	[10100000606] = "你问外国面孔的人吗？那家伙拿了我的钱就跑了，往北边走了，也许还没走远。",
	[10100000607] = "哦？走，我们去看看。",
	[10100000608] = "嗯！（奇怪，这人身上怎么一股狗的味道……）",
	[10100000609] = "冒险者大人，有群山霸王突然闯进我家，把家里洗劫一空。爸爸也被他们抓走了，说要抓他回去做仆人，呜呜呜……求求你去救救我父亲！",
	[10100000610] = "我明白了。\n在这呆着别动，我马上去救你爸爸回来。",
	[10100000611] = "呜呜呜呜……爸爸……",
	[10100000612] = "怎么了，你怎么哭得这么伤心？",
	[10100000613] = "好啦，这件事解决本大爷就安心啦！",
	[10100000614] = "那么带我们去找地与三头犬吧。",
	[10100000615] = "你来啦，曹大人。真高兴还能见到你。",
	[10100000616] = "说起来，有一个可疑的人带着机械人往灵槐树那边去了，我觉得不太对劲，还是告诉大人你一声比较好。",
	[10100000617] = "哦？我们去看看。",
	[10100000618] = "刚才那声巨响真吓人啊……灵槐树若是被毁，罗刹街也将沦为恶灵横行之地。\n看来我得再另寻一处安稳之地了。",
	[10100000619] = "你问我那些可疑的家伙往哪里去了吗？\n在东边，刚走不远，大人现在去追，一定能赶上。",
	[10100000620] = "怎么啦？",
	[10100000621] = "点击顺序错误，可以向犬神询问正确顺序。",
	[10100000622] = "这种宝藏机关虽然随处可见，可要想找到好东西，可要费一番功夫。\n不过这难不倒我宝藏迅捷，不论多难找的宝藏，我都一定能找到！",
	[10100000623] = "注意要按规定的顺序开启才行哦！顺序是一三二，千万别搞错了。",
	[10100000624] = "转了一圈没有发现什么妖灵，倒遇上过一只讨厌的狗。对了，你有见过一只自称犬神的穿衣服的狗吗？",
	[10100000625] = "没有遇上这样的骗子，不过，倒发现一个大家伙。\n先前跟你说的猛兽，或许就是关押在冥河旁的地与三头犬。",
	[10100000626] = "地狱三头犬？冥河离这那么远，那家伙是怎么跑到这来的？",
	[10100000627] = "想必是有人解开了它的镇兽锁，带它来的。\n不过，虽然我能感知他的气息，却怎么也找不到它在什么位置，或许有人用法力将它隐藏起来了。要找到它可不容易。",
	[10100000628] = "怎么回事……这里聚集了这么多人。",
	[10100000629] = "偷了东西别不承认，今天你必须把神珠给我们还回来！",
	[10100000630] = "我们岩渊派行事光明，从不做这等龌龊事。我看你们是想加罪于我们，好夺走你们垂涎已久的法力秘技，我没说错吧？",
	[10100000631] = "怎么办，我们帮哪边？",
	[10100000632] = "唔……",
	[10100000633] = "炎龙派别欺人太甚了，凭空诬蔑清白之人，不太好吧。",
	[10100000634] = "你是谁？我们帮派的事情，哪轮得到一个外人说话。给我拿下这个家伙！",
	[10100000635] = "哈？我什么都没说啊？",
	[10100000636] = "做这种偷鸡摸狗之事，岩渊派的做法惹人耻笑。",
	[10100000637] = "你是谁？我们帮派的事情，哪轮得到一个外人说话。给我拿下这个家伙！",
	[10100000638] = "哈？我什么都没说啊？",
	[10100000639] = "*模仿曹焱兵的声音*一群宵小，胆敢在我的地盘撒野斗殴，活得不耐烦了！",
	[10100000640] = "什么？给我拿下这个家伙！",
	[10100000641] = "哈？我什么都没说啊？",
	[10100000642] = "可恶，莫名其妙跟人打了一场。我们快离开这个是非之地吧。",
	[10100000643] = "唔，把他骗来此处，本想让这些帮派好好教训教训他，没想到这家伙身手还不错，倒让他逞了一回女神……\n对了，我记得东边有一只被结界藏起来的地狱三头犬。我得想个办法把这冒险者引到那里去。",
	[10100000644] = "喂，你这家伙，那是条被封锁的路，只有两个帮派在争斗，住在这附近你不可能不知道这回事吧？\n你骗我去那边干嘛？",
	[10100000645] = "啊？大人你在说什么？小的完全不知道啊……小的、小的今天是第一次遇见过大人啊……",
	[10100000646] = "哥哥，我想应该不是他干的。\n刚才这人身上有浓重的狗味，现在却消失了。也许是先前那只犬妖变成他的样子来捉弄我们。",
	[10100000647] = "我们明明救了他，他为什么要对我们做这种事？真是不明白。",
	[10100000648] = "曹大人，好久不见。\n你有急事要赶路吗？最好不要从这里走哦，那边是山霸王的老巢。",
	[10100000649] = "那山霸王抓了镇里的人，我正想去找他们呢。",
	[10100000650] = "原来如此，曹大人果然是正义之士。我这里还有一株“灵草”，或许之后对你有大用，请你收下吧。",
	[10100000651] = "小少爷要出生了，府上人手不够，快把它带回去，去后厨打扫卫生！",
	[10100000652] = "喂，你们的对手在这边！",
	[10100000653] = "谢谢大人出手相救……",
	[10100000654] = "你的儿子还在镇上等你呢，快回去吧。",
	[10100000655] = "两人说话时，一个假装晕厥的山霸王突然起身，抓起涂满“散魂毒”的箭朝曹焱兵刺来。",
	[10100000656] = "啊呀呀呀呀！",
	[10100000657] = "千钧一发之际，一个熟悉的身影从天而降，压垮了心怀不轨的山霸王。\n曹焱兵定睛，发现他认得这家伙。",
	[10100000658] = "是你这只臭狗！",
	[10100000659] = "正是本大爷！没想到吧？",
	[10100000660] = "果然是你。你几次三番害我们，现在又救了我们，到底想做什么。",
	[10100000661] = "不不不，本大爷可不是想害你，只是想对嚣张跋扈的灵域走狗略施惩罚罢了。不过一视同仁看待神姬的人，就是我的朋友！有什么需要帮忙的地方请尽管说！",
	[10100000662] = "原来如此。你有苦衷，我能理解。不过一码归一码，你害我们两次陷入危险，这事可不能算了。",
	[10100000663] = "唔唔……我……我知道啦！\n刚才听说你们在找地狱三头犬？那家伙被法力藏起来了，一般幽灵察觉不到它的气息。本大爷知道他的位置，就由我冒风险给你们带路吧！",
	[10100000664] = "好，要是再骗人，我可饶不了你！",
	[10100000665] = "赌上我爷爷的名声，绝对不会再骗你啦！",
	[10100000666] = "爸爸没事真是太好啦！\n曹大人，谢谢你，这些微薄的谢礼请你收下。",
	[10100000667] = "鬼符三通，这家伙知道三头犬的位置，你要跟我们一起去吗？",
	[10100000668] = "哦？那太好了。不过关于幕后操纵者，我掌握了一些新的线索要调查，三头犬就交给你了，冒险者。",
	[10100000669] = "嗷吼吼吼！",
	[10100000670] = "小亮，看它的胳膊，有和机器人一样的标志！",
	[10100000671] = "好啦，本大爷要溜了！\n本大爷喜欢四处游历收集财宝，要是有好东西，以后就便宜卖给你吧！",
	[10100000672] = "咕噜咕噜……啊！别靠近我的财宝袋！",
	[10100000673] = "我们也快走吧，哥哥，不快点找到那个黑尔坎普，不知道他还会做出什么事。",
	[10100000674] = "我感觉鬼符三通的气息靠近了，我们去问问他有什么发现吧。",
	[10100000675] = "小亮的感知可真灵敏……",
	[10100000676] = "太精彩了，曹大人。\n在转世前能目睹这样一战，也不枉我被那破笼子关了七天之久了。那我就此告辞了，下辈子再见！",
	[10100000677] = "轰隆隆……从灵槐树附近发出一阵喧哗。",
	[10100000678] = "是从灵槐附近传来的。",
	[10100000679] = "结界光芒闪烁，是灵气不足所致……糟了，灵槐树不会有危险了吧！",
	[10100000680] = "可恶，竟然趁我不在的时候……走，赶紧回家。",
	[10100000681] = "这是……",
	[10100000682] = "哦，曹当家，又见面了。我看见三头犬的遗体，是你干的吧？",
	[10100000683] = "这里是什么情况，这些恶灵冒犯你了？",
	[10100000684] = "不，我只是循着足迹和邪气一路调查来到此地，就看到了这番景象。",
	[10100000685] = "*摇头* 暂时还没有眉目。",
	[10100000686] = "这些恶灵胸前的标记，看来是尸蟒将军的部下。",
	[10100000687] = "的确。那家伙是遇上什么强敌了吗？",
	[10100000688] = "我猜是两方势力在此地争夺，才会留下这样的惨状。\n我们顺着足迹往前看看吧。",
	[10100000689] = "呕，恶灵的味道好恶心……",
	[10100000690] = "没事吧主公？快服下这颗药稳定心神。",
	[10100000691] = "谁下手这么狠……哥哥，我们调查一下这些遗体，或许有什么发现。",
	[10100000692] = "怎么样哥哥，有什么发现？",
	[10100000693] = "有牙齿的痕迹……",
	[10100000694] = "不错，这具遗体的肢体和腹部被严重中伤，不像兵器所为，倒像是猛兽啃食过的痕迹。",
	[10100000695] = "再调查下附近吧。",
	[10100000696] = "怎么样？有什么发现？",
	[10100000697] = "他身上怎么有中毒的迹象……",
	[10100000698] = "嗯，这个恶灵没有外伤，脖子附近却严重发紫，是中毒的征兆。",
	[10100000699] = "再调查下附近吧。",
	[10100000700] = "这个恶灵已经不成形了……看不出什么眉目。",
	[10100000701] = "这些恶灵看上去是被巨物挤压而亡的。",
	[10100000702] = "的确，连骨头也破碎断裂，像是被巨物碾压过去的样子，真惨烈呀。既然是两方势力争斗，想必现在他们已各奔东西。曹当家，我们分头调查，你在附近调查，我往北边稍远的地方走走。一刻钟后见。",
	[10100000703] = "看来有不少兵卒从这里路过。",
	[10100000704] = "小心！是恐狼！",
	[10100000705] = "恶灵身上的齿痕应该是他们所为吧？",
	[10100000706] = "看来是了，不过这些狼面目狰狞，狂躁不安，有些异乎寻常……究竟是怎么回事？",
	[10100000707] = "这是……毒液？",
	[10100000708] = "主公小心，谨防地上的毒液。",
	[10100000709] = "毒液……颜色倒与恶灵身上残留的毒液吻合。",
	[10100000710] = "罗刹街出现这么多蜘蛛和恐狼，也太奇怪了。谁把这些东西带来的……",
	[10100000711] = "有人？这是什么怪物……",
	[10100000712] = "这位是……？",
	[10100000713] = "我是罗刹街冒险者曹焱兵是也，敢问阁下是？",
	[10100000714] = "啊，原来是曹当家！\n我是墨鳞街冒险者苏靖齐。惊扰了你们，实在抱歉。现在我正等我兄弟来一起羁押他们回墨鳞街，曹当家不会阻拦吧？",
	[10100000715] = "哪里，既是墨鳞街的凶兽，你们羁押回去便是。只是被封印在地牢，如何逃出的？还有，你说它不能自已是怎么回事？",
	[10100000716] = "目前看来，恐怕是有人故意释放了巨兽，并从远程操控。这些山巨人面目痛苦不堪，不像是自己意愿所为。",
	[10100000717] = "唔，之前遇见的恐狼也有类似的特征。",
	[10100000718] = "没错，可是究竟是谁做的呢？\n哥哥，不如去信询问刘羽禅，他或许知道什么。",
	[10100000719] = "是个办法，那家伙消息灵通，或许听说过什么。小亮，给他写一封灵言信吧。",
	[10100000720] = "嗯。",
	[10100000721] = "我倒觉得这些事件有相似之处，不如我们去信询问刘羽禅吧，他或许知道什么。",
	[10100000722] = "是个办法，那家伙消息灵通，或许听说过什么。小亮，给他写一封灵言信吧。",
	[10100000723] = "嗯。",
	[10100000724] = "地上好像有些痕迹，像是有东西在这里拖动的样子。",
	[10100000725] = "你们看，这里有些破碎的脚印，或许有人负伤路过，拖着受伤的身体留下了足迹。",
	[10100000726] = "去调查下其他地方吧。",
	[10100000727] = "这十几米都能看见脚印拖行的痕迹，但到了这里，足迹却凭空消失了，这是怎么回事？",
	[10100000728] = "有人刻意隐瞒行踪。我们继续往前，看能发现些什么。",
	[10100000729] = "去调查下其他地方吧。",
	[10100000730] = "这里也有，足迹中途断掉了。不过我们可以跟着行走趋势往前看看。",
	[10100000731] = "总觉得怪怪的。这些足迹像故意被抹去似的……",
	[10100000732] = "鬼符三通怎么还没到，早就过了约定的时间了。",
	[10100000733] = "或许被什么事绊住了。不用等他，我们先走吧。",
	[10100000734] = "曹大人……请你救救将军大人……",
	[10100000735] = "他胸前的标记，应该是尸蟒将军的部下吧。",
	[10100000736] = "是的，我拼命逃到这里，就是听说你在附近……将军大人就在前面，请你……救救他……",
	[10100000737] = "他受伤好严重，看来尸蟒将军这回遇到劲敌了。",
	[10100000738] = "别管我！你们快跑！我的身体已经被控制了！这样下去你们都会完蛋的。",
	[10100000739] = "将军大人！",
	[10100000740] = "主公当心！那家伙的行动似乎失控了！",
	[10100000741] = "曹当家，没想到会再见到你，多谢你，我才能摆脱那人的控制，咳咳……",
	[10100000742] = "谁在操控你做这种事？",
	[10100000743] = "有个叫黑尔坎普的，想招揽我做他的部下，可天下怎能交给这样的家伙。我回绝了他。没想到，他立刻发动法力，令我行动全为他所控制，打伤了不少我招来的弟兄……要是下次再见到他，我一定……",
	[10100000744] = "他们的灵气全然消失了……",
	[10100000745] = "想不到这家伙也是个有仁心的，我们就在此地给他立个碑吧。",
	[10100000746] = "曹焱兵埋葬了尸蟒将军和众恶灵。",
	[10100000747] = "主公，这边的树丛掩盖着路面，里面有条暗道，怕不是有埋伏，我们从这里绕过去看看。",
	[10100000748] = "走。",
	[10100000749] = "这么多宝藏……恐怕都是尸蟒将军为了征兵收集的财宝。",
	[10100000750] = "有不少好东西呢。",
	[10100000751] = "滴滴滴……",
	[10100000752] = "刘羽禅回信了。",
	[10100000753] = "焱兵：",
	[10100000754] = "王国的黑尔坎普么……记得先前奇怪的机械人也有被法力操控的迹象。",
	[10100000755] = "鬼符三通猜错了，他以为有两帮人在罗刹街，实际上只有一个，那就是黑尔坎普。\n他在罗刹街制造混乱，应该是为了声东击西，避人耳目。",
	[10100000756] = "这个黑尔坎普或许并非厉害的角色。",
	[10100000757] = "为什么这样说？",
	[10100000758] = "弱者喜欢隐藏自己，让别人当挡箭牌。\n他四处混淆视听，想必对自己实力有所顾虑，才这样谨慎行事。",
	[10100000759] = "哈哈哈哈！说我谨慎行事？可笑可笑！",
	[10100000760] = "声音从那边传来的！",
	[10100000761] = "曹当家的，终于见面了。呵呵，没想到你能来到这里，有点实力，不过也到此为止了。我是第一个到罗刹街的人，神树之中的羲和神珠已是我囊中之物了。",
	[10100000762] = "羲和神珠？",
	[10100000763] = "小的们，给我上，别让这些杂碎影响我的大事。",
	[10100000764] = "可恶，溜得比泥鳅还快。我们快跟上！",
	[10100000765] = "曹大人，听说你救了尸蟒将军大人，多谢你了。",
	[10100000766] = "黑尔坎普往哪去了，你有看见吗？",
	[10100000767] = "他往东边去了。",
	[10100000768] = "站住，别想逃！",
	[10100000769] = "真碍事。",
	[10100000770] = "可恶，这家伙有两把刷子。这样下去别说拿到羲和神珠去和老大邀功，连小命都保不住……我得走一步，待我融合后再来找他算账。",
	[10100000771] = "我得走一步，等等再来找他算账。",
	[10100000772] = "黑尔坎普嘴里念念有词，通过传送门消失了。",
	[10100000773] = "又让那家伙溜了。",
	[10100000774] = "可是他的气息还留在罗刹街，他一定还在不远的地方。",
	[10100000775] = "对了，他刚才说要拿神珠什么的，罗刹街的神珠你藏在哪里的，曹焱兵？",
	[10100000776] = "我从来不知道罗刹街还有什么神珠啊，或许有什么秘密，连我也不知道……但我绝不允许他破坏灵槐神树。",
	[10100000777] = "神珠的事情暂且不论，刚才他离开时，嘴里念念有词，我没记错的话，那是他与守护灵融合的咒语，若是他融合成功就麻烦了。我觉得我们还是尽快把他找出来比较好。",
	[10100000778] = "有人？",
	[10100000779] = "终于见面了，曹焱兵，看来不得不与你一战了。",
	[10100000780] = "你是谁？",
	[10100000781] = "是他！先前搞乱罗刹街的人！",
	[10100000782] = "我是王国直属执行官，第九骑士，黑尔坎普。",
	[10100000783] = "*心理* 好可怕的家伙……他费这么多功夫硬闯罗刹街，难道他想从这里得到什么吗？",
	[10100000784] = "不管你目的是什么，我决不允许任何人破坏罗刹街。不离开罗刹街，就别怪我不客气。",
	[10100000785] = "哼，虚张声势！",
	[10100000786] = "就这点能耐，也想和我同台较量？看招！",
	[10100000787] = "黑尔坎普以极快的速度冲上高空，向下俯冲，在他脚下，法力积蓄到了顶点，一旦爆发，力量足以令人粉身碎骨。",
	[10100000788] = "焱兵当心！他是冲你来的！",
	[10100000789] = "十殿阎罗的地狱之焰，火势如山崩，你再快也快不过它。",
	[10100000790] = "*喃喃* 可恶……大意了……",
	[10100000791] = "*喃喃*我需要一点时间，用法力将地狱之火熄灭……",
	[10100000792] = "他逃跑了！不过，我能感觉到他的气息，正向北边山坡上移动。",
	[10100000793] = "跟上他！",
	[10100000794] = "这么快就跟来了吗？不能让那家伙先出招！",
	[10100000795] = "当心，有东西从天上落下来了！",
	[10100000796] = "这些家伙真难缠，我得想办法摆脱他们……",
	[10100000797] = "这么快就追上来了？地狱三头犬，给、给我咬碎他们！",
	[10100000798] = "这就是他的守护灵？竟是这样强大的家伙！",
	[10100000799] = "又逃跑了？",
	[10100000800] = "看来他的招式已经用尽了，我们快追。",
	[10100000801] = "可恶……你们给我等着……",
	[10100000802] = "走开！挡路的家伙！",
	[10100000803] = "这种程度可不是吓不倒我。",
	[10100000804] = "地狱三头犬的力量似乎被削弱了！",
	[10100000805] = "太好了！我们一鼓作气把它拿下吧！",
	[10100000806] = "三头犬负伤逃跑了，想必会去与黑尔坎普汇合。\n跟上它！是时候找那家伙算账了。",
	[10100000807] = "消失了？那个扭曲的螺旋是？",
	[10100000808] = "是融合灵体逗留的空间，他就在里面。\n走，去会会那个大家伙。",
	[10100000809] = "到此为止吧，你已经走投无路了。",
	[10100000810] = "还没完呢，曹焱兵，战斗才刚刚开始。",
	[10100000811] = "竟然把我的爱犬伤成这样……你们给我等着！",
	[10100000812] = "小心！他要发起攻击了！",
	[10100000813] = "闯进来的会是什么样的人呢？",
	[10100000814] = "真想快点离开这里……",
	[10100000815] = "鬼符三通究竟是什么人啊？",
	[10100000816] = "去吧，我不能逗留太久。祝你好运，小鬼。",
	[10100000817] = "好险，还以为又要被恶灵抓住了呢。\n那些想抓我的人到底是些什么家伙啊……",
	[10100000818] = "呜呜呜……救命啊……有人救救我吗？",
	[10100000819] = "呵呵呵，神树已经完了，神珠尽在掌握。\n拿到了神珠，功劳就全是我的了。",
	[10100000820] = "有胆量就来跟我搏一搏吧，为了神珠，我不会手下留情的。",
	[10100000821] = "传说很久以前有位神仙云游至此，落户为民。那些善良的幽灵们都受到他的庇护。",
	[10100000822] = "有什么事吗？",
	[10100000823] = "我本楚地人，师父去世后，便变卖家当，四处云游。若有什么想知道的，尽管来问我好了。",
	[10100000824] = "传说很久以前有位神仙云游至此，落户为民。那些善良的幽灵们都受到他的庇护。只是万物皆有枯荣，神仙也有寿终的一天。他归西后化为一颗菩提树，世世代代保护着咱们。",
	[10100000825] = "我能用小石子打20个水漂，厉害吧！",
	[10100000826] = "说是被咒语的森林，仔细一看风景还蛮不错的嘛。",
	[10100000827] = "总觉得还是快点到达芦花古楼才安心……哥哥也有同感吧？",
	[10100000828] = "干嘛盯着本大爷？难不成是馋本大爷包里的宝贝？",
	[10100000829] = "姐姐，总有一天我会救你出来的……",
	[10100000830] = "那边有宝箱诶！不去看看吗？",
	[10100000831] = "那边有个老婆婆看样子很着急，去看看怎么回事？",
	[10100000832] = "前面的路被封住了，你们看那边有个机关，要不去试试吧?",
	[10100000833] = "前面有个人，看起来是在等我们的样子要不过去看看？",
	[10100000834] = "这里有个机关，跟共鸣神石好像有关系，看来我们得破解了才行",
	[10100000835] = "前面那个幽灵好像是村里的人吧，要不上前问问情况？",
	[10100000836] = "那边三个村民好像有话要说，要不去听听完成他们的请求吧",
	[10100000837] = "旁边有个鬼鬼祟祟的游魂去看看她在做什么",
	[10100000838] = "那边好像有个人被关住了，应该就是之前提到过的那个人，凑过去看看怎么回事",
	[10100000839] = "鬼符三通就在前面，去找他谈谈吧",
	[10100000840] = "鬼符三通好像有话要说，我们过去吧",
	[10100000841] = "鬼符三通带我们来这里究竟想干什么，一定要问个明白",
	[10100000842] = "这里曾经发生过什么，有几个恶灵倒在地上，去看看怎么回事",
	[10100000843] = "地面好像有什么痕迹调查一下吧",
	[10100000844] = "鬼符三通就在那，我们过去问问他该怎么办吧",
	[10100000845] = "鬼符三通就在那，我们过去问问他该怎么办吧",
	[10100000846] = "鬼符三通就在那，我们过去问问他该怎么办吧",
	[10100000847] = "鬼符三通就在那，我们过去问问他该怎么办吧",
	[10100000848] = "聚灵石像的光芒消失了。",
	[10100000849] = "焱兵，看在长路漫漫的份上，能问你个问题吗？",
	[10100000850] = "你想说什么？",
	[10100000851] = "我们为什么要用走的，不能开车去？",
	[10100000852] = "我不会开车。",
	[10100000853] = "可是我会呀！",
	[10100000854] = "哦，那你倒是找一辆车来。",
	[10100000855] = "……",
	[10100000856] = "你们听，附近好像有人的声音，我们好像走到某个村子里来了。\n我们走去前面看看。",
	[10100000857] = "真美……",
	[10100000858] = "镇魂街里竟然会有这么宁静的村子……",
	[10100000859] = "既然有村子，我们快去问问村民能不能在这里留宿吧。我的脚快到极限了……",
	[10100000860] = "要在这里歇息？\n可是可以，不过你们来得不巧，我们村有两个小孩跑丢了，大家都在找人，怕是没人有空招待你们。",
	[10100000861] = "有孩子走丢了？",
	[10100000862] = "喂，阿福，原来你在这！还不赶紧来帮忙找人，愣着干嘛呢！",
	[10100000863] = "诶，来了来了。",
	[10100000864] = "焱兵，我们也帮他们找找那两个孩子吧，要是跑出去碰上恶灵就麻烦了。",
	[10100000865] = "这些村民聚在这荒郊九界做什么？",
	[10100000866] = "哇啊，没想到那么平静的村子附近居然真的有恶灵……曹焱兵，我们得快点找到那两个孩子，不然他们就危险了！",
	[10100000867] = "迷路了吗？明镜村往右边走。",
	[10100000868] = "唔，看起来像是需要触发什么机关才能打开的样子。\n先走另一条路，说不定有什么线索。",
	[10100000869] = "我说，走了这么远，还没看到那两个孩子的踪迹，他们真的是往这边走的吗？",
	[10100000870] = "别过来！我不会让你伤害狗儿的！",
	[10100000871] = "有人在那边！",
	[10100000872] = "我记得右边的石碑上记载着解开机关颜色顺序提示的谜语，快去看看吧。",
	[10100000873] = "找到了！",
	[10100000874] = "走吧，村子就在前面，门司令见到你们，一定会很高兴的。",
	[10100000875] = "曹焱兵一行人送白水儿和狗儿回到明镜村外。",
	[10100000876] = "怎么样，曹焱兵，我的守护灵这么厉害，你对我不会再有什么质疑了吧？",
	[10100000877] = "我从来没质疑过你的守护灵，我担心的是你自身的实力。",
	[10100000878] = "哼。",
	[10100000879] = "守护灵？你们是冒险者？",
	[10100000880] = "听明镜村的人说你走丢了，我们来帮忙找找。走，跟我们回去吧。",
	[10100000881] = "太好了！冒险者大人，求求你们帮帮我，救救狗儿吧！",
	[10100000882] = "狗儿？",
	[10100000883] = "村里的人说走丢了两个小孩，狗儿应该就是另一个吧。",
	[10100000884] = "事不宜迟，有恶灵出没，那孩子不知道怎么样了。\n白水儿，你知道另一个小孩去哪了吗？",
	[10100000885] = "我想狗儿一定躲进我们经常去玩的那个密道了！\n这里有个机关，只有打开机关才能进入密道。",
	[10100000886] = "倒在地上的就是狗儿吗？",
	[10100000887] = "可恶，连小孩子都不放过……",
	[10100000888] = "咳咳咳……",
	[10100000889] = "狗儿，你没事吧？\n怎么办，他好像失去意识了。",
	[10100000890] = "气息很微弱，不知道能不能坚持到村子。",
	[10100000891] = "总之，我先把法力注入他的身体吧，应该能让他多坚持一段时间。",
	[10100000892] = "几个小时后",
	[10100000893] = "婆婆，狗儿怎么样了？",
	[10100000894] = "放心，狗儿已经没有危险了。多亏了冒险者大人为他注入法力疗伤，他才恢复得这么快。",
	[10100000895] = "太好了……\n冒险者大人，真不知道怎么感谢你们才好。没想到在荒郊九界遇到冒险者大人，真是太幸运了。",
	[10100000896] = "对了，这里周边这么荒芜，恶灵出没频繁，你们村子怎么会这么安宁啊？",
	[10100000897] = "我们村子能这样安宁，是因为有玉菩提的保佑。",
	[10100000898] = "玉菩提？！",
	[10100000899] = "怎么，有什么来历吗？",
	[10100000900] = "传说很久以前有位神仙云游至此，落户为民。那些善良的幽灵们都受到他的庇护。只是万物皆有枯荣，神仙也有寿终的一天。他归西后化为一颗菩提树，世世代代保护着咱们。",
	[10100000901] = "玉菩提和羲和神珠一样，具有划分空间的能力，只是范围比较小。\n这正是恶灵无法进入的原因。",
	[10100000902] = "嗯，我们不仅有玉菩提，还有门大人保护着我们。",
	[10100000903] = "你是说羽林街的门司令？",
	[10100000904] = "那是以前啦！门大人为了大家可以过安居乐业的日子，主动放弃了司令的职位，带大家在这福佑之地建立了村子。",
	[10100000905] = "我曾听闻过灵甲军头子果断敢为的传闻，却不知道他有这等悲悯之心。\n真想亲眼见见他。",
	[10100000906] = "这时，不远处传来一阵脚步声。接着村民之中响起一声声亲切的“门大人”的招呼声。\n一个身材魁梧的中年人走了过来。",
	[10100000907] = "北落大人！欢迎回来！",
	[10100000908] = "水儿，你们都没事吧？",
	[10100000909] = "没事，对不起，让你们担心了……对了，就是这几个哥哥姐姐救了我和狗儿。",
	[10100000910] = "我都听曹婆婆说了。真是太感谢了。我是明镜村的冒险者北落师门。实在是失职，在这种时候有事赶不回村子……多亏你们在，水儿和狗儿那两个不懂事的孩子才安然无恙。不知道怎么感谢你们才好。",
	[10100000911] = "前辈客气了，救人是我们应该做的。\n我们走了很远的路，不知可否让我们在村子里借住两天。",
	[10100000912] = "当然可以，欢迎欢迎！我最喜欢你这样有勇知义的年轻人了。敢问阁下是哪条街道的冒险者？下次我一定带上礼物，正式登门道谢。",
	[10100000913] = "前辈客气，举手之劳罢了。我是罗刹街的冒险者，名叫曹焱兵，这是我弟弟曹玄亮，我朋友夏铃。",
	[10100000914] = "北落师门突然严肃起来。",
	[10100000915] = "哦，罗刹街的曹焱兵……小子，请你们离开这里吧，我就当你们没来过。",
	[10100000916] = "什么情况……曹焱兵，你跟门大人有过节吗？",
	[10100000917] = "不，不过我收到了一份通缉令，下令捉拿毁坏神树的曹焱兵。\n按理说我应该逮捕你，不过看在你救了孩子的份上，我只当你没来过。",
	[10100000918] = "什么？怎么会……哥哥明明是为了救神树……",
	[10100000919] = "没办法，我们走吧。",
	[10100000920] = "这种地方居然能遇见活人，真难得。",
	[10100000921] = "想用我的锅就用吧，煮点东西暖暖身子，不必客气。",
	[10100000922] = "食物么，我身上的东西只够一个人吃了，想做饭的话，可以去瀑布边钓鱼，草丛里也有不少野菜，随意采吧。",
	[10100000923] = "我倒是想和这样的人较量较量，可惜时机不对。",
	[10100000924] = "嘘，你们听，好像有什么东西过来了。",
	[10100000925] = "走，我们过去看看。",
	[10100000926] = "<size=30><color=#f1f1f1>点击屏幕继续</color></size>",
	[10100000927] = "抱歉，我被一种不祥的感觉扰乱了心境，主人，还请小心前进。",
	[10100000928] = "曹焱兵走到某个路口，正与一队人马迎面撞上。",
	[10100000929] = "大人，北落那家伙顽固又强硬，恐怕没那么容易从他手上拿到菩提果。",
	[10100000930] = "灵域的人下令要寻找菩提果，而菩提树正巧在我的管辖区内，这是向上面邀功的好机会。记着，做成了，不仅是我，连你们也会跟着有好处。所以不论用什么手段都要拿到菩提果。",
	[10100000931] = "明白。",
	[10100000932] = "那些人好像在讨论菩提果。",
	[10100000933] = "看穿着，是羽林街的人没错了。",
	[10100000934] = "羽林街的人是什么人？",
	[10100000935] = "一些趋炎附势的走狗。不过，挺能吠的。",
	[10100000936] = "喂，前面是谁？看见羽林街的总司令不知道退让吗？",
	[10100000937] = "等等，这家伙……应该是罗刹街的曹焱兵吧？",
	[10100000938] = "一个通缉犯罢了，不用在他身上浪费时间。让灵甲军收拾他们，有更重要的事情等着我们去做。我们走！",
	[10100000939] = "南御夫一行人离开了，数量众多的灵甲军却将他们团团围住。",
	[10100000940] = "这、这数量也太多了。",
	[10100000941] = "哇！这么多财宝，我们要发财啦！",
	[10100000942] = "不错，你实力的确了得。曹焱兵，我很欣赏你。",
	[10100000943] = "怎么，你要认输？",
	[10100000944] = "且慢，焱兵，别忘了我们在魔星塔学过的，关于五行相克的规律。",
	[10100000945] = "天地生风雷水火土五行属性，利用五行之间的克制关系，可以更有效地掌控战局。",
	[10100000946] = "此路邪气四溢，前路的恶灵恐怕只会越发凶猛。\n以我们目前的人手应对，有些吃力啊。",
	[10100000947] = "我竟然在你身上看到了曹丞相的影子，莫非你真是能统一天下之人？",
	[10100000948] = "有趣！有趣！就让我典韦再一次助你一臂之力吧。",
	[10100000949] = "哥哥你看，那一伙人跟那个大叔在一起。",
	[10100000950] = "南御夫？你怎么来了，还带了这么多人？",
	[10100000951] = "听说门司令已经回来了，顺道来看看你。",
	[10100000952] = "我已经不是司令了，只是一个普通的冒险者罢了！还是客套了，南御夫，说吧，来是为了什么事？",
	[10100000953] = "还是北落大哥了解我。那么开门见山地说，灵域想要回收菩提果，还请你按规定上交菩提果。",
	[10100000954] = "老弟，你该知道，明镜村是靠菩提树的神力维持纯净的，正因为有菩提树的结界，村民们才不会变成恶灵。我们是曾经一同作战的好兄弟，你知道我绝对不可能放弃明镜村的。",
	[10100000955] = "唔……兄弟一场，我知道北落大哥坚守的是什么。既然你不愿意，我也不会勉强你的。",
	[10100000956] = "哼，这家伙跟刚刚说的话完全不一样诶，我看他心里一定盘算着怎么把菩提果弄到手。",
	[10100000957] = "有人？谁躲在那？",
	[10100000958] = "糟了……说话太大声了……",
	[10100000959] = "怎么会是你们？我的灵甲军呢？\n难不成……看来是我小看你了，曹焱兵。紫薇、天市、太微！你们一起把他拿下。",
	[10100000960] = "等等，老弟。曹焱兵这家伙，你就交给我吧。这个人与我有私人恩怨，既然在这里碰上，就让我来解决他吧。",
	[10100000961] = "大哥跟这个冒险者有过节？",
	[10100000962] = "不错。怎么？你担心我赢不了他？",
	[10100000963] = "怎么会！北落大哥这么说，我就放心了，以你的实力，赢他当然不在话下。\n那么菩提果的事，你再考虑考虑吧。我先告辞了。",
	[10100000964] = "南御夫带领众人离开了。",
	[10100000965] = "曹焱兵，我很欣赏你。可这次不能再这样轻易放你走了。\n刚才和南御夫所说的话并不假，我们必须打一场，你赢了就放你走。明天早晨七点，村外石棚旁的空地见。你会来吧？",
	[10100000966] = "当然，我可不会当缩头乌龟。",
	[10100000967] = "曹当家，你该知道，同一个寄灵人与不同守护灵搭档，能激活不同的圣兽吧？",
	[10100000968] = "人的潜力是无穷的，这次战斗，就让我替代许褚，和你搭档作战吧！",
	[10100000969] = "我不太确定，我想羽林街司令，一定不是泛泛之辈。",
	[10100000970] = "哈？？！！那你答应那么爽快干嘛。",
	[10100000971] = "现在只能这样了，如果想要借用菩提果，优先要做的是得到门司令的认同。\n哥哥一定也是这样考虑的，对吧？",
	[10100000972] = "啊，嗯……没错，就是这样。（其实什么都没想就答应了）",
	[10100000973] = "吾辈只跟你到这里了，目前你的实力还不值得我为你效力。\n不过，你潜力无限，期待日后与你相见的那一天。",
	[10100000974] = "不用担心。我不吃饭也能打十个。",
	[10100000975] = "嗯，很有精神。\n不过，嘴上说说可不算数，还是用拳头说话吧。\n出来吧，石明灵！",
	[10100000976] = "嗯！",
	[10100000977] = "猴子？那就是北落的守护灵吗……",
	[10100000978] = "哟，焱兵，刚才我发现你出招吃力，有些力不从心呢。",
	[10100000979] = "也难怪，这些恶灵属火，与你属性相同，恐怕不好对付。",
	[10100000980] = "我的绝技有减速效果，或许能助你一臂之力。需要的话就让我来说明你吧。",
	[10100000981] = "多谢。",
	[10100000982] = "不客气，这是你自己争取来的自由，哈哈哈。",
	[10100000983] = "太棒了，曹焱兵！",
	[10100000984] = "……",
	[10100000985] = "谢谢你们。很高兴能认识你们这样热心正直的青年，你们路过明镜村救了水儿，又和我大战了一场，不打不相识，也算是一场缘分了。",
	[10100000986] = "曹玄亮、曹焱兵和夏铃互相看了看，下定决心似的点了点头。",
	[10100000987] = "北门大叔，我们也很高兴认识你，但其实，我们并不是偶然路过此地，而是专门找来的。",
	[10100000988] = "哦？你们有事找我？",
	[10100000989] = "其实我们罗刹街被一帮名为“王国组织”的人入侵，灵槐神树才意外被毁灭。听说集齐龙桃、扶桑、帝榆三棵树的果实，就能复苏灵槐树，所以就找到这里来了。我想明镜村的“菩提树”就是传说中的“龙桃树”吧，而菩提果就是我们在找的龙桃的果实了。",
	[10100000990] = "你们也想要菩提果？",
	[10100000991] = "只是借用。等灵槐树复原我们把它给你送回来。",
	[10100000992] = "你们现在已经有另外两颗果实了吗？",
	[10100000993] = "还没有……",
	[10100000994] = "唔，那可不行。我不能把菩提果给你，让你带着菩提果在冥界四处转悠。不过么，只要你有本事找到另外两颗，我就把菩提果借给你。",
	[10100000995] = "一言为定。",
	[10100000996] = "曹焱兵，希望能看到你能活着回来。",
	[10100000997] = "那是自然。\n我一定会回来的。到时候你可别反悔啊！",
	[10100000998] = "后会有期，大叔！我们先走了！",
	[10100000999] = "曹焱兵一行人离开了。",
	[10100001000] = "想不到现在能见到这样年轻的豪杰，前途无量啊。",
	[10100001001] = "呼……北落大人！北落大人……呼……不好了！",
	[10100001002] = "阿贵？！你怎么了，怎么全身是伤？",
	[10100001003] = "村里、村里出事了！南御夫想要我们的菩提果，派了两个手下来，见人就打，狗儿、王伯、明叔，他们都……明镜村已经变成一片火海了……我……",
	[10100001004] = "阿贵用尽最后一口气，倒在地上。",
	[10100001005] = "阿贵！阿贵！可恶……\n石灵明，我们赶快回村！",
	[10100001006] = "原本一个字也没有的石碑，经水儿的指尖触碰，立刻显现出发着幽光的文字。",
	[10100001007] = "第一关的谜语是……",
	[10100001008] = "让我想想，第一关的诗句应该是……",
	[10100001009] = "东风吹遍原野，但无言、红绿自纷纷。",
	[10100001010] = "谜语里依次出现<color=#c94252>“红”</color>、<color=#6c9a3b>“绿”</color>二字，那么按照顺序踩踏对应颜色的踏板试试吧。",
	[10100001011] = "唔，我太担心今早的战斗，急匆匆地赶出来……我们快回去取吧。",
	[10100001012] = "道路上留着一些凌乱的足迹，顺着足迹向前看，明镜村的老婆婆正躺在那里。",
	[10100001013] = "是婆婆！她受了重伤。",
	[10100001014] = "婆婆，醒醒！啊……已经……断气了……",
	[10100001015] = "怎么会这样……",
	[10100001016] = "看刀伤干脆利落，不像是恶灵干的，倒像训练有素的人下的手……我们赶快回明镜村吧，村子里一定出事了。",
	[10100001017] = "你们看那边，是水儿！",
	[10100001018] = "咳咳咳……",
	[10100001019] = "她还有一口气！",
	[10100001020] = "快去救门大人……救救爸爸，他为了救我，自愿被锁灵石锁上，带去羽林街了……",
	[10100001021] = "爸爸？",
	[10100001022] = "他们为了得到玉菩提的果实，利用你们决斗的空隙，袭击了村子……求求你们快去救救爸爸吧，他现在使不出任何法力，只能任人摆布……",
	[10100001023] = "这孩子伤得不轻，武器贯穿了她的内脏，加上发现得太晚，法力几乎都流失了，我给她复用的药丸，只能暂时维持生命罢了。能不能挺过去，只能看天命了。",
	[10100001024] = "怎么会……",
	[10100001025] = "南御夫这个畜生……",
	[10100001026] = "可恶，实在咽不下这口气，焱兵，我们去羽林街！",
	[10100001027] = "那还用说！",
	[10100001028] = "原本一个字也没有的石碑，经水儿的指尖触碰，立刻显现出发着幽光的文字。",
	[10100001029] = "第二关的谜语是……",
	[10100001030] = "原本一个字也没有的石碑，经水儿的指尖触碰，立刻显现出发着幽光的文字。",
	[10100001031] = "哦？曹焱兵，不趁机逃走，反而到这里来了。真感人啊，为了情义之类的。",
	[10100001032] = "少废话，你们把北落大叔带到哪里去了？",
	[10100001033] = "当然带去大殿里了。想去的话，你得先过我这一关才行。",
	[10100001034] = "找到了！操作机关应该就能通过那条路了。",
	[10100001035] = "没想到连紫薇都打不过你。不过，我和紫薇那个自大的女人不一样，我更喜欢团队合作。灵甲军，给我上！",
	[10100001036] = "终于到大殿跟前了，他们在哪？",
	[10100001037] = "看，门司令被锁在大殿上！",
	[10100001038] = "是<color=#48bce7>聚灵石像</color>！\n要是受伤了的话，一定要用<color=#48bce7>聚灵石像</color>治愈伤势，不能逞强哦。",
	[10100001039] = "大殿门廊前，北落师门被锁灵石紧紧锁住。",
	[10100001040] = "真是没完没了，快把门司令交出来！",
	[10100001041] = "想从这里过去没那么容易。",
	[10100001042] = "可恶，手臂已经不能动弹了……你们要的钥匙我留下了。先走一步了。",
	[10100001043] = "他要逃跑了，要追吗？",
	[10100001044] = "救人要紧，不用管那家伙了。",
	[10100001045] = "双手拷着锁灵石，既无法召唤守护灵，也无法施展法力，北落师门颓废地瘫坐在地上。",
	[10100001046] = "南御夫，我们兄弟一场，你为什么做出这种事，我们有什么仇吗？",
	[10100001047] = "仇恨？没有的事，你是我曾经的导师、战友、上司，哪里有什么仇恨。只是你太碍事了。明明顺从灵域，交出菩提果，就能平安无事。你偏偏要顾虑那些没用的幽灵，真是可笑。本来，你若交出菩提果，等我向上面汇报的时候，也会帮你美言几句，可惜了。还好有那个叫曹焱兵的小鬼来捣乱，如果不是他把你引开，离开村子，我恐怕也没那么容易得手。\n呵呵，仔细一看，这颗菩提果可真美啊。我的前途全靠它了哈哈哈。",
	[10100001048] = "就为了这个？就为了你自己的名利，你就下令残害了村子里的人？",
	[10100001049] = "谁叫他们阻止我，阻碍我前进的人，都是我的敌人。况且那些不是人，门司令，只是幽灵罢了，他们早就不在啦。\n呵呵，从我认识你开始，你就是这样迂腐，这么多年还真没有变过啊。",
	[10100001050] = "呵，到头来，是我自己看错了你……南御夫，你一心想往上爬，但看在这么多年交情的份上，拜托你一件事，那就是求你放过我女儿……",
	[10100001051] = "等一下！",
	[10100001052] = "曹焱兵？！这么说，我的三员大将都已经……你究竟是何方神圣？",
	[10100001053] = "喂，大叔！你脑子没问题吧？为何明明被骗子骗了，还要拜托骗子？",
	[10100001054] = "没错，北落大叔，南御夫就是个满心只有名和利的小人，自己珍视的东西，应该自己牢牢抓在手里啊！",
	[10100001055] = "是你们……",
	[10100001056] = "刚刚我们折返村子的时候，看见水儿也被一起攻击了，如果再晚一步……",
	[10100001057] = "水儿受伤了？她现在怎么样了？没事吧？",
	[10100001058] = "她……还有一口气，等着我们带你回去。",
	[10100001059] = "南御夫，你这个混蛋！可恶……力量被封印住了，使不出来……",
	[10100001060] = "走吧，大叔，用你自己的手来保护她！",
	[10100001061] = "用太微给的钥匙插入锁灵石的插孔，锁灵石碎裂掉落。",
	[10100001062] = "现在，我来慢慢跟你算账，南御夫。",
	[10100001063] = "可恶……所有人听令！把这三个人抓住，一个都不要放走！",
	[10100001064] = "可恶，我们成了他们的目标，所有人都往我们这过来了！",
	[10100001065] = "来得正好，一腔怒气正好没地方发泄呢。",
	[10100001066] = "北落师门一声怒吼，石灵明腾空飞出，猛地一挥铁棒，一片灵甲军应声倒地。",
	[10100001067] = "哇……是门司令的守护灵石灵明！快逃！",
	[10100001068] = "呀呀呀呀呀！你们这群忘恩负义的家伙，一个都别想逃！",
	[10100001069] = "这条路有机关，跟我来！",
	[10100001070] = "打开这个机关，就可以从刚刚的路通过了。",
	[10100001071] = "糟糕，怎么这么快就追上来了……",
	[10100001072] = "曹当家的！在这天下，别以为你就是霸王！",
	[10100001073] = "你是何人？",
	[10100001074] = "这里也不是你的许都，而是我的鸿门宴。",
	[10100001075] = "项昆仑……群英殿的老大……",
	[10100001076] = "哈哈哈哈，你们通通都完了！",
	[10100001077] = "我们能打败这么强的人吗……",
	[10100001078] = "别误会，我只是来这边看看有什么骚动，没想到不过是些不入流的寄灵人。只有那个武神躯还有点意思。不过今天我没空跟你们缠斗，虞子期，你来跟他们较量较量。",
	[10100001079] = "是！主公！",
	[10100001080] = "等等！来了就别想跑！",
	[10100001081] = "曹焱兵紧握十殿阎罗向项昆仑攻去，不过三四招的功夫，就被项昆仑掀翻在地。",
	[10100001082] = "曹焱兵！",
	[10100001083] = "曹焱兵，你现在还太嫩。我更期待未来的你。后会有期了。",
	[10100001084] = "项昆仑离开了。",
	[10100001085] = "咦，南御夫去哪了？",
	[10100001086] = "一定乘乱去拿他的玄黄丹了，我们得尽快追上他。一旦他吃下玄黄丹，化身为噬日，事情就麻烦了。",
	[10100001087] = "李轩辕，你能感觉到南御夫的气息吗？",
	[10100001088] = "唔……我感觉到一种奇怪的感觉，一种法力与邪气纠葛在一起的感觉……",
	[10100001089] = "搞不好南御夫已经拿到玄黄丹开始兽化了，我们得抓紧时间，在他完全化身为噬日前找到他。",
	[10100001090] = "唔，房间被锁住了，附近应该有机关可以开启。",
	[10100001091] = "是机关，没记错的话，前面被锁住的路可以用它开启。",
	[10100001092] = "吼吼吼……",
	[10100001093] = "那是什么？",
	[10100001094] = "是噬日……南御夫变身成功了。没办法，只能战斗了。",
	[10100001095] = "经过噬日一战，羽林街已全军覆没。曹焱兵一行人折返明镜村。",
	[10100001096] = "我们到明镜村了，大叔，水儿就在这里。",
	[10100001097] = "李轩辕轻轻解开围绕在水儿身边的结界，水儿面色苍白，就像树梢上快要融化的雪一样。",
	[10100001098] = "她看上去快不行了，似乎灵魂马上要消散了……",
	[10100001099] = "抱歉，我已经尽力了，可水儿的灵体实在太虚弱……",
	[10100001100] = "别说了……门司令一定很难过，让他们单独呆一会儿吧。",
	[10100001101] = "呜呜……水儿……",
	[10100001102] = "北落师门抱起重伤的水儿。",
	[10100001103] = "爸……爸……",
	[10100001104] = "刚才你叫我什么？",
	[10100001105] = "爸爸……我已经全部想起来了，关于我生前的事，还有你是我父亲的事。",
	[10100001106] = "水儿……我是个不称职的父亲，你恨我吗？",
	[10100001107] = "活着的时候我经常埋怨爸爸，怪你不能总是陪伴在我身边。可现在才明白你是个了不起的人。\n我很幸运，能成为爸爸的女儿。",
	[10100001108] = "水儿……",
	[10100001109] = "真希望能一直做爸爸的女儿啊……可惜我已经看不见了……啊，身体变得轻飘飘的……",
	[10100001110] = "水儿的灵魂开始变成碎片，随风而起。",
	[10100001111] = "水儿……不……不要消失得那么快！\n呜呜，是爸爸对不起你！",
	[10100001112] = "爸爸，你怎么哭了……不准哭呀！不然水儿也会难过的。",
	[10100001113] = "呜呜，爸爸不哭……不再哭了……",
	[10100001114] = "爸爸，你要连同水儿的份一起活下去，好好活着……",
	[10100001115] = "水儿的声音越来越小，好像是从遥远的地方传来。\n接着，躯体随着声音一同消失在夜空中。",
	[10100001116] = "爸爸答应你……一定……好好活下去。",
	[10100001117] = "第二天",
	[10100001118] = "早啊，夏铃姐姐。",
	[10100001119] = "早啊，小亮。\n咦，门司令出来了。",
	[10100001120] = "看上去好憔悴啊……",
	[10100001121] = "门司令，我能带走这颗菩提珠吗？等灵槐树复原之时，一定将他还回来。",
	[10100001122] = "拿走吧，它对我来说已经没有意义了。",
	[10100001123] = "……",
	[10100001124] = "大叔，明镜村已经不存在了，我们打算周游冥界，寻找剩下的神珠。你要同我们一起吗？",
	[10100001125] = "明镜村是为弥补生前对水儿亏欠而建，如今村子没了，我也再没有牵挂。走吧，我答应水儿要好好活下去，这一次，不能再让她失望了。",
	[10100001126] = "希望能顺利拿到神珠，这样灵槐树就有救了。",
	[10100001127] = "好一个世外桃源。哥哥，等我们救了灵槐树，也把罗刹街变成这样的安居之所吧。",
	[10100001128] = "果然，就算是这样的世外桃源，也免不了为要恶灵发愁。",
	[10100001129] = "你们去吧，我留在这里多打听打听消息。",
	[10100001130] = "小亮，你一个人在这里，真的没问题吗？",
	[10100001131] = "对这里的幽灵来说，我们是外来人，还是一起行动比较好。\n走吧小亮，我们去找找那两个小孩。",
	[10100001132] = "恕不能久留，不送了，火将军曹焱兵。",
	[10100001133] = "我明白了。",
	[10100001134] = "这帮家伙居心不良，我们得快点告诉北落大叔！",
	[10100001135] = "你说得没错，夏铃，这件事要尽快通知北落大叔才行，我们赶紧跟上他们吧。",
	[10100001136] = "曹焱兵，别忘了我们的约定啊。",
	[10100001137] = "我一定按时赴约。",
	[10100001138] = "哥哥，我好像有什么东西落在村子里了……我们回去取吧。",
	[10100001139] = "奇怪，我感觉村子里的气氛有些不对劲？",
	[10100001140] = "羽林街人马众多，我们循着足迹，应该就能找到。",
	[10100001141] = "嗯，我们循着足迹去羽林街吧。",
	[10100001142] = "羽林街的走狗，实力也不过如此。",
	[10100001143] = "没时间休息了，我们赶快继续前进吧。",
	[10100001144] = "希望北落大叔平安无事……",
	[10100001145] = "他一定会没事的。",
	[10100001146] = "你们看，四面八方涌过来好多援兵，看来得先解决他们才行。",
	[10100001147] = "都是些杂碎罢了，看我碾碎他们。",
	[10100001148] = "项昆仑并未现出真身，仅仅投影就有此等功力，所幸那人没把我们放在眼里……",
	[10100001149] = "算了，现在要紧的是找到南御夫，那家伙实在太可恶了。",
	[10100001150] = "真是难缠的家伙。",
	[10100001151] = "水儿呢……快带我去找水儿！",
	[10100001152] = "我们把水儿藏在村子里安全的地方，跟我来，门司令。",
	[10100001153] = "曹焱兵，从今往后，再也没有世外桃源了。",
	[10100001154] = "门将军，总有一天我们会再建一个新桃源，等着吧。",
	[10100001155] = "哇呀，那些怪物追得好紧！曹焱兵这家伙，说去森林探路就没消息了。",
	[10100001156] = "放心吧，那家伙命硬着呢！不会出事的。",
	[10100001157] = "我哪里是担心他，我是担心这儿人手不够……",
	[10100001158] = "夏铃和北落师门乘坐幻化出的巨石龟拼命奔驰，身后乌泱泱一片的怪物，正紧紧追赶着他们。",
	[10100001159] = "啊啊啊，真是的，为什么非要来这种地方不可。",
	[10100001160] = "主人，不如我们也进入森林。森林视野狭窄，道路复杂，或许能制约这些常于草原出没的怪兽，变被动为主动。",
	[10100001161] = "是个好方法，冲吧！巨石龟，往这边！",
	[10100001162] = "大家当心，这里路线错综复杂，千万不要走散了。",
	[10100001163] = "嘶嘶嘶——",
	[10100001164] = "来东西了。",
	[10100001165] = "这种深山老林也有机关竟然也藏着机关，会不会有人住在这里？",
	[10100001166] = "唔，谁会住在禁地呢……难道有人看守？",
	[10100001167] = "道路被封印锁住了，恐怕我们得找找机关才能解开它。",
	[10100001168] = "诶，禁地里也有聚灵石像吗？",
	[10100001169] = "聚灵石像是汇聚幽灵之气天然形成的，只要有幽灵在的地方自然会有聚灵石像。",
	[10100001170] = "有人跑了过来。",
	[10100001171] = "你们来这地方做什么？",
	[10100001172] = "曹焱兵！当然是找你啊。",
	[10100001173] = "你们当心，这里怪怪的——果然！又是巨蜥。",
	[10100001174] = "这些蜥蜴就是守护禁地的侍卫么？",
	[10100001175] = "不清楚，不过我发现这里的每只蜥蜴脚底都写着编号，这种事不像神明所为。\n曹焱兵，这么危险地方，你到底想来查什么？",
	[10100001176] = "我来是因为听说空神之森里有一座名叫芦花古楼的遗迹，我们要找的神珠或许也在其中。\n真是的，本来想留几个人在外面有个照应，没想到你们都冲进来了。",
	[10100001177] = "可现在看来，敌在暗我在明，要找芦花古楼果然没那么容易……",
	[10100001178] = "走吧，我们得赶在蜥蜴怪的头目发现我们之前找到它。但愿这个险值得我们去冒。",
	[10100001179] = "森林深处，一座阶梯状寝宫发出森森的寒气。\n寝宫物地下的地下室摆满玻璃器皿，各种野生蜥蜴泡在储存液中。",
	[10100001180] = "呵呵呵，太棒了！我花了半年研制出的灵海测量仪终于完成了，这是我的又一杰作。你看，红莲，它多美啊。",
	[10100001181] = "我不是来参观你无聊的新发明和改造蜥蜴的。",
	[10100001182] = "别急，如果你要找的叫曹焱兵的家伙真的会来这里，那么我的探测仪一定能将他探测出来。",
	[10100001183] = "吉拉按下开关，探测仪转动指标，发出“哔哔哔”的声音。",
	[10100001184] = "你看，这里有5个灵海值出现在范围内了，其中一定有你想找的人。\n等等，怎么全都是灵海值40万以上的高手？那样强的守护灵改造过后会是什么样呢？\n呵呵，突然兴奋起来了呢。红莲，你可不要插手，空神之森是我的地盘，森林里的人，理应由我来处理。",
	[10100001185] = "我不想与你为此争执，浪费时间。\n 国王的任务是追击曹焱兵，只要你能带回他的遗体，我就没意见。不过，你要是误了我的事……",
	[10100001186] = "少瞧不起人，红莲，我和你一样，也是王国十骑士之一。别以为你在国王身边就高人一等。\n我一定会带回他的。",
	[10100001187] = "你最好可以。",
	[10100001188] = "咦，有什么花的气味，好香呀。",
	[10100001189] = "怎么突然起雾了，不太对劲。大家注意别走散了。",
	[10100001190] = "迷雾中出现一个女人的身影。",
	[10100001191] = "曹焱兵，是你吗？我的儿子？你、你千万别过来——啊——",
	[10100001192] = "是……母亲？",
	[10100001193] = "什么？哥哥，别跑，等等我！",
	[10100001194] = "曹焱兵和小亮向女人消失的方向跑去，消失在雾中。",
	[10100001195] = "喂，曹焱兵，回来！那是幻象！\n真是的，夏铃，你千万别再走散了。",
	[10100001196] = "迷雾中出现一男一女两个人的身影。",
	[10100001197] = "智美，忘了北落师门吧，我会给你幸福的。",
	[10100001198] = "那是……我前妻！喂，等等我，这么多年你跑哪里去了！",
	[10100001199] = "北落师门跑入迷雾，消失了。",
	[10100001200] = "北落大叔！\n真是的！一个靠得住的都没有。",
	[10100001201] = "事到如今还是得靠自己了。李轩辕，我们上！",
	[10100001202] = "奇怪，脚下怎么黏黏的……地下这些白色的丝线是什么啊。",
	[10100001203] = "呵呵，没有猎物能走出我精心布下的蛛网。",
	[10100001204] = "太棒了，赢了！",
	[10100001205] = "咳咳，小姑娘有点东西。不过，你再仔细看看你的脚。",
	[10100001206] = "少跟我打马虎眼，脚怎么了？\n——咦，这些白丝什么时候缠上来的？完全挣脱不掉……",
	[10100001207] = "在我的蛛网里，越挣扎，丝线就会缠得越紧。你已经无路可逃了。",
	[10100001208] = "唔，怎么办……手脚被缠住的话，就无法召唤李轩辕了！",
	[10100001209] = "忽然间，一个黑影闪过上空。",
	[10100001210] = "那么多手，先切哪一块呢？",
	[10100001211] = "不出几秒钟，狼蛛的手臂在飕飕的风声中纷纷落下。",
	[10100001212] = "啊啊啊啊！！！我的手！可恶，给我等着！",
	[10100001213] = "哼，劣质的实验品。",
	[10100001214] = "地面的蛛丝全部消失了。",
	[10100001215] = "谢谢……你是？",
	[10100001216] = "你来空神之森做什么？不老实回答，就给你点颜色看看。",
	[10100001217] = "什么……这人救了我态度却这么凶，到底是敌是友啊？",
	[10100001218] = "可恶，跟丢了！",
	[10100001219] = "喂，北落，清醒一点！别追了，你已经和大家走散了！",
	[10100001220] = "糟了，夏铃呢？可恶，我不该这么冲动的。",
	[10100001221] = "他们应该离我们很近，四处找找吧。",
	[10100001222] = "附近似乎有埋伏，小心一点啊。",
	[10100001223] = "啊，我会警惕的。",
	[10100001224] = "石灵明，用聚灵石像治疗下吧，战斗不知道什么时候才结束呢。",
	[10100001225] = "呵呵呵，和计划一样，把他们分散了，只有一个人的话，就好办了。",
	[10100001226] = "哼，想对付我，还早着呢。",
	[10100001227] = "怎么办，我们似乎已经走出相当远了，却连曹焱兵他们的人影都没见到。",
	[10100001228] = "附近没有人迹，恐怕他们不在这里。石灵明，你去那颗最高的树树顶观察下附近的动向。",
	[10100001229] = "石灵明迅速爬上树梢，眺望远方。",
	[10100001230] = "北落，东边有硝烟。",
	[10100001231] = "一定是他们。走，我们去看看。",
	[10100001232] = "真是的，哥哥，你跑得太快了啦！",
	[10100001233] = "母亲……",
	[10100001234] = "刚刚母亲的形象应该是有人幻化出的幻象吧？",
	[10100001235] = "没错，明明潜意识里知道可能是骗局，可我还是控制不住自己……",
	[10100001236] = "这雾气带有一股异香……闻起来很像书上记载的神花的气味。恐怕有人利用神花迷人心智的特性，操纵了我们的知觉。只有找到躲在背后施法的人，才能走出这片迷雾。",
	[10100001237] = "居然敢拿母亲的样子来耍我，决不能饶恕这个骗子。",
	[10100001238] = "这条路被封住了，可我感觉法力的气息的确是从这边散发出来的。",
	[10100001239] = "应该有机关。那个石像会是机关吗？",
	[10100001240] = "我查看了一下，并没有看见什么玄机。不如先往前面探探，说不定能找到线索。",
	[10100001241] = "这破地方机关真多。",
	[10100001242] = "这石头碎片好眼熟。",
	[10100001243] = "这是刚才破碎的石像的一部分吧。",
	[10100001244] = "这座森林是咒语禁地，一座石像或许也隐藏着神力。我们把它带上吧。",
	[10100001245] = "曹焱兵将石像碎片收了起来。",
	[10100001246] = "啊，是这个！",
	[10100001247] = "找到了第二块石像碎片。",
	[10100001248] = "找到了第三块石像碎片。",
	[10100001249] = "这些石像碎片看起来没什么特别之处呀。",
	[10100001250] = "这石像虽已碎裂，碎块却十分完整，或许我们可以拼回石像试试。",
	[10100001251] = "哦！果然玄机在石像身上！",
	[10100001252] = "走吧。",
	[10100001253] = "终于来了吗，我等你好久了。",
	[10100001254] = "看起来也不像古神啊。你是什么人？",
	[10100001255] = "呵呵，闯进禁区口气还这么大。在空神之森的守护者面前，你应该学会尊敬。",
	[10100001256] = "有两下子。这么强的灵体经过改造会是什么样子呢？越来越期待了。",
	[10100001257] = "天边忽然窜出一束燃烧的火花，那是曹焱兵交给夏铃的信号弹，是集合的信号。",
	[10100001258] = "那个笨女人发出的集合信号，恐怕她有危险了。我们没时间跟他纠缠了。",
	[10100001259] = "想走？没那么容易。",
	[10100001260] = "呵呵，空神之森的守护者，如果我把森林烧掉，你会怎么样呢？",
	[10100001261] = "嗯？",
	[10100001262] = "曹焱兵用阎王炮发射火焰弹，森林中的火势立即蔓延开来。",
	[10100001263] = "后会有期啦！",
	[10100001264] = "曹焱兵和曹玄亮逃走了。",
	[10100001265] = "可恶，这个疯子，居然放火烧森林。森林遭殃的话，我一定会被森林古神惩罚的……快来人！灭火！",
	[10100001266] = "刚刚看见夏铃的信号弹，应该是从这附近发射的……",
	[10100001267] = "焱兵！小亮！你们怎么这么慢！",
	[10100001268] = "碰到个自称森林守护者的人，被他缠住了。",
	[10100001269] = "我也一样，被一个莫名其妙的家伙缠住了。",
	[10100001270] = "你说自称森林守护者？是森林古神吗？",
	[10100001271] = "不，看起来不像，只是只丑陋的蜥蜴罢了。",
	[10100001272] = "这座森林一定发生了什么，让那家伙统治了这片森林。",
	[10100001273] = "是食火蜥吉拉。",
	[10100001274] = "这家伙是谁？",
	[10100001275] = "我叫阎风咤，是踏风族的一员。我们族人自古以来就守护空神之森。可食火蜥吉拉霸占了我们的地方，害惨了我们族人。现在这里只剩下我一人了。\n那家伙如果被我遇到了，我一定不会放过他。可惜他一直躲在地下室搞那些的兵器改造实验，几乎没有露过面。",
	[10100001276] = "他刚才救了我的一命，说他好像也要去芦花古楼，我想我们不如一起，好多个照应。",
	[10100001277] = "哦？你的族人既然被害，不去找食火蜥报仇，去芦花古楼做什么？",
	[10100001278] = "我有我的目的，怀疑我的话，分道扬镳就好了。还有，你还没说你的名字吧。",
	[10100001279] = "我么，我是罗刹街的当家曹焱兵，有七个守护灵，人称火将军。",
	[10100001280] = "完全没听说过，该不会是你自封的吧？我姐姐说过，金玉其外的家伙，最喜欢吹嘘自己。",
	[10100001281] = "你这小毛头，是不是想打架？",
	[10100001282] = "喂喂，你们不要为什么幼稚的理由打起来啊，现在我们可是在躲那些蜥蜴的追查。",
	[10100001283] = "嗯，阎风咤，你看上去不像坏人，我来告诉你我们为什么来这里吧。",
	[10100001284] = "北落师门把曾发生的事一五一十告诉了阎风咤。",
	[10100001285] = "所以，你们去芦花古楼是为了救神树？除了那个自大的家伙，你们看上去也不像坏人。这样的话，我倒是能给你们带路。",
	[10100001286] = "……",
	[10100001287] = "真的？在什么地方？",
	[10100001288] = "芦花古楼并非一直存在于森林中，几年才现身一次。我为这天已等了数月，今夜，芦花古楼就会现身。",
	[10100001289] = "另外，芦花古楼每次出现的地方不一样，但有规律可寻，只有踏风族的人知道这些。今晚它现身的地点，可能在西边。",
	[10100001290] = "这里应该走哪边呢？",
	[10100001291] = "应该走左边。",
	[10100001292] = "记得是走右边。",
	[10100001293] = "阎风咤比较熟悉这里的地形，走右边吧。",
	[10100001294] = "这一次走哪边？",
	[10100001295] = "走上面的路。",
	[10100001296] = "不，应该走下面。",
	[10100001297] = "这小子，是不是故意跟我对着干……",
	[10100001298] = "曹焱兵，不要那么幼稚好吗。",
	[10100001299] = "哥哥，还是姑且先听阎风咤的吧。",
	[10100001300] = "喂喂，不仅是夏铃，连小亮也开始相信他了。他要是食火蜥派的间谍，带我们走进陷阱了怎么办？",
	[10100001301] = "啊，这个机关要小心对待，要让他的剑指向正确的方位，道路才会打开。如果指向错误的地方，很可能会触发机关陷阱。",
	[10100001302] = "这机关之前我们也遇见过，不过如此，要我说，这次应该指向下面。",
	[10100001303] = "曹焱兵伸手扳动机关。",
	[10100001304] = "喂！你不要乱来啊。",
	[10100001305] = "这里是？",
	[10100001306] = "可恶，只有我们两个人掉进来了吗？这恐怕是个陷阱，我们得想办法出去才行。都怪你这个自大的家伙。",
	[10100001307] = "应该是你这个可疑的家伙才对，你不会是故意带我们来这么危险的地方来的吧？",
	[10100001308] = "这家伙刚才也遇到过。",
	[10100001309] = "虽然外表一样，但编号并不同，恐怕是同一批改造人。",
	[10100001310] = "不用你说我也知道。",
	[10100001311] = "可恶，这么多岔路，陷阱究竟有多长……",
	[10100001312] = "这条路到底通向哪里呢？要让我知道是你搞的鬼，我绝不会轻易放过你。",
	[10100001313] = "懒得理你。",
	[10100001314] = "这幽灵是看守机关的吗？看来这机关能让我们出去。",
	[10100001315] = "这机关底部已经坏掉了。看来机关底部需要一个人用手托着才能打开。",
	[10100001316] = "快，没时间了，我来托住它，你快操作机关。",
	[10100001317] = "笨蛋，机关激活的力量恐怕有千斤重，托住底部，手恐怕也废了。",
	[10100001318] = "别废话，来吧！",
	[10100001319] = "为了进入芦花古楼，丢掉一只手值得吗？为什么这么执着？你疯了吗？",
	[10100001320] = "和你们不同，我的族人和姐姐都被关在古楼里……好不容易才等到进入古楼的机会，我不能再错过了。",
	[10100001321] = "……",
	[10100001322] = "我可不想让你手废掉，芦花古楼里有什么危险还是未知，我们得多一个四肢健全的帮手才行。",
	[10100001323] = "你这家伙……还挺讲义气的。",
	[10100001324] = "抱歉，刚才是我不对，一直怀疑你。",
	[10100001325] = "搞什么，突、突然这么正经。走吧，夏铃她们应该还在等我们。",
	[10100001326] = "喂，前面有什么东西，你感觉到了吗？",
	[10100001327] = "嗯，一起上！",
	[10100001328] = "吉拉大人说得没错，果然有笨蛋进来了。我要把你们统统抓住，献给吉拉大人。",
	[10100001329] = "那你倒是试试！",
	[10100001330] = "没想到这小个子还挺厉害的，拥有操控风的天赋吗？真庆幸他站在我们这边。若他是敌人就麻烦了。",
	[10100001331] = "你在嘀咕什么呢？这条路已经安全了，我们赶紧和其他人汇合吧。",
	[10100001332] = "那个……阎风咤，你刚刚说你的族人和姐姐都在芦花古楼里，到底是什么意思？",
	[10100001333] = "那是发生在几年前的悲剧。芦花古楼自古以来是古神的居所，凡人绝不允许入内。\n可上一次芦花古楼现身的时候，吉拉那蠢货私自打开古楼大门，害全村人被古神诛害，姐姐也一去不返。\n不过姐姐身上带着与我配对的项链，两条坠链用同一块灵石制成，可以无限转动，只要项链还在运转，姐姐就一定活着。",
	[10100001334] = "阎风咤取下挂在脖子上的项链，圆形的坠子正神秘地转动着。",
	[10100001335] = "不过吉拉也因此惹上了事端，古神带走了全村的人，却需要新人来守护这座森林，他们选中了吉拉，给他下了永远不能离开森林，也不能让森林受破坏的咒语。他自此再也不能离开空神之森。",
	[10100001336] = "原来如此。不过话说回来，那些古神和灵域的御史就因为这个驱逐了所有的族人？这样不人道的行径，听起来更像魔鬼所为。",
	[10100001337] = "不错，古神本来并不会因为以真面目示人就惩罚别人。从前我们族还有古神和族人会面的历史被记录下来。可上一次不知怎么的，那些灵域来的人坚持要驱逐所有人，好像很慌张的样子。或许，他们知道了普通人不该知道的东西。",
	[10100001338] = "听说灵域先王逝世后，灵域大变，不知是否与此事有关系。",
	[10100001339] = "那些高高在上的灵域原住民，才不会管我们。走吧，曹……",
	[10100001340] = "曹焱兵。",
	[10100001341] = "曹焱兵，别让你的同伴等久了，我们快出去吧。",
	[10100001342] = "曹焱兵！阎风咤！我们找了你们好久了。",
	[10100001343] = "要从那鬼地方出来真不容易，不过好在有这家伙跟我一起。",
	[10100001344] = "不，多亏了曹焱兵，他帮了大忙。好了，我们快继续前进吧。",
	[10100001345] = "奇怪，这俩关系什么时候这么好了？",
	[10100001346] = "喂，你们慢一点，跑了这么久没有休息，我已经有点吃不消了……",
	[10100001347] = "我也开始感觉吃力了……",
	[10100001348] = "加把劲吧，芦花古楼出现的位置就在前面那片荒原后面，错过这次机会，要再等好几年才能再见到古楼了。",
	[10100001349] = "休息一下也无妨。现在离芦花古楼现身时间还早，我们还有时间，别太着急了，风咤。养养精神，要是碰上吉拉的人也有精力应对。",
	[10100001350] = "嗯，我见芦花古楼就近在眼前，有些过于激动了。不过，不要滞留太久，我们五分钟后出发吧。",
	[10100001351] = "嘿嘿嘿，终于找到你们了。正如吉拉大人所说，守在这里，就能拦截你们。",
	[10100001352] = "怎么会，我们的路线暴露了？",
	[10100001353] = "你们的一举一动都在吉拉大人的掌控之中！乖乖就范吧！",
	[10100001354] = "看来那个叫吉拉的已经布下埋伏，前面的路我们小心为上。",
	[10100001355] = "来阻挡我曹当家，得先问问我七个守护灵答应不答应。",
	[10100001356] = "大家当心，这段路还有不少机关。而吉拉的手下恐怕也布下埋伏了。",
	[10100001357] = "咦，是个十字路口。",
	[10100001358] = "芦花古楼应当往左走，可这里只有向下的路能通行，这恐怕是吉拉布下的局。没办法，硬着头皮去看看吧。",
	[10100001359] = "我布下的陷阱如何？真开心有除了兔子以外的生物掉进去。咦，那不是踏风族的小子么？你居然还活着？我的灵海检测仪上多出来的那人就是你么？",
	[10100001360] = "吉拉！在你离开空神之森之前，我是不会闭眼的。",
	[10100001361] = "呵呵，那么我们拭目以待。圣盾！我骄傲的改造体，出来吧！",
	[10100001362] = "这家伙真可怕，像不怕痛似的一个劲地冲过来。",
	[10100001363] = "等你能徒步走到刘羽禅的桃园，就会发现这样的家伙也不过如此。",
	[10100001364] = "我们是不是绕回来了？",
	[10100001365] = "不错，芦花古楼现身时间已到，我们也快到了。",
	[10100001366] = "真是地狱无门闯进来！",
	[10100001367] = "吉拉，你还敢出来，你害我全族被害，今天我就来讨回公道！",
	[10100001368] = "姓阎的小子，我当初被你们族人如何对待的，你会不知道吗？他们被古神惩罚也是罪有应得。",
	[10100001369] = "如何对待？我们收留流浪的你，给你住处，请你吃喝，你却恩将仇报。还有，别对我大呼小叫的，老子的阎，是阎王爷的阎！",
	[10100001370] = "他要跑了！",
	[10100001371] = "看样子他要转移到对他有利的地方战斗，我们追！",
	[10100001372] = "哥哥，快看！芦花古楼出现了！",
	[10100001373] = "走！",
	[10100001374] = "我等这一刻已经很久了，姐姐，我一定会把你救出来。",
	[10100001375] = "一行人急忙向芦花古楼赶去，只有北落师门停下了脚步。",
	[10100001376] = "怎么了？你不跟同伴一起走，来看我笑话？",
	[10100001377] = "你的腿怎么了？怎么开始化成石头了？",
	[10100001378] = "这是古神的咒语，一旦森林遭到破坏，我也会化成石头。这些把群英当奴隶使唤的所谓的神，要不是给我下了咒语，我老早就跟他们拼了。你们进去了，替我出口气吧。你们这群家伙，说不定，有这样的力量……",
	[10100001379] = "哦？",
	[10100001380] = "哼，你要笑就笑吧，我这副什么也办不到的样子，连我自己都觉得可悲。要守护的东西变得遥远，而肮脏的事情却近在眼前。在实验室待久了，身上会残留洗不去的腐臭味，坏事做久了，人也会变得麻木。能在归西前享受自由，这是我唯一庆幸的事情。你走吧，外人在森林里呆太久也会变成石头的。只有呆在芦花古楼里才能幸免。",
	[10100001381] = "这么说，神的咒语只在这座森林里生效？那么，我把你带进古楼，你也能恢复原状咯？",
	[10100001382] = "别做多余的事，你与阎风咤站在一起，我们就是敌人，就算你救了我，这一点也不会改变。",
	[10100001383] = "一码归一码，我偏要带你进去。我们还需要人手呢。",
	[10100001384] = "北落师门拖着吉拉，走向芦花古楼内部。",
	[10100001385] = "喂，你想清楚！我要是恢复了可是会和你战斗的哦！",
	[10100001386] = "想干架我一定奉陪。",
	[10100001387] = "就算你在我面前被神灵咒语，我也不会管你的哦！",
	[10100001388] = "好、好。随你的便吧。",
	[10100001389] = "咦，我们刚进入森林，那些怪物就自动退散了。李轩辕你的方法很有效嘛！",
	[10100001390] = "不，感觉怪怪的，恐怕跟地貌没什么关系。如果我没猜错，这片森林就是传说中的禁地空神之森。那些畜生应该感知到了咒语的危险才离去的。",
	[10100001391] = "禁地？那我们这样闯进来没问题吗？",
	[10100001392] = "没办法，现在只有先前进了。",
	[10100001393] = "对了，来都来了，我们先去找焱兵吧。",
	[10100001394] = "这森林不是普通的森林，焱兵要来这里一定有非比寻常的理由。",
	[10100001395] = "总之别太冒进，大家小心前进吧。",
	[10100001396] = "水儿现在已经投胎转世了吧，这次她一定会幸福地活着。",
	[10100001397] = "来到这种地方却有惊无险，真不知该说运气好还是不好。",
	[10100001398] = "刚才那些蜥蜴军团一定会再出现，千万要当心啊。",
	[10100001399] = "可恶，居然用这么卑鄙的手段迷惑我们……哥哥真是的，怎么一下子就中计了。",
	[10100001400] = "知道啦知道啦，是我的错。我们还是快点离开这里吧。",
	[10100001401] = "不知道其他人怎么样了，我们最好尽快找到他们才好。",
	[10100001402] = "希望大家能顺利汇合。",
	[10100001403] = "东边好像有些嘈杂声，我们小心过去看看情况吧。",
	[10100001404] = "那场大火或许能帮我们拖延时间，那家伙现在无暇顾及我们了。",
	[10100001405] = "嗖——\n一声尖锐的炮鸣引起曹焱兵的注意。",
	[10100001406] = "那是夏铃姐姐的信号弹！我们快过去看看。",
	[10100001407] = "你们没事吧！",
	[10100001408] = "没时间休息了，我们快走吧，别告诉我你没胆进芦花古楼。",
	[10100001409] = "我是为了去芦花古楼，怎么会在这种地方退缩。",
	[10100001410] = "我们在这里浪费了太多时间，这样下去说不定会错过芦花古楼现身的时间，快走吧。",
	[10100001411] = "没想到你人还不错，或许我们可以成为同伴。",
	[10100001412] = "这咒语的森林也不过是唬人罢了，没什么大不了的。",
	[10100001413] = "那是你还没见识过远古之神的恐怖之处。",
	[10100001414] = "我曹焱兵要做的事，一定要做到，这就是我的信念，管他什么神鬼，都别想阻拦我。",
	[10100001415] = "你这人，还怪有意思的。",
	[10100001416] = "距离芦花古楼还有一段路程，当心别再走进陷阱了。",
	[10100001417] = "嗯，夏铃他们一定在等我们，我们快去找他们吧。",
	[10100001418] = "你们俩和好真是太好了，我还在担心你们是不是打起来了呢。",
	[10100001419] = "吉拉已经布下局，等我们上钩了，焱兵你还能撑得住吗？",
	[10100001420] = "这是场战斗我们非赢不可，好不容易碰上芦花古楼现身的时机，我可不想再等几年时间。",
	[10100001421] = "真是个可怕的家伙，不过好歹赢了。芦花古楼应该快现身了，我们往前走吧。",
	[10100001422] = "咳咳……咳咳……可恶，我的身体开始石化了，这就是没有好好守护森林的代价吗。",
