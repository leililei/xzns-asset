	[90030203827] = "虎啸九州！每消耗<color=#5bdf99>9</color>点怒气点，白虎发出震慑全场的虎啸，沉默全体敌方<color=#5bdf99>3</color>秒并清空目标法力值。",
	[90030203828] = "可消耗更多的怒气点强化伤害，至多<color=#5bdf99>6</color>点，瞬移至敌方生命值百分比最低的英雄身后，对目标造成<color=#5bdf99>360%</color>攻击力的物理伤害，每消耗<color=#5bdf99>1</color>点怒气，额外造成目标<color=#5bdf99>5%</color>最大生命值的物理伤害，此次伤害无视护盾，并减少目标<color=#5bdf99>30%</color>的防御，效果持续<color=#5bdf99>10</color>秒，至多可叠加<color=#5bdf99>3</color>层。",
	[90030203829] = "召唤物，『朱雀真身』拥有朱雀<color=#5bdf99>150%</color>的基础属性。",
	[90030203830] = "『朱雀真身』死亡时会对全场敌人释放终炎冲击，对敌方全体造成<color=#5bdf99>200%</color>攻击力的伤害，并施加<color=#5bdf99>1</color>个“炎翎”，随后化为灰烬，灰烬会缓慢重新燃起，<color=#5bdf99>10</color>秒后『朱雀真身』浴火重生，并恢复至满血。",
	[90030203831] = "持续消耗法力释放火雨，每秒对敌人造成<color=#5bdf99>180%</color>攻击力的魔法伤害，并恢复队友<color=#5bdf99>200%</color>攻击力的生命。",
	[90030203832] = "『朱雀真身』不受治疗和负面效果影响，免疫斩杀，单次受到的伤害不会超过自身<color=#5bdf99>5%</color>最大生命值，每<color=#5bdf99>0.3</color>秒限<color=#5bdf99>1</color>次，受到普攻伤害时会为敌方全体附着<color=#5bdf99>1</color>个持续<color=#5bdf99>1</color>秒的“点燃”效果。",
	[90030203833] = "『朱雀真身』存活期间，每秒对随机敌人发射火焰弹，对命中目标及周围单位造成<color=#5bdf99>80%</color>攻击力的点燃伤害。",
	[90030203834] = "连续向敌方随机敌人发射<color=#5bdf99>3</color>枚奔腾之火，对路径上的敌人造成<color=#5bdf99>260%</color>攻击力的伤害，并为目标附着<color=#5bdf99>1</color>个“点燃”效果，持续<color=#5bdf99>4</color>秒。",
	[90030203835] = "<color=#FF5656>【负面·持续伤害】</color>减少<color=#5bdf99>50%</color>抗暴击率并每秒造成<color=#5bdf99>30%</color>攻击力的伤害，持续<color=#5bdf99>6</color>秒。",
	[90030203836] = "【专属效果】无法被驱散、窃取或转移，持续期间内对自身使用赤帝巡疆，且免疫死亡和斩杀，持续恢复<color=#5bdf99>60%</color>自身最大血量的生命值。",
	[90030203837] = "主动技能每暴击<color=#5bdf99>10</color>次，可在当前目标处释放，对目标以及其周围敌人造成<color=#5bdf99>180%</color>攻击力的伤害，并添加<color=#5bdf99>1</color>层“炎翎”。",
	[90030203838] = "【专属效果】无法被驱散、窃取或转移，提升<color=#5bdf99>2%</color>攻击力与破甲，持续<color=#5bdf99>5</color>秒，最多可叠加<color=#5bdf99>50</color>层。",
	[90030203839] = "每秒对随机<color=#5bdf99>3</color>名敌人造成<color=#5bdf99>120%</color>攻击力的魔法伤害并延长<color=#5bdf99>1</color>秒其“炎翎”的持续时间，如敌人身上没有“点燃”效果，则添加<color=#5bdf99>1</color>个持续<color=#5bdf99>4</color>秒的“点燃”效果，如敌人身上已经存在“点燃”效果，则此次伤害必定暴击。",
	[90030203840] = "对自身使用赤帝巡疆，持续<color=#5bdf99>3</color>秒，同时持续向随机敌人迸射火焰，火焰会穿透敌人，造成<color=#5bdf99>150%</color>攻击力的伤害，并附带<color=#5bdf99>1</color>个持<color=#5bdf99>4</color>秒的“点燃”效果，技能结束时消耗掉自身全部的“炎心”层数。",
	[90030203841] = "【专属效果】无法被驱散、窃取或转移，受到技能伤害或者控制效果时，额外受到玄武<color=#5bdf99>15%</color>防御力的伤害，该效果可叠加至多<color=#5bdf99>5</color>层，效果持续<color=#5bdf99>8</color>秒。",
	[90030203842] = "以极快的速度对周围敌人造成<color=#5bdf99>180%</color>攻击力的物理伤害，并恢复<color=#5bdf99>10%</color>自身最大生命值的生命，【钢铁回旋】在自身处于控制效果时依然可以释放。",
	[90030203843] = "免疫斩杀效果，受到伤害时，立即获得一个等同于自身<color=#5bdf99>120%</color>防御力的护盾，护盾持续<color=#5bdf99>1</color>秒。",
	[90030203844] = "朝敌方最密集区域投掷血斧，对范围内敌人累计造成<color=#5bdf99>240%</color>攻击力的物理伤害并减少目标<color=#5bdf99>50%</color>移动速度，每次伤害都会额外减少目标<color=#5bdf99>8%</color>伤害减免，持续<color=#5bdf99>5</color>秒，最多可叠加<color=#5bdf99>3</color>层。",
	[90030203845] = "【变身】此状态下，攻击速度提高<color=#5bdf99>35%</color>，闪避率提高<color=#5bdf99>45%</color>。",
	[90030203846] = "【变身】此状态下，防御力提高<color=#5bdf99>50%</color>，伤害减免提高<color=#5bdf99>20%</color>。",
	[90030203847] = "<color=#FF5656>【负面·减益】</color>每层减少<color=#5bdf99>10%</color>防御力和<color=#5bdf99>5%</color>攻击速度，持续<color=#5bdf99>10</color>秒，最多可迭加<color=#5bdf99>10</color>层。",
	[90030203848] = "<color=#FF5656>【负面·减益】</color>每层减少<color=#5bdf99>10%</color>命中率和<color=#5bdf99>5%</color>攻击力，持续<color=#5bdf99>10</color>秒，最多可迭加<color=#5bdf99>10</color>层。",
	[90030203849] = "【专属效果】无法被驱散、窃取或转移，永久提高自身<color=#5bdf99>1%</color>破甲和暴击伤害，最多可迭加<color=#5bdf99>50</color>层。",
	[90030203850] = "获得<color=#5bdf99>1</color>次控制免疫并进入短暂的不可选中状态，瞬移至敌方生命值最低的英雄身后，对前方范围的敌人造成<color=#5bdf99>200%</color>攻击力的物理伤害并附着<color=#5bdf99>2</color>层“暗蚀”，此次伤害自带<color=#5bdf99>50%</color>暴击率。",
	[90030203851] = "对首个触碰的敌人造成<color=#5bdf99>150%</color>攻击力的物理伤害并附着<color=#5bdf99>3</color>层“暗蚀”，并在后续<color=#5bdf99>3</color>秒，每秒对范围内的敌人造成<color=#5bdf99>40%</color>攻击力的物理伤害并附着<color=#5bdf99>1</color>层“暗蚀”。",
	[90030203852] = "【专属效果】无法被驱散、窃取或转移，永久减少<color=#5bdf99>8%</color>护盾和治疗获取效率，最多可叠加<color=#5bdf99>10</color>层。",
	[90030203853] = "【专属效果】无法被驱散、窃取或转移，对处在血池中的敌人造成普攻和技能伤害时，提高<color=#5bdf99>4%</color>吸血和<color=#5bdf99>6%</color>攻击速度，持续<color=#5bdf99>5</color>秒，最多可叠加<color=#5bdf99>8</color>层。",
	[90030203854] = "<color=#FF5656>【负面·持续伤害】</color>每秒损失<color=#5bdf99>4%</color>最大生命值，持续<color=#5bdf99>5</color>秒。",
	[90030203855] = "<color=#FF5656>【负面·减益】</color>攻击力和防御力随生命值的降低而降低，至多降低<color=#5bdf99>60%</color>，持续<color=#5bdf99>4</color>秒。",
	[90030203856] = "【专属效果】无法被驱散、窃取或转移，降低<color=#5bdf99>15%</color>防御以及<color=#5bdf99>10%</color>急速，持续<color=#5bdf99>4</color>秒，至多可叠加<color=#5bdf99>6</color>层。",
	[90030203857] = "【专属效果】无法被驱散、窃取或转移，提高<color=#5bdf99>15%</color>攻击速度以及<color=#5bdf99>6%</color>生命偷取，持续<color=#5bdf99>3</color>秒，最多可叠加<color=#5bdf99>5</color>层。",
	[90030203858] = "【专属效果】无法被驱散、窃取或转移，获得青龙的部分攻击力、防御力和破甲，根据青龙的当前血量，至多可获得<color=#5bdf99>80%</color>。",
	[90030203859] = "“沉默”目标<color=#5bdf99>4</color>秒，每秒汲取其<color=#5bdf99>150</color>点法力值并在其位置召唤持续<color=#5bdf99>4</color>秒的腐化领域。",
	[90030203860] = "【专属效果】无法被驱散、窃取或转移，获得<color=#5bdf99>200%</color>最大生命值的护盾和青龙临死前<color=#5bdf99>40%</color>的基础属性，护盾存续期间，获得<color=#5bdf99>55%</color>伤害减免。",
	[90030203861] = "降低范围内敌人<color=#5bdf99>60%</color>防御和<color=#5bdf99>40%</color>急速效果，每秒对目标造成其<color=#5bdf99>5%</color>最大生命值，持续<color=#5bdf99>4</color>秒。",
	[90030203862] = "<color=#FF5656>【负面·减益】</color>“冰冻”目标<color=#5bdf99>1</color>秒 ，效果持续期间目标无法获得增益效果。",
