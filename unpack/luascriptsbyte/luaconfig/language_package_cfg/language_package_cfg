	[90029100101] = "鬼门大开",
	[90029100102] = "夏侯惇可以通过不断地召唤赤鬼，持续的增加己方的输出。",
	[90029100201] = "恶鬼缠身",
	[90029100202] = "激活灵脉后，夏侯惇带着赤鬼的集火攻击，很容易让敌方的主力瞬间陨落。",
	[90029100301] = "地狱重现",
	[90029100302] = "夏侯惇的魂链效果可使场上的赤鬼出生的更快，配合镜池刀山的反伤效果，将会成为大范围攻击者的噩梦。",
	[90029110101] = "剑气如虹",
	[90029110102] = "铁卒是一名神属性迅捷角色，能持续对面前的目标造成大量伤害，并在释放怒气技时隐没于自身的剑阵之中，让敌人无踪可寻。",
	[90029110201] = "无懈可击",
	[90029110202] = "激活魂链后，铁卒对面前的目标可以造成更多的伤害，同时对于贸然出现在身边的敌方角色，也有了新的应对手段，可谓攻守兼备。",
	[90029110301] = "剑神临世",
	[90029110302] = "铁卒的灵脉效果可使自身的输出提升至极限，怒气技技能范围的提升更是可以覆盖更多的战斗区域，使目标无处可遁，感受绝望吧。",
	[90029120101] = "以命相搏",
	[90029120102] = "黄盖是一名消耗自身血量释放技能，同时自身血量百分比越低自身效果越强的女神，在小规模战斗中，此优势尤为突出。",
	[90029120201] = "盖以诱敌",
	[90029120202] = "激活魂链后，黄盖针对多段攻击的目标时，可快速叠满减伤和增伤，进可攻退可守，方能立于不败之地。",
	[90029120301] = "勇冠三军",
	[90029120302] = "灵脉技能的激活对黄盖来说犹如如虎添翼，在紧急时刻的换血常常可以瞬间改变战场局势，对战局的胜负起到关键性的作用。",
	[90029130101] = "剑影惊鸿",
	[90029130102] = "干将莫邪·剑形态是一名神属性辅助角色，依靠侍主作战方式协助我方战力最高的单位，极大的提高“剑主”的属性和生存能力。",
	[90029130201] = "神意双行",
	[90029130202] = "干将莫邪·剑形态的魂链效果可源源不断的为“剑主”提供法力支援，让依靠绝技创造优势的“剑主”更具实力。",
	[90029130301] = "万籁寂灭",
	[90029130302] = "激活灵脉后，可极大强化“剑主”的生存能力。",
	[90029140101] = "睚眦必报",
	[90029140102] = "普攻命中目标多次后，使用绝技攻击目标可瞬间造成大量伤害",
	[90029140201] = "水淹七军",
	[90029140202] = "关姬的魂链效果可大量增加自身的暴击几率以及暴击伤害，使其短时间内的单体爆发更加的出众。",
	[90029140301] = "谁与争锋",
	[90029140302] = "关姬激活灵脉后，可对被控制的单位额外造成伤害，配合控制形的队友，可以瞬间造成巨量伤害。",
	[90029150101] = "和风暖絮",
	[90029150102] = "诸葛一心是一名风属性辅助角色，擅长与不同职业的友方搭配，提供全面的辅助和高额的减伤能力。",
	[90029150201] = "气意长明",
	[90029150202] = "激活魂链后的诸葛一心可使全队能更稳定的应对擅长制造爆发伤害的敌人。",
	[90029150301] = "飞叶风花",
	[90029150302] = "诸葛一心的灵脉点亮后，可极大地加速诸葛一心对敌方阵容的压制能力，并更早的为我方全体提供增益和治疗。",
	[90029160101] = "杀意冲霄",
	[90029160102] = "貂灵芸是一名神属性战士角色，能通过快速衔接的技能对敌人造成海量的伤害。",
	[90029160201] = "饮战轮回",
	[90029160202] = "貂灵芸的魂链效果可以通过连续施放技能来为其带来强大的生存能力。",
	[90029160301] = "凌威恣意",
	[90029160302] = "貂灵芸点亮灵脉后，可大大提升她在第一轮爆发之后的持续作战能力。",
	[90029170101] = "初窥迷宫",
	[90029170102] = "牛头战士是一名土属性圣盾角色，当其周围的敌方单位较多时，自身释放技能后可获得多重强化，并给敌人添加多重减益效果。",
	[90029170201] = "恶兽觉醒",
	[90029170202] = "牛头战士的魂链效果可以使其拥有强大的单体爆发与控制效果，及时周围的敌方单位数量不足时，也可以有一战之力。",
	[90029170301] = "毁灭巨袭",
	[90029170302] = "牛头战士点亮灵脉后，可大大提升他在战斗中的持续输出，同时在其死亡时，会将大部分敌方聚在一起，方便队友将其击杀。",
	[90029180101] = "魔焰盈天",
	[90029180102] = "盖文是一名火属性圣盾角色，能和制造点燃的队友相互配合造成爆发性的伤害。",
	[90029180201] = "女神之志",
	[90029180202] = "盖文的魂链效果能有效地保护我方后排的脆弱队友，为积累爆发创造环境。",
	[90029180301] = "黯翳逐光",
	[90029180302] = "盖文点亮灵脉后，能大幅提高对隐身敌人的压制力，使其在隐身状态下难有作为。",
	[90029190101] = "天下无双",
	[90029190102] = "吕布是一名神属性圣盾角色，拥有骑乘和步战双形态作战方式，骑乘状态下能极其高效地压缩敌方阵型，并持续造成控制。",
	[90029190201] = "历战群雄",
	[90029190202] = "吕布的魂链效果能在开战和作战途中巨额提高自身属性并永久削弱敌人，能对自身的生存和输出能力提供核心保障。",
	[90029190301] = "勇率三军",
	[90029190302] = "点亮灵脉后，吕布能在步战状态下先手取得巨额优势，并为队友提供源源不断的增援。",
	[90029200101] = "江东霸王",
	[90029200102] = "孙策是一名雷属性战士角色，拥有快速的法力积累能力和高额的单体输出伤害，且拥有遇强则强的战斗特性。",
	[90029200201] = "天命英主",
	[90029200202] = "孙策的魂链效果可大幅强化自身的被动特性，并将自身的法力获取能力扩散到我方全体。",
	[90029200301] = "威风赫赫",
	[90029200302] = "孙策点亮灵脉后，可化身团队辅助，为全体队友提供高额的攻防加成。",
	[90029201011] = "总有一天，我会超越哥哥！必须得加紧训练才行！你觉得我应该从什么训练开始呢？",
	[90029201012] = "负重训练",
	[90029201013] = "是吗？不错的建议！我必须开始加油了。",
	[90029201014] = "敏捷训练",
	[90029201015] = "好想法！得赶快开始训练才行",
	[90029201021] = "来得正好！最近我正在尝试新的菜谱，要来试试吗？",
	[90029201022] = "品尝水煮鱼",
	[90029201023] = "怎么样？怎么样？",
	[90029201024] = "品尝西红柿炒鸡蛋",
	[90029201025] = "好吃吗？是不是应该再多放些盐。",
	[90029201031] = "哥哥他们已经出去有一段时间了，也不知道怎么样了？",
	[90029201032] = "发一封言灵信过去试试吧",
	[90029201033] = "对啊，我怎么没想到，这就去发一封，谢谢！对了，这是我最近在练功时找到得东西，送给你吧。",
	[90029201034] = "加紧训练",
	[90029201035] = "说的对，我答应过哥哥要好好守护这条街，得加紧训练才行。",
	[90029201111] = "最近我在巡视罗剎街时发现了这个，或许你应该用得上",
	[90029202011] = "早啊，我正要和李轩辕出去逛逛，有什么推荐的地方吗？",
	[90029202012] = "明镜村",
	[90029202013] = "对啊，上次李轩辕给了黄伯一些丹药，这次正好过去看看。",
	[90029202014] = "空神之森",
	[90029202015] = "空神之森吗？上次被曹焱兵那个笨蛋给烧过后就没去，这次过去看看也可以，谢谢你咯。",
	[90029202021] = "最近我和李轩辕正要去一趟花谷，有喜欢的花吗？到时候给你采一点。",
	[90029202022] = "百合花",
	[90029202023] = "百合花吗？它花语好像有纯洁和健康，挺不错的，是要送给情人吗？",
	[90029202024] = "杜鹃花",
	[90029202025] = "杜鹃花？我还蛮喜欢的，是打算送给某个朋友吗？",
	[90029202031] = "最近有个叫代号：破晓的手游上线了，要一起玩玩看吗？",
	[90029202032] = "这就去下载",
	[90029202033] = "真的？等会进游戏了记得加我好友哦。",
	[90029202034] = "不太会玩…",
	[90029202035] = "没事，本小姐可是很强的，到时候带你玩。",
	[90029202111] = "我购物得时候发现了这个，想着你应该用得上就买了，嘿嘿。",
	[90029203011] = "有人天生为王，有人落草为寇，你是哪一种呢？",
	[90029203012] = "我就是我",
	[90029203013] = "这……出乎预料的回答，不愧是你，有趣。",
	[90029203014] = "（无视）",
	[90029203015] = "啧，真没意思。",
	[90029203021] = "哦？你想知道我眼里曹焱兵是个什么样的人，那么在你眼中，他是一个什么样的人呢？",
	[90029203022] = "狂妄自大",
	[90029203023] = "哈哈哈哈，我就知道会是这样，脾气差又自大，整天谁都欠他钱似的，但其实它还是很看重自己的朋友和亲人的，对于自己的目标也特别明确。",
	[90029203024] = "好人？",
	[90029203025] = "唔，也算是吧。在我眼里他有成王之姿，但还缺少历练，希望这次出去能弥补缺少的能力吧。",
