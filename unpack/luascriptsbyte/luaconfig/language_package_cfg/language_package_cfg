	[90022600068] = "<color=#018e43>中军</color>入场提供支援，可<color=#018e43>上阵2人</color>。能形成短时间的以多打少，或是为后军入场提供控场支援。",
	[90022600069] = "<color=#018e43>后军上阵3人</color>是作为终结敌方的最后手段，后军的终结也依赖前面的女神提供保护。",
	[90022600070] = "更多样的战术和策略搭配，还需要各位冒险者亲自尝试！让我们赶快一场决斗吧！",
	[90022600071] = "激烈的战斗可能会让女神在<color=#018e43>海皇神殿</color>中迷失并<color=#018e43>阵亡</color>。",
	[90022600072] = "但是不用担心，完成日常任务可获得<color=#018e43>女神之泪</color>。",
	[90022600073] = "<color=#018e43>女神之泪</color>可帮助女神恢复，继续挑战<color=#018e43>海皇神殿</color>。",
	[90022600074] = "欢迎参与<color=#018e43>问鼎灵域</color>，在这里和战区内的各路高手一较高下！参与的<color=#018e43>赛事级别</color>越高，排名越靠前，奖励越丰厚。",
	[90022600075] = "在<color=#018e43>问鼎灵域</color>中，各位冒险者可根据自身实力选择报名参赛级别。参赛后，无法更改参赛的<color=#018e43>赛事级别</color>。",
	[90022600076] = "点击<color=#018e43>布阵</color>",
	[90022600077] = "<color=#018e43>问鼎灵域</color>不同的<color=#018e43>赛事级别</color>，需要上阵的队伍数量也不相同。",
	[90022600078] = "让我们先上阵一支防守队伍，在<color=#018e43>繁星赛事</color>中证明自己的实力。",
	[90022600079] = "<color=#018e43>繁星赛事</color>可以上阵一支队伍进行搏杀。在赛季结束前赢得更高的名次将会获得更多、更优质的<color=#018e43>首饰奖励</color>。",
	[90022600080] = "在<color=#018e43>情报</color>中可以看到关卡的信息，<color=#018e43>首领页签</color>可查看当前首领的<color=#018e43>技能介绍</color>。",
	[90022600081] = "<color=#018e43>推荐女神</color>可查看<color=#018e43>适合上阵</color>的女神。",
	[90022600082] = "<color=#018e43>战斗指引</color>中可以看到<color=#018e43>重点介绍</color>，以及攻略<color=#018e43>小窍门</color>。",
	[90022600083] = "<color=#018e43>百抽狂欢</color>已开启！",
	[90022600084] = "次日可获得<color=#018e43>五行自选女神</color>，可自选核心五行女神增强实力。",
	[90022600085] = "<color=#018e43>百抽狂欢</color>可在八日领取<color=#018e43>100连抽召唤卷轴</color>！",
	[90022600086] = "<color=#018e43>圣兽</color>已开放，各位冒险者大人能在这里获得心仪的<color=#018e43>圣兽</color>",
	[90022600087] = "召唤灵宠可是门技术活，让我们先试试能否得到灵宠的青睐。",
	[90022600088] = "召唤灵宠需要<color=#018e43>封宠卷轴</color>，我这恰好有一张。",
	[90022600089] = "点击任意界面关闭奖励",
	[90022600090] = "请点击返回",
	[90022600091] = "让我们来<color=#018e43>合成</color>获得的灵宠。",
	[90022600092] = "请点击合成",
	[90022600093] = "点击任意界面合成成功界面",
	[90022600094] = "请点击返回",
	[90022600095] = "让我们上阵灵宠",
	[90022600096] = "请选择要上阵的灵宠",
	[90022600097] = "请点击确认",
	[90022600098] = "<color=#018e43>特定灵宠</color>可激活对应<color=#018e43>羁绊</color>，更多的组合，还需要各位冒险者大人自行探索啦！",
	[90022600099] = "<color=#018e43>起源召唤</color>已开放，各位冒险者大人能在此获得<color=#018e43>特定灵宠</color>",
	[90022600100] = "点击这里可以更换至心仪的灵宠",
	[90022600101] = "<color=#018e43>灵宠</color>各有特色，还请冒险者大人选择对自身阵容体系更有搭配的<color=#018e43>灵宠</color>",
	[90022600102] = "<color=#018e43>义结金兰</color>已开放，各位冒险者可在此结交挚友，合力完成任务，赢取奖励。",
	[90022600103] = "点击这里结识，寻找志趣相投的好友吧。",
	[90022600104] = "<color=#018e43>千抽自选</color>已开放，可在这里<color=#018e43>抽取多次十连</color>并自选获得的女神。",
	[90022600105] = "<color=#018e43>千抽自选</color>已可领取，期待更多女神的加入吧",
	[90022600106] = "满足特定条件可进行<color=#018e43>多轮女神自选</color>。",
