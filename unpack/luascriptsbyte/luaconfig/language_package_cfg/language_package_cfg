	[10100001491] = "投降吧！",
	[10100001492] = "成为我的食物吧！",
	[10100001493] = "休想从这里过去！",
	[10100001494] = "这招你能接住吗？",
	[10100001495] = "去死吧！丑陋的群英！",
	[10100001496] = "不过是个群英，也敢与我作对？",
	[10100001497] = "现在交出守护灵还来得及。",
	[10100001498] = "敬酒不吃吃罚酒！",
	[10100001499] = "来尝尝痛苦的滋味吧！",
	[10100001500] = "嗷！",
	[10100001501] = "吼吼！",
	[10100001502] = "嗷吼吼吼吼！！！",
	[10100001503] = "吼——",
	[10100001504] = "我被操控了，快打败我！",
	[10100001505] = "好痛苦……",
	[10100001506] = "我无法控制自己身体……",
	[10100001507] = "啊啊啊啊！",
	[10100001508] = "好害怕……",
	[10100001509] = "那怪物要来了！",
	[10100001510] = "救命！",
	[10100001511] = "冒险者大人……",
	[10100001512] = "找到了……群英的味道……杀……",
	[10100001513] = "我要更多……鲜血……",
	[10100001514] = "嘶嘶……嘶……",
	[10100001515] = "“一个也不能放过。”嗯，他是这样说的。",
	[10100001516] = "黑尔坎普大人的计划非常顺利。继续看守这里。",
	[10100001517] = "黑尔坎普大人，一切如您所愿。",
	[10100001518] = "糟了！灵槐树！",
	[10100001519] = "我还是来迟了一步。",
	[10100001520] = "鬼符三通？你来做什么？",
	[10100001521] = "灵槐已经被毁，曹焱兵，这件事你恐怕难辞其咎。",
	[10100001522] = "不过，仔细一看并非没有挽回的可能。\n灵槐乃千年神树，只要集齐龙桃果、帝榆叶、扶桑花这三样东西，便可复苏灵槐。",
	[10100001523] = "这三样东西散布在冥界各处，要想找齐它们，你们必须离开罗刹街，前往凶险的广阔冥域才行。",
	[10100001524] = "灵槐是父母留下的东西，我就是走遍天涯海角也要找到这三样东西。",
	[10100001525] = "没错，能复苏灵槐，离开这里又何妨！",
	[10100001526] = "嗯？奇怪，这种法力充盈的感觉……我好像看到了什么东西？",
	[10100001527] = "既然已经决定离开，我们就准备出发吧！鬼符三通，后会有期！",
	[10100001528] = "原来我隐藏着这样的力量……",
	[10100001529] = "不行不行，不能想这些！得快些找到曹焱兵。\n这个路口有点眼熟，顺着这条路应该能找到他。",
	[10100001530] = "鬼符三通，你还在吗？这里究竟发生了什么？",
	[10100001531] = "喂，你也是住在附近的小孩吗？跟我一起逃吧！",
	[10100001532] = "收到一封灵言信。",
	[10100001533] = "为了能来这里，我一连闯过五条罗刹街。你们冒险者真是徒有虚名，我一口气就将他们全解决掉了。而下一个就是你，曹焱兵。",
	[10100001534] = "只是万物皆有枯荣，神仙也有寿终的一天。他归西后化为一颗菩提树，世世代代保护着咱们。",
	[10100001535] = "在这险恶的镇魂街，能有这样平静的生活，大家都心存感激。不仅是对门大人，也为了菩提树下的神灵……啊，我是不是说太多了？",
	[10100001536] = "灵域力量衰微，王国势力蠢蠢欲动。#在此希望诸位联合起来对抗王国势力。",
	[10100001537] = "鬼符三通",
	[10100001538] = "最近我们住所附近被恶灵包围，还望大人快来化龙巷救救我们。",
	[10100001539] = "某居民",
	[10100001540] = "最近我们住所附近被恶灵包围，还望大人快来化龙巷救救我们。",
	[10100001541] = "化龙巷居民",
	[10100001542] = "\t你说的秘术我略有耳闻，那是一种以法力施加的咒术。若真是王国的人所为，那十之八九是一个叫黑尔坎普的人，王国里只有他会操纵之术。",
	[10100001543] = "请先击败先锋小怪。",
	[10100001544] = "我是怎么走到这里来的？",
	[10100001545] = "愿清风化煞化解一切伤痛。",
	[10100001546] = "姬烟华",
	[10100001547] = "曹焱兵，把你的十殿阎罗借我玩玩！不给？别这么小气嘛，我不会转手卖掉的。",
	[10100001548] = "灵槐被毁有我的责任，我才不会当缩头乌龟呢。",
	[10100001549] = "呼，刚刚好险……学过的跆拳道总算在实战中派上用场了。",
	[10100001550] = "总之得离开这里才行！再来几个我可招架不住。",
	[10100001551] = "不，你来得太及时了！总之，我们一起去找曹焱兵吧。",
	[10100001552] = "还是找不到那两个孩子。",
	[10100001553] = "两个孩子该不会跑到恶灵出没的地方了吧！",
	[10100001554] = "希望他们千万别遇上什么危险。",
	[10100001555] = "你们有看见附近有两个这么高的小孩吗？",
	[10100001556] = "没见过。有孩子走丢了吗？",
	[10100001557] = "是啊，再往外走就是恶灵出没的地方了，这可怎么办才好！",
	[10100001558] = "夏铃、小亮，我们去附近帮忙找找吧。",
	[10100001559] = "曹焱兵前往密林深处。",
	[10100001560] = "*嘶吼* 吼吼吼——",
	[10100001561] = "你、你别过来！\n不、不然我们就、就不客气了！",
	[10100001562] = "找到了！",
	[10100001563] = "谢谢你们，你们是？",
	[10100001564] = "我们是路过这里的冒险者，听说村里有孩子走丢了，就来找你们了。你们怎么会跑到这么危险的地方来？",
	[10100001565] = "原来是冒险者大人，怪不得这么厉害！对不起，下次一定不会来这种地方玩了。",
	[10100001566] = "走吧，我们护送你回去，村里人还在等你们呢。",
	[10100001567] = "这是？",
	[10100001568] = "这是明镜村为了不被外界打扰在村外设下的机关。",
	[10100001569] = "我记得这里的机关按顺序踩下即可，顺序和颜色有关。那座石雕里藏着关于颜色的提示。",
	[10100001570] = "到了，再往前面走就是明镜村了。",
	[10100001571] = "这里就是明镜村？好美啊……\n焱兵你看，那棵树是不是四颗神树之一的……龙桃树？",
	[10100001572] = "嗯。",
	[10100001573] = "水儿！",
	[10100001574] = "啊！是门司令！",
	[10100001575] = "是你们救了这两个孩子吗？",
	[10100001576] = "大人不必言谢，我是罗刹街冒险者曹焱兵，救助幽灵是我分内之事。",
	[10100001577] = "不过我们赶了好几天路，正在找歇脚的地方，若是明镜村有一间让我们容身的屋子就帮大忙了。",
	[10100001578] = "曹焱兵？\n唔……老张，我看孩子们受伤了，麻烦你先带他们回去吧。",
	[10100001579] = "好嘞。孩子们，大家伙，我们先回去吧。",
	[10100001580] = "早就听闻曹当家的传闻，今日一见，女神不仅气度不凡，更有侠肝义胆，令我欣赏敬佩。",
	[10100001581] = "这是什么意思？",
	[10100001582] = "北落师门递来一张印着灵域标识的灵言信。",
	[10100001583] = "这是？",
	[10100001584] = "各镇魂街将领",
	[10100001585] = "罗刹街将领曹焱兵毁坏神树灵槐，现予以通缉。请接到此通告后，立即开始搜查工作。",
	[10100001586] = "没错，曹当家，罗刹街神树被毁一事，灵域已经降罪，正四处捉拿“逃犯”曹焱兵。",
	[10100001587] = "虽然不清楚罗刹街究竟发生了什么，但既然你对我们有恩，这次我就当作没见过你，也会嘱咐村里人不向外宣扬此事。",
	[10100001588] = "但进入明镜村一事，恕我不能答应你。",
	[10100001589] = "“逃犯”……我明白了。",
	[10100001590] = "那么保重了，曹当家。好自为之吧。",
	[10100001591] = "对不起，大哥哥。其实北落大人是个大好人，不过他也很有原则……还请你们不要怪他。",
	[10100001592] = "我会记住你们的恩情的，我想北落大人也一样。这个，请你收下。",
	[10100001593] = "白水儿递来一面镜子。",
	[10100001594] = "这是菩提树根做的镜子，它的神力会保护你们的。",
	[10100001595] = "怎么办，哥哥，龙桃的神珠我们还没拿到呢，就这样走了吗？",
	[10100001596] = "没办法，我们背负着逃犯的身份，只能先离开，再去想其他办法了。",
	[10100001597] = "不过我们赶了好几天路，正在找歇脚的地方，若是明镜村有一间让我们容身的屋子就帮大忙了。",
	[10100001598] = "灵域",
	[10100001599] = "看来夏铃还没有顺利逃跑。\n曹当家的，快去罗刹街找她吧，情况紧急，说不定现在已经遇到危险了。",
	[10100001600] = "哦？谁寄来的灵言信？给我看看。",
	[10100001601] = "我还有别的事要处理，不能陪你继续前进了，你要多加小心。",
	[10100001602] = "顺序好像不对哦！",
	[10100001603] = "老张",
	[10100001604] = "不过，正因如此，我不能收留你们。",
	[10100001605] = "我是明镜村的冒险者北落师门，可否请这位女神来寒舍小坐，我再好好向你们致谢。",
	[10100001606] = "快到明镜村了，记住，一会儿按原计划行事，我不信北落师门不肯交出神珠。",
	[10100001607] = "大人，有人从那边来了，不像是明镜村的人。",
	[10100001608] = "天市，你派两队羽林军去探一探。",
	[10100001609] = "是。",
	[10100001610] = "我们朝这边走应该能避开羽林街的人，对吧，小亮？",
	[10100001611] = "嗯！地图上是这样写的。",
	[10100001612] = "密林中忽然钻出一队士兵，将曹焱兵团团围住。",
	[10100001613] = "这、这是？",
	[10100001614] = "是羽林军！大家当心！",
	[10100001615] = "呵呵，让我看看，原来是大名鼎鼎的曹当家啊。\n给我抓住这个逃犯！",
	[10100001616] = "什么！羽林军居然被……\n天市、紫薇，抓住他！",
	[10100001617] = "慢着！",
	[10100001618] = "御夫老弟，谢谢你啦！我找这家伙找好久了。",
	[10100001619] = "门司令？你来做什么，你认识这个逃犯？",
	[10100001620] = "还叫我门司令呐？现在的司令可是你御夫老弟，我的好兄弟。",
	[10100001621] = "好兄弟，这曹焱兵与我素有过节，今日他沦为逃犯，我正想趁此机会出一口恶气。",
	[10100001622] = "不如你将他交给我，事后我会将他押送到你府上，人还是你抓的。",
	[10100001623] = "既然北落大哥这么说，那这人就交给你吧！\n紫薇、天市、太微，我们走！",
	[10100001624] = "多谢门大人解围。",
	[10100001625] = "谢谢白水儿吧，是她的铜镜感应到血光之灾，我才知道你们在这里的。",
	[10100001626] = "而且，别谢得太早，我有我的原则。\n我们较量一场吧，若你赢了我，就放你走，你输了，就跟我去羽林街报导。",
	[10100001627] = "乐意奉陪。",
	[10100001628] = "又要打？真的没问题吗……",
	[10100001629] = "刚才的战斗让你很累了吧？为了公平起见，明天早上7点，你再到村口棚石外找我。",
	[10100001630] = "看来我们得找个安全的地方好好休息一晚，明天一定是一场恶战了。",
	[10100001631] = "这里看起来很平静，就在这歇一晚吧。",
	[10100001632] = "喂，你们，也是旅行者吗？",
	[10100001633] = "那人在招呼我们，去听听他想说什么吧。",
	[10100001634] = "旅行者",
	[10100001635] = "哇，小亮，想不到你的厨艺这么好，真是人不可貌相。",
	[10100001636] = "哈哈，其实哥哥不在家的时候都是我负责做饭，孰能生巧罢了。",
	[10100001637] = "真是的，也不知道到底谁是哥哥谁是弟弟。",
	[10100001638] = "少啰嗦，快吃饭吧你们……",
	[10100001639] = "嬉笑间，三人平安地度过了一夜。",
	[10100001640] = "天快亮了，走吧，让我们去会会北落师门。",
	[10100001641] = "来了？",
	[10100001642] = "我先声明，我不会因为你救过村里的孩子就对你放水。我会全力以赴，以打倒你为目标与你作战。",
	[10100001643] = "我知道。",
	[10100001644] = "很好，那么我们开始吧。",
	[10100001645] = "这趟旅程总算有点意思了。",
	[10100001646] = "哼，你的样子总让我想起我年轻的时候。\n今天就到此为止吧，和老张喝茶的时间到了。",
	[10100001647] = "你的意思是？",
	[10100001648] = "“北落师门在与曹焱兵战斗中失误，让逃犯曹焱兵趁机溜走”——听起来很顺耳。",
	[10100001649] = "太好了焱兵！",
	[10100001650] = "嗯，可惜战斗还没有分出胜负，下次有机会见面，再和你较量。",
	[10100001651] = "一言为定。",
	[10100001652] = "小阿瞒，让我见识见识你的实力！",
	[10100001653] = "狂鲨双极！",
	[10100001654] = "任狂风骤雨，不可摧灭吾志！",
	[10100001655] = "<color=#4FABF2FF>天道自然，相生相克</color>",
	[10100001656] = "曹当家，你可知道不同属性的角色搭配上阵，会获得出乎意料的效果呢？",
	[10100001657] = "所谓善用兵者，可以少敌多。\n布阵时请多多利用不同属性搭配的阵型规律，获得加成效果吧。",
	[10100001658] = "典韦",
	[10100001659] = "哈哈哈哈哈！吾辈可以帮你！\n不过，我不接受比我弱小的主公！若想让我帮你，就与我一较高下吧！",
	[10100001660] = "你是……潜伏在我内心深处的守护灵——典韦？\n好！我接受挑战！",
	[10100001661] = "解开禁锢吧！",
	[10100001662] = "哇……",
	[10100001663] = "搭配阵型，获得增益。",
	[10100001664] = "探索人灵新技能，战术出击。",
	[10100001665] = "你没事吧？",
	[10100001666] = "能站起来吗？",
	[10100001667] = "啊……谢谢……",
	[10100001668] = "谢谢……",
	[10100001669] = "决斗",
	[10100001670] = "我是水属性寄灵人，可以更有效地克制火属性灵体。让我为你助战吧！",
	[10100001671] = "谜语里依次出现<color=#c94252>“红”</color>、<color=#4e81de>“蓝”</color>、<color=#ddc04e>“黄”</color>三种颜色，按照顺序踩踏对应颜色的踏板，就可以解开机关了。",
	[10100001672] = "第三关的谜语是……",
	[10100001673] = "这次的颜色有四种呢。\n谜语中颜色的顺序依次是：<color=#c94252>“红”</color>、<color=#6c9a3b>“绿”</color>、<color=#ddc04e>“黄”</color>、<color=#4e81de>“蓝”</color>。快试试吧。",
	[10100001674] = "哇，真的可以耶！",
	[10100001675] = "太好了，看来我没记错。",
	[10100001676] = "这样应该就可以了。",
	[10100001677] = "别在罗刹街作恶了，束手就擒吧。",
	[10100001678] = "可恶……那丫头的守护灵竟然这样强。",
	[10100001679] = "不过，寄灵人消失的话，守护灵也会没有容身之地了吧。",
	[10100001680] = "一瞬间，黑尔坎普向夏铃攻去。",
	[10100001681] = "糟了！他想攻击夏铃姐姐！",
	[10100001682] = "别想得逞！",
	[10100001683] = "东风吹遍原野",
	[10100001684] = "但无言",
	[10100001685] = "红绿自纷纷",
	[10100001686] = "红烛落",
	[10100001687] = "蓝绡鼓",
	[10100001688] = "寂寞梢头黄月苦",
	[10100001689] = "怅望兽炭陈红炉",
	[10100001690] = "问绿水、黄竹何处",
	[10100001691] = "雪啸蓝关",
	[10100001692] = "雪啸蓝关",
	[10100001693] = "糟了，灵槐树被击中了！",
	[10100001694] = "看来是我来晚了。",
	[10100001695] = "（灵槐树……鬼符三通？可恶，那个神秘的寄灵人，他这时候来做什么？）",
	[10100001696] = "灵槐树已经被破坏到这种程度，曹当家的恐怕难辞其咎。",
	[10100001697] = "不过，根部还未损坏——别担心，就交给我吧！",
	[10100001698] = "鬼符三通使用四方真如封印术封印了被毁坏的神树，阻止了神树法力的流失。",
	[10100001699] = "可恶，都是我的错，是我回来晚了，才让这样的事情发生。",
	[10100001700] = "这件事，也有我的责任……",
	[10100001701] = "别急，灵槐乃千年神树，并非没有恢复的可能。",
	[10100001702] = "据我所知，冥界除却灵槐，还有另外三棵神树，只要集齐另外三棵的果实，便可复苏灵槐。",
	[10100001703] = "另外三颗吗？我记得应该是龙桃树、扶桑树和帝榆树吧。",
	[10100001704] = "没错，这三样东西散布在冥界各处。\n要想找齐它们，你们必须离开罗刹街，前往镇魂街其他区域。",
	[10100001705] = "不过这样一来，前路可就生死未卜了。",
	[10100001706] = "你们，有这样的勇气吗？还是说，想找一条逃亡的路逃避冥域的追捕？",
	[10100001707] = "不，灵槐是父母留下的东西，我就是走遍天涯海角也要找到这三样东西。",
	[10100001708] = "没错，能复苏灵槐，离开这里又何妨！",
	[10100001709] = "灵槐被毁有我的责任，我才不会当缩头乌龟呢。",
	[10100001710] = "那么祝你好运了，曹当家。",
	[10100001711] = "（呵，虽然跟计划有些偏差，不过，还在可控制范围内。\n接下来会怎么样呢？让我拭目以待吧。）",
	[10100001712] = "南御夫趁北落不在，屠戮村民，烧毁房舍，抢走了神话果。",
	[10100001713] = "南御夫！我跟你拼了！",
	[10100001714] = "哼，住手吧，看看这是谁？",
	[10100001715] = "门大人……",
	[10100001716] = "拿水儿做人质？南御夫，你卑鄙！",
	[10100001717] = "想要放她走，先给我跪下，然后戴上锁灵石，跟我们回去。",
	[10100001718] = "门大人，不用管我……快替、替乡亲们报仇！",
	[10100001719] = "果然还是没办法吗……",
	[10100001720] = "门大人？",
	[10100001721] = "北落！这就是你的选择吗？",
	[10100001722] = "你可要想清楚，带上锁灵石，你就不能再使用法力，而我也将封存在你内心之中。",
	[10100001723] = "灵明兄，我的人生已经输了。\n这种时候，拿女儿的性命做赌注，我做不到。",
	[10100001724] = "女儿？",
	[10100001725] = "没错，你生前是北落师门的独生女。",
	[10100001726] = "你是因为亲生父亲的过失才去世的，而他为了让你忘记对他的憎恨，才带你来到菩提街。",
	[10100001727] = "因为菩提神珠的法力可以令人忘记一切痛苦！",
	[10100001728] = "啊，头好痛！",
	[10100001729] = "我好像想起来了……全都想起来了……",
	[10100001730] = "对不起，水儿……",
	[10100001731] = "好了，别哭哭啼啼的了，给我把北落师门带回羽林街！",
	[10100001732] = "这是幽灵留下的，它应该还在不远处。\n这附近恐怕有危险，大家谨慎前进吧。",
	[10100001733] = "血迹？",
	[10100001734] = "这是幽灵留下的，它应该还在不远处。\n这附近恐怕有危险，大家谨慎前进吧。",
	[10100001735] = "是水儿！",
	[10100001736] = "可恶，我们离开这阵子，明镜村究竟发生了什么？",
	[10100001737] = "李轩辕，你快看看水儿的情况怎么样。",
	[10100001738] = "遵命。",
	[10100001739] = "怎么样，李轩辕？",
	[10100001740] = "不太好，她的法力几乎完全流失了。",
	[10100001741] = "你的葫芦！不是可以医治百病？",
	[10100001742] = "不行，她伤势太重了，即便续上法力，恐怕也难以撑过今晚。",
	[10100001743] = "不过，我会尽全力治疗她。\n我需要三株灵草才能进行治疗，你们能帮我找找吗？",
	[10100001744] = "三株灵草吗？交给我吧！",
	[10100001745] = "交给我吧！",
	[10100001746] = "咳咳……",
	[10100001747] = "她恢复意识了。",
	[10100001748] = "快去救救……爸爸……门司令……",
	[10100001749] = "是南御夫为了得到神话果，屠杀了整个村子。爸爸也被他们用锁灵石铐住带走了……",
	[10100001750] = "这些人哪里是军队，完全是强盗！",
	[10100001751] = "南御夫真是欺人太甚。\n放心，水儿，北落对我们有恩，我一定会把他带回来。",
	[10100001752] = "谢谢，大哥哥……",
	[10100001753] = "如果，我撑不到你们回来的时候，请代我告诉门司令，我已经什么都想起来了。",
	[10100001754] = "但是我一点也不恨爸爸。",
	[10100001755] = "好好撑着小家伙。",
	[10100001756] = "你们的事我不了解，但有些话，还是亲口告诉他比较好。",
	[10100001757] = "许褚！典韦！我们走！",
	[10100001758] = "只要主公一句话，我等踏平这罗刹街！",
	[10100001759] = "许褚、典韦",
	[10100001760] = "……",
	[10100001761] = "羽林街防御森严，大家多加小心。",
	[10100001762] = "久候多时了！",
	[10100001763] = "原来是你！逃犯曹焱兵！\n北落师门提出私下和你决斗我就觉得不对劲，你们沆瀣一气，果然是一路贼子。",
	[10100001764] = "不过，多亏了你们在村外傻傻地酣战，才给了我们进村探取神话果的机会，说起来还真要谢谢你！",
	[10100001765] = "闪开，没时间跟你废话！",
	[10100001766] = "真难缠。我们快继续前进吧。",
	[10100001767] = "有埋伏？",
	[10100001768] = "当心，是孙尚香！",
	[10100001769] = "小菜一碟！",
	[10100001770] = "紫薇死了，她死在了过度自信，死在了手下无人。",
	[10100001771] = "我和她不一样。比起单独行动，我更喜欢用兵。",
	[10100001772] = "管你喜欢什么！阻挡我的人，杀无赦！",
	[10100001773] = "我定要将做出恶行的人碎尸万段！",
	[10100001774] = "羽林街大殿前。",
	[10100001775] = "别误会，我对你并无仇恨，但南御夫定要取你性命，我也只奉命行事。",
	[10100001776] = "你体内还有镇魂链，一旦出事，灵域就会立刻知道。\n我会使用我特殊法力，将镇魂链取出销毁。",
	[10100001777] = "然后，就任凭南御夫处置了。",
	[10100001778] = "……",
	[10100001779] = "将军链已取。",
	[10100001780] = "*喃喃*如果有谁能助我逃过一劫，助我解开这枷锁",
	[10100001781] = "*喃喃*能助我再见女儿一面",
	[10100001782] = "*喃喃*就算他是恶罗刹，我也愿意跟随",
	[10100001783] = "苍天啊！你听到了吗！苍天啊！",
	[10100001784] = "苍天已死！给我杀了他！",
	[10100001785] = "北落师门！你这蠢货！",
	[10100001786] = "这里是魔王的天下，关老天屁事！",
	[10100001787] = "自己重视的事情，当然要自己亲手来守护。",
	[10100001788] = "可恶……太微！给我拿下他们！",
	[10100001789] = "羽林街大殿内。",
	[10100001790] = "曹当家，前面的路只有你自己能走。准备妥当就出发吧。",
	[10100001791] = "进入故事关卡",
	[10100001792] = "退出",
	[10100001793] = "那么，有问题随时可以来找我。",
	[10100001794] = "曹焱兵，你的救命之恩我永远都会记得。",
	[10100001795] = "还没结束呢，北落师门。",
	[10100001796] = "我们救治了水儿，但恐怕她也撑不过今晚。",
	[10100001797] = "什么！水儿还活着！",
	[10100001798] = "她在等你见她最后一面呢，我们赶紧把事情做完回去见她吧。",
	[10100001799] = "看来，轮到我们出场了，石灵明！",
	[10100001800] = "等你这句话很久了！",
	[10100001801] = "吼吼吼！！",
	[10100001802] = "笨女人，跟在我身后！许褚，我们上！",
	[10100001803] = "主公一声令下，我许褚必当赴汤蹈火！",
	[10100001804] = "我一直很疑惑，姐姐既然是没有法力的普通人，怎么会穿过结界来到罗刹街呢？",
	[10100001805] = "对了！那是因为我收到了一封面试通知的邮件，让我来这里面试的。",
	[10100001806] = "没想到依照上面的地址找来，竟是这样的地方……",
	[10100001807] = "什么邮件？给我看看。",
	[10100001808] = "夏铃递过手机，给曹焱兵看自己收到的邮件。",
	[10100001809] = "这是！",
	[10100001810] = "没错，这邮件，是灵言信幻化而成的。",
	[10100001811] = "只有寄灵人才能看到灵言信的内容，而且，是等活以上的寄灵人！",
	[10100001812] = "也就是说，姐姐她的确是寄灵人，并且是被人刻意引领到我们这来的！",
	[10100001813] = "哼，事情越来越有意思了。",
	[10100001814] = "夏铃，你闭上眼睛，将气聚拢丹田。",
	[10100001815] = "夏铃闭上眼睛，周身的灵气随着呼吸显现，在她周围徐徐燃烧。",
	[10100001816] = "厉害，竟然这么快就掌握了！\n趁法力燃烧旺盛，将它们全都聚拢到颅顶。",
	[10100001817] = "这衣服是……",
	[10100001818] = "这衣服叫灵衣，每个寄灵人都有自己的灵衣。这是成为寄灵人的标志。",
	[10100001819] = "原来我隐藏着这样的力量……",
	[10100001820] = "众人跑到道路尽头，一只高等恶灵正准备吞噬幽灵。",
	[10100001821] = "吼吼吼——！",
	[10100001822] = "他、他将幽灵吃下去了！",
	[10100001823] = "为害罗刹街者，必为我所铲除！",
	[10100001824] = "什么嘛，少瞧不起人了！",
	[10100001825] = "吼吼吼！！",
	[10100001826] = "来了。",
	[10100001827] = "（这是怎么回事？我的心突然跳得好快。）",
	[10100001828] = "（作为寄灵人，我的力量怎么样呢？好想知道。）",
	[10100001829] = "夏铃走上前，凝神注视着敌人，做出准备迎战的样子。",
	[10100001830] = "笨女人，我能理解作为寄灵人想战斗的心情，但你现在还无法使用法力，先在一旁看好我们是怎么做的吧。",
	[10100001831] = "曹焱兵周身被一股能量环绕，这就是使用法力战斗的感觉吗……总有一天我也要召唤出我的守护灵！",
	[10100001832] = "没想到你这样的笨女人能观察到这种程度，真是人不可貌相。",
	[10100001833] = "也就是说，我很有潜力咯？",
	[10100001834] = "嗯，不过可别得意太早，你的法力可还不足以召唤出守护灵呢。",
	[10100001835] = "主公……属下来迟了。",
	[10100001836] = "嗯？这声音是……",
	[10100001837] = "前面还有一段恶灵出没的险路，你可要抓紧了，笨女人。",
	[10100001838] = "哇！前面出现了好多恶灵！",
	[10100001839] = "曹焱兵大手一挥，做出一副准备出发的架势。",
	[10100001840] = "这么快就来了么，都给我闪一边去！",
	[10100001841] = "吼吼吼——！！！",
	[10100001842] = "这么快就来了么，都给我闪一边去！",
	[10100001843] = "冥域野生孤灵的意识流动保留了我的存在，而主公的每次使用法力，都饲养了我的精神。",
	[10100001844] = "如今，我收集的法力，令我足以站在主公面前说话。",
	[10100001845] = "主公是否还愿意卑职再次追随呢？",
	[10100001846] = "那是当然！那次事件后，我只恨我力量弱小，没能守住你的灵体，你能回来，我高兴还来不及！",
	[10100001847] = "让我们一起守护罗刹街吧！",
	[10100001848] = "让我来助你复苏吧。",
	[10100001849] = "吼吼吼！这就是罗刹街的冒险者吗？只要我拿下他，这条街就是我的了！",
	[10100001850] = "高等恶灵吗？于禁，且再等一下，我得先处决碍事的家伙。",
	[10100001851] = "曹焱兵将法力注入于禁的身体，霎时间，于禁的灵体发出光芒，从光芒中走出一个崭新的灵体。",
	[10100001852] = "末将于禁，愿为曹家世代赴汤蹈火。",
	[10100001853] = "我从防具中获得了力量。",
	[10100001854] = "各种装备都能为使用者带来增益，我们今后也要留心收集，别再像以前一样，打没有准备的仗了。",
	[10100001855] = "主人，请允许我站在阵位前方，抵抗敌人大部分火力。",
	[10100001856] = "嗯，让我们三个火属性的人一起上阵吧，许褚，于禁。",
	[10100001857] = "三个同属性的人上阵，可以获得额外的增益效果。真不愧是武神躯。",
	[10100001858] = "得救了……",
	[10100001859] = "混乱中，一张名片从夏铃的衣兜里掉了出来。",
	[10100001860] = "鬼符三通？",
	[10100001861] = "在无尽的等待中，总会有人不耐烦产生邪念，恶的能量就会变成可以攻击群英的恶灵。",
	[10100001862] = "也就是说这些恶灵都是曾经的幽灵变成的？",
	[10100001863] = "没错。若任由怨念侵蚀，终会堕入邪道。这一点，幽灵和群英一样。",
	[10100001864] = "……",
	[10100001865] = "那前面的路上还有恶灵吗？",
	[10100001866] = "地狱三头犬？它怎么会到这里来？",
	[10100001867] = "小亮，你看今晚吃狗肉汤怎么样？你会做吗？",
	[10100001868] = "哈哈，小菜一碟。",
	[10100001869] = "三头犬受了重伤，呜呼一声，钻进一扇传送门逃跑了。",
	[10100001870] = "唉，今晚吃不上狗肉汤了。",
	[10100001871] = "（连这样强大的恶犬都能轻松击败，守护灵的力量可真厉害呀。）",
	[10100001872] = "（我什么时候才能有自己的守护灵呢？）",
	[10100001873] = "一行人继续向街道深处巡逻。",
	[10100001874] = "罗刹街的范围到底有多大啊？走了这么久，一路上都是错综复杂的巷道和路口，好像道路连着道路，循环不尽似的。",
	[10100001875] = "罗刹街被恶灵的怨念所影响，道路也会随之发生扭曲。你可小心跟好了，别再走丢了。",
	[10100001876] = "当心，前面蹲守了几只蜥蜴怪。",
	[10100001877] = "是很厉害的敌人吗？",
	[10100001878] = "虽然只是杂草，不过也不可小觑。",
	[10100001879] = "夏铃，你不是想增强法力吗？多多战斗对法力的增益有帮助，你敢和那几只蜥蜴怪作战吗？",
	[10100001880] = "这有什么不敢，看我的！",
	[10100001881] = "像……真像啊。",
	[10100001882] = "李轩辕，你觉得我像某个人？",
	[10100001883] = "主人，你很像我生前认识的一个人，名叫木文元香。",
	[10100001884] = "她是精通铸造铃器的木文家的千金。你灵衣上挂着的铃铛，或许就是遗传自她吧。",
	[10100001885] = "不过，已经是前尘往事了。\n啊，千年弹指一挥间，如今我与元香的后人成为主仆，不得不说是一种缘分。",
	[10100001886] = "（我的守护灵和曹焱兵的比起来，身形更纤瘦，他真的可以战斗吗？）",
	[10100001887] = "李轩辕，你有什么绝招吗？",
	[10100001888] = "“绝招”这个词是为何意？",
	[10100001889] = "大家当心，有敌人来了。",
	[10100001890] = "主人小心，且让我来应对！",
	[10100001891] = "李轩辕，你好厉害……你是怎么做到突然跳到敌人后方攻击的？这就是你的绝招吗？",
	[10100001892] = "只是个不值一提的计策罢了，都是因为主人配合得当，才让我有机会从后方击敌。",
	[10100001893] = "这段路看来已经没有敌人了，我们换个方向前进吧。",
	[10100001894] = "蜥蜴人",
	[10100001895] = "嘶嘶——",
	[10100001896] = "我认得这怪物，它是蜥蜴人。",
	[10100001897] = "记得这家伙属土，根据风雷水火土五行相克的规律，我们可以以火克土。",
	[10100001898] = "也就是说，该我们火属性人上场了。\n许褚、于禁，随我一同作战吧！",
	[10100001899] = "五行相生相克，天地万物，莫出其中。",
	[10100001900] = "若将此规律用于战术，则使战局变化万千，有趣有趣。",
	[10100001901] = "这蜥蜴人身上带了一些装备，有能用的吗？",
	[10100001902] = "李轩辕穿上蜥蜴人掉落的装备。",
	[10100001903] = "我获得了新的力量。",
	[10100001904] = "很好，此行总算有了些收获。让我们继续向前，走完这条恶灵遍布的街道吧。",
	[10100001905] = "前面没有路了吗？",
	[10100001906] = "没有了，这条巷子已经走到底了。",
	[10100001907] = "我们先在此处就地休息一会儿吧。",
	[10100001908] = "一行人就地坐下休息。",
	[10100001909] = "（罗刹街最近恶灵越来越多了，看来还要加强巡视才行。）",
	[10100001910] = "曹焱兵思考着，不知不觉打起了瞌睡。",
	[10100001911] = "吼吼吼——！！",
	[10100001912] = "又是恶灵吗？想要拿下罗刹街，得先过我这一关！",
	[10100001913] = "三人来到玄武巷。",
	[10100001914] = "刚才路上还能看见好多幽灵，怎么这里一个人也没有？",
	[10100001915] = "你们看！",
	[10100001916] = "唔唔唔……",
	[10100001917] = "玄武巷的居民们被关在一间狭窄的屋子里，大门上挂了一块锁灵石。",
	[10100001918] = "这是怎么回事？",
	[10100001919] = "唔唔唔……",
	[10100001920] = "他们都被堵住嘴了！",
	[10100001921] = "我们找找锁灵石的钥匙吧，先想办法放他们出来再说。",
	[10100001922] = "哈哈哈哈哈！曹焱兵，你可还记得我？",
	[10100001923] = "流寇",
	[10100001924] = "呃，绝招……就是……",
	[10100001925] = "已经闻到香味啦。",
	[10100001926] = "我已经迫不及待想开动了！",
	[10100001927] = "不错不错。",
	[10100001928] = "稳扎稳打。",
	[10100001929] = "好像做出了黑乎乎的东西……",
	[10100001930] = "呜呜，这是什么黑暗料理……",
	[10100001931] = "呜呼！成功啦！",
	[10100001932] = "你就是传说中的特级厨师？",
	[10100001933] = "我需要三株灵草，方可进行治疗。在我帮白水儿延续法力之时，可以请你帮我找来吗？",
	[10100001934] = "获得灵草+1",
	[10100001935] = "获得灵草+1",
	[10100001936] = "获得灵草+1",
	[10100001937] = "曹焱兵将三株灵草交给李轩辕。",
	[10100001938] = "嗯，现在可以开始治疗了。",
	[10100001939] = "开始治疗",
	[10100001940] = "我也来帮忙。",
	[10100001941] = "拦住他！这是天市大人的命令！",
	[10100001942] = "休想从这里过去。",
	[10100001943] = "尝尝寒冰箭的厉害吧！",
	[10100001944] = "以少敌多，痴心妄想！",
	[10100001945] = "谁也快不过我的箭。",
	[10100001946] = "记得破坏掉这里的蜘蛛茧。",
	[10100001947] = "这么多恶灵，到底是从哪里来的啊？",
	[10100001948] = "想要进入灵域的妖灵，必须留在镇魂街，等待御灵使的超度。",
	[10100001949] = "一阵窸窸窣窣的声音响起，一群恶灵从高楼顶端的阴影中显出轮廓。",
	[10100001950] = "红衣服那个人就是这条街的冒险者吗？",
	[10100001951] = "对、对，是他没错！\n现、现在可以按照约定，放了我了吧？",
	[10100001952] = "当然，现在就按我们说好的，带我们找到冒险者就放了你。",
	[10100001953] = "恶灵将手松开，用力朝幽灵推了一掌，只见幽灵失去重心，从楼顶坠落下去。",
	[10100001954] = "哇！有什么东西摔下来了……是一个人！",
	[10100001955] = "曹玄亮反应迅速，闪身将落下幽灵接住，安全落地。",
	[10100001956] = "上头有人！",
	[10100001957] = "可是照我看来，她不太像普通人啊。",
	[10100001958] = "曹焱兵顺着刘羽禅手指的方向看过去，夏铃正向一只像她袭来的恶灵扔石头。",
	[10100001959] = "走开！讨厌的恶灵！",
	[10100001960] = "危险！笨女人，不要擅自行动啊！",
	[10100001961] = "罗刹街一条小巷内，一群恶灵抓住了一只普通幽灵。",
	[10100001962] = "求……求求你们放过我吧……",
	[10100001963] = "放过你可以，不过，要请你帮我一个小忙。",
	[10100001964] = "带我指认出罗刹街的冒险者，我就放了你。",
	[10100001965] = "是、是！这就带你去……",
	[10100001966] = "呵呵，这条罗刹街，我要定了。",
	[10100001967] = "与此同时……",
	[10100001968] = "曹焱兵一路横冲直撞，用武器十殿阎罗轻松击退如蝼蚁般的恶灵。",
	[10100001969] = "紧张的居民",
	[10100001970] = "怎么样？你发现那些埋伏的恶灵了吗？",
	[10100001971] = "他们躲在附近，但还未现身，真是沉得住气。",
	[10100001972] = "喂，出来吧！躲起来的家伙。",
	[10100001973] = "一阵窸窸窣窣的声音响起，一群恶灵从高楼顶端的阴影中显出轮廓。",
	[10100001974] = "红衣服那个人就是这条街的冒险者吗？",
	[10100001975] = "对、对，是他没错！\n现、现在可以按照约定，放了我了吧？",
	[10100001976] = "当然，现在就按我们说好的，带我们找到冒险者就放了你。",
	[10100001977] = "恶灵将手松开，用力朝幽灵推了一掌，只见幽灵失去重心，从楼顶坠落下去。",
	[10100001978] = "真狡猾，连我也差点就中了他们的埋伏。",
	[10100001979] = "嗯？刚刚那个幽灵呢？",
	[10100001980] = "他逃跑了。可能怕你报复吧，毕竟是他给敌人带的路。",
	[10100001981] = "附近恶灵遍布，那罗刹街的幽灵就这样离开，不知道会不会遇上危险。",
	[10100001982] = "那人为敌人带路来杀你，你反而担心他的安危？",
	[10100001983] = "保护幽灵是冒险者的职责，何况他是被胁迫才做出这种事。",
	[10100001984] = "在冥界，这种事情并不少见。",
	[10100001985] = "呜呜哇哇哇哇！！",
	[10100001986] = "一阵惨叫从不远处传来。",
	[10100001987] = "什么声音！",
	[10100001988] = "恐怕有人遇到了危险，走，我们过去看看。",
	[10100001989] = "冥界原来有幽灵也有恶灵，那，你之前召唤出的怪物属于什么？",
	[10100001990] = "许褚，有人想认识你。",
	[10100001991] = "荣幸之至！",
	[10100001992] = "他是我的守护灵，群英时期曹操的虎卫军统领，许褚，拥有一夫当关万夫莫敌之勇。",
	[10100001993] = "真是难缠的家伙。",
	[10100001994] = "哎呀呀，曹当家的，别来无恙啊。",
	[10100001995] = "人死后，灵魂会来到镇魂街。",
	[10100001996] = "但是，若一个人生前怀有积怨，他的魂魄便会失去理智，变成只知道掠夺的贪婪怪物，也就是恶灵。",
	[10100001997] = "冒险者的任务，就是镇压这些恶灵，维护冥界的安定。",
	[10100001998] = "所以知道你闯进来的是什么地方了吧？",
	[10100001999] = "不是不能理解，不过这一切对我来说好像做梦一样……",
	[10100002000] = "不论你有没有听懂，都没关系。",
	[10100002001] = "反正你在离开冥域前，我会用特殊能力消除你脑中关于镇魂街的记忆，这是灵域的命令。",
	[10100002002] = "不过消除记忆等同于进行一场脑部外科手术，能不能成功就另当别论了。",
	[10100002003] = "喂……你、你可别吓我啊！",
	[10100002004] = "说到这里，我一直很疑惑，姐姐既然是没有法力的普通人，怎么会穿过结界来到罗刹街呢？",
	[10100002005] = "啊，那是因为我收到了一封面试通知的邮件，让我来这里面试的。",
	[10100002006] = "没想到依照上面的地址找来，竟是这样的地方……",
	[10100002007] = "什么邮件？给我看看。",
	[10100002008] = "夏铃递过手机，给曹焱兵看自己收到的邮件。",
	[10100002009] = "这是！",
	[10100002010] = "没错，这邮件，是灵言信幻化而成的。",
	[10100002011] = "只有寄灵人才能看到灵言信的内容，而且，是等活以上的寄灵人！",
	[10100002012] = "也就是说，姐姐她的确是寄灵人，并且是被人刻意引领到我们这来的！",
	[10100002013] = "哼，事情越来越有意思了。",
	[10100002014] = "你们在说什么呀，我要是寄灵人，怎么不会使用法力呢？",
	[10100002015] = "这个，我也不太清楚。\n也许你的法力被什么东西封锁住了。",
	[10100002016] = "不管怎么说，我不用被消除记忆了是吧？",
	[10100002017] = "没错。总之，我们先继续巡逻吧，等回到山顶，再想想激发出你法力的方法。",
	[10100002018] = "哇，这是……我的衣服怎么变了？",
	[10100002019] = "学得很快嘛。这衣服是因为你使用法力而幻化出来的灵衣，它对寄灵人来说非常重要。",
	[10100002020] = "不过你需要释放更多法力，才能降之熟练运用。\n走吧，这条路低级恶灵还有很多，正好让你练练手。",
	[10100002021] = "高等恶灵受了重伤，钻进一扇传送门逃跑了。",
	[10100002022] = "可恶，还是让他逃走了。",
	[10100002023] = "附近的恶灵越来越多了，稳妥起见，我看还是快点送你回去比较好。",
	[10100002024] = "上车，笨女人！我们从左边的近路抄过去。",
	[10100002025] = "哦！",
	[10100002026] = "总之，我们先在此处就地休息一会儿吧。",
	[10100002027] = "哔哔哔……\n刘羽禅的言灵盒亮了起来。",
	[10100002028] = "灵域的灵言信？看来我的新指令来了。",
	[10100002029] = "没能和你像上次一样较量一番，真是可惜，不过，我必须先走一步了。",
	[10100002030] = "当然，如果有事的话，随时可以用灵言信找到我。",
	[10100002031] = "害怕的人质",
	[10100002032] = "站住！你就是罗刹街冒险者曹焱兵吗？\n若想这家伙活命，就交出冒险者的位置。",
	[10100002033] = "大人，救救我！救命！",
	[10100002034] = "哼，就凭你也想做冒险者？",
	[10100002035] = "可恨的冒险者，我不会就此善罢罢休！",
	[10100002036] = "即便我的魂魄灰飞烟灭，我也要在临死前向你施加最狠毒的诅咒，让你痛不欲生！",
	[10100002037] = "恶灵念念有词，从口中飞出一串咒语，向曹焱兵袭来。",
	[10100002038] = "这是！",
	[10100002039] = "曹焱兵情急之下将十殿阎罗猛地一挥，挥散了咒语。",
	[10100002040] = "哥哥，你的十殿阎罗？",
	[10100002041] = "查看十殿阎罗",
	[10100002042] = "十殿阎罗被黑色的怨气缠绕着，发挥不出原本的功力。",
	[10100002043] = "这是……咒术？",
	[10100002044] = "曹大人，那家伙是个擅长操纵咒术的恶灵，想必你的武器上已经被他的怨念缠上。",
	[10100002045] = "我记得无影街有个除灵师，能以法力解除咒术，大人不妨去拜访他一趟。",
	[10100002046] = "那人在无影街的什么位置？你知道吗？",
	[10100002047] = "这就不太清楚了。不过你们可以去万灵巷问问，那边离无影街很近，或许有知道他的人。",
	[10100002048] = "此时，罗刹街的另一个角落，黑尔坎普正监听着曹焱兵的一举一动。",
	[10100002049] = "呵呵呵……无影街的除灵师吗？我知道了。",
	[10100002050] = "你们可以去万灵巷问问，那边离无影街很近，或许有知道除灵师的人。",
	[10100002051] = "这里就是万灵巷吗？我们在此处打听打听关于除灵师的事吧。",
	[10100002052] = "万灵巷？这里就是万灵巷。",
	[10100002053] = "世界上没有比万灵巷更好的地方，你要不也在这里住下吧，这里很安全。",
	[10100002054] = "最近镇魂街的恶灵越来越多，旅行之路也变得危险起来，不过这里倒很和平。",
	[10100002055] = "干脆我也在这里定居下来算了。",
	[10100002056] = "除灵师？我不知道，不过这条街的路上也许可以捡到一些别人掉落的东西，你可以找找哦。",
	[10100002057] = "你们要找除灵师？我知道他在哪，不过我的陀螺不知道飞哪里去了，你们能先帮我找找吗？",
	[10100002058] = "在路边找到一只陀螺。",
	[10100002059] = "应该是那个小男孩的陀螺，去还给他吧。",
	[10100002060] = "是我的陀螺！谢谢大人。",
	[10100002061] = "关于除灵师，我哥哥在除灵师那里做学徒，让他告诉你吧。哥哥！快来！",
	[10100002062] = "除灵师弟子",
	[10100002063] = "出什么事了？",
	[10100002064] = "嘻嘻，陀螺陀螺，再转快点！",
	[10100002065] = "除灵师就在无影街最深处一个叫“水镜堂”的地方。",
	[10100002066] = "这位大人想找除灵师，哥哥你可以带他去吗？",
	[10100002067] = "我的武器中了恶灵的诅咒，敢问可否请尊师为我驱除诅咒呢？",
	[10100002068] = "原来如此！我师父是个值得尊敬的除灵师，经常帮穷苦人治病，大人去了他一定很开心。",
	[10100002069] = "只可惜我现在有事在身，办完事情才能回去，现在没办法为你带路了。",
	[10100002070] = "可否为我们指条路呢？",
	[10100002071] = "当然，我师父就在无影街最深处一个叫“水镜堂”的地方，你向右走就能找到了。",
	[10100002072] = "这里就是无影街了，可这个岔路口，应该走哪边呢？",
	[10100002073] = "敢问阁下是罗刹街火将军曹焱兵？",
	[10100002074] = "你是？",
	[10100002075] = "除灵师昨日占卜，得知罗刹街火将军今日会前来探访，于是命弟子我在路口接应。",
	[10100002076] = "如此神机妙算，真不愧是除灵师！",
	[10100002077] = "走吧，大人，这里道路错综复杂，还请跟随我的脚步。",
	[10100002078] = "我们走吧，哥哥。",
	[10100002079] = "等等，那是什么血迹。",
	[10100002080] = "一些血迹。",
	[10100002081] = "这是群英的血迹，有人在这里遇害了？",
	[10100002082] = "这是……符咒？谁落在这里的？",
	[10100002083] = "*读信*“……我……奇怪……………………如果遭遇不测…………请救救我……”",
	[10100002084] = "这封信上的字已经模糊得看不清了，不过好像是一封求救信？",
	[10100002085] = "就是这里了。",
	[10100002086] = "这里？这里好暗，而且什么也没有呀。",
	[10100002087] = "因为样的地形，最适合伏击战呀！",
	[10100002088] = "什么？",
	[10100002089] = "大家当心！有埋伏！",
	[10100002090] = "没想到竟是个圈套……",
	[10100002091] = "除灵师或许已经遇害了，刚才的血迹和求救信都是他的吧？",
	[10100002092] = "我们顺着血迹找找线索吧。",
	[10100002093] = "疑似除灵师留下的血迹。",
	[10100002094] = "是谁在那？",
	[10100002095] = "那人好像受了重伤，看来是用最后一口气爬到聚灵石像旁边，却没能触碰到石像。",
	[10100002096] = "我们用聚灵石像帮他治疗吧。",
	[10100002097] = "我们用聚灵石像帮他治疗吧。",
	[10100002098] = "除灵师",
	[10100002099] = "咳咳咳……",
	[10100002100] = "她醒了。",
	[10100002101] = "老人家，是谁把你伤成这样的？",
	[10100002102] = "谢谢，好心人……我是附近水镜堂的除灵师，一向过着平静的生活。",
	[10100002103] = "今天却突然被来路不明的人追杀，昏迷中隐隐约约听见那领头人似乎想冒充我的身份谋害冒险者。",
	[10100002104] = "看你气度不凡，那个冒险者大人就是你吧？",
	[10100002105] = "咳咳咳……希望冒险者大人别再去水镜堂，他们恐怕现在正埋伏在那里，等着你呢。",
	[10100002106] = "可恶，到底是什么人在搞鬼！",
	[10100002107] = "放心，老人家，我绝不会姑息在镇魂街作乱的家伙！",
	[10100002108] = "……",
	[10100002109] = "哥哥，她已经没气了……",
	[10100002110] = "这老人失血过多，就是聚灵石也救不了。",
	[10100002111] = "走，小亮，夏铃，我们去水镜堂会一会那家伙！",
	[10100002112] = "嘻嘻，看来，曹焱兵来了，三头犬，给我撕碎他们！",
	[10100002113] = "那家伙逃走了。",
	[10100002114] = "这里怎么回事……怎么会变成这样……",
	[10100002115] = "……",
	[10100002116] = "冒险者大人，我刚才收到师父的求救信，立刻赶了回来。他人呢？你有看见他吗？",
	[10100002117] = "你师父他已经……进入轮回了。",
	[10100002118] = "夏铃将事情经过告诉了除灵师的弟子。",
	[10100002119] = "怎么会……师父……",
	[10100002120] = "他的目标既然是我，就不会只有这一次交手。",
	[10100002121] = "等下次碰上，我一定不会轻易放过他！",
	[10100002122] = "虽然师父已经去世，但还是谢谢您在危机时的救治。",
	[10100002123] = "我虽技艺比不上师父，但对除咒术小有研究，你的武器就交给我吧。",
	[10100002124] = "可恶，竟然破了我的阵，那么这一招如何！",
	[10100002125] = "太微抬手施法，一阵狂风卷过，再看他时，已经变出了无数分身。",
	[10100002126] = "好多分身！这可怎么是好！",
	[10100002127] = "这家伙使用的仙术，同为仙术的清风化煞或许可以克制他。",
	[10100002128] = "李轩辕取下葫芦，仰头大口喝酒，身上随之出现了仙气。",
	[10100002129] = "让我来找出你的真身吧。",
	[10100002130] = "太微见情形不妙，逃离了大殿。",
	[10100002131] = "有时间谢谢我，不如早点找南御夫算账。水儿还在等着你呢。",
	[10100002132] = "你们见到水儿了？她怎么样？",
	[10100002133] = "水儿她……只剩最后一口气，我们已经尽力治疗，但恐怕撑不过今晚了。",
	[10100002134] = "怎么会……",
	[10100002135] = "南御夫，不仅不顾念旧情，反而恩将仇报，毁灭村子，现在连水儿也……等着瞧，我定不会放过他！",
	[10100002136] = "休想逃跑！",
	[10100002137] = "完了，我们输了！",
	[10100002138] = "快去禀报天市大人！",
	[10100002139] = "可恶，你们等着瞧。",
	[10100002140] = "我们还没找齐食材吧？",
	[10100002141] = "去找旅行者借下清单，看看还缺什么食材吧。",
	[10100002142] = "鬼符三通？你来做什么？",
	[10100002143] = "前几日你救下的寄灵人夏铃正在被王国组织追杀，我帮她挡下了敌人，让她来罗刹街找你。",
	[10100002144] = "她还没有来吗？",
	[10100002145] = "什么？那个笨女人？",
	[10100002146] = "看来你们并没有碰面。\n曹当家的，快去罗刹街找找她吧，情况紧急，说不定现在已经遇到危险了。",
	[10100002147] = "真会给人添麻烦！",
	[10100002148] = "曹焱兵指了指夏铃。",
	[10100002149] = "哦？这倒是件新鲜事。",
	[10100002150] = "这个，我可以慢慢说给你听，不过我觉得现在还是先解决你身后的恶灵比较好。",
	[10100002151] = "吼吼吼——",
	[10100002152] = "不知什么时候，鬼符三通身后围过来几只被法力吸引来的恶灵。",
	[10100002153] = "呵呵，罗刹街果然还是老样子。",
	[10100002154] = "战斗之路越来越艰险了呢。",
	[10100002155] = "不如试试与守护灵配合，使用圣兽，会达成出其不意的效果哦 。",
	[10100002156] = "大家打开门锁，救出被困的幽灵们。",
	[10100002157] = "虽然罗刹街一向是镇魂街中最为凶险的一条，但最近恶灵的数量实在多得有些异常啊。",
	[10100002158] = "这正是我来找你的原因，根据我的调查，有一股叫“王国”的外部势力正向镇魂街渗透。",
	[10100002159] = "如今灵域衰微，各方势力都蠢蠢欲动，若冒险者不集结起来，很难与他们抗衡。",
	[10100002160] = "怎么样？要不要加入我，一起对抗王国势力？",
	[10100002161] = "抱歉，对这些争权夺利的事情，我没兴趣。",
	[10100002162] = "我就知道你会这样说，不过事关重大，你考虑考虑吧。",
	[10100002163] = "若你改变了主意，可以随时发灵言信给我。",
	[10100002164] = "鬼符三通消失了。",
	[10100002165] = "真是个神出鬼没的家伙。",
	[10100002166] = "别管他了，我们还是继续清理这条街吧。",
	[10100002167] = "焱兵，你为什么不愿加入那个鬼符三通？",
	[10100002168] = "冥界势力众多，各有来头，不过归根结底还是为了自己的利益，孰是孰非，谁又能看得清？",
	[10100002169] = "何况我不喜欢被别人管。\n在罗刹街逍遥自在，多好。",
	[10100002170] = "吼吼吼——",
	[10100002171] = "（唔，如果这也算逍遥自在的话……）",
	[10100002172] = "哔哔，找到了，那个寄灵人。",
	[10100002173] = "什么人！",
	[10100002174] = "黑尔坎普大人的命令，必须执行。",
	[10100002175] = "呵呵，真是痛快！",
	[10100002176] = "曹焱兵重新骑上摩托，一路疾驰。",
	[10100002177] = "风驰电掣之间，二人驶向一条狭窄的巷子。",
	[10100002178] = "笨女人，前面就是人界大门了！",
	[10100002179] = "前面……？那是面墙啊。",
	[10100002180] = "快停下！是个死胡同！",
	[10100002181] = "曹焱兵不但没有停下，反而踩了一脚油门，向死路冲过去。",
	[10100002182] = "一鼓作气冲过去！",
	[10100002183] = "一面墙拦路挡在中间。",
	[10100002184] = "不对！是面墙！",
	[10100002185] = "快停下！是个死胡同！",
	[10100002186] = "一鼓作气！",
	[10100002187] = "曹焱兵将夏铃送到人界安全的地方。",
	[10100002188] = "谢谢你。",
	[10100002189] = "*伸手*10块。",
	[10100002190] = "原来还要钱啊！",
	[10100002191] = "唉，守财奴。",
	[10100002192] = "曹焱兵收了钱准备离开。",
	[10100002193] = "对了，那个鬼符三通，也和你一样是寄灵人吗？",
	[10100002194] = "他是被御灵使派到人界的，目的是为灵域寻找可用的寄灵人。",
	[10100002195] = "虽然你身上完全没有法力的迹象，不过既然他找到你，而你也能看见灵言信，那么八成你就是寄灵人吧。",
	[10100002196] = "寄灵人……我？怎么可能？",
	[10100002197] = "曹焱兵用手指在自己掌心划了几划。",
	[10100002198] = "我以为在这鬼地方已经见惯了离奇的事，但笨女人这件事还是令我惊讶。",
	[10100002199] = "罗刹街最近怪事频发，许多居民都寄来言灵信，说有外来的恶灵侵袭。",
	[10100002200] = "这到底是怎么回事？",
	[10100002201] = "不论如何，有我曹焱兵在，谁都别想在罗刹街作威作福。",
	[10100002202] = "嗯！看来今后要加强巡逻才是。",
	[10100002203] = "现在就动身吧。",
	[10100002204] = "现在就去？天已经快黑了。",
	[10100002205] = "我不喜欢等待，今天先把罗刹东边的巷子都巡查一遍再说。",
	[10100002206] = "在短暂的十分之一秒的一瞬间，曹焱兵反应了过来。",
	[10100002207] = "退后！",
	[10100002208] = "太好了，总算是有惊无险。",
	[10100002209] = "我想确认一下，刚才恶灵是你推倒的吧？",
	[10100002210] = "我也正奇怪，我好像没有碰到它，只觉得手心忽然涌出一股力量，然后……它就倒下了。",
	[10100002211] = "果然我没有眼花，方才看你手心涌出一股法力，击中了那家伙。",
	[10100002212] = "换句话说，也许无意间，你的法力已经觉醒了。",
	[10100002213] = "我的法力？你是说和你们一样的那种力量？",
	[10100002214] = "没错，寄灵人本身就有释放法力的潜能。也许冥界受到各种力量的影响，加上情况紧急，焕发了出你内心的力量。虽然还很微弱就是了。",
	[10100002215] = "我来教你法力正确释放的方法吧。",
	[10100002216] = "好啊！我早就想学了。",
	[10100002217] = "你闭上眼睛，将气聚拢丹田。",
	[10100002218] = "夏铃按曹焱兵所说的方法做，逐步聚拢周身之气，使法力在她周围徐徐燃烧。",
	[10100002219] = "现在，将法力一口气释放出来！",
	[10100002220] = "哇！这是……我的衣服怎么变了！",
	[10100002221] = "学得很快嘛。这衣服叫灵衣，每个寄灵人都有自己的灵衣。这是你正式成为寄灵人的证明。",
	[10100002222] = "原来我的内心中隐藏着这样的力量……真不可思议呀。",
	[10100002223] = "一群恶灵躲在暗巷里，眼睛闪着贪婪的绿光。",
	[10100002224] = "好强的杀意，当心，他们要来了。",
	[10100002225] = "（这是怎么回事？我的心突然跳得好快。）",
	[10100002226] = "（作为寄灵人，我的力量怎么样呢？好想知道。）",
	[10100002227] = "夏铃走上前，凝神注视着敌人，做出准备迎战的样子。",
	[10100002228] = "（第一次释放法力就想和恶灵实战？这笨女人的战斗意志这样强烈，真是意外啊。）",
	[10100002229] = "（就让我看看你的实力究竟如何吧。）",
	[10100002230] = "没想到你这种笨蛋第一次实战就能将法力运用到这种地步，真是人不可貌相。",
	[10100002231] = "就是说我很有天赋咯？",
	[10100002232] = "马马虎虎吧。要知道，寄灵人不仅需要单打独斗，还须召唤守护灵，以智谋和法力驾驭它。",
	[10100002233] = "而你的法力还不足以召唤守护灵呢。",
	[10100002234] = "是哦，我的守护灵会是什么样的人呢？真想快点见到他。",
	[10100002235] = "说起来，刚才让小亮单独查探情况，他也走了好一段时间了，怎么还不见回来，真让人有点担心。",
	[10100002236] = "曹焱兵用十殿阎罗在地面画了一个圈。",
	[10100002237] = "我用十殿阎罗做了个结界，恶灵来了不敢轻易接近，你呆在里面别动，我去找找小亮。",
	[10100002238] = "鬼符三通，王国刺客为什么要追杀夏铃？",
	[10100002239] = "我之前就想告诉你可你没让我说。",
	[10100002240] = "现在说也不晚。",
	[10100002241] = "夏铃从街对面跑来。",
	[10100002242] = "喂——焱兵！",
	[10100002243] = "你怎么来了？不是叫你呆在原地吗。",
	[10100002244] = "我在路上捡到一只镯子，你看看是不是小亮的？如果是的话，我想他应该向东去了。",
	[10100002245] = "这个！的确是小亮的镯子！快带我去。",
	[10100002246] = "转过一个路口，曹玄亮忽然从地洞里爬出来。",
	[10100002247] = "小亮！你怎么从地下出来了？",
	[10100002248] = "事情是这样的……",
	[10100002249] = "我在那条街碰上许多蜘蛛怪，那些家伙繁殖速度极快，叫我费了好一番功夫才清理掉。",
	[10100002250] = "*喃喃*这么说，难道除了夏铃，还有另一个强大的寄灵人也在罗刹街？",
	[10100002251] = "敌在暗，我在明。看来我们今后要多加小心了。",
	[10100002252] = "嗯，还有，那些蜘蛛在罗刹街四处产卵，或许还有一些残余的蜘蛛，我们先去把它们找出来吧。",
	[10100002253] = "一行人歼灭了一波拦路的恶灵，到达山顶灵槐树附近，于是停下来稍作休息。",
	[10100002254] = "累死了……不过灵槐树真神奇，只是站在树下，就有种身心都被治愈的感觉。",
	[10100002255] = "对了，焱兵，为什么我按你说的方法，却召唤不出守护灵？是哪里出错了呢？",
	[10100002256] = "你之前在心灵空间看到的锁链，恐怕是封印守护灵的锁心链，需要足够强大的法力才可解开。",
	[10100002257] = "以你的资质，我算算……起码要五年吧。",
	[10100002258] = "五年？！我的青春……",
	[10100002259] = "如果让夏玲姐吃一根槐灵枝，一样可以让法力提高呀！",
	[10100002260] = "吃槐灵枝？那可是禁……",
	[10100002261] = "咦，就是这个吗？",
	[10100002262] = "夏铃一口吃掉了槐灵枝。",
	[10100002263] = "禁止事项！",
	[10100002264] = "什么！？我已经吃下去了！怎么办……",
	[10100002265] = "嗯？奇怪，这种法力充盈的感觉……我好像看到了什么东西？",
	[10100002266] = "夏玲不由自主地闭上了眼睛。",
	[10100002267] = "哇……我从来不知道原来我内心深处还寄居着一个大活人！",
	[10100002268] = "这就是你的守护灵吗？",
	[10100002269] = "没错！他叫李轩辕，厉害吧！",
	[10100002270] = "你这样的笨蛋竟然有这样不凡的守护灵……",
	[10100002271] = "算了，既然你有了守护灵，就来帮我清理剩下的山蜘蛛吧，就当你吃了灵槐的补偿，没意见吧？",
	[10100002272] = "像……真像啊。",
	[10100002273] = "李轩辕，你觉得我像某个人？",
	[10100002274] = "主人，你很像我生前认识的一个人，名叫木文元香。",
	[10100002275] = "她是精通铸造铃器的木文家的千金。你灵衣上挂着的铃铛，或许就是遗传自她吧。",
	[10100002276] = "不过，已经是前尘往事了。\n啊，千年弹指一挥间，如今我与元香的后人成为主仆，不得不说是一种缘分。",
	[10100002277] = "这样啊，原来还有这样的缘分。",
	[10100002278] = "对了，李轩辕，你有什么绝招吗？就是像曹焱兵阎王炮那样的招式。",
	[10100002279] = "这样的秘技吗？我想应该是……",
	[10100002280] = "应该是……？",
	[10100002281] = "大家当心，有敌人来了。",
	[10100002282] = "主人小心，且让我来应对！",
	[10100002283] = "李轩辕，你好厉害……你是怎么做到突然跳到敌人后方攻击的？这就是你的绝招吗？",
	[10100002284] = "只是个不值一提的计策罢了，都是因为主人配合得当，才让我有机会从后方击敌。",
	[10100002285] = "嘶嘶——",
	[10100002286] = "在附近的大楼的廊桥之间，出现一只巨大的蜘蛛的身影。",
	[10100002287] = "好大的蜘蛛，想来这一路的小蜘蛛都由它孵化而来。",
	[10100002288] = "别让它逃掉！",
	[10100002289] = "夏铃的修炼进行了几日。",
	[10100002290] = "唉，小亮，你说这样的修炼到底靠不靠谱啊，我怎么除了累一点感觉也没有。",
	[10100002291] = "不用担心，书上就是这么写的。",
	[10100002292] = "书？",
	[10100002293] = "曹玄亮拿来一摞书给夏铃看。",
	[10100002294] = "喏，武林秘籍。",
	[10100002295] = "这是……漫画？！！",
	[10100002296] = "傍晚。",
	[10100002297] = "怎么了？着急忙慌把我叫过来最好是重要的事情。",
	[10100002298] = "在李轩辕的配合下，西风巷的一群恶灵很快被扫清。",
	[10100002299] = "李轩辕，干得漂亮！",
	[10100002300] = "主人谬赞了。",
	[10100002301] = "你的守护灵这样厉害，居然愿意听令于你这样的菜鸟。",
	[10100002302] = "啊？守护灵不都应该听从寄灵人的命令吗？我们是他们的主人诶。",
	[10100002303] = "话是这样说，但厉害的守护灵也是会挑主人的。",
	[10100002304] = "他们只肯替他们认可的人效命，如果寄灵人的能力不足以驾驭守护灵，他们宁愿呆在心灵空间也不愿出来为主人效力。",
	[10100002305] = "还有这样的事？",
	[10100002306] = "那会不会有一天，李轩辕不愿再听令于我呢？",
	[10100002307] = "这很难说，毕竟你太菜了。",
	[10100002308] = "什么嘛，我很快就会变强的！",
	[10100002309] = "主人多虑了，我被封印囚禁了上千年，解救出我的你既是我的主人，又是我的恩人，我不会做出背弃恩人之事的。",
	[10100002310] = "（虽然寄灵人与守护灵之间的契约是天生决定的，李轩辕也不像是会背弃主人的守护灵，但我也不能让他失望，得好好修行自己的法力才行。）",
	[10100002311] = "（好！今后还要多多修行和战斗吧！）",
	[10100002312] = "一场恶战结束，小亮的腿似乎被恶灵咬伤，血流不止。",
	[10100002313] = "嘶……",
	[10100002314] = "小亮受伤了吗？李轩辕，快把葫芦里的药拿出来！",
	[10100002315] = "李轩辕将药水轻轻涂抹在小亮伤口处，又施加法力加以治疗，伤口很快就愈合了。",
	[10100002316] = "这葫芦是什么来历？还挺灵的。",
	[10100002317] = "这葫芦是上古神器，叫清风化煞，白天是可以治愈百病的清风，晚上则会变成暴虐的化煞。",
	[10100002318] = "如今它已经和李轩辕化为一体了。",
	[10100002319] = "可真是个宝贝。",
	[10100002320] = "你的十殿阎罗有什么来历？给我看看！",
	[10100002321] = "不行。这是曹家历代相传的神器，力量之源乃是庞大无垠的地狱火海。",
	[10100002322] = "持有人越想从其中得到强大的力量风险也越大，如果不注意使用，便会玉石俱焚。",
	[10100002323] = "这种东西如果落入恶人之手，只怕后果不堪设想，断不可以随便交给别人。",
	[10100002324] = "真小气。",
	[10100002325] = "不说这个了，我们继续前进吧。",
	[10100002326] = "穿过西风巷，进入更黑暗的暗巷。",
	[10100002327] = "巷道深处蠕动着许多细丝。",
	[10100002328] = "这是什么？",
	[10100002329] = "一只恶灵骤然从地底破土而出。",
	[10100002330] = "咕噜咕噜……",
	[10100002331] = "是恶灵的头发！大家当心，它头发有腐蚀性黏液，千万别被碰到了！",
	[10100002332] = "敌人气数将近之时，从口中吐出一段头发，趁曹焱兵不备，夺走了十殿阎罗。",
	[10100002333] = "完了！十殿阎罗！",
	[10100002334] = "夏铃纵身一跃，跳进一团头发中，将十殿阎罗取出。",
	[10100002335] = "真胡来！",
	[10100002336] = "主人！",
	[10100002337] = "李轩辕立刻作法切断恶灵的发丝，并用符咒为夏铃张开结界。",
	[10100002338] = "曹焱兵接过夏铃扔过来的十殿阎罗，用火焰将头发焚烧殆尽。",
	[10100002339] = "啊啊……好烫……",
	[10100002340] = "恶灵顷刻间灰飞烟灭。",
	[10100002341] = "恶灵头发上的黏液，可以溶铁，何况凡人肉体。\n还好李轩辕眼疾手快张开了结界，不然姐姐的命可就没了。",
	[10100002342] = "可是十殿阎罗若真有焱兵说得那么厉害，落到敌人手中可就糟糕了。",
	[10100002343] = "到那时，恐怕我们都只有束手就擒。",
	[10100002344] = "何况，我知道在我跳出去的一瞬间，李轩辕一定会为我张开结界。",
	[10100002345] = "虽然事先没和你们商量过，抱歉，我有时候是有点冲动，嘿嘿。",
	[10100002346] = "（真令人吃惊，武器被夺走的一瞬间的反应，竟然能这样迅速。）",
	[10100002347] = "（更令人吃惊的，是她毫不顾虑自身安危，只考虑解决问题的态度。）",
	[10100002348] = "（以及对自己守护灵无条件信任的心态。）",
	[10100002349] = "（这家伙，说不定有极高的战斗天赋……不，应该说她是天生的寄灵人。）",
	[10100002350] = "（这也是李轩辕这样强的守护灵会对她如此忠诚的原因吧。）",
	[10100002351] = "焱兵，你怎么了？",
	[10100002352] = "唔，没事……",
	[10100002353] = "该说抱歉的人是我，是我误以为对方已经失去意识，才掉以轻心，让武器被夺去的。",
	[10100002354] = "错误在我，今后还要更加谨慎才是。",
	[10100002355] = "总而言之，大家小心一点，离山脚越来越近了，大家加快脚步吧。",
	[10100002356] = "曹焱兵回到罗刹街山脚下，鬼符三通正在此等候。",
	[10100002357] = "哟，曹当家的，清理蜘蛛还顺利吗？",
	[10100002358] = "不能说不顺利，不过，其中却有些蹊跷。",
	[10100002359] = "哦？",
	[10100002360] = "我们在那些蜘蛛的腹部和腿上发现了数字编号，或许这些蜘蛛是人为繁衍的结果。",
	[10100002361] = "我收到情报，附近有王国成员活动的迹象，我想或许跟他们有关。",
	[10100002362] = "我们也是这样想的。",
	[10100002363] = "哔哔哔……\n鬼符三通的灵言信响了起来。",
	[10100002364] = "有新的线报，我得去查探一番，那么先告辞了。",
	[10100002365] = "鬼符三通离开。",
	[10100002366] = "怎么办，哥哥？",
	[10100002367] = "兵来将挡。既然有人盯上了我们，那我们也准备迎击。",
	[10100002368] = "小亮，夏铃，你们留在这里，好好守护灵槐树。",
	[10100002369] = "我去把躲在罗刹街暗处的家伙给揪出来。",
	[10100002370] = "曹焱兵来到还未查探过的风筝巷。",
	[10100002371] = "（这边散落了不少机械人的零件，还有一些凌乱的脚印。）",
	[10100002372] = "（不过这些脚印通向一个偏僻的巷道，或许是圈套也不一定，要不要换一条路走？）",
	[10100002373] = "（不，既然他想让我过去，那我便去会会那家伙。）",
	[10100002374] = "前面好像来了什么人？",
	[10100002375] = "是敌人？",
	[10100002376] = "就这点战力，根本不堪一击。",
	[10100002377] = "不过，这里是什么地方来着？",
	[10100002378] = "看来埋伏并不是他们的目的，他们想趁战乱之时，将我引到这个地方来。",
	[10100002379] = "这里像是个庭院，四面有三面都被堵住了，只有一面有狭窄的出口，简直就像是个陷阱似的！",
	[10100002380] = "四周的楼顶上出现不少机械人。",
	[10100002381] = "呵呵，想要瓮中捉鳖？天真！",
	[10100002382] = "远处山顶突然爆发出一束白色光柱，直冲云天。",
	[10100002383] = "是灵槐树附近发出的？特意把我支开，目标却是灵槐树吗？可恶，中计了！",
	[10100002384] = "与此同时，罗刹街灵槐树旁，小亮和夏铃正面对一名难缠的敌人。",
	[10100002385] = "搞乱罗刹街，毁坏灵槐树，你究竟是什么人！",
	[10100002386] = "我是王国十骑士之一的黑尔坎普，奉命来取灵槐树羲和神珠。",
	[10100002387] = "不知道你要取的是什么东西，不过，我不会让你得逞的！",
	[10100002388] = "好大的口气！罗刹街冒险者曹焱兵不在，你可阻挡得了我？",
	[10100002389] = "谁说我不在的。",
	[10100002390] = "哥哥！",
	[10100002391] = "啧，这么快就赶回来了？",
	[10100002392] = "不过刚才的山蜘蛛和王国刺客数量众多，想必已经耗费了你们大量精力，现在的你们，还能战胜得了我吗？",
	[10100002393] = "那就来试试！",
	[10100002394] = "咳咳咳……可恶，我居然……败了……",
	[10100002395] = "走吧，跟我去法庭走一趟。",
	[10100002396] = "看来我还是来晚了。",
	[10100002397] = "鬼符三通出现在大家面前。",
	[10100002398] = "被毁坏成这样，看来只有集齐四颗神珠才能将之复苏了。",
	[10100002399] = "灵槐树根断裂，其树干正源源不断地释放法力，再这样下去，枯竭是迟早的事。",
	[10100002400] = "还是让我先将之封印起来吧。",
	[10100002401] = "鬼符三通使用封灵之术，将灵槐封印了起来。",
	[10100002402] = "这样就行了。",
	[10100002403] = "灵槐之事，也要向灵域汇报才是。",
	[10100002404] = "冥域四颗神树，灵槐被毁，灵域立刻就会知道，或许他们不久他们就会派人过来。",
	[10100002405] = "那么，押送他去法庭的事就交给我吧。",
	[10100002406] = "鬼符三通带着黑尔坎普离开了。",
	[10100002407] = "我会写一封灵言信给灵域，告诉他们事情的来龙去脉吧。",
	[10100002408] = "你就是罗刹街冒险者曹焱兵？",
	[10100002409] = "你是？",
	[10100002410] = "这是自然。之后若发现了什么情况，随时可以来找我。",
	[10100002411] = "虽然只有很小的力量，但足以使一只恶灵倒地，这也替我争取了时间。",
	[10100002412] = "但就在我以为事情已经结束的时候，出现了一个脸生的寄灵人。那人态度嚣张，不太友善的样子。",
	[10100002413] = "只是他只露了一面便消失了，而我法力耗尽，也没有再追赶。",
	[10100002414] = "哔哔哔……\n收到一封来自鬼符三通的灵言信。",
	[10100002415] = "<color=#018e43>鬼符三通</color>来信了，说是还有一些事情有待处理，不过没说具体什么事。",
	[10100002416] = "我们去问问到底发生了什么吧。",
	[10100002417] = "鬼符三通，找我有什么事吗？",
	[10100002418] = "哟，曹当家的，不知道你注意到没有。",
	[10100002419] = "我头顶有时会出现一个<color=#018e43>黄色感叹号</color>。只要还有未完成的关卡，感叹号就会一直存在。",
	[10100002420] = "平日里可以多多留意我头顶的<color=#018e43>黄色感叹号</color>，可别遗忘了未完成之事哦。",
	[10100002421] = "一行人离开罗刹街，已有一段时日。",
	[10100002422] = "怎么一路上也不见个村子。",
	[10100002423] = "是啊，我们风餐露宿，已经好几日了，一路上除了恶灵，一个人影也见不到。",
	[10100002424] = "别着急，我昨晚似乎听见晨钟的声音，或许附近有村子，我们去看看吧。",
	[10100002425] = "救命……有人吗？",
	[10100002426] = "有呼救声！快过去看看！",
	[10100002427] = "两个受伤的孩子坐在地上，害怕得浑身战栗。",
	[10100002428] = "一只高大的恶灵正一步一步逼近。",
	[10100002429] = "喂！别靠近那些孩子，有本事和我较量较量！",
	[10100002430] = "谢谢大哥哥出手相助。",
	[10100002431] = "你们是住在附近的孩子吗？",
	[10100002432] = "是的，我们是附近明镜村的。",
	[10100002433] = "李轩辕，这两个孩子伤得好严重，我们来为他们疗伤吧。",
	[10100002434] = "好。我看孩子们被恶灵咬伤，身上邪毒入侵，若是有灵草给他们服下，就更好了。",
	[10100002435] = "灵草在附近有很多，我去前面找两株来。",
	[10100002436] = "白水儿&狗儿",
	[10100002437] = "一从茂盛的石楠旁长着两株纤长的灵草，正微微发着光。",
	[10100002438] = "找到了！这些灵草应该够用了。",
	[10100002439] = "曹焱兵带着灵草回到原来的地方，让孩子们服下去。",
	[10100002440] = "哇，刚才的伤口一点也不痛了。谢谢你们！",
	[10100002441] = "你们怎么会跑到这样荒凉的地方来玩，真不小心啊。",
	[10100002442] = "对不起，下次一定不会了。",
	[10100002443] = "你们村子在哪里，我们送你们回去吧。",
	[10100002444] = "真的吗？太好了！",
	[10100002445] = "嗯，这里的血腥味会引来更多恶灵，在恶灵被吸引来之前，还是快点离开这里吧。",
	[10100002446] = "水儿，真的是往这边走吗？怎么附近一点人迹也没有？",
	[10100002447] = "嗯，我不会记错路的。之所以看不见村子，是因为明镜村的冒险者门大人，为了保护乡亲们，把村子藏起来了。",
	[10100002448] = "正因为如此，我们村子才一直宁静祥和，每天都过着安心的日子。",
	[10100002449] = "你们看，就在前面！那块石碑后面便是了。",
	[10100002450] = "在白水儿的引领下，曹焱兵一行人进入石碑之中。",
	[10100002451] = "穿过一条狭窄的走廊，忽然开阔起来，阳光洒满了大地。",
	[10100002452] = "哇！这样一块小小的石碑里，竟然别有洞天！当真是个世外桃源呀。",
	[10100002453] = "那是……菩提树？",
	[10100002454] = "神话果就在那颗树里吗？太好了，神树也不是很难找嘛！",
	[10100002455] = "大哥哥，大姐姐，你们若不嫌弃，请在我们这里住下吧。",
	[10100002456] = "大家知道你们救了我和狗儿，一定会盛情款待你们的。",
	[10100002457] = "一阵脚步声由远及近而来。",
	[10100002458] = "水儿！你们没事吧！",
	[10100002459] = "门大人！",
	[10100002460] = "明镜村的冒险者北落师门赶来。",
	[10100002461] = "你们救了水儿他们，真不知怎么感谢你们。敢问女神尊姓大名？",
	[10100002462] = "门大人客气了，只是举手之劳，不必言谢。我是罗刹街曹焱兵，有事暂时外出，今天正路过这里。",
	[10100002463] = "哦？曹焱兵？\n抱歉，那么恕我不能收留你们了，你们快离开这座村子吧。",
	[10100002464] = "怎么会？什么情况？",
	[10100002465] = "门大人，这是为什么？",
	[10100002466] = "曹焱兵严重失职，导致灵槐神树被毁，现在镇魂街各处都在通缉他。",
	[10100002467] = "若将你们留下，怕只会殃及这座村子和这里的乡亲们。",
	[10100002468] = "虽然很感谢你救了两个孩子，但我只能睁一只眼闭一只眼，当你们没来过。抱歉了。",
	[10100002469] = "通缉犯吗……我明白了。\n小亮、夏铃，我们走吧。",
	[10100002470] = "曹焱兵一行人离开了菩提村。",
	[10100002471] = "唉，还以为会很顺利呢。\n居然被赶出来了。",
	[10100002472] = "没办法，没想到灵域这么快就下达了通缉令。",
	[10100002473] = "咦，前面好像有人来了。",
	[10100002474] = "一对装备精良的士兵跑来，将三人团团围住。",
	[10100002475] = "呵呵呵，发现了一个意外的收获。",
	[10100002476] = "南御夫，羽林街总司令，手下统管着三十万羽林军。",
	[10100002477] = "没看错的话，这是被通缉的逃犯曹焱兵吧！\n给我把他带回去，关进地牢等待灵域发落。",
	[10100002478] = "怎么办！",
	[10100002479] = "冲过去！",
	[10100002480] = "别放跑他们，给我追！",
	[10100002481] = "啧，这家伙有点能耐，看来一般的士兵不是他的对手。",
	[10100002482] = "天市，你去把他捉回来。",
	[10100002483] = "是。",
	[10100002484] = "且慢！",
	[10100002485] = "从树林深处走出一个熟悉的身影。",
	[10100002486] = "御夫老弟，许久不见，你怎么到我的地盘上抓人来了？",
	[10100002487] = "北落大哥？你有所不知，这家伙，是被灵域通缉的犯人，非得抓住不可。",
	[10100002488] = "哦？我说了，这里是我的地盘，我想用我的方式解决。虽然你现在升任羽林街司令，但不会不给我这个面子吧？",
	[10100002489] = "既然北落大哥说到这份上，自然有你的理由，我也不勉强了。",
	[10100002490] = "嗯，曹焱兵，念在你救了水儿的份上，我想用我一贯的方式解决问题。",
	[10100002491] = "这样吧，和我打一场吧，若你赢了，我就放了你，若你输了，你就乖乖伏罪，跟南御夫回去。怎么样？",
	[10100002492] = "好，一言为定。",
	[10100002493] = "那么，来村外棚石外找我吧。",
	[10100002494] = "曹焱兵休息了一夜，在约定的时间来到村外。",
	[10100002495] = "曹焱兵，没有忘记我们的赌约吧？",
	[10100002496] = "记得很清楚，开始吧。",
	[10100002497] = "哈哈哈哈哈！到此为止吧，曹焱兵。",
	[10100002498] = "你认输了？",
	[10100002499] = "哼，看到你就想起我年轻的时候。",
	[10100002500] = "你走吧，南御夫那边我来说。",
	[10100002501] = "太好了，焱兵！",
	[10100002502] = "若今后有缘再见，我们再一决胜负吧。",
	[10100002503] = "一言为定。",
	[10100002504] = "曹焱兵离开了明镜村。",
	[10100002505] = "虽然逃脱了追捕是好，可这样就拿不到神话神珠了，该怎么办呢？",
	[10100002506] = "只有另想办法了。",
	[10100002507] = "哥哥你看，地上有好多血！",
	[10100002508] = "奇怪，我们来的时候还很平静，怎么现在像经过了一场乱战似的。",
	[10100002509] = "血迹顺延过去，好像往明镜村那边去了，我们快过去看看吧！",
	[10100002510] = "一处阴暗的角落，羽林军正挥刀向村民砍去。",
	[10100002511] = "住手！",
	[10100002512] = "太晚了，村民已经……",
	[10100002513] = "你们看，那边躺着的人好眼熟……好像是水儿！",
	[10100002514] = "水儿，你没事吧！",
	[10100002515] = "救救……爸爸……门大人……",
	[10100002516] = "北落师门是你父亲？",
	[10100002517] = "南御夫为了抢夺神话神珠，趁门大人不在，放火烧了村子。",
	[10100002518] = "他以我为要挟，用锁灵石锁住了门大人，门大人就这样被他们抓走了！",
	[10100002519] = "咳咳咳……咳咳……",
	[10100002520] = "你流了好多血，还是别说话了！",
	[10100002521] = "可恶，南御夫那家伙，表面上和北落师门称兄道弟，背地里却做出这种事。",
	[10100002522] = "水儿，你放心，我们一定将北落师门带回来。",
	[10100002523] = "曹焱兵一行人来到羽林街。",
	[10100002524] = "喂！是什么人？这里禁止通行！",
	[10100002525] = "闪开！没时间和你们废话！",
	[10100002526] = "在一处宫门前的空地上，站着一个人，看上去已经等了很久。",
	[10100002527] = "曹焱兵，别想从这过去。",
	[10100002528] = "休想阻止我！",
	[10100002529] = "到了第二宫殿的大门，天市正坐在高台上骄傲地俯视着他们。",
	[10100002530] = "紫薇败了，败在她自视甚高，败在她手下无人。",
	[10100002531] = "我跟她不一样，我更喜欢用兵。",
	[10100002532] = "天市一打响指，旁边出现许多身穿精锐盔甲的战士。",
	[10100002533] = "给我杀了他们。",
	[10100002534] = "我的精锐部队都不是他的对手，这家伙不可小觑。",
	[10100002535] = "看来只有我亲自出马了。",
	[10100002536] = "众人击败天市，继续向羽林街深处前进。",
	[10100002537] = "在大殿楼梯之上，一个熟悉的身影跪在那里。",
	[10100002538] = "是北落师门！他好像被枷锁困住了，有人在对他施法？",
	[10100002539] = "那是取出镇魂链的法术。\n恐怕他们想杀了北落，又不想惊动灵域，所以才先取出冒险者的身份证明——镇魂链。",
	[10100002540] = "我们得加快脚步，决不能让他们得逞。",
	[10100002541] = "经过一番辛苦，终于赶到了大殿门前。",
	[10100002542] = "赶来了吗？不过迟了一点，北落师门的镇魂链已经被我取出了。",
	[10100002543] = "不过你们来了，就先陪你们玩玩。",
	[10100002544] = "废话少说！",
	[10100002545] = "曹焱兵打败太微，取出了枷锁的钥匙，释放了北落师门。",
	[10100002546] = "我……为了女儿死后的灵魂能安生，所以建立的明镜村，让他们可以无忧无虑地活下去。",
	[10100002547] = "没想到这一切都被南御夫轻而易举地摧毁了。",
	[10100002548] = "我绝对饶不了他！",
	[10100002549] = "那家伙跑哪里去了？",
	[10100002550] = "他去往大殿深处，恐怕是去拿能令他实力大增的玄黄丹。",
	[10100002551] = "走吧，乡亲们的仇，我要找他一笔一笔地算。",
	[10100002552] = "哈哈哈，你们找我吗？",
	[10100002553] = "这里面怎么跟迷宫一样，到处都是机关和士兵，根本抓不住他嘛！",
	[10100002554] = "南御夫狡猾多端，他一定为了拖延时间才东躲西藏。我们分头搜寻吧。",
	[10100002555] = "这里面怎么跟迷宫一样，到处都是机关和士兵，根本抓不住他嘛！",
	[10100002556] = "南御夫狡猾多端，他一定为了拖延时间才东躲西藏。我们分头搜寻吧。",
	[10100002557] = "众人终于在一片废墟处见到了南御夫。\n他一动不动地站立，似乎正在等他们。",
	[10100002558] = "南御夫，别想逃跑，这笔账，我和你算定了。",
	[10100002559] = "好啊，我正等着你们呢。",
	[10100002560] = "南御夫蹲下，将手指咬破，在地上画了一些符号，随即一道光芒闪动，他的身体开始变成一只巨大的怪兽。",
	[10100002561] = "是噬日巨兽！他果然已经吃下了玄黄丹，大家当心！",
	[10100002562] = "这样一来，水儿和乡亲们也可以瞑目了。",
	[10100002563] = "北落，水儿还活着，还有一口气。",
	[10100002564] = "什么！",
	[10100002565] = "我们回村的时候尽力救治了她，不过她伤得太重，恐怕熬不过今晚了……",
	[10100002566] = "她在哪里，快带我去！",
	[10100002567] = "一行人回到水儿的住处。",
	[10100002568] = "对不起，是爸爸没用，认不出身边谁是真心谁是假意，才导致这样的结果。",
	[10100002569] = "爸爸，能够做爸爸的女儿，我真的很幸福……",
	[10100002570] = "所以请你带着我那份，好好活下去……",
	[10100002571] = "呜呜呜……爸爸一定会的，你放心吧。",
	[10100002572] = "水儿闭上了眼睛，瞬间化为烟尘，飞向夜空。",
	[10100002573] = "第二天",
	[10100002574] = "北落，你以后有什么打算呢？",
	[10100002575] = "明镜村没了，水儿也没了，我对这里已经没有了留恋。",
	[10100002576] = "我们为了复活灵槐树，正在各处找寻冥界四神珠。你要跟我们一起走吗？",
	[10100002577] = "也好，是时候离开这里了。",
	[10100002578] = "群英殿的人？有什么事吗？",
	[10100002579] = "灵域有一件灵器被盗，命群英殿找回失物。",
	[10100002580] = "我多方查探，发现罗刹街传出微弱的灵器信号，所以过来看看。",
	[10100002581] = "曹焱兵，你可私藏了梦山灵器？",
	[10100002582] = "什么？我们从来没见过什么灵器。你可别诬蔑人！",
	[10100002583] = "没错，若是不信，大可以让群英殿的人来搜查。",
	[10100002584] = "群英殿事务繁忙，恐怕没这个功夫管你辖区的事。",
	[10100002585] = "既然是你辖区的事，你就好好搜查吧，若发现什么情况，立刻向我报告。",
	[10100002586] = "杨落七消失了。",
	[10100002587] = "什么嘛，真高傲。",
	[10100002588] = "群英殿的人自诩冥界精英，自视甚高，不用理她。",
	[10100002589] = "不过既然上面下达了指令，也只有找找了吧？曹焱兵，你知道梦山神器是什么东西吗？",
	[10100002590] = "我也没听说过，既是神器，还真想见一见。",
	[10100002591] = "我们回罗刹山脚去找小亮吧，他经常阅读冥域典籍，或许知道些什么。",
	[10100002592] = "杨落七",
	[10100002593] = "路边掉落了一片黑色的羽毛。",
	[10100002594] = "咦，这片羽毛虽然颜色乌黑，却闪着光，真漂亮。",
	[10100002595] = "夏铃将羽毛收进口袋。",
	[10100002596] = "哥哥，今天怎么这么早就回来了？",
	[10100002597] = "群英殿下令寻找灵域丢失的灵器，名为梦山灵器，你常常翻阅典籍，可知道是什么样的东西？",
	[10100002598] = "我记得曾在《幻海灵器录》中读到过，不过详细的不太记得了，可以帮我把书拿过来吗？",
	[10100002599] = "《幻海灵器录》……找到了，就是这本。",
	[10100002600] = "就是这本！\n让我找找……唔。",
	[10100002601] = "曹玄亮查阅典籍，在某一页找到了关于灵器的记录。",
	[10100002602] = "这灵器外形是一支笛子，传说是由梦山上一只黑色神鸟化身而成。",
	[10100002603] = "这神鸟羽毛闪着光，喜欢自由自在地四处飞行游历。也许是自己飞到罗刹街来的也说不定。",
	[10100002604] = "刚才我在路上捡到一片黑色的羽毛，羽毛上闪着光，不像普通鸟儿的鸟羽，会不会是神鸟落下的呢。",
	[10100002605] = "我写几封灵言信问问住在镇魂街的幽魂们吧，说不定有什么线索。",
	[10100002606] = "曹玄亮向罗刹街各处幽灵投寄了灵言信。",
	[10100002607] = "哇，这么快就有人回信了！",
	[10100002608] = "曹玄亮拾起灵言信。",
	[10100002609] = "太好了，有消息了，信上是化龙巷的幽灵寄来的，说今天见过一只黑鸟，我们去那边看看吧。",
	[10100002610] = "信中说化龙巷的人见过黑鸟，我们去那边看看吧。",
	[10100002611] = "吼吼吼！",
	[10100002612] = "这是！",
	[10100002613] = "竟敢在我家门口作恶，真是胆大妄为。",
	[10100002614] = "谢谢你们救了我。",
	[10100002615] = "谁在说话？这里没有人呀。",
	[10100002616] = "我在地上。",
	[10100002617] = "大家低头一看，地上站着一只乌鸦。",
	[10100002618] = "乌鸦居然会说话！难不成你就是梦山神器？",
	[10100002619] = "是的，我来自梦山，你们是这条街的冒险者，想必是想带我回去吧？",
	[10100002620] = "但我此次出来，是因为有一件未了的心愿，请允许我做完这件事再将我带回。",
	[10100002621] = "什么事？我们能帮上忙吗？",
	[10100002622] = "我来自人间的梦山，还在人间时，有个小女孩曾在我奄奄一息时救了我一命，我的灵魂才有机会修行成为神器。",
	[10100002623] = "前几日在灵域，我听说那女孩因为战乱被饿死，魂魄进入了罗刹街。所以才化身成乌鸦，飞来这里，想护她进入轮回之道。",
	[10100002624] = "你能帮我找到她吗？",
	[10100002625] = "既是我地盘的事情，我当然会帮忙。\n这里离集市很近，我们去打听打听吧。",
	[10100002626] = "乌鸦",
	[10100002627] = "希望那姑娘没事。",
	[10100002628] = "集市上聚集了许多幽灵，我们在这打听打听吧。",
	[10100002629] = "多亏了冒险者除掉了这条街的恶灵，我们才得以安居。",
	[10100002630] = "希望我能早点进入轮回，投胎成人。",
	[10100002631] = "你问新来的幽灵？最近新来了七个幽灵，其中六个都是老年人，只有一个少女模样的幽灵，不过……",
	[10100002632] = "她怎么了？",
	[10100002633] = "她好像一到罗刹街就变成恶灵了，唉，可怜的孩子。",
	[10100002634] = "怎么会……",
	[10100002635] = "……",
	[10100002636] = "罗刹街里变成恶灵的魂魄只能为冒险者除掉，你还要找她吗？",
	[10100002637] = "带我去吧，只要见到她，我就有方法恢复她的意识。",
	[10100002638] = "你知道她在哪里吗？",
	[10100002639] = "她在青云街深处，就是因为有她在，大伙儿都不敢往那边去呢。",
	[10100002640] = "走吧！我们去看看。",
	[10100002641] = "你要找的人就在青云街最深处，不过千万小心啊，她的样子怪吓人的。",
	[10100002642] = "当心！有敌人！",
	[10100002643] = "快走吧，我感觉到前面有人活动的声音。",
	[10100002644] = "吼吼吼！",
	[10100002645] = "嘶嘶嘶——",
	[10100002646] = "哇，是两个恶灵在战斗！",
	[10100002647] = "那只蝎子……应该就是我要找的人，原来你被恶念缠身，变成这副模样了啊……",
	[10100002648] = "冒险者大人，请救救她吧。",
	[10100002649] = "交给我吧。",
	[10100002650] = "嘶嘶嘶……",
	[10100002651] = "这只蝎子好像很难受的样子……",
	[10100002652] = "交给我吧。用我的力量应该可以让她变回原来的样子。",
	[10100002653] = "不过这样一来，我的意识将不再复苏了。",
	[10100002654] = "你确定要这样吗？意识不再复苏，相当于你只能作为灵器存在于世界上，不能再化身成鸟儿与人交谈了。",
	[10100002655] = "是啊，况且那姑娘死后失去了生前的记忆，已经不记得你了。",
	[10100002656] = "嗯，我已经决定了。",
	[10100002657] = "我是因为被其善意感动，才得以开悟修成灵器。",
	[10100002658] = "乌鸦展开翅膀在天空盘旋，接着俯冲撞向旁边的聚灵石像。",
	[10100002659] = "聚灵石像发出光芒，蝎子女触碰到光芒，外形渐渐消融，变回了原来的样子。",
	[10100002660] = "头好痛……是你们救了我吗？太感谢你们了。",
	[10100002661] = "话音刚落，女孩的灵魂便飘向了轮回之道。",
	[10100002662] = "但乌鸦就此消失，地面上只留下支笛子。",
	[10100002663] = "唉，这就是它的本体吗？",
	[10100002664] = "为了报恩做到这种程度……真令人惊讶。",
	[10100002665] = "我们把东西交给杨落七吧。",
	[10100002666] = "吼吼吼——",
	[10100002667] = "小亮说得没错，这条路上果然有恶灵出没！",
	[10100002668] = "这种程度也敢在此作恶。",
	[10100002669] = "奇怪，怎么感觉附近还有人？",
	[10100002670] = "不像恶灵，倒像幽灵的气息。",
	[10100002671] = "算了，赶紧去下一个清理点吧。",
	[10100002672] = "*喃喃* 奇怪，总觉得有人跟着我，这是怎么回事。",
	[10100002673] = "喂，谁在暗处跟着我？有事找我吗？",
	[10100002674] = "四下一片寂静。",
	[10100002675] = "不肯出来么？",
	[10100002676] = "有办法了。",
	[10100002677] = "曹焱兵假装睡着了。",
	[10100002678] = "你想做什么？",
	[10100002679] = "哇哇哇哇——你、你没睡着吗？",
	[10100002680] = "小幽灵见势不妙，想要逃跑。",
	[10100002681] = "站住！",
	[10100002682] = "那孩子跑哪里去了？",
	[10100002683] = "附近传来一阵吵闹声。",
	[10100002684] = "别、别过来！",
