local ct1 = _G.emptyTab
local title = { id = 1 , name = 2 , condition = 3 , rank = 4 , icon = 5}
local findT = {
	__index=function(t,key)
		if not key or not title[key] then
			return nil
		end
		return t[title[key]]
	end
}
local scene_world_cfg = {
	[300] = {300,0,ct1,1,"ui_zjm_ditu_luochajie"},
	[400] = {400,0,ct1,2,"ui_zjm_ditu_mingjingcun"},
	[500] = {500,0,ct1,3,"ui_zjm_ditu_kongshenzhisen"}
}
for _, value in pairs(scene_world_cfg) do
    setmetatable(value,findT)
end
return _G.ConstClass("scene_world_cfg",scene_world_cfg)