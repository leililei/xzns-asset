	[81000016901] = {81000016901,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002298}},{{"在李轩辕的配合下，西风巷的一群恶灵很快被扫清。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
