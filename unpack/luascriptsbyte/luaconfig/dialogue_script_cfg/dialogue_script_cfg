	[81000023004] = {81000023004,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100003402}},{{"水儿！你们去哪了？大家都在担心你们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
