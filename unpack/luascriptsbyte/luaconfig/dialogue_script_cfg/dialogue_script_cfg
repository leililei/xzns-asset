	[81001042101] = {81001042101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000450}},{{"奶奶，你好像很着急的样子，丢了什么东西吗？附近有恶灵出没，还是不要离人群太远比较好哦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042201] = {81001042201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000451}},{{"奶奶，失语之灵已经没事了，放心吧。\n他现在应该已经回村子了吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042301] = {81001042301,10100000010,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000452}},{{"镇魂将大人，今天出来巡查时间很早啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042302] = {81001042302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000453}},{{"最近罗刹街不太平，我们得搜查仔细些。\n倒是你怎么愁眉不展的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042303] = {81001042303,10100000010,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct1,{{10100000454}},{{"唉，诚如你所说，罗刹街不太平，村子里事情也越来越多，村民们轮番来找我。\n可我分身乏术，处理不过来，要是有个帮手就好了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042304] = {81001042304,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000455}},{{"这有何难，我们既然巡查至此，就交给我们吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042401] = {81001042401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000456}},{{"事情已经都处理了，还有别的什么事吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042402] = {81001042402,10100000010,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000457}},{{"太感谢了，你真是帮了大忙，别的琐碎之事，就不劳曹大人操心了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042501] = {81001042501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000458}},{{"对了，最近你有发现附近还有什么怪事吗？\n多小都行，特别是和外来人相关的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042502] = {81001042502,10100000010,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000459}},{{"唔，我回忆回忆……\n啊，想起来了，有好几个小孩子跑来说看见过蓝色的机器人。当时我没放在心上，不知与大人要找的是否有关。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042503] = {81001042503,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000460}},{{"机器人？有意思……\n多谢，村长，很有用的消息。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001040406] = {81001040406,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000461}},{{"那看我们谁先打倒它吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050101] = {81001050101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000462}},{{"那是谁？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001050102] = {81001050102,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000463}},{{"哇！不要打我啊啊啊啊——咦，是你们？太好了，终于找到你们了！"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001050103] = {81001050103,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000464}},{{"夏铃？你怎么又回来了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001050104] = {81001050104,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000465}},{ct54},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001050105] = {81001050105,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000466}},{{"三天前，夏铃回到了人界，开始了正常生活。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001050106] = {81001050106,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100000467}},{{"你是说有奇怪的机械人在追捕你？鬼符三通说王国组织正计划驱逐所有寄灵人，该不会就是那个组织的人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001050107] = {81001050107,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000468}},{{"在别的地方怎么闹都不关我的事，但胆敢来我罗刹街捣乱，绝不能放过。\n走，我们去把王国组织的人揪出来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050108] = {81001050108,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000469}},{{"咦，有呼救声？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001050201] = {81001050201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100000470},{10100001530}},{{"222号就是这里吧？说要来接我，怎么一个人也没有？怎么这么多蜘蛛网？"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001050201] = {82001050201,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000471}},{{"只知道吵闹的小鬼，你已经没有时间迷茫了。<color=&48bce7>破坏</color>掉这些蜘蛛茧，赶紧前进吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001050301] = {82001050301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100002801}},{{"黏糊糊的……\n蛛茧之中有一些衣服，不知是不是被蜘蛛抓住的不幸的人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001050302] = {82001050302,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct19,{{10100002802}},{{"除此以外，没有发现别的线索。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001050303] = {82001050303,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct15,{{10100002803}},{{"唔……难道真是普通的虫害吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001050304] = {82001050304,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002804}},{{"这条街恐怕已被它们占领了。我往前探探，看能不能救出几个幸存的幽灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[89001050101] = {89001050101,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000472},{10100001601}},{{"这里蛛网密布，看上去有一只会使用蛛网的灵体侵占了这条街。\n据我观察，这些蜘蛛茧的状态也十分奇怪，最好调查一下。"},{"我还有别的事要处理，不能陪你继续前进了，你要多加小心。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[89001050102] = {89001050102,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000473}},{{"原来如此，看来寄信人也凶多吉少了。\n放心，我会<color=","3db0be>破坏</color>掉这些蜘蛛茧，把入侵的恶灵揪出来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050404] = {81001050404,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000478}},{{"曹焱兵将刚才发生的事情一五一十告诉了鬼符三通。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050405] = {81001050405,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{{10100000479}},{{"我知道王国组织中有个善用机械的寄灵人，或许遇到的是他的部下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050406] = {81001050406,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct15,{{10100000480}},{{"至于他们为什么来罗刹街，恐怕还有待调查。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050301] = {81001050301,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{ct176},{{"看来夏铃还没有顺利逃跑。\n曹当家的，快去罗刹街找她吧，情况紧急，说不定现在已经遇到危险了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050302] = {81001050302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct6,{ct177},{{"哦？谁寄来的言灵信？给我看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050401] = {81001050401,10100000001,"","",{ct2},ct1,ct1,3,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000475,10100001538,10100001539}},{{"尊敬的镇魂将大人","\t<color=","FFFFFF00>两格</color>我是住在化龙巷附近的幽灵。最近我们住所附近恶灵出没频繁，附近失踪了不少人，还望大人尽快来化龙巷222号，恶灵一日不除，大家一日不能安生。","化龙巷居民"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050402] = {81001050402,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000476}},{{"是化龙巷旁的幽灵寄来的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050403] = {81001050403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000477}},{{"走，去那边看看。\n鬼符三通，王国组织的调查就拜托你了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050407] = {81001050407,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{{10100002410}},{{"这是自然。之后若发现了什么情况，随时可以来找我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001050401] = {83001050401,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct9,{{10100000481}},{{"等等，你们在自说自话些什么呢！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050501] = {81001050501,10100000012,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000482}},{{"竟然落在区区人类手中……动手吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050502] = {81001050502,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000483}},{{"我们根本不认识你说的骗子，你不会错把我们认成别人了吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050503] = {81001050503,10100000012,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000484}},{{"唔，有这可能……那个骗子是和我同乡的流浪汉，平时做些小偷小摸的勾当，后来谋害了个工匠，抢走他的钱，从乡里逃跑了。今日偶然遇见了他，他怕我抓他，走的时候嚷嚷着要雇人杀我，霸占我的蜘蛛。真是滑稽至极。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050504] = {81001050504,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000485}},{{"我们刚刚碰上一个自称工匠的家伙，不会就是那个骗子吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050505] = {81001050505,10100000012,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000486}},{{"他脸上有道疤吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050506] = {81001050506,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000487}},{{"从眼睛到下巴，很明显。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050507] = {81001050507,10100000012,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000488}},{{"那就是他了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050508] = {81001050508,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000489}},{{"看来是想借我们的手出口气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050509] = {81001050509,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100000490}},{{"可惜没时间修理他，希望他运气好点，别再碰见我们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050801] = {81001050801,10100000058,"","",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000491}},{ct25},{ct3},ct2,false,{{90000000029}},ct1,{ct30},{{"320011804"}},ct1},
	[81001058001] = {81001058001,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000492}},{{"仍有未完成之事，此路暂时无法通过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001055301] = {84001055301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000493}},{{"还没准备好，再观察一下吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050901] = {81001050901,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000494}},{{"可恶，鬼符三通和寄信人都不在，没人带路的化龙巷简直就像迷宫一样……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[89001050901] = {89001050901,10100000007,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000495}},{{"这么多蜘蛛卵，要是孵化出小蜘蛛可就难办了。看我把这些玩意统统<color=&48bce7>破坏</color>掉！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001050902] = {81001050902,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000496}},{ct178},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051101] = {81001051101,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000497}},{{"多谢大人，我终于恢复了自由之身。\n我会把逆子的遗体带回去安葬，希望他来世能走上正道。这里的机关请自由使用吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051301] = {81001051301,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000498}},{{"远方传来火焰燃烧的声音。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051001] = {81001051001,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000499}},{{"黏糊糊的蜘蛛网。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051201] = {81001051201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000500}},{{"看这体积可真不得了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001055702] = {81001055702,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000501}},{{"我再想想。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051701] = {81001051701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000502}},{{"黏糊糊的，真让人不舒服。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051901] = {81001051901,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct13,{{10100000503}},{{"简简单单。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052001] = {81001052001,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000504}},{{"蜘蛛！这就是灾祸的源头吗？\n来吧，找你们好久了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052101] = {81001052101,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000505}},{{"蜘蛛网挡住了去路，找找有没有什么能<color=&48bce7>烧掉</color>它的东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052201] = {81001052201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000506}},{{"哼，看你怎么作祟。\n咦，那边有什么声音？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052301] = {81001052301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000507}},{{"什么人躲在这里！快给我出来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001052401] = {84001052401,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000508}},{{"救命啊！快来人……救救……我……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001052402] = {84001052402,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000509}},{{"附近传来微弱的呼救声。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88001052401] = {88001052401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct19,{{10100000510}},{{"奇怪了，明明刚刚从这里传来了呼救声，怎么到这一看什么人也没有……\n可是，我分明感觉到了幽灵的气息，那人一定就在这附近。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81401052401] = {81401052401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000511}},{{"仔细观察，这里的蜘蛛茧似乎在蠕动。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81801052401] = {81801052401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct6,{{10100000512}},{{"蠕动的蜘蛛茧？对了，听说蜘蛛会把猎物裹在蜘蛛网里，我干嘛不查查这些蜘蛛茧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052501] = {81001052501,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000513}},{ct179},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052502] = {81001052502,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000514},{10100001531}},{{"哈呼，哈呼……终于可以呼吸了。\n啊，是你救了我！谢谢，我没事！被蜘蛛抓来关在这里，只受了点皮外伤。不过那些怪物可真吓死我了！"},{"喂，你也是住在附近的小孩吗？跟我一起逃吧！"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052503] = {81001052503,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000515}},{{"不行，我还不能走。我接到从这里发来的求助信，专程来调查蜘蛛一事。你知道其他居民都去哪了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052504] = {81001052504,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000516}},{{"原来你是镇魂将！那封言灵信是我用三年修为发出去的，这里的居民么……你看那边的地洞。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81201052501] = {81201052501,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000517}},{{"他们都被抓进那个地洞了，不知道现在是凶是吉。你可要小心呀，千万别被毒液融化掉。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052601] = {81001052601,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000518}},{{"你可要小心呀，千万别被毒液融化掉。"}},{ct3},ct2,false,{{90000000115},{90000000113},{90000000114}},ct1,{{"ShowDialogueScriptThenClose"},ct64,ct64},{{"81001052604"},{"800010544"},{"800010545"}},ct1},
	[81001052602] = {81001052602,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000519}},{{"那些小蜘蛛都是大蜘蛛孵化出来了，大蜘蛛在洞穴最深处。不过真奇怪，明明这条街没有洞穴呀……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052603] = {81001052603,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000520}},{{"大家都被抓进那个洞穴了，好可怕。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052604] = {81001052604,10100000056,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000521}},{{"有问题就来找我吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052801] = {81001052801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct13,{{10100000522}},{{"哦！太好了，传送门打开了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052901] = {81001052901,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000523}},{{"蛛网封锁了洞口，无法进入。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052703] = {81001052703,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000524}},{{"钻入洞穴，进入漆黑潮湿的地底。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052701] = {81001052701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100000525}},{{"哇，这洞底竟然这样宽广！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052702] = {81001052702,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000526}},{{"仔细一看，这两个家伙似乎已经入眠了。\n我还是不要惊动他们，找出出口快点溜走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053001] = {81001053001,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000527}},{{"获得火把。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"1","3","Images/Icon/ui_dj_hb","1","0","0"}},
	[81001053002] = {81001053002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000528}},{{"哼哼，这下可以把蜘蛛网烧掉了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"0","3","Images/Icon/ui_dj_hb","1","0","0"}},
	[81001053101] = {81001053101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000529}},{{"全部烧光吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053201] = {81001053201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000530}},{{"进来了！看来这里就是关押居民的地方。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053202] = {81001053202,10100000016,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000531}},{{"镇魂将大人，快来救救我们！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053203] = {81001053203,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000532}},{{"别紧张，蜘蛛网越挣扎捆得越紧，你们呆在原地，我来烧掉这张网。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054306] = {82001054306,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000533}},{{"经过一番努力，曹玄亮救出了居民。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054301] = {82001054301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000534}},{{"这些蜘蛛是从哪里来的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054302] = {82001054302,10100000027,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000535}},{{"我们也不知道啊，那山一样巨大的妖兽四处吐丝，孵化小蜘蛛，大家都吓破了胆，来不及调查它的来历，就被抓到这里来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054303] = {82001054303,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000536}},{{"巨大的妖兽？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054304] = {82001054304,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000537}},{{"嘶——嘶嘶——！！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001054305] = {82001054305,10100000027,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000538}},{{"啊！它又来了！快跑！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053301] = {81001053301,10100000040,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000539}},{{"嘶嘶嘶——！！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053302] = {81001053302,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000540}},{{"这不是被封印的山蜘蛛吗？谁把它放出来的？\n……看来有麻烦了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81601053601] = {81601053601,10100000017,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000541}},{{"完成不了指令的废物，没有存在的必要。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81601053602] = {81601053602,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct22,{{10100000542}},{{"太好了，这蜘蛛现在格外虚弱，只需要带回原处封印起来就没问题了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81601053603] = {81601053603,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000543}},{{"一个陌生的声音突然响起。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001053601] = {84001053601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000544}},{{"看来就是这个人将山蜘蛛放出来的——你是什么人？毁坏罗刹街有什么目的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001053602] = {84001053602,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000545}},{{"目的么，你很快就会知道了，呵呵呵……"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88001053601] = {88001053601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000546}},{{"消失了？！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88001053602] = {88001053602,10100000048,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000547}},{{"别追了，主公。那家伙散发出强烈的压迫感，刚才的战斗我们流失不少灵力，现在不是他的对手，还是先回去和曹焱兵汇合吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053901] = {81001053901,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000548}},{{"关于罗刹街的异动，今天有发现什么线索吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053902] = {81001053902,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct8},ct2,ct1,ct1,ct1,{{10100000549}},{{"*摇头*完全没有……要是有居民来提供一些线索就好了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001053903] = {81001053903,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000550},{10100001532}},{ct180,{"收到一封言灵信。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054001] = {81001054001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000551}},{{"谁寄来的言灵信？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054002] = {81001054002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000552}},{{"是化龙巷旁的幽灵寄来的，你看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054003] = {81001054003,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000553}},{{"看来那边出事了，我过去看看。"}},{ct3},ct2,false,{ct56,ct57},ct1,{ct28,ct58},{ct59,ct60},ct1},
	[81001054004] = {81001054004,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000554}},{{"最近罗刹街动荡不安，怕有人觊觎灵槐引我们离开。不如我先去探探情况，我手脚轻快，去去就回。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054005] = {81001054005,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000555}},{{"也好，寄信人会在巷口接应你，应该没问题。若是遇上危险，就发射信号通知我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054101] = {81001054101,10100000001,"","",{ct2},ct1,ct1,3,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000556,10100001540,10100001541}},{{"尊敬的镇魂将大人","\t<color=","FFFFFF00>两格</color>我是住在化龙巷旁的幽灵。最近这巷子附近失踪了不少人，我们怀疑有魔物入侵，请大人速速来化龙巷222号，我会在路口为你带路，详细情况当面告诉你。","化龙巷居民"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001054201] = {81001054201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct22,{{10100000557}},{{"哦？有宝箱？那我就不客气啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051401] = {81001051401,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000558}},{ct25},{ct3},ct2,false,{{90000000023},{90000000024},{90000000028}},ct1,{ct28,ct28,ct30},{{"810010515"},{"810010516"},{"320011805"}},ct1},
	[81001051501] = {81001051501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000559}},{{"我是罗刹街镇魂将曹焱兵，在此地巡逻，查看是否有可疑之人。\n你是什么人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051502] = {81001051502,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000560}},{ct178},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051601] = {81001051601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000561}},{{"听说要从主路通过，必须点燃冥焰火盆，而要点燃冥焰火盆，必须解开机关才行。\n可以拜托你通融一下，让我们过去吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051602] = {81001051602,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000562}},{{"吾辈的使命是守护机关，吾辈不能让你通过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051603] = {81001051603,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000563}},{{"什么条件？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051604] = {81001051604,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000564}},{{"另一个机关也有个守护人，只有战胜他，缠绕我的咒语才会消失。\n若你愿意帮我，我就让你进去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051605] = {81001051605,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000565}},{{"我看还是打败你比较方便。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051606] = {81001051606,10100000021,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000566}},{{"不……那是我的父亲唐少平，我不想再听从他的命令，于是从宿龙帮逃出，加入幽焰帮。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001051801] = {81001051801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000567}},{{"开启那个机关就可以了吧？看上去并不复杂。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052002] = {81001052002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000568}},{{"这是罗刹街被封印的凶兽，山蜘蛛。若没有外人解开它的符咒，它是不可能跑出来的。\n到底是谁干的……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052102] = {81001052102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000569}},{{"谁知道呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001052401] = {81001052401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000570}},{{"事不宜迟，我们快走吧，哥哥。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060101] = {81001060101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000571}},{{"可恶，刚刚的机械人都是些什么怪胎，一想到他们在罗刹街某个角落做不为人知的破坏性行为就非常不爽。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001060102] = {81001060102,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct8},ct2,ct1,ct1,ct6,{{10100000572}},{{"控制它的人或许也在罗刹街，也许就是那个叫黑尔坎普的家伙。\n我们去附近的镇上问问吧，或许能发现什么眉目。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001060103] = {81001060103,10100000009,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000573}},{{"呜呜……救命！快来救救本大爷！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[86001060101] = {86001060101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000574}},{{"又是误入机关的人吗。\n别着急，我来救你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060201] = {81001060201,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000575}},{{"咦，镇魂将大人，又见面了！\n人家说一回生，二回熟。我们也算熟人了。\n你也走这条路吗？急急忙忙地往哪去呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060202] = {81001060202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000576}},{{"吓我一跳，原来是你。\n我在找一个来捣乱的家伙，你刚刚有看见什么可疑的人吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001060203] = {81001060203,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000577}},{{"方才小的看见一个外国面孔过去了，他还领着一只长着三只头的狗。那狗的大嘴，像山洞一样大，可把我吓得够呛。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060204] = {81001060204,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct1,{{10100000578}},{{"外国面孔，那应该是那家伙没错了。不过三头犬？难道是传说中的地狱三头犬塞伯洛斯？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001060205] = {81001060205,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000579}},{{"谁知道呢。小的不敢招惹他们，躲在树丛里见他们离开了才继续赶路。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060206] = {81001060206,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000580}},{{"也许那就是我们要找的人，走，追过去看看。\n你叫什么名字？能给我们带一段路吗！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001060207] = {81001060207,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000581}},{{"亡灵的名字有什么稀罕记的，带路倒是小事一桩，跟我来吧大人，我亲眼见他朝这边走了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060501] = {81001060501,10100000009,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000582}},{{"咦，得救了？是、是你们救了我吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060502] = {81001060502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000583}},{{"凑近一看原来是一只狗啊。\n我们是罗刹街的镇魂将，你没事吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060503] = {81001060503,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000584}},{{"是犬神！不是狗！\n算了，看在你们救了我的份上这次就不计较了。我们犬神一族知恩图报，请让我把刚刚发现的藏宝点告诉你们作为回报吧，快跟我来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060601] = {81001060601,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000585}},{{"没想到这么快又见面了。\n我在人界调查时发现行刺夏铃的机械人，不过怎么也找不到控制源。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063501] = {81001063501,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000586}},{{"不过我追着线索来到这里，却发现了异兽的踪迹，那恐怕是独属于地狱的猛兽，你可得小心啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063601] = {81001063601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000587}},{{"没办法，只能战斗了。"}},{ct3},ct2,false,{{90000000044}},ct1,{ct30},{{"320011809"}},ct1},
	[81001060701] = {81001060701,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000588}},{{"你来啦？这里每根火柱下面都埋着一个宝箱。去点燃它吧，愚蠢的人类！嘿嘿嘿嘿……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060801] = {81001060801,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000589}},{{"呵呵呵，是财宝！快点燃第三盏灯吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060901] = {81001060901,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000590}},{{"哦！我的推测果然没错，就是这里，大丰收！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061001] = {81001061001,10100000014,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000591}},{ct36},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061002] = {81001061002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000592}},{{"这、这是？陷阱！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061003] = {81001061003,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100000593}},{{"噗噗！傻瓜！老爷我老早就知道这里机关里藏着陷阱，才带你们来当试验品的！现在宝藏是我的了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061004] = {81001061004,10100000001,"","",{ct4,{0,-74,0}},ct1,ct1,0,2,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100000594}},{{"犬神趁大家都发愣时卷走了大部分财宝，一溜烟地跑了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061101] = {81001061101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000595}},{{"可恶！这只臭狗……再碰上绝不饶了它！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061102] = {81001061102,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000596}},{{"没时间管那小毛头了，我们快去镇上吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061201] = {81001061201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000597}},{{"到了。\n想不到这里居然有英武结界。小亮，把手放上石像打开结界吧，小镇就在结界后面。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061202] = {81001061202,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000598}},{{"这里除了一块石碑，什么也没有呀。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061203] = {81001061203,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000599}},{{"那是防止恶灵入内的英武结界，解开它就能进入小镇了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061301] = {81001061301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000600}},{{"石像已经挪开了，我们走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061401] = {81001061401,10100000036,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000601}},{{"这些钱给我吗？真是太感谢你了……孩子们冬天不用担心挨饿了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061402] = {81001061402,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000602}},{{"小意思，本大爷四处搜寻宝藏，可不是为了我一个人！\n你快回家吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001061401] = {82001061401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000603}},{{"就在这里打听打听吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001061401] = {83001061401,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000604}},{{"哇哇哇！是那个镇魂将！哼，最讨厌这些灵域的走狗了。该怎么捉弄一下他们呢……我记得北边有两个帮派在打架来着……有了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001061401] = {84001061401,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000605}},{{"右卫门变身成穷苦人的模样。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061501] = {81001061501,10100000036,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000606}},{{"你问外国面孔的人吗？那家伙拿了我的钱就跑了，往北边走了，也许还没走远。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061502] = {81001061502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct1,{{10100000607}},{{"哦？走，我们去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061503] = {81001061503,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000608}},{{"嗯！（奇怪，这人身上怎么一股狗的味道……）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061601] = {81001061601,10100000057,"","",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000609}},{{"镇魂将大人，有群山霸王突然闯进我家，把家里洗劫一空。爸爸也被他们抓走了，说要抓他回去做仆人，呜呜呜……求求你去救救我父亲！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061602] = {81001061602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000610}},{{"我明白了。\n在这呆着别动，我马上去救你爸爸回来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063801] = {81001063801,10100000057,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000611}},{{"呜呜呜呜……爸爸……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063802] = {81001063802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000612}},{{"怎么了，你怎么哭得这么伤心？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063901] = {81001063901,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000613}},{{"好啦，这件事解决本大爷就安心啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064001] = {81001064001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000614}},{{"那么带我们去找地与三头犬吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064101] = {81001064101,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000615}},{{"你来啦，曹大人。真高兴还能见到你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064201] = {81001064201,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000616}},{{"说起来，有一个可疑的人带着机械人往灵槐树那边去了，我觉得不太对劲，还是告诉大人你一声比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064202] = {81001064202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000617}},{{"哦？我们去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064301] = {81001064301,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000618}},{{"刚才那声巨响真吓人啊……灵槐树若是被毁，罗刹街也将沦为恶灵横行之地。\n看来我得再另寻一处安稳之地了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064401] = {81001064401,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000619}},{{"你问我那些可疑的家伙往哪里去了吗？\n在东边，刚走不远，大人现在去追，一定能赶上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001064501] = {81001064501,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000620}},{{"怎么啦？"}},{ct3},ct2,false,{{90000000063},{90000000064}},ct1,{ct28,ct28,ct28},{{"820010645"},{"830010645"}},ct1},
	[81001064601] = {81001064601,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000621}},{{"点击顺序错误，可以向犬神询问正确顺序。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001064501] = {82001064501,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000622}},{{"这种宝藏机关虽然随处可见，可要想找到好东西，可要费一番功夫。\n不过这难不倒我宝藏猎人，不论多难找的宝藏，我都一定能找到！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001064501] = {83001064501,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000623}},{{"注意要按规定的顺序开启才行哦！顺序是一三二，千万别搞错了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061701] = {81001061701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,1,{ct2},ct2,ct1,ct1,ct1,{{10100000624}},{{"转了一圈没有发现什么异兽，倒遇上过一只讨厌的狗。对了，你有见过一只自称犬神的穿衣服的狗吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061801] = {81001061801,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000625}},{{"没有遇上这样的骗子，不过，倒发现一个大家伙。\n先前跟你说的猛兽，或许就是关押在冥河旁的地与三头犬。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061802] = {81001061802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000626}},{{"地狱三头犬？冥河离这那么远，那家伙是怎么跑到这来的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061803] = {81001061803,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000627}},{{"想必是有人解开了它的镇兽锁，带它来的。\n不过，虽然我能感知他的气息，却怎么也找不到它在什么位置，或许有人用灵力将它隐藏起来了。要找到它可不容易。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061901] = {81001061901,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000628}},{{"怎么回事……这里聚集了这么多人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061902] = {81001061902,10100000061,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000629}},{{"偷了东西别不承认，今天你必须把神珠给我们还回来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061903] = {81001061903,10100000060,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000630}},{{"我们岩渊派行事光明，从不做这等龌龊事。我看你们是想加罪于我们，好夺走你们垂涎已久的灵力秘技，我没说错吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061904] = {81001061904,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000631}},{{"怎么办，我们帮哪边？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001061905] = {81001061905,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000632}},{{"唔……"}},{ct3},ct2,false,{{90000000030},{90000000031}},ct1,{ct181,ct181},{{"810010620","320011806"},{"810010621","320011807"}},ct1},
	[81001062001] = {81001062001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000633}},{{"炎龙派别欺人太甚了，凭空诬蔑清白之人，不太好吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062002] = {81001062002,10100000061,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000634}},{ct182},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062003] = {81001062003,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000635}},{ct65},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062101] = {81001062101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000636}},{{"做这种偷鸡摸狗之事，岩渊派的做法惹人耻笑。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062102] = {81001062102,10100000060,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000637}},{ct182},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062103] = {81001062103,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000638}},{ct65},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062201] = {81001062201,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000639}},{{"*模仿曹焱兵的声音*一群宵小，胆敢在我的地盘撒野斗殴，活得不耐烦了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062202] = {81001062202,10100000060,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000640}},{{"什么？给我拿下这个家伙！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062203] = {81001062203,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000641}},{ct65},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062301] = {81001062301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100000642}},{{"可恶，莫名其妙跟人打了一场。我们快离开这个是非之地吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062302] = {81001062302,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000643}},{{"唔，把他骗来此处，本想让这些帮派好好教训教训他，没想到这家伙身手还不错，倒让他逞了一回英雄……\n对了，我记得东边有一只被结界藏起来的地狱三头犬。我得想个办法把这镇魂将引到那里去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062401] = {81001062401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000644}},{{"喂，你这家伙，那是条被封锁的路，只有两个帮派在争斗，住在这附近你不可能不知道这回事吧？\n你骗我去那边干嘛？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062402] = {81001062402,10100000036,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000645}},{{"啊？大人你在说什么？小的完全不知道啊……小的、小的今天是第一次遇见过大人啊……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062403] = {81001062403,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000646}},{{"哥哥，我想应该不是他干的。\n刚才这人身上有浓重的狗味，现在却消失了。也许是先前那只犬妖变成他的样子来捉弄我们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062404] = {81001062404,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000647}},{{"我们明明救了他，他为什么要对我们做这种事？真是不明白。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062501] = {81001062501,10100000005,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000648}},{{"曹大人，好久不见。\n你有急事要赶路吗？最好不要从这里走哦，那边是山霸王的老巢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062502] = {81001062502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000649}},{{"那山霸王抓了镇里的人，我正想去找他们呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062503] = {81001062503,10100000005,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000650}},{{"原来如此，曹大人果然是正义之士。我这里还有一株“灵草”，或许之后对你有大用，请你收下吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062601] = {81001062601,10100000039,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000651}},{{"小少爷要出生了，府上人手不够，快把它带回去，去后厨打扫卫生！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062601] = {84001062601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000652}},{{"喂，你们的对手在这边！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062701] = {81001062701,10100000030,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000653}},{{"谢谢大人出手相救……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062702] = {81001062702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000654}},{{"你的儿子还在镇上等你呢，快回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001062701] = {82001062701,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000655}},{{"两人说话时，一个假装晕厥的山霸王突然起身，抓起涂满“散魂毒”的箭朝曹焱兵刺来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001062701] = {83001062701,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000656}},{{"啊呀呀呀呀！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062706] = {84001062706,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000657}},{{"千钧一发之际，一个熟悉的身影从天而降，压垮了心怀不轨的山霸王。\n曹焱兵定睛，发现他认得这家伙。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062701] = {84001062701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000658}},{{"是你这只臭狗！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062702] = {84001062702,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000659}},{{"正是本大爷！没想到吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062703] = {84001062703,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000660}},{{"果然是你。你几次三番害我们，现在又救了我们，到底想做什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062704] = {84001062704,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000661}},{{"不不不，本大爷可不是想害你，只是想对嚣张跋扈的灵域走狗略施惩罚罢了。不过一视同仁看待兽族的人，就是我的朋友！有什么需要帮忙的地方请尽管说！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062705] = {84001062705,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000662}},{{"原来如此。你有苦衷，我能理解。不过一码归一码，你害我们两次陷入危险，这事可不能算了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062707] = {84001062707,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000663}},{{"唔唔……我……我知道啦！\n刚才听说你们在找地狱三头犬？那家伙被灵力藏起来了，一般幽灵察觉不到它的气息。本大爷知道他的位置，就由我冒风险给你们带路吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062708] = {84001062708,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000664}},{{"好，要是再骗人，我可饶不了你！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84001062709] = {84001062709,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000665}},{{"赌上我爷爷的名声，绝对不会再骗你啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062801] = {81001062801,10100000057,"","",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000666}},{{"爸爸没事真是太好啦！\n曹大人，谢谢你，这些微薄的谢礼请你收下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001062901] = {81001062901,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000667}},{{"鬼符三通，这家伙知道三头犬的位置，你要跟我们一起去吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063001] = {81001063001,10100000015,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000668}},{{"哦？那太好了。不过关于幕后操纵者，我掌握了一些新的线索要调查，三头犬就交给你了，镇魂将。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063101] = {81001063101,10100000038,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000669}},{{"嗷吼吼吼！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063102] = {81001063102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000670}},{{"小亮，看它的胳膊，有和机器人一样的标志！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063201] = {81001063201,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000671}},{{"好啦，本大爷要溜了！\n本大爷喜欢四处游历收集财宝，要是有好东西，以后就便宜卖给你吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063301] = {81001063301,10100000037,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000672}},{{"咕噜咕噜……啊！别靠近我的财宝袋！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001063201] = {82001063201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000673}},{{"我们也快走吧，哥哥，不快点找到那个黑尔坎普，不知道他还会做出什么事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063401] = {81001063401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000674}},{{"我感觉鬼符三通的气息靠近了，我们去问问他有什么发现吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001063402] = {81001063402,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000675}},{{"小亮的感知可真灵敏……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060301] = {81001060301,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000676}},{{"太精彩了，曹大人。\n在转世前能目睹这样一战，也不枉我被那破笼子关了七天之久了。那我就此告辞了，下辈子再见！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060302] = {81001060302,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct4,ct1,ct1,{{10100000677}},{{"轰隆隆……从灵槐树附近发出一阵喧哗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060303] = {81001060303,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000678}},{{"是从灵槐附近传来的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001060304] = {81001060304,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct7,{{10100000679}},{{"结界光芒闪烁，是灵气不足所致……糟了，灵槐树不会有危险了吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001060305] = {81001060305,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000680}},{{"可恶，竟然趁我不在的时候……走，赶紧回家。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001070101] = {81001070101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000681}},{{"这是……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001070201] = {81001070201,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000682}},{{"哦，曹当家，又见面了。我看见三头犬的遗体，是你干的吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001070202] = {81001070202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000683}},{{"这里是什么情况，这些魂兵冒犯你了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070301] = {81001070301,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000684}},{{"不，我只是循着足迹和邪气一路调查来到此地，就看到了这番景象。"}},{ct3},ct2,false,{{90000000036}},ct1,{ct27},{{"810010704"}},ct17},
	[81001070401] = {81001070401,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000685}},{{"*摇头* 暂时还没有眉目。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001070402] = {81001070402,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000686}},{{"这些魂兵胸前的标记，看来是尸蟒将军的部下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070403] = {81001070403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct1,{{10100000687}},{{"的确。那家伙是遇上什么强敌了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070404] = {81001070404,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000688}},{{"我猜是两方势力在此地争夺，才会留下这样的惨状。\n我们顺着足迹往前看看吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070501] = {81001070501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100000689}},{{"呕，恶灵的味道好恶心……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070502] = {81001070502,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000690}},{{"没事吧主公？快服下这颗药稳定心神。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070503] = {81001070503,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct1,{{10100000691}},{{"谁下手这么狠……哥哥，我们调查一下这些遗体，或许有什么发现。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001070601] = {81001070601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000692}},{{"怎么样哥哥，有什么发现？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
