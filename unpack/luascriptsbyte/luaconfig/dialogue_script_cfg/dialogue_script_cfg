	[81002029303] = {81002029303,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003606}},{{"幸好及时扑灭，没有烧伤太严重。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029304] = {81002029304,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct10,{{10100003607}},{{"“烧伤”……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029305] = {81002029305,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003608}},{{"啊，这不是预言中第一个劫吗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029306] = {81002029306,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003609}},{{"也许只是凑巧，不过如果是真的，那么接下来的“遗失”和“分离”也会发生。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029307] = {81002029307,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003610}},{{"难道我们会分道扬镳？还是……两人之间有一个会挂掉？不不不，我在想什么？不能想这样晦气的事情！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029308] = {81002029308,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003611}},{{"如果预言是真的，的确有发生的可能。不论如何，小心为上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029401] = {81002029401,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003612}},{{"喂，你确定往这边走吗？怎么没路了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029402] = {81002029402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct10,{{10100003613}},{{"奇怪，地图上写的是往这边走啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029403] = {81002029403,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003614}},{{"等等，我们这是迷路了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029404] = {81002029404,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct8},ct2,ct16,ct1,ct1,{{10100003615}},{{"不远处传来一阵惨叫声。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029405] = {81002029405,10100003645,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003616}},{{"啊啊啊……别杀我！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029406] = {81002029406,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003617}},{{"有恶灵？喂，大家伙！别想害人！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029501] = {81002029501,10100003645,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003618}},{{"谢谢你们的救命之恩！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029502] = {81002029502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003619}},{{"顺手的事。倒是你怎么离开幽灵聚居的村子，到这么偏远的地方来了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029503] = {81002029503,10100003645,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003620}},{{"我的孩子得了重病，村子里的人说会传染，就把我们赶了出来，我们父子二人只好在这荒无人烟的地方盖个草房子住下了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029504] = {81002029504,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct11,{{10100003621}},{{"真可怜……你孩子得的什么病？带我去看看吧，我会一点治疗术，或许能帮到你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029505] = {81002029505,10100003645,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003622}},{{"真、真的吗？！你是大夫？？？那真是太感谢了！前面的茅草屋就是我家，我这就带你去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029506] = {81002029506,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100003623}},{{"就是不远处山脚下的草房子吗？很近嘛。\n焱兵，我去他家看看就回来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029507] = {81002029507,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct10,{{10100003624}},{{"那我在这研究下地图吧，可恶，这地图好多记号都看不清了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029501] = {82002029501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100003625}},{{"我知道了，地图上写着，所以我们刚才才走错了路，应该走这边才对。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029502] = {82002029502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100003626}},{{"奇怪，夏铃那家伙怎么去了这么久，早知道就不分开，和她一起去了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029503] = {82002029503,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100003627}},{{"分开……“分离”？预言中提到的一个劫。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029504] = {82002029504,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct8},ct2,ct1,ct1,ct1,{{10100003628}},{{"怎么感觉有种不好的预感……我得赶紧去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029505] = {82002029505,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003629}},{{"曹焱兵赶往茅草屋，却见里面空无一人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029506] = {82002029506,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct12,{{10100003630}},{{"糟了，是陷阱！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002029507] = {82002029507,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct14,{{10100003631}},{{"不过，地面似留下了一些灵力记号……这是夏铃留下的！我得快点跟着记号去找他们！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029601] = {81002029601,10100000008,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct14,{{10100003632}},{{"跟着灵力走到这里来了。\n这鬼地方还真是让人生气——咦，夏铃，你没事吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029602] = {81002029602,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003633}},{{"我被锁灵石锁住了，这叫没事吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029603] = {81002029603,10100000019,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct16,ct1,ct1,{{10100003634}},{{"吼吼吼！！！可恶，既然你也来了，那就一起受死吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029604] = {81002029604,10100003645,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003635}},{{"啊，追过来了！没办法，我还是先溜吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029605] = {81002029605,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003636}},{{"伪装成弱者将路人骗去喂食恶灵吗？决不能饶恕！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029701] = {81002029701,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003637}},{{"打败恶灵后，曹焱兵帮助夏铃解开锁灵石。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029702] = {81002029702,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003638}},{{"那农夫在你战斗的时候逃跑了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029703] = {81002029703,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100003639}},{{"我知道，不过那恶灵有点难对付，我也无暇顾及他了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029704] = {81002029704,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100003640}},{{"我的钱袋也被那家伙偷走了，真可恶！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029705] = {81002029705,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct10,{{10100003641}},{{"钱袋被偷，算“遗失”吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029706] = {81002029706,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003642}},{{"你说那则预言吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029707] = {81002029707,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003643}},{{"没错，预言已经发生了两个，不过最后一个和预言中不同了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002029708] = {81002029708,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct13,{{10100003644}},{{"看来，命运在不知不觉之间发生改变了呢！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030001] = {81002030001,0,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003646}},{{"焱兵！救救我！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030201] = {81002030201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003653}},{{"就是这孩子吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030202] = {81002030202,10100003704,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003654}},{{"没错，麻烦你跑这么远来送他。这孩子父母兄弟都变成恶灵了，好在还有个在白河村的舅舅，这就想托人带他去舅舅家。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030203] = {81002030203,10100003704,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100003655}},{{"可是，最近恶灵出没频繁，幸好镇魂将大人愿意帮忙护送他过去。阿良，快说谢谢大人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030204] = {81002030204,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003656}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002030201] = {83002030201,10100003070,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003657}},{{"阿良自顾自地跑开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002030202] = {83002030202,10100003704,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003658}},{{"这孩子真没礼貌……\n不过，想来是近日接连失去亲人的缘故，大人不要见怪。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002030203] = {83002030203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct13,{{10100003659}},{{"小孩子嘛。焱兵，现在我们就带孩子出发吧，趁天色还早。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002030204] = {83002030204,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100003660}},{{"嗯，我们先下山吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030301] = {81002030301,10100003704,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003661}},{{"孩子的舅舅住在白河村，麻烦你护送他过去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030401] = {81002030401,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003662}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030701] = {81002030701,10100000011,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003663}},{ct51},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002030702] = {81002030702,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100003664}},{{"小心！恶灵来了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002030801] = {82002030801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003665}},{{"有惊无险，只是个低等恶灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002030802] = {82002030802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct10,{{10100003666}},{{"那孩子去哪里了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002030803] = {82002030803,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003667}},{{"咦，怎么不见了？难道是刚刚看见恶灵吓跑了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002030804] = {82002030804,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003668}},{{"去附近找找吧，应该没有跑远。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
