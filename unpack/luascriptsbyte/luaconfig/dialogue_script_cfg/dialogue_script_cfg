	[81003025811] = {81003025811,10100002735,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100002660}},{{"头好痛……是你们救了我吗？太感谢你们了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025812] = {81003025812,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002661}},{{"话音刚落，女孩的灵魂便飘向了轮回之道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025813] = {81003025813,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002662}},{{"但乌鸦就此消失，地面上只留下支笛子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
