	[81001020801] = {81001020801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000162}},{{"这条路阴森森的，让人心里发毛。我们快点离开这里吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020901] = {81001020901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct11,{{10100000163}},{{"咦，焱兵，为什么我按你说的方法，却召唤不出守护灵？是哪里出错了呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
