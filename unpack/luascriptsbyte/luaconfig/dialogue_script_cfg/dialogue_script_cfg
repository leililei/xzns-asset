	[81000016904] = {81000016904,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct10,{{10100002301}},{{"你的守护灵这样厉害，居然愿意听令于你这样的菜鸟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016905] = {81000016905,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100002302}},{{"啊？守护灵不都应该听从寄灵人的命令吗？我们是他们的主人诶。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016906] = {81000016906,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002303}},{{"话是这样说，但厉害的守护灵也是会挑主人的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016907] = {81000016907,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100002304}},{{"他们只肯替他们认可的人效命，如果寄灵人的能力不足以驾驭守护灵，他们宁愿呆在心灵空间也不愿出来为主人效力。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016908] = {81000016908,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100002305}},{{"还有这样的事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016909] = {81000016909,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct11,{{10100002306}},{{"那会不会有一天，李轩辕不愿再听令于我呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016910] = {81000016910,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct13,{{10100002307}},{{"这很难说，毕竟你太菜了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016911] = {81000016911,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100002308}},{{"什么嘛，我很快就会变强的！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016912] = {81000016912,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100002309}},{{"主人多虑了，我被封印囚禁了上千年，解救出我的你既是我的主人，又是我的恩人，我不会做出背弃恩人之事的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016913] = {81000016913,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct11,{{10100002310}},{{"（虽然寄灵人与守护灵之间的契约是天生决定的，李轩辕也不像是会背弃主人的守护灵，但我也不能让他失望，得好好修行自己的灵力才行。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000016914] = {81000016914,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002311}},{{"（好！今后还要多多修行和战斗吧！）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017001] = {81000017001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002312}},{{"一场恶战结束，小亮的腿似乎被恶灵咬伤，血流不止。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017002] = {81000017002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct19,{{10100002313}},{{"嘶……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017003] = {81000017003,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct7,{{10100002314}},{{"小亮受伤了吗？李轩辕，快把葫芦里的药拿出来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017004] = {81000017004,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002315}},{{"李轩辕将药水轻轻涂抹在小亮伤口处，又施加灵力加以治疗，伤口很快就愈合了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
