	[81002032202] = {81002032202,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003718}},{{"咦！这是……幽灵的碎片？居然会讲话。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032203] = {81002032203,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003719}},{{"我是住在明槐街的幽灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032204] = {81002032204,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003720}},{{"今天我正在路上走路，一群恶灵冲过来，一把就把我丢进袋子里。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032205] = {81002032205,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003721}},{{"我趁他们不注意，悄悄把魂魄分成两半，这才得以从布袋里逃出一部分。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032206] = {81002032206,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003722}},{{"剩下的一半应该还在他们手里，要两半合二为一，我才能再次成形，大人能帮我找回来吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
