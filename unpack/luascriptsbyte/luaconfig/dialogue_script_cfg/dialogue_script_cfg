	[82003055904] = {82003055904,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct22,{{10100003002}},{{"今天的巡查也差不多结束了，我们去隔壁化龙巷买点吃的，你留在这休息一会儿吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055901] = {81003055901,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct22,{{10100003003}},{{"我们去化龙巷买点吃的来，你留在这休息一会儿吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055201] = {81003055201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003004}},{{"这里人真多啊，哪里有吃的卖呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055202] = {81003055202,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003005}},{{"喂，那边那个人！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055203] = {81003055203,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct10,{{10100003006}},{{"嗯？是在叫我吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055204] = {81003055204,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003007}},{{"就是你，年轻人，过来过来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003056001] = {81003056001,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003008}},{{"可以帮我个忙吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003056002] = {81003056002,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003009}},{{"刚才我逛街的时候，不小心把银钗掉在附近了，可我眼睛不好，能帮我找找吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003056001] = {82003056001,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003010}},{{"那支银钗不值什么钱，不过，是一件充满回忆的东西。可以帮我找找吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003056001] = {83003056001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003011}},{{"一支旧旧的银钗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003056002] = {83003056002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003012}},{{"找到了，应该就是这个。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056001] = {84003056001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003013}},{{"老人家，是这个吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056002] = {84003056002,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003014}},{{"就是这个！谢谢你啦，真是帮了大忙。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056003] = {84003056003,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003015}},{{"说起来，你好像不是这附近的人啊。这边恶灵可不少，你来这里做什么呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056004] = {84003056004,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003016}},{{"曹焱兵把刚才发生的事告诉了老婆婆。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056005] = {84003056005,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003017}},{{"啊，原来是这样啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056006] = {84003056006,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003018}},{{"那真不巧，今天集市以卖生活用品为主，衣服呀，柴火什么的，明天才开始卖吃的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056007] = {84003056007,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003019}},{{"如果不嫌弃，不如来我家里，我今天早上做了一些米糕，就当作是给你的谢礼吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003056008] = {84003056008,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct10,{{10100003020}},{{"那真是太感谢了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85003056001] = {85003056001,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003021}},{{"我家就在化龙西巷，跟我来吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003056101] = {81003056101,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003022}},{{"集市上人真多呀，你也是专门来赶集的吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003056101] = {82003056101,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003023}},{{"化龙巷从前没什么生人，最近倒是多了许多生面孔。\n这到底是好事还是坏事呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003056101] = {83003056101,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003024}},{{"大人需要修理桌椅凳子吗？我的木工活儿做得可好了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055301] = {81003055301,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003025}},{{"就是这里了，你在这里稍等一下，我进去找找。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055301] = {82003055301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100003026}},{{"这里是医馆？原来老人家是药师啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003055301] = {83003055301,10100000011,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003027}},{ct46},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003055302] = {83003055302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003028}},{{"可恶，居然跑到居民区来了，真是大胆。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055801] = {82003055801,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003029}},{{"来了来了！\n这是……恶灵？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055802] = {82003055802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct10,{{10100003030}},{{"是啊，没想到恶灵竟然入侵到这里来了。婆婆你平时可要多加小心啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055803] = {82003055803,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003031}},{{"放心吧，大人，老身会注意保重小命的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055804] = {82003055804,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003032}},{{"婆婆递来手中的小包裹。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055805] = {82003055805,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003033}},{{"里面有一些我烤制的富含治愈灵力的甜甜米糕，还有一瓶水和治愈草药。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055806] = {82003055806,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct10,{{10100003034}},{{"这么多……真是不好意思。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055807] = {82003055807,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003035}},{{"大人客气了，大家能在此安居，都是因为有你们在。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003055808] = {82003055808,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003036}},{{"请安心地收下吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003056201] = {81003056201,10100003069,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003037}},{{"希望你的朋友没事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065101] = {81003065101,10100000019,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003090}},{ct32},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065102] = {81003065102,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003091}},{{"小亮你看，它手里是什么东西？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065103] = {81003065103,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003092}},{{"那是……灵魂核心！\n别让它吞下去了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065701] = {81003065701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct22,{{10100003093}},{{"太好了，灵魂核心完好无损。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065702] = {81003065702,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003094}},{{"灵魂核心是什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065703] = {81003065703,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003095}},{{"幽灵转生前会化为一个类似胚胎的光球，叫做灵魂核心。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065704] = {81003065704,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003096}},{{"只要把它送到转生点，幽灵就可以转生了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065705] = {81003065705,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct13,{{10100003097}},{{"它的转生点在哪里呢？我们送它去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065706] = {81003065706,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct19,{{10100003098}},{{"这个么，我也不知道。\n不如我们去附近找找，说不定有什么线索。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065201] = {81003065201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003099}},{{"你们看，那是什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066001] = {81003066001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003100}},{{"是一张残页，好像写着什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066002] = {81003066002,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003101}},{{"“2月18日，天气阴。\n来到村子的第三个月，我收到了灵域的言灵信，说我还有不久就可以转生了。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066003] = {81003066003,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003102}},{{"“真开心，终于能离开这里。 \n妈妈和弟弟也开心极了。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066004] = {81003066004,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003103}},{{"“希望妈妈和弟弟也能快点收到转生言灵信。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066005] = {81003066005,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003104}},{{"“2月25日，天气晴。\n今天妈妈带着我和弟弟出门野餐，天气真好。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066006] = {81003066006,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003105}},{{"“真希望来世也能和他们成为家人。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066007] = {81003066007,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003106}},{{"是日记。里面提到转生的日子和灵魂核心一模一样，日记的主人应该就是他了吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066008] = {81003066008,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003107}},{{"日记里提到他有亲人，我们去附近的村子找找，兴许能从他亲人口中知道点什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065301] = {81003065301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100003108}},{{"这里的幽灵，谁是他的亲人呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065302] = {81003065302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100003109}},{{"算了，就问问关于幽灵转生的消息吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066501] = {81003066501,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003110}},{{"转生么？小张的大儿子听说就要转生了，你去问问她吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003066501] = {82003066501,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003111}},{{"转生？还有这种好事？\n对我来说，别变成恶灵就不错了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003066501] = {83003066501,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003112}},{{"真希望我们大家都能坚持到转生的那一天，不要被恶念侵蚀了才好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066101] = {81003066101,10100000056,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003113}},{{"是镇魂将大人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066102] = {81003066102,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003114}},{{"我家哥哥已经转生了。出什么事了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066103] = {81003066103,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100003115}},{{"你就是他弟弟么？你哥哥转生途中遇到恶灵阻挠，现在需要有人将他的灵魂核心送到转生点才行。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066104] = {81003066104,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003116}},{{"那种事情我怎么会知道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066105] = {81003066105,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003117}},{{"事关你哥哥能不能成功转生，你再好好想想？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066106] = {81003066106,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003118}},{{"哥哥和妈妈已经走了，我也不知道他们去哪了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066107] = {81003066107,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003119}},{{"我已经被他们抛弃了，你们来问我也没有用。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066108] = {81003066108,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct11,{{10100003120}},{ct45},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066109] = {81003066109,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct14,{{10100003121}},{{"镇魂街里为了保全自己，抛弃家人的事也常有发生。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066110] = {81003066110,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003122}},{{"毕竟身边多一个人，就多一份变成恶灵的风险，也许他的哥哥和母亲也是因为这个离开这里的吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066111] = {81003066111,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003123}},{{"虽然是这样，我们也不能放着不管。\n帮助幽灵转生是镇魂将的职责。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066112] = {81003066112,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003124}},{{"不过看样子是问不出什么了，还是我们自己找找线索吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003066501] = {84003066501,10100000056,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003125}},{{"哥哥……妈妈……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066201] = {81003066201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003126}},{{"你们看，我找到这个。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066202] = {81003066202,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003127}},{{"是日记碎片？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066203] = {81003066203,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003128}},{{"“3月1日，天气阴。\n今天和妈妈一起做了个大蛋糕，因为今天是弟弟的生日。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066204] = {81003066204,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003129}},{{"“我们三人都很开心，要是永远这样开心就好了。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066205] = {81003066205,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003130}},{{"是日记。对了，我们在附近找找他留下的日记碎片吧，或许里面会记载关于转生点的信息。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065401] = {81003065401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003131}},{{"找到了，这里有一张！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066301] = {81003066301,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003132}},{{"“3月4日，天气雨。\n今天被灵域告知明天我就可以去明镜台转生，我开心极了。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066302] = {81003066302,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003133}},{{"“可是，这天晚上，妈妈忽然被邪念侵蚀，变成了恶灵。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066303] = {81003066303,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003134}},{{"“她撕咬东西的声音把我惊醒，我呼唤她时，她已经不认得我了。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066304] = {81003066304,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003135}},{{"“我怕她伤害熟睡的弟弟，于是跑出家门，想把她引向离家更远的地方。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066305] = {81003066305,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003136}},{{"“不知道以后有没有机会见到弟弟，所以我躲避妈妈追逐时，躲在角落里写下这些。”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066306] = {81003066306,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003137}},{{"“希望他日后找到这本日记，会明白妈妈和我消失的理由，总有一天我们会在……”"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066307] = {81003066307,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003138}},{{"日记到这里就断掉了，后面全是一些钢笔凌乱的划痕。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066308] = {81003066308,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003139}},{{"原来他是为了救弟弟，才跑出去的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066309] = {81003066309,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100003140}},{{"等一下，也就是说，我们看见占有灵魂核心的恶灵，就是他们母亲？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066310] = {81003066310,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct14,{{10100003141}},{{"恐怕是这样……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066311] = {81003066311,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003142}},{{"好在恶灵还来不及同化灵魂，就被我们碰上了，不然，那孩子真的会失去转世投胎的机会。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066312] = {81003066312,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003143}},{{"刚才日记里写明了转生地点，就在明镜台，离这里不算太远，我们赶紧过去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066601] = {81003066601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003144}},{{"刚才日记里写明了转生地点，就在明镜台，离这里不算太远，我们赶紧过去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065501] = {81003065501,10100003167,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003145}},{{"救命！！谁、谁来救救我！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065502] = {81003065502,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003146}},{{"你们看，有个人快被恶灵吃掉了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066401] = {81003066401,10100003167,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003147}},{{"谢谢大人，若不是你们及时赶到，我恐怕已经……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066402] = {81003066402,10100003167,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003148}},{{"对了！刚才有个小孩往那边那条的巷子去了，喊也喊不住。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066403] = {81003066403,10100003167,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003149}},{{"大人快去那边看看吧，那边恶灵出没频繁，现在不去，恐怕就晚了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066404] = {81003066404,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct12,{{10100003150}},{{"走，我们快去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003066701] = {81003066701,10100003167,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003151}},{{"大人快去那边看看吧，那边恶灵出没频繁，现在不去，那孩子就危险了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065801] = {81003065801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003577}},{{"自不量力的家伙。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065601] = {81003065601,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003152}},{ct75},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065602] = {81003065602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct12,{{10100003153}},{{"在那里！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065901] = {81003065901,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003154}},{{"你这小鬼，怎么跑到这么危险的地方来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065902] = {81003065902,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003155}},{{"哥哥马上要转世了，妈妈也不知去向，我一个人在家里也没什么意思，所以想出来走走。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065903] = {81003065903,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003156}},{{"没想到这里有这么多恶灵……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065904] = {81003065904,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003157}},{{"你哥哥是为了保护你才离开家的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065905] = {81003065905,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003158}},{{"保护我？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065906] = {81003065906,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003159}},{{"曹焱兵将找到的日记残片递给孩子，告诉他发生了什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065907] = {81003065907,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003160}},{{"原来是这样……妈妈她已经……呜呜呜……居然发生了这样的事……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065908] = {81003065908,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003161}},{{"我想，你哥哥没写完的那句话，是想和你在人间重聚。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065909] = {81003065909,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003162}},{{"你可要保重好你自己，别让怨念侵蚀了心灵，只有获得转世资格，才有机会和哥哥重聚呀。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065910] = {81003065910,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003163}},{{"小孩听完这话，从地上站起来，擦干了眼泪。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065911] = {81003065911,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003164}},{{"嗯，你说得对，总有一天，我会和哥哥再次见面的，不能在这里死掉。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065912] = {81003065912,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003165}},{{"你哥哥在明镜台转生，和我们一起去送他一程吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003065913] = {81003065913,10100000056,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003166}},{{"嗯！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84003057401] = {84003057401,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003573}},{{"曹焱兵折返回原来的地方。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055401] = {81003055401,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003038}},{{"你找到吗？没找到也不要紧，我感觉似乎比先前好些了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055402] = {81003055402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003039}},{{"找到了一些米糕，给。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003055403] = {81003055403,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003040}},{{"夏铃吃下米糕，苍白的脸立刻恢复了颜色。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
