	[81003030103] = {81003030103,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001220}},{{"糟了，夏铃呢？可恶，我不该这么冲动的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
