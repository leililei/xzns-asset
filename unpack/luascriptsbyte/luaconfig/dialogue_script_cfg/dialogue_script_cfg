	[81000014821] = {81000014821,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct12,{{10100002013}},{ct94},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014822] = {81000014822,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002014}},{{"你们在说什么呀，我要是寄灵人，怎么不会使用灵力呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014823] = {81000014823,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002015}},{{"这个，我也不太清楚。\n也许你的灵力被什么东西封锁住了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014824] = {81000014824,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002016}},{{"不管怎么说，我不用被消除记忆了是吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014825] = {81000014825,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002017}},{{"没错。总之，我们先继续巡逻吧，等回到山顶，再想想激发出你灵力的方法。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014801] = {82000014801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100002018}},{ct98},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014802] = {82000014802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct13,{{10100002019}},{{"学得很快嘛。这衣服是因为你使用灵力而幻化出来的灵衣，它对寄灵人来说非常重要。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014803] = {82000014803,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002020}},{{"不过你需要释放更多灵力，才能降之熟练运用。\n走吧，这条路低级恶灵还有很多，正好让你练练手。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015001] = {81000015001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002021}},{{"高等恶灵受了重伤，钻进一扇传送门逃跑了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015002] = {81000015002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_16-001"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct14,{{10100002022}},{{"可恶，还是让他逃走了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015003] = {81000015003,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_17-002"},ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100002023}},{{"附近的恶灵越来越多了，稳妥起见，我看还是快点送你回去比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015004] = {81000015004,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_18-001"},ct1,0,0,2,0,{ct8},ct2,ct1,ct1,ct12,{{10100002024}},{{"上车，笨女人！我们从左边的近路抄过去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015005] = {81000015005,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct49,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100002025}},{{"哦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015006] = {81000015006,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct8},ct2,ct1,ct1,ct6,{{10100002026}},{{"总之，我们先在此处就地休息一会儿吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015007] = {81000015007,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002027}},{{"哔哔哔……\n刘羽禅的言灵盒亮了起来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015008] = {81000015008,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002028}},{{"灵域的言灵信？看来我的新指令来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015009] = {81000015009,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002029}},{{"没能和你像上次一样较量一番，真是可惜，不过，我必须先走一步了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015010] = {81000015010,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002030}},{{"当然，如果有事的话，随时可以用言灵信找到我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015101] = {81000015101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_08-001"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100002142}},{{"鬼符三通？你来做什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015102] = {81000015102,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/guifusantong_story_04"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct18,{{10100002143}},{{"前几日你救下的寄灵人夏铃正在被王国组织追杀，我帮她挡下了敌人，让她来罗刹街找你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015103] = {81000015103,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/guifusantong_story_05-001"},ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100002144}},{{"她还没有来吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015104] = {81000015104,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_19-001"},ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100002145}},{{"什么？那个笨女人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015105] = {81000015105,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/guifusantong_story_06-001"},ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct15,{{10100002146}},{{"看来你们并没有碰面。\n曹当家的，快去罗刹街找找她吧，情况紧急，说不定现在已经遇到危险了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015106] = {81000015106,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_20-001"},ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct9,{{10100002147}},{{"真会给人添麻烦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015107] = {81000015107,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002148}},{{"曹焱兵指了指夏铃。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015108] = {81000015108,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct15,{{10100002149}},{{"哦？这倒是件新鲜事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015109] = {81000015109,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct10,{{10100002150}},{{"这个，我可以慢慢说给你听，不过我觉得现在还是先解决你身后的恶灵比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015110] = {81000015110,10100000011,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct16,ct1,ct1,{{10100002151}},{ct32},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015111] = {81000015111,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100002152}},{{"不知什么时候，鬼符三通身后围过来几只被灵力吸引来的恶灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015112] = {81000015112,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{{10100002153}},{{"呵呵，罗刹街果然还是老样子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015201] = {81000015201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100002154}},{{"战斗之路越来越艰险了呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015202] = {81000015202,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002155}},{{"不如试试与守护灵配合，使用合击技，会达成出其不意的效果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015203] = {81000015203,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002156}},{{"大家打开门锁，救出被困的亡灵们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015204] = {81000015204,10100002854,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002824}},{{"谢谢大人的救命之恩。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015205] = {81000015205,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct6,{{10100002825}},{{"谁把你们关起来的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015206] = {81000015206,10100002854,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002826}},{{"大人，昨天我们这突然来了一个机械人，带着一众手下占领了这里。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015207] = {81000015207,10100002854,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002827}},{{"他们一来就将我们锁在此处。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015208] = {81000015208,10100002854,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002828}},{{"这里地处偏远，我们又被堵了嘴巴，真是叫天天不灵，若不是大人路过，我们只有等死了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015209] = {81000015209,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002829}},{{"真是吃了熊心豹子胆，敢在我罗刹街作威作福。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015210] = {81000015210,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct9,{{10100002830}},{{"送笨女人回家的事先放在一边，我今日非要把那家伙揪出来不可！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015211] = {81000015211,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct6,{{10100002831}},{{"他们现在在哪？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015212] = {81000015212,10100002854,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002832}},{{"那些机械人一般在巷子西边活动。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015213] = {81000015213,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct12,{{10100002833}},{{"走，去会会他们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015301] = {81000015301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100002157}},{{"虽然罗刹街一向是镇魂街中最为凶险的一条，但最近恶灵的数量实在多得有些异常啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015302] = {81000015302,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct18,{{10100002158}},{{"这正是我来找你的原因，根据我的调查，有一股叫“王国”的外部势力正向镇魂街渗透。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015303] = {81000015303,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct15,{{10100002159}},{{"如今灵域衰微，各方势力都蠢蠢欲动，若镇魂将不集结起来，很难与他们抗衡。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015304] = {81000015304,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100002160}},{{"怎么样？要不要加入我，一起对抗王国势力？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015305] = {81000015305,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002161}},{{"抱歉，对这些争权夺利的事情，我没兴趣。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015306] = {81000015306,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100002162}},{{"我就知道你会这样说，不过事关重大，你考虑考虑吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015307] = {81000015307,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct18,{{10100002163}},{{"若你改变了主意，可以随时发言灵信给我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000015308] = {81000015308,0,"","",{ct2},ct1,ct1,0,2,0,0,{{1,2}},ct2,ct1,ct1,ct1,{{10100002164}},{{"鬼符三通消失了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
