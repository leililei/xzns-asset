	[81000023203] = {81000023203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct6,{{10100003424}},{{"不论怎么说，总算是逃出来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023204] = {81000023204,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100003425}},{{"想逃出我的掌心，没那么容易！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023205] = {81000023205,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct7,{{10100003426}},{{"是南御夫！他追上来了！怎么办？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023206] = {81000023206,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003427}},{{"南御夫从天而降，后面站着他的三个得力部下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023207] = {81000023207,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003428}},{{"一时间气氛凝聚至冰点，曹焱兵握紧十殿阎罗，凝神屏气，准备迎接对方的攻击。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
