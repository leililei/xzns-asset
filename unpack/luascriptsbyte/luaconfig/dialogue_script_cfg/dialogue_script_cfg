	[81000010935] = {81000010935,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000155}},{{"有第三种方法吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010936] = {81000010936,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000156}},{{"没有。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"1","2","StoryEffect_item_ylx","1","0","75"}},
	[81000010937] = {81000010937,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000157}},{{"我还是选第一种吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"0","2","StoryEffect_item_ylx","1","0","75"}},
	[81000010938] = {81000010938,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100000158}},{{"好，那你按我说的做，集中精力，试着召唤出内心真正的力量。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
