	[81002034811] = {81002034811,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003860}},{{"吕仙宫离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
