	[81001073001] = {81001073001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000707}},{{"这是……毒液？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071101] = {81001071101,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000708}},{{"主公小心，谨防地上的毒液。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071102] = {81001071102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000709}},{{"毒液……颜色倒与魂兵身上残留的毒液吻合。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071103] = {81001071103,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000710}},{{"罗刹街出现这么多蜘蛛和恐狼，也太奇怪了。谁把这些东西带来的……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071201] = {81001071201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000711}},{{"有人？这是什么怪物……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071201] = {82001071201,10100000046,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000712}},{{"这位是……？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071202] = {82001071202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000713}},{{"我是罗刹街镇魂将曹焱兵是也，敢问阁下是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071203] = {82001071203,10100000046,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000714}},{{"啊，原来是曹当家！\n我是墨鳞街镇魂将苏靖齐。惊扰了你们，实在抱歉。现在我正等我兄弟来一起羁押他们回墨鳞街，曹当家不会阻拦吧？"}},{ct3,ct3,ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071204] = {82001071204,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000715}},{{"哪里，既是墨鳞街的凶兽，你们羁押回去便是。只是被封印在地牢，如何逃出的？还有，你说它不能自已是怎么回事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071205] = {82001071205,10100000046,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000716}},{{"目前看来，恐怕是有人故意释放了巨兽，并从远程操控。这些山巨人面目痛苦不堪，不像是自己意愿所为。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071206] = {82001071206,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000717}},{{"唔，之前遇见的恐狼也有类似的特征。"}},{ct3},ct2,false,{{90000000040},{90000000041}},ct1,{ct27,ct27},{{"820010713"},{"820010714"}},ct1},
	[82001071301] = {82001071301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000718}},{{"没错，可是究竟是谁做的呢？\n哥哥，不如去信询问刘羽禅，他或许知道什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071302] = {82001071302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000719}},{ct184},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071303] = {82001071303,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000720}},{ct35},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071401] = {82001071401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000721}},{{"我倒觉得这些事件有相似之处，不如我们去信询问刘羽禅吧，他或许知道什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071402] = {82001071402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000722}},{ct184},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001071403] = {82001071403,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000723}},{ct35},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071301] = {81001071301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000724}},{{"地上好像有些痕迹，像是有东西在这里拖动的样子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071401] = {81001071401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000725}},{{"你们看，这里有些破碎的脚印，或许有人负伤路过，拖着受伤的身体留下了足迹。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001073501] = {81001073501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000726}},{ct185},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071501] = {81001071501,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000727}},{{"这十几米都能看见脚印拖行的痕迹，但到了这里，足迹却凭空消失了，这是怎么回事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071502] = {81001071502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000728}},{{"有人刻意隐瞒行踪。我们继续往前，看能发现些什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001073601] = {81001073601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000729}},{ct185},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001073101] = {81001073101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000730}},{{"这里也有，足迹中途断掉了。不过我们可以跟着行走趋势往前看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001073701] = {81001073701,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000731}},{{"总觉得怪怪的。这些足迹像故意被抹去似的……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071601] = {81001071601,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000732}},{{"鬼符三通怎么还没到，早就过了约定的时间了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071701] = {81001071701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000733}},{{"或许被什么事绊住了。不用等他，我们先走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071801] = {81001071801,10100000063,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000734}},{{"曹大人……请你救救将军大人……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071802] = {81001071802,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000735}},{{"他胸前的标记，应该是尸蟒将军的部下吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071803] = {81001071803,10100000063,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000736}},{{"是的，我拼命逃到这里，就是听说你在附近……将军大人就在前面，请你……救救他……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071804] = {81001071804,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000737}},{{"他受伤好严重，看来尸蟒将军这回遇到劲敌了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071901] = {81001071901,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000738}},{{"别管我！你们快跑！我的身体已经被控制了！这样下去你们都会完蛋的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071902] = {81001071902,10100000019,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100000739}},{{"将军大人！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001071903] = {81001071903,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000740}},{{"主公当心！那家伙的行动似乎失控了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072001] = {81001072001,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000741}},{{"曹当家，没想到会再见到你，多谢你，我才能摆脱那人的控制，咳咳……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072002] = {81001072002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000742}},{{"谁在操控你做这种事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072003] = {81001072003,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000743}},{{"有个叫黑尔坎普的，想招揽我做他的部下，可天下怎能交给这样的家伙。我回绝了他。没想到，他立刻发动灵力，令我行动全为他所控制，打伤了不少我招来的弟兄……要是下次再见到他，我一定……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072001] = {83001072001,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000744}},{{"他们的灵气全然消失了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072002] = {83001072002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000745}},{{"想不到这家伙也是个有仁心的，我们就在此地给他立个碑吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072003] = {83001072003,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000746}},{{"曹焱兵埋葬了尸蟒将军和众魂兵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072004] = {83001072004,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000747}},{{"主公，这边的树丛掩盖着路面，里面有条暗道，怕不是有埋伏，我们从这里绕过去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072005] = {83001072005,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000748}},{{"走。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072101] = {81001072101,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000749}},{{"这么多宝藏……恐怕都是尸蟒将军为了征兵收集的财宝。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072201] = {81001072201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000750}},{{"有不少好东西呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072202] = {81001072202,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000751}},{ct180},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072203] = {81001072203,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100000752}},{{"刘羽禅回信了。"}},{ct3},ct2,false,{{90000000042}},ct1,{ct27},{{"810010723"}},ct1},
	[81001072301] = {81001072301,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000753,10100001542,10100001543}},{{"焱兵：","\t你说的秘术我略有耳闻，那是一种以灵力施加的咒术。若真是王国的人所为，那十之八九是一个叫黑尔坎普的人，王国里只有他会操纵之术。","刘羽禅"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072401] = {81001072401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000754}},{{"王国的黑尔坎普么……记得先前奇怪的机械人也有被灵力操控的迹象。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072402] = {81001072402,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000755}},{{"鬼符三通猜错了，他以为有两帮人在罗刹街，实际上只有一个，那就是黑尔坎普。\n他在罗刹街制造混乱，应该是为了声东击西，避人耳目。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072403] = {81001072403,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000756}},{{"这个黑尔坎普或许并非厉害的角色。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072404] = {81001072404,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000757}},{{"为什么这样说？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072405] = {81001072405,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000758}},{{"弱者喜欢隐藏自己，让别人当挡箭牌。\n他四处混淆视听，想必对自己实力有所顾虑，才这样谨慎行事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072406] = {81001072406,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000759}},{{"哈哈哈哈！说我谨慎行事？可笑可笑！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072407] = {81001072407,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000760}},{{"声音从那边传来的！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072501] = {81001072501,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000761}},{{"曹当家的，终于见面了。呵呵，没想到你能来到这里，有点实力，不过也到此为止了。我是第一个到罗刹街的人，神树之中的羲和神珠已是我囊中之物了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072502] = {81001072502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000762}},{{"羲和神珠？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001072501] = {82001072501,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000763}},{{"小的们，给我上，别让这些杂碎影响我的大事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072601] = {81001072601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000764}},{{"可恶，溜得比泥鳅还快。我们快跟上！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072701] = {81001072701,10100000019,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000765}},{{"曹大人，听说你救了尸蟒将军大人，多谢你了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072702] = {81001072702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000766}},{{"黑尔坎普往哪去了，你有看见吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072703] = {81001072703,10100000019,"","",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000767}},{{"他往东边去了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072801] = {81001072801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000768}},{{"站住，别想逃！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072802] = {81001072802,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000769}},{{"真碍事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001072901] = {81001072901,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000770}},{{"可恶，这家伙有两把刷子。这样下去别说拿到羲和神珠去和老大邀功，连小命都保不住……我得走一步，待我融合后再来找他算账。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001072901] = {82001072901,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000771}},{{"我得走一步，等等再来找他算账。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072901] = {83001072901,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000772}},{{"黑尔坎普嘴里念念有词，通过传送门消失了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072902] = {83001072902,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000773}},{{"又让那家伙溜了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072903] = {83001072903,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000774}},{{"可是他的气息还留在罗刹街，他一定还在不远的地方。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072904] = {83001072904,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000775}},{{"对了，他刚才说要拿神珠什么的，罗刹街的神珠你藏在哪里的，曹焱兵？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072905] = {83001072905,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000776}},{{"我从来不知道罗刹街还有什么神珠啊，或许有什么秘密，连我也不知道……但我绝不允许他破坏灵槐神树。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001072906] = {83001072906,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000777}},{{"神珠的事情暂且不论，刚才他离开时，嘴里念念有词，我没记错的话，那是他与守护灵融合的咒语，若是他融合成功就麻烦了。我觉得我们还是尽快把他找出来比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001080301] = {81001080301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100000778}},{{"有人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001080501] = {81001080501,10100000017,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000779}},{{"终于见面了，曹焱兵，看来不得不与你一战了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084101] = {82001084101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100001677}},{{"别在罗刹街作恶了，束手就擒吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084102] = {82001084102,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct9,{{10100001678}},{{"可恶……那丫头的守护灵竟然这样强。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084103] = {82001084103,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct55,{{10100001679}},{{"不过，寄灵人消失的话，守护灵也会没有容身之地了吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084104] = {82001084104,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001680}},{{"一瞬间，黑尔坎普向夏铃攻去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084105] = {82001084105,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct7,{{10100001681}},{{"糟了！他想攻击夏铃姐姐！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001084106] = {82001084106,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct24,{{10100001682}},{{"别想得逞！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001084101] = {83001084101,10100000008,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{ct161},{{"灵槐是父母留下的东西，我就是走遍天涯海角也要找到这三样东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001084102] = {83001084102,10100000007,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{ct162},{{"没错，能复苏灵槐，离开这里又何妨！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001084103] = {83001084103,10100000053,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001548}},{{"灵槐被毁有我的责任，我才不会当缩头乌龟呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001084104] = {83001084104,10100000008,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct13,{{10100001527}},{{"既然已经决定离开，我们就准备出发吧！鬼符三通，后会有期！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001084301] = {85001084301,10100000007,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001693}},{{"糟了，灵槐树被击中了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81301084301] = {81301084301,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001694}},{{"看来是我来晚了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81601084301] = {81601084301,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001695}},{{"（灵槐树……鬼符三通？可恶，那个神秘的寄灵人，他这时候来做什么？）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82201084301] = {82201084301,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001696}},{{"灵槐树已经被破坏到这种程度，曹当家的恐怕难辞其咎。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82201084302] = {82201084302,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001697}},{{"不过，根部还未损坏——别担心，就交给我吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82501084301] = {82501084301,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001698}},{{"鬼符三通使用四方真如封印术封印了被毁坏的神树，阻止了神树灵力的流失。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82701084301] = {82701084301,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001699}},{{"可恶，都是我的错，是我回来晚了，才让这样的事情发生。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83201084301] = {83201084301,10100000031,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001700}},{{"这件事，也有我的责任……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83501084301] = {83501084301,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001701}},{{"别急，灵槐乃千年神树，并非没有恢复的可能。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83501084302] = {83501084302,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001702}},{{"据我所知，冥界除却灵槐，还有另外三棵神树，只要集齐另外三棵的果实，便可复苏灵槐。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83801084301] = {83801084301,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001703}},{{"另外三颗吗？我记得应该是龙桃树、扶桑树和帝榆树吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84301084301] = {84301084301,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001704}},{{"没错，这三样东西散布在冥界各处。\n要想找齐它们，你们必须离开罗刹街，前往镇魂街其他区域。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84301084302] = {84301084302,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001705}},{{"不过这样一来，前路可就生死未卜了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84301084303] = {84301084303,10100000015,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001706}},{{"你们，有这样的勇气吗？还是说，想找一条逃亡的路逃避冥域的追捕？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84401084301] = {84401084301,10100000008,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001707}},{{"不，灵槐是父母留下的东西，我就是走遍天涯海角也要找到这三样东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84401084302] = {84401084302,10100000007,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001708}},{{"没错，能复苏灵槐，离开这里又何妨！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84401084303] = {84401084303,10100000031,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001709}},{{"灵槐被毁有我的责任，我才不会当缩头乌龟呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84401084304] = {84401084304,10100000015,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001710}},{{"那么祝你好运了，曹当家。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84401084305] = {84401084305,10100000015,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001711}},{{"（呵，虽然跟计划有些偏差，不过，还在可控制范围内。\n接下来会怎么样呢？让我拭目以待吧。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001084201] = {81001084201,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{ct176},{{"曹当家的，有个罗刹街的幽灵托我带一封信给你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001084202] = {81001084202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct8},ct2,ct1,ct1,ct6,{ct177},{{"哦？谁寄来的言灵信？"}},{ct3},ct2,false,{{90000000110}},ct1,{ct27},{{"810010504"}},ct1},
	[82001080601] = {82001080601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000780}},{{"你是谁？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001080701] = {82001080701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct7,{{10100000781}},{{"是他！先前搞乱罗刹街的人！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001080801] = {82001080801,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000782},{10100001533}},{{"我是王国直属执行官，第九骑士，黑尔坎普。"},{"为了能来这里，我一连闯过五条罗刹街。你们镇魂将真是徒有虚名，我一口气就将他们全解决掉了。而下一个就是你，曹焱兵。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001080901] = {82001080901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct11,{{10100000783}},{{"*心理* 好可怕的家伙……他费这么多功夫硬闯罗刹街，难道他想从这里得到什么吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001081001] = {82001081001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct8},ct2,ct1,ct1,ct12,{{10100000784}},{{"不管你目的是什么，我决不允许任何人破坏罗刹街。不离开罗刹街，就别怪我不客气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001081101] = {81001081101,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000785}},{{"哼，虚张声势！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001081301] = {81001081301,10100000017,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000786}},{{"就这点能耐，也想和我同台较量？看招！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
