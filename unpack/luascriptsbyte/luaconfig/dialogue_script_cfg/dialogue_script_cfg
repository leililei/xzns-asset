	[81002032403] = {81002032403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct9,{{10100003728}},{{"罗刹街曹焱兵都不认得？今天就让你们认识认识。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032501] = {81002032501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003729}},{{"里面就是他们驻扎的地方了吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032502] = {81002032502,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003730}},{{"我能感应到我的另一半魂魄，一定就在里面。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032503] = {81002032503,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct12,{{10100003731}},{{"走，我们闯进去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032601] = {81002032601,10100000011,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003732}},{{"咦，怎么有人闯进来了？门口的守卫呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032602] = {81002032602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct13,{{10100003733}},{{"已经被我解决掉了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032603] = {81002032603,10100000011,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100003734}},{{"唔……！什么！来人，把他们统统抓起来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032701] = {81002032701,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003735}},{{"这里堆放了不少物资，但却看见你说的装魂魄的袋子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032702] = {81002032702,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003736}},{{"唔，我也感应不到我的另一半魂魄。\n不过，总觉得很近了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032703] = {81002032703,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003737}},{{"幽灵对自己的魂魄感应很灵敏，她的感觉应该不会有错。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032704] = {81002032704,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003738}},{{"我们去前面搜寻一番吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032801] = {81002032801,10100000066,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003739}},{{"那是……我的魂魄！可恶，竟然就这样随随便便扔在地上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032802] = {81002032802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct6,{{10100003740}},{{"我去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032803] = {81002032803,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003741}},{{"曹焱兵拾起碎片。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032804] = {81002032804,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003742}},{{"的确是另一块碎片，给。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032805] = {81002032805,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003743}},{{"曹焱兵将遗落的魂魄拾起，还给幽灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032806] = {81002032806,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct13,{{10100003744}},{{"虽然已是幽灵，但魂魄若是不完整，只能算是孤魂野鬼了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032807] = {81002032807,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003745}},{{"幽灵两部分魂魄合二为一，终于现出本体。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002032801] = {83002032801,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003746}},{{"太好了，这下我又能自由行动了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002032802] = {83002032802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct6,{{10100003747}},{{"没记错的话你家在明槐街是吧？附近恶灵出没频繁，我们先送你回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002032803] = {83002032803,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003748}},{{"啊！是谁杀死了我的部下？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002032804] = {83002032804,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003749}},{{"听见了吗？有人声从入口传过来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002032805] = {83002032805,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct12,{{10100003750}},{{"是恶灵残党？走，出去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002032901] = {81002032901,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003751}},{{"希望能顺利从这里出去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033001] = {81002033001,10100003176,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100003752}},{{"啊啊啊啊！我的地盘就这样被你毁了，我要让你付出代价！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033002] = {81002033002,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003753}},{{"当心，这家伙散发出好强的灵力，恐怕没那么容易对付。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033101] = {81002033101,10100003176,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100003754}},{{"啊啊啊——好痛苦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033102] = {81002033102,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003755}},{{"恶灵高呼一声，在曹焱兵的烈火中化为灰烬。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033103] = {81002033103,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003756}},{{"一旦被怨念缠身，就会变成这样吗？真可怕。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033104] = {81002033104,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct13,{{10100003757}},{{"只要呆在安全的地方，恶灵化的概率也会大大减小。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033105] = {81002033105,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003758}},{{"走吧，我们带你回村子，别在这怨念之地停留了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002033201] = {82002033201,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003771}},{{"李轩辕，你的伤还好吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002033202] = {82002033202,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct21,{{10100003772}},{{"主人放心，我的伤势只需要再静养几天便可以恢复了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002033203] = {82002033203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003773}},{{"曹焱兵让我们一起去悬龙街找孙斩天借治疗百病的上古神器，他倒是跑得快，一溜烟就不见了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002033204] = {82002033204,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003774}},{{"咦，他在那里——曹焱兵！你这家伙，终于追上你了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033301] = {81002033301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003775}},{{"这里怎么回事……好像经过了一场乱战。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033302] = {81002033302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003776}},{{"刚才我觉得这里有点不对，所以提前来看看，没想到就看到这副情景。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033303] = {81002033303,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003777}},{{"并且，我找到这东西。你看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033304] = {81002033304,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003778}},{{"曹焱兵将一页残章递给夏铃。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033305] = {81002033305,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003779}},{{"上面印了灵域的印章，是灵域的密件！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033306] = {81002033306,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003780}},{{"不错，这应该是御灵使发出来的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033307] = {81002033307,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct14,{{10100003781}},{{"密件被撕毁，信息不完整，不过，看这只言片语，仿佛在说镇魂将死后不可以进入灵域。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033308] = {81002033308,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003782}},{{"我记得你和我说过，镇魂将为冥界驱除恶灵，死后就有资格进入灵域。为什么突然禁止了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033309] = {81002033309,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct10,{{10100003783}},{{"不知道，看得我也是摸不着头脑。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033310] = {81002033310,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003784}},{{"我打算去夕照岗找鬼符三通，他也许知道些什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033311] = {81002033311,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003785}},{{"那，我和李轩辕先去找孙斩天那里借灵器了。到时候就在这附近集合吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033312] = {81002033312,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct8},ct2,ct1,ct1,ct1,{{10100003786}},{{"好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033313] = {81002033313,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003787}},{{"另一方面，群英殿的吕仙宫感知到了密件被毁。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033314] = {81002033314,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003788}},{{"咒印被人破坏了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033315] = {81002033315,15903000013,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100003789}},{ct118},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033316] = {81002033316,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003790}},{{"刚才御灵使来带走的密件，是由我加封的咒印。一旦密件被御灵使以外的人打开，我就能知道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033317] = {81002033317,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003791}},{{"我感觉到咒印被人破坏，一定是有人看到了他不该看到的东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033318] = {81002033318,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003792}},{{"若是灵域追查下来，我们恐怕脱不了干系……真麻烦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033319] = {81002033319,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003793}},{{"李孤城，今日貂灵芸和项昆仑不在殿内，你派些人去御灵使的路线查探发生了什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033320] = {81002033320,15903000013,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003794}},{ct52},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033401] = {81002033401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003795}},{{"我打算去夕照岗找鬼符三通，他也许知道些什么。到时候在这附近集合吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033701] = {81002033701,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003796}},{{"夏铃来到悬龙街，正想进门，却听见门内有喧哗，于是站在一旁细听。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033702] = {81002033702,11120000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003797}},{{"所以，你们要我做什么？我对你们群英殿的事情可不感兴趣。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033703] = {81002033703,10100003877,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003798}},{{"事关灵域，我们查到贼子曾途径您的辖区，还请悬龙街镇魂将跟我们走一趟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033704] = {81002033704,10100003877,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003799}},{{"不止是你，最近不少镇魂将都会接受询问，放心，只是问几句话。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033705] = {81002033705,11120000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct8},ct2,ct1,ct1,ct1,{{10100003800}},{{"真是的，最近来来去去被你们询问过三回了，没完没了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033706] = {81002033706,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003801}},{{"孙斩天跟随群英殿的人离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033707] = {81002033707,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003802}},{{"这是怎么回事？孙斩天被带走了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033708] = {81002033708,11206000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100003803}},{{"你们怎么来了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033709] = {81002033709,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct11,{{10100003804}},{{"朱童，斩天怎么被带走了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033710] = {81002033710,11206000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003805}},{{"灵域最近不知怎么的，经常传唤镇魂将，搞得人心惶惶的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033711] = {81002033711,11206000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003806}},{{"今天稀奇，来的是群英殿的人，似乎弄丢了什么灵域机密的东西，正到处找呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033712] = {81002033712,11206000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003807}},{{"你们要多加小心，这个给你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033713] = {81002033713,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003808}},{{"朱童递给夏铃一个小瓶子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033714] = {81002033714,11206000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003809}},{{"我也要走了。这是我最近炼成的迷药，世道越来越乱，带在身上防身吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033715] = {81002033715,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003810}},{{"朱童离开了悬龙街。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033716] = {81002033716,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003811}},{{"看来，曹焱兵捡到了不得了的东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033717] = {81002033717,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct11,{{10100003812}},{{"要是他被群英殿的人发现身上有密件的残页就麻烦了，说不定会被当成袭击御灵使的人……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002033718] = {81002033718,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003813}},{{"没错，我们得快点回去告诉曹焱兵这件事，那东西还是早早销毁掉的好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034001] = {81002034001,10100003878,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003814}},{{"唔，这里到处都是尸体，看来御灵使的密件就是在这里失窃的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034002] = {81002034002,10100003879,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003815}},{{"也许是御灵使部下和恶灵战斗时，被人趁乱偷走的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034003] = {81002034003,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003816}},{{"李轩辕，你看！有人在查看那些尸体。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034004] = {81002034004,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct24,{{10100003817}},{{"虽然没有穿制服，但听他们的对话，或许就是群英殿派来的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034005] = {81002034005,10100003878,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003818}},{ct119},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034006] = {81002034006,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003819}},{{"糟糕，我们被发现了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034201] = {81002034201,10100003879,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003820}},{{"唔，别以为就这样结束了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034201] = {83002034201,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003821}},{{"探子口中念念有词，周围瞬间出现大量分身。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034202] = {83002034202,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct11,{{10100003822}},{{"这么多分身……李轩辕，我们有胜算吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034203] = {83002034203,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct24,{{10100003823}},{{"主人，我的伤势恐怕难以抵挡这些群英殿精锐，还是快离开这里吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034204] = {83002034204,10100003879,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003824}},{{"休想逃跑！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034205] = {83002034205,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003825}},{{"一时间群英殿的精锐将夏铃二人团团包围。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034206] = {83002034206,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct7,{{10100003826}},{{"糟了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002034207] = {83002034207,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003827}},{{"休想在此作乱！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034201] = {85002034201,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003828}},{{"这时一个身影从天而降，挡在夏铃和李轩辕之前。他召出守护灵迅速击退了群英殿的包围。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034202] = {85002034202,10100003879,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003829}},{{"可恶，是个高手。\n我的任务是查探情报，不是拼命，先撤了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034203] = {85002034203,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003830}},{{"群英殿探子撤退。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034204] = {85002034204,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003831}},{{"姑娘，你们没事吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034205] = {85002034205,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003832}},{{"没事，多谢你出手相助！请问你是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034206] = {85002034206,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003833}},{{"不客气！我是附近的烽火街的镇魂将云石，虽然这里不是我的管辖之地，但我见不惯倚强凌弱的恶霸。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034207] = {85002034207,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003834}},{{"灵域派镇魂将管理自己的街道，管其他地方不仅有性命危险，还容易会多生是非，阁下愿意出手相助，侠义心肠可见一斑。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034208] = {85002034208,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003835}},{{"嗨，这算什么。灵域为了冥域众灵才任命镇魂将驱逐恶灵，不论是不是自己的地盘，我们也应守护众灵才是。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034209] = {85002034209,10100003881,"","",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100003836}},{{"云叔叔！云叔叔！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034210] = {85002034210,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003837}},{{"一群小幽灵突然从草丛中跑出来，将云石抱住。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034211] = {85002034211,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003838}},{{"哎，别急，我这就送你们回去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034212] = {85002034212,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct8},ct2,ct1,ct1,ct1,{{10100003839}},{{"我还要护送这些小家伙回村，先告辞啦！你们二位自己多保重。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034213] = {85002034213,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003840}},{{"云石带着孩子们离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034214] = {85002034214,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100003841}},{{"他看上去对灵域非常崇敬，应该是个胸怀理想，心地纯良的人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034215] = {85002034215,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100003842}},{{"嗯，我妈妈也说过，小孩子喜欢的人一定不是坏人，可惜，灵域或许并没有他想得那么好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034216] = {85002034216,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003843}},{{"密件牵涉的事很危险，我们还是别在其他人面前提起比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034217] = {85002034217,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003844}},{{"我知道，所以才什么也没说。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034218] = {85002034218,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003845}},{{"总之得先离开这里吧，要是再被人看见就危险了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85002034219] = {85002034219,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003846}},{{"嗯，曹焱兵既然还没来，也许还在夕照岗，我们去那儿找他吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034301] = {81002034301,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct24,{{10100003847}},{{"看来鬼符三通为了隐藏踪迹，施法用植物将路隐藏住了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034302] = {81002034302,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct9,{{10100003848}},{{"所以我讨厌去夕照岗，这里的路跟迷宫似的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034303] = {81002034303,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003849}},{{"总之，先从这些草丛里找找出口吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034801] = {81002034801,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct9,{{10100003850}},{{"等等，主人，别再前进了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034802] = {81002034802,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003851}},{{"山崖上一个人躺在血泊里。一旁站着的，正是群英殿的吕仙宫。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034803] = {81002034803,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003852}},{{"云石，你知道太多了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034804] = {81002034804,10100003876,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003853}},{{"你……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002034805] = {81002034805,11405000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100003854}},{{"知道也就罢了，这是灵域的事情，我本来懒得管。不过，你想要妨害群英殿，就不怪我不客气的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
