	[81000019008] = {81000019008,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct24,{{10100002467}},{{"虽然很感谢你救了两个孩子，但我只能睁一只眼闭一只眼，当你们没来过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
