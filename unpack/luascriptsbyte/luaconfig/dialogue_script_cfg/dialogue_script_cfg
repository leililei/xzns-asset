	[81000017304] = {81000017304,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct15,{{10100002359}},{ct155},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017305] = {81000017305,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002360}},{{"我们在那些蜘蛛的腹部和腿上发现了数字编号，或许这些蜘蛛是人为繁衍的结果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017306] = {81000017306,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct18,{{10100002361}},{{"我收到情报，附近有王国成员活动的迹象，我想或许跟他们有关。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
