	[81000014704] = {81000014704,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/caoyanbing/story_caoyanbing4_sikao"},ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100001992}},{{"他是我的守护灵，三国时期曹操的虎卫军统领，许褚，拥有一夫当关万夫莫敌之勇。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014705] = {81000014705,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct10,{{10100003178}},{{"可能因为我是曹操的后人的缘故，现在他成了我的守护灵，是我的得力助手。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014706] = {81000014706,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct8},ct2,ct1,ct1,ct38,{{10100003179}},{{"主公过奖！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014707] = {81000014707,10100003177,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003180}},{{"需要……吸食……灵力……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014708] = {81000014708,0,"","",{ct2},ct100,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003181}},{{"两人谈话间，四周的恶灵已经聚过来，一个接着一个朝曹焱兵的摩托车进攻。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014709] = {81000014709,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/caoyanbing_wonaizhenhunjiang"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100003182}},{{"我乃罗刹街镇魂将曹焱兵！想活命的统统给我闪开！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014801] = {81000014801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_15-002"},ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001993}},{ct138},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014802] = {81000014802,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/zhuchengdianji_guifusantong3_02"},ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct18,{{10100001994}},{{"哎呀呀，曹当家的，别来无恙啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014803] = {81000014803,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001995}},{{"人死后，灵魂会来到镇魂街。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014804] = {81000014804,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100001996}},{{"但是，若一个人生前怀有积怨，他的魂魄便会失去理智，变成只知道掠夺的贪婪怪物，也就是恶灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014805] = {81000014805,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100001997}},{{"镇魂将的任务，就是镇压这些恶灵，维护冥界的安定。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014806] = {81000014806,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct10,{{10100001998}},{{"所以知道你闯进来的是什么地方了吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014807] = {81000014807,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct11,{{10100001999}},{{"不是不能理解，不过这一切对我来说好像做梦一样……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014808] = {81000014808,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100002000}},{{"不论你有没有听懂，都没关系。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014809] = {81000014809,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct13,{{10100002001}},{{"反正你在离开冥域前，我会用特殊能力消除你脑中关于镇魂街的记忆，这是灵域的命令。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014810] = {81000014810,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct10,{{10100002002}},{{"不过消除记忆等同于进行一场脑部外科手术，能不能成功就另当别论了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014811] = {81000014811,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100002003}},{{"喂……你、你可别吓我啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
