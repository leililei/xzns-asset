	[82003020603] = {82003020603,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001211}},{{"不出几秒钟，狼蛛的手臂在飕飕的风声中纷纷落下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
