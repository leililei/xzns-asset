	[82003020601] = {82003020601,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001209}},{{"忽然间，一个黑影闪过上空。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
