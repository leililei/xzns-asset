	[81000017211] = {81000017211,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100002342}},{{"可是十殿阎罗若真有焱兵说得那么厉害，落到敌人手中可就糟糕了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017212] = {81000017212,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct11,{{10100002343}},{{"到那时，恐怕我们都只有束手就擒。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
