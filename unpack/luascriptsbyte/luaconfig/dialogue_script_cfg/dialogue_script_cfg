	[81000017609] = {81000017609,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100002392}},{{"不过刚才的山蜘蛛和王国刺客数量众多，想必已经耗费了你们大量精力，现在的你们，还能战胜得了我吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
