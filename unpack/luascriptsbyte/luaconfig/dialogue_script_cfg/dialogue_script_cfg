	[81000023805] = {81000023805,10100000070,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100003482}},{ct108},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
