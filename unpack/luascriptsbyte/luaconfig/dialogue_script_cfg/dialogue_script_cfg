	[81000017308] = {81000017308,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002363}},{{"哔哔哔……\n鬼符三通的言灵信响了起来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
