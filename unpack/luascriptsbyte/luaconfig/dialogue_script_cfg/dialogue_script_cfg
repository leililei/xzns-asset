	[81003025809] = {81003025809,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002658}},{{"乌鸦展开翅膀在天空盘旋，接着俯冲撞向旁边的聚灵石像。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
