	[81001070803] = {81001070803,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000702}},{{"的确，连骨头也破碎断裂，像是被巨物碾压过去的样子，真惨烈呀。既然是两方势力争斗，想必现在他们已各奔东西。曹当家，我们分头调查，你在附近调查，我往北边稍远的地方走走。一刻钟后见。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001073401] = {81001073401,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000703}},{{"看来有不少兵卒从这里路过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
