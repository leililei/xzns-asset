	[81003040901] = {81003040901,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001256}},{{"有两下子。这么强的灵体经过改造会是什么样子呢？越来越期待了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040902] = {81003040902,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001257}},{{"天边忽然窜出一束燃烧的火花，那是曹焱兵交给夏铃的信号弹，是集合的信号。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040903] = {81003040903,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001258}},{{"那个笨女人发出的集合信号，恐怕她有危险了。我们没时间跟他纠缠了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040904] = {81003040904,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001259}},{{"想走？没那么容易。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040905] = {81003040905,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001260}},{{"呵呵，空神之森的守护者，如果我把森林烧掉，你会怎么样呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040906] = {81003040906,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001261}},{{"嗯？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040907] = {81003040907,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001262}},{{"曹焱兵用阎王炮发射火焰弹，森林中的火势立即蔓延开来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040908] = {81003040908,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001263}},{{"后会有期啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040909] = {81003040909,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001264}},{{"曹焱兵和曹玄亮逃走了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003040910] = {81003040910,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001265}},{{"可恶，这个疯子，居然放火烧森林。森林遭殃的话，我一定会被森林古神惩罚的……快来人！灭火！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041001] = {81003041001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001266}},{{"刚刚看见夏铃的信号弹，应该是从这附近发射的……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041002] = {81003041002,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct13,{{10100001267}},{{"焱兵！小亮！你们怎么这么慢！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041003] = {81003041003,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001268}},{{"碰到个自称森林守护者的人，被他缠住了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041004] = {81003041004,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001269}},{{"我也一样，被一个莫名其妙的家伙缠住了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041005] = {81003041005,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001270}},{{"你说自称森林守护者？是森林古神吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041006] = {81003041006,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001271}},{{"不，看起来不像，只是只丑陋的蜥蜴罢了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041007] = {81003041007,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001272}},{{"这座森林一定发生了什么，让那家伙统治了这片森林。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041008] = {81003041008,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001273}},{{"是食火蜥吉拉。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041009] = {81003041009,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001274}},{{"这家伙是谁？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041010] = {81003041010,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001275}},{{"我叫阎风吒，是踏风族的一员。我们族人自古以来就守护空神之森。可食火蜥吉拉霸占了我们的地方，害惨了我们族人。现在这里只剩下我一人了。\n那家伙如果被我遇到了，我一定不会放过他。可惜他一直躲在地下室搞那些的兵器改造实验，几乎没有露过面。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041011] = {81003041011,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct1,{{10100001276}},{{"他刚才救了我的一命，说他好像也要去芦花古楼，我想我们不如一起，好多个照应。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041012] = {81003041012,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001277}},{{"哦？你的族人既然被害，不去找食火蜥报仇，去芦花古楼做什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041013] = {81003041013,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001278}},{{"我有我的目的，怀疑我的话，分道扬镳就好了。还有，你还没说你的名字吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041014] = {81003041014,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001279}},{{"我么，我是罗刹街的当家曹焱兵，有七个守护灵，人称火将军。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041015] = {81003041015,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001280}},{{"完全没听说过，该不会是你自封的吧？我姐姐说过，金玉其外的家伙，最喜欢吹嘘自己。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041016] = {81003041016,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001281}},{{"你这小毛头，是不是想打架？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041017] = {81003041017,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct7,{{10100001282}},{{"喂喂，你们不要为什么幼稚的理由打起来啊，现在我们可是在躲那些蜥蜴的追查。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041018] = {81003041018,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100001283}},{{"嗯，阎风吒，你看上去不像坏人，我来告诉你我们为什么来这里吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041019] = {81003041019,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001284}},{{"北落师门把曾发生的事一五一十告诉了阎风吒。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041020] = {81003041020,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001285}},{{"所以，你们去芦花古楼是为了救神树？除了那个自大的家伙，你们看上去也不像坏人。这样的话，我倒是能给你们带路。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041021] = {81003041021,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001286}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041022] = {81003041022,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001287}},{{"真的？在什么地方？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003041023] = {81003041023,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001288}},{{"芦花古楼并非一直存在于森林中，几年才现身一次。我为这天已等了数月，今夜，芦花古楼就会现身。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050101] = {81003050101,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001289}},{{"另外，芦花古楼每次出现的地方不一样，但有规律可寻，只有踏风族的人知道这些。今晚它现身的地点，可能在西边。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050201] = {81003050201,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001290}},{{"这里应该走哪边呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050202] = {81003050202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001291}},{{"应该走左边。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050203] = {81003050203,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001292}},{{"记得是走右边。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050204] = {81003050204,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001293}},{{"阎风吒比较熟悉这里的地形，走右边吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050301] = {81003050301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001294}},{{"这一次走哪边？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050302] = {81003050302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001295}},{{"走上面的路。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050303] = {81003050303,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001296}},{{"不，应该走下面。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050304] = {81003050304,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001297}},{{"这小子，是不是故意跟我对着干……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050305] = {81003050305,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001298}},{{"曹焱兵，不要那么幼稚好吗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050306] = {81003050306,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001299}},{{"哥哥，还是姑且先听阎风吒的吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050307] = {81003050307,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001300}},{{"喂喂，不仅是夏铃，连小亮也开始相信他了。他要是食火蜥派的间谍，带我们走进陷阱了怎么办？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050401] = {81003050401,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001301}},{{"啊，这个机关要小心对待，要让他的剑指向正确的方位，道路才会打开。如果指向错误的地方，很可能会触发机关陷阱。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050402] = {81003050402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100001302}},{{"这机关之前我们也遇见过，不过如此，要我说，这次应该指向下面。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050403] = {81003050403,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001303}},{{"曹焱兵伸手扳动机关。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050404] = {81003050404,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001304}},{{"喂！你不要乱来啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050501] = {81003050501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001305}},{{"这里是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050502] = {81003050502,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001306}},{{"可恶，只有我们两个人掉进来了吗？这恐怕是个陷阱，我们得想办法出去才行。都怪你这个自大的家伙。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050503] = {81003050503,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001307}},{{"应该是你这个可疑的家伙才对，你不会是故意带我们来这么危险的地方来的吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050601] = {81003050601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001308}},{{"这家伙刚才也遇到过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050602] = {81003050602,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001309}},{{"虽然外表一样，但编号并不同，恐怕是同一批改造人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003050603] = {81003050603,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001310}},{{"不用你说我也知道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060101] = {81003060101,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001311}},{{"可恶，这么多岔路，陷阱究竟有多长……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060201] = {81003060201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001312}},{{"这条路到底通向哪里呢？要让我知道是你搞的鬼，我绝不会轻易放过你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060202] = {81003060202,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001313}},{{"懒得理你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060301] = {81003060301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001314}},{{"这幽灵是看守机关的吗？看来这机关能让我们出去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060302] = {81003060302,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001315}},{{"这机关底部已经坏掉了。看来机关底部需要一个人用手托着才能打开。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060301] = {82003060301,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001316}},{{"快，没时间了，我来托住它，你快操作机关。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060302] = {82003060302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001317}},{{"笨蛋，机关启动的力量恐怕有千斤重，托住底部，手恐怕也废了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060303] = {82003060303,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001318}},{{"别废话，来吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060304] = {82003060304,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001319}},{{"为了进入芦花古楼，丢掉一只手值得吗？为什么这么执着？你疯了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060305] = {82003060305,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001320}},{{"和你们不同，我的族人和姐姐都被关在古楼里……好不容易才等到进入古楼的机会，我不能再错过了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003060306] = {82003060306,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001321}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003060301] = {83003060301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001322}},{{"我可不想让你手废掉，芦花古楼里有什么危险还是未知，我们得多一个四肢健全的帮手才行。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83003060302] = {83003060302,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001323}},{{"你这家伙……还挺讲义气的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060401] = {81003060401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001324}},{{"抱歉，刚才是我不对，一直怀疑你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060402] = {81003060402,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001325}},{{"搞什么，突、突然这么正经。走吧，夏铃她们应该还在等我们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060501] = {81003060501,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001326}},{{"喂，前面有什么东西，你感觉到了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060502] = {81003060502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001327}},{{"嗯，一起上！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060601] = {81003060601,10100000049,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001328}},{{"吉拉大人说得没错，果然有笨蛋进来了。我要把你们统统抓住，献给吉拉大人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060602] = {81003060602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001329}},{{"那你倒是试试！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060701] = {81003060701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001330}},{{"没想到这小个子还挺厉害的，拥有操控风的天赋吗？真庆幸他站在我们这边。若他是敌人就麻烦了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060702] = {81003060702,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001331}},{{"你在嘀咕什么呢？这条路已经安全了，我们赶紧和其他人汇合吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060703] = {81003060703,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001332}},{{"那个……阎风吒，你刚刚说你的族人和姐姐都在芦花古楼里，到底是什么意思？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060704] = {81003060704,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001333}},{{"那是发生在几年前的悲剧。芦花古楼自古以来是古神的居所，凡人绝不允许入内。\n可上一次芦花古楼现身的时候，吉拉那蠢货私自打开古楼大门，害全村人被古神诛害，姐姐也一去不返。\n不过姐姐身上带着与我配对的项链，两条坠链用同一块灵石制成，可以无限转动，只要项链还在运转，姐姐就一定活着。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060705] = {81003060705,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001334}},{{"阎风吒取下挂在脖子上的项链，圆形的坠子正神秘地转动着。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060706] = {81003060706,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001335}},{{"不过吉拉也因此惹上了事端，古神带走了全村的人，却需要新人来守护这座森林，他们选中了吉拉，给他下了永远不能离开森林，也不能让森林受破坏的咒语。他自此再也不能离开空神之森。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060707] = {81003060707,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001336}},{{"原来如此。不过话说回来，那些古神和灵域的御史就因为这个驱逐了所有的族人？这样不人道的行径，听起来更像魔鬼所为。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060708] = {81003060708,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001337}},{{"不错，古神本来并不会因为以真面目示人就惩罚别人。从前我们族还有古神和族人会面的历史被记录下来。可上一次不知怎么的，那些灵域来的人坚持要驱逐所有人，好像很慌张的样子。或许，他们知道了普通人不该知道的东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060709] = {81003060709,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001338}},{{"听说灵域先王逝世后，灵域大变，不知是否与此事有关系。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060710] = {81003060710,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001339}},{{"那些高高在上的灵域原住民，才不会管我们。走吧，曹……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060711] = {81003060711,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001340}},{{"曹焱兵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003060712] = {81003060712,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001341}},{{"曹焱兵，别让你的同伴等久了，我们快出去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070101] = {81003070101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001342}},{{"曹焱兵！阎风吒！我们找了你们好久了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070102] = {81003070102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001343}},{{"要从那鬼地方出来真不容易，不过好在有这家伙跟我一起。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070103] = {81003070103,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001344}},{{"不，多亏了曹焱兵，他帮了大忙。好了，我们快继续前进吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070104] = {81003070104,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001345}},{{"奇怪，这俩关系什么时候这么好了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070201] = {81003070201,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001346}},{{"喂，你们慢一点，跑了这么久没有休息，我已经有点吃不消了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070202] = {81003070202,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001347}},{{"我也开始感觉吃力了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070203] = {81003070203,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001348}},{{"加把劲吧，芦花古楼出现的位置就在前面那片荒原后面，错过这次机会，要再等好几年才能再见到古楼了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070204] = {81003070204,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001349}},{{"休息一下也无妨。现在离芦花古楼现身时间还早，我们还有时间，别太着急了，风吒。养养精神，要是碰上吉拉的人也有精力应对。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070205] = {81003070205,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001350}},{{"嗯，我见芦花古楼就近在眼前，有些过于激动了。不过，不要滞留太久，我们五分钟后出发吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070301] = {81003070301,10100000025,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001351}},{{"嘿嘿嘿，终于找到你们了。正如吉拉大人所说，守在这里，就能拦截你们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070302] = {81003070302,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001352}},{{"怎么会，我们的路线暴露了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070303] = {81003070303,10100000025,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001353}},{{"你们的一举一动都在吉拉大人的掌控之中！乖乖就范吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070401] = {81003070401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100001354}},{{"看来那个叫吉拉的已经布下埋伏，前面的路我们小心为上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003070402] = {81003070402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001355}},{{"来阻挡我曹当家，得先问问我七个守护灵答应不答应。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080101] = {81003080101,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001356}},{{"大家当心，这段路还有不少机关。而吉拉的手下恐怕也布下埋伏了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080201] = {81003080201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100001357}},{{"咦，是个十字路口。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080301] = {81003080301,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001358}},{{"芦花古楼应当往左走，可这里只有向下的路能通行，这恐怕是吉拉布下的局。没办法，硬着头皮去看看吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080401] = {81003080401,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001359}},{{"我布下的陷阱如何？真开心有除了兔子以外的生物掉进去。咦，那不是踏风族的小子么？你居然还活着？我的灵海检测仪上多出来的那人就是你么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080402] = {81003080402,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001360}},{{"吉拉！在你离开空神之森之前，我是不会闭眼的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080403] = {81003080403,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001361}},{{"呵呵，那么我们拭目以待。坦克！我骄傲的改造体，出来吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080501] = {81003080501,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001362}},{{"这家伙真可怕，像不怕痛似的一个劲地冲过来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080502] = {81003080502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001363}},{{"等你能徒步走到刘羽禅的桃园，就会发现这样的家伙也不过如此。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080601] = {81003080601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001364}},{{"我们是不是绕回来了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080602] = {81003080602,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001365}},{{"不错，芦花古楼现身时间已到，我们也快到了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080603] = {81003080603,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001366}},{{"真是地狱无门闯进来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080604] = {81003080604,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001367}},{{"吉拉，你还敢出来，你害我全族被害，今天我就来讨回公道！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080605] = {81003080605,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001368}},{{"姓阎的小子，我当初被你们族人如何对待的，你会不知道吗？他们被古神惩罚也是罪有应得。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080606] = {81003080606,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001369}},{{"如何对待？我们收留流浪的你，给你住处，请你吃喝，你却恩将仇报。还有，别对我大呼小叫的，老子的阎，是阎王爷的阎！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080607] = {81003080607,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001370}},{{"他要跑了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080608] = {81003080608,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001371}},{{"看样子他要转移到对他有利的地方战斗，我们追！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080701] = {81003080701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100001372}},{{"哥哥，快看！芦花古楼出现了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080702] = {81003080702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001373}},{{"走！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080703] = {81003080703,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100001374}},{{"我等这一刻已经很久了，姐姐，我一定会把你救出来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080704] = {81003080704,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001375}},{{"一行人急忙向芦花古楼赶去，只有北落师门停下了脚步。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"1","2","ef_dialogue_da","1","420","0","1"}},
	[81003080705] = {81003080705,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001376}},{{"怎么了？你不跟同伴一起走，来看我笑话？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080706] = {81003080706,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001377}},{{"你的腿怎么了？怎么开始化成石头了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080707] = {81003080707,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001378}},{{"这是古神的咒语，一旦森林遭到破坏，我也会化成石头。这些把人类当奴隶使唤的所谓的神，要不是给我下了咒语，我老早就跟他们拼了。你们进去了，替我出口气吧。你们这群家伙，说不定，有这样的力量……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080708] = {81003080708,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001379}},{ct155},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080709] = {81003080709,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001380}},{{"哼，你要笑就笑吧，我这副什么也办不到的样子，连我自己都觉得可悲。要守护的东西变得遥远，而肮脏的事情却近在眼前。在实验室待久了，身上会残留洗不去的腐臭味，坏事做久了，人也会变得麻木。能在归西前享受自由，这是我唯一庆幸的事情。你走吧，外人在森林里呆太久也会变成石头的。只有呆在芦花古楼里才能幸免。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080710] = {81003080710,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001381}},{{"这么说，神的咒语只在这座森林里生效？那么，我把你带进古楼，你也能恢复原状咯？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080711] = {81003080711,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001382}},{{"别做多余的事，你与阎风吒站在一起，我们就是敌人，就算你救了我，这一点也不会改变。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080712] = {81003080712,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001383}},{{"一码归一码，我偏要带你进去。我们还需要人手呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080713] = {81003080713,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001384}},{{"北落师门拖着吉拉，走向芦花古楼内部。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080714] = {81003080714,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001385}},{{"喂，你想清楚！我要是恢复了可是会和你战斗的哦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080715] = {81003080715,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001386}},{{"想干架我一定奉陪。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080716] = {81003080716,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001387}},{{"就算你在我面前被神灵咒语，我也不会管你的哦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080717] = {81003080717,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001388}},{{"好、好。随你的便吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080801] = {81003080801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001389}},{{"咦，我们刚进入森林，那些怪物就自动退散了。李轩辕你的方法很有效嘛！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080802] = {81003080802,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001390}},{{"不，感觉怪怪的，恐怕跟地貌没什么关系。如果我没猜错，这片森林就是传说中的禁地空神之森。那些畜生应该感知到了咒语的危险才离去的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080803] = {81003080803,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001391}},{{"禁地？那我们这样闯进来没问题吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080804] = {81003080804,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001392}},{{"没办法，现在只有先前进了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003080901] = {81003080901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001393}},{{"对了，来都来了，我们先去找焱兵吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081001] = {81003081001,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001394}},{{"这森林不是普通的森林，焱兵要来这里一定有非比寻常的理由。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081101] = {81003081101,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001395}},{{"总之别太冒进，大家小心前进吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081201] = {81003081201,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001396}},{{"水儿现在已经投胎转世了吧，这次她一定会幸福地活着。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081301] = {81003081301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001397}},{{"来到这种地方却有惊无险，真不知该说运气好还是不好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081401] = {81003081401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001398}},{{"刚才那些蜥蜴军团一定会再出现，千万要当心啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081501] = {81003081501,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001399}},{{"可恶，居然用这么卑鄙的手段迷惑我们……哥哥真是的，怎么一下子就中计了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081502] = {81003081502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001400}},{{"知道啦知道啦，是我的错。我们还是快点离开这里吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081601] = {81003081601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001401}},{{"不知道其他人怎么样了，我们最好尽快找到他们才好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081701] = {81003081701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001402}},{{"希望大家能顺利汇合。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081801] = {81003081801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001403}},{{"东边好像有些嘈杂声，我们小心过去看看情况吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003081901] = {81003081901,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001404}},{{"那场大火或许能帮我们拖延时间，那家伙现在无暇顾及我们了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082001] = {81003082001,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001405}},{{"嗖——\n一声尖锐的炮鸣引起曹焱兵的注意。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082002] = {81003082002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001406}},{{"那是夏玲姐姐的信号弹！我们快过去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082101] = {81003082101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001407}},{{"你们没事吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082201] = {81003082201,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001408}},{{"没时间休息了，我们快走吧，别告诉我你没胆进芦花古楼。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082301] = {81003082301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001409}},{{"我是为了去芦花古楼，怎么会在这种地方退缩。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082401] = {81003082401,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001410}},{{"我们在这里浪费了太多时间，这样下去说不定会错过芦花古楼现身的时间，快走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082501] = {81003082501,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001411}},{{"没想到你人还不错，或许我们可以成为同伴。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082601] = {81003082601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001412}},{{"这咒语的森林也不过是唬人罢了，没什么大不了的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082602] = {81003082602,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001413}},{{"那是你还没见识过远古之神的恐怖之处。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082603] = {81003082603,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001414}},{{"我曹焱兵要做的事，一定要做到，这就是我的信念，管他什么神鬼，都别想阻拦我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082604] = {81003082604,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001415}},{{"你这人，还怪有意思的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082701] = {81003082701,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001416}},{{"距离芦花古楼还有一段路程，当心别再走进陷阱了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082801] = {81003082801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001417}},{{"嗯，夏玲他们一定在等我们，我们快去找他们吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003082901] = {81003082901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001418}},{{"你们俩和好真是太好了，我还在担心你们是不是打起来了呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083001] = {81003083001,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001419}},{{"吉拉已经布下局，等我们上钩了，焱兵你还能撑得住吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083002] = {81003083002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001420}},{{"这是场战斗我们非赢不可，好不容易碰上芦花古楼现身的时机，我可不想再等几年时间。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083101] = {81003083101,10100000062,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001421}},{{"真是个可怕的家伙，不过好歹赢了。芦花古楼应该快现身了，我们往前走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083201] = {81003083201,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001422}},{{"咳咳……咳咳……可恶，我的身体开始石化了，这就是没有好好守护森林的代价吗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083202] = {81003083202,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001423}},{{"这家伙还在啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083301] = {81003083301,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001424}},{{"焱兵，我要带上这家伙，你没意见吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083302] = {81003083302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001425}},{{"随你的便，反正不是我背他。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003083303] = {81003083303,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001426}},{{"呵呵，那好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
