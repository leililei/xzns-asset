	[81003030503] = {81003030503,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001228}},{{"附近没有人迹，恐怕他们不在这里。石灵明，你去那颗最高的树树顶观察下附近的动向。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003030504] = {81003030504,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001229}},{{"石灵明迅速爬上树梢，眺望远方。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
