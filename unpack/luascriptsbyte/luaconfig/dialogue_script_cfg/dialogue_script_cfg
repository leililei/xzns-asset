	[81003030401] = {81003030401,10100000025,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001225}},{{"呵呵呵，和计划一样，把他们分散了，只有一个人的话，就好办了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003030501] = {81003030501,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001226}},{{"哼，想对付我，还早着呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
