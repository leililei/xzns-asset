	[82000014402] = {82000014402,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001968}},{{"曹焱兵一路横冲直撞，用武器十殿阎罗轻松击退如蝼蚁般的恶灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014403] = {82000014403,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002818}},{{"行至一处，曹焱兵却忽然停下脚步。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
