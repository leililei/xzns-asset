	[81000017010] = {81000017010,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002321}},{{"不行。这是曹家历代相传的神器，力量之源乃是庞大无垠的地狱火海。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017011] = {81000017011,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100002322}},{{"持有人越想从其中得到强大的力量风险也越大，如果不注意使用，便会玉石俱焚。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017012] = {81000017012,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100002323}},{{"这种东西如果落入恶人之手，只怕后果不堪设想，断不可以随便交给别人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017013] = {81000017013,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100002324}},{{"真小气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
