	[83701010401] = {83701010401,10100000007,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000236}},{{"什么！恶灵居然想当镇魂将？太猖狂了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83901010401] = {83901010401,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/shimangjiangjun_story_02"},ct1,0,0,3,2,{ct2},ct2,ct4,ct1,ct1,{{10100000237}},{ct43},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83901010402] = {83901010402,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/shimangjiangjun_story_03"},ct1,0,0,3,2,{ct2},ct2,ct4,ct1,ct1,{{10100000238}},{{"区区镇魂将，竟敢阻挡本将军的计划！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83901010403] = {83901010403,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/shimangjiangjun_story_04"},ct1,0,0,3,2,{ct8},ct2,ct16,ct1,ct1,{{10100000239}},{{"不可饶恕！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84201010401] = {84201010401,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000240}},{{"但你好像搞错了，大个子。我曹焱兵绝不会让任何恶灵为非作歹！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001010401] = {83001010401,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000241}},{{"看你的实力，是罗刹街的镇魂将吧？现在我心情不错，你老实交出罗刹街，我就放你一马。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct62},
	[83001010402] = {83001010402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000242}},{{"真伤脑筋啊，区区恶灵也想爬到我头上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[83001010403] = {83001010403,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct167,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000243}},{{"你有两下子，可区区烈焰又能奈我何？\n现身吧，蛇灵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001010404] = {83001010404,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000244}},{{"天真的家伙。许褚，震碎它！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001010501] = {81001010501,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000245}},{{"我可不能这样就输掉。亘古蛇灵，成为我的力量吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct62},
	[81001010601] = {81001010601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000246}},{{"小心！他与蛇灵融为一体了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001011101] = {81001011101,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/shimangjiangjun_xiaosheng"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000247}},{{"亘古蛇灵与我在漫长岁月中合为一体，你以一敌二，真是不自量力。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001011102] = {81001011102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_33"},ct1,0,0,2,2,{ct2},ct2,ct1,ct1,ct1,{{10100000248}},{{"镇魂将都是由灵域选拔的寄灵人，我的守护灵已经对你很不耐烦了——许褚，震碎他！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001010701] = {81001010701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000249}},{{"好久没出来过了，许褚，出来活动活动吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010702] = {81001010702,10100000059,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000250}},{{"守护主公，一心同体，收到命令，即刻执行。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"Images/zRoles/ui_lt_touxiang04"}},
	[81001010703] = {81001010703,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000251}},{{"守护灵？难道你、你就是……罗刹街的镇魂将——曹焱兵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct62},
	[81001010801] = {81001010801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/xialing_lihai"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100000252}},{{"好厉害……\n曹焱兵，你不是送外卖的吗……你到底是什么人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010802] = {81001010802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct29},ct2,ct1,ct1,ct1,{{10100000253}},{{"现在不是问这种问题的时候，好好看看周围的情况啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010803] = {81001010803,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000254}},{{"尸蟒将军的手下迟疑地围站在四周，低声吼叫着。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001010804] = {81001010804,10100000011,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct16,ct1,ct1,{{10100000255}},{{"吼吼吼吼——"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001010805] = {81001010805,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct4,ct1,ct7,{{10100000256}},{{"哇啊啊啊啊，又、又来了，我们怎么办？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010806] = {81001010806,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/caoyanbing_jiangjundexiachang"},ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct12,{{10100000257}},{{"还没逃跑吗？呵呵，你们这群尸鬼，有谁想和你们将军一个下场，就来试试！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010901] = {81001010901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000258}},{{"哇，好高大的树啊……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010902] = {81001010902,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000259}},{{"这颗树叫灵槐树，是守护罗刹街的神树。树后面就是我和哥哥的家。\n因为我每天都有认真照顾，它才会长得这样好哦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010903] = {81001010903,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000260}},{{"神树……对了，这里到底是什么地方啊？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010904] = {81001010904,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000261}},{{"连这里是什么地方都不知道，来这里干嘛啊？果然是个笨女人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010905] = {81001010905,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100000262}},{{"你这个人，别一口一个笨女人的，我也是受害者好不好！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010906] = {81001010906,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000263}},{{"你们认识吗？感觉很熟的样子嘛。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010907] = {81001010907,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000264}},{{"谁要跟这笨女人熟啊。我在人间打工的时候，这女人走路闯红灯，撞翻了我的外卖，害我被好几个客户投诉了……对了，这事还没找你算账呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010908] = {81001010908,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000265}},{{"跟你解释过了嘛，那时候是有人在后面推了我一下我才摔倒街上的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010909] = {81001010909,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000266}},{{"笨蛋就是借口多。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010910] = {81001010910,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000267}},{{"这里是收容亡灵的街道，叫“罗刹街”，也就是人们常说的“冥界”啦。\n刚刚你碰上的，是邪化后的亡灵，也就是恶灵。"}},{ct3,ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010911] = {81001010911,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000268}},{{"那你们也是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010912] = {81001010912,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000269}},{{"不不不，我们是货真价实的人类。我们兄弟二人之所以住在这里，是家族的使命。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010913] = {81001010913,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000270}},{{"家族的使命？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010914] = {81001010914,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000271}},{{"我们家族拥有代代相传的寄灵人体质，所以世世代代都被任命为镇魂将，镇守着这里的恶灵，要是有恶灵作怪，就除掉他们。我哥哥曹焱兵，就是现任罗刹街的镇魂将。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010915] = {81001010915,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000272}},{{"小亮，不用跟这个笨女人说这些多余的话，她反正也听不懂啦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010916] = {81001010916,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000273}},{{"原来如此，刚刚真是多谢你了，小亮。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010917] = {81001010917,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000274}},{{"救你的人是我，怎么不跟我道谢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010918] = {81001010918,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000275}},{{"不知为什么，被你这种自以为是的人救了完全高兴不起来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010919] = {81001010919,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000276}},{{"小亮，我看这种笨蛋还是丢回恶灵那边比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001010920] = {81001010920,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000277}},{{"好啦好啦……别吵了。"},{"话说回来，人类长时间呆在冥界不太好，姐姐，还是让我们送你回去吧。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001010921] = {81001010921,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000278}},{{"真的吗？那真是太感谢了！我一秒钟也不想跟自大男还有恐怖的恶灵呆在一起。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001010922] = {81001010922,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000279}},{{"哼，你可别再走错路了，去往大门的路上还有好多恶灵，我可不想在我的罗刹街让人类受伤。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81000011601] = {81000011601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000280}},{ct168},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020101] = {81001020101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000281}},{{"真的没问题吗，我说，不然还是……欸，你们不要走那么快，等等我啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001020102] = {81001020102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000282}},{{"注意看敌人方向，别闭上眼睛！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020201] = {81001020201,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct13,{{10100000283}},{{"哇，我做到了，真的做到了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001020202] = {81001020202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000284}},{{"我能感觉到你灵力变强了，不过，还不足以召唤出守护灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020203] = {81001020203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000285}},{{"还要打吗……不过，这样看来，应该可以的吧。嘿嘿，我还挺厉害的嘛！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020204] = {81001020204,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000286}},{{"喂，你们看，这条路已经被封住了。\n那里有个机关，且去试试吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020301] = {81001020301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000287}},{ct168},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001020401] = {81001020401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000288}},{{"你看上去笨头笨脑的，使起灵力来倒是有一套。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020402] = {81001020402,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000289}},{{"哼，想看我笑话可没那么容易！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020403] = {81001020403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000290}},{{"总而言之，这算是好事。现在你灵力充盈，差不多可以召唤守护灵了，可以召唤一次试试看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020404] = {81001020404,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000291}},{{"哦哦哦，终于要出现了吗，我的守护灵到底是个什么样的人，好期待啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020601] = {81001020601,10100000001,"","",{ct2},ct1,ct1,3,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000292,10100001536,10100001537}},{{"致各位寄灵人","灵域力量衰微，王国势力蠢蠢欲动，","在此希望诸位联合起来对抗王国势力。","鬼符三通"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025401] = {81001025401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct1,{{10100000293}},{{"哥哥，姐姐既然是寄灵人，就不用消除记忆了吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025402] = {81001025402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000294}},{{"的确，前提是她能学会使用灵力。\n走吧，看看她有没有这样的好运吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025601] = {81001025601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000295}},{{"咦，你不是这地方的幽灵吧？找我有事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025602] = {81001025602,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000296}},{{"想必这位就是罗刹街的镇魂将曹当家。\n果然一表人才。我乃四处游荡的说书人是也，从南方游历至此，不知道大人是否能让我在此地歇歇脚？若有时间，我将把一路的见闻说与大人听，或许对你有帮助。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025501] = {81001025501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000299}},{{"说起来你们刚刚说我是寄灵人什么的是什么意思？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025002] = {81001025002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000300}},{{"你听见了啊？\n跟我来吧，先到安全的地方，再慢慢解释。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025101] = {81001025101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000301}},{{"曹焱兵，一直没好好感谢你，谢谢你救了我哦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025102] = {81001025102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000302}},{{"要感谢的话，先把上次撞坏我摩托车的费用付了吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025103] = {81001025103,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000303}},{{"呃，今天天气真不错！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025801] = {81001025801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000304}},{{"这条路气氛好阴森，就这样走进去真的没问题吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025301] = {81001025301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000305}},{{"你也太冲动了，曹焱兵，万一你打不过那人怎么办？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025302] = {81001025302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000306}},{{"怎么能向他服软，打了再说。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025901] = {81001025901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000307}},{{"怎么了？你要送我回去吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025902] = {81001025902,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000308}},{{"嗯，你可别发愣跟丢了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001026101] = {81001026101,10100000042,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/shimangjiangjun_story_05"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000309}},{{"小的们，给我撕碎这个不知天高地厚的人类！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025201] = {81001025201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000310}},{{"哥哥，时间不早了，我们继续前进吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001025202] = {81001025202,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000311}},{{"这段路恶灵真多。\n虽然罗刹街是镇魂街中恶灵出没最为频繁的街道，但最近是不是越发凶险了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020401] = {82001020401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,1,{ct2},ct2,ct1,ct1,ct6,{{10100000312}},{{"王国势力？最近罗刹街魂兵行动很怪，跟他们有关系么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[82001020402] = {82001020402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct8},ct2,ct1,ct1,ct1,{{10100000313}},{{"联合所有寄灵人吗……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[82001020403] = {82001020403,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000314}},{{"忽然，一个人影从暗影重重的屋顶跳下来，挡住了他们的去路。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020404] = {82001020404,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{{10100000315}},{{"曹焱兵，出什么事了，这么急匆匆的？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020405] = {82001020405,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_08-001"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000316}},{{"鬼符三通？你来做什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020406] = {82001020406,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct15,{{10100000317}},{{"给你的邮件显示已读未回，让我有些伤心呢，所以我想亲自来问问你，要不要加入我，一起对抗王国组织？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020407] = {82001020407,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100000318}},{{"我曹焱兵一向单打独斗，对结盟之类的事情没兴趣。再说，我们很熟吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020408] = {82001020408,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000319}},{{"没兴趣？就算王国的人来攻打你也无所谓？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020409] = {82001020409,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100000320}},{{"谁敢来罗刹街捣乱，就是跟我曹当家作对，干掉就完事了，何必加入什么组织。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020410] = {82001020410,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct18,{{10100000321}},{{"呵呵，原来你呆在罗刹街这样的小地方就满足了。\n我还以为曹家后人有什么了不起的，没想到竟是这种没种的软蛋。失望啊，呵呵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020411] = {82001020411,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100000322}},{ct169},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020412] = {82001020412,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000323}},{{"我说错了吗？总是满足于现状，再快的刀也会变钝。\n若是不服气，现在就跟我过过招，让你见识下千征百战的我，和躲在街道里的你之间的差距。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020413] = {82001020413,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000324}},{{"（小声）曹焱兵，那人看起来只是想激你啦，别中计！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020414] = {82001020414,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000325}},{{"行啊，正好手痒了，想找人练练手。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020415] = {82001020415,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct29},ct2,ct1,ct1,ct18,{{10100000326}},{ct170},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020416] = {82001020416,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100000327}},{ct171},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020417] = {82001020417,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000328}},{{"救命呀！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82001020418] = {82001020418,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000329}},{{"有动静！声音在右边，我们走，小亮！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001020501] = {81001020501,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000330}},{{"给你的邮件显示已读未回，让我有些伤心呢，所以想亲自来问问你：要不要加入我，一起对抗王国组织？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020502] = {81001020502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,1,{ct2},ct2,ct1,ct1,ct1,{{10100000331}},{{"没兴趣。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001020503] = {81001020503,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000332}},{{"就算王国的人来攻打你也无所谓？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020504] = {81001020504,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000333}},{{"我们曹家世世代代守护罗刹街，谁敢来捣乱，老子就干掉他不就完了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001020505] = {81001020505,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000334}},{{"呵呵，呆在罗刹街这样的小地方就满足了吗？\n恐怕你不知道，王国的个中高手数不胜数，你说你能胜过他们，不过是吹牛罢了。若你真如你所说，就来和我比试比试，让我看看你的实力。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020506] = {81001020506,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000335}},{{"跟你说过了，我没兴趣。请你回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001020507] = {81001020507,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000336}},{{"我还以为曹家后人有什么了不起的，没想到竟是这种没种的软蛋。失望啊，呵呵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020508] = {81001020508,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000337}},{ct169},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001020509] = {81001020509,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000338}},{{"你那眼神，是要和我比试吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020510] = {81001020510,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000339}},{{"（小声）那人是想激你啦，别中计！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001020511] = {81001020511,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000340}},{{"正好手痒了，想找人练练手。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001020512] = {81001020512,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct29},ct2,ct1,ct1,ct1,{{10100000341}},{ct170},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct33},
	[81001020513] = {81001020513,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000342}},{ct171},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81001030101] = {81001030101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000343}},{{"鬼符三通朝前面边走了，他脚程好快，我们快跟上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81001030201] = {81001030201,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000344}},{{"哇，那是什么……没、没有脚的人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct17},
	[81001030202] = {81001030202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000345}},{{"能不能别这么一惊一乍，那是幽灵，很常见的东西。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030203] = {81001030203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct29},ct2,ct1,ct1,ct1,{{10100000346}},{{"谁会随随便便见到幽灵啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030204] = {81001030204,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000347}},{{"三盏灯？是机关吗？大家当心一点。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030701] = {81001030701,10100000067,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000348}},{{"呀，居然撞见人类了，真是不吉利！呸呸呸！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030801] = {81001030801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000349}},{{"有东西落下来了——石头？嘶，好烫！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030802] = {81001030802,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000350}},{{"啊，这形状……莫非是古书上所记载的共鸣神石。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"1","3","Images/Icon/ui-huobi-lingyu","1","0","0"}},
	[81001030803] = {81001030803,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000351}},{{"我也听说过，传说神石分五属，分别是风，雷，水，火，土，恰与寄灵人属性相合。若得到与自己属性相同的神石，悉心供养，增益神石之力，自己和同伴的灵力也能与神石共鸣，获得增长。小亮，把它放进你包里吧。细心培养，今后它将对修炼大有裨益。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"0","3","Images/Icon/ui-huobi-lingyu","1","0","0"}},
	[81001030804] = {81001030804,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000352}},{{"小亮，把它放进你包里吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030805] = {81001030805,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000353}},{{"嘶，好烫！得到这宝贝，不枉我们来这一趟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035401] = {85001035401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000354}},{{"鬼符三通的信我总觉得不太对劲。\n那个说书幽魂走南闯北，或许知道点什么，我去找他打听打听。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035402] = {85001035402,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000355}},{{"总觉得有种不好的预感。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035601] = {85001035601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000356}},{{"你有听说过鬼符三通这个人么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035602] = {85001035602,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000357}},{{"鬼符三通吗？那家伙是个有风骨的寄灵人，做了不少好事。\n只可惜……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035701] = {85001035701,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000358}},{{"可惜什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035702] = {85001035702,10100000045,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000359}},{{"听说他前段时间去世了——不过我也不太清楚，只是听说而已。\n话说回来，夏铃姑娘似乎很着急的样子，大人不去看看情况吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035501] = {85001035501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000360}},{{"你们俩兄弟又在嘀嘀咕咕什么呢……真是的，快走啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035001] = {85001035001,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000361}},{{"不过，话又说回来，这里不是罗刹街的大门吗？我能直接从这里回人界吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035002] = {85001035002,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000362}},{{"这道门发生了异常，暂时不能通过，我们绕个远路，东边应该还有一个出口。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035101] = {85001035101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000363}},{{"真是的，想不到曹焱兵是这么冲动的家伙。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035201] = {85001035201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000364}},{{"鬼符三通……他明面上来信要抵抗王国势力，但我总觉得来者不善。\n虽说哥哥冲动了些，也好趁此机会打听打听他的底细，事不宜迟，我们快跟上吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035301] = {85001035301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000365}},{{"还以为他有什么大动作，也许真的想拉哥哥入伙吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035302] = {85001035302,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000366}},{{"如果真这么简单就好了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001035801] = {85001035801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000367}},{{"只用了如此之短的时间便击败了对方，真不愧是哥哥。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030301] = {81001030301,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000368}},{{"哈哈，竟然能跟上我的脚步，不错。\n让我看看你的实力吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030401] = {81001030401,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct15,{{10100000369}},{{"我没看错人，你资质果然不错，曹焱兵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030402] = {81001030402,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct1,{{10100000370}},{{"（这人很强，他战斗时到底有几分认真……看不透，他的灵力似乎深不可测……）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030403] = {81001030403,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct18,{{10100000371}},{{"我很欣赏你，要是你还想加入我们，随时可以改变主意。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030404] = {81001030404,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct15,{{10100000372}},{{"那么，先走一步了。呵呵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001030401] = {83001030401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000373}},{{"鬼符三通出了名的神出鬼没，今天见了，果然真是个怪人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001030402] = {83001030402,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000374}},{{"一行人继续赶路，又行过两段狭窄的巷子，罗刹街的大门出现在眼前。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001030403] = {83001030403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000375}},{{"这里就是罗刹街的出口，你顺着这条路，就可以回到人类世界了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001030404] = {83001030404,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000376}},{{"真的？太感谢你们了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030501] = {81001030501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000377}},{{"别再走错路了！下次可不一定这么走运了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030502] = {81001030502,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000378}},{{"兄弟二人目送夏铃走出了冥界。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030505] = {81001030505,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000379}},{{"哥哥，最近罗刹街有些异常啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030506] = {81001030506,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000380}},{{"的确，今日鬼符三通来这里，笨女人又莫名其妙走入了冥界，只怕灵域发生动荡的传言不是空穴来风。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030507] = {81001030507,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000381}},{{"到底发生了什么呢？这天下……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030508] = {81001030508,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000382}},{{"我也不知道，不过，没有人能在老子的地盘撒野。我们今后要更加警惕才行。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030509] = {81001030509,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000383}},{ct35},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001030601] = {81001030601,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000384}},{{"附近传来开锁的声音，可以从封锁的道路通行了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042601] = {81001042601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct42,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000385},{10100001529}},{{"虽然听从鬼符三通的话，逃到罗刹街来了，但是这里像迷宫一样，到底该走哪条路啊……"},{"对了！我记得这个广告牌，顺着这条路应该能找到曹焱兵。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042602] = {81001042602,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000386}},{{"为了逃脱王国魔爪，夏铃听从鬼符三通的指示，再度返回罗刹街，寻求曹焱兵的帮助。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042603] = {81001042603,14102000001,"","",{ct2},ct1,ct1,0,0,0,1,{ct2},ct2,ct1,ct1,ct1,{{10100003884}},{{"还好及时赶到，没想到王国组织的人来的这么快。。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042604] = {81001042604,0,"","",{ct2},ct172,ct1,0,2,0,1,{ct2},ct2,ct1,ct1,ct1,{{10100003885}},{{"*滋—嘣——*鬼符三通击败了最后一个来袭的机器人"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042605] = {81001042605,14102000001,"","",{ct2},ct1,ct1,0,0,0,1,{ct2},ct2,ct1,ct1,ct1,{{10100003886}},{{"这么多年了，我的计划也该继续了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042606] = {81001042606,14102000001,"","",{ct2},ct1,ct1,0,0,0,1,{ct2},ct2,ct1,ct1,ct1,{{10100003887}},{{"曹焱兵你可别让我失望啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042701] = {81001042701,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000387}},{{"好多魂兵的尸体……难道刚刚发生了一场乱战？\n唔，我看我还是赶紧离开比较好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042702] = {81001042702,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000388}},{{"附近传来一阵低鸣。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001042703] = {81001042703,10100000019,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000389}},{ct173},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83001042701] = {83001042701,10100000053,"","",{ct2},ct1,ct1,1,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000390}},{{"难道已经断气了？"}},{ct3},ct2,false,{{90000000103}},ct1,{ct27},{{"840010427"}},ct1},
	[84001042701] = {84001042701,10100000053,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000391}},{{"唔……试试吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85001042701] = {85001042701,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000392}},{{"失去意识的魂兵，一动不动地躺在地上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[87001042701] = {87001042701,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/xialing_jianjiao"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000393}},{{"什、什么！恶灵还活着？完蛋了，没地方可以躲，我已经被它看到了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[87001042702] = {87001042702,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000394}},{{"不过……只有一只恶灵，而且它看上去受了重伤，硬着头皮迎击也不是没有胜算……哇！它冲过来了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
