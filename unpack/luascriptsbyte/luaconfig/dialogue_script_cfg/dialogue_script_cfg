	[81000020501] = {81000020501,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002536}},{{"众人击败天市，继续向羽林街深处前进。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000020502] = {81000020502,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002537}},{{"在大殿楼梯之上，一个熟悉的身影跪在那里。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000020503] = {81000020503,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100002538}},{{"是北落师门！他好像被枷锁困住了，有人在对他施法？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000020504] = {81000020504,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100002539}},{{"那是取出镇魂链的法术。\n恐怕他们想杀了北落，又不想惊动灵域，所以才先取出镇魂将的身份证明——镇魂链。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
