	[81000014701] = {81000014701,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct42,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct15,{{10100001989}},{{"冥界原来有亡灵也有恶灵，那，你之前召唤出的怪物属于什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014702] = {81000014702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100001990}},{{"许褚，有人想认识你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
