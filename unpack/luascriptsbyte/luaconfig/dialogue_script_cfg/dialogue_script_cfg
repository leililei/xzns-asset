	[81000017401] = {81000017401,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002370}},{{"曹焱兵来到还未查探过的风筝巷。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
