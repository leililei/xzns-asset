	[86002010702] = {86002010702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001572}},{ct35},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81102010701] = {81102010701,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001573}},{{"水儿！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81102010702] = {81102010702,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct21,{{10100001574}},{{"啊！是门司令！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81402010701] = {81402010701,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001575},{10100001605}},{{"是你们救了这两个孩子吗？\n我是明镜村的镇魂将北落师门，可否请这位英雄来寒舍小坐，我再好好向你们致谢。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81402010702] = {81402010702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001576},{10100001577}},{{"大人不必言谢，我是罗刹街镇魂将曹焱兵，救助幽灵是我分内之事。"},{"不过我们赶了好几天路，正在找歇脚的地方，若是明镜村有一间让我们容身的屋子就帮大忙了。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81402010703] = {81402010703,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct15,{{10100001578}},{{"曹焱兵？\n唔……老张，我看孩子们受伤了，麻烦你先带他们回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81402010704] = {81402010704,10100001603,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001579}},{{"好嘞。孩子们，大家伙，我们先回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82302010701] = {82302010701,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001580},{10100001604}},{{"早就听闻曹当家的传闻，今日一见，英雄不仅气度不凡，更有侠肝义胆，令我欣赏敬佩。"},{"不过，正因如此，我不能收留你们。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82302010702] = {82302010702,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct7,{{10100001581}},{ct41},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82302010703] = {82302010703,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001582}},{{"北落师门递来一张印着灵域标识的言灵信。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82302010704] = {82302010704,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct10,{{10100001583}},{ct37},{ct3},ct2,false,{{90000000110}},ct1,{ct27},{{"824020107"}},ct1},
	[82402010701] = {82402010701,0,"","",{ct2},ct1,ct1,3,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001584,10100001585,10100001598}},{{"各镇魂街将领：","\t罗刹街将领曹焱兵毁坏神树灵槐，扰乱镇魂街安宁，如今正四处逃亡，下落不明。现经讨论予以通缉。\n稍后将向各位发布逃犯肖像。请接到此通告后，立即开始搜查工作。","灵域"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82402010702] = {82402010702,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100001586},{10100001587},{10100001588}},{{"没错，曹当家，罗刹街神树被毁一事，灵域已经降罪，正四处捉拿“逃犯”曹焱兵。"},{"虽然不清楚罗刹街究竟发生了什么，但既然你对我们有恩，这次我就当作没见过你，也会嘱咐村里人不向外宣扬此事。"},{"但进入明镜村一事，恕我不能答应你。"}},{ct3,ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82402010703] = {82402010703,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001589}},{{"“逃犯”……我明白了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82402010704] = {82402010704,11501000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct21,{{10100001590}},{{"保重，曹当家。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802010701] = {82802010701,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct26,{{10100001591},{10100001592}},{{"对不起，大哥哥。其实北落大人是个大好人，不过他也很有原则……还请你们不要怪他。"},{"我会记住你们的恩情的，我想北落大人也一样。这个，请你收下。"}},{ct3,ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802010702] = {82802010702,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001593}},{{"白水儿递来一面镜子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802010703] = {82802010703,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001594}},{{"这是菩提树根做的镜子，它的神力会保护你们的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83202010701] = {83202010701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct19,{{10100001595}},{{"怎么办，哥哥，龙桃的神珠我们还没拿到呢，就这样走了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83202010702] = {83202010702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001596}},{{"没办法，我们背负着逃犯的身份，只能先离开，再想其他办法了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[86002010801] = {86002010801,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001602}},{{"顺序好像不对哦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[87002010901] = {87002010901,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001606}},{{"快到明镜村了，记住，一会儿按原计划行事，我不信北落师门不肯交出神珠。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81102010901] = {81102010901,14104000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001607}},{{"大人，有人从那边来了，不像是明镜村的人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81302010901] = {81302010901,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001608}},{{"天市，你派两队羽林军去探一探。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81302010902] = {81302010902,14402000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001609}},{ct52},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802010901] = {82802010901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001610}},{{"我们朝这边走应该能避开羽林街的人，对吧，小亮？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802010902] = {82802010902,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001611}},{{"嗯，地图上是这样写的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83102010901] = {83102010901,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001612}},{{"密林中忽然钻出一队士兵，将曹焱兵团团围住。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83102010902] = {83102010902,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100001613}},{{"这、这是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83102010903] = {83102010903,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct7,{{10100001614}},{{"是羽林军！大家当心！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84602010901] = {84602010901,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001615}},{{"呵呵，让我看看，原来是大名鼎鼎的曹当家啊。\n给我抓住这个逃犯！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88002011001] = {88002011001,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001616}},{{"什么！羽林军居然被……\n天市、紫薇，抓住他！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88002011002] = {88002011002,10100000002,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001617}},{ct110},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81602011001] = {81602011001,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001618}},{{"御夫老弟，谢谢你啦！我找这家伙找好久了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81802011001] = {81802011001,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001619}},{{"门司令？你来做什么，你认识这个逃犯？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82102011001] = {82102011001,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001620}},{{"还叫我门司令呐？现在的司令可是你御夫老弟，我的好兄弟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82102011002] = {82102011002,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001621}},{{"好兄弟，这曹焱兵与我素有过节，今日他落马沦为逃犯，我正想趁此机会出一口恶气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82102011003] = {82102011003,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001622}},{{"不如你将他交给我，事后我会将他押送到你府上，人还是你抓的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82702011001] = {82702011001,14401000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001623}},{{"既然北落大哥这么说，那这人就交给你吧！\n紫薇、天市、太微，我们走！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83902011001] = {83902011001,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001624}},{{"多谢门大人解围。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84302011001] = {84302011001,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001625}},{{"谢谢白水儿吧，是她的铜镜感觉到血光之灾，我才知道你们在这里的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84302011002] = {84302011002,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001626}},{{"而且，别谢得太早，我有我的原则。\n我们较量一场吧，若你赢了我，就放你走，你输了，就跟我去羽林街报道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84602011001] = {84602011001,10100000008,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001627}},{{"乐意奉陪。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84902011001] = {84902011001,10100000007,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001628}},{{"又要打？真的没问题吗……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[85302011001] = {85302011001,11501000001,"","",{ct2},ct1,ct1,4,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001629}},{{"刚才的战斗让你很累了吧？为了公平起见，明天早上7点，你再到村口棚石外找我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011101] = {81002011101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001631}},{{"这里看起来很平静，就在这歇一晚吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011102] = {81002011102,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001632}},{{"喂，你们，也是旅行者吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81102011101] = {81102011101,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001633}},{{"那人在招呼我们，去听听他想说什么吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81102017401] = {81102017401,0,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003578}},{{"获得【旅行者的草鱼】"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[86102011001] = {86102011001,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001630}},{{"看来我们得找个安全的地方好好休息一晚，明天一定是一场恶战了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010703] = {81002010703,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000876}},{{"怎么样，曹焱兵，我的守护灵这么厉害，你对我不会再有什么质疑了吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010704] = {81002010704,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000877}},{{"我从来没质疑过你的守护灵，我担心的是你自身的实力。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010705] = {81002010705,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000878}},{{"哼。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010706] = {81002010706,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000879}},{{"守护灵？你们是镇魂将？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010707] = {81002010707,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000880}},{{"听明镜村的人说你走丢了，我们来帮忙找找。走，跟我们回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010708] = {81002010708,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000881}},{{"太好了！镇魂将大人，求求你们帮帮我，救救狗儿吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010709] = {81002010709,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000882}},{{"狗儿？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010710] = {81002010710,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000883}},{{"村里的人说走丢了两个小孩，狗儿应该就是另一个吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010711] = {81002010711,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000884}},{{"事不宜迟，有恶灵出没，那孩子不知道怎么样了。\n白水儿，你知道另一个小孩去哪了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010712] = {81002010712,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000885}},{{"我想狗儿一定躲进我们经常去玩的那个密道了！\n这里有个机关，只有打开机关才能进入密道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010901] = {81002010901,10100000013,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000888}},{ct71},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010902] = {81002010902,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000889}},{{"狗儿，你没事吧？\n怎么办，他好像失去意识了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010903] = {81002010903,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000890}},{{"气息很微弱，不知道能不能坚持到村子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002010904] = {81002010904,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100000891}},{{"总之，我先把灵力注入他的身体吧，应该能让他多坚持一段时间。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010901] = {82002010901,0,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000892}},{{"几个小时后"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010902] = {82002010902,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000893}},{{"婆婆，狗儿怎么样了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010903] = {82002010903,10100000064,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000894}},{{"放心，狗儿已经没有危险了。多亏了镇魂将大人为他注入灵力疗伤，他才恢复得这么快。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010904] = {82002010904,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000895}},{{"太好了……\n镇魂将大人，真不知道怎么感谢你们才好。没想到在荒郊野外遇到镇魂将大人，真是太幸运了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010905] = {82002010905,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000896}},{{"对了，这里周边这么荒芜，恶灵出没频繁，你们村子怎么会这么安宁啊？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010906] = {82002010906,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000897}},{{"我们村子能这样安宁，是因为有玉菩提的保佑。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010907] = {82002010907,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000898}},{{"玉菩提？！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010908] = {82002010908,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000899}},{{"怎么，有什么来历吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010909] = {82002010909,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{ct66,ct67},{ct68,ct69},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010910] = {82002010910,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000901}},{{"玉菩提和羲和神珠一样，具有划分空间的能力，只是范围比较小。\n这正是恶灵无法进入的原因。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010911] = {82002010911,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000902}},{{"嗯，我们不仅有玉菩提，还有门大人保护着我们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010912] = {82002010912,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000903}},{{"你是说羽林街的门司令？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010913] = {82002010913,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000904},{10100001535}},{{"那是以前啦！门大人为了大家可以过安居乐业的日子，主动放弃了司令的职位，带大家在这福佑之地建立了村子。"},{"在这险恶的镇魂街，能有这样平静的生活，大家都心存感激。不仅是对门大人，也为了菩提树下的神灵……啊，我是不是说太多了？"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010914] = {82002010914,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000905}},{{"我曾听闻过灵甲军头子果断敢为的传闻，却不知道他有这等悲悯之心。\n真想亲眼见见他。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010915] = {82002010915,0,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000906}},{{"这时，不远处传来一阵脚步声。接着村民之中响起一声声亲切的“门大人”的招呼声。\n一个身材魁梧的中年人走了过来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010916] = {82002010916,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000907}},{{"北落大人！欢迎回来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010917] = {82002010917,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000908}},{{"水儿，你们都没事吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010918] = {82002010918,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000909}},{{"没事，对不起，让你们担心了……对了，就是这几个哥哥姐姐救了我和狗儿。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010919] = {82002010919,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000910}},{{"我都听曹婆婆说了。真是太感谢了。我是明镜村的镇魂将北落师门。实在是失职，在这种时候有事赶不回村子……多亏你们在，水儿和狗儿那两个不懂事的孩子才安然无恙。不知道怎么感谢你们才好。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010920] = {82002010920,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000911}},{{"前辈客气了，救人是我们应该做的。\n我们走了很远的路，不知可否让我们在村子里借住两天。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010921] = {82002010921,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000912}},{{"当然可以，欢迎欢迎！我最喜欢你这样有勇知义的年轻人了。敢问阁下是哪条街道的镇魂将？下次我一定带上礼物，正式登门道谢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010922] = {82002010922,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000913}},{{"前辈客气，举手之劳罢了。我是罗刹街的镇魂将，名叫曹焱兵，这是我弟弟曹玄亮，我朋友夏铃。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010923] = {82002010923,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000914}},{{"北落师门突然严肃起来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010924] = {82002010924,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000915}},{{"哦，罗刹街的曹焱兵……小子，请你们离开这里吧，我就当你们没来过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010925] = {82002010925,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000916}},{{"什么情况……曹焱兵，你跟门大人有过节吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010926] = {82002010926,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000917}},{{"不，不过我收到了一份通缉令，下令捉拿毁坏神树的曹焱兵。\n按理说我应该逮捕你，不过看在你救了孩子的份上，我只当你没来过。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010927] = {82002010927,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct9,{{10100000918}},{{"什么？怎么会……哥哥明明是为了救神树……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002010928] = {82002010928,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000919}},{{"没办法，我们走吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011201] = {81002011201,10100001634,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000920}},{{"这种地方居然能遇见活人，真难得。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011202] = {81002011202,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000921}},{{"想用我的锅就用吧，煮点东西暖暖身子，不用客气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011203] = {81002011203,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000922}},{{"食物么，我身上的东西只够一个人吃了，想做饭的话，可以去瀑布边钓鱼，草丛里也有不少野菜，随意采吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013801] = {81002013801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100002140}},{{"我们还没找齐食材吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013802] = {81002013802,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002141}},{{"去找旅行者借下清单，看看还缺什么食材吧。"}},ct1,ct1,false,ct1,ct1,ct1,ct1,ct1},
	[81002011204] = {81002011204,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000923}},{{"我倒是想和这样的人较量较量，可惜时机不对。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011205] = {81002011205,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000924}},{{"嘘，你们听，好像有什么东西过来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011206] = {81002011206,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000925}},{{"走，我们过去看看。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011301] = {81002011301,0,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000926}},{{"<size=30><color=","ffffff>点击屏幕继续</color></size>"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88002011601] = {88002011601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100001635}},{{"哇，小亮，想不到你的厨艺这么好，真是人不可貌相。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81202011601] = {81202011601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct22,{{10100001636}},{{"哈哈，其实哥哥不在家的时候都是我负责做饭，孰能生巧罢了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82802011601] = {82802011601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct13,{{10100001637}},{{"真是的，也不知道到底谁是哥哥谁是弟弟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81502011601] = {81502011601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100001638}},{{"少啰嗦……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81702011601] = {81702011601,0,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001639}},{{"嬉笑间，三人平安地度过了一夜。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82602011601] = {82602011601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100001640}},{{"天快亮了，走吧，让我们去会会北落师门。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002011701] = {82002011701,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct21,{{10100001641}},{{"来了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002011702] = {82002011702,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100001642}},{{"我先声明，我不会因为你救过村里的孩子就对你放水。我会全力以赴，以打倒你为目标与你作战。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002011703] = {82002011703,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001643}},{{"我知道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002011704] = {82002011704,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct24,{{10100001644}},{{"很好，那么我们开始吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011302] = {81002011302,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct8},ct2,ct1,ct1,ct1,{{10100000927}},{{"抱歉，我被一种不祥的感觉扰乱了心境，主人，还请小心前进。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011601] = {81002011601,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000928}},{{"曹焱兵走到某个路口，正与一队人马迎面撞上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011602] = {81002011602,10100000050,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000929}},{{"大人，北落那家伙顽固又强硬，恐怕没那么容易从他手上拿到菩提果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011603] = {81002011603,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000930}},{{"灵域的人下令要寻找菩提果，而菩提树正巧在我的管辖区内，这是向上面邀功的好机会。记着，做成了，不仅是我，连你们也会跟着有好处。所以不论用什么手段都要拿到菩提果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011604] = {81002011604,10100000050,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000931}},{{"明白。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011605] = {81002011605,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100000932}},{{"*小声*那些人好像在讨论菩提果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011606] = {81002011606,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000933}},{{"看穿着，是羽林街的人没错了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011607] = {81002011607,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000934}},{{"羽林街的人是什么人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011608] = {81002011608,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000935}},{{"一些趋炎附势的走狗。不过，挺能吠的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011609] = {81002011609,10100000069,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000936}},{{"喂，前面是谁？看见羽林街的总司令不知道退让吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011610] = {81002011610,10100000050,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000937}},{{"等等，这家伙……应该是罗刹街的曹焱兵吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011611] = {81002011611,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct8},ct2,ct1,ct1,ct1,{{10100000938}},{{"一个通缉犯罢了，不用在他身上浪费时间。让灵甲军收拾他们，有更重要的事情等着我们去做。我们走！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011612] = {81002011612,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000939}},{{"南御夫一行人离开了，数量众多的灵甲军却将他们团团围住。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011613] = {81002011613,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000940}},{{"这、这数量也太多了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011801] = {81002011801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100000941}},{{"哇！这么多财宝，我们要发财啦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011802] = {81002011802,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001645}},{{"这趟旅程总算有点意思了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011901] = {81002011901,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000942}},{{"不错，你实力的确了得。曹焱兵，我很欣赏你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011902] = {81002011902,10100000008,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000943}},{{"怎么，你要认输？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011903] = {81002011903,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100001646}},{{"哼，你的样子总让我想起我年轻的时候。\n今天就到此为止吧，和老张喝茶的时间到了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011904] = {81002011904,10100000053,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001647}},{{"你的意思是？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011905] = {81002011905,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100001648}},{{"“北落师门在与曹焱兵战斗中失误，让逃犯曹焱兵趁机溜走”——听起来很顺耳。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011906] = {81002011906,10100000053,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100001649}},{{"太好了焱兵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011907] = {81002011907,10100000008,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100001650}},{{"嗯，可惜战斗还没有分出胜负，下次有机会见面，再和你较量。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002011908] = {81002011908,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100001651}},{ct61},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012001] = {81002012001,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000944}},{{"且慢，焱兵，别忘了我们在死魂塔学过的，关于五行相克的规律。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012002] = {81002012002,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000945}},{{"天地生风雷水火土五行属性，利用五行之间的克制关系，可以更有效地掌控战局。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012003] = {81002012003,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001670}},{{"我是水属性寄灵人，可以更有效地克制火属性灵体。让我为你助战吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012101] = {81002012101,12320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001656}},{{"曹当家，你可知道不同属性的角色搭配上阵，会获得出乎意料的效果呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012102] = {81002012102,12320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001657}},{{"所谓善用兵者，可以少敌多。\n布阵时请多多利用不同属性搭配的阵型规律，获得加成效果吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012201] = {81002012201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct10,{{10100000946}},{{"此路邪气四溢，前路的恶灵恐怕只会越发凶猛。\n以我们目前的人手应对，有些吃力啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012202] = {81002012202,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001659}},{{"哈哈哈哈哈！吾辈可以帮你！\n不过，我不接受比我弱小的主公！若想让我帮你，就与我一较高下吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012203] = {81002012203,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100001660}},{{"你是……潜伏在我内心深处的守护灵——典韦？\n好！我接受挑战！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012301] = {81002012301,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000947}},{{"我竟然在你身上看到了曹丞相的影子，莫非你真是能统一天下之人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012302] = {81002012302,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000948}},{{"有趣！有趣！就让我典韦再一次助你一臂之力吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012301] = {82002012301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct31},ct2,ct1,ct1,ct6,{{10100000949}},{{"哥哥你看，那一伙人跟那个大叔在一起。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012302] = {82002012302,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000950}},{{"南御夫？你怎么来了，还带了这么多人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012303] = {82002012303,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000951}},{{"听说门司令已经回来了，顺道来看看你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012304] = {82002012304,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000952}},{{"我已经不是司令了，只是一个普通的镇魂将罢了！还是客套了，南御夫，说吧，来是为了什么事？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012305] = {82002012305,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000953}},{{"还是北落大哥了解我。那么开门见山地说，灵域想要回收菩提果，还请你按规定上交菩提果。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012306] = {82002012306,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000954}},{{"老弟，你该知道，明镜村是靠菩提树的神力维持纯净的，正因为有菩提树的结界，村民们才不会变成恶灵。我们是曾经一同作战的好兄弟，你知道我绝对不可能放弃明镜村的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012307] = {82002012307,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000955}},{{"唔……兄弟一场，我知道北落大哥坚守的是什么。既然你不愿意，我也不会勉强你的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012308] = {82002012308,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct9,{{10100000956}},{{"哼，这家伙跟刚刚说的话完全不一样诶，我看他心里一定盘算着怎么把菩提果弄到手。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012309] = {82002012309,10100000069,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000957}},{{"有人？谁躲在那？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012310] = {82002012310,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100000958}},{{"糟了……说话太大声了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012311] = {82002012311,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000959}},{{"怎么会是你们？我的灵甲军呢？\n难不成……看来是我小看你了，曹焱兵。紫薇、天市、太微！你们一起把他拿下。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012312] = {82002012312,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000960}},{{"等等，老弟。曹焱兵这家伙，你就交给我吧。这个人与我有私人恩怨，既然在这里碰上，就让我来解决他吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012313] = {82002012313,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000961}},{{"大哥跟这个镇魂将有过节？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012314] = {82002012314,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000962}},{{"不错。怎么？你担心我赢不了他？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012315] = {82002012315,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100000963}},{{"怎么会！北落大哥这么说，我就放心了，以你的实力，赢他当然不在话下。\n那么菩提果的事，你再考虑考虑吧。我先告辞了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012316] = {82002012316,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000964}},{{"南御夫带领众人离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012317] = {82002012317,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000965}},{{"曹焱兵，我很欣赏你。可这次不能再这样轻易放你走了。\n刚才和南御夫所说的话并不假，我们必须打一场，你赢了就放你走。明天早晨七点，村外石棚旁的空地见。你会来吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012318] = {82002012318,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000966}},{{"当然，我可不会当缩头乌龟。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012401] = {81002012401,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000967}},{{"曹当家，你该知道，同一个寄灵人与不同守护灵搭档，能激活不同的合击技吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012402] = {81002012402,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000968}},{{"人的潜力是无穷的，这次战斗，就让我替代许褚，和你搭档作战吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012403] = {81002012403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000969}},{{"我不太确定，我想羽林街司令，一定不是泛泛之辈。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012404] = {81002012404,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000970}},{{"哈？？！！那你答应那么爽快干嘛。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012405] = {81002012405,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000971}},{{"现在只能这样了，如果想要借用菩提果，优先要做的是得到门司令的认同。\n哥哥一定也是这样考虑的，对吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012406] = {81002012406,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000972}},{{"啊，嗯……没错，就是这样。（其实什么都没想就答应了）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012501] = {81002012501,10100001658,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000973}},{{"吾辈只跟你到这里了，目前你的实力还不值得我为你效力。\n不过，你潜力无限，期待日后与你相见的那一天。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012502] = {81002012502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000974}},{{"不用担心。我不吃饭也能打十个。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012503] = {81002012503,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000975}},{{"嗯，很有精神。\n不过，嘴上说说可不算数，还是用拳头说话吧。\n出来吧，石明灵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012504] = {81002012504,10100000070,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100000976}},{{"嗯！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012505] = {81002012505,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000977}},{{"猴子？那就是北落的守护灵吗……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012601] = {81002012601,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000978}},{{"哟，焱兵，刚才我发现你出招吃力，有些力不从心呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012602] = {81002012602,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000979}},{{"也难怪，这些恶灵属火，与你属性相同，恐怕不好对付。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012603] = {81002012603,11320000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000980}},{{"我的怒气技有减速效果，或许能助你一臂之力。需要的话就让我来帮助你吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012604] = {81002012604,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000981}},{{"多谢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012605] = {81002012605,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000982}},{{"不客气，这是你自己争取来的自由，哈哈哈。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012606] = {81002012606,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000983}},{{"太棒了，曹焱兵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012607] = {81002012607,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000984}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012608] = {81002012608,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000985}},{{"谢谢你们。很高兴能认识你们这样热心正直的青年，你们路过明镜村救了水儿，又和我大战了一场，不打不相识，也算是一场缘分了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012609] = {81002012609,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000986}},{{"曹玄亮、曹焱兵和夏铃互相看了看，下定决心似的点了点头。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012610] = {81002012610,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100000987}},{{"北门大叔，我们也很高兴认识你，但其实，我们并不是偶然路过此地，而是专门找来的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012611] = {81002012611,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000988}},{{"哦？你们有事找我？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012612] = {81002012612,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000989}},{{"其实我们罗刹街被一帮名为“王国组织”的人入侵，灵槐神树才意外被毁灭。听说集齐龙桃、扶桑、帝榆三棵树的果实，就能复苏灵槐树，所以就找到这里来了。我想明镜村的“菩提树”就是传说中的“龙桃树”吧，而菩提果就是我们在找的龙桃的果实了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012613] = {81002012613,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000990}},{{"你们也想要菩提果？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012614] = {81002012614,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000991}},{{"只是借用。等灵槐树复原我们把它给你送回来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012615] = {81002012615,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000992}},{{"你们现在已经有另外两颗果实了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012616] = {81002012616,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000993}},{{"还没有……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012617] = {81002012617,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000994}},{{"唔，那可不行。我不能把菩提果给你，让你带着菩提果在冥界四处转悠。不过么，只要你有本事找到另外两颗，我就把菩提果借给你。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012618] = {81002012618,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000995}},{ct61},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012601] = {82002012601,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000996}},{{"曹焱兵，希望能看到你能活着回来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002012602] = {82002012602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000997}},{{"那是自然。\n我一定会回来的。到时候你可别反悔啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012601] = {83002012601,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct22,{{10100000998}},{{"后会有期，大叔！我们先走了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012602] = {83002012602,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000999}},{{"曹焱兵一行人离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012603] = {83002012603,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001000}},{{"想不到现在能见到这样年轻的豪杰，前途无量啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012604] = {83002012604,10100000033,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001001}},{{"呼……北落大人！北落大人……呼……不好了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012605] = {83002012605,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001002}},{{"阿贵？！你怎么了，怎么全身是伤？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012606] = {83002012606,10100000033,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001003}},{{"村里、村里出事了！南御夫想要我们的菩提果，派了两个手下来，见人就打，狗儿、王伯、明叔，他们都……明镜村已经变成一片火海了……我……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012607] = {83002012607,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001004}},{{"阿贵用尽最后一口气，倒在地上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002012608] = {83002012608,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001005}},{{"阿贵！阿贵！可恶……\n石灵明，我们赶快回村！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012701] = {81002012701,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001006}},{ct72},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012702] = {81002012702,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001007}},{{"第一关的谜语是……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012703] = {81002012703,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct26,{{10100001008}},{{"让我想想，第一关的谜语应该是……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012704] = {81002012704,10100000007,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001009}},{{"东风吹遍原野，但无言、红绿自纷纷。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012705] = {81002012705,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001010}},{{"谜语里依次出现<color=&c94252>“红”</color>、<color=&6c9a3b>“绿”</color>二字，那么按照顺序踩踏对应颜色的踏板试试吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[88002017201] = {88002017201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct22,{{10100002808}},{{"这下食材就齐了！我们用大铁锅做饭吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012706] = {81002012706,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct19,{{10100001011}},{{"唔，我太担心今早的战斗，急匆匆地赶出来……我们快回去取吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012707] = {81002012707,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001012}},{{"道路上留着一些凌乱的足迹，顺着足迹向前看，明镜村的老婆婆正躺在那里。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012708] = {81002012708,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100001013}},{{"是婆婆！她受了重伤。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012709] = {81002012709,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001014}},{{"婆婆，醒醒！啊……已经……断气了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012710] = {81002012710,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100001015}},{ct165},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012711] = {81002012711,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001016}},{{"看刀伤干脆利落，不像是恶灵干的，倒像训练有素的人下的手……我们赶快回明镜村吧，村子里一定出事了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012712] = {81002012712,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001017}},{{"你们看那边，是水儿！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012713] = {81002012713,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001018}},{ct71},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012714] = {81002012714,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100001019}},{{"她还有一口气！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002012715] = {81002012715,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001020}},{{"快去救门大人……救救爸爸，他为了救我，自愿被锁灵石锁上，带去羽林街了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
