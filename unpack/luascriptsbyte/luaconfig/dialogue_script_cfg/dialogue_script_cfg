	[81002034902] = {81002034902,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003863}},{{"云石闭上眼睛。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
