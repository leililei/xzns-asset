	[81000021211] = {81000021211,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct21,{{10100002577}},{{"也好，是时候离开这里了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
