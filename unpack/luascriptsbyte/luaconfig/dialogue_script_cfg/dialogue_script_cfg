	[82003020609] = {82003020609,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100001217}},{{"什么……这人救了我态度却这么凶，到底是敌是友啊？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
