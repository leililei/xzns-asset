	[81001016401] = {81001016401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000089}},{{"若得到与自己属性相同的神石，悉心供养，增益神石之力，自己和同伴的灵力也能与神石共鸣，获得增长。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
