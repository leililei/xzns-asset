	[81000010901] = {81000010901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/xialing_story_18"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100000123}},{{"这里究竟是什么地方？"}},{ct3},ct2,false,ct1,{"Images/Dialogue/bg_linghuaishuxia"},ct1,ct1,ct1},
	[81000010902] = {81000010902,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/ch_caoxuanliang_zoujinguimenguan"},ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100000124}},{{"姐姐，你闯进鬼门关了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010903] = {81000010903,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoxuanliang_story_12"},ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100000125}},{{"不过别担心，现在我们已经到了灵槐树附近。有我们在，恶灵是不敢靠近的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010904] = {81000010904,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/xialing_story_19"},ct1,0,0,1,0,{ct8},ct2,ct1,ct1,ct15,{{10100000126}},{{"原来，这种鬼地方也有阳光啊……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010908] = {81000010908,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000127}},{{"夏铃被巨大的灵槐树吸引，注视着神树。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010909] = {81000010909,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000128}},{{"在夏铃观察神树时，曹焱兵已将摩托车启动，发出隆隆声。"}},{ct3},ct2,false,ct1,{"Images/Dialogue/bg_shangche"},ct1,ct1,ct1},
	[81000010917] = {81000010917,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000129}},{{"夏铃靠近灵槐神树，慌乱的心情顷刻间安宁了下来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83000010901] = {83000010901,10100000053,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000130}},{{"这是怎么回事，为什么我一靠近这棵树，内心就这样宁静呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83000010902] = {83000010902,10100000007,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000131}},{{"因为它不是普通的树，而是由古神种下，拥有着不可思议力量的神树。\n它的神力通联镇魂街四方，为罗刹街罩起庇护之结界。有了它，恶灵的力量才得以抑制。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83000010903] = {83000010903,10100000053,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000132}},{{"真了不起，它看起来多沧桑啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83000010904] = {83000010904,10100000007,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000133},{10100001521}},{{"是啊，这棵树不知道守护了镇魂街多少年，我们家族也世世代代守护着它，你看树上挂的牌子，都刻着我们家族的人的名字。"},{"虽然现在只剩下我和哥哥两个人，但我们一定会好好守护它的。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84000010901] = {84000010901,10100000008,"","",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_36"},ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000134}},{{"笨女人，别傻愣着。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[84000010902] = {84000010902,10100000008,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100000135}},{{"上车吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[86000010901] = {86000010901,10100000053,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct1,{{10100000136}},{ct37},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[86000010902] = {86000010902,10100000053,"","",{ct4,{0,-74,0}},{"Audio/story/story/xialing_story_20"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000137}},{{"咦？去哪里？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010918] = {81000010918,10100000007,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100000138}},{{"去哪里？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010919] = {81000010919,10100000008,"","",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_37"},ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100000139}},{{"送你回去啊！难道你想一直呆在这个“鬼地方”？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010920] = {81000010920,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000140}},{{"一定是因为那个原因吧，结界对智商低于平均值的人免疫。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010921] = {81000010921,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000141}},{{"结界有这种设定吗？\n我觉得“为了隔离无情无义的人所以才有了结界”这种设定更说得通。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010922] = {81000010922,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000142}},{{"你这家伙脑子不太好使，嘴倒挺利的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010923] = {81000010923,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/xialing_story_15"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000143}},{{"这是死路吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct23},
	[81000010924] = {81000010924,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoxuanliang_story_09"},ct1,0,0,3,2,{ct4},ct2,ct1,ct1,ct1,{{10100000144}},{{"不，这是灵槐神树布下的结界，只有罗刹街的主人可以进入。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct20},
	[81000010925] = {81000010925,10100000001,"","",{ct2},{"Audio/story/story/caoxuanliang_story_10"},ct1,1,2,0,0,{ct4},ct2,ct1,ct1,ct1,{{10100000145}},{{"眼前被封锁的结界，需要以将军令验明身份才能通过，现在就要出示将军令进入安全区吗？"}},{ct3},ct2,false,{{90000000017}},ct1,{ct27},{{"810000114"}},ct1},
	[81000010926] = {81000010926,10100000001,"","",{ct2},{"Audio/story/story/caoxuanliang_story_11"},ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000146}},{{"那么，请亮出你的名字吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010927] = {81000010927,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000147},{10100001523}},{{"曹焱兵发动摩托车，载着夏铃和小亮穿梭于罗刹街的街道。"},{"转过最后一个宽敞的路口，摩托车渐渐停了下来。"}},{ct3,ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010928] = {81000010928,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000148}},{{"下车吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010929] = {81000010929,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100000149}},{{"已经到了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010930] = {81000010930,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000150}},{{"不，前面的路太窄了，骑车不太方便。我们得走一段。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000010931] = {81000010931,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100000151}},{{"这里看起来好阴森。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
