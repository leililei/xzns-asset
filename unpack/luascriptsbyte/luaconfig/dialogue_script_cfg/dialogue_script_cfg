	[81003025806] = {81003025806,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,1,{ct2},ct2,ct1,ct1,ct6,{{10100002655}},{{"是啊，况且那姑娘死后失去了生前的记忆，已经不记得你了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
