	[81000017310] = {81000017310,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002365}},{{"鬼符三通离开。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
