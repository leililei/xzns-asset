	[82003020605] = {82003020605,10100000002,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001213}},{{"哼，劣质的实验品。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003020606] = {82003020606,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001214}},{{"地面的蛛丝全部消失了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
