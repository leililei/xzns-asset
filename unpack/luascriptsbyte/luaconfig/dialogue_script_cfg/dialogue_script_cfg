	[81000014501] = {81000014501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/xialing_story_07-002"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001970}},{{"怎么样？你发现那些埋伏的恶灵了吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014502] = {81000014502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_11-001"},ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001971}},{{"他们躲在附近，但还未现身，真是沉得住气。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
