	[84002010701] = {84002010701,10100000003,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001570}},{{"到了，再往前面走就是明镜村了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
