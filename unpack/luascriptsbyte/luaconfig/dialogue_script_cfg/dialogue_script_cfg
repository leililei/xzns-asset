	[81000021001] = {81000021001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002557}},{{"众人终于在一片废墟处见到了南御夫。\n他一动不动地站立，似乎正在等他们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
