	[81003025301] = {81003025301,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct12,{{10100002613}},{{"竟敢在我家门口作恶，真是胆大妄为。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025302] = {81003025302,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002614}},{{"谢谢你们救了我。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025303] = {81003025303,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100002615}},{{"谁在说话？这里没有人呀。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025304] = {81003025304,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002616}},{{"我在地上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025305] = {81003025305,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002617}},{{"大家低头一看，地上站着一只乌鸦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025306] = {81003025306,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100002618}},{{"乌鸦居然会说话！难不成你就是梦山神器？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025307] = {81003025307,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002619}},{{"是的，我来自梦山，你们是这条街的镇魂将，想必是想带我回去吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025308] = {81003025308,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002620}},{{"但我此次出来，是因为有一件未了的心愿，请允许我做完这件事再将我带回。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025309] = {81003025309,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct10,{{10100002621}},{{"什么事？我们能帮上忙吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025310] = {81003025310,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002622}},{{"我来自人间的梦山，还在人间时，有个小女孩曾在我奄奄一息时救了我一命，我的灵魂才有机会修行成为神器。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025311] = {81003025311,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002623}},{{"前几日在灵域，我听说那女孩因为战乱被饿死，魂魄进入了罗刹街。所以才化身成乌鸦，飞来这里，想护她进入轮回之道。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025312] = {81003025312,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002624}},{{"你能帮我找到她吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025313] = {81003025313,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002625}},{{"既是我地盘的事情，我当然会帮忙。\n这里离集市很近，我们去打听打听吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026501] = {81003026501,10100002626,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002627}},{{"希望那姑娘没事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003025401] = {81003025401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100002628}},{{"集市上聚集了许多幽灵，我们在这打听打听吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026601] = {81003026601,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002629}},{{"多亏了镇魂将除掉了这条街的恶灵，我们才得以安居。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026701] = {81003026701,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002630}},{{"希望我能早点进入轮回，投胎成人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026901] = {81003026901,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002631}},{{"你问新来的幽灵？最近新来了七个幽灵，其中六个都是老年人，只有一个少女模样的幽灵，不过……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026902] = {81003026902,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100002632}},{{"她怎么了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026903] = {81003026903,10100000066,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100002633}},{{"她好像一到罗刹街就变成恶灵了，唉，可怜的孩子。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003026904] = {81003026904,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct11,{{10100002634}},{ct45},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
