	[81000017214] = {81000017214,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct29},ct2,ct1,ct1,ct13,{{10100002345}},{{"虽然事先没和你们商量过，抱歉，我有时候是有点冲动，嘿嘿。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017215] = {81000017215,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100002346}},{{"（真令人吃惊，武器被夺走的一瞬间的反应，竟然能这样迅速。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017216] = {81000017216,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002347}},{{"（更令人吃惊的，是她毫不顾虑自身安危，只考虑解决问题的态度。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017217] = {81000017217,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100002348}},{{"（以及对自己守护灵无条件信任的心态。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017218] = {81000017218,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct14,{{10100002349}},{{"（这家伙，说不定有极高的战斗天赋……不，应该说她是天生的寄灵人。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017219] = {81000017219,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100002350}},{{"（这也是李轩辕这样强的守护灵会对她如此忠诚的原因吧。）"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017220] = {81000017220,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100002351}},{{"焱兵，你怎么了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017221] = {81000017221,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct10,{{10100002352}},{{"唔，没事……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017222] = {81000017222,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002353}},{{"该说抱歉的人是我，是我误以为对方已经失去意识，才掉以轻心，让武器被夺去的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017223] = {81000017223,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct10,{{10100002354}},{{"错误在我，今后还要更加谨慎才是。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017224] = {81000017224,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100002355}},{{"总而言之，大家小心一点，离山脚越来越近了，大家加快脚步吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017301] = {81000017301,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002356}},{{"曹焱兵回到罗刹街山脚下，鬼符三通正在此等候。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017302] = {81000017302,10100000015,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct18,{{10100002357}},{{"哟，曹当家的，清理蜘蛛还顺利吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
