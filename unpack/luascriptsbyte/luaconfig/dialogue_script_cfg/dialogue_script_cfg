	[82002037304] = {82002037304,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct6,{{10100003537}},{{"这种时候还逞能。告诉你，我可不止为你，就算是为了自己，也要杀了这家伙！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002037305] = {82002037305,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct9,{{10100003538}},{{"这种忘恩负义，口慈心狠的人，为了私欲屠杀整个村子的人，人人得而诛之！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81001015001] = {81001015001,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100000075}},{{"一个阶段的战斗结束，可以获得丰厚的回报哦！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
