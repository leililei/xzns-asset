	[81000017605] = {81000017605,10100000017,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct9,{{10100002388}},{{"好大的口气！罗刹街镇魂将曹焱兵不在，你可阻挡得了我？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000017606] = {81000017606,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100002389}},{{"谁说我不在的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
