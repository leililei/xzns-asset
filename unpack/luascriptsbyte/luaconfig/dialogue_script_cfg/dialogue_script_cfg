	[81002031607] = {81002031607,10100003070,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003691}},{{"阿良向曹焱兵和夏铃讲出了事情的原委。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031608] = {81002031608,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct11,{{10100003692}},{{"原来你家人都变成恶灵被驱逐出村子了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031609] = {81002031609,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003693}},{{"是的，当时我哥哥和姐姐还保留着清醒的意识，村子里的人竟然就将他们二人赶了出去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031610] = {81002031610,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct7,{{10100003694}},{{"所以你把他们留在暗道里，随时出来照顾他们？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031611] = {81002031611,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct9,{{10100003695}},{{"愚蠢。刚变成恶灵时，幽灵的确会保留一部分正常意识。但随着怨念的恶化，它们现在已经是只知道吃人的恶灵了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031612] = {81002031612,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003696}},{{"对于没有灵力的普通幽灵来说，离恶灵这么近是很危险的！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031613] = {81002031613,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100003697}},{{"但是……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031614] = {81002031614,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct11,{{10100003698}},{{"失去亲人的痛苦我能理解，但别忘了，世界上还有担心你的人。以后别再做这样的事了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031615] = {81002031615,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct8},ct2,ct1,ct1,ct6,{{10100003699}},{{"和你姐姐道别吧。\n至于你指使恶灵一事，我这次就当没看见，好好去你舅舅家反省吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031616] = {81002031616,10100003070,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003700}},{{"曹焱兵举起十殿阎罗。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031617] = {81002031617,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003701}},{{"呜呜呜……对不起，哥哥、姐姐……我还是不能保护大家。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031618] = {81002031618,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct1,{{10100003702}},{{"我会在舅舅家附近为你们立碑，若有朝一日你们的魂魄能回来，就来石碑处找我，我们约好了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031701] = {81002031701,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003703}},{{"对不起，哥哥、姐姐……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031901] = {81002031901,10100000011,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003706}},{{"今天从村子里搜刮到不少东西，回去老大一定很高兴。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
