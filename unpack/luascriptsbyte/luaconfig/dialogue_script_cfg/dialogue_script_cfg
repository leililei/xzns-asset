	[81003020604] = {81003020604,10100000029,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001207}},{{"在我的蛛网里，越挣扎，丝线就会缠得越紧。你已经无路可逃了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
