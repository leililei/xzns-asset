	[81000023903] = {81000023903,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct6,{{10100003485}},{{"你们走吧，我输了。\n我会履行承诺，灵甲军的事就由我来搞定。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
