	[81000014510] = {81000014510,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct7,{{10100003173}},{{"在上面！有人从上面掉下来了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014511] = {81000014511,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003174}},{{"曹焱兵反应迅速，起步跳跃接住了从楼顶坠落的幽灵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014512] = {81000014512,10100003169,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/role/shibing_hou"},ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003175}},{{"哼哼，身手不错，有资格做我的对手。\n就让我亲手结果你的性命吧！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014601] = {81000014601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_13"},ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001978}},{{"真狡猾，连我也差点就中了他们的埋伏。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014602] = {81000014602,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,0,{ct2},ct2,ct1,ct1,ct10,{{10100001979}},{{"嗯？刚刚那个亡灵呢？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014603] = {81000014603,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001980}},{{"他逃跑了。可能怕你报复吧，毕竟是他给敌人带的路。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014604] = {81000014604,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct14,{{10100001981}},{{"附近恶灵遍布，那罗刹街的亡灵就这样离开，不知道会不会遇上危险。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014605] = {81000014605,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100001982}},{{"那人为敌人带路来杀你，你反而担心他的安危？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014606] = {81000014606,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100001983}},{{"保护亡灵是镇魂将的职责，何况他是被胁迫才做出这种事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000014607] = {81000014607,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct8},ct2,ct1,ct1,ct1,{{10100001984}},{{"在冥界，这种事情并不少见。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
