	[82000014406] = {82000014406,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002821}},{{"曹焱兵表情戒备观察四周。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014407] = {82000014407,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},{"Audio/story/story/caoyanbing_story_10"},ct1,0,0,3,0,{ct2},ct2,ct1,ct1,{"huangu_1"},{{10100002822}},{{"离我们不远的地方，有人隐藏了自己的气息，但我还是能感觉到微弱的灵力——有埋伏！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82000014408] = {82000014408,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct7,{{10100002823}},{{"什么？对方很厉害吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
