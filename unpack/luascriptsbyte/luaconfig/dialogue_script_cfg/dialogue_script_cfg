	[81002032001] = {81002032001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003710}},{{"恶灵被尽数消灭。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
