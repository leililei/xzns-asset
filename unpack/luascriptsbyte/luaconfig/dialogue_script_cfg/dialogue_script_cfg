	[81000010933] = {81000010933,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100000153}},{{"为什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
