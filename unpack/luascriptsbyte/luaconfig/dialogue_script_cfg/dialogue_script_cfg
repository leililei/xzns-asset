	[81000017601] = {81000017601,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100002384}},{{"与此同时，罗刹街灵槐树旁，小亮和夏铃正面对一名难缠的敌人。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
