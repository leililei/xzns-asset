	[81000022913] = {81000022913,16003000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003396}},{{"谢谢大哥哥，我们没事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000022914] = {81000022914,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100003397}},{{"看样子附近常有恶灵出没，你们住在哪里？我们送你回去吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000022915] = {81000022915,16003000001,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct34,{{10100003398}},{{"那太谢谢你们了！我住在明镜村，一个有点隐蔽的村子。我带你们过去吧，大家见到你们一定会很高兴的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023001] = {81000023001,0,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003399}},{{"曹焱兵一行人跟着白水儿走进密林深处，穿过一只石碑来到明镜村。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
