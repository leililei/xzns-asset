	[81002031604] = {81002031604,10100003070,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100003688}},{{"阿良突然扑过来，挡在恶灵身前。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002031605] = {81002031605,10100003705,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct1,{{10100003689}},{{"不要伤害他，他是……我的姐姐……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
