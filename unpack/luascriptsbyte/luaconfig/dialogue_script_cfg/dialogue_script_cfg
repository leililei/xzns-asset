	[81002029301] = {81002029301,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100003604}},{{"焱兵，你的手？！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
