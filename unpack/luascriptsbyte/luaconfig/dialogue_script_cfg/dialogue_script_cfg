	[81002013302] = {81002013302,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001037}},{{"看，门司令被锁在大殿上！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013401] = {81002013401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct7,{{10100001038}},{{"是<color=&48bce7>聚灵石像</color>！\n要是受伤了的话，一定要用<color=&48bce7>聚灵石像</color>治愈伤势，不能逞强哦。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013501] = {81002013501,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001039}},{{"大殿门廊前，北落师门被锁灵石紧紧锁住。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013502] = {81002013502,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001040}},{{"真是没完没了，快把门司令交出来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013503] = {81002013503,10100000047,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001041}},{{"想从这里过去没那么容易。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013601] = {81002013601,10100000047,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001042}},{{"可恶，手臂已经不能动弹了……你们要的钥匙我留下了。先走一步了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013602] = {81002013602,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001043}},{{"他要逃跑了，要追吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013603] = {81002013603,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001044}},{{"救人要紧，不用管那家伙了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013701] = {81002013701,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001045}},{{"双手拷着锁灵石，既无法召唤守护灵，也无法施展灵力，北落师门颓废地瘫坐在地上。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013702] = {81002013702,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001046}},{{"南御夫，我们兄弟一场，你为什么做出这种事，我们有什么仇吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013703] = {81002013703,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001047}},{{"仇恨？没有的事，你是我曾经的导师、战友、上司，哪里有什么仇恨。只是你太碍事了。明明顺从灵域，交出菩提果，就能平安无事。你偏偏要顾虑那些没用的幽灵，真是可笑。本来，你若交出菩提果，等我向上面汇报的时候，也会帮你美言几句，可惜了。还好有那个叫曹焱兵的小鬼来捣乱，如果不是他把你引开，离开村子，我恐怕也没那么容易得手。\n呵呵，仔细一看，这颗菩提果可真美啊。我的前途全靠它了哈哈哈。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013704] = {81002013704,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001048}},{{"就为了这个？就为了你自己的名利，你就下令残害了村子里的人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013705] = {81002013705,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001049}},{{"谁叫他们阻止我，阻碍我前进的人，都是我的敌人。况且那些不是人，门司令，只是幽灵罢了，他们早就不在啦。\n呵呵，从我认识你开始，你就是这样迂腐，这么多年还真没有变过啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013706] = {81002013706,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001050}},{{"呵，到头来，是我自己看错了你……南御夫，你一心想往上爬，但看在这么多年交情的份上，拜托你一件事，那就是求你放过我女儿……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013707] = {81002013707,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001051}},{{"等一下！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013708] = {81002013708,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001052}},{{"曹焱兵？！这么说，我的三员大将都已经……你究竟是何方神圣？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013709] = {81002013709,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001053}},{{"喂，大叔！你脑子没问题吧？为何明明被骗子骗了，还要拜托骗子？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013710] = {81002013710,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001054}},{{"没错，北落大叔，南御夫就是个满心只有名和利的小人，自己珍视的东西，应该自己牢牢抓在手里啊！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013711] = {81002013711,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001055}},{{"是你们……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013712] = {81002013712,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001056}},{{"刚刚我们折返村子的时候，看见水儿也被一起攻击了，如果再晚一步……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013713] = {81002013713,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001057}},{{"水儿受伤了？她现在怎么样了？没事吧？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013714] = {81002013714,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001058}},{{"她……还有一口气，等着我们带你回去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013715] = {81002013715,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001059}},{{"南御夫，你这个混蛋！可恶……力量被封印住了，使不出来……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013716] = {81002013716,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001060}},{{"走吧，大叔，用你自己的手来保护她！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013717] = {81002013717,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001061}},{{"用太微给的钥匙插入锁灵石的插孔，锁灵石碎裂掉落。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013718] = {81002013718,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001062}},{{"现在，我来慢慢跟你算账，南御夫。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002013719] = {81002013719,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001063}},{{"可恶……所有人听令！把这三个人抓住，一个都不要放走！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070101] = {81002070101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001064}},{{"可恶，我们成了他们的目标，所有人都往我们这过来了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070102] = {81002070102,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001065}},{{"来得正好，一腔怒气正好没地方发泄呢。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070101] = {82002070101,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001066}},{{"北落师门一声怒吼，石灵明腾空飞出，猛地一挥铁棒，一片灵甲军应声倒地。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070102] = {82002070102,10100000032,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001067}},{{"哇……是门司令的守护灵石灵明！快逃！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070103] = {82002070103,10100000043,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct16,ct1,ct1,{{10100001068}},{{"呀呀呀呀呀！你们这群忘恩负义的家伙，一个都别想逃！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070201] = {81002070201,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001069}},{{"这条路有机关，跟我来！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070301] = {81002070301,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001070}},{{"打开这个机关，就可以从刚刚的路通过了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070401] = {81002070401,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001071}},{{"糟糕，怎么这么快就追上来了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070402] = {81002070402,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001072}},{{"曹当家的！在这天下，别以为你就是霸王！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070403] = {81002070403,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001073}},{{"你是何人？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070404] = {81002070404,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001074}},{{"这里也不是你的许都，而是我的鸿门宴。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070405] = {81002070405,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001075}},{{"项昆仑……群英殿的老大……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070406] = {81002070406,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001076}},{{"哈哈哈哈，你们通通都完了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070407] = {81002070407,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001077}},{{"我们能打败这么强的人吗……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070408] = {81002070408,10100000055,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001078}},{{"别误会，我只是来这边看看有什么骚动，没想到不过是些不入流的寄灵人。只有那个武神躯还有点意思。不过今天我没空跟你们缠斗，虞子期，你来跟他们较量较量。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070409] = {81002070409,10100000068,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001079}},{{"是！主公！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070401] = {82002070401,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100001080}},{{"等等！来了就别想跑！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070402] = {82002070402,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001081}},{{"曹焱兵紧握十殿阎罗向项昆仑攻去，不过三四招的功夫，就被项昆仑掀翻在地。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070403] = {82002070403,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001082}},{{"曹焱兵！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070404] = {82002070404,10100000055,"","",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001083}},{{"曹焱兵，你现在还太嫩。我更期待未来的你。后会有期了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002070405] = {82002070405,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001084}},{{"项昆仑离开了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070501] = {81002070501,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001085}},{{"咦，南御夫去哪了？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002070502] = {81002070502,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001086}},{{"一定乘乱去拿他的玄黄丹了，我们得尽快追上他。一旦他吃下玄黄丹，化身为噬日，事情就麻烦了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080601] = {81002080601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001087}},{{"李轩辕，你能感觉到南御夫的气息吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080602] = {81002080602,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001088}},{{"唔……我感觉到一种奇怪的感觉，一种灵力与邪气纠葛在一起的感觉……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080603] = {81002080603,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001089}},{{"搞不好南御夫已经拿到玄黄丹开始兽化了，我们得抓紧时间，在他完全化身为噬日前找到他。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080701] = {81002080701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001090}},{{"唔，房间被锁住了，附近应该有机关可以开启。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080801] = {81002080801,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001091}},{{"是机关，没记错的话，前面被锁住的路可以用它开启。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080901] = {81002080901,10100000001,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001092}},{ct46},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080902] = {81002080902,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001093}},{ct63},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002080903] = {81002080903,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001094}},{{"是噬日……南御夫变身成功了。没办法，只能战斗了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081001] = {81002081001,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001095}},{{"经过噬日一战，羽林街已全军覆没。曹焱兵一行人折返明镜村。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081002] = {81002081002,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001096}},{{"我们到明镜村了，大叔，水儿就在这里。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081003] = {81002081003,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001097}},{{"李轩辕轻轻解开围绕在水儿身边的结界，水儿面色苍白，就像树梢上快要融化的雪一样。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081004] = {81002081004,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001098}},{{"她看上去快不行了，似乎灵魂马上要消散了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081005] = {81002081005,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001099}},{{"抱歉，我已经尽力了，可水儿的灵体实在太虚弱……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081006] = {81002081006,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001100}},{{"别说了……门司令一定很难过，让他们单独呆一会儿吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081007] = {81002081007,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001101}},{{"呜呜……水儿……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081008] = {81002081008,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001102}},{{"北落师门抱起重伤的水儿。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081009] = {81002081009,10100000003,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001103}},{{"爸……爸……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081010] = {81002081010,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001104}},{{"刚才你叫我什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081011] = {81002081011,10100000003,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001105}},{{"爸爸……我已经全部想起来了，关于我生前的事，还有你是我父亲的事。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081012] = {81002081012,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001106}},{{"水儿……我是个不称职的父亲，你恨我吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081013] = {81002081013,10100000003,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001107}},{{"活着的时候我经常埋怨爸爸，怪你不能总是陪伴在我身边。可现在才明白你是个了不起的人。\n我很幸运，能成为爸爸的女儿。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081014] = {81002081014,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001108}},{{"水儿……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081015] = {81002081015,10100000003,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001109}},{{"真希望能一直做爸爸的女儿啊……可惜我已经看不见了……啊，身体变得轻飘飘的……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081001] = {82002081001,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001110}},{{"水儿的灵魂开始变成碎片，随风而起。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081002] = {82002081002,10100000004,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001111}},{{"水儿……不……不要消失得那么快！\n呜呜，是爸爸对不起你！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081003] = {82002081003,10100000003,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001112}},{{"爸爸，你怎么哭了……不准哭呀！不然水儿也会难过的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081004] = {82002081004,10100000004,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001113}},{{"呜呜，爸爸不哭……不再哭了……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081005] = {82002081005,10100000003,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001114}},{{"爸爸，你要连同水儿的份一起活下去，好好活着……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081006] = {82002081006,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001115}},{{"水儿的声音越来越小，好像是从遥远的地方传来。\n接着，躯体随着声音一同消失在夜空中。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82002081007] = {82002081007,10100000004,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001116}},{{"爸爸答应你……一定……好好活下去。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081001] = {83002081001,10100000001,"","",{ct2},ct1,ct1,2,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001117}},{ct160},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081002] = {83002081002,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001118}},{{"早啊，夏铃姐姐。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081003] = {83002081003,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001119}},{{"早啊，小亮。\n咦，门司令出来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081004] = {83002081004,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001120}},{{"看上去好憔悴啊……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081005] = {83002081005,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001121}},{{"门司令，我能带走这颗菩提珠吗？等灵槐树复原之时，一定将他还回来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081006] = {83002081006,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001122}},{{"拿走吧，它对我来说已经没有意义了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081007] = {83002081007,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001123}},{ct25},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081008] = {83002081008,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001124}},{{"大叔，明镜村已经不存在了，我们打算周游冥界，寻找剩下的神珠。你要同我们一起吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[83002081009] = {83002081009,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001125}},{{"明镜村是为弥补生前对水儿亏欠而建，如今村子没了，我也再没有牵挂。走吧，我答应水儿要好好活下去，这一次，不能再让她失望了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081101] = {81002081101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001126}},{{"希望能顺利拿到神珠，这样灵槐树就有救了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081201] = {81002081201,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001127}},{{"好一个世外桃源。哥哥，等我们救了灵槐树，也把罗刹街变成这样的安居之所吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081301] = {81002081301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001128}},{{"果然，就算是这样的世外桃源，也免不了为要恶灵发愁。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081401] = {81002081401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001129}},{{"你们去吧，我留在这里多打听打听消息。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081501] = {81002081501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001130}},{{"小亮，你一个人在这里，真的没问题吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081601] = {81002081601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct6,{{10100001131}},{{"对这里的幽灵来说，我们是外来人，还是一起行动比较好。\n走吧小亮，我们去找找那两个小孩。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081701] = {81002081701,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001132}},{{"恕不能久留，不送了，火将军曹焱兵。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081801] = {81002081801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001133}},{{"我明白了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002081901] = {81002081901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct9,{{10100001134}},{{"这帮家伙居心不良，我们得快点告诉北落大叔！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082001] = {81002082001,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001135}},{{"你说得没错，夏铃，这件事要尽快通知北落大叔才行，我们赶紧跟上他们吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082101] = {81002082101,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001136}},{{"曹焱兵，别忘了我们的约定啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082201] = {81002082201,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001137}},{{"我一定按时赴约。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082301] = {81002082301,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001138}},{{"哥哥，我好像有什么东西落在村子里了……我们回去取吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082401] = {81002082401,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001139}},{{"奇怪，我感觉村子里的气氛有些不对劲？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082501] = {81002082501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001140}},{{"羽林街人马众多，我们循着足迹，应该就能找到。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082601] = {81002082601,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001141}},{{"嗯，我们循着足迹去羽林街吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082701] = {81002082701,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001142}},{{"羽林街的走狗，实力也不过如此。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082801] = {81002082801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001143}},{{"没时间休息了，我们赶快继续前进吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002082901] = {81002082901,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001144}},{{"希望北落大叔平安无事……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083001] = {81002083001,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001145}},{{"他一定会没事的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083101] = {81002083101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001146}},{{"你们看，四面八方涌过来好多援兵，看来得先解决他们才行。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083201] = {81002083201,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001147}},{{"都是些杂碎罢了，看我碾碎他们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083301] = {81002083301,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001148}},{{"项昆仑并未现出真身，仅仅投影就有此等功力，所幸那人没把我们放在眼里……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083401] = {81002083401,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001149}},{{"算了，现在要紧的是找到南御夫，那家伙实在太可恶了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083501] = {81002083501,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct47,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001150}},{ct138},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083502] = {81002083502,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001151}},{{"水儿呢……快带我去找水儿！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083601] = {81002083601,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001152}},{{"我们把水儿藏在村子里安全的地方，跟我来，门司令。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083701] = {81002083701,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001153}},{{"曹焱兵，从今往后，再也没有世外桃源了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81002083801] = {81002083801,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,1,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001154}},{{"门将军，总有一天我们会再建一个新桃源，等着吧。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010101] = {81003010101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001155}},{{"哇呀，那些怪物追得好紧！曹焱兵这家伙，说去森林探路就没消息了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010102] = {81003010102,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001156}},{{"放心吧，那家伙命硬着呢！不会出事的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010103] = {81003010103,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001157}},{{"我哪里是担心他，我是担心这儿人手不够……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010104] = {81003010104,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001158}},{{"夏铃和北落师门乘坐幻化出的巨石龟拼命奔驰，身后乌泱泱一片的怪物，正紧紧追赶着他们。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010105] = {81003010105,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001159}},{{"啊啊啊，真是的，为什么非要来这种地方不可。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010106] = {81003010106,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001160}},{{"主人，不如我们也进入森林。森林视野狭窄，道路复杂，或许能制约这些常于草原出没的怪兽，变被动为主动。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010107] = {81003010107,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct13,{{10100001161}},{{"是个好方法，冲吧！巨石龟，往这边！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010201] = {81003010201,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001162}},{{"大家当心，这里路线错综复杂，千万不要走散了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010204] = {81003010204,10100000052,"","",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct8},ct2,ct1,ct1,ct1,{{10100001163}},{{"嘶嘶嘶——"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010205] = {81003010205,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001164}},{{"来东西了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010401] = {81003010401,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001165}},{{"这种深山老林也有机关竟然也藏着机关，会不会有人住在这里？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010402] = {81003010402,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001166}},{{"唔，谁会住在禁地呢……难道有人看守？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010501] = {81003010501,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001167}},{{"道路被封印锁住了，恐怕我们得找找机关才能解开它。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010601] = {81003010601,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001168}},{{"诶，禁地里也有聚灵石像吗？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010602] = {81003010602,10100000031,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001169}},{{"聚灵石像是汇聚亡灵之气天然形成的，只要有亡灵在的地方自然会有聚灵石像。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010701] = {82003010701,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001170}},{{"有人跑了过来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,{"1","2","ef_chat_da","1","420","0","1"}},
	[82003010702] = {82003010702,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001171}},{{"你们来这地方做什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010703] = {82003010703,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001172}},{{"曹焱兵！当然是找你啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010704] = {82003010704,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001173}},{{"你们当心，这里怪怪的——果然！又是巨蜥。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010801] = {81003010801,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001174}},{{"这些蜥蜴就是守护禁地的侍卫么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010802] = {81003010802,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct6,{{10100001175}},{{"不清楚，不过我发现这里的每只蜥蜴脚底都写着编号，这种事不像神明所为。\n曹焱兵，这么危险地方，你到底想来查什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010803] = {81003010803,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001176}},{{"我来是因为听说空神之森里有一座名叫芦花古楼的遗迹，我们要找的神珠或许也在其中。\n真是的，本来想留几个人在外面有个照应，没想到你们都冲进来了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010804] = {81003010804,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001177}},{{"可现在看来，敌在暗我在明，要找芦花古楼果然没那么容易……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003010805] = {81003010805,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001178}},{{"走吧，我们得赶在蜥蜴怪的头目发现我们之前找到它。但愿这个险值得我们去冒。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010801] = {82003010801,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001179}},{{"森林深处，一座阶梯状建筑发出森森的寒气。\n建筑物地下的地下室摆满玻璃器皿，各种野生蜥蜴泡在储存液中。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010802] = {82003010802,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001180}},{{"呵呵呵，太棒了！我花了半年研制出的灵海测量仪终于完成了，这是我的又一杰作。你看，红莲，它多美啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010803] = {82003010803,10100000018,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001181}},{{"我不是来参观你无聊的新发明和改造蜥蜴的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010804] = {82003010804,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct8},ct2,ct1,ct1,ct1,{{10100001182}},{{"别急，如果你要找的叫曹焱兵的家伙真的会来这里，那么我的探测仪一定能将他探测出来。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010805] = {82003010805,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001183}},{{"吉拉按下开关，探测仪转动指针，发出“哔哔哔”的声音。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010806] = {82003010806,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001184}},{{"你看，这里有5个灵海值出现在范围内了，其中一定有你想找的人。\n等等，怎么全都是灵海值40万以上的高手？那样强的守护灵改造过后会是什么样呢？\n呵呵，突然兴奋起来了呢。红莲，你可不要插手，空神之森是我的地盘，森林里的人，理应由我来处理。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010807] = {82003010807,10100000018,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001185}},{{"我不想与你为此争执，浪费时间。\n 国王的任务是追击曹焱兵，只要你能带回他的遗体，我就没意见。不过，你要是误了我的事……"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010808] = {82003010808,10100000023,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001186}},{{"少瞧不起人，红莲，我和你一样，也是王国十骑士之一。别以为你在国王身边就高人一等。\n我一定会带回他的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[82003010809] = {82003010809,10100000018,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001187}},{{"你最好可以。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020101] = {81003020101,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001188}},{{"咦，有什么花的气味，好香呀。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020102] = {81003020102,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001189}},{{"怎么突然起雾了，不太对劲。大家注意别走散了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020201] = {81003020201,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001190}},{{"迷雾中出现一个女人的身影。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020202] = {81003020202,10100000002,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001191}},{{"曹焱兵，是你吗？我的儿子？你、你千万别过来——啊——"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020203] = {81003020203,10100000008,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001192}},{{"是……母亲？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020204] = {81003020204,10100000007,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct8},ct2,ct1,ct1,ct1,{{10100001193}},{{"什么？哥哥，别跑，等等我！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020205] = {81003020205,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001194}},{{"曹焱兵和小亮向女人消失的方向跑去，消失在雾中。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020206] = {81003020206,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001195}},{{"喂，曹焱兵，回来！那是幻象！\n真是的，夏铃，你千万别再走散了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020301] = {81003020301,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001196}},{{"迷雾中出现一男一女两个人的身影。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020302] = {81003020302,10100000034,"","",{ct2},ct1,ct1,0,0,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001197}},{{"智美，忘了北落师门吧，我会给你幸福的。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020303] = {81003020303,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001198}},{{"那是……我前妻！喂，等等我，这么多年你跑哪里去了！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020304] = {81003020304,10100000001,"","",{ct2},ct1,ct1,0,2,0,0,{ct2},ct2,ct1,ct1,ct1,{{10100001199}},{{"北落师门跑入迷雾，消失了。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020305] = {81003020305,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct7,{{10100001200}},{{"北落大叔！\n真是的！一个靠得住的都没有。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020401] = {81003020401,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100001201}},{{"事到如今还是得靠自己了。李轩辕，我们上！"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020501] = {81003020501,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct1,{{10100001202}},{{"奇怪，脚下怎么黏黏的……地下这些白色的丝线是什么啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81003020502] = {81003020502,10100000029,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,2,{ct2},ct2,ct1,ct1,ct1,{{10100001203}},{{"呵呵，没有猎物能走出我精心布下的蛛网。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
