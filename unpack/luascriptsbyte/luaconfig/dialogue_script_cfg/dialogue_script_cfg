	[81000023210] = {81000023210,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,2,1,{ct2},ct2,ct1,ct1,ct1,{{10100003431}},{{"北落……门司令？你来做什么？"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023211] = {81000023211,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,2,{ct2},ct2,ct1,ct1,ct13,{{10100003432}},{{"在我的地盘上可不准随便乱来啊。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023212] = {81000023212,10100000035,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct1,{{10100003433}},{{"这是西区逃犯曹焱兵，我要将他捉拿归案。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
	[81000023213] = {81000023213,10100000004,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,1,0,{ct2},ct2,ct1,ct1,ct6,{{10100003434}},{{"曹焱兵的事，我会用我一贯的方式解决。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
