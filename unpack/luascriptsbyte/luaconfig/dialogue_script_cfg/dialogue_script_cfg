	[81002032004] = {81002032004,10100000053,"","WX_Role/Animation/Xierwanasi/prf_xierwanasi_ui",{ct4,{0,-74,0}},ct1,ct1,0,0,3,0,{ct2},ct2,ct1,ct1,ct6,{{10100003713}},{{"走，我们去看看有些什么。"}},{ct3},ct2,false,ct1,ct1,ct1,ct1,ct1},
