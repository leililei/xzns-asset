------重置游戏，返回登录
---@param 变量名 变量类型 中文描述
---@return 变量类型 中文描述
------重置游戏，返回登录

function GameMain:ResetGame()
    -- _G.CSLauncher:ShowUI(true)

    _G.LoginManager:GetInstance().GotoMainFinish = false
    _G.ServerManager:GetInstance().canClick = true
    _G.ServerManager:GetInstance().isInitSuccess = false

    _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)

    _G.Events:GetInstance():Broadcast(_G.GlobalEvents.GlobalResetGame)

    _G.Net.CloseAllConnects()

    -- _G.CSXLuaManager:StopLuaEnv()

    --清理静态委托
    -- self:ClearCallCS()

    --单独优先处理
    -- _G.TimerManager:GetInstance():Dispose()
    -- _G.Events:GetInstance():Dispose()

    -- require("SDKManager"):GetInstance():Dispose()
    _G.UIManager:GetInstance():CloseAllWindows()
    _G.WorldManager:GetInstance():ExitCurrentWorld()
    _G.WorldManager:GetInstance():ClearCache()
    --- 关闭视频CG
    _G.UIUtils.CloseVideo()
    _G.BattleManager:GetInstance():DestroyBattle()
    ---部分委托要在清除主世界之后才能置空(比如AI行为树的，否则某些世界对象的委托绑定无法正常清理)
    -- self:ClearCallCSAfterExitWorld()

    _G.SDKManager:GetInstance():Reset()

    --统一处理
    _G.Singleton.ALLDispose()
    _G.Component.ALLDispose()
    _G.LogicClass.ALLDispose()
    _G.GameInit.ALLDispose()

    --重载
    --_G.Time.timeScale = 1
    _G.CSMain.Inst:ReleaseGame()
    ---逻辑管理模块清理重置
    _G.require = _G.realRequire
    package.loaded["GameInit"] = nil
    _G.GameInit = nil
    _G.require("GameInit")
    --懒加载
    _G.require = require "lazyRequire"
    ---
    ---重新设置音乐
    --设置音乐及音效的临时代码
    local settingType = _G.SystemSettingManager:GetInstance().SettingType
    if WXPlayerPrefs.HasKey("Setting" .. settingType.BGMusic_is) then
        if WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic_is) > 0 then
            _G.AudioManager.SetMusicVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic))
        else
            _G.AudioManager.SetMusicVolume(0)
        end
    else
        ---没有点击过 关闭音乐按钮儿
        if WXPlayerPrefs.HasKey("Setting" .. settingType.BGMusic) then
            _G.AudioManager.SetMusicVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic))
        else
            _G.AudioManager.SetMusicVolume(0.5)
            WXPlayerPrefs.SetFloat("Setting" .. settingType.BGMusic, 0.5)
        end
    end
    if WXPlayerPrefs.HasKey("Setting" .. settingType.BGAudio_is) then
        if WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio_is) > 0 then
            _G.AudioManager.SetAudioVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio))
        else
            _G.AudioManager.SetAudioVolume(0)
        end
    else
        ---没有点击过 关闭 音效
        if WXPlayerPrefs.HasKey("Setting" .. settingType.BGAudio) then
            _G.AudioManager.SetAudioVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio))
        else
            _G.AudioManager.SetAudioVolume(0.5)
            WXPlayerPrefs.SetFloat("Setting" .. settingType.BGAudio, 0.5)
        end
    end

    --_G.CS.VideoManager.Instance:CreatePrefab()

    _G.UIManager:GetInstance():CloseWindow(_G.ConfigManager.ui_cfg.LoadingView.Name)
    if self:CheckOpenMiniGame() then
        return
    end
    self:NormalOpenLoginView()
end

