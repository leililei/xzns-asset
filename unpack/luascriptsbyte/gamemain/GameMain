-- 全局配置  依据配置表  修改  AttrType
function GameMain:UpdataGlobalDefine_AttrType()
    local type_attribute_cfg = _G.ConfigManager.type_attribute_cfg
    for _, value_AttrType in pairs(_G.AttrType) do
        ---@type AttrTypeInfo
        local attrinfo = value_AttrType
        local attrCfg = type_attribute_cfg[attrinfo.ID]
        if attrCfg ~= nil then
            attrinfo.des = _G.LangUtil.GetLangPackValue(attrCfg.name)
            attrinfo.icon = attrCfg.icon
            attrinfo.percentage = (attrCfg.value_type or 1) - 1
            attrinfo.sortid = attrCfg.display_priority
        end
    end
end

function GameMain:CheckOpenMiniGame()
    if _G.AppSetting.IsArraigned then
        if _G.AppSetting.ArraignedType == _G.ArraignedStartType.RedPaper then
            --2接红包
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.RedPaperView.Name)
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOut then
            --3送外卖
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TakeOutGameView.Name)
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.TakeOutToMain then
            --4送外卖转正常启动
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.TakeOutGameView.Name, nil, _G.handler(self, self.NormalOpenLoginView))
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.Music then
            --5音游
            _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.eventcureview.Name)
        elseif _G.AppSetting.ArraignedType == _G.ArraignedStartType.SwordCasual then
            --6剑之修行
            require("SwordCasualModel"):GetInstance():ArraignedChallenge()
        else
            return false
        end
        _G.CS.Launcher.Inst:CloseLoading()
        return true
    end
    return false
end

