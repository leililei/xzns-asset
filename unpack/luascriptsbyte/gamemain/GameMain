require "AppSetting"
require "init"

local WXPlayerPrefs = _G.CS.WechatGameCore.PlayerPrefs

---@class GameMain:GameMain 游戏的主入口，一般由C#端调用
---@field reportLoadingCompleted boolean    是否已上报资源加载完成
---@field reportGamePlay boolean    是否已上报进入游戏页面
local GameMain = {}
_G.GameMain = GameMain

-- 主入口函数。从这里开始lua逻辑
function GameMain:Start()
    if AppSetting.IsH5 then
        _G.SDKManager:GetInstance():PushResumeAndPauseListener(require("SDKDef").GetMsg.onAppResume, _G.handler(self, self.onAppResume), {})
        _G.SDKManager:GetInstance():PushResumeAndPauseListener(require("SDKDef").GetMsg.onAppPause, _G.handler(self, self.onAppPause), {})
    end
    local version = _G.ConfigManager.discrete_cfg[200002] and _G.ConfigManager.discrete_cfg[200002][1][1] or 1
    _G.AppSetting.IsXzns = version == _G.ConfigVersion.xzns
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.StartLoginMain)
    if not _G.AppSetting.DEBUG and not _G.CS.WechatGameCore.WechatGameApp.Instance.isDebugMod then
        _G.CS.UnityEngine.Debug.unityLogger.filterLogType = _G.CS.UnityEngine.LogType.Exception
    end
    --这里由于线上出了debug包，说以这里改为用产品配置为主，自己打的debug无用了
    if _G.CS.WechatGameCore.WechatGameApp.Instance.isDebugMod then
        _G.Log("<color=red><size=20>" .. "Lua GameMain:" .. "Start" .. "</size></color>")
        _G.CS.Launcher.Inst:AddComponentE(_G.typeof(_G.CS.Reporter))
    end
    if not _G.IsNil(_G.CS.Reporter.Inst) then
        _G.CS.Reporter.Inst.DebugCallBack = self.AddLog
    end
    --设置音乐及音效的临时代码
    local settingType = _G.SystemSettingManager:GetInstance().SettingType
    if WXPlayerPrefs.HasKey("Setting" .. settingType.BGMusic_is) then
        if WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic_is) > 0 then
            _G.AudioManager.SetMusicVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic))
        else
            _G.AudioManager.SetMusicVolume(0)
        end
    else
        ---没有点击过 关闭音乐按钮儿
        if WXPlayerPrefs.HasKey("Setting" .. settingType.BGMusic) then
            _G.AudioManager.SetMusicVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGMusic))
        else
            _G.AudioManager.SetMusicVolume(0.5)
            WXPlayerPrefs.SetFloat("Setting" .. settingType.BGMusic, 0.5)
        end
    end
    if WXPlayerPrefs.HasKey("Setting" .. settingType.BGAudio_is) then
        if WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio_is) > 0 then
            _G.AudioManager.SetAudioVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio))
        else
            _G.AudioManager.SetAudioVolume(0)
        end
    else
        ---没有点击过 关闭 音效
        if WXPlayerPrefs.HasKey("Setting" .. settingType.BGAudio) then
            _G.AudioManager.SetAudioVolume(WXPlayerPrefs.GetFloat("Setting" .. settingType.BGAudio))
        else
            _G.AudioManager.SetAudioVolume(0.5)
            WXPlayerPrefs.SetFloat("Setting" .. settingType.BGAudio, 0.5)
        end
    end
    _G.AudioManager.RefreshCurMusicVolume()
    if _G.AppSetting.DEBUG then
        _G.Log(_G.AppSetting.IsEditor, "editor模式启动")
        _G.Log(_G.AppSetting.IsIos, "ios模式启动")
        _G.Log(_G.AppSetting.IsAndriod, "android模式启动")
    end

    if _G.AppSetting.IsEditor then
        if _G.AppSetting.DEBUG then
            _G.Log("editor直接开始游戏")
        end
        self:GameContinue()
    else
        if _G.AppSetting.IsIos then
            if _G.AppSetting.DEBUG then
                _G.Log("ios请求设备信息")
            end
            --_G.SDKManager:GetInstance():AddListener(require("SDKDef").GetMsg.iphone_info, self.GetDIphoneInfo, self)
            -- _G.SDKManager:GetInstance():GetIphoneInfo()
            ---ios没有游客登录，所以去掉该流程，直接开始游戏
            self:GameContinue()
        else
            if _G.AppSetting.DEBUG then
                _G.Log("安卓直接开始游戏")
            end
            self:GameContinue()
        end
    end
    _G.SDKManager:GetInstance():TrackEvent(require "SDKDef".DotMsg.Ru.LaunchApp)
end

function GameMain:GetDIphoneInfo(json)
    local json_data = _G.Json2Table(json)

    if _G.AppSetting.DEBUG then
        _G.Log(json_data, "<color=red>" .. "iphone_info" .. "</color>")
    end

    self:GameContinue()
    _G.SDKManager:GetInstance():RemoveListener(require("SDKDef").GetMsg.iphone_info, self.GetDIphoneInfo, self)
end

---播放开场视频后再进行登录游戏
---@return void
function GameMain:PlayVideoIfFirstEnterGame()
    local isPlaying = false
    --播放开场视频
    ---部分平台不显示开场视频
    local videoKey = _G.GameUtil.GetFunctionData(_G.FunctionBlock.Video)
    if _G.AppSetting.IsXzns or not videoKey or not _G.ConfigManager.video_cfg[videoKey] then
        isPlaying = false
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.StartJumpVideo)
    elseif _G.ConfigManager.video_cfg[videoKey] then
        local isFirstOpenGame = _G.PlayerPrefsManager.GetInt("FirstOpenGame")
        if isFirstOpenGame ~= 1 then
            _G.PlayerPrefsManager.SetInt("FirstOpenGame", 1)
            isPlaying = true
            -- _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg.zhenhunjie_open_movie, nil, function()
            --     _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
            --     CS.Launcher.Inst:CloseLoading()
            -- end)
            _G.SDKManager:GetInstance():MiniGameTrack(require("SDKDef").DotMsg.ShuShu.opening_anim)
            _G.UIUtils.PlayVideo(_G.ConfigManager.video_cfg[videoKey],
                    function()
                        self:EnterServerIfEmptyRoles()
                    end,
                    function()
                        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
                        CS.Launcher.Inst:CloseLoading()
                    end)
        end
    end

    if not isPlaying then
        --_G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.StartLogin)
        self:EnterServerIfEmptyRoles()
    end
end

---如果是新账户, 自动登录进入服务器
function GameMain:EnterServerIfEmptyRoles()
    self.loginRequestId = nil
    if self:CheckOpenMiniGame() then
        return
    end
    --非WebGL平台没有自动登录, 直接跳转LoginView页面
    if _G.CS.UnityEngine.Application.platform ~= _G.CS.UnityEngine.RuntimePlatform.WebGLPlayer or _G.AppSetting.IsArraigned or _G.AppSetting.IsTuoGuan
            or _G.GameUtil.GetFunctionOpenState(_G.FunctionBlock.SpecialCheck1) then
        if not _G.IsNil(CS.Launcher.Inst.loadingWin) then
            CS.Launcher.Inst.loadingWin:SetProgress(100)
            CS.Launcher.Inst.loadingWin:LauncherComplete()
        end
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        return
    end
    --_G.CS.Launcher.Inst:CloseLoading()

    local SDKDef = require("SDKDef")

    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.auth_failed, self.SDKLoginFailure, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.login_failed, self.SDKLoginFailure, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetServerListSuccess, self.EnterServerIfEmptyRoles, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetUserInfoCall, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.NewPlayer, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.FangchenmiFlag, self.SendEnterServer, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.LoginFailure, self.EnterServerLoginFailure, self)
    _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ConnectFail, self.EnterServerLoginFailure, self)

    --未登录,先发起登录请求
    if not _G.LoginManager:GetInstance().isSDKLoginSuccess then
        if self.sendLoginRequested then
            --如果已经请求过登录, 不再重复请求
            _G.UIManager:GetInstance():OpenWindow(
                    _G.ConfigManager.ui_cfg.LoginView.Name,
                    _G.AppSetting.IsHuaWei --登录失败后, 华为rpk快游戏禁用自动登录
            )
            return
        end
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.SendLoginFunction)
        self.sendLoginRequested = true

        --sdk登录后将自动拉取服务器列表
        _G.Events:GetInstance():AddListener(_G.eLoginEvent.GetServerListSuccess, self.EnterServerIfEmptyRoles, self)
        --sdk登录失败监听
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.auth_failed, self.SDKLoginFailure, self)
        _G.SDKManager:GetInstance():AddListener(SDKDef.GetMsg.login_failed, self.SDKLoginFailure, self)
        --登录请求超时处理
        local requestId = "requestLogin" .. tostring(math.random())
        self.loginRequestId = requestId
        _G.DelayDo(3, function()
            if self.loginRequestId ~= requestId then
                return
            end
            self:SDKLoginFailure()
        end)

        --发送SDK登录请求
        _G.SDKManager:GetInstance():SendLoginEx()
        return
    end
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.CheckPlayer)
    --如果登录任何服务器, 则进入登录页面
    if not _G.CS.Launcher.Inst.IsSDK then
        _G.ServerManager:GetInstance():InitLocalServerList()
    end
    if _G.ServerManager:GetInstance():CheckHasPlayer() then
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.HasPlayer)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        return
    end
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.NoPlayer)
    --获取推荐服务器
    local recommendServer = _G.ServerManager:GetInstance():GetLastServer()
    if not recommendServer then
        _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.Norecommend)
        _G.UIManager:GetInstance():OpenWindow(_G.ConfigManager.ui_cfg.LoginView.Name)
        return
    end
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.Hasrecommend)
    if _G.AppSetting.DEBUG then
        --测试选择使用alpha公共服务器,
        local all = _G.ServerManager:GetInstance():GetAllServerList() or {}
        for _, v in pairs(all) do
            if v.ServerName == "alpha公共" then
                recommendServer = v
                break
            end
        end
    end

    --登录服务器
    _G.Events:GetInstance():AddListener(_G.eLoginEvent.GetUserInfoCall, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():AddListener(_G.eLoginEvent.NewPlayer, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():AddListener(_G.eLoginEvent.LoginFailure, self.EnterServerLoginFailure, self)
    _G.Events:GetInstance():AddListener(_G.eYKNetEvent.ConnectFail, self.EnterServerLoginFailure, self)
    if _G.CS.Launcher.Inst.IsSDK then
        --sdk登录需额外的防沉迷认证
        _G.Events:GetInstance():AddListener(_G.eLoginEvent.FangchenmiFlag, self.SendEnterServer, self)
    end
    local constKey = _G.LoginManager:GetInstance().ConstKey --初始化LoginManager
    _G.ServerManager:GetInstance():SetCurServer(recommendServer)
    _G.SDKManager:GetInstance():GameStepInfo(require("SDKDef").BIStep.BeginLoginServer)
    _G.LoginManager:GetInstance():DoLoginGameServer("")
end

---登录防沉迷年龄认证
---@return void
function GameMain:SendEnterServer(args)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.FangchenmiFlag, self.SendEnterServer, self)
    _G.PlayerModel:GetInstance().SDK_AgeState = tonumber(args)
    _G.LoginManager:GetInstance():LoginServer("")
end

---sdk登录失败, 进入LoginView
---@return void
function GameMain:SDKLoginFailure()
    self.loginRequestId = nil
    local SDKDef = require("SDKDef")
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.auth_failed, self.SDKLoginFailure, self)
    _G.SDKManager:GetInstance():RemoveListener(SDKDef.GetMsg.login_failed, self.SDKLoginFailure, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetServerListSuccess, self.EnterServerIfEmptyRoles, self)

    _G.UIManager:GetInstance():OpenWindow(
            _G.ConfigManager.ui_cfg.LoginView.Name,
            _G.AppSetting.IsHuaWei --登录失败后, 华为rpk快游戏禁用自动登录
    )
end

---登录成功
---@return void
function GameMain:EnterServerLoginSuccessed()
    self.loginRequestId = nil
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.GetUserInfoCall, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.NewPlayer, self.EnterServerLoginSuccessed, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.FangchenmiFlag, self.SendEnterServer, self)
    _G.Events:GetInstance():RemoveListener(_G.eLoginEvent.LoginFailure, self.EnterServerLoginFailure, self)
    _G.Events:GetInstance():RemoveListener(_G.eYKNetEvent.ConnectFail, self.EnterServerLoginFailure, self)

    if _G.PlayerModel:GetInstance():CheckCreateRole() then
        _G.LoginManager:GetInstance():StartLoginInfo()
        _G.CS.Launcher.Inst:CloseLoading()
    else
        _G.PlayerModel:GetInstance():CreateRole(function()
            _G.LoginManager:GetInstance():StartLoginInfo()
            _G.CS.Launcher.Inst:CloseLoading()
        end)
    end
end

