---焦点函数
---@param gtype number 1是焦点存在与否，2是暂停状态与否
---@param state boolean 状态
function GameMain:UpdateGameFocusAndPauseState(gtype, state)
    --镇魂街ZHJ-29702 【主任务】【0301】涉及程序单号ZHJ-29894
    --【客户端】断线重连若时间较长则直接重新登录
    --pc用焦点，手机平台使用暂停接口处理
    if _G.AppSetting.IsEditor or _G.AppSetting.IsWebGl then
        if gtype == 1 and state == false then
            self.DoBackGroundTime = _G.CS.UnityEngine.Time.realtimeSinceStartup
            if _G.AppSetting.DEBUG then
                _G.Log(self.DoBackGroundTime, "检测到失去焦点")
            end
            ---失去焦点暂停引导自动进入下一步的计时器
            if not _G.AppSetting.IsEditor then
                _G.GuideManager:GetInstance():StopNextTimer()
            end
        end
        if gtype == 1 and state then
            local timeNow = _G.CS.UnityEngine.Time.realtimeSinceStartup
            --按小时计
            local bgtime = _G.ConfigManager.discrete_cfg[100126][1][1]
            if _G.AppSetting.DEBUG then
                _G.Log(bgtime, "配置焦点检测间隔时间")
                _G.Log(timeNow, "检测到获得焦点")
            end
            if nil == self.DoBackGroundTime then
                self.DoBackGroundTime = timeNow
            end
            if _G.CS.YoukiaCore.TimeKit.LoginServerTime ~= 0 and
                    _G.PlayerModel:GetInstance():CheckCreateRole() and
                    _G.LoginManager:GetInstance().GotoMainFinish then
                require "DouyinModel":GetInstance():GetOnShowRes()
                require "MeituanModel":GetInstance():GetRepeat()
            end
            ----如果切到后台已超过配置时间就直接提示并退回到登录
            if timeNow - self.DoBackGroundTime >= 3600 * bgtime then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                        200310,
                        nil,
                        function()
                            self.DoBackGroundTime = timeNow
                            self:ResetGame()
                        end
                )
            end
            if not _G.AppSetting.IsEditor and timeNow - self.DoBackGroundTime >= 10 then
                ---微信十秒后会自动断开所有的网络链接,超过十秒回来直接断开链接重连
                _G.Net.CheckSocketActive()
            end
        end
    else
        if gtype == 2 and state then
            self.DoBackGroundTime = _G.CS.UnityEngine.Time.realtimeSinceStartup
            if _G.AppSetting.DEBUG then
                _G.Log(self.DoBackGroundTime, "移动平台检测到失去焦点")
            end
            ---失去焦点暂停引导自动进入下一步的计时器
            if not _G.AppSetting.IsEditor then
                _G.GuideManager:GetInstance():StopNextTimer()
            end
        end
        if gtype == 2 and state == false then
            local timeNow = _G.CS.UnityEngine.Time.realtimeSinceStartup
            --按小时计
            local bgtime = _G.ConfigManager.discrete_cfg[100126][1][1]
            if _G.AppSetting.DEBUG then
                _G.Log(bgtime, "配置焦点检测间隔时间")
                _G.Log(timeNow, "移动平台检测到获得焦点")
            end
            if _G.CS.YoukiaCore.TimeKit.LoginServerTime ~= 0 and
                    _G.PlayerModel:GetInstance():CheckCreateRole() and
                    _G.LoginManager:GetInstance().GotoMainFinish then
                require "DouyinModel":GetInstance():GetOnShowRes()
                require "MeituanModel":GetInstance():GetRepeat()
            end
            if nil == self.DoBackGroundTime then
                self.DoBackGroundTime = timeNow
            end
            ----如果切到后台已超过配置时间就直接提示并退回到登录
            if timeNow - self.DoBackGroundTime >= 3600 * bgtime then
                _G.PopWindowManager:GetInstance():ShowAllTips(
                        200310,
                        nil,
                        function()
                            self.DoBackGroundTime = timeNow
                            self:ResetGame()
                        end
                )
            else
                _G.Net.CheckTcpSocketActive()
            end
        end
    end
end

